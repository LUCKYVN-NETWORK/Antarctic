From: StellarSeal <emnoigi1452@gmail.com>
Date: Sat, 17 Oct 2026 16:06:10 +0700
Subject: [PATCH 42/86] Reject absorption amounts overflowing NMS storage

- Validate the float range before narrowing a finite double to absorption hearts
- Follow up Dionysus 0165 / SPIGOT-5317

diff --git a/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java b/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
index 3343724..5121e38 100644
--- a/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
+++ b/main/java/org/bukkit/craftbukkit/entity/CraftLivingEntity.java
@@ -113,7 +113,7 @@ public class CraftLivingEntity extends CraftEntity implements LivingEntity {
     }
 
     public void setAbsorptionAmount(double amount) {
-        Preconditions.checkArgument(amount >= 0 && Double.isFinite(amount), "amount < 0 or non-finite");
+        Preconditions.checkArgument(amount >= 0 && amount <= Float.MAX_VALUE && Double.isFinite(amount), "amount must be finite, nonnegative and representable as a float");
 
         getHandle().setAbsorptionHearts((float) amount);
     }
