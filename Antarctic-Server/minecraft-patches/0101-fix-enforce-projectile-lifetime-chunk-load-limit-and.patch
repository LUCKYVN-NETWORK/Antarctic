From: StellarSeal <emnoigi1452@gmail.com>
Date: Mon, 23 Nov 2026 09:27:56 +0700
Subject: [PATCH 101/149] fix: enforce projectile lifetime chunk load limit and
 per-world tick cap


diff --git a/main/java/net/minecraft/server/EntityProjectile.java b/main/java/net/minecraft/server/EntityProjectile.java
index cff7d12..efefd42 100644
--- a/main/java/net/minecraft/server/EntityProjectile.java
+++ b/main/java/net/minecraft/server/EntityProjectile.java
@@ -297,31 +297,47 @@ public abstract class EntityProjectile extends Entity implements IProjectile {
     }
 
     // Antarctic start - reduce projectile chunk loading
-    private static int loadedThisTick = 0;
-    private static int loadedTick;
-
     private int loadedLifetime = 0;
+    private int antarcticLastChunkX = Integer.MIN_VALUE;
+    private int antarcticLastChunkZ = Integer.MIN_VALUE;
+
     @Override
     public void setPosition(double x, double y, double z) {
-        int currentTick = net.minecraft.server.MinecraftServer.currentTick;
-        if (loadedTick != currentTick) {
-            loadedTick = currentTick;
-            loadedThisTick = 0;
-        }
-        int previousX = MathHelper.floor(this.locX) >> 4, previousZ = MathHelper.floor(this.locZ) >> 4;
-        int newX = MathHelper.floor(x) >> 4, newZ = MathHelper.floor(z) >> 4;
-        if (previousX != newX || previousZ != newZ) {
-            boolean isLoaded = ((net.minecraft.server.ChunkProviderServer) this.world.getChunkProvider()).isLoaded(newX, newZ);
-            if (!isLoaded) {
-                if (EntityProjectile.loadedThisTick > com.destroystokyo.paper.config.toml.modules.optimizations.Projectiles.maxLoadsPerTick) {
-                    if (++this.loadedLifetime > com.destroystokyo.paper.config.toml.modules.optimizations.Projectiles.maxLoadsPerProjectile) {
-                        this.die();
+        int newX = MathHelper.floor(x) >> 4;
+        int newZ = MathHelper.floor(z) >> 4;
+        if (this.world != null && !this.world.isClientSide && (this.antarcticLastChunkX != newX || this.antarcticLastChunkZ != newZ)) {
+            IChunkProvider provider = this.world.getChunkProvider();
+            if (provider instanceof ChunkProviderServer && !((ChunkProviderServer) provider).isLoaded(newX, newZ)) {
+                int currentTick = MinecraftServer.currentTick;
+                if (this.world.projectileChunkLoadsTick != currentTick) {
+                    this.world.projectileChunkLoadsTick = currentTick;
+                    this.world.projectileChunkLoadsThisTick = 0;
+                }
+                int maxPerProjectile = Math.max(0, com.destroystokyo.paper.config.toml.modules.optimizations.Projectiles.maxLoadsPerProjectile);
+                if (this.loadedLifetime >= maxPerProjectile) {
+                    if (this.antarcticLastChunkX != Integer.MIN_VALUE && this.locX == x && this.locZ == z) {
+                        this.locX = this.lastX;
+                        this.locY = this.lastY;
+                        this.locZ = this.lastZ;
+                    }
+                    this.die();
+                    return;
+                }
+                int maxPerTick = Math.max(0, com.destroystokyo.paper.config.toml.modules.optimizations.Projectiles.maxLoadsPerTick);
+                if (this.world.projectileChunkLoadsThisTick >= maxPerTick) {
+                    if (this.antarcticLastChunkX != Integer.MIN_VALUE && this.locX == x && this.locZ == z) {
+                        this.locX = this.lastX;
+                        this.locY = this.lastY;
+                        this.locZ = this.lastZ;
                     }
                     return;
                 }
-                EntityProjectile.loadedThisTick++;
+                this.world.projectileChunkLoadsThisTick++;
+                this.loadedLifetime++;
             }
         }
+        this.antarcticLastChunkX = newX;
+        this.antarcticLastChunkZ = newZ;
         super.setPosition(x, y, z);
     }
     // Antarctic end
diff --git a/main/java/net/minecraft/server/World.java b/main/java/net/minecraft/server/World.java
index b331c75..3df9f79 100644
--- a/main/java/net/minecraft/server/World.java
