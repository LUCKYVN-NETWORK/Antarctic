+    // Antarctic start - main-thread pending marker capture & tolerant read (Appendix C)
+    static boolean captureLightPending(World world, Chunk chunk) {
+        if (chunk.antarcticLightPending) {
+            return true;
+        }
+        if (world instanceof WorldServer) {
+            RelightService service = ((WorldServer) world).getRelightServiceIfPresent();
+            return service != null && service.isPending(chunk.chunkKey);
+        }
+        return false;
+    }
+
+    static void readAntarcticLightPending(Chunk chunk, NBTTagCompound levelTag, World world) {
+        if (!levelTag.hasKey(ANTARCTIC_LIGHT_PENDING_KEY)) {
+            chunk.antarcticLightPending = false;
+            return;
+        }
+        if (levelTag.hasKeyOfType(ANTARCTIC_LIGHT_PENDING_KEY, 99)) {
+            chunk.antarcticLightPending = levelTag.getByte(ANTARCTIC_LIGHT_PENDING_KEY) != 0;
+        } else {
+            chunk.antarcticLightPending = false;
+            if (world == null || !world.antarcticWarnedMalformedLightMarker) {
+                if (world != null) {
+                    world.antarcticWarnedMalformedLightMarker = true;
+                }
+                ChunkRegionLoader.a.debug("Ignoring non-numeric {} tag on chunk {},{}", ANTARCTIC_LIGHT_PENDING_KEY, chunk.locX, chunk.locZ);
+            }
+        }
+    }
+    // Antarctic end
+
     private static void saveBody(NBTTagCompound nbttagcompound, Chunk chunk, long worldTime, boolean worldHasSkyLight) { // Spigot
+        saveBody(nbttagcompound, chunk, worldTime, worldHasSkyLight, false);
+    }
+
+    static void saveBody(NBTTagCompound nbttagcompound, Chunk chunk, long worldTime, boolean worldHasSkyLight, boolean lightPending) { // Spigot // Antarctic
         nbttagcompound.setInt("xPos", chunk.locX);
         nbttagcompound.setInt("zPos", chunk.locZ);
         nbttagcompound.setLong("LastUpdate", worldTime); // Spigot
         nbttagcompound.setIntArray("HeightMap", chunk.r());
         nbttagcompound.setBoolean("TerrainPopulated", chunk.isDone());
         nbttagcompound.setBoolean("LightPopulated", chunk.v());
+        if (lightPending) { // Antarctic - only written when pending or carried (vanilla-identical otherwise)
+            nbttagcompound.setByte(ANTARCTIC_LIGHT_PENDING_KEY, (byte) 1);
+        }
         nbttagcompound.setLong("InhabitedTime", chunk.x());
         ChunkSection[] achunksection = chunk.getSections();
         NBTTagList nbttaglist = new NBTTagList();
