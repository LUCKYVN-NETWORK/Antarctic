diff --git a/test/java/net/minecraft/server/RelightSaveMarkerTest.java b/test/java/net/minecraft/server/RelightSaveMarkerTest.java
new file mode 100644
index 0000000..62fac5e
--- /dev/null
+++ b/test/java/net/minecraft/server/RelightSaveMarkerTest.java
@@ -0,0 +1,215 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.Lighting;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/**
+ * T6 / Appendix C.6 tests for the Antarctic.LightPending chunk NBT marker:
+ * round-trip write/omit, vanilla old-data compatibility, tolerant read of malformed/numeric tags,
+ * toggle-off carry semantics, main-thread capture isolation, and future-schema v2 coexistence.
+ */
+public class RelightSaveMarkerTest {
+
+    private boolean prevAsyncCatcher;
+    private WorldServer activeWorld;
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    @Before
+    public void setUp() {
+        this.prevAsyncCatcher = org.spigotmc.AsyncCatcher.enabled;
+        org.spigotmc.AsyncCatcher.enabled = false;
+        Lighting.asyncBulkRelight = true;
+        Lighting.asyncRelightThreads = 1;
+        Lighting.relightSnapshotBudgetMs = 50;
+        Lighting.relightApplyBudgetMs = 50;
+    }
+
+    @After
+    public void tearDown() {
+        if (this.activeWorld != null) {
+            this.activeWorld.shutdownRelightService();
+            this.activeWorld = null;
+        }
+        Lighting.asyncBulkRelight = false;
+        Lighting.asyncRelightThreads = 0;
+        Lighting.relightSnapshotBudgetMs = 5;
+        Lighting.relightApplyBudgetMs = 2;
+        org.spigotmc.AsyncCatcher.enabled = this.prevAsyncCatcher;
+    }
+
+    private WorldServer makeWorld(long seed) throws Exception {
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = LightPropagationParityTest.buildWorld(seed, p);
+        LightPropagationParityTest.set(World.class, world, "chunkPacketBlockController",
+            com.destroystokyo.paper.antixray.ChunkPacketBlockController.NO_OPERATION_INSTANCE);
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                Chunk c = world.getChunkIfLoaded(cx, cz);
+                LightPropagationParityTest.set(Chunk.class, c, "locX", cx);
+                LightPropagationParityTest.set(Chunk.class, c, "locZ", cz);
+                LightPropagationParityTest.set(Chunk.class, c, "g", new byte[256]); // biomes
+            }
+        }
+        this.activeWorld = world;
+        return world;
+    }
+
+    @Test
+    public void roundTripWritesMarkerWhilePendingAndOmitsAfterApply() throws Exception {
+        WorldServer world = makeWorld(601L);
+        Chunk chunk = world.getChunkIfLoaded(0, 0);
+        RelightService service = world.getRelightService();
+
+        // 1. Clean chunk: no marker written (vanilla-identical)
+        NBTTagCompound cleanLevel = new NBTTagCompound();
+        ChunkRegionLoader.saveBody(cleanLevel, chunk, 100L, true, ChunkRegionLoader.captureLightPending(world, chunk));
+        assertFalse("clean chunk must not write Antarctic.LightPending", cleanLevel.hasKey(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY));
+
+        // 2. Submit relight: chunk is pending -> marker written as TAG_Byte = 1
+        CompletableFuture<Integer> future = service.submit(new long[]{chunk.chunkKey});
+        assertTrue(chunk.antarcticLightPending);
+        assertTrue(ChunkRegionLoader.captureLightPending(world, chunk));
+
+        NBTTagCompound pendingLevel = new NBTTagCompound();
+        ChunkRegionLoader.saveBody(pendingLevel, chunk, 100L, true, ChunkRegionLoader.captureLightPending(world, chunk));
+        assertTrue(pendingLevel.hasKeyOfType(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, 1)); // TAG_Byte
+        assertEquals((byte) 1, pendingLevel.getByte(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY));
+
+        // All other tags are identical to clean save
+        NBTTagCompound pendingCopyWithoutMarker = (NBTTagCompound) pendingLevel.clone();
+        pendingCopyWithoutMarker.remove(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY);
+        assertEquals("all non-marker tags must be byte-identical to vanilla save", cleanLevel, pendingCopyWithoutMarker);
+
+        // 3. Apply finishes: marker cleared and omitted on next save
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (!future.isDone() && System.nanoTime() < deadline) {
+            service.tick();
+            if (!future.isDone()) Thread.sleep(1);
+        }
+        assertTrue(future.isDone());
+        assertFalse("applied chunk must clear antarcticLightPending", chunk.antarcticLightPending);
+        assertFalse("applied chunk must not report pending on save capture", ChunkRegionLoader.captureLightPending(world, chunk));
+
+        NBTTagCompound afterApply = new NBTTagCompound();
+        ChunkRegionLoader.saveBody(afterApply, chunk, 100L, true, ChunkRegionLoader.captureLightPending(world, chunk));
+        assertFalse("save after apply must omit Antarctic.LightPending", afterApply.hasKey(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY));
+    }
+
+    @Test
+    public void tolerantReadHandlesAllNumericAndMalformedTypesPlusFutureSchema() throws Exception {
+        WorldServer world = makeWorld(602L);
+        Chunk chunk = world.getChunkIfLoaded(0, 0);
+
+        // Missing key (vanilla 1.12.2 save) -> false
+        ChunkRegionLoader.readAntarcticLightPending(chunk, new NBTTagCompound(), world);
+        assertFalse(chunk.antarcticLightPending);
+
+        // Numeric zero -> false
+        NBTTagCompound zero = new NBTTagCompound();
+        zero.setByte(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, (byte) 0);
+        ChunkRegionLoader.readAntarcticLightPending(chunk, zero, world);
+        assertFalse(chunk.antarcticLightPending);
+
+        // Numeric non-zero types (byte, short, int, long) -> true
+        NBTTagCompound asShort = new NBTTagCompound();
+        asShort.setShort(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, (short) 1);
+        ChunkRegionLoader.readAntarcticLightPending(chunk, asShort, world);
+        assertTrue(chunk.antarcticLightPending);
+
+        NBTTagCompound asInt = new NBTTagCompound();
+        asInt.setInt(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, 1);
+        ChunkRegionLoader.readAntarcticLightPending(chunk, asInt, world);
+        assertTrue(chunk.antarcticLightPending);
+
+        NBTTagCompound asLong = new NBTTagCompound();
+        asLong.setLong(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, 1L);
+        ChunkRegionLoader.readAntarcticLightPending(chunk, asLong, world);
+        assertTrue(chunk.antarcticLightPending);
+
+        // Malformed non-numeric types (string, compound, list) -> false, never throws, warns once
+        NBTTagCompound asString = new NBTTagCompound();
+        asString.setString(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, "yes");
+        ChunkRegionLoader.readAntarcticLightPending(chunk, asString, world);
+        assertFalse(chunk.antarcticLightPending);
+        assertTrue("malformed tag should record one-time world warning flag", world.antarcticWarnedMalformedLightMarker);
+
+        NBTTagCompound asCompound = new NBTTagCompound();
+        asCompound.set(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, new NBTTagCompound());
+        ChunkRegionLoader.readAntarcticLightPending(chunk, asCompound, world);
+        assertFalse(chunk.antarcticLightPending);
+
+        NBTTagCompound asList = new NBTTagCompound();
+        asList.set(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, new NBTTagList());
+        ChunkRegionLoader.readAntarcticLightPending(chunk, asList, world);
+        assertFalse(chunk.antarcticLightPending);
+
+        // Future schema v2 coexistence: v1 marker honored, unknown Antarctic.Light compound ignored
+        NBTTagCompound futureV2 = new NBTTagCompound();
+        futureV2.setByte(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, (byte) 1);
+        NBTTagCompound v2Payload = new NBTTagCompound();
+        v2Payload.setInt("Version", 2);
+        futureV2.set("Antarctic.Light", v2Payload);
+        ChunkRegionLoader.readAntarcticLightPending(chunk, futureV2, world);
+        assertTrue("v1 marker must still load as pending alongside unknown Antarctic.Light compound", chunk.antarcticLightPending);
+    }
+
+    @Test
+    public void toggleOffCarriesMarkerWithoutDroppingIt() throws Exception {
+        Lighting.asyncBulkRelight = false;
+        WorldServer world = makeWorld(603L);
+        Chunk chunk = world.getChunkIfLoaded(0, 0);
+
+        NBTTagCompound loadedLevel = new NBTTagCompound();
+        loadedLevel.setByte(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY, (byte) 1);
+        ChunkRegionLoader.readAntarcticLightPending(chunk, loadedLevel, world);
+        assertTrue("marker must be carried on chunk even when async-bulk-relight=false", chunk.antarcticLightPending);
+
+        // Save while toggle is still false -> marker is preserved for when feature is re-enabled!
+        boolean captured = ChunkRegionLoader.captureLightPending(world, chunk);
+        assertTrue(captured);
+        NBTTagCompound savedLevel = new NBTTagCompound();
+        ChunkRegionLoader.saveBody(savedLevel, chunk, 200L, true, captured);
+        assertEquals((byte) 1, savedLevel.getByte(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY));
+    }
+
+    @Test
+    public void capturedBooleanIsolatesLazySaveFromSubsequentApply() throws Exception {
+        WorldServer world = makeWorld(604L);
+        Chunk chunk = world.getChunkIfLoaded(0, 0);
+        RelightService service = world.getRelightService();
+
+        CompletableFuture<Integer> future = service.submit(new long[]{chunk.chunkKey});
+        // Capture happens on main thread BEFORE apply completes
+        boolean capturedBeforeApply = ChunkRegionLoader.captureLightPending(world, chunk);
+        assertTrue(capturedBeforeApply);
+
+        // Apply finishes on main thread BEFORE lazy IO-thread supplier executes saveBody
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (!future.isDone() && System.nanoTime() < deadline) {
+            service.tick();
+            if (!future.isDone()) Thread.sleep(1);
+        }
+        assertTrue(future.isDone());
+        assertFalse(chunk.antarcticLightPending);
+
+        // Capturing AFTER apply must yield false (never writes stale marker)
+        boolean capturedAfterApply = ChunkRegionLoader.captureLightPending(world, chunk);
+        assertFalse("save captured after apply must not write marker", capturedAfterApply);
+        NBTTagCompound afterLevel = new NBTTagCompound();
+        ChunkRegionLoader.saveBody(afterLevel, chunk, 300L, true, capturedAfterApply);
+        assertFalse(afterLevel.hasKey(ChunkRegionLoader.ANTARCTIC_LIGHT_PENDING_KEY));
+    }
+}
