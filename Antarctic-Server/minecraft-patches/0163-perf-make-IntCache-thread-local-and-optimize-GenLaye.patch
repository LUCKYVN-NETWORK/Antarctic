+
+        static synchronized void reset() {
+            if (!d.isEmpty()) {
+                d.remove(d.size() - 1);
+            }
+            if (!b.isEmpty()) {
+                b.remove(b.size() - 1);
+            }
+            d.addAll(e);
+            b.addAll(c);
+            e.clear();
+            c.clear();
+        }
+    }
