+    @Test
+    public void testGenLayerNextIntAndPipelineParity() throws Exception {
+        Field cField = GenLayer.class.getDeclaredField("c");
+        Field dField = GenLayer.class.getDeclaredField("d");
+        cField.setAccessible(true);
+        dField.setAccessible(true);
+
+        int[] bounds = new int[]{1, 2, 4, 8, 16, 256, 3, 5, 7, 10};
+        for (long seed : new long[]{0L, 123456789L, -9876543210123L}) {
+            ProbeGenLayer opt = new ProbeGenLayer(seed);
+            VanillaGenLayerRng ref = new VanillaGenLayerRng();
+            ref.c = cField.getLong(opt);
+            ref.d = dField.getLong(opt);
+            for (int step = 0; step < 10000; ++step) {
+                int bound = bounds[step % bounds.length];
+                int expected = ref.nextInt(bound);
+                int actual = opt.nextInt(bound);
+                assertEquals("GenLayer.a(" + bound + ") mismatch at step " + step, expected, actual);
+            }
+        }
+
+        // Full overworld GenLayer pipeline determinism & IntCache.a() non-aliasing
+        GenLayer[] layers = GenLayer.a(123456789L, WorldType.NORMAL, null);
+        assertNotNull(layers);
+        assertEquals(3, layers.length);
+
+        IntCache.a();
+        int[] r1 = layers[0].a(0, 0, 16, 16);
+        int[] r2 = layers[0].a(32, -16, 16, 16);
+        assertNotSame("Distinct IntCache.a(int) calls before reset must not alias", r1, r2);
+        int[] copy1 = Arrays.copyOf(r1, r1.length);
+        int[] copy2 = Arrays.copyOf(r2, r2.length);
+
+        IntCache.a();
+        int[] r1Again = layers[0].a(0, 0, 16, 16);
+        int[] r2Again = layers[0].a(32, -16, 16, 16);
+        assertArrayEquals("GenLayer overworld determinism check 1", copy1, r1Again);
+        assertArrayEquals("GenLayer overworld determinism check 2", copy2, r2Again);
+        IntCache.a();
+
+        // Beyond MAX_FREE (70 calls before reset) must never alias, and size > maxSize escalation must grow cleanly
+        int[][] manySmall = new int[70][];
+        for (int i = 0; i < manySmall.length; ++i) {
+            manySmall[i] = IntCache.a(256);
+            manySmall[i][0] = i + 1;
+            for (int prev = 0; prev < i; ++prev) {
+                assertNotSame("IntCache small buffers must not alias at " + i, manySmall[prev], manySmall[i]);
+            }
+        }
+        int[] l1 = IntCache.a(512);
+        int[] l2 = IntCache.a(2048);
+        assertTrue(l2.length >= 2048);
+        assertNotSame(l1, l2);
+        IntCache.a();
+    }
