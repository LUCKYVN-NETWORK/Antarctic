+    @Test
+    public void testRegistryIDParity() {
+        RegistryID<Object> reg = new RegistryID<Object>(16);
+        Object[] objs = new Object[500];
+        int[] expectedIds = new int[500];
+        for (int i = 0; i < 500; ++i) {
+            objs[i] = new Object();
+            if ((i & 3) == 0) {
+                int sparseId = i * 2 + 17;
+                reg.a(objs[i], sparseId);
+                expectedIds[i] = sparseId;
+            } else {
+                expectedIds[i] = reg.c(objs[i]);
+            }
+        }
+
+        assertEquals(500, reg.b());
+        for (int i = 0; i < 500; ++i) {
+            assertEquals("getId mismatch at " + i, expectedIds[i], reg.getId(objs[i]));
+            assertSame("fromId mismatch at " + i, objs[i], reg.fromId(expectedIds[i]));
+        }
+        assertEquals(-1, reg.getId(new Object()));
+        assertNull(reg.fromId(-1));
+        assertNull(reg.fromId(999999));
+
+        int iterCount = 0;
+        for (Object ignored : reg) {
+            ++iterCount;
+        }
+        assertEquals(500, iterCount);
+    }
