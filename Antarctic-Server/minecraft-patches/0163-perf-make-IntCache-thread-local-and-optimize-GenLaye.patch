+    @Test
+    public void testIntCacheAndGenLayerBenchmark() {
+        long blackhole = 0L;
+
+        // Warmup IntCache
+        for (int w = 0; w < 500; ++w) {
+            VanillaSyncedIntCache.reset();
+            for (int i = 0; i < 16; ++i) {
+                blackhole ^= VanillaSyncedIntCache.a(256)[0];
+                blackhole ^= VanillaSyncedIntCache.a(1024)[0];
+            }
+            IntCache.a();
+            for (int i = 0; i < 16; ++i) {
+                blackhole ^= IntCache.a(256)[0];
+                blackhole ^= IntCache.a(1024)[0];
+            }
+        }
+        VanillaSyncedIntCache.reset();
+        IntCache.a();
+
+        int iters = 2000;
+        long t0 = System.nanoTime();
+        for (int c = 0; c < iters; ++c) {
+            VanillaSyncedIntCache.reset();
+            for (int i = 0; i < 24; ++i) {
+                int[] a1 = VanillaSyncedIntCache.a(256);
+                int[] a2 = VanillaSyncedIntCache.a(1024);
+                blackhole += a1.length + a2.length;
+            }
+        }
+        long intCacheVanillaNs = (System.nanoTime() - t0) / iters;
+
+        t0 = System.nanoTime();
+        for (int c = 0; c < iters; ++c) {
+            IntCache.a();
+            for (int i = 0; i < 24; ++i) {
+                int[] a1 = IntCache.a(256);
+                int[] a2 = IntCache.a(1024);
+                blackhole += a1.length + a2.length;
+            }
+        }
+        long intCacheOptNs = (System.nanoTime() - t0) / iters;
+        IntCache.a();
+
+        // RegistryID getId throughput
+        RegistryID<Object> reg = new RegistryID<Object>(256);
+        Object[] keys = new Object[512];
+        for (int i = 0; i < keys.length; ++i) {
+            keys[i] = new Object();
+            reg.c(keys[i]);
+        }
+        for (int w = 0; w < 200; ++w) {
+            for (Object key : keys) {
+                blackhole ^= reg.getId(key);
+            }
+        }
+        t0 = System.nanoTime();
+        for (int r = 0; r < 500; ++r) {
+            for (Object key : keys) {
+                blackhole += reg.getId(key);
+            }
+        }
+        long regLookupNs = (System.nanoTime() - t0) / 500;
+
+        // GenLayer biome pipeline throughput
+        GenLayer[] layers = GenLayer.a(123456789L, WorldType.NORMAL, null);
+        for (int w = 0; w < 50; ++w) {
+            IntCache.a();
+            blackhole ^= layers[0].a(w * 16, w * 16, 16, 16)[0];
+        }
+        t0 = System.nanoTime();
+        for (int c = 0; c < 200; ++c) {
+            IntCache.a();
+            blackhole += layers[0].a(c * 16, -c * 16, 16, 16)[0];
+        }
+        long genLayerNs = (System.nanoTime() - t0) / 200;
+        IntCache.a();
+
+        System.out.printf("A8_BENCH intcache_vanilla_ns=%d intcache_opt_ns=%d intcache_speedup=%.2fx reg512_ns=%d genlayer_ns=%d blackhole=%d%n",
+                intCacheVanillaNs, intCacheOptNs, (double) intCacheVanillaNs / Math.max(1L, intCacheOptNs),
+                regLookupNs, genLayerNs, blackhole);
+
+        assertTrue("Expected IntCache speedup > 1.5x, got " + intCacheVanillaNs + " vs " + intCacheOptNs,
+                intCacheOptNs * 1.5 < intCacheVanillaNs);
+    }
