+    @After
+    public void restoreConfig() {
+        DisableWorldDataSaving.worlds = new ArrayList<>(prevWorlds);
+        new DisableWorldDataSaving().onLoaded(null);
+        VanillaUsernameCheck.removeAllCheck = prevRemoveAll;
+        VanillaUsernameCheck.useRegex = prevUseRegex;
+        VanillaUsernameCheck.regex = prevRegex;
