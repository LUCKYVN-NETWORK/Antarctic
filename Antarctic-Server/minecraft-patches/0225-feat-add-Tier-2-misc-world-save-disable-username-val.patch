+package com.destroystokyo.paper.config.toml.modules.misc;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+public class DisableWorldDataSaving implements IConfigModule {
+
+    @ConfigInfo(
+        baseName = "worlds",
+        comments = "List of world names for which disk chunk/level data saving is disabled. Default empty []."
+    )
+    public static List<String> worlds = new ArrayList<String>();
+
+    private static volatile Set<String> disabledWorldSet = Collections.emptySet();
+
+    public static boolean isDisabled(String worldName) {
+        if (worldName == null || worldName.isEmpty()) {
+            return false;
+        }
+        Set<String> set = disabledWorldSet;
+        if (!set.isEmpty()) {
+            return set.contains(worldName);
+        }
+        List<String> list = worlds;
+        return list != null && !list.isEmpty() && list.contains(worldName);
+    }
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.MISC;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "disable-world-data-saving";
+    }
+
+    @Override
+    public void onLoaded(CommentedFileConfig config) {
+        if (worlds == null || worlds.isEmpty()) {
+            disabledWorldSet = Collections.emptySet();
+        } else {
+            disabledWorldSet = Collections.unmodifiableSet(new HashSet<String>(worlds));
+        }
+    }
+}
