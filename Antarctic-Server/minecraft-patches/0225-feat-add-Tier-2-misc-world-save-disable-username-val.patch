+        DisableWorldDataSaving.worlds = List.of("world_nether");
+        new DisableWorldDataSaving().onLoaded(null);
+        assertTrue(DisableWorldDataSaving.isDisabled("world_nether"));
+        assertFalse(DisableWorldDataSaving.isDisabled("world"));
+
+        WorldServer ws = (WorldServer) UNSAFE.allocateInstance(WorldServer.class);
+        WorldData wd = new WorldData() {};
+        wd.a("world_nether");
+        Field wdField = World.class.getDeclaredField("worldData");
+        wdField.setAccessible(true);
+        wdField.set(ws, wd);
+
+        // Should return early without touching null chunkProvider/dataManager and mark savingDisabled = true
+        ws.save(true, null);
+        assertTrue(ws.savingDisabled);
+
+        ChunkProviderServer cps = (ChunkProviderServer) UNSAFE.allocateInstance(ChunkProviderServer.class);
+        Field worldField = ChunkProviderServer.class.getDeclaredField("world");
+        worldField.setAccessible(true);
+        worldField.set(cps, ws);
+        // Should return true immediately without NPE on null chunkLoader
+        assertTrue(cps.a(true));
+    }
