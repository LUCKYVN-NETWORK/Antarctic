@@ -0,0 +1,87 @@
+package com.destroystokyo.paper.config.toml.modules.misc;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+import java.util.regex.Pattern;
+
+public class VanillaUsernameCheck implements IConfigModule {
+
+    @ConfigInfo(baseName = "remove-all-check", comments = "Disable username character validation on login (use with caution). Default false.")
+    public static boolean removeAllCheck = false;
+
+    @ConfigInfo(baseName = "use-regex", comments = "Validate login usernames against the configured regex instead of vanilla ASCII bounds. Default false.")
+    public static boolean useRegex = false;
+
+    @ConfigInfo(baseName = "regex", comments = "Regex used when use-regex is enabled. Default ^[a-zA-Z0-9_.]*$.")
+    public static String regex = "^[a-zA-Z0-9_.]*$";
+
+    @ConfigInfo(baseName = "enforce-skull", comments = "Reject malformed skull owner names before profile lookup so 1.12.2 clients are never kicked. Default true.")
+    public static boolean enforceSkull = true;
+
+    private static volatile String compiledRegexSource;
+    private static volatile Pattern compiledPattern;
+
+    private static Pattern getPattern() {
+        String src = regex != null ? regex : "^[a-zA-Z0-9_.]*$";
+        Pattern pat = compiledPattern;
+        if (pat == null || !src.equals(compiledRegexSource)) {
+            pat = Pattern.compile(src);
+            compiledRegexSource = src;
+            compiledPattern = pat;
+        }
+        return pat;
+    }
+
+    public static boolean isValidUsername(String name) {
+        if (name == null || name.isEmpty()) {
+            return false;
+        }
+        if (removeAllCheck) {
+            return true;
+        }
+        if (name.length() > 16) {
+            return false;
+        }
+        if (useRegex) {
+            return getPattern().matcher(name).matches();
+        }
+        return isVanillaAscii(name);
+    }
+
+    public static boolean isValidSkullName(String name) {
+        if (!enforceSkull) {
+            return true;
+        }
+        if (name == null || name.isEmpty() || name.length() > 16) {
+            return false;
+        }
+        return isVanillaAscii(name);
+    }
+
+    private static boolean isVanillaAscii(String name) {
+        for (int i = 0, len = name.length(); i < len; ++i) {
+            char c = name.charAt(i);
+            if (c <= 32 || c >= 127) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.MISC;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "vanilla-username-check";
+    }
+
+    @Override
+    public void onLoaded(CommentedFileConfig config) {
+        getPattern();
+    }
+}
