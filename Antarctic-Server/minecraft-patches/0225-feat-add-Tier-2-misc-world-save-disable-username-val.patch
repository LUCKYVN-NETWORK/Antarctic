+    @Test
+    public void testUsernameValidationAndSkullEnforcement() {
+        VanillaUsernameCheck.removeAllCheck = false;
+        VanillaUsernameCheck.useRegex = false;
+        assertTrue(VanillaUsernameCheck.isValidUsername("Notch_123"));
+        assertFalse(VanillaUsernameCheck.isValidUsername("Bad Name"));
+        assertFalse(VanillaUsernameCheck.isValidUsername("TooLongUsername17"));
+        assertFalse(VanillaUsernameCheck.isValidUsername(""));
+        assertFalse(VanillaUsernameCheck.isValidUsername(null));
+
+        VanillaUsernameCheck.useRegex = true;
+        VanillaUsernameCheck.regex = "^[a-zA-Z0-9_.]{3,16}$";
+        assertTrue(VanillaUsernameCheck.isValidUsername("Player.1"));
+        assertFalse(VanillaUsernameCheck.isValidUsername("ab"));
+
+        VanillaUsernameCheck.removeAllCheck = true;
+        assertTrue(VanillaUsernameCheck.isValidUsername("Any Name With Spaces!"));
+
+        // Skull check + TileEntitySkull.b() skip
+        VanillaUsernameCheck.enforceSkull = true;
+        assertFalse(VanillaUsernameCheck.isValidSkullName("Bad Skull Name"));
+        final GameProfile[] callbackResult = new GameProfile[1];
+        GameProfile badProfile = new GameProfile((UUID) null, "Bad Skull Name");
+        TileEntitySkull.b(badProfile, new Predicate<GameProfile>() {
+            @Override
+            public boolean apply(GameProfile input) {
+                callbackResult[0] = input;
+                return false;
+            }
+        }, false);
+        assertSame(badProfile, callbackResult[0]);
+    }
