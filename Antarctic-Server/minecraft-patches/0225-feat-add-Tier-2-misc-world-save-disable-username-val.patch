+    @Test
+    public void testAbiSafeTpsAndCommandFormatting() throws Exception {
+        MinecraftServer server = (MinecraftServer) UNSAFE.allocateInstance(DedicatedServer.class);
+        Field rtField = MinecraftServer.class.getDeclaredField("recentTps");
+        rtField.setAccessible(true);
+        rtField.set(server, new double[3]);
+
+        double[] tps = new double[] { 20.0D, 19.8D, 19.5D };
+
+        Tps.include5sInTpsCommand = false;
+        assertEquals(3, server.recentTps.length);
+        String msgOff = TicksPerSecondCommandAccess.buildTpsMessage(tps, 18.5D);
+        assertTrue(msgOff.contains("TPS from last 1m, 5m, 15m:"));
+        assertFalse(msgOff.contains("5s,"));
+
+        Tps.include5sInTpsCommand = true;
+        assertEquals(3, server.recentTps.length);
+        String msgOn = TicksPerSecondCommandAccess.buildTpsMessage(tps, 18.5D);
+        assertTrue(msgOn.contains("TPS from last 5s, 1m, 5m, 15m:"));
+        assertTrue(msgOn.contains("18.5"));
