From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 18 Jun 2022 13:15:24 +0200
Subject: [PATCH 058/193] Reduce projectile chunk loading

- Backport Dionysus server/0054-Reduce-projectile-chunk-loading.patch
- Source: https://github.com/nopjmp/Dionysus at b5c71b62f6f1f555b22bd52f5751e33be4690b6e
- Author: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
- Copyright: (C) 2022 Pufferfish Studios LLC (GPL-3.0-or-later)
- Add projectile.max-loads-per-tick and projectile.max-loads-per-projectile settings (default 10)
- EntityProjectile: limit unloaded chunk loading per tick and kill projectiles exceeding lifetime load budget

diff --git a/main/java/com/destroystokyo/paper/AntarcticConfig.java b/main/java/com/destroystokyo/paper/AntarcticConfig.java
index 6eacb9b..e2f4ca7 100644
--- a/main/java/com/destroystokyo/paper/AntarcticConfig.java
+++ b/main/java/com/destroystokyo/paper/AntarcticConfig.java
@@ -205,4 +205,16 @@ public class AntarcticConfig {
         enableSuffocationOptimization = getBoolean("suffocation-optimization", enableSuffocationOptimization);
     }
 
+    public static int maxProjectileLoadsPerTick = 10;
+    public static int maxProjectileLoadsPerProjectile = 10;
+    private static void projectileLoading() {
+        setComment("projectile.max-loads-per-tick",
+            "Maximum number of unloaded chunks that projectiles may trigger to load per server tick.",
+            "Helps mitigate lag machines that fire projectiles into distant unloaded chunks.");
+        maxProjectileLoadsPerTick = getInt("projectile.max-loads-per-tick", 10);
+        setComment("projectile.max-loads-per-projectile",
+            "Maximum number of unloaded chunks a single projectile can load before being removed.");
+        maxProjectileLoadsPerProjectile = getInt("projectile.max-loads-per-projectile", 10);
+    }
+
 }
diff --git a/main/java/net/minecraft/server/EntityProjectile.java b/main/java/net/minecraft/server/EntityProjectile.java
index 8e6428a..1b8338e 100644
--- a/main/java/net/minecraft/server/EntityProjectile.java
+++ b/main/java/net/minecraft/server/EntityProjectile.java
@@ -295,4 +295,34 @@ public abstract class EntityProjectile extends Entity implements IProjectile {
 
         return this.shooter;
     }
-}
+
+    // Antarctic start - reduce projectile chunk loading
+    private static int loadedThisTick = 0;
+    private static int loadedTick;
+
+    private int loadedLifetime = 0;
+    @Override
+    public void setPosition(double x, double y, double z) {
+        int currentTick = net.minecraft.server.MinecraftServer.currentTick;
+        if (loadedTick != currentTick) {
+            loadedTick = currentTick;
+            loadedThisTick = 0;
+        }
+        int previousX = MathHelper.floor(this.locX) >> 4, previousZ = MathHelper.floor(this.locZ) >> 4;
+        int newX = MathHelper.floor(x) >> 4, newZ = MathHelper.floor(z) >> 4;
+        if (previousX != newX || previousZ != newZ) {
+            boolean isLoaded = ((net.minecraft.server.ChunkProviderServer) this.world.getChunkProvider()).isLoaded(newX, newZ);
+            if (!isLoaded) {
+                if (EntityProjectile.loadedThisTick > com.destroystokyo.paper.AntarcticConfig.maxProjectileLoadsPerTick) {
+                    if (++this.loadedLifetime > com.destroystokyo.paper.AntarcticConfig.maxProjectileLoadsPerProjectile) {
+                        this.die();
+                    }
+                    return;
+                }
+                EntityProjectile.loadedThisTick++;
+            }
+        }
+        super.setPosition(x, y, z);
+    }
+    // Antarctic end
+}
\ No newline at end of file
