+    @Test
+    public void testTickListAndLightingPerf() throws Exception {
+        TestWorld world = createWorld();
+        Chunk center = world.getChunkIfLoaded(0, 0);
+        BlockPosition lightPos = new BlockPosition(8, 68, 8);
+
+        // Prepare 2,000 TEs for unload compaction benchmark
+        final int teCount = 2000;
+        List<TileEntity> allTes = new ArrayList<>(teCount);
+        List<TileEntity> toUnload = new ArrayList<>(500);
+        for (int i = 0; i < teCount; i++) {
+            TileEntityHopper h = new TileEntityHopper();
+            h.a(world);
+            allTes.add(h);
+            if ((i & 3) == 0) {
+                toUnload.add(h);
+            }
+        }
+        List<TileEntity> vanillaList = new ArrayList<>(teCount);
+        World.TickableTileEntityList optList = (World.TickableTileEntityList) world.tileEntityListTick;
+
+        final int warmup = 200;
+        long sink = 0L;
+
+        for (int i = 0; i < warmup; i++) {
+            vanillaList.clear();
+            vanillaList.addAll(allTes);
+            Set<TileEntity> removeSet = Collections.newSetFromMap(new IdentityHashMap<>());
+            removeSet.addAll(toUnload);
+            vanillaList.removeAll(removeSet);
+            sink += vanillaList.size();
+
+            for (int k = 0, s = toUnload.size(); k < s; k++) {
+                toUnload.get(k).antarcticPendingUnload = true;
+            }
+            optList.compactPendingUnloads();
+            for (int k = 0, s = toUnload.size(); k < s; k++) {
+                TileEntity te = toUnload.get(k);
+                te.antarcticPendingUnload = false;
+                optList.add(te);
+            }
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        bean.getThreadAllocatedBytes(tid);
+
+        // Vanilla: IdentityHashMap+removeAll unload + O(N) contains check + BlockPosition light setter
+        long vanBytes0 = bean.getThreadAllocatedBytes(tid);
+        long vanT0 = System.nanoTime();
+        for (int i = 0; i < 100; i++) {
+            vanillaList.clear();
+            vanillaList.addAll(allTes);
+            Set<TileEntity> removeSet = Collections.newSetFromMap(new IdentityHashMap<>());
+            removeSet.addAll(toUnload);
+            vanillaList.removeAll(removeSet);
+            if (vanillaList.contains(allTes.get(teCount - 1))) {
+                sink++;
+            }
+            sink += vanillaList.size();
+        }
+        for (int i = 0; i < 10000; i++) {
+            world.a(EnumSkyBlock.BLOCK, new BlockPosition(8, 68, 8), i & 15);
+        }
+        long vanNs = System.nanoTime() - vanT0;
+        long vanBytes = bean.getThreadAllocatedBytes(tid) - vanBytes0;
+
+        // Optimized: intrusive O(N) FIFO compaction + O(1) antarcticInTickList + primitive setLightFor
+        optList.clear();
+        optList.addAll(allTes);
+        long optBytes0 = bean.getThreadAllocatedBytes(tid);
+        long optT0 = System.nanoTime();
+        for (int i = 0; i < 100; i++) {
+            for (int k = 0, s = toUnload.size(); k < s; k++) {
+                toUnload.get(k).antarcticPendingUnload = true;
+            }
+            optList.compactPendingUnloads();
+            if (allTes.get(teCount - 1).antarcticInTickList) {
+                sink++;
+            }
+            sink += optList.size();
+            for (int k = 0, s = toUnload.size(); k < s; k++) {
+                TileEntity te = toUnload.get(k);
+                te.antarcticPendingUnload = false;
+                optList.add(te);
+            }
+        }
+        for (int i = 0; i < 10000; i++) {
+            world.setLightFor(EnumSkyBlock.BLOCK, 8, 68, 8, i & 15);
+        }
+        long optNs = System.nanoTime() - optT0;
+        long optBytes = bean.getThreadAllocatedBytes(tid) - optBytes0;
+
+        double speedup = (double) vanNs / Math.max(1L, optNs);
+        System.out.println("C6_BENCH vanilla_ns=" + vanNs + " opt_ns=" + optNs
+            + " speedup=" + String.format("%.2fx", speedup)
+            + " vanilla_bytes=" + vanBytes + " opt_bytes=" + optBytes + " sink=" + sink);
+
+        Assert.assertEquals("Optimized path should allocate 0 bytes", 0L, optBytes);
+        Assert.assertTrue("Expected >= 1.5x speedup, got " + speedup, speedup > 1.5D);
+    }
