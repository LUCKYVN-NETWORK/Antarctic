+    private static void vanillaChunkN(Chunk chunk, World world, List<BlockPosition> out) throws Exception {
+        Field xField = Chunk.class.getDeclaredField("x");
+        xField.setAccessible(true);
+        Field secField = Chunk.class.getDeclaredField("sections");
+        secField.setAccessible(true);
+        ChunkSection[] sections = (ChunkSection[]) secField.get(chunk);
+
+        int xVal = xField.getInt(chunk);
+        if (xVal < 4096) {
+            BlockPosition base = new BlockPosition(chunk.locX << 4, 0, chunk.locZ << 4);
+            for (int i = 0; i < 8; ++i) {
+                if (xVal >= 4096) {
+                    xField.setInt(chunk, xVal);
+                    return;
+                }
+                int j = xVal % 16;
+                int k = xVal / 16 % 16;
+                int l = xVal / 256;
+                ++xVal;
+                for (int i1 = 0; i1 < 16; ++i1) {
+                    BlockPosition pos1 = base.a(k, (j << 4) + i1, l);
+                    boolean flag = i1 == 0 || i1 == 15 || k == 0 || k == 15 || l == 0 || l == 15;
+                    if (sections[j] == Chunk.a && flag || sections[j] != Chunk.a && sections[j].getType(k, i1, l).getMaterial() == Material.AIR) {
+                        for (EnumDirection dir : EnumDirection.values()) {
+                            BlockPosition pos2 = pos1.shift(dir);
+                            IBlockData nd = world.getTypeIfLoaded(pos2);
+                            if (nd != null && nd.d() > 0) {
+                                out.add(pos2);
+                            }
+                        }
+                        out.add(pos1);
+                    }
+                }
+            }
+            xField.setInt(chunk, xVal);
+        }
+    }
