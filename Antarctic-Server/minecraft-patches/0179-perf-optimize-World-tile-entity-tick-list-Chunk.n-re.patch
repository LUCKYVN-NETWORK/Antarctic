+    @Test
+    public void testTickableListFifoUnloadAndDirectMutationParity() throws Exception {
+        TestWorld world = createWorld();
+        List<TileEntity> tes = new ArrayList<>();
+        for (int i = 0; i < 40; i++) {
+            TileEntityHopper h = new TileEntityHopper();
+            h.a(world);
+            h.setPosition(new BlockPosition(i & 15, 64, 0));
+            tes.add(h);
+            world.a(h);
+            world.a(h); // duplicate add must be ignored
+        }
+        Assert.assertEquals(40, world.tileEntityListTick.size());
+        for (TileEntity te : tes) {
+            Assert.assertTrue(te.antarcticInTickList);
+        }
+
+        // Non-tickable TE added to unload queue must not break or retain antarcticPendingUnload
+        TileEntityChest chest = new TileEntityChest();
+        chest.a(world);
+        world.a(chest);
+        Assert.assertFalse(chest.antarcticInTickList);
+        world.b(chest);
+
+        // Unload even indices
+        List<TileEntity> expected = new ArrayList<>();
+        for (int i = 0; i < 40; i++) {
+            if ((i & 1) == 0) {
+                world.b(tes.get(i));
+            } else {
+                expected.add(tes.get(i));
+            }
+        }
+
+        // Simulate unload drain in World.tickEntities()
+        Field unloadField = World.class.getDeclaredField("tileEntityListUnload");
+        unloadField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        Set<TileEntity> unloadSet = (Set<TileEntity>) unloadField.get(world);
+        for (TileEntity te : unloadSet) {
+            te.antarcticPendingUnload = true;
+        }
+        ((World.TickableTileEntityList) world.tileEntityListTick).compactPendingUnloads();
+        for (TileEntity te : unloadSet) {
+            te.antarcticPendingUnload = false;
+        }
+        unloadSet.clear();
+
+        Assert.assertEquals(expected, world.tileEntityListTick);
+        Assert.assertFalse(chest.antarcticPendingUnload);
+        for (int i = 0; i < 40; i++) {
+            Assert.assertFalse(tes.get(i).antarcticPendingUnload);
+            Assert.assertEquals((i & 1) != 0, tes.get(i).antarcticInTickList);
+        }
+
+        // Direct plugin mutation via List.remove(0) and iterator().remove()
+        TileEntity first = world.tileEntityListTick.remove(0);
+        Assert.assertFalse(first.antarcticInTickList);
+        world.a(first);
+        Assert.assertTrue(first.antarcticInTickList);
+
+        Iterator<TileEntity> it = world.tileEntityListTick.iterator();
+        TileEntity second = it.next();
+        it.remove();
+        Assert.assertFalse(second.antarcticInTickList);
+        world.tileEntityListTick.clear();
+        for (TileEntity te : tes) {
+            Assert.assertFalse(te.antarcticInTickList);
+        }
+    }
