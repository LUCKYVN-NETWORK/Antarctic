@@ -0,0 +1,24 @@
+package com.destroystokyo.paper.config.toml.modules.fixes;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+
+public class PistonDuplication implements IConfigModule {
+
+    @ConfigInfo(
+        baseName = "allow-piston-duplication",
+        comments = "Allow vanilla 1.12.2 piston rail/carpet/TNT self-duplication mechanics. Default true for 1.12.2 technical parity; set false to re-verify block state snapshots during piston moves."
+    )
+    public static boolean allowPistonDuplication = true;
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.FIXES;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "piston-duplication";
+    }
+}
