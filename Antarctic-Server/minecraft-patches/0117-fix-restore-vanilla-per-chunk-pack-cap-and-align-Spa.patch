+++ b/main/java/net/minecraft/server/SpawnerCreature.java
@@ -18,6 +18,10 @@ public final class SpawnerCreature {
     private static final int a = (int) Math.pow(17.0D, 2.0D);
     private final LongHashSet b = new LongHashSet(); // CraftBukkit
 
+    static int computeMobLimit(int limit, int eligibleChunks, int currentMobCount) {
+        return (limit * eligibleChunks / SpawnerCreature.a) - currentMobCount + 1;
+    }
