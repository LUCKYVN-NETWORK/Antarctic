     public SpawnerCreature() {}
 
     // Spigot start - get entity count only from chunks being processed in b
@@ -155,11 +159,11 @@ public final class SpawnerCreature {
                     int l1 = limit * i / a; // CraftBukkit - use per-world limits
                     */ // Paper end
 
-                    if ((mobcnt = worldserver.getCreatureCount(enumcreaturetype)) <= limit * i / 289) { // Paper - use 17x17 like vanilla (a at top of file) // Antarctic - O(1) tracked world count
+                    if ((mobcnt = worldserver.getCreatureCount(enumcreaturetype)) <= limit * i / SpawnerCreature.a) { // Paper - use 17x17 like vanilla (a at top of file) // Antarctic - O(1) tracked world count
                         BlockPosition.MutableBlockPosition blockposition_mutableblockposition = new BlockPosition.MutableBlockPosition();
                         Iterator iterator1 = this.b.iterator();
 
-                        int moblimit = (limit * i / 256) - mobcnt + 1; // Spigot - up to 1 more than limit
+                        int moblimit = computeMobLimit(limit, i, mobcnt); // Antarctic - align divisor with 17x17 (289) cap check above
                         label120:
                         while (iterator1.hasNext() && (moblimit > 0)) { // Spigot - while more allowed
                             // CraftBukkit start = use LongHash and LongObjectHashMap
@@ -247,12 +251,11 @@ public final class SpawnerCreature {
                                                                 entityinsentient.die();
                                                             }
 
-                                                            // Spigot start
-                                                            if ( moblimit <= 0 ) {
