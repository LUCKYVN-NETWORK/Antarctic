         // Paper end
-        if (this.m instanceof LoginListener) {
-            LoginListener loginListener = (LoginListener) this.m;
-            if (loginListener.getLoginState() != LoginListener.EnumProtocolState.READY_TO_ACCEPT  // Paper
-                    || (joinAttemptsThisTick++ < MAX_PER_TICK)) { // Paper - limit the number of joins which can be processed each tick
-                loginListener.e();
+        // Antarctic start - preserve single ITickable dispatch per tick and dynamic maxJoinsPerTick
+        if (this.m instanceof ITickable) {
+            if (this.m instanceof LoginListener) {
+                LoginListener loginListener = (LoginListener) this.m;
+                int maxPerTick = com.destroystokyo.paper.PaperConfig.maxJoinsPerTick;
+                if (loginListener.getLoginState() != LoginListener.EnumProtocolState.READY_TO_ACCEPT
+                        || maxPerTick <= 0
+                        || joinAttemptsThisTick++ < maxPerTick) {
+                    loginListener.e();
+                }
+            } else {
+                ((ITickable) this.m).e();
             }
