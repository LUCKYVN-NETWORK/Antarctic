diff --git a/test/java/net/minecraft/server/NetworkManagerTickDispatchTest.java b/test/java/net/minecraft/server/NetworkManagerTickDispatchTest.java
new file mode 100644
index 0000000..e6a0d0b
--- /dev/null
+++ b/test/java/net/minecraft/server/NetworkManagerTickDispatchTest.java
@@ -0,0 +1,149 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.PaperConfig;
+import java.lang.reflect.Field;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class NetworkManagerTickDispatchTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    private static final class CustomTickableListener implements PacketListener, ITickable {
+        int ticks;
+
+        @Override
+        public void a(IChatBaseComponent ichatbasecomponent) {
+        }
+
+        @Override
+        public void e() {
+            ticks++;
+        }
+    }
+
+    private static final class StubPlayerConnection extends PlayerConnection {
+        int ticks;
+
+        StubPlayerConnection() {
+            super(null, null, null);
+        }
+
+        @Override
+        public void e() {
+            ticks++;
+        }
+    }
+
+    private static final class TransitionLoginListener extends LoginListener {
+        int ticks;
+        NetworkManager nm;
+        PlayerConnection nextConnection;
+
+        TransitionLoginListener() {
+            super(null, null);
+        }
+
+        @Override
+        public void e() {
+            ticks++;
+            if (nextConnection != null) {
+                nm.setPacketListener(nextConnection);
+            }
+        }
+    }
+
+    private static void setLoginState(LoginListener listener, LoginListener.EnumProtocolState state) throws Exception {
+        Field g = LoginListener.class.getDeclaredField("g");
+        g.setAccessible(true);
+        g.set(listener, state);
+    }
+
+    @Test
+    public void testCustomITickableListenerStillTicks() {
+        NetworkManager nm = new NetworkManager(EnumProtocolDirection.SERVERBOUND);
+        CustomTickableListener custom = new CustomTickableListener();
+        nm.setPacketListener(custom);
+
+        nm.a();
+        nm.a();
+
+        Assert.assertEquals("Custom ITickable PacketListener must tick once per NetworkManager.a()", 2, custom.ticks);
+    }
+
+    @Test
+    public void testLoginTransitionDoesNotDoubleTickPlayerConnectionOnSameTick() throws Exception {
+        int prevMax = PaperConfig.maxJoinsPerTick;
+        int prevTick = MinecraftServer.currentTick;
+        try {
+            PaperConfig.maxJoinsPerTick = 5;
+            MinecraftServer.currentTick = prevTick + 101;
+
+            NetworkManager nm = new NetworkManager(EnumProtocolDirection.SERVERBOUND);
+            TransitionLoginListener login = (TransitionLoginListener) unsafe.allocateInstance(TransitionLoginListener.class);
+            StubPlayerConnection conn = (StubPlayerConnection) unsafe.allocateInstance(StubPlayerConnection.class);
+            login.nm = nm;
+            login.nextConnection = conn;
+            setLoginState(login, LoginListener.EnumProtocolState.READY_TO_ACCEPT);
+            nm.setPacketListener(login);
+
+            // Tick 1: LoginListener accepts and transitions packet listener to PlayerConnection.
+            // PlayerConnection must NOT also tick on this same tick.
+            nm.a();
+            Assert.assertEquals(1, login.ticks);
+            Assert.assertEquals("PlayerConnection must not double-tick on join tick", 0, conn.ticks);
+
+            // Tick 2: Now PlayerConnection ticks normally.
+            nm.a();
+            Assert.assertEquals(1, login.ticks);
+            Assert.assertEquals(1, conn.ticks);
+        } finally {
+            PaperConfig.maxJoinsPerTick = prevMax;
+            MinecraftServer.currentTick = prevTick;
+        }
+    }
+
+    @Test
+    public void testDynamicMaxJoinsPerTickHonoredAndZeroDoesNotLockOut() throws Exception {
+        int prevMax = PaperConfig.maxJoinsPerTick;
+        int prevTick = MinecraftServer.currentTick;
+        try {
+            MinecraftServer.currentTick = prevTick + 202;
+            PaperConfig.maxJoinsPerTick = 1;
+
+            NetworkManager nm1 = new NetworkManager(EnumProtocolDirection.SERVERBOUND);
+            NetworkManager nm2 = new NetworkManager(EnumProtocolDirection.SERVERBOUND);
+            TransitionLoginListener l1 = (TransitionLoginListener) unsafe.allocateInstance(TransitionLoginListener.class);
+            TransitionLoginListener l2 = (TransitionLoginListener) unsafe.allocateInstance(TransitionLoginListener.class);
+            setLoginState(l1, LoginListener.EnumProtocolState.READY_TO_ACCEPT);
+            setLoginState(l2, LoginListener.EnumProtocolState.READY_TO_ACCEPT);
+            nm1.setPacketListener(l1);
+            nm2.setPacketListener(l2);
+
+            nm1.a();
+            nm2.a();
+            Assert.assertEquals("First login within maxJoinsPerTick=1 must run", 1, l1.ticks);
+            Assert.assertEquals("Second login exceeding maxJoinsPerTick=1 must be deferred", 0, l2.ticks);
+
+            // Dynamically change config to <= 0 (unlimited) on next tick
+            MinecraftServer.currentTick = prevTick + 203;
+            PaperConfig.maxJoinsPerTick = 0;
+            nm1.a();
+            nm2.a();
+            Assert.assertEquals(2, l1.ticks);
+            Assert.assertEquals("maxJoinsPerTick <= 0 must not lock out logins", 1, l2.ticks);
+        } finally {
+            PaperConfig.maxJoinsPerTick = prevMax;
+            MinecraftServer.currentTick = prevTick;
+        }
+    }
+}
