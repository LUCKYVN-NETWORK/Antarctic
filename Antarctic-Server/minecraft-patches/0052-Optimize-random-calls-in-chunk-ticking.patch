From: nopjmp <kthompson@hey.com>
Date: Thu, 11 Mar 2021 23:21:10 -0600
Subject: [PATCH 052/139] Optimize random calls in chunk ticking

- Backport Dionysus server/0033-Optimize-random-calls-in-chunk-ticking.patch
- Source: https://github.com/nopjmp/Dionysus at b5c71b62f6f1f555b22bd52f5751e33be4690b6e
- Chunk: maintain lightningTick interval instead of running RNG every tick
- WorldServer: use single incrementing counter for ice and snow checks across chunks

diff --git a/main/java/net/minecraft/server/Chunk.java b/main/java/net/minecraft/server/Chunk.java
index a86744b..f4233ed 100644
--- a/main/java/net/minecraft/server/Chunk.java
+++ b/main/java/net/minecraft/server/Chunk.java
@@ -121,6 +121,18 @@ public class Chunk {
     }
     // CraftBukkit end
 
+    // Airplane start - instead of using a random every time the chunk is ticked, define when lightning strikes preemptively
+    private int lightningTick;
+    // shouldDoLightning compiles down to 29 bytes, which with the default of 35 byte inlining should guarantee an inline
+    public final boolean shouldDoLightning(Random random) {
+        if (this.lightningTick-- <= 0) {
+            this.lightningTick = random.nextInt(100000) << 1;
+            return true;
+        }
+        return false;
+    }
+    // Airplane end
+
     public Chunk(World world, int i, int j) {
         this.sections = new ChunkSection[16];
         this.g = new byte[256];
@@ -144,6 +156,8 @@ public class Chunk {
         // CraftBukkit start
         this.bukkitChunk = new org.bukkit.craftbukkit.CraftChunk(this);
         this.chunkKey = ChunkCoordIntPair.a(this.locX, this.locZ);
+
+        this.lightningTick = this.world.random.nextInt(100000) << 1; // Airplane - initialize lightning tick
     }
 
     public org.bukkit.Chunk bukkitChunk;
