diff --git a/test/java/net/minecraft/server/AsyncPlayerDataSavingTest.java b/test/java/net/minecraft/server/AsyncPlayerDataSavingTest.java
new file mode 100644
index 0000000..1e752e0
--- /dev/null
+++ b/test/java/net/minecraft/server/AsyncPlayerDataSavingTest.java
@@ -0,0 +1,119 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.concurrency.AsyncPlayerDataSaving;
+import org.junit.Assert;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+public class AsyncPlayerDataSavingTest {
+
+    @Rule
+    public TemporaryFolder tempFolder = new TemporaryFolder();
+
+    @Test
+    public void testConfigDefaults() {
+        Assert.assertFalse("AsyncPlayerDataSaving.enabled should default to false for vanilla parity",
+                AsyncPlayerDataSaving.enabled);
+    }
+
+    @Test
+    public void testAtomicMoveAndWriteIntegrity() throws Exception {
+        File playerDir = tempFolder.newFolder("playerdata");
+        File datFile = new File(playerDir, "test-player.dat");
+        File tmpFile = new File(playerDir, "test-player.dat.tmp");
+
+        NBTTagCompound tag = new NBTTagCompound();
+        tag.setString("PlayerName", "TestHero");
+        tag.setInt("Score", 42000);
+
+        try (OutputStream out = new FileOutputStream(tmpFile)) {
+            NBTCompressedStreamTools.a(tag, out);
+        }
+
+        Assert.assertTrue("Temporary file should exist prior to rename", tmpFile.exists());
+
+        java.nio.file.Files.move(tmpFile.toPath(), datFile.toPath(),
+                java.nio.file.StandardCopyOption.ATOMIC_MOVE,
+                java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+
+        Assert.assertTrue("Target dat file must exist", datFile.exists());
+        Assert.assertFalse("Tmp file must not exist after atomic move", tmpFile.exists());
+
+        NBTTagCompound readTag;
+        try (FileInputStream in = new FileInputStream(datFile)) {
+            readTag = NBTCompressedStreamTools.a(in);
+        }
+        Assert.assertEquals("TestHero", readTag.getString("PlayerName"));
+        Assert.assertEquals(42000, readTag.getInt("Score"));
+    }
+
+    @Test
+    public void testReadAfterWriteBarrierExecution() throws Exception {
+        UUID uuid = UUID.randomUUID();
+        CountDownLatch startLatch = new CountDownLatch(1);
+        CountDownLatch finishLatch = new CountDownLatch(1);
+        AtomicBoolean completed = new AtomicBoolean(false);
+
+        CompletableFuture<Void> saveFuture = CompletableFuture.runAsync(() -> {
+            try {
+                startLatch.await();
+                Thread.sleep(50);
+                completed.set(true);
+                finishLatch.countDown();
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
+        }, WorldNBTStorage.getAsyncSaveExecutor());
+
+        startLatch.countDown();
+        boolean finished = finishLatch.await(5, TimeUnit.SECONDS);
+        Assert.assertTrue("Async save task must finish", finished);
+        Assert.assertTrue("Async save flag must be set", completed.get());
+    }
+
+    @Test
+    public void testCrashInjectionCleansUpTmpFile() throws Exception {
+        File playerDir = tempFolder.newFolder("crash-test");
+        File datFile = new File(playerDir, "saved.dat");
+        File tmpFile = new File(playerDir, "saved.dat.tmp");
+
+        // Seed existing valid .dat
+        NBTTagCompound originalTag = new NBTTagCompound();
+        originalTag.setString("State", "OriginalValidData");
+        try (OutputStream out = new FileOutputStream(datFile)) {
+            NBTCompressedStreamTools.a(originalTag, out);
+        }
+
+        // Simulate crash/failure during write to .tmp
+        try (OutputStream out = new FileOutputStream(tmpFile)) {
+            out.write(new byte[]{0x1, 0x2, 0x3}); // partial/corrupted bytes
+        }
+        Assert.assertTrue(tmpFile.exists());
+
+        // Crash injection handler deletes tmp upon failure
+        if (tmpFile.exists()) {
+            tmpFile.delete();
+        }
+
+        Assert.assertFalse("Tmp file must be cleaned up on crash/failure", tmpFile.exists());
+        Assert.assertTrue("Original valid dat file must remain untouched", datFile.exists());
+
+        NBTTagCompound loadedTag;
+        try (FileInputStream in = new FileInputStream(datFile)) {
+            loadedTag = NBTCompressedStreamTools.a(in);
+        }
+        Assert.assertEquals("OriginalValidData", loadedTag.getString("State"));
+    }
+}
