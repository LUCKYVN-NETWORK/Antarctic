+    private static ExecutorService buildAsyncSaveExecutor() {
+        try {
+            return Executors.newThreadPerTaskExecutor(
+                    Thread.ofVirtual().name("Async PlayerData #", 0).factory()
+            );
+        } catch (Throwable t) {
+            return Executors.newCachedThreadPool(
+                    new com.google.common.util.concurrent.ThreadFactoryBuilder()
+                            .setNameFormat("Async PlayerData #%d")
+                            .setDaemon(true)
+                            .build()
+            );
+        }
+    }
+
+    public static ExecutorService getAsyncSaveExecutor() {
+        return asyncSaveExecutor;
+    }
+
+    public static CompletableFuture<Void> getPendingSave(UUID uuid) {
+        return pendingSaves.get(uuid);
+    }
+
+    public static boolean hasPendingSave(UUID uuid) {
+        return pendingSaves.containsKey(uuid);
+    }
+
+    public static void awaitPendingSave(UUID uuid) {
+        CompletableFuture<Void> future = pendingSaves.get(uuid);
+        if (future != null) {
+            try {
+                future.get(15, TimeUnit.SECONDS);
+            } catch (Exception e) {
+                b.error("Failed to await in-flight player data save for {}", uuid, e);
+            }
+        }
+    }
+
+    public static void awaitAllPendingSaves() {
+        long deadline = System.currentTimeMillis() + 30000L;
+        while (!pendingSaves.isEmpty() && System.currentTimeMillis() < deadline) {
+            CompletableFuture<?>[] futures = pendingSaves.values().toArray(new CompletableFuture[0]);
+            if (futures.length == 0) break;
+            try {
+                CompletableFuture.allOf(futures).get(Math.max(1, deadline - System.currentTimeMillis()), TimeUnit.MILLISECONDS);
+            } catch (Exception e) {
+                b.error("Failed to await all pending player data saves", e);
+                break;
+            }
+        }
+    }
