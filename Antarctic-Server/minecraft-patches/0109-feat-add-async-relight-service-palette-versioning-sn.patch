diff --git a/main/java/net/minecraft/server/RelightService.java b/main/java/net/minecraft/server/RelightService.java
new file mode 100644
index 0000000..a19b221
--- /dev/null
+++ b/main/java/net/minecraft/server/RelightService.java
@@ -0,0 +1,606 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.Lighting;
+import it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap;
+import it.unimi.dsi.fastutil.longs.Long2LongOpenHashMap;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.longs.LongArrayList;
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import me.stella.antarctic.light.HeightMaps;
+import me.stella.antarctic.light.LightColumn;
+import me.stella.antarctic.light.LightEngine;
+import me.stella.antarctic.light.LightRegion;
+import me.stella.antarctic.light.LightResult;
+import me.stella.antarctic.light.LightRules;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Per-world main-thread coordinator for asynchronous bulk relighting.
+ *
+ * <p>Architecture: requests are partitioned into 8x8 chunk tiles, snapshotted on the main thread within
+ * {@link Lighting#relightSnapshotBudgetMs}, computed on immutable {@link LightRegion} copies by a small platform-thread
+ * worker pool (never touching live NMS structures off-thread), and applied strictly in sequence-number order on the main
+ * thread within {@link Lighting#relightApplyBudgetMs}. Every target chunk is validated against chunk identity, section
+ * identity, palette identity, and {@link DataPaletteBlock#antarcticVersion} before writing nibbles; mismatches resubmit
+ * once and then fall back to the synchronous engine on the main thread.
+ *
+ * <p>Antarctic - rebuilt from the design of Starlight (Spottedleaf / PaperMC; LGPL-3.0). No code is copied.
+ */
+public final class RelightService {
+
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final int TILE_SHIFT = 3; // 8x8 chunk tiles
+
+    private final WorldServer world;
+    private final LightEngine engine = new LightEngine();
+    private final LightEngine.Scratch mainThreadScratch = new LightEngine.Scratch();
+    private final ThreadLocal<LightEngine.Scratch> workerScratch = ThreadLocal.withInitial(LightEngine.Scratch::new);
+    private final int poolSize;
+    private final ExecutorService workers;
+
+    private final ArrayDeque<PendingTile> queuedTiles = new ArrayDeque<>();
+    private final ConcurrentLinkedQueue<TileResult> completedQueue = new ConcurrentLinkedQueue<>();
+    private final Long2ObjectOpenHashMap<TileResult> readyBySeq = new Long2ObjectOpenHashMap<>();
+    private final Long2LongOpenHashMap latestSnapshottedSeq = new Long2LongOpenHashMap();
+    private final Long2IntOpenHashMap pendingChunkCounts = new Long2IntOpenHashMap();
+
+    private long nextSeq = 1L;
+    private long nextApplySeq = 1L;
+    private int inFlightTiles = 0;
+    private boolean shutdown = false;
+
+    public RelightService(WorldServer world) {
+        this.world = world;
+        this.latestSnapshottedSeq.defaultReturnValue(-1L);
+        this.pendingChunkCounts.defaultReturnValue(0);
+        int configured = Lighting.asyncRelightThreads;
+        this.poolSize = configured > 0 ? configured : Math.max(1, Math.min(4, Runtime.getRuntime().availableProcessors() / 2));
+        final String worldName = world.worldData != null && world.worldData.getName() != null ? world.worldData.getName() : "world";
+        final AtomicInteger counter = new AtomicInteger(1);
+        this.workers = Executors.newFixedThreadPool(this.poolSize, new ThreadFactory() {
+            @Override
+            public Thread newThread(Runnable r) {
+                Thread t = new Thread(r, "Antarctic-Relight-" + worldName + "-" + counter.getAndIncrement());
+                t.setDaemon(true);
+                return t;
+            }
+        });
+    }
+
+    /**
+     * Submits a batch of chunk keys (packed via {@link ChunkCoordIntPair#a(int, int)}) for asynchronous relight.
+     * Main-thread only. The returned future completes on the main thread with the number of chunks applied.
+     */
+    public CompletableFuture<Integer> submit(long[] chunkKeys) {
+        org.spigotmc.AsyncCatcher.catchOp("Async relight submission");
+        if (this.shutdown) {
+            CompletableFuture<Integer> failed = new CompletableFuture<>();
+            failed.completeExceptionally(new IllegalStateException("RelightService is shut down"));
+            return failed;
+        }
+        if (chunkKeys == null || chunkKeys.length == 0) {
+            return CompletableFuture.completedFuture(0);
+        }
+        if (chunkKeys.length > Lighting.maxRelightChunksPerRequest) {
+            CompletableFuture<Integer> failed = new CompletableFuture<>();
+            failed.completeExceptionally(new IllegalArgumentException(
+                "Relight request of " + chunkKeys.length + " chunks exceeds limit " + Lighting.maxRelightChunksPerRequest));
+            return failed;
+        }
+
+        // Deduplicate and partition into 8x8 tiles
+        LongOpenHashSet seen = new LongOpenHashSet(chunkKeys.length);
+        Long2ObjectOpenHashMap<LongArrayList> byTile = new Long2ObjectOpenHashMap<>();
+        for (long key : chunkKeys) {
+            if (!seen.add(key)) {
+                continue;
+            }
+            int cx = (int) key;
+            int cz = (int) (key >>> 32);
+            long tileKey = ChunkCoordIntPair.a(Math.floorDiv(cx, 1 << TILE_SHIFT), Math.floorDiv(cz, 1 << TILE_SHIFT));
+            LongArrayList list = byTile.get(tileKey);
+            if (list == null) {
+                list = new LongArrayList(8);
+                byTile.put(tileKey, list);
+            }
+            list.add(key);
+        }
+
+        RequestState request = new RequestState(byTile.size());
+        for (LongArrayList tileChunks : byTile.values()) {
+            long[] keys = tileChunks.toLongArray();
+            long seq = this.nextSeq++;
+            this.incrementPending(keys);
+            this.queuedTiles.addLast(new PendingTile(seq, keys, request, 0));
+        }
+        return request.future;
+    }
+
+    /** True if the chunk currently has any relight queued, snapshotted, in flight, or awaiting apply. */
+    public boolean isPending(long chunkKey) {
+        return this.pendingChunkCounts.get(chunkKey) > 0;
+    }
+
+    public int pendingTileCount() {
+        return this.queuedTiles.size() + this.inFlightTiles + this.readyBySeq.size();
+    }
+
+    /** Main-thread tick: applies completed tiles in strict sequence order, then snapshots queued tiles within budgets. */
+    public void tick() {
+        if (this.shutdown) {
+            return;
+        }
+        this.applyCompletedWithinBudget();
+        this.snapshotQueuedWithinBudget();
+    }
+
+    private void snapshotQueuedWithinBudget() {
+        int maxInFlight = this.poolSize * 2;
+        if (this.queuedTiles.isEmpty() || this.inFlightTiles >= maxInFlight) {
+            return;
+        }
+        long deadline = System.nanoTime() + Lighting.relightSnapshotBudgetMs * 1_000_000L;
+        int snapshotted = 0;
+        while (!this.queuedTiles.isEmpty() && this.inFlightTiles < maxInFlight) {
+            if (snapshotted > 0 && System.nanoTime() >= deadline) {
+                break;
+            }
+            PendingTile tile = this.queuedTiles.pollFirst();
+            TileSnapshot snapshot = this.buildTileSnapshot(tile);
+            snapshotted++;
+            if (snapshot == null) {
+                // No loaded chunks in this tile: post empty result immediately so sequence ordering stays contiguous
+                this.completedQueue.add(new TileResult(tile, null, null, null));
+                continue;
+            }
+            this.inFlightTiles++;
+            this.workers.execute(() -> {
+                LightResult result = null;
+                Throwable error = null;
+                try {
+                    result = this.engine.relight(snapshot.region, this.workerScratch.get());
+                } catch (Throwable t) {
+                    error = t;
+                }
+                this.completedQueue.add(new TileResult(tile, snapshot, result, error));
+            });
+        }
+    }
+
+    private TileSnapshot buildTileSnapshot(PendingTile tile) {
+        int minX = Integer.MAX_VALUE;
+        int maxX = Integer.MIN_VALUE;
+        int minZ = Integer.MAX_VALUE;
+        int maxZ = Integer.MIN_VALUE;
+
+        List<TargetChunkSnapshot> targets = new ArrayList<>(tile.chunkKeys.length);
+        LongOpenHashSet targetKeySet = new LongOpenHashSet(tile.chunkKeys.length);
+        for (long key : tile.chunkKeys) {
+            int cx = (int) key;
+            int cz = (int) (key >>> 32);
+            Chunk chunk = this.world.getChunkIfLoaded(cx, cz);
+            if (chunk == null) {
+                continue;
+            }
+            if (cx < minX) minX = cx;
+            if (cx > maxX) maxX = cx;
+            if (cz < minZ) minZ = cz;
+            if (cz > maxZ) maxZ = cz;
+            targetKeySet.add(key);
+
+            TargetChunkSnapshot snap = snapshotTargetChunk(chunk, cx, cz, key);
+            targets.add(snap);
+            // Record supersession watermark at snapshot time (Design §5.4)
+            long prev = this.latestSnapshottedSeq.get(key);
+            if (tile.seq > prev) {
+                this.latestSnapshottedSeq.put(key, tile.seq);
+            }
+        }
+        if (targets.isEmpty()) {
+            return null;
+        }
+
+        // Expand by 1-chunk ring on all 4 sides
+        int regionMinX = minX - 1;
+        int regionMinZ = minZ - 1;
+        int width = (maxX - minX) + 3;
+        int depth = (maxZ - minZ) + 3;
+        boolean hasSky = this.world.worldProvider != null && this.world.worldProvider.m();
+        LightRegion region = new LightRegion(regionMinX, regionMinZ, width, depth, hasSky);
+
+        for (TargetChunkSnapshot snap : targets) {
+            region.put(snap.cx, snap.cz, snap.column, true);
+        }
+
+        // Populate 1-chunk ring around target bounding box with immutable light copies
+        for (int cx = regionMinX; cx < regionMinX + width; ++cx) {
+            for (int cz = regionMinZ; cz < regionMinZ + depth; ++cz) {
+                long key = ChunkCoordIntPair.a(cx, cz);
+                if (targetKeySet.contains(key)) {
+                    continue;
+                }
+                Chunk ringChunk = this.world.getChunkIfLoaded(cx, cz);
+                if (ringChunk != null) {
+                    region.put(cx, cz, snapshotRingChunk(ringChunk, hasSky), false);
+                }
+            }
+        }
+
+        return new TileSnapshot(region, targets);
+    }
+
+    private static TargetChunkSnapshot snapshotTargetChunk(Chunk chunk, int cx, int cz, long key) {
+        ChunkSection[] liveSections = chunk.getSections();
+        ChunkSection[] snapSections = new ChunkSection[LightRules.SECTIONS];
+        DataPaletteBlock[] snapPalettes = new DataPaletteBlock[LightRules.SECTIONS];
+        int[] snapVersions = new int[LightRules.SECTIONS];
+        byte[][] packedCells = new byte[LightRules.SECTIONS][];
+
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            ChunkSection sec = liveSections[s];
+            snapSections[s] = sec;
+            if (sec != Chunk.a) {
+                DataPaletteBlock blocks = sec.getBlocks();
+                snapPalettes[s] = blocks;
+                snapVersions[s] = blocks.antarcticVersion;
+                byte[] cells = new byte[LightRules.SECTION_CELLS];
+                blocks.packLightCells(cells);
+                packedCells[s] = cells;
+            }
+        }
+
+        int[] heights = HeightMaps.compute(packedCells);
+        LightColumn column = new LightColumn(heights);
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            if (packedCells[s] != null) {
+                column.setCells(s, packedCells[s]);
+            }
+        }
+        return new TargetChunkSnapshot(chunk, cx, cz, key, snapSections, snapPalettes, snapVersions, heights, column);
+    }
+
+    private static LightColumn snapshotRingChunk(Chunk chunk, boolean hasSky) {
+        int[] heightCopy = chunk.r().clone();
+        LightColumn column = new LightColumn(heightCopy);
+        ChunkSection[] sections = chunk.getSections();
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            ChunkSection sec = sections[s];
+            if (sec != Chunk.a) {
+                byte[] sky = hasSky && sec.getSkyLightArray() != null ? sec.getSkyLightArray().asBytes().clone() : null;
+                byte[] block = sec.getEmittedLightArray() != null ? sec.getEmittedLightArray().asBytes().clone() : null;
+                column.setStored(s, sky, block);
+            }
+        }
+        return column;
+    }
+
+    private void applyCompletedWithinBudget() {
+        TileResult polled;
+        while ((polled = this.completedQueue.poll()) != null) {
+            if (polled.snapshot != null) {
+                this.inFlightTiles = Math.max(0, this.inFlightTiles - 1);
+            }
+            this.readyBySeq.put(polled.tile.seq, polled);
+        }
+
+        long deadline = System.nanoTime() + Lighting.relightApplyBudgetMs * 1_000_000L;
+        int appliedTiles = 0;
+        while (this.readyBySeq.containsKey(this.nextApplySeq)) {
+            if (appliedTiles > 0 && System.nanoTime() >= deadline) {
+                break;
+            }
+            TileResult tr = this.readyBySeq.remove(this.nextApplySeq++);
+            this.processTileResult(tr);
+            appliedTiles++;
+        }
+    }
+
+    private void processTileResult(TileResult tr) {
+        PendingTile tile = tr.tile;
+        try {
+            if (tr.snapshot == null) {
+                tile.request.onTileFinished(0);
+                return;
+            }
+
+            LightResult result = tr.result;
+            if (tr.error != null) {
+                LOGGER.warn("Async relight worker failed for tile seq={}; running synchronous fallback", tile.seq, tr.error);
+                try {
+                    result = this.engine.relight(tr.snapshot.region, this.mainThreadScratch);
+                } catch (Throwable syncErr) {
+                    LOGGER.error("Synchronous relight fallback failed for tile seq={}", tile.seq, syncErr);
+                    tile.request.onTileFinished(0);
+                    return;
+                }
+            }
+
+            int appliedInTile = 0;
+            LongArrayList toRetry = null;
+            boolean hasSky = this.world.worldProvider != null && this.world.worldProvider.m();
+
+            for (TargetChunkSnapshot snap : tr.snapshot.targets) {
+                // §5.5 Never touch an unloaded or replaced chunk
+                Chunk live = this.world.getChunkIfLoaded(snap.cx, snap.cz);
+                if (live != snap.chunk) {
+                    continue;
+                }
+                // §5.4 Supersession: drop older result if a newer snapshot for this chunk has already been taken
+                if (this.latestSnapshottedSeq.get(snap.key) > tile.seq) {
+                    continue;
+                }
+
+                // §5.2 Validate section/palette identity and version counter
+                if (!matchesSnapshot(live, snap)) {
+                    if (tile.retries == 0) {
+                        if (toRetry == null) {
+                            toRetry = new LongArrayList(4);
+                        }
+                        toRetry.add(snap.key);
+                    } else {
+                        // Second mismatch: deterministic synchronous fallback on main thread
+                        if (this.applySingleChunkSync(live, snap.cx, snap.cz, hasSky)) {
+                            appliedInTile++;
+                        }
+                    }
+                    continue;
+                }
+
+                this.writeLightToChunk(live, snap.cx, snap.cz, snap.heights, result, hasSky);
+                this.onChunkApplied(live, snap.cx, snap.cz);
+                appliedInTile++;
+            }
+
+            if (toRetry != null && !toRetry.isEmpty()) {
+                long[] retryKeys = toRetry.toLongArray();
+                long retrySeq = this.nextSeq++;
+                tile.request.addRetryTile();
+                this.incrementPending(retryKeys);
+                this.queuedTiles.addLast(new PendingTile(retrySeq, retryKeys, tile.request, tile.retries + 1));
+            }
+            tile.request.onTileFinished(appliedInTile);
+        } finally {
+            this.decrementPending(tile.chunkKeys, tile.seq);
+        }
+    }
+
+    private boolean applySingleChunkSync(Chunk live, int cx, int cz, boolean hasSky) {
+        try {
+            long key = ChunkCoordIntPair.a(cx, cz);
+            TargetChunkSnapshot fresh = snapshotTargetChunk(live, cx, cz, key);
+            LightRegion region = new LightRegion(cx - 1, cz - 1, 3, 3, hasSky);
+            region.put(cx, cz, fresh.column, true);
+            for (int dx = -1; dx <= 1; ++dx) {
+                for (int dz = -1; dz <= 1; ++dz) {
+                    if (dx == 0 && dz == 0) continue;
+                    Chunk ring = this.world.getChunkIfLoaded(cx + dx, cz + dz);
+                    if (ring != null) {
+                        region.put(cx + dx, cz + dz, snapshotRingChunk(ring, hasSky), false);
+                    }
+                }
+            }
+            LightResult syncResult = this.engine.relight(region, this.mainThreadScratch);
+            this.writeLightToChunk(live, cx, cz, fresh.heights, syncResult, hasSky);
+            this.onChunkApplied(live, cx, cz);
+            return true;
+        } catch (Throwable t) {
+            LOGGER.error("Synchronous relight fallback failed for chunk {},{}", cx, cz, t);
+            return false;
+        }
+    }
+
+    private void writeLightToChunk(Chunk live, int cx, int cz, int[] computedHeights, LightResult result, boolean hasSky) {
+        // Clarification 1: write recomputed HeightMaps back to Chunk.r() if stale
+        int[] liveHeights = live.r();
+        if (liveHeights != null && liveHeights.length == 256) {
+            int minHeight = Integer.MAX_VALUE;
+            boolean heightChanged = false;
+            for (int i = 0; i < 256; ++i) {
+                int h = computedHeights[i];
+                if (h < minHeight) {
+                    minHeight = h;
+                }
+                if (liveHeights[i] != h) {
+                    liveHeights[i] = h;
+                    heightChanged = true;
+                }
+            }
+            if (heightChanged) {
+                live.f(true);
+            }
+        }
+
+        // Clarification 2: write nibbles and instantiate missing sections directly without Chunk.initLighting()
+        ChunkSection[] sections = live.getSections();
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            byte[] skyNibbles = hasSky ? result.sky(cx, cz, s) : null;
+            byte[] blockNibbles = result.block(cx, cz, s);
+            if (skyNibbles == null && blockNibbles == null) {
+                continue;
+            }
+            ChunkSection sec = sections[s];
+            if (sec == Chunk.a) {
+                IBlockData[] predefined = this.world.chunkPacketBlockController != null
+                    ? this.world.chunkPacketBlockController.getPredefinedBlockData(live, s)
+                    : null;
+                sec = new ChunkSection(s << 4, hasSky, predefined);
+                sections[s] = sec;
+            }
+            if (blockNibbles != null) {
+                NibbleArray emitted = sec.getEmittedLightArray();
+                if (emitted != null && emitted.asBytes().length == blockNibbles.length) {
+                    System.arraycopy(blockNibbles, 0, emitted.asBytes(), 0, blockNibbles.length);
+                } else {
+                    sec.a(new NibbleArray(blockNibbles.clone()));
+                }
+            }
+            if (hasSky && skyNibbles != null) {
+                NibbleArray skyArr = sec.getSkyLightArray();
+                if (skyArr != null && skyArr.asBytes().length == skyNibbles.length) {
+                    System.arraycopy(skyNibbles, 0, skyArr.asBytes(), 0, skyNibbles.length);
+                } else {
+                    sec.b(new NibbleArray(skyNibbles.clone()));
+                }
+            }
+        }
+
+        // Clarification 3: mark dirty and lit=true so relit chunks exit the Chunk.o() per-tick retry loop
+        live.f(true);
+        live.e(true);
+        if (Lighting.saveAfterRelight) {
+            live.setLastSaved(0L);
+        }
+    }
+
+    /** Hook invoked on main thread immediately after a chunk's light is written (wired to LightChecker verifier in Commit C3). */
+    void onChunkApplied(Chunk live, int cx, int cz) {
+    }
+
+    private static boolean matchesSnapshot(Chunk live, TargetChunkSnapshot snap) {
+        ChunkSection[] sections = live.getSections();
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            ChunkSection liveSec = sections[s];
+            if (liveSec != snap.sections[s]) {
+                return false;
+            }
+            if (liveSec != Chunk.a) {
+                DataPaletteBlock liveBlocks = liveSec.getBlocks();
+                if (liveBlocks != snap.palettes[s] || liveBlocks.antarcticVersion != snap.versions[s]) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private void incrementPending(long[] keys) {
+        for (long key : keys) {
+            this.pendingChunkCounts.addTo(key, 1);
+        }
+    }
+
+    private void decrementPending(long[] keys, long completedSeq) {
+        for (long key : keys) {
+            int rem = this.pendingChunkCounts.addTo(key, -1) - 1;
+            if (rem <= 0) {
+                this.pendingChunkCounts.remove(key);
+                if (this.latestSnapshottedSeq.get(key) <= completedSeq) {
+                    this.latestSnapshottedSeq.remove(key);
+                }
+            }
+        }
+    }
+
+    public void shutdown() {
+        this.shutdown = true;
+        this.workers.shutdownNow();
+        try {
+            this.workers.awaitTermination(2L, TimeUnit.SECONDS);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+        this.queuedTiles.clear();
+        this.completedQueue.clear();
+        this.readyBySeq.clear();
+        this.pendingChunkCounts.clear();
+        this.latestSnapshottedSeq.clear();
+    }
+
+    // ----------------------------------------------------------------------------- internal state records
+
+    private static final class RequestState {
+        final CompletableFuture<Integer> future = new CompletableFuture<>();
+        int remainingTiles;
+        int appliedChunks;
+
+        RequestState(int tiles) {
+            this.remainingTiles = tiles;
+        }
+
+        void addRetryTile() {
+            this.remainingTiles++;
+        }
+
+        void onTileFinished(int applied) {
+            this.appliedChunks += applied;
+            if (--this.remainingTiles <= 0 && !this.future.isDone()) {
+                this.future.complete(this.appliedChunks);
+            }
+        }
+    }
+
+    private static final class PendingTile {
+        final long seq;
+        final long[] chunkKeys;
+        final RequestState request;
+        final int retries;
+
+        PendingTile(long seq, long[] chunkKeys, RequestState request, int retries) {
+            this.seq = seq;
+            this.chunkKeys = chunkKeys;
+            this.request = request;
+            this.retries = retries;
+        }
+    }
+
+    private static final class TargetChunkSnapshot {
+        final Chunk chunk;
+        final int cx;
+        final int cz;
+        final long key;
+        final ChunkSection[] sections;
+        final DataPaletteBlock[] palettes;
+        final int[] versions;
+        final int[] heights;
+        final LightColumn column;
+
+        TargetChunkSnapshot(Chunk chunk, int cx, int cz, long key, ChunkSection[] sections,
+                            DataPaletteBlock[] palettes, int[] versions, int[] heights, LightColumn column) {
+            this.chunk = chunk;
+            this.cx = cx;
+            this.cz = cz;
+            this.key = key;
+            this.sections = sections;
+            this.palettes = palettes;
+            this.versions = versions;
+            this.heights = heights;
+            this.column = column;
+        }
+    }
+
+    private static final class TileSnapshot {
+        final LightRegion region;
+        final List<TargetChunkSnapshot> targets;
+
+        TileSnapshot(LightRegion region, List<TargetChunkSnapshot> targets) {
+            this.region = region;
+            this.targets = targets;
+        }
+    }
+
+    private static final class TileResult {
+        final PendingTile tile;
+        final TileSnapshot snapshot;
+        final LightResult result;
+        final Throwable error;
+
+        TileResult(PendingTile tile, TileSnapshot snapshot, LightResult result, Throwable error) {
+            this.tile = tile;
+            this.snapshot = snapshot;
+            this.result = result;
+            this.error = error;
+        }
+    }
+}
