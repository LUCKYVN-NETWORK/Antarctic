+            throw new IllegalArgumentException("optimizations.lighting.relight-apply-budget-ms must be positive");
+        }
+        if (autoRelightDeferredThreshold < 0) {
+            throw new IllegalArgumentException("optimizations.lighting.auto-relight-deferred-threshold must be >= 0");
