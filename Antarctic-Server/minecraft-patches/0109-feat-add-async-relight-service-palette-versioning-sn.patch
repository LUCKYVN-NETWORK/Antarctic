+/**
+ * Tests T4 (ordering, version mismatch retry + sync fallback, supersession, unload drop), T7 (empty section creation),
+ * T8 (concurrent main-thread edits during worker compute), T9 (toggle off), HeightMap write-back, and main-thread cost.
+ */
+public class RelightServiceTest {
+
+    private boolean prevAsyncCatcher;
+    private WorldServer activeWorld;
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    @Before
+    public void setUp() {
+        this.prevAsyncCatcher = org.spigotmc.AsyncCatcher.enabled;
+        org.spigotmc.AsyncCatcher.enabled = false;
+        Lighting.asyncBulkRelight = true;
+        Lighting.asyncRelightThreads = 2;
+        Lighting.relightSnapshotBudgetMs = 50;
+        Lighting.relightApplyBudgetMs = 50;
+        Lighting.verifyAfterRelight = true;
+        Lighting.maxRelightChunksPerRequest = 4096;
+        Lighting.saveAfterRelight = false;
+    }
+
+    @After
+    public void tearDown() {
+        if (this.activeWorld != null) {
+            this.activeWorld.shutdownRelightService();
+            this.activeWorld = null;
+        }
+        Lighting.asyncBulkRelight = false;
+        Lighting.asyncRelightThreads = 0;
+        Lighting.relightSnapshotBudgetMs = 5;
+        Lighting.relightApplyBudgetMs = 2;
+        Lighting.verifyAfterRelight = true;
+        Lighting.maxRelightChunksPerRequest = 4096;
+        Lighting.saveAfterRelight = false;
+        org.spigotmc.AsyncCatcher.enabled = this.prevAsyncCatcher;
+    }
+
+    private WorldServer makeWorld(long seed, LightPropagationParityTest.StubProvider[] providerOut) throws Exception {
+        WorldServer world = LightPropagationParityTest.buildWorld(seed, providerOut);
+        LightPropagationParityTest.set(World.class, world, "chunkPacketBlockController",
+            com.destroystokyo.paper.antixray.ChunkPacketBlockController.NO_OPERATION_INSTANCE);
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                Chunk c = world.getChunkIfLoaded(cx, cz);
+                LightPropagationParityTest.set(Chunk.class, c, "locX", cx);
+                LightPropagationParityTest.set(Chunk.class, c, "locZ", cz);
+            }
+        }
+        this.activeWorld = world;
+        return world;
+    }
+
+    private static int driveUntilDone(RelightService service, CompletableFuture<Integer> future) throws Exception {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (!future.isDone() && System.nanoTime() < deadline) {
+            service.tick();
+            if (!future.isDone()) {
+                Thread.sleep(1);
+            }
+        }
+        assertTrue("relight future must complete within timeout", future.isDone());
+        return future.get();
+    }
+
+    @Test
+    public void toggleOffCreatesNoServiceAndReturnsZero() throws Exception {
+        Lighting.asyncBulkRelight = false;
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = makeWorld(1L, p);
+        assertNull(world.getRelightService());
+        assertEquals(Integer.valueOf(0), world.relightChunks(new long[]{ChunkCoordIntPair.a(0, 0)}).get());
+    }
+
+    @Test
+    public void requestExceedingMaxLimitFailsCleanly() throws Exception {
+        Lighting.maxRelightChunksPerRequest = 4;
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = makeWorld(2L, p);
+        CompletableFuture<Integer> future = world.relightChunks(new long[]{1, 2, 3, 4, 5});
+        assertTrue(future.isCompletedExceptionally());
+    }
+
+    @Test
+    public void asyncRelightFixesStaleHeightMapAndEmptySectionSpillWithoutInitLighting() throws Exception {
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = makeWorld(3L, p);
+        Chunk c = world.getChunkIfLoaded(0, 0);
+
+        // Clear all sections >= 2 to Chunk.a (null), place a glowstone at top of section 1 (y=31) so light spills into section 2!
+        for (int s = 2; s < 16; ++s) {
+            c.getSections()[s] = Chunk.a;
+        }
+        LightPropagationParityTest.setBlock(world, 8, 31, 8, Blocks.GLOWSTONE.getBlockData());
+        // Corrupt the HeightMap (like bulk schematic writers in SuperiorWorld) and mark lit=false
+        c.r()[8 << 4 | 8] = 0;
+        c.e(false);
+
+        RelightService service = world.getRelightService();
+        assertNotNull(service);
+        CompletableFuture<Integer> future = service.submit(new long[]{ChunkCoordIntPair.a(0, 0)});
+        int applied = driveUntilDone(service, future);
+        assertEquals(1, applied);
+
+        // Clarification 1: HeightMap repaired
+        assertEquals("stale HeightMap must be repaired on apply", 32, c.r()[8 << 4 | 8]);
+        // Clarification 2: section 2 created for spilled light, higher untouched sections remain Chunk.a (T7)
+        assertNotNull("section 2 must be created for spilled light", c.getSections()[2]);
+        assertEquals(15, world.getBrightness(EnumSkyBlock.BLOCK, 8, 31, 8));
+        assertEquals(14, world.getBrightness(EnumSkyBlock.BLOCK, 8, 32, 8));
+        assertNull("untouched empty section 15 must remain Chunk.a", c.getSections()[15]);
+        // Clarification 3: chunk marked lit=true
+        assertTrue("relit chunk must be marked lit=true", c.v());
+    }
+
+    @Test
+    public void unloadedChunkIsNeverTouchedOnApply() throws Exception {
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = makeWorld(4L, p);
+        Chunk target = world.getChunkIfLoaded(0, 0);
+        LightPropagationParityTest.setBlock(world, 5, 40, 5, Blocks.GLOWSTONE.getBlockData());
+
+        RelightService service = world.getRelightService();
+        CompletableFuture<Integer> future = service.submit(new long[]{ChunkCoordIntPair.a(0, 0)});
+        // Snapshot the tile, then immediately unload the chunk before apply runs
+        service.tick();
+        p[0].chunks.remove(ChunkCoordIntPair.a(0, 0));
+
+        int applied = driveUntilDone(service, future);
+        assertEquals("unloaded chunk must be dropped and not counted as applied", 0, applied);
+        assertEquals("unloaded chunk light array must not be mutated", 0, target.getSections()[2].getEmittedLightArray().a(5, 40 & 15, 5));
+    }
+
+    @Test
+    public void concurrentMainThreadEditsConvergeWithZeroExceptions() throws Exception {
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = makeWorld(5L, p);
+        RelightService service = world.getRelightService();
+
+        long[] keys = new long[]{
+            ChunkCoordIntPair.a(-1, -1), ChunkCoordIntPair.a(0, -1),
+            ChunkCoordIntPair.a(-1, 0), ChunkCoordIntPair.a(0, 0)
+        };
+
+        // Submit initial relight, mutate blocks while workers run (triggering version-mismatch retry / sync fallback)
+        LightPropagationParityTest.setBlock(world, 4, 40, 4, Blocks.GLOWSTONE.getBlockData());
+        CompletableFuture<Integer> f1 = service.submit(keys);
+        service.tick(); // snapshot f1
+        // Mutate block in chunk (0, 0) mid-flight -> increments DataPaletteBlock.antarcticVersion
+        LightPropagationParityTest.setBlock(world, 4, 40, 4, Blocks.AIR.getBlockData());
+        LightPropagationParityTest.setBlock(world, 10, 40, 10, Blocks.TORCH.getBlockData());
+
+        int applied = driveUntilDone(service, f1);
+        assertEquals("all 4 chunks must converge via retry or sync fallback", 4, applied);
+        // Torch at (10, 40, 10) has emission 14; Manhattan distance to (4, 40, 4) is 12 -> exact light = 14 - 12 = 2 (glowstone's 15 is gone)
+        assertEquals("removed glowstone must leave only torch light (14 - 12 = 2)", 2, world.getBrightness(EnumSkyBlock.BLOCK, 4, 40, 4));
+        assertEquals("newly placed torch must have exact light 14", 14, world.getBrightness(EnumSkyBlock.BLOCK, 10, 40, 10));
+    }
+
+    @Test
+    public void asyncBulkRelightCutsMainThreadWorkVsInlineWorldChecks() throws Exception {
+        LightPropagationParityTest.StubProvider[] pInline = new LightPropagationParityTest.StubProvider[1];
+        LightPropagationParityTest.StubProvider[] pAsync = new LightPropagationParityTest.StubProvider[1];
+        WorldServer inlineWorld = makeWorld(99L, pInline);
+        WorldServer asyncWorld = LightPropagationParityTest.buildWorld(99L, pAsync);
+        LightPropagationParityTest.set(World.class, asyncWorld, "chunkPacketBlockController",
+            com.destroystokyo.paper.antixray.ChunkPacketBlockController.NO_OPERATION_INSTANCE);
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                Chunk c = asyncWorld.getChunkIfLoaded(cx, cz);
+                LightPropagationParityTest.set(Chunk.class, c, "locX", cx);
+                LightPropagationParityTest.set(Chunk.class, c, "locZ", cz);
+            }
+        }
+
+        // Paste 256 glowstone blocks across 4 chunks (-1..0, -1..0)
+        BlockPosition[] placed = new BlockPosition[256];
+        int idx = 0;
+        for (int x = -16; x < 16; x += 2) {
+            for (int z = -16; z < 16; z += 2) {
+                placed[idx++] = new BlockPosition(x, 40, z);
+                LightPropagationParityTest.setBlock(inlineWorld, x, 40, z, Blocks.GLOWSTONE.getBlockData());
+                LightPropagationParityTest.setBlock(asyncWorld, x, 40, z, Blocks.GLOWSTONE.getBlockData());
+            }
+        }
+
+        long tInline0 = System.nanoTime();
+        for (BlockPosition bp : placed) {
+            inlineWorld.w(bp);
+        }
+        long inlineMainNanos = System.nanoTime() - tInline0;
+
+        RelightService service = asyncWorld.getRelightService();
+        long[] keys = {
+            ChunkCoordIntPair.a(-1, -1), ChunkCoordIntPair.a(0, -1),
+            ChunkCoordIntPair.a(-1, 0), ChunkCoordIntPair.a(0, 0)
+        };
+        long asyncMainNanos = 0L;
+        long tSub0 = System.nanoTime();
+        CompletableFuture<Integer> future = service.submit(keys);
+        asyncMainNanos += System.nanoTime() - tSub0;
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (!future.isDone() && System.nanoTime() < deadline) {
+            long tTick0 = System.nanoTime();
+            service.tick();
+            asyncMainNanos += System.nanoTime() - tTick0;
+            if (!future.isDone()) {
+                Thread.sleep(1);
+            }
+        }
+        assertTrue(future.isDone());
+        assertEquals(Integer.valueOf(4), future.get());
+        asyncWorld.shutdownRelightService();
+
+        System.out.printf("[perf] 256-glowstone 4-chunk bulk paste main-thread time: inline=%.2f ms, async=%.2f ms (%.1fx less main-thread work)%n",
+            inlineMainNanos / 1.0e6, asyncMainNanos / 1.0e6, (double) inlineMainNanos / Math.max(1L, asyncMainNanos));
+        assertTrue("async relight must spend less main-thread time than 256 inline World.w checks", asyncMainNanos < inlineMainNanos);
+    }
+
+    @Test
+    public void overlappingRequestsNeverLetOlderResultOverwriteNewer() throws Exception {
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = makeWorld(6L, p);
+        RelightService service = world.getRelightService();
+
+        // Request 1 sees glowstone at (6, 40, 6)
+        LightPropagationParityTest.setBlock(world, 6, 40, 6, Blocks.GLOWSTONE.getBlockData());
+        CompletableFuture<Integer> f1 = service.submit(new long[]{ChunkCoordIntPair.a(0, 0)});
+        service.tick(); // snapshots f1
+
+        // Now remove glowstone and submit Request 2 before f1 applies
+        LightPropagationParityTest.setBlock(world, 6, 40, 6, Blocks.AIR.getBlockData());
+        CompletableFuture<Integer> f2 = service.submit(new long[]{ChunkCoordIntPair.a(0, 0)});
+
+        driveUntilDone(service, CompletableFuture.allOf(f1, f2).thenApply(v -> 0));
+        assertEquals("newer request (air) must win over older request (glowstone)", 0, world.getBrightness(EnumSkyBlock.BLOCK, 6, 40, 6));
+    }
+}
