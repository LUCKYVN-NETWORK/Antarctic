+
+    @ConfigInfo(baseName = "verify-after-relight", comments = "Run automatic border shell verification (LightChecker.Scope.BORDER) after every async relight apply and repair any boundary inconsistencies through PendingLightRegistry. Default true.")
+    public static boolean verifyAfterRelight = true;
+
+    @ConfigInfo(baseName = "max-relight-chunks-per-request", comments = "Maximum number of chunks accepted in a single World#relightChunks API request. Must be positive. Default 4096.")
+    public static int maxRelightChunksPerRequest = 4096;
+
+    @ConfigInfo(baseName = "save-after-relight", comments = "When true, relit chunks become immediately eligible for the next incremental autosave slot instead of waiting for auto-save-interval. Default false.")
