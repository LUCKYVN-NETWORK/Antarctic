     public static int deferredLightMaxEntries = 262144;
 
+    @ConfigInfo(baseName = "async-bulk-relight", comments = "Master toggle for the asynchronous bulk relight service and post-apply light enforcer.\nComputes the exact fixed-point lighting off the main thread on immutable snapshots. Default false.")
+    public static boolean asyncBulkRelight = false;
+
+    @ConfigInfo(baseName = "async-relight-threads", comments = "Worker thread count per world for async relight. 0 = auto (clamp(availableProcessors / 2, 1, 4)). Default 0.")
+    public static int asyncRelightThreads = 0;
+
+    @ConfigInfo(baseName = "relight-snapshot-budget-ms", comments = "Maximum main-thread milliseconds per world per tick spent snapshotting chunks for async relight. Must be positive. Default 5.")
+    public static int relightSnapshotBudgetMs = 5;
+
+    @ConfigInfo(baseName = "relight-apply-budget-ms", comments = "Maximum main-thread milliseconds per world per tick spent applying and verifying finished async relight results. Must be positive. Default 2.")
+    public static int relightApplyBudgetMs = 2;
+
+    @ConfigInfo(baseName = "auto-relight-deferred-threshold", comments = "When a chunk accumulates more than this many deferred light checks in PendingLightRegistry, convert them into one async relight request (T-bulk). Set 0 to disable. Default 512.")
