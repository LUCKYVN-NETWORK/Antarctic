     @Override
     public EnumConfigCategory getCategory() {
         return EnumConfigCategory.OPTIMIZATIONS;
@@ -33,5 +57,20 @@ public class Lighting implements IConfigModule {
         if (deferredLightMaxEntries < 1) {
             throw new IllegalArgumentException("optimizations.lighting.deferred-light-max-entries must be positive");
         }
+        if (asyncRelightThreads < 0) {
+            throw new IllegalArgumentException("optimizations.lighting.async-relight-threads must be >= 0");
+        }
+        if (relightSnapshotBudgetMs < 1) {
+            throw new IllegalArgumentException("optimizations.lighting.relight-snapshot-budget-ms must be positive");
