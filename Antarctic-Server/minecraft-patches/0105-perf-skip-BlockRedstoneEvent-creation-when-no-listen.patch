diff --git a/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java b/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java
index 835f143..cc00742 100644
--- a/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java
+++ b/main/java/org/bukkit/craftbukkit/event/CraftEventFactory.java
@@ -893,6 +893,17 @@ public class CraftEventFactory {
         return event;
     }
 
+    // Antarctic start - avoid CraftBlock and BlockRedstoneEvent allocations when no listeners are registered
+    public static int callRedstoneChangeCurrent(World world, int x, int y, int z, int oldCurrent, int newCurrent) {
+        if (BlockRedstoneEvent.getHandlerList().getRegisteredListeners().length == 0) {
+            return newCurrent;
+        }
+        BlockRedstoneEvent event = new BlockRedstoneEvent(world.getWorld().getBlockAt(x, y, z), oldCurrent, newCurrent);
+        world.getServer().getPluginManager().callEvent(event);
+        return event.getNewCurrent();
+    }
+    // Antarctic end
+
     public static NotePlayEvent callNotePlayEvent(World world, int x, int y, int z, byte instrument, byte note) {
         NotePlayEvent event = new NotePlayEvent(world.getWorld().getBlockAt(x, y, z), org.bukkit.Instrument.getByType(instrument), new org.bukkit.Note(note));
         world.getServer().getPluginManager().callEvent(event);
diff --git a/test/java/net/minecraft/server/RedstoneEventShortCircuitTest.java b/test/java/net/minecraft/server/RedstoneEventShortCircuitTest.java
new file mode 100644
index 0000000..7621b66
--- /dev/null
+++ b/test/java/net/minecraft/server/RedstoneEventShortCircuitTest.java
@@ -0,0 +1,178 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.lang.management.ManagementFactory;
+import java.lang.reflect.Field;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.bukkit.craftbukkit.event.CraftEventFactory;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.Listener;
+import org.bukkit.event.block.BlockRedstoneEvent;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.RegisteredListener;
+import org.bukkit.plugin.SimplePluginManager;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class RedstoneEventShortCircuitTest {
+
+    private static Unsafe unsafe;
+    private RegisteredListener registeredListener;
+
+    private static final class StubCraftWorld extends org.bukkit.craftbukkit.CraftWorld {
+        StubCraftWorld() {
+            super(null, null, null);
+        }
+
+        @Override
+        public org.bukkit.block.Block getBlockAt(int x, int y, int z) {
+            return (org.bukkit.block.Block) java.lang.reflect.Proxy.newProxyInstance(
+                org.bukkit.block.Block.class.getClassLoader(),
+                new Class<?>[]{org.bukkit.block.Block.class},
+                (proxy, method, args) -> {
+                    if ("getX".equals(method.getName())) return x;
+                    if ("getY".equals(method.getName())) return y;
+                    if ("getZ".equals(method.getName())) return z;
+                    return null;
+                }
+            );
+        }
+    }
+
+    private static final class StubEventWorld extends WorldServer {
+        org.bukkit.craftbukkit.CraftWorld stubWorld;
+        org.bukkit.craftbukkit.CraftServer stubServer;
+
+        StubEventWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public org.bukkit.craftbukkit.CraftWorld getWorld() {
+            return this.stubWorld;
+        }
+
+        @Override
+        public org.bukkit.craftbukkit.CraftServer getServer() {
+            return this.stubServer;
+        }
+    }
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+        Field uf = Unsafe.class.getDeclaredField("theUnsafe");
+        uf.setAccessible(true);
+        unsafe = (Unsafe) uf.get(null);
+    }
+
+    @After
+    public void cleanup() {
+        if (this.registeredListener != null) {
+            BlockRedstoneEvent.getHandlerList().unregister(this.registeredListener);
+            this.registeredListener = null;
+        }
+    }
+
+    private static StubEventWorld makeWorld() throws Exception {
+        StubEventWorld world = (StubEventWorld) unsafe.allocateInstance(StubEventWorld.class);
+        world.stubWorld = (org.bukkit.craftbukkit.CraftWorld) unsafe.allocateInstance(StubCraftWorld.class);
+        world.stubServer = (org.bukkit.craftbukkit.CraftServer) unsafe.allocateInstance(org.bukkit.craftbukkit.CraftServer.class);
+        LightPropagationParityTest.set(org.bukkit.craftbukkit.CraftServer.class, world.stubServer, "pluginManager", new SimplePluginManager(null, null));
+        return world;
+    }
+
+    @Test
+    public void zeroListenerPathAllocatesZeroBytesAndBeatsFullEventDispatch() throws Exception {
+        assertEquals(0, BlockRedstoneEvent.getHandlerList().getRegisteredListeners().length);
+        StubEventWorld world = makeWorld();
+
+        // Warmup
+        int sink = 0;
+        for (int i = 0; i < 50_000; ++i) {
+            sink += CraftEventFactory.callRedstoneChangeCurrent(world, 1, 64, 1, 0, i & 15);
+            sink += CraftEventFactory.callRedstoneChange(world, 1, 64, 1, 0, i & 15).getNewCurrent();
+        }
+        assertTrue(sink > 0);
+
+        com.sun.management.ThreadMXBean mx = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        long fastNanos = Long.MAX_VALUE;
+        long oldNanos = Long.MAX_VALUE;
+        long allocFast = Long.MAX_VALUE;
+        long allocOld = 0L;
+        for (int round = 0; round < 3; ++round) {
+            long allocBeforeFast = mx.getThreadAllocatedBytes(tid);
+            long t0 = System.nanoTime();
+            for (int i = 0; i < 500_000; ++i) {
+                sink += CraftEventFactory.callRedstoneChangeCurrent(world, 1, 64, 1, 0, i & 15);
+            }
+            long fn = System.nanoTime() - t0;
+            long af = mx.getThreadAllocatedBytes(tid) - allocBeforeFast;
+            fastNanos = Math.min(fastNanos, fn);
+            allocFast = Math.min(allocFast, af);
+
+            long allocBeforeOld = mx.getThreadAllocatedBytes(tid);
+            long t1 = System.nanoTime();
+            for (int i = 0; i < 500_000; ++i) {
+                sink += CraftEventFactory.callRedstoneChange(world, 1, 64, 1, 0, i & 15).getNewCurrent();
+            }
+            long on = System.nanoTime() - t1;
+            long ao = mx.getThreadAllocatedBytes(tid) - allocBeforeOld;
+            oldNanos = Math.min(oldNanos, on);
+            allocOld = Math.max(allocOld, ao);
+        }
+
+        assertTrue(sink > 0);
+        System.out.println("[perf] BlockRedstoneEvent 500k calls: old=" + (oldNanos / 1000) + "us (" + (allocOld / 1024) + " KiB) fast="
+            + (fastNanos / 1000) + "us (" + (allocFast / 1024) + " KiB)");
+        assertTrue("zero-listener fast path must allocate ~0 bytes, got " + allocFast, allocFast <= 1024L);
+        assertTrue("baseline path allocates significant event/block garbage", allocOld > 10 * 1024 * 1024);
+        assertTrue("zero-listener fast path should be at least 3x faster than full dispatch", fastNanos * 3 < oldNanos);
+    }
+
+    @Test
+    public void registeredListenerOverridesCurrentAndUnregisterRestoresFastPath() throws Exception {
+        StubEventWorld world = makeWorld();
+        AtomicInteger calls = new AtomicInteger();
+        Plugin dummyPlugin = (Plugin) java.lang.reflect.Proxy.newProxyInstance(
+            Plugin.class.getClassLoader(),
+            new Class<?>[]{Plugin.class},
+            (proxy, method, args) -> {
+                if ("isEnabled".equals(method.getName())) return true;
+                if ("getName".equals(method.getName())) return "RedstoneShortCircuitTest";
+                return null;
+            }
+        );
+
+        this.registeredListener = new RegisteredListener(
+            new Listener() {},
+            (listener, event) -> {
+                if (event instanceof BlockRedstoneEvent) {
+                    calls.incrementAndGet();
+                    ((BlockRedstoneEvent) event).setNewCurrent(9);
+                }
+            },
+            EventPriority.NORMAL,
+            dummyPlugin,
+            false
+        );
+
+        assertEquals(15, CraftEventFactory.callRedstoneChangeCurrent(world, 2, 64, 3, 0, 15));
+        assertEquals(0, calls.get());
+
+        BlockRedstoneEvent.getHandlerList().register(this.registeredListener);
+        assertEquals("registered listener override must be honored", 9, CraftEventFactory.callRedstoneChangeCurrent(world, 2, 64, 3, 0, 15));
+        assertEquals(1, calls.get());
+
+        BlockRedstoneEvent.getHandlerList().unregister(this.registeredListener);
+        this.registeredListener = null;
+        assertEquals(15, CraftEventFactory.callRedstoneChangeCurrent(world, 2, 64, 3, 0, 15));
+        assertEquals(1, calls.get());
+    }
+}
