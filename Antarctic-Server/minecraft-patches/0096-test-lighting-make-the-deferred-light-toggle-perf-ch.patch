+        java.lang.management.ThreadMXBean bean = java.lang.management.ManagementFactory.getThreadMXBean();
+        com.sun.management.ThreadMXBean threads = bean instanceof com.sun.management.ThreadMXBean
+                && ((com.sun.management.ThreadMXBean) bean).isThreadAllocatedMemorySupported() ? (com.sun.management.ThreadMXBean) bean : null;
+        double[] ratios = new double[MEASURED_ROUNDS];
+        long[] allocOff = new long[MEASURED_ROUNDS];
+        long[] allocOn = new long[MEASURED_ROUNDS];
+        long[] nanosOff = new long[MEASURED_ROUNDS];
+        long[] nanosOn = new long[MEASURED_ROUNDS];
+        for (int round = -WARMUP_ROUNDS; round < MEASURED_ROUNDS; ++round) {
+            // Paired measurement: both modes back to back inside one round (so machine drift hits both), and the
+            // order alternates between rounds (so neither mode always pays the cache/GC cost of going second).
+            boolean onFirst = (round & 1) == 0;
+            long[] first = relightFullyLoaded(onFirst, threads);
+            long[] second = relightFullyLoaded(!onFirst, threads);
+            if (round < 0) {
+                continue; // JIT warm-up rounds are discarded
             }
+            long[] off = onFirst ? second : first;
+            long[] on = onFirst ? first : second;
+            nanosOff[round] = off[0];
+            nanosOn[round] = on[0];
+            allocOff[round] = off[1];
+            allocOn[round] = on[1];
+            ratios[round] = (double) on[0] / (double) off[0];
+        }
+        double[] sorted = ratios.clone();
+        java.util.Arrays.sort(sorted);
+        double median = sorted[MEASURED_ROUNDS / 2];
+        long[] offSorted = nanosOff.clone();
+        long[] onSorted = nanosOn.clone();
+        java.util.Arrays.sort(offSorted);
+        java.util.Arrays.sort(onSorted);
+        System.out.println("[perf] fully loaded relight (400 edits, " + MEASURED_ROUNDS + " paired rounds): median defer off="
+                + offSorted[MEASURED_ROUNDS / 2] / 1000 + "us defer on=" + onSorted[MEASURED_ROUNDS / 2] / 1000
+                + "us, median on/off ratio=" + String.format("%.3f", median) + ", ratios=" + java.util.Arrays.toString(ratios));
+        // Median of per-round ratios: one noisy round cannot decide the verdict, and slow drift cancels inside a pair.
+        // 1.5 (not 1.25): ten isolated runs gave medians of 0.85-1.18 on a shared laptop, so 1.25 left ~5% headroom. The
+        // allocation and "nothing deferred" checks are the exact guarantees; this bound only catches a gross slowdown.
+        assertTrue("the toggle must not slow the normal path (median on/off ratio " + median + ")", median < MAX_MEDIAN_RATIO);
+        if (threads != null) {
+            long[] a0 = allocOff.clone();
+            long[] a1 = allocOn.clone();
+            java.util.Arrays.sort(a0);
+            java.util.Arrays.sort(a1);
+            long medOff = a0[MEASURED_ROUNDS / 2];
+            long medOn = a1[MEASURED_ROUNDS / 2];
+            System.out.println("[perf] allocation per 400-edit relight: median defer off=" + medOff + "B defer on=" + medOn + "B");
+            assertTrue("the toggle must not add allocation on the fully loaded path (off=" + medOff + "B on=" + medOn + "B)",
+                    medOn <= medOff + medOff / 20 + 65_536L);
         }
-        System.out.println("[perf] fully loaded relight (400 edits, best of 12): defer off=" + best[0] / 1000 + "us defer on=" + best[1] / 1000 + "us");
-        assertTrue("the toggle must not slow the normal path", best[1] < best[0] * 1.25 + 1_000_000);
     }
 
