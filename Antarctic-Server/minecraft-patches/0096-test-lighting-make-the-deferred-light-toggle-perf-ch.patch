Subject: [PATCH 096/136] test(lighting): make the deferred-light toggle perf
 check robust to machine noise

The fully-loaded relight check compared best-of-12 times with a 1.25 bound and failed once under load. It now measures off/on back to back per round with alternating order after warm-up, asserts on the median of the per-round on/off ratios (bound 1.5), and adds exact guards: no deferred entries and no extra thread allocation when the toggle is on.

Twenty isolated runs on JDK 21 passed: median ratios 0.85-1.18, identical 28,800 B allocation per 400-edit relight in both modes.

diff --git a/test/java/net/minecraft/server/DeferredLightPerfTest.java b/test/java/net/minecraft/server/DeferredLightPerfTest.java
index c3833ef..11b5192 100644
--- a/test/java/net/minecraft/server/DeferredLightPerfTest.java
+++ b/test/java/net/minecraft/server/DeferredLightPerfTest.java
@@ -21,25 +21,80 @@ public class DeferredLightPerfTest {
         Lighting.deferLightUpdates = true;
     }
 
+    private static final int WARMUP_ROUNDS = 4;
+    private static final int MEASURED_ROUNDS = 15;
+    private static final double MAX_MEDIAN_RATIO = 1.5D;
+
+    /** One timed relight of 400 edits on a fully loaded world; returns {nanos, allocatedBytes (-1 if unsupported)}. */
+    private static long[] relightFullyLoaded(boolean deferOn, com.sun.management.ThreadMXBean threads) throws Exception {
+        Lighting.deferLightUpdates = deferOn;
+        WorldServer world = LightPropagationParityTest.buildWorld(21, new LightPropagationParityTest.StubProvider[1]);
+        long threadId = Thread.currentThread().getId();
+        long alloc0 = threads == null ? 0 : threads.getThreadAllocatedBytes(threadId);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < 400; ++i) {
+            BlockPosition pos = new BlockPosition(i % 20 - 10, 5 + i % 3, i / 20 - 10);
+            LightPropagationParityTest.setBlock(world, pos.getX(), pos.getY(), pos.getZ(), i % 2 == 0 ? Blocks.TORCH.getBlockData() : Blocks.AIR.getBlockData());
+            world.w(pos);
+        }
+        long nanos = System.nanoTime() - t0;
+        long allocated = threads == null ? -1 : threads.getThreadAllocatedBytes(threadId) - alloc0;
+        assertEquals("neighbors are all loaded: nothing may be deferred", 0, world.pendingLight.size());
+        return new long[] {nanos, allocated};
+    }
+
     @Test
     public void fullyLoadedPathIsUnaffectedByTheToggle() throws Exception {
-        long[] best = {Long.MAX_VALUE, Long.MAX_VALUE};
-        for (int round = 0; round < 12; ++round) { // alternate the modes so JIT warm-up and GC hit both equally
