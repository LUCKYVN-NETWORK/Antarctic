+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+        DispenserRegistry.c();
+
+        if (Bukkit.getServer() == null) {
+            CraftServer server = (CraftServer) unsafe.allocateInstance(CraftServer.class);
+            SimplePluginManager pm = new SimplePluginManager(server, new org.bukkit.command.SimpleCommandMap(server));
+            setField(CraftServer.class, server, "pluginManager", pm);
+            Field serverField = Bukkit.class.getDeclaredField("server");
+            serverField.setAccessible(true);
+            serverField.set(null, server);
+            installedBukkitServer = true;
+        }
+    }
+
+    @AfterClass
+    public static void cleanupBukkitServer() throws Exception {
+        if (installedBukkitServer) {
+            Field serverField = Bukkit.class.getDeclaredField("server");
+            serverField.setAccessible(true);
+            serverField.set(null, null);
+            installedBukkitServer = false;
+        }
+    }
+
+    @Before
+    public void setUp() {
+        this.prevAsyncCatcher = AsyncCatcher.enabled;
+        AsyncCatcher.enabled = false;
+    }
+
+    @After
+    public void tearDown() {
+        AsyncCatcher.enabled = this.prevAsyncCatcher;
+        MobSpawning.supportFirstSpawnFiltering = true;
+        MobSpawning.eligibleChunkInitialCapacity = 1024;
+        MobSpawning.eligibleChunkTrimFactor = 4;
+    }
+
+    private static void setField(Class<?> owner, Object target, String name, Object value) throws Exception {
+        Field f = owner.getDeclaredField(name);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    private static EntityPlayer newPlayer(WorldServer world, double x, double y, double z, boolean spectator, boolean affectsSpawning) throws Exception {
+        EntityPlayer p = (EntityPlayer) unsafe.allocateInstance(EntityPlayer.class);
+        p.world = world;
+        p.locX = x;
+        p.locY = y;
+        p.locZ = z;
+        p.affectsSpawning = affectsSpawning;
+        p.uniqueID = UUID.randomUUID();
+        PlayerInteractManager pim = (PlayerInteractManager) unsafe.allocateInstance(PlayerInteractManager.class);
+        setField(PlayerInteractManager.class, pim, "gamemode", spectator ? EnumGamemode.SPECTATOR : EnumGamemode.SURVIVAL);
+        setField(EntityPlayer.class, p, "playerInteractManager", pim);
+        p.bukkitEntity = (CraftPlayer) unsafe.allocateInstance(CraftPlayer.class);
+        return p;
+    }
+
+    private static Chunk newChunk(WorldServer world, int cx, int cz, boolean voidChunk) throws Exception {
+        Chunk chunk = (Chunk) unsafe.allocateInstance(Chunk.class);
+        setField(Chunk.class, chunk, "world", world);
+        setField(Chunk.class, chunk, "locX", cx);
+        setField(Chunk.class, chunk, "locZ", cz);
+        setField(Chunk.class, chunk, "chunkKey", ChunkCoordIntPair.a(cx, cz));
+        ChunkSection[] sections = new ChunkSection[16];
+        int[] heightMap = new int[256];
+        if (!voidChunk) {
+            sections[4] = new ChunkSection(64, true);
+            for (int x = 0; x < 16; ++x) {
+                for (int z = 0; z < 16; ++z) {
+                    sections[4].setType(x, 0, z, Blocks.STONE.getBlockData());
+                    sections[4].a(x, 1, z, 15); // daytime bright sky light so precheck rejects
+                    heightMap[(z << 4) | x] = 65;
+                }
+            }
+        }
+        setField(Chunk.class, chunk, "sections", sections);
+        setField(Chunk.class, chunk, "heightMap", heightMap);
+        return chunk;
+    }
+
+    private static TrackingWorldServer buildSkyblockWorld(int playerCount, int mobSpawnRange, boolean allVoid) throws Exception {
+        TrackingWorldServer world = (TrackingWorldServer) unsafe.allocateInstance(TrackingWorldServer.class);
+        SpigotWorldConfig spigotConfig = (SpigotWorldConfig) unsafe.allocateInstance(SpigotWorldConfig.class);
+        spigotConfig.mobSpawnRange = (byte) mobSpawnRange;
+        spigotConfig.viewDistance = 8;
+        setField(World.class, world, "spigotConfig", spigotConfig);
+        setField(World.class, world, "paperConfig", unsafe.allocateInstance(PaperWorldConfig.class));
+        WorldProvider provider = new WorldProviderNormal();
+        setField(WorldProvider.class, provider, "f", true);
+        world.worldProvider = provider;
+        setField(World.class, world, "random", new Random(1337L));
+        setField(World.class, world, "P", new WorldBorder());
+        setField(World.class, world, "players", new ArrayList<EntityHuman>());
+        setField(World.class, world, "methodProfiler", new MethodProfiler());
+        setField(World.class, world, "antarcticCreatureCounts", new int[EnumCreatureType.values().length]);
+        world.stubCraftWorld = (StubCraftWorld) unsafe.allocateInstance(StubCraftWorld.class);
+        world.forcedMeta = new BiomeBase.BiomeMeta(EntityZombie.class, 100, 4, 4);
+
+        StubChunkProvider cp = new StubChunkProvider(world);
+        setField(World.class, world, "chunkProvider", cp);
+
+        MapPlayerChunkMap pcm = (MapPlayerChunkMap) unsafe.allocateInstance(MapPlayerChunkMap.class);
+        setField(MapPlayerChunkMap.class, pcm, "map", new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<PlayerChunk>());
+        setField(WorldServer.class, world, "manager", pcm);
+
+        PlayerChunk ready = (PlayerChunk) unsafe.allocateInstance(PlayerChunk.class);
+        setField(PlayerChunk.class, ready, "done", true);
+
+        for (int p = 0; p < playerCount; ++p) {
+            int baseCx = p * 20; // disjoint islands
+            world.players.add(newPlayer(world, baseCx * 16 + 8.0, 100.0, 8.0, false, true));
+            for (int dx = -mobSpawnRange; dx <= mobSpawnRange; ++dx) {
+                for (int dz = -mobSpawnRange; dz <= mobSpawnRange; ++dz) {
+                    int cx = baseCx + dx;
+                    int cz = dz;
+                    long key = LongHash.toLong(cx, cz);
+                    pcm.map.put(key, ready);
+                    boolean isVoid = allVoid || (dx != 0 || dz != 0);
+                    cp.chunks.put(ChunkCoordIntPair.a(cx, cz), newChunk(world, cx, cz, isVoid));
+                }
+            }
+        }
+        return world;
+    }
