+    @Test
+    public void testIsPlayerNearbyFastPathParity() throws Exception {
+        TrackingWorldServer world = buildSkyblockWorld(0, 4, true);
+        EntityPlayer normal = newPlayer(world, 10.0, 64.0, 10.0, false, true);
+        EntityPlayer spec = newPlayer(world, 0.0, 64.0, 0.0, true, true);
+        EntityPlayer noSpawn = newPlayer(world, 0.0, 64.0, 0.0, false, false);
+        world.players.add(spec);
+        world.players.add(noSpawn);
+        assertFalse("Spectator and !affectsSpawning players must be ignored", world.isPlayerNearby(0.0, 64.0, 0.0, 24.0));
+
+        world.players.add(normal);
+        assertTrue(world.isPlayerNearby(10.0, 64.0, 10.0, 1.0));
+        assertFalse(world.isPlayerNearby(40.0, 64.0, 10.0, 24.0));
+        assertTrue("Negative distance means any range", world.isPlayerNearby(10000.0, 64.0, 10000.0, -1.0));
+    }
