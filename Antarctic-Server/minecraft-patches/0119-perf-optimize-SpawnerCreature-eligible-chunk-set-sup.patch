+            super(null, null, null);
+        }
+
+        @Override public int getMonsterSpawnLimit() { return 70; }
+        @Override public int getAnimalSpawnLimit() { return 0; }
+        @Override public int getWaterAnimalSpawnLimit() { return 0; }
+        @Override public int getAmbientSpawnLimit() { return 0; }
+    }
+
+    private static final class TrackingWorldServer extends WorldServer {
+        CraftWorld stubCraftWorld;
+        int playerNearbyCalls;
+        int getMobsSelectCalls;
+        int getMobsVerifyCalls;
+        BiomeBase.BiomeMeta forcedMeta = new BiomeBase.BiomeMeta(EntityZombie.class, 100, 4, 4);
+
+        TrackingWorldServer() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override public CraftWorld getWorld() { return stubCraftWorld; }
+        @Override public BlockPosition getSpawn() { return new BlockPosition(100000, 64, 100000); }
+        @Override public EnumDifficulty getDifficulty() { return EnumDifficulty.NORMAL; }
+        @Override public boolean addEntity(Entity e, CreatureSpawnEvent.SpawnReason r) { return false; }
+
+        @Override
+        public boolean isPlayerNearby(double x, double y, double z, double d) {
+            ++playerNearbyCalls;
+            return super.isPlayerNearby(x, y, z, d);
+        }
+
+        @Override
+        public BiomeBase.BiomeMeta a(EnumCreatureType type, BlockPosition pos) {
+            ++getMobsSelectCalls;
+            return type == EnumCreatureType.MONSTER ? forcedMeta : null;
+        }
+
+        @Override
+        public boolean a(EnumCreatureType type, BiomeBase.BiomeMeta meta, BlockPosition pos) {
+            ++getMobsVerifyCalls;
+            return type == EnumCreatureType.MONSTER && meta == forcedMeta;
+        }
+    }
