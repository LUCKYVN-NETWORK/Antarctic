+    @Test
+    public void testEligibleChunkRingSemanticsAndSpikeToIdleMemoryTrim() throws Exception {
+        SpawnerCreature spawner = new SpawnerCreature();
+        MobSpawning.eligibleChunkInitialCapacity = 128;
+        MobSpawning.eligibleChunkTrimFactor = 4;
+
+        // 1 player with radius 4 => interior is 7x7 = 49 chunks (border ring never enters list!)
+        TrackingWorldServer onePlayer = buildSkyblockWorld(1, 4, true);
+        spawner.a(onePlayer, true, false, false);
+        assertEquals("Interior of radius-4 ring must contain exactly 7x7=49 chunks", 49, spawner.getEligibleChunkCount());
+
+        // Spike to 60 disjoint players at radius 6 => 60 * 11*11 = 7,260 chunks
+        TrackingWorldServer spikeWorld = buildSkyblockWorld(60, 6, true);
+        spawner.a(spikeWorld, true, false, false);
+        assertEquals(60 * 121, spawner.getEligibleChunkCount());
+        int peakCap = spawner.getEligibleChunkListCapacity();
+        assertTrue("Expected grown capacity >= 7260, got " + peakCap, peakCap >= 7260);
+
+        // Drop back to 1 player (49 chunks): 1st tick sees prevSize=7260, 2nd tick sees prevSize=49 and trims!
+        spawner.a(onePlayer, true, false, false);
+        spawner.a(onePlayer, true, false, false);
+        int trimmedCap = spawner.getEligibleChunkListCapacity();
+        assertTrue("Expected trimmed capacity << peakCap (" + peakCap + "), got " + trimmedCap, trimmedCap < peakCap / 4);
+    }
