+    @Test
+    public void testCanSpawnAtLocationParityWithVanilla() throws Exception {
+        TrackingWorldServer world = buildSkyblockWorld(0, 4, false);
+        Chunk chunk = newChunk(world, 0, 0, true);
+        ChunkSection[] sections = new ChunkSection[16];
+        for (int s = 0; s < 16; ++s) {
+            sections[s] = new ChunkSection(s << 4, true);
+        }
+        setField(Chunk.class, chunk, "sections", sections);
+        world.getChunkProviderServer().chunks.put(ChunkCoordIntPair.a(0, 0), chunk);
+
+        // 1. Stone + air + air -> ON_GROUND true, IN_WATER false
+        sections[4].setType(2, 0, 2, Blocks.STONE.getBlockData());
+        BlockPosition pStone = new BlockPosition(2, 65, 2);
+        assertEquals(SpawnerCreature.a(EntityInsentient.EnumEntityPositionType.ON_GROUND, world, pStone),
+                SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.ON_GROUND, chunk, 2, 65, 2));
+        assertTrue(SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.ON_GROUND, chunk, 2, 65, 2));
+        assertFalse(SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.IN_WATER, chunk, 2, 65, 2));
+
+        // 2. Bedrock & Barrier -> ON_GROUND false
+        sections[4].setType(3, 0, 2, Blocks.BEDROCK.getBlockData());
+        sections[4].setType(4, 0, 2, Blocks.BARRIER.getBlockData());
+        assertFalse(SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.ON_GROUND, chunk, 3, 65, 2));
+        assertFalse(SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.ON_GROUND, chunk, 4, 65, 2));
+
+        // 3. Water column (water below, water at, air above) -> IN_WATER true, ON_GROUND false
+        sections[4].setType(5, 0, 2, Blocks.WATER.getBlockData());
+        sections[4].setType(5, 1, 2, Blocks.WATER.getBlockData());
+        BlockPosition pWater = new BlockPosition(5, 65, 2);
+        assertEquals(SpawnerCreature.a(EntityInsentient.EnumEntityPositionType.IN_WATER, world, pWater),
+                SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.IN_WATER, chunk, 5, 65, 2));
+        assertTrue(SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.IN_WATER, chunk, 5, 65, 2));
+        assertFalse(SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.ON_GROUND, chunk, 5, 65, 2));
+
+        // 4. Mid-air void -> both false
+        assertFalse(SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.ON_GROUND, chunk, 10, 65, 10));
+        assertFalse(SpawnerCreature.canSpawnAtLocation(EntityInsentient.EnumEntityPositionType.IN_WATER, chunk, 10, 65, 10));
+    }
