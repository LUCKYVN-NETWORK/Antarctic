+    @Test
+    public void testEligibleChunkLoopZeroAllocationAndThroughput() throws Exception {
+        TrackingWorldServer world = buildSkyblockWorld(30, 5, false); // 30 islands, ~98% void chunks
+        SpawnerCreature spawner = new SpawnerCreature();
+
+        // Warmup both modes
+        for (int t = 0; t < 50; ++t) {
+            MobSpawning.supportFirstSpawnFiltering = false;
+            spawner.a(world, true, false, false);
+            MobSpawning.supportFirstSpawnFiltering = true;
+            spawner.a(world, true, false, false);
+        }
+
+        com.sun.management.ThreadMXBean tmxb = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        int ticks = 100;
+
+        MobSpawning.supportFirstSpawnFiltering = false;
+        long allocOff0 = tmxb.getThreadAllocatedBytes(tid);
+        long tOff0 = System.nanoTime();
+        for (int t = 0; t < ticks; ++t) {
+            spawner.a(world, true, false, false);
+        }
+        long offNs = System.nanoTime() - tOff0;
+        long offBytes = tmxb.getThreadAllocatedBytes(tid) - allocOff0;
+
+        MobSpawning.supportFirstSpawnFiltering = true;
+        long allocOn0 = tmxb.getThreadAllocatedBytes(tid);
+        long tOn0 = System.nanoTime();
+        for (int t = 0; t < ticks; ++t) {
+            spawner.a(world, true, false, false);
+        }
+        long onNs = System.nanoTime() - tOn0;
+        long onBytes = tmxb.getThreadAllocatedBytes(tid) - allocOn0;
+
+        double offMsPerTick = (offNs / 1e6) / ticks;
+        double onMsPerTick = (onNs / 1e6) / ticks;
+        double onKibPerTick = (onBytes / 1024.0) / ticks;
+        double speedup = (double) offNs / Math.max(1L, onNs);
+
+        System.out.printf("SpawnerCreatureHotPathPerfTest (30p Skyblock, %d ticks): off=%.3f ms/tick (%.2f KiB/t) on=%.3f ms/tick (%.2f KiB/t) speedup=%.2fx%n",
+                ticks, offMsPerTick, (offBytes / 1024.0) / ticks, onMsPerTick, onKibPerTick, speedup);
+        assertTrue("Expected support-first speedup >= 1.5x on 30p Skyblock, got " + speedup + "x", speedup >= 1.5);
+        assertTrue("Expected < 4.0 KiB/tick allocation on 30-player Skyblock world, got " + onKibPerTick, onKibPerTick < 4.0);
+    }
