+    @Test
+    public void testSupportFirstFilteringEliminatesVoidPlayerScansAndStructureLookups() throws Exception {
+        TrackingWorldServer voidWorldOff = buildSkyblockWorld(5, 4, true);
+        SpawnerCreature spawner = new SpawnerCreature();
+
+        MobSpawning.supportFirstSpawnFiltering = false;
