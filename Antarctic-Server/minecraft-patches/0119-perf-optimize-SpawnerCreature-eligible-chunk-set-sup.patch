diff --git a/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/MobSpawning.java b/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/MobSpawning.java
index 215db1a..d5986b3 100644
--- a/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/MobSpawning.java
+++ b/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/MobSpawning.java
@@ -20,6 +20,24 @@ public class MobSpawning implements IConfigModule {
     )
     public static String precheckLightMode = "single-roll";
 
+    @ConfigInfo(
+        baseName = "support-first-spawn-filtering",
+        comments = "Check solid support / water block at the candidate position before scanning nearby players and querying biome/structure spawn tables.\nEliminates ~99.7% of wasted player scans and structure lookups on void/mid-air Skyblock chunks (default: true)."
+    )
+    public static boolean supportFirstSpawnFiltering = true;
+
+    @ConfigInfo(
+        baseName = "eligible-chunk-initial-capacity",
+        comments = "Initial capacity for SpawnerCreature's reusable LongOpenHashSet + LongArrayList eligible chunk buffers (>= 64, default: 1024)."
+    )
+    public static int eligibleChunkInitialCapacity = 1024;
+
+    @ConfigInfo(
+        baseName = "eligible-chunk-trim-factor",
+        comments = "Shrink reusable eligible chunk buffers back toward current load when capacity exceeds active_chunks * factor (0 to disable, or >= 2; default: 4)."
+    )
+    public static int eligibleChunkTrimFactor = 4;
+
     public static int getPrecheckLightMode() {
         String mode = precheckLightMode;
         if (mode == "single-roll") {
@@ -72,5 +90,15 @@ public class MobSpawning implements IConfigModule {
                     "optimizations.mob-spawning.precheck-light-mode must be one of 'off', 'deterministic', or 'single-roll', got: " + precheckLightMode
                 );
         }
+        if (eligibleChunkInitialCapacity < 64) {
+            throw new IllegalArgumentException(
+                "optimizations.mob-spawning.eligible-chunk-initial-capacity must be >= 64, got: " + eligibleChunkInitialCapacity
+            );
+        }
+        if (eligibleChunkTrimFactor != 0 && eligibleChunkTrimFactor < 2) {
+            throw new IllegalArgumentException(
+                "optimizations.mob-spawning.eligible-chunk-trim-factor must be 0 or >= 2, got: " + eligibleChunkTrimFactor
+            );
+        }
     }
 }
