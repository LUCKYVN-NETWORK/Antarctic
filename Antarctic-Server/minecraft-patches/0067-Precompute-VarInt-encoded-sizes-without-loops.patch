From: StellarSeal <emnoigi1452@gmail.com>
Date: Sun, 18 Oct 2026 12:16:53 +0700
Subject: [PATCH 067/140] Precompute VarInt encoded sizes without loops

- Backport Leaf MC 0079 (precomputed VarInt size) to PacketDataSerializer
- Replace the up-to-four-iteration mask loop with a branch-free bit-length formula
- Equivalence with the vanilla loop verified exhaustively over the 21-bit range plus randomized full-range sampling

diff --git a/main/java/net/minecraft/server/PacketDataSerializer.java b/main/java/net/minecraft/server/PacketDataSerializer.java
index 218ef2c..1a6e521 100644
--- a/main/java/net/minecraft/server/PacketDataSerializer.java
+++ b/main/java/net/minecraft/server/PacketDataSerializer.java
@@ -35,15 +35,11 @@ public class PacketDataSerializer extends ByteBuf {
 
     public static int countBytes(int i) { return PacketDataSerializer.a(i); } // Paper - Anti-Xray - OBFHELPER
     public static int a(int i) {
-        for (int j = 1; j < 5; ++j) {
-            if ((i & -1 << j * 7) == 0) {
-                return j;
-            }
-        }
-
-        return 5;
+        // Leaf - Pre-compute VarInt size (backport of Leaf MC 0079); branch-free bit-length formula
+        return (31 - Integer.numberOfLeadingZeros(i | 1)) / 7 + 1;
     }
 
+
     public PacketDataSerializer a(byte[] abyte) {
         this.d(abyte.length);
         this.writeBytes(abyte);
diff --git a/test/java/net/minecraft/server/PacketDataSerializerVarintSizeTest.java b/test/java/net/minecraft/server/PacketDataSerializerVarintSizeTest.java
new file mode 100644
index 0000000..4f13a69
--- /dev/null
+++ b/test/java/net/minecraft/server/PacketDataSerializerVarintSizeTest.java
@@ -0,0 +1,92 @@
+package net.minecraft.server;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.buffer.Unpooled;
+import org.junit.Test;
+
+import java.util.Random;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+
+public class PacketDataSerializerVarintSizeTest {
+
+    private static int referenceSize(int value) {
+        for (int j = 1; j < 5; ++j) {
+            if ((value & -1 << j * 7) == 0) {
+                return j;
+            }
+        }
+        return 5;
+    }
+
+    private static byte[] encodeVarInt(int value) {
+        ByteBuf buf = Unpooled.buffer();
+        PacketDataSerializer serializer = new PacketDataSerializer(buf);
+        serializer.d(value);
+        byte[] out = new byte[buf.readableBytes()];
+        buf.readBytes(out);
+        buf.release();
+        return out;
+    }
+
+    @Test
+    public void sizeMatchesVanillaLoopCounter() {
+        // Exhaustive over the full 3-byte range and deep into the 4-byte range.
+        for (int value = -(1 << 21); value < (1 << 21); value++) {
+            assertEquals("varint size diverges at " + value, referenceSize(value), PacketDataSerializer.a(value));
+        }
+        for (int value = -(1 << 24); value < (1 << 24); value += 3) {
+            assertEquals("varint size diverges at " + value, referenceSize(value), PacketDataSerializer.a(value));
+        }
+    }
+
+    @Test
+    public void sizeMatchesVanillaLoopCounterAtBoundaries() {
+        int[] boundaries = {
+            0, 1, 2, 63, 64, 127, 128, 129, 16383, 16384, 16385,
+            2097151, 2097152, 2097153, 268435455, 268435456, 268435457,
+            Integer.MAX_VALUE, -1, -2, -127, -128, -129, -16384, -16385,
+            -2097152, -2097153, -268435456, -268435457, Integer.MIN_VALUE, Integer.MIN_VALUE + 1
+        };
+        for (int value : boundaries) {
+            assertEquals("varint size diverges at " + value, referenceSize(value), PacketDataSerializer.a(value));
+        }
+        for (int bits = 0; bits <= 31; bits++) {
+            int value = (1 << bits) - 1;
+            assertEquals("varint size diverges at " + value, referenceSize(value), PacketDataSerializer.a(value));
+            if (bits < 31) {
+                value = 1 << bits;
+                assertEquals("varint size diverges at " + value, referenceSize(value), PacketDataSerializer.a(value));
+                value = -1 << bits;
+                assertEquals("varint size diverges at " + value, referenceSize(value), PacketDataSerializer.a(value));
+            }
+        }
+    }
+
+    @Test
+    public void sizeMatchesVanillaLoopCounterOnRandomValues() {
+        Random random = new Random(0x51FE5AFEL);
+        for (int i = 0; i < 1000000; i++) {
+            int value = random.nextInt();
+            assertEquals("varint size diverges at " + value, referenceSize(value), PacketDataSerializer.a(value));
+        }
+    }
+
+    @Test
+    public void sizeMatchesBytesActuallyWritten() {
+        Random random = new Random(0xAB12CD34L);
+        for (int i = 0; i < 100000; i++) {
+            int value = random.nextInt();
+            assertEquals("varint size disagrees with encoding at " + value,
+                encodeVarInt(value).length, PacketDataSerializer.a(value));
+        }
+    }
+
+    @Test
+    public void countBytesHelperStaysConsistent() {
+        for (int value : new int[] {0, 1, 127, 128, 16384, 2097152, 268435456, -1, Integer.MIN_VALUE}) {
+            assertEquals("countBytes diverges at " + value, PacketDataSerializer.a(value), PacketDataSerializer.countBytes(value));
+        }
+    }
+}
