+    @Test
+    public void testChunkFailedSpawnAttemptCounterAndThrottle() throws Exception {
+        // UNSAFE-allocated chunk stays null-safe
+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        int monsterOrd = EnumCreatureType.MONSTER.ordinal();
+        assertEquals(0, chunk.getFailedSpawnAttempts(monsterOrd));
+
+        MobSpawning.throttleMobSpawningEnabled = true;
+        MobSpawning.throttleMonsterMinFailedAttempts = 4;
+        MobSpawning.throttleMonsterSpawnChance = 25;
+
+        Random rng = new Random(42L);
+        for (int i = 0; i < 3; i++) {
+            chunk.recordFailedSpawnAttempt(monsterOrd);
+            assertFalse(SpawnerCreature.shouldThrottleChunkSpawn(chunk, monsterOrd, rng));
+        }
+
+        // 4th failure hits threshold -> ~75% of attempts should throttle
+        chunk.recordFailedSpawnAttempt(monsterOrd);
+        assertEquals(4, chunk.getFailedSpawnAttempts(monsterOrd));
+        int throttled = 0;
+        for (int i = 0; i < 1000; i++) {
+            if (SpawnerCreature.shouldThrottleChunkSpawn(chunk, monsterOrd, rng)) {
+                throttled++;
+            }
+        }
+        assertTrue("Expected ~750 throttled out of 1000, got " + throttled, throttled > 650 && throttled < 850);
+
+        // Reset on successful spawn restores immediate attempts
+        chunk.resetFailedSpawnAttempts(monsterOrd);
+        assertEquals(0, chunk.getFailedSpawnAttempts(monsterOrd));
+        assertFalse(SpawnerCreature.shouldThrottleChunkSpawn(chunk, monsterOrd, rng));
+
+        // Disabled -> never throttles
+        for (int i = 0; i < 10; i++) {
+            chunk.recordFailedSpawnAttempt(monsterOrd);
+        }
+        MobSpawning.throttleMobSpawningEnabled = false;
+        assertFalse(SpawnerCreature.shouldThrottleChunkSpawn(chunk, monsterOrd, rng));
+    }
