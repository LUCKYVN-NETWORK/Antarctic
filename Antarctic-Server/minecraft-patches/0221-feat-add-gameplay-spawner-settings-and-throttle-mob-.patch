@@ -0,0 +1,60 @@
+package com.destroystokyo.paper.config.toml.modules.gameplay;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+
+public class SpawnerSettings implements IConfigModule {
+
+    @ConfigInfo(
+        baseName = "enabled",
+        comments = "Enable custom mob spawner check toggles and overrides. Default false preserves exact vanilla 1.12.2 spawner behavior."
+    )
+    public static boolean enabled = false;
+
+    @ConfigInfo(baseName = "check-for-nearby-players", comments = "Require a nearby player within requiredPlayerRange to tick the spawner. Default true.")
+    public static boolean checkForNearbyPlayers = true;
+
+    @ConfigInfo(baseName = "check-for-max-nearby-entities", comments = "Enforce maxNearbyEntities cap around the spawner. Default true.")
+    public static boolean checkForMaxNearbyEntities = true;
+
+    @ConfigInfo(baseName = "check-for-light-level", comments = "Enforce light-level spawn checks for spawner-created monsters. Default true.")
+    public static boolean checkForLightLevel = true;
+
+    @ConfigInfo(baseName = "check-for-block-collision", comments = "Enforce block/entity collision checks at the spawner spawn position. Default true.")
+    public static boolean checkForBlockCollision = true;
+
+    @ConfigInfo(baseName = "check-for-water", comments = "Disallow spawner placement inside liquid blocks for land mobs. Default true.")
+    public static boolean checkForWater = true;
+
+    @ConfigInfo(baseName = "check-for-spawn-rules", comments = "Enforce EntityInsentient.P() spawn rule checks on spawner mobs. Default true.")
+    public static boolean checkForSpawnRules = true;
+
+    @ConfigInfo(baseName = "min-spawn-delay-override", comments = "Override spawner minSpawnDelay when >= 0 (default -1 = use spawner NBT).")
+    public static int minSpawnDelayOverride = -1;
+
+    @ConfigInfo(baseName = "max-spawn-delay-override", comments = "Override spawner maxSpawnDelay when >= 0 (default -1 = use spawner NBT).")
+    public static int maxSpawnDelayOverride = -1;
+
+    @ConfigInfo(baseName = "spawn-count-override", comments = "Override spawner spawnCount when > 0 (default -1 = use spawner NBT).")
+    public static int spawnCountOverride = -1;
+
+    @ConfigInfo(baseName = "max-nearby-entities-override", comments = "Override spawner maxNearbyEntities when >= 0 (default -1 = use spawner NBT).")
+    public static int maxNearbyEntitiesOverride = -1;
+
+    @ConfigInfo(baseName = "required-player-range-override", comments = "Override spawner requiredPlayerRange when > 0 (default -1 = use spawner NBT).")
+    public static int requiredPlayerRangeOverride = -1;
+
+    @ConfigInfo(baseName = "spawn-range-override", comments = "Override spawner spawnRange when > 0 (default -1 = use spawner NBT).")
+    public static int spawnRangeOverride = -1;
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.GAMEPLAY;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "spawner-settings";
+    }
+}
