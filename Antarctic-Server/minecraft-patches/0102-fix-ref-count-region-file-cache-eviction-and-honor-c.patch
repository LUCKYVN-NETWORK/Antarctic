diff --git a/test/java/net/minecraft/server/RegionFileCacheConcurrencyTest.java b/test/java/net/minecraft/server/RegionFileCacheConcurrencyTest.java
new file mode 100644
index 0000000..84c030a
--- /dev/null
+++ b/test/java/net/minecraft/server/RegionFileCacheConcurrencyTest.java
@@ -0,0 +1,141 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import com.destroystokyo.paper.PaperConfig;
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import java.util.concurrent.Callable;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+public class RegionFileCacheConcurrencyTest {
+
+    private int prevCacheSize;
+    private Path tempWorldDir;
+
+    @Before
+    public void setUp() throws Exception {
+        this.prevCacheSize = PaperConfig.regionFileCacheSize;
+        RegionFileCache.a();
+        this.tempWorldDir = Files.createTempDirectory("antarctic-rfc-test-");
+    }
+
+    @After
+    public void tearDown() throws Exception {
+        RegionFileCache.a();
+        PaperConfig.regionFileCacheSize = this.prevCacheSize;
+        if (this.tempWorldDir != null && Files.exists(this.tempWorldDir)) {
+            Files.walk(this.tempWorldDir)
+                .sorted(java.util.Comparator.reverseOrder())
+                .map(Path::toFile)
+                .forEach(File::delete);
+        }
+    }
+
+    private static NBTTagCompound makeChunkTag(int rx, int rz) {
+        NBTTagCompound root = new NBTTagCompound();
+        NBTTagCompound level = new NBTTagCompound();
+        level.setInt("xPos", rx << 5);
+        level.setInt("zPos", rz << 5);
+        level.setInt("Marker", rx * 1000 + rz);
+        root.set("Level", level);
+        return root;
+    }
+
+    @Test
+    public void chunkExistsHonorsConfiguredCacheSizeWithoutFullWipe() throws Exception {
+        PaperConfig.regionFileCacheSize = 8;
+        File worldDir = this.tempWorldDir.toFile();
+
+        // Populate 20 distinct region files
+        for (int r = 0; r < 20; ++r) {
+            RegionFileCache.e(worldDir, r << 5, 0, makeChunkTag(r, 0));
+        }
+        assertTrue("cache size must stay bounded by PaperConfig.regionFileCacheSize", RegionFileCache.a.size() <= 8);
+
+        // Repeatedly probe via chunkExists (which uses RegionFileCache.b): must stay at 8, never wipe to 1
+        for (int r = 0; r < 20; ++r) {
+            assertTrue(RegionFileCache.chunkExists(worldDir, r << 5, 0));
+            assertEquals("b() must LRU-trim to cacheSize instead of full wipe", 8, RegionFileCache.a.size());
+        }
+    }
+
+    @Test
+    public void concurrentReadsWritesAndExistsSufferZeroCloseRaces() throws Exception {
+        // Tiny cache forces aggressive eviction on nearly every operation across 24 region files
+        PaperConfig.regionFileCacheSize = 4;
+        File worldDir = this.tempWorldDir.toFile();
+        final int regionCount = 24;
+
+        for (int r = 0; r < regionCount; ++r) {
+            RegionFileCache.e(worldDir, r << 5, 0, makeChunkTag(r, 0));
+        }
+
+        ExecutorService pool = Executors.newFixedThreadPool(5);
+        AtomicInteger readCount = new AtomicInteger();
+        AtomicInteger existsCount = new AtomicInteger();
+        List<Callable<Void>> tasks = new ArrayList<>();
+
+        // 3 concurrent reader threads (ChunkIOExecutor simulation)
+        for (int t = 0; t < 3; ++t) {
+            final int seed = 100 + t;
+            tasks.add(() -> {
+                Random rng = new Random(seed);
+                for (int i = 0; i < 150; ++i) {
+                    int r = rng.nextInt(regionCount);
+                    NBTTagCompound tag = RegionFileCache.d(worldDir, r << 5, 0);
+                    assertNotNull("concurrent read must not fail or return null", tag);
+                    assertEquals(r * 1000, tag.getCompound("Level").getInt("Marker"));
+                    readCount.incrementAndGet();
+                }
+                return null;
+            });
+        }
+
+        // 1 concurrent chunkExists thread (RegionFileCache.b path)
+        tasks.add(() -> {
+            Random rng = new Random(200);
+            for (int i = 0; i < 200; ++i) {
+                int r = rng.nextInt(regionCount);
+                assertTrue(RegionFileCache.chunkExists(worldDir, r << 5, 0));
+                existsCount.incrementAndGet();
+            }
+            return null;
+        });
+
+        // 1 concurrent writer thread (FileIOThread simulation)
+        tasks.add(() -> {
+            Random rng = new Random(300);
+            for (int i = 0; i < 60; ++i) {
+                int r = rng.nextInt(regionCount);
+                RegionFileCache.e(worldDir, r << 5, 0, makeChunkTag(r, 0));
+            }
+            return null;
+        });
+
+        try {
+            List<Future<Void>> futures = pool.invokeAll(tasks);
+            for (Future<Void> f : futures) {
+                f.get(); // rethrows any IOException / ClosedChannelException / assertion failure
+            }
+        } finally {
+            pool.shutdownNow();
+        }
+
+        assertEquals(450, readCount.get());
+        assertEquals(200, existsCount.get());
+        assertTrue("cache size must remain bounded after stress", RegionFileCache.a.size() <= 4);
+    }
+}
