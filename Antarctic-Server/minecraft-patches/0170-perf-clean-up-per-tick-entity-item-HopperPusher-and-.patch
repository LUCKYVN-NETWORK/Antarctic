+    private static int runVanillaLoop(World world, EntityZombie zombie, EntityItem item, HopperPusher pusher) {
+        int acc = 0;
+        AxisAlignedBB bb = zombie.getBoundingBox();
+        if (world.e(bb.shrink(0.001D))) acc++;
+        if (world.a(bb.grow(0.0D, -0.4000000059604645D, 0.0D).shrink(0.001D), Material.WATER, zombie)) acc += 2;
+        if (world.a(bb.grow(-0.10000000149011612D, -0.4000000059604645D, -0.10000000149011612D), Material.LAVA)) acc += 4;
+        List<EntityItem> list = world.a(EntityItem.class, item.getBoundingBox().grow(2.5D, 0.0D, 2.5D));
+        acc += list.size();
+        for (EnumItemSlot slot : EnumItemSlot.values()) {
+            acc += slot.ordinal();
+        }
+        BlockPosition bp = new BlockPosition(zombie);
+        acc += bp.getX();
+        if (pusher.findHopper() != null) acc += 8;
+        return acc;
+    }
