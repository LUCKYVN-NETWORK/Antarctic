+        if (world.a(bb.a + 0.001D, bb.b + 0.4000000059604645D + 0.001D, bb.c + 0.001D, bb.d - 0.001D, bb.e - 0.4000000059604645D - 0.001D, bb.f - 0.001D, Material.WATER, zombie)) acc += 2;
+        if (world.a(bb.a + 0.10000000149011612D, bb.b + 0.4000000059604645D, bb.c + 0.10000000149011612D, bb.d - 0.10000000149011612D, bb.e - 0.4000000059604645D, bb.f - 0.10000000149011612D, Material.LAVA)) acc += 4;
+        world.mergeNearbyItems(item, 2.5D);
+        for (EnumItemSlot slot : CACHED_SLOTS) {
+            acc += slot.ordinal();
+        }
+        if (zombie.an()) acc += 16;
+        if (pusher.findHopper() != null) acc += 8;
+        return acc;
+    }
