+    @Test
+    public void testMicroWasteBenchmark() throws Exception {
+        TestWorld world = createWorld();
+        EntityZombie zombie = createZombie(world, 16.5D, 64.0D, 16.5D);
+        EntityItem soloItem = createItem(world, 20.0D, 64.0D, 20.0D, Items.APPLE, 1);
+        HopperPusher pusher = new HopperPusher() {
+            @Override public World getWorld() { return world; }
+            @Override public double getX() { return 20.5D; }
+            @Override public double getY() { return 65.5D; }
+            @Override public double getZ() { return 20.5D; }
+            @Override public AxisAlignedBB getBoundingBox() { return soloItem.getBoundingBox(); }
+            @Override public boolean acceptItem(TileEntityHopper hopper) { return false; }
+        };
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        // Warmup
+        for (int i = 0; i < 5000; i++) {
+            runVanillaLoop(world, zombie, soloItem, pusher);
+            runOptLoop(world, zombie, soloItem, pusher);
+        }
+
+        final int iters = 50000;
+        long vAlloc0 = bean.getThreadAllocatedBytes(tid);
+        long vT0 = System.nanoTime();
+        int vSink = 0;
+        for (int i = 0; i < iters; i++) {
+            vSink ^= runVanillaLoop(world, zombie, soloItem, pusher);
+        }
+        long vNs = System.nanoTime() - vT0;
+        long vBytes = bean.getThreadAllocatedBytes(tid) - vAlloc0;
+
+        long oAlloc0 = bean.getThreadAllocatedBytes(tid);
+        long oT0 = System.nanoTime();
+        int oSink = 0;
+        for (int i = 0; i < iters; i++) {
+            oSink ^= runOptLoop(world, zombie, soloItem, pusher);
+        }
+        long oNs = System.nanoTime() - oT0;
+        long oBytes = bean.getThreadAllocatedBytes(tid) - oAlloc0;
+
+        double speedup = (double) vNs / (double) Math.max(1L, oNs);
+        System.out.println(String.format(
+                "B6_BENCH vanilla_ns=%d opt_ns=%d speedup=%.2fx vanilla_bytes=%d opt_bytes=%d sink=%d",
+                vNs, oNs, speedup, vBytes, oBytes, (vSink ^ oSink)));
+
+        Assert.assertEquals("Optimized micro-waste path should allocate 0 bytes", 0L, oBytes);
+        Assert.assertTrue("Expected speedup > 1.2x, got " + speedup, speedup > 1.2D);
+    }
