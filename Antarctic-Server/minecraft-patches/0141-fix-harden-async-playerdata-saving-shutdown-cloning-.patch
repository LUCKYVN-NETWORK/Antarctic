diff --git a/test/java/net/minecraft/server/AsyncPlayerDataHardeningTest.java b/test/java/net/minecraft/server/AsyncPlayerDataHardeningTest.java
new file mode 100644
index 0000000..25a53ee
--- /dev/null
+++ b/test/java/net/minecraft/server/AsyncPlayerDataHardeningTest.java
@@ -0,0 +1,69 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentMap;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class AsyncPlayerDataHardeningTest {
+
+    @SuppressWarnings("unchecked")
+    @Test
+    public void testAwaitAllPendingSavesWaitsForHealthyFuturesEvenWhenOneFails() throws Exception {
+        Field pendingField = WorldNBTStorage.class.getDeclaredField("pendingSaves");
+        pendingField.setAccessible(true);
+        ConcurrentMap<UUID, CompletableFuture<Void>> pending =
+                (ConcurrentMap<UUID, CompletableFuture<Void>>) pendingField.get(null);
+
+        UUID failedId = UUID.randomUUID();
+        UUID slowId = UUID.randomUUID();
+        CompletableFuture<Void> failedFuture = new CompletableFuture<>();
+        CompletableFuture<Void> slowFuture = new CompletableFuture<>();
+        AtomicBoolean slowFinished = new AtomicBoolean(false);
+
+        pending.put(failedId, failedFuture);
+        pending.put(slowId, slowFuture);
+
+        try {
+            // Fail the first future immediately, complete the second future after 150ms
+            failedFuture.completeExceptionally(new RuntimeException("simulated disk failure"));
+            pending.remove(failedId, failedFuture);
+            Thread completer = new Thread(() -> {
+                try {
+                    Thread.sleep(150L);
+                } catch (InterruptedException ignored) {
+                    Thread.currentThread().interrupt();
+                }
+                slowFinished.set(true);
+                slowFuture.complete(null);
+                pending.remove(slowId, slowFuture);
+            });
+            completer.setDaemon(true);
+            completer.start();
+
+            // Put failedFuture back right before awaitAllPendingSaves so it encounters the failed future first
+            pending.put(failedId, failedFuture);
+            Thread remover = new Thread(() -> {
+                try {
+                    Thread.sleep(50L);
+                } catch (InterruptedException ignored) {
+                    Thread.currentThread().interrupt();
+                }
+                pending.remove(failedId, failedFuture);
+            });
+            remover.setDaemon(true);
+            remover.start();
+
+            WorldNBTStorage.awaitAllPendingSaves();
+
+            Assert.assertTrue("awaitAllPendingSaves must still wait for slowFuture after failedFuture throws", slowFinished.get());
+            Assert.assertTrue("slowFuture must be completed before awaitAllPendingSaves returns", slowFuture.isDone());
+        } finally {
+            pending.remove(failedId);
+            pending.remove(slowId);
+        }
+    }
+}
