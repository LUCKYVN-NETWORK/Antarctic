+    @Test
+    public void testDiodeAndComparatorStretchDelayAndRecover() throws Exception {
+        RedstoneGuard.enabled = true;
+        RedstoneGuard.windowTicks = 20;
+        RedstoneGuard.maxDiodeUpdatesPerChunkPerWindow = 2;
+
+        MockWorldServer world = newMockWorld();
+        Chunk chunk = newLoadedChunk(world, 0, 0);
+
+        BlockPosition repPos = new BlockPosition(5, 64, 5);
+        BlockPosition backPos = repPos.shift(EnumDirection.NORTH);
+        setBlock(chunk, backPos, Blocks.REDSTONE_BLOCK.getBlockData());
+        IBlockData repData = Blocks.UNPOWERED_REPEATER.getBlockData().set(BlockDiodeAbstract.FACING, EnumDirection.NORTH);
+        setBlock(chunk, repPos, repData);
+
+        // 1st & 2nd updates within threshold -> vanilla 2-tick delay
+        ((BlockDiodeAbstract) Blocks.UNPOWERED_REPEATER).g(world, repPos, repData);
+        ((BlockDiodeAbstract) Blocks.UNPOWERED_REPEATER).g(world, repPos, repData);
+        // 3rd update exceeds threshold -> stretched delay (2 * 4 = 8)
+        ((BlockDiodeAbstract) Blocks.UNPOWERED_REPEATER).g(world, repPos, repData);
+
+        assertEquals(3, world.recordedSchedules.size());
+        assertEquals(2, world.recordedSchedules.get(0).delay);
+        assertEquals(2, world.recordedSchedules.get(1).delay);
+        assertEquals(8, world.recordedSchedules.get(2).delay);
+
+        // Advance past windowTicks -> recovers to vanilla 2-tick delay
+        world.worldTime += 20;
+        world.worldData.setTime(world.worldTime);
+        ((BlockDiodeAbstract) Blocks.UNPOWERED_REPEATER).g(world, repPos, repData);
+        assertEquals(2, world.recordedSchedules.get(3).delay);
+
+        // Comparator delay stretch check (in a fresh window)
+        world.worldTime += 20;
+        world.worldData.setTime(world.worldTime);
+        BlockPosition compPos = new BlockPosition(7, 64, 7);
+        setBlock(chunk, compPos.shift(EnumDirection.NORTH), Blocks.REDSTONE_BLOCK.getBlockData());
+        IBlockData compData = Blocks.UNPOWERED_COMPARATOR.getBlockData().set(BlockDiodeAbstract.FACING, EnumDirection.NORTH);
+        setBlock(chunk, compPos, compData);
+        for (int i = 0; i < 4; i++) {
+            ((BlockRedstoneComparator) Blocks.UNPOWERED_COMPARATOR).g(world, compPos, compData);
+        }
+        assertEquals(2, world.recordedSchedules.get(4).delay);
+        assertEquals(2, world.recordedSchedules.get(5).delay);
+        assertEquals(8, world.recordedSchedules.get(6).delay);
+    }
