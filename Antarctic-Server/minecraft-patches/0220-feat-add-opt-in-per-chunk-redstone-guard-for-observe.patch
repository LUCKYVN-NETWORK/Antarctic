+    @Test
+    public void testObserverCubeStressBenchmark() throws Exception {
+        MockWorldServer world = newMockWorld();
+        newLoadedChunk(world, 0, 0);
+        BlockObserver observer = (BlockObserver) Blocks.dk;
+        IBlockData unpowered = observer.getBlockData().set(BlockObserver.a, Boolean.FALSE);
+        BlockPosition[] positions = new BlockPosition[2048];
+        for (int i = 0; i < 2048; i++) {
+            positions[i] = new BlockPosition(i & 15, 16 + ((i >> 4) & 7), (i >> 7) & 15);
+        }
+
+        RedstoneGuard.enabled = false;
+        world.recordedSchedules.clear();
+        long t0 = System.nanoTime();
+        for (int tick = 0; tick < 40; tick++) {
+            world.worldTime = 100L + tick;
+            for (int i = 0; i < 2048; i++) {
+                observer.b(unpowered, world, positions[i], Blocks.STONE, positions[i].shift(EnumDirection.SOUTH));
+            }
+        }
+        long unguardedNs = System.nanoTime() - t0;
+        int unguardedScheduled = world.recordedSchedules.size();
+
+        RedstoneGuard.enabled = true;
+        RedstoneGuard.windowTicks = 20;
+        RedstoneGuard.maxObserverPulsesPerChunkPerWindow = 128;
+        world.recordedSchedules.clear();
+        long t1 = System.nanoTime();
+        for (int tick = 0; tick < 40; tick++) {
+            world.worldTime = 200L + tick;
+            for (int i = 0; i < 2048; i++) {
+                observer.b(unpowered, world, positions[i], Blocks.STONE, positions[i].shift(EnumDirection.SOUTH));
+            }
+        }
+        long guardedNs = System.nanoTime() - t1;
+        int guardedScheduled = world.recordedSchedules.size();
+
+        assertEquals(81920, unguardedScheduled);
+        assertEquals(256, guardedScheduled);
+        System.out.printf("E2_BENCH observer_cube_40t unguarded_sched=%d (%d us) guarded_sched=%d (%d us)%n",
+                unguardedScheduled, unguardedNs / 1000, guardedScheduled, guardedNs / 1000);
+    }
