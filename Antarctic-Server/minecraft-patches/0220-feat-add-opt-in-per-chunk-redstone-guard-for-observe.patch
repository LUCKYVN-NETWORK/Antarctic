+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+import static org.junit.Assert.*;
+
+public class RedstoneGuardTest {
+
+    private static Unsafe UNSAFE;
+    private static Timing NOOP_TIMING;
+
+    private boolean prevEnabled = RedstoneGuard.enabled;
+    private int prevWindowTicks = RedstoneGuard.windowTicks;
+    private int prevMaxObserver = RedstoneGuard.maxObserverPulsesPerChunkPerWindow;
+    private int prevMaxPiston = RedstoneGuard.maxPistonActionsPerChunkPerWindow;
+    private int prevMaxDiode = RedstoneGuard.maxDiodeUpdatesPerChunkPerWindow;
+    private int prevMaxNote = RedstoneGuard.maxNoteBlockPlaysPerChunkPerWindow;
+    private int prevMaxScheduled = RedstoneGuard.maxScheduledTicksPerChunkPerTick;
+    private int prevUnloadedBackoff = RedstoneGuard.unloadedChunkTickBackoffTicks;
+
+    @BeforeClass
+    public static void init() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+        NOOP_TIMING = (Timing) Proxy.newProxyInstance(
+            Timing.class.getClassLoader(),
+            new Class<?>[] { Timing.class },
+            (proxy, method, args) -> {
+                Class<?> rt = method.getReturnType();
+                if (rt == Timing.class) return proxy;
+                if (rt == boolean.class) return false;
+                if (rt == int.class) return 0;
+                return null;
+            }
+        );
+    }
+
+    @After
+    public void restoreConfig() {
+        RedstoneGuard.enabled = prevEnabled;
+        RedstoneGuard.windowTicks = prevWindowTicks;
+        RedstoneGuard.maxObserverPulsesPerChunkPerWindow = prevMaxObserver;
+        RedstoneGuard.maxPistonActionsPerChunkPerWindow = prevMaxPiston;
+        RedstoneGuard.maxDiodeUpdatesPerChunkPerWindow = prevMaxDiode;
+        RedstoneGuard.maxNoteBlockPlaysPerChunkPerWindow = prevMaxNote;
+        RedstoneGuard.maxScheduledTicksPerChunkPerTick = prevMaxScheduled;
+        RedstoneGuard.unloadedChunkTickBackoffTicks = prevUnloadedBackoff;
+    }
+
+    private static final class ScheduledCall {
+        final BlockPosition pos;
+        final Block block;
+        final int delay;
+        final int priority;
+
+        ScheduledCall(BlockPosition pos, Block block, int delay, int priority) {
+            this.pos = pos.h();
+            this.block = block;
+            this.delay = delay;
+            this.priority = priority;
+        }
+    }
+
+    private static final class PlayActionCall {
+        final BlockPosition pos;
+        final Block block;
+        final int id;
+        final int param;
+
+        PlayActionCall(BlockPosition pos, Block block, int id, int param) {
+            this.pos = pos.h();
+            this.block = block;
+            this.id = id;
+            this.param = param;
+        }
+    }
+
+    private static final class MockWorldServer extends WorldServer {
+        Long2ObjectOpenHashMap<Chunk> loadedChunks;
+        List<ScheduledCall> recordedSchedules;
+        List<PlayActionCall> recordedActions;
+        long worldTime;
+        org.bukkit.World proxyBukkitWorld;
+        CraftServer mockCraftServer;
+        WorldBorder mockWorldBorder;
+
+        MockWorldServer() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public WorldBorder getWorldBorder() {
+            return mockWorldBorder;
+        }
+
+        @Override
+        public long getTime() {
+            return worldTime;
+        }
+
+        @Override
+        public Chunk getChunkIfLoaded(int x, int z) {
+            return loadedChunks.get(ChunkCoordIntPair.a(x, z));
+        }
+
+        @Override
+        public boolean isLoaded(BlockPosition pos) {
+            return getChunkIfLoaded(pos.getX() >> 4, pos.getZ() >> 4) != null;
+        }
+
+        @Override
+        public boolean b(BlockPosition pos, Block block) {
+            return false;
+        }
+
+        @Override
+        public void a(BlockPosition pos, Block block, int delay, int priority) {
+            recordedSchedules.add(new ScheduledCall(pos, block, delay, priority));
+            super.a(pos, block, delay, priority);
+        }
+
+        @Override
+        public void playBlockAction(BlockPosition pos, Block block, int id, int param) {
+            recordedActions.add(new PlayActionCall(pos, block, id, param));
+        }
+
+        @Override
+        public IBlockData getType(BlockPosition pos) {
+            Chunk c = getChunkIfLoaded(pos.getX() >> 4, pos.getZ() >> 4);
+            if (c != null) {
+                return c.getBlockData(pos);
+            }
+            return Blocks.AIR.getBlockData();
+        }
+
+        @Override
+        public boolean setTypeAndData(BlockPosition pos, IBlockData data, int flags) {
