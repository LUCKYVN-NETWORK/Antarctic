+    private static Chunk newLoadedChunk(MockWorldServer world, int cx, int cz) throws Exception {
+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        Field worldField = Chunk.class.getDeclaredField("world");
+        worldField.setAccessible(true);
+        worldField.set(chunk, world);
+        Field xField = Chunk.class.getDeclaredField("locX");
+        xField.setAccessible(true);
+        xField.setInt(chunk, cx);
+        Field zField = Chunk.class.getDeclaredField("locZ");
+        zField.setAccessible(true);
+        zField.setInt(chunk, cz);
+        Field secField = Chunk.class.getDeclaredField("sections");
+        secField.setAccessible(true);
+        secField.set(chunk, new ChunkSection[16]);
+        Field hmField = Chunk.class.getDeclaredField("heightMap");
+        hmField.setAccessible(true);
+        hmField.set(chunk, new int[256]);
+        Field keyField = Chunk.class.getDeclaredField("chunkKey");
+        keyField.setAccessible(true);
+        keyField.setLong(chunk, ChunkCoordIntPair.a(cx, cz));
+        Field winField = Chunk.class.getDeclaredField("antarcticRedstoneWindowStart");
+        winField.setAccessible(true);
+        winField.setLong(chunk, Long.MIN_VALUE);
+        world.loadedChunks.put(chunk.chunkKey, chunk);
+        return chunk;
+    }
