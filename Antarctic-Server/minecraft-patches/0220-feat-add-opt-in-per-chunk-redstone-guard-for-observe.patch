+    @Test
+    public void testObserverRisingThrottledButFallingEdgeNeverStuck() throws Exception {
+        RedstoneGuard.enabled = true;
+        RedstoneGuard.windowTicks = 20;
+        RedstoneGuard.maxObserverPulsesPerChunkPerWindow = 5;
+        RedstoneGuard.maxScheduledTicksPerChunkPerTick = 2;
+
+        MockWorldServer world = newMockWorld();
+        Chunk chunk = newLoadedChunk(world, 0, 0);
+
+        BlockObserver observer = (BlockObserver) Blocks.dk;
+        Timing prevTiming = observer.timing;
+        observer.timing = NOOP_TIMING;
+        try {
+            IBlockData unpowered = observer.getBlockData().set(BlockObserver.a, Boolean.FALSE);
+            IBlockData powered = observer.getBlockData().set(BlockObserver.a, Boolean.TRUE);
+            BlockPosition front = new BlockPosition(5, 64, 5);
+            BlockPosition changed = front.shift(EnumDirection.SOUTH);
+
+            // Trigger 10 rising edges in same window -> only first 5 schedule
+            for (int i = 0; i < 10; i++) {
+                observer.b(unpowered, world, front, Blocks.STONE, changed);
+            }
+            assertEquals(5, world.recordedSchedules.size());
+
+            // Now place a POWERED observer in chunk (0,0) and flood chunk (0,0) with >2 scheduled ticks
+            BlockPosition obsPos = new BlockPosition(2, 64, 2);
+            setBlock(chunk, obsPos, powered);
+
+            BlockPosition filler1 = new BlockPosition(3, 64, 2);
+            BlockPosition filler2 = new BlockPosition(4, 64, 2);
+            Block fillerBlock = new Block(Material.STONE) {};
+            fillerBlock.timing = NOOP_TIMING;
+            setBlock(chunk, filler1, fillerBlock.getBlockData());
+            setBlock(chunk, filler2, fillerBlock.getBlockData());
+
+            world.a(filler1, fillerBlock, 0);
+            world.a(filler2, fillerBlock, 0);
+            world.a(new BlockPosition(6, 64, 2), fillerBlock, 0);
+            // Observer falling edge scheduled AFTER chunk already has >=2 scheduled ticks
+            world.a(obsPos, observer, 0);
+
+            world.a(false);
+
+            // Falling edge MUST have executed and cleared POWERED=false!
+            assertEquals(Boolean.FALSE, chunk.getBlockData(obsPos).get(BlockObserver.a));
+        } finally {
+            observer.timing = prevTiming;
+        }
+    }
