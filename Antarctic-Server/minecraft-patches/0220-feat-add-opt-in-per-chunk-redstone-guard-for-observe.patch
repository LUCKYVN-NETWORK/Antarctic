     // Airplane end
 
+    // Antarctic start - transient per-chunk sliding-window redstone guard counters (not saved to NBT)
+    private long antarcticRedstoneWindowStart = Long.MIN_VALUE;
+    private int antarcticObserverRisingOps;
+    private int antarcticPistonOps;
+    private int antarcticDiodeOps;
+    private int antarcticNoteBlockOps;
+
+    private void rollRedstoneGuardWindow(long nowTick) {
+        if (this.antarcticRedstoneWindowStart == Long.MIN_VALUE
+                || nowTick < this.antarcticRedstoneWindowStart
+                || (nowTick - this.antarcticRedstoneWindowStart) >= com.destroystokyo.paper.config.toml.modules.optimizations.RedstoneGuard.windowTicks) {
+            this.antarcticRedstoneWindowStart = nowTick;
+            this.antarcticObserverRisingOps = 0;
+            this.antarcticPistonOps = 0;
+            this.antarcticDiodeOps = 0;
+            this.antarcticNoteBlockOps = 0;
+        }
+    }
+
+    public boolean allowRedstoneObserverPulse(long nowTick) {
+        this.rollRedstoneGuardWindow(nowTick);
+        return ++this.antarcticObserverRisingOps <= com.destroystokyo.paper.config.toml.modules.optimizations.RedstoneGuard.maxObserverPulsesPerChunkPerWindow;
+    }
+
+    public boolean allowRedstonePistonAction(long nowTick) {
+        this.rollRedstoneGuardWindow(nowTick);
+        return ++this.antarcticPistonOps <= com.destroystokyo.paper.config.toml.modules.optimizations.RedstoneGuard.maxPistonActionsPerChunkPerWindow;
+    }
+
+    public boolean shouldStretchDiodeDelay(long nowTick) {
+        this.rollRedstoneGuardWindow(nowTick);
+        return ++this.antarcticDiodeOps > com.destroystokyo.paper.config.toml.modules.optimizations.RedstoneGuard.maxDiodeUpdatesPerChunkPerWindow;
+    }
+
+    public boolean allowRedstoneNoteBlockPlay(long nowTick) {
+        this.rollRedstoneGuardWindow(nowTick);
+        return ++this.antarcticNoteBlockOps <= com.destroystokyo.paper.config.toml.modules.optimizations.RedstoneGuard.maxNoteBlockPlaysPerChunkPerWindow;
+    }
+    // Antarctic end
+
