+    @Test
+    public void testFairScheduledTickQuotaAndUnloadedBackoff() throws Exception {
+        RedstoneGuard.enabled = true;
+        RedstoneGuard.maxScheduledTicksPerChunkPerTick = 8;
+        RedstoneGuard.unloadedChunkTickBackoffTicks = 20;
+
+        MockWorldServer world = newMockWorld();
+        Chunk chunkA = newLoadedChunk(world, 0, 0);
+        Chunk chunkB = newLoadedChunk(world, 1, 0);
+
+        final int[] countA = {0};
+        final int[] countB = {0};
+        Block counterA = new Block(Material.STONE) {
+            @Override
+            public void b(World w, BlockPosition p, IBlockData d, Random r) {
+                countA[0]++;
+            }
+        };
+        counterA.timing = NOOP_TIMING;
+        Block counterB = new Block(Material.STONE) {
+            @Override
+            public void b(World w, BlockPosition p, IBlockData d, Random r) {
+                countB[0]++;
+            }
+        };
+        counterB.timing = NOOP_TIMING;
+
+        for (int i = 0; i < 20; i++) {
+            BlockPosition p = new BlockPosition(i & 15, 64 + (i >> 4), 0);
+            setBlock(chunkA, p, counterA.getBlockData());
+            world.a(p, counterA, 0);
+        }
+        for (int i = 0; i < 6; i++) {
+            BlockPosition p = new BlockPosition(16 + i, 64, 0);
+            setBlock(chunkB, p, counterB.getBlockData());
+            world.a(p, counterB, 0);
+        }
+        // Unloaded chunk tick at (320, 64, 320) scheduled before chunk unload
+        world.b(new BlockPosition(320, 64, 320), counterA, 0, 0);
+
+        world.recordedSchedules.clear();
+        world.a(false);
+
+        // Chunk A bounded to 8, Chunk B runs all 6 unstarved!
+        assertEquals(8, countA[0]);
+        assertEquals(6, countB[0]);
+
+        // Unloaded chunk tick was re-scheduled with backoff = 20 (not 0), and 12 deferred ticks from A with delay 1
+        boolean sawUnloadedBackoff = false;
+        int deferredA = 0;
+        for (ScheduledCall call : world.recordedSchedules) {
+            if (call.pos.getX() == 320 && call.delay == 20) {
+                sawUnloadedBackoff = true;
+            } else if ((call.pos.getX() >> 4) == 0 && call.delay == 1) {
+                deferredA++;
+            }
+        }
+        assertTrue(sawUnloadedBackoff);
+        assertEquals(12, deferredA);
+    }
