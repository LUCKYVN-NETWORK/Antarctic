+    private static void setBlock(Chunk chunk, BlockPosition pos, IBlockData data) {
+        int secIdx = pos.getY() >> 4;
+        ChunkSection[] sections = chunk.getSections();
+        ChunkSection section = sections[secIdx];
+        if (section == null) {
+            section = new ChunkSection(pos.getY() & ~15, true);
+            sections[secIdx] = section;
+        }
+        section.setType(pos.getX() & 15, pos.getY() & 15, pos.getZ() & 15, data);
+    }
