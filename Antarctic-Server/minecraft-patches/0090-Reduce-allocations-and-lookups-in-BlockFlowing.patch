+        EnumSet<EnumDirection> all = EnumSet.noneOf(EnumDirection.class);
+        all.add(EnumDirection.EAST);
+        all.add(EnumDirection.WEST);
+        all.add(EnumDirection.SOUTH);
+        all.add(EnumDirection.NORTH);
+        List<EnumDirection> iterated = new ArrayList<EnumDirection>(all);
+        assertEquals(EnumDirection.NORTH, iterated.get(0));
+        assertEquals(EnumDirection.SOUTH, iterated.get(1));
