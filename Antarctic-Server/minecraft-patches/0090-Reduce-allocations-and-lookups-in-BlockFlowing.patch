+    private static IBlockData randomTerrain(Random random) {
+        int r = random.nextInt(100);
+        if (r < 52) {
+            return Blocks.AIR.getBlockData();
+        } else if (r < 66) {
+            return Blocks.STONE.getBlockData();
+        } else if (r < 72) {
+            return Blocks.FLOWING_WATER.getBlockData().set(BlockFluids.LEVEL, 0);
+        } else if (r < 77) {
+            return Blocks.FLOWING_WATER.getBlockData().set(BlockFluids.LEVEL, 1 + random.nextInt(7));
+        } else if (r < 80) {
+            return Blocks.FLOWING_LAVA.getBlockData().set(BlockFluids.LEVEL, random.nextInt(8));
+        } else if (r < 83) {
+            return Blocks.WOODEN_DOOR.getBlockData();
+        } else if (r < 86) {
+            return Blocks.LADDER.getBlockData();
+        } else if (r < 89) {
+            return Blocks.STANDING_SIGN.getBlockData();
+        } else if (r < 92) {
+            return Blocks.REEDS.getBlockData();
+        } else if (r < 94) {
+            return Blocks.PORTAL.getBlockData();
+        } else {
+            return Blocks.FLOWING_WATER.getBlockData().set(BlockFluids.LEVEL, 8 + random.nextInt(8)); // falling water
