+    @Test
+    public void slopeSearchMatchesTheOldImplementation() throws Exception {
+        BlockFlowing[] fluids = {Blocks.FLOWING_WATER, Blocks.FLOWING_LAVA};
+        int compared = 0;
+        int nonTrivial = 0;
+        for (boolean nether : new boolean[] {false, true}) {
+            for (long seed = 1; seed <= 6; ++seed) {
+                TerrainProvider[] holder = new TerrainProvider[1];
+                WorldServer world = buildTerrain(seed, nether, holder);
+                Random random = new Random(seed * 31);
+                for (int n = 0; n < 1500; ++n) {
+                    BlockPosition pos = new BlockPosition(random.nextInt(48) - 24, 2 + random.nextInt(12), random.nextInt(48) - 24);
+                    for (BlockFlowing fluid : fluids) {
+                        List<EnumDirection> expected = new ArrayList<EnumDirection>(oldC(fluid, world, pos)); // EnumSet: ordinal order
+                        List<EnumDirection> actual = newOrder(fluid, world, pos);
+                        assertEquals("fluid=" + fluid.material + " nether=" + nether + " pos=" + pos, expected, actual);
+                        ++compared;
+                        if (expected.size() > 0 && expected.size() < 4) {
+                            ++nonTrivial;
+                        }
+                    }
+                }
+            }
+        }
+        assertTrue("the terrain must exercise real slope decisions, not only all-or-nothing", nonTrivial > 200);
+        assertTrue(compared > 10000);
+    }
