+    // ----------------------------------------------------------------- the new implementation, through reflection
+
+    private static Method flowDirections;
+    private static EnumDirection[] horizontal;
+    private static int[] flowOrderBits;
+
+    @SuppressWarnings("unchecked")
+    private static void reflect() throws Exception {
+        if (flowDirections != null) {
+            return;
+        }
+        flowDirections = BlockFlowing.class.getDeclaredMethod("getFlowDirections", World.class, BlockPosition.class);
+        flowDirections.setAccessible(true);
+        Field h = BlockFlowing.class.getDeclaredField("HORIZONTAL_DIRECTIONS");
+        h.setAccessible(true);
+        horizontal = (EnumDirection[]) h.get(null);
+        Field o = BlockFlowing.class.getDeclaredField("FLOW_ORDER_BITS");
+        o.setAccessible(true);
+        flowOrderBits = (int[]) o.get(null);
+    }
+
+    /** The directions in the exact order BlockFlowing.b applies them. */
+    static List<EnumDirection> newOrder(BlockFlowing fluid, World world, BlockPosition pos) throws Exception {
+        reflect();
+        int mask = (Integer) flowDirections.invoke(fluid, world, pos);
+        List<EnumDirection> order = new ArrayList<EnumDirection>();
+        for (int n = 0; n < 4; ++n) {
+            int bit = flowOrderBits[n];
+            if ((mask & (1 << bit)) != 0) {
+                order.add(horizontal[bit]);
+            }
+        }
+        return order;
+    }
