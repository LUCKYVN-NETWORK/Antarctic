+    /** Fills chunks -2..1 on both axes (blocks -32..31), y = 1..14, then returns the world. */
+    static WorldServer buildTerrain(long seed, boolean nether, TerrainProvider[] providerOut) throws Exception {
+        WorldServer world = newWorld(nether, providerOut);
+        Random random = new Random(seed);
+        for (int cx = -2; cx <= 1; ++cx) {
