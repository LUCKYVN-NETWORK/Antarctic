+package net.minecraft.server;
+
+import static org.junit.Assert.assertTrue;
+
+import java.lang.management.ManagementFactory;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.Random;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/** Timed and allocation-counting comparison of the old and new slope search on identical terrain. */
+public class BlockFlowingPerfTest {
+
+    private static final com.sun.management.ThreadMXBean MX = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        BlockFlowingParityTest.bootstrap();
+    }
+
+    private static long sink;
+
+    @Test
+    public void slopeSearchIsFasterAndAllocatesLess() throws Exception {
+        BlockFlowingParityTest.TerrainProvider[] holder = new BlockFlowingParityTest.TerrainProvider[1];
+        WorldServer world = BlockFlowingParityTest.buildTerrain(99, false, holder);
+        Method flowDirections = BlockFlowing.class.getDeclaredMethod("getFlowDirections", World.class, BlockPosition.class);
+        flowDirections.setAccessible(true);
+        BlockFlowing fluid = Blocks.FLOWING_WATER;
+
+        // Open flat terrain: the realistic hot case (a sheet of water with holes), where slope searches run to full depth.
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                Chunk chunk = holder[0].getChunkIfLoaded(cx, cz);
+                for (int x = 0; x < 16; ++x) {
+                    for (int z = 0; z < 16; ++z) {
+                        BlockFlowingParityTest.put(chunk, x, 9, z, (x * 7 + z * 13) % 11 == 0 ? Blocks.AIR.getBlockData() : Blocks.STONE.getBlockData());
+                        BlockFlowingParityTest.put(chunk, x, 10, z, Blocks.AIR.getBlockData());
+                    }
+                }
+            }
+        }
+        Random random = new Random(5);
+        BlockPosition[] positions = new BlockPosition[20_000];
+        for (int i = 0; i < positions.length; ++i) {
+            positions[i] = new BlockPosition(random.nextInt(40) - 20, 10, random.nextInt(40) - 20);
+        }
+
+        long oldNanos = Long.MAX_VALUE;
+        long newNanos = Long.MAX_VALUE;
+        long oldBytes = 0;
+        long newBytes = 0;
+        for (int round = 0; round < 6; ++round) {
+            long a0 = MX.getThreadAllocatedBytes(Thread.currentThread().getId());
+            long t0 = System.nanoTime();
+            for (BlockPosition pos : positions) {
+                sink += BlockFlowingParityTest.oldC(fluid, world, pos).size();
+            }
+            oldNanos = Math.min(oldNanos, System.nanoTime() - t0);
+            oldBytes = MX.getThreadAllocatedBytes(Thread.currentThread().getId()) - a0;
+
+            a0 = MX.getThreadAllocatedBytes(Thread.currentThread().getId());
+            t0 = System.nanoTime();
+            for (BlockPosition pos : positions) {
+                sink += (Integer) flowDirections.invoke(fluid, world, pos);
+            }
+            newNanos = Math.min(newNanos, System.nanoTime() - t0);
+            newBytes = MX.getThreadAllocatedBytes(Thread.currentThread().getId()) - a0;
+        }
+        System.out.println("[perf] BlockFlowing slope search, 20k positions on open terrain: old=" + oldNanos / 1000 + "us/" + oldBytes / 1024
+                + "KiB new=" + newNanos / 1000 + "us/" + newBytes / 1024 + "KiB time=" + String.format("%.2f", (double) oldNanos / Math.max(1, newNanos))
+                + "x alloc=" + String.format("%.1f", (double) oldBytes / Math.max(1, newBytes)) + "x (new includes reflection overhead) sink=" + sink);
+        assertTrue("new slope search should allocate clearly less", newBytes * 2 < oldBytes);
+        assertTrue("new slope search should be faster", newNanos < oldNanos);
+    }
+}
