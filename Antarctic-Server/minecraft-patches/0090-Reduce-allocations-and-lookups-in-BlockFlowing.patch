+        // Chunks -2..1 are loaded; probe across and beyond the loaded border, including negative coordinates.
+        for (int x = -40; x <= 40; x += 3) {
+            for (int z = -40; z <= 40; z += 3) {
+                for (EnumDirection direction : directions) {
+                    BlockPosition pos = new BlockPosition(x, 5, z);
+                    // Old: source.getWorld().isChunkLoaded((x + face.modX) >> 4, (z + face.modZ) >> 4)
+                    // == ChunkProviderServer.isLoaded(...); BlockFace.getModX/Z equal EnumDirection's adjacent offsets.
+                    boolean expected = holder[0].isLoaded((x + direction.getAdjacentX()) >> 4, (z + direction.getAdjacentZ()) >> 4);
+                    boolean actual = (Boolean) canFlowTo.invoke(Blocks.FLOWING_WATER, world, pos, direction);
+                    assertEquals("x=" + x + " z=" + z + " " + direction, expected, actual);
+                    if (!expected) {
+                        ++unloaded;
+                    }
+                }
+            }
+        }
+        assertTrue("the probe must include unloaded targets", unloaded > 100);
+    }
+
+    @Test
+    public void slopeSearchOnAnEmptyWorldAndAtLoadedBorder() throws Exception {
+        TerrainProvider[] holder = new TerrainProvider[1];
+        WorldServer world = newWorld(false, holder);
+        for (BlockFlowing fluid : new BlockFlowing[] {Blocks.FLOWING_WATER, Blocks.FLOWING_LAVA}) {
+            BlockPosition pos = new BlockPosition(0, 10, 0);
+            assertEquals(new ArrayList<EnumDirection>(oldC(fluid, world, pos)), newOrder(fluid, world, pos));
+            // y = 1: the "below" read goes to y = 0; y = 0 itself reads y = -1 (the old code did the same through getType).
+            for (int y : new int[] {0, 1}) {
+                BlockPosition low = new BlockPosition(15, y, 15);
+                assertEquals(new ArrayList<EnumDirection>(oldC(fluid, world, low)), newOrder(fluid, world, low));
+            }
+        }
+        assertFalse(holder[0].chunks.isEmpty());
+    }
+}
