+    /** A provider whose chunks are pre-built terrain; anything else is an empty chunk, like a freshly generated void. */
+    static final class TerrainProvider extends ChunkProviderServer {
+        TerrainProvider(WorldServer world) {
+            super(world, null, null);
+        }
+
+        @Override
+        public Chunk originalGetChunkAt(int x, int z) {
+            return install(this, x, z);
+        }
+    }
+
+    static void set(Class<?> owner, Object instance, String name, Object value) throws Exception {
+        Field field = owner.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(instance, value);
+    }
+
+    static Chunk install(ChunkProviderServer provider, int x, int z) {
+        try {
+            Chunk chunk = (Chunk) unsafe.allocateInstance(Chunk.class);
+            set(Chunk.class, chunk, "sections", new ChunkSection[16]);
+            // ChunkProviderServer.chunks keeps a last-chunk cache keyed on Chunk.chunkKey; it must match the real key.
+            set(Chunk.class, chunk, "chunkKey", ChunkCoordIntPair.a(x, z));
+            provider.chunks.put(ChunkCoordIntPair.a(x, z), chunk);
+            return chunk;
+        } catch (Exception e) {
+            throw new AssertionError(e);
+        }
+    }
+
+    static void put(Chunk chunk, int x, int y, int z, IBlockData state) {
+        ChunkSection[] sections = chunk.getSections();
+        int index = y >> 4;
+        if (sections[index] == null) {
+            sections[index] = new ChunkSection(index << 4, true);
+        }
+        sections[index].setType(x & 15, y & 15, z & 15, state);
+    }
+
+    static WorldServer newWorld(boolean nether, TerrainProvider[] providerOut) throws Exception {
+        WorldServer world = (WorldServer) unsafe.allocateInstance(WorldServer.class);
+        set(World.class, world, "paperConfig", unsafe.allocateInstance(com.destroystokyo.paper.PaperWorldConfig.class));
+        WorldProvider wp = (WorldProvider) unsafe.allocateInstance(WorldProviderNormal.class);
+        set(WorldProvider.class, wp, "d", nether); // WorldProvider.l(): true in the nether
+        world.worldProvider = wp;
+        TerrainProvider provider = new TerrainProvider(world);
+        set(World.class, world, "chunkProvider", provider);
+        providerOut[0] = provider;
+        return world;
+    }
