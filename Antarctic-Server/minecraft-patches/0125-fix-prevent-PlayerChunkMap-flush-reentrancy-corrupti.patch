+    private void compactLoadList() {
+        int write = 0;
+        int size = this.h.size();
+        for (int read = 0; read < size; ++read) {
+            PlayerChunk pc = this.h.get(read);
+            if (pc != null) {
+                if (write != read) {
+                    this.h.set(write, pc);
+                }
+                pc.antarcticLoadIdx = write++;
+            }
+        }
+        if (write < size) {
+            this.truncateList(this.h, write);
+        }
+    }
+
+    private void compactSendList() {
+        int write = 0;
+        int size = this.g.size();
+        for (int read = 0; read < size; ++read) {
+            PlayerChunk pc = this.g.get(read);
+            if (pc != null) {
+                if (write != read) {
+                    this.g.set(write, pc);
+                }
+                pc.antarcticSendIdx = write++;
+            }
+        }
+        if (write < size) {
+            this.truncateList(this.g, write);
+        }
+    }
