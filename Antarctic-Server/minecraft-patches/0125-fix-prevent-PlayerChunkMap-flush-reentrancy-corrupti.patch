+package net.minecraft.server;
+
+import co.aikar.timings.WorldTimingsHandler;
+import com.destroystokyo.paper.PaperWorldConfig;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import it.unimi.dsi.fastutil.objects.ObjectArrayList;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class PlayerChunkMapFlushReentrancyTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    private static final class ReentrantPlayerChunk extends PlayerChunk {
+        Runnable onSend;
+        boolean sendResult;
+
+        ReentrantPlayerChunk() {
+            super(null, 0, 0);
+        }
+
+        @Override
+        public boolean b() {
+            if (onSend != null) {
+                onSend.run();
+            }
+            return sendResult;
+        }
+    }
+
+    private static PlayerChunkMap newStubMap() throws Exception {
+        WorldServer world = (WorldServer) unsafe.allocateInstance(WorldServer.class);
+        PaperWorldConfig pwc = (PaperWorldConfig) unsafe.allocateInstance(PaperWorldConfig.class);
+        pwc.maxChunkGensPerTick = 100;
+        pwc.maxChunkSendsPerTick = 100;
+        Field paperConfigField = World.class.getDeclaredField("paperConfig");
+        paperConfigField.setAccessible(true);
+        paperConfigField.set(world, pwc);
+
+        WorldTimingsHandler timings = (WorldTimingsHandler) unsafe.allocateInstance(WorldTimingsHandler.class);
+        Field sendTiming = WorldTimingsHandler.class.getDeclaredField("doChunkMapPendingSendToPlayers");
+        sendTiming.setAccessible(true);
+        sendTiming.set(timings, co.aikar.timings.Timings.NULL_HANDLER);
+        Field loadTiming = WorldTimingsHandler.class.getDeclaredField("doChunkMapPlayersNeedingChunks");
+        loadTiming.setAccessible(true);
+        loadTiming.set(timings, co.aikar.timings.Timings.NULL_HANDLER);
+        Field updateTiming = WorldTimingsHandler.class.getDeclaredField("doChunkMapUpdate");
+        updateTiming.setAccessible(true);
+        updateTiming.set(timings, co.aikar.timings.Timings.NULL_HANDLER);
+        Field unloadTiming = WorldTimingsHandler.class.getDeclaredField("doChunkMapUnloadChunks");
+        unloadTiming.setAccessible(true);
+        unloadTiming.set(timings, co.aikar.timings.Timings.NULL_HANDLER);
+        Field timingsField = World.class.getDeclaredField("timings");
+        timingsField.setAccessible(true);
+        timingsField.set(world, timings);
+
+        Field worldDataField = World.class.getDeclaredField("worldData");
+        worldDataField.setAccessible(true);
+        WorldData wd = (WorldData) unsafe.allocateInstance(WorldData.class);
+        worldDataField.set(world, wd);
+
+        PlayerChunkMap map = (PlayerChunkMap) unsafe.allocateInstance(PlayerChunkMap.class);
+        setField(map, "world", world);
+        List<EntityPlayer> players = new ArrayList<>();
+        // Add a dummy player so managedPlayers.isEmpty() branch isn't entered
+        players.add((EntityPlayer) unsafe.allocateInstance(EntityPlayer.class));
+        setField(map, "managedPlayers", players);
+        setField(map, "e", new Long2ObjectOpenHashMap<PlayerChunk>());
+        setField(map, "f", new HashSet<PlayerChunk>());
+        setField(map, "g", new ObjectArrayList<PlayerChunk>());
+        setField(map, "h", new ObjectArrayList<PlayerChunk>());
+        setField(map, "i", new ObjectArrayList<PlayerChunk>());
+        setField(map, "l", false);
+        setField(map, "m", false);
+        return map;
+    }
+
+    private static void setField(Object target, String name, Object value) throws Exception {
+        Field f = PlayerChunkMap.class.getDeclaredField(name);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<PlayerChunk> getList(PlayerChunkMap map, String name) throws Exception {
+        Field f = PlayerChunkMap.class.getDeclaredField(name);
+        f.setAccessible(true);
+        return (List<PlayerChunk>) f.get(map);
+    }
+
+    private static ReentrantPlayerChunk newChunk(boolean sendResult, Runnable onSend) throws Exception {
+        ReentrantPlayerChunk pc = (ReentrantPlayerChunk) unsafe.allocateInstance(ReentrantPlayerChunk.class);
+        pc.antarcticLoadIdx = -1;
+        pc.antarcticSendIdx = -1;
+        pc.antarcticAllIdx = -1;
+        pc.sendResult = sendResult;
+        pc.onSend = onSend;
+        return pc;
+    }
+
+    @Test
+    public void testReentrantAddAndRemoveDuringSendFlushPreservesNewEntriesAndIndices() throws Exception {
+        PlayerChunkMap map = newStubMap();
+        List<PlayerChunk> sendList = getList(map, "g");
+        Method removeFromSendList = PlayerChunkMap.class.getDeclaredMethod("removeFromSendList", PlayerChunk.class);
+        removeFromSendList.setAccessible(true);
+
+        ReentrantPlayerChunk reentrantAdded = newChunk(false, null);
+        ReentrantPlayerChunk pc1 = newChunk(true, null);
+        ReentrantPlayerChunk pc2 = newChunk(false, null);
+        ReentrantPlayerChunk pc3 = newChunk(true, null);
+
+        // During pc1.b(), re-entrantly remove pc2 AND append reentrantAdded to sendList
+        pc1.onSend = () -> {
+            try {
+                removeFromSendList.invoke(map, pc2);
+                reentrantAdded.antarcticSendIdx = sendList.size();
+                sendList.add(reentrantAdded);
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
+        };
+
+        pc1.antarcticSendIdx = 0; sendList.add(pc1);
+        pc2.antarcticSendIdx = 1; sendList.add(pc2);
+        pc3.antarcticSendIdx = 2; sendList.add(pc3);
+
+        // Previously threw IndexOutOfBoundsException OR truncated reentrantAdded silently
+        map.flush();
+
+        Assert.assertEquals("Only reentrantAdded must remain in sendList", 1, sendList.size());
+        Assert.assertSame("Re-entrantly appended PlayerChunk must NOT be silently dropped", reentrantAdded, sendList.get(0));
+        Assert.assertEquals("Compacted intrusive index must match slot 0", 0, reentrantAdded.antarcticSendIdx);
+        Assert.assertEquals(-1, pc1.antarcticSendIdx);
+        Assert.assertEquals(-1, pc2.antarcticSendIdx);
+        Assert.assertEquals(-1, pc3.antarcticSendIdx);
+    }
+
+    @Test
+    public void testExceptionDuringSendFlushStillCompactsTombstones() throws Exception {
+        PlayerChunkMap map = newStubMap();
+        List<PlayerChunk> sendList = getList(map, "g");
+
+        ReentrantPlayerChunk pc1 = newChunk(true, null);
+        ReentrantPlayerChunk pc2 = newChunk(false, () -> {
+            throw new IllegalStateException("simulated plugin failure");
+        });
+        ReentrantPlayerChunk pc3 = newChunk(false, null);
+
+        pc1.antarcticSendIdx = 0; sendList.add(pc1);
+        pc2.antarcticSendIdx = 1; sendList.add(pc2);
+        pc3.antarcticSendIdx = 2; sendList.add(pc3);
+
+        try {
+            map.flush();
+            Assert.fail("Expected simulated exception");
+        } catch (IllegalStateException expected) {
+            // expected
+        }
+
+        Assert.assertEquals("Remaining 2 chunks must be compacted without nulls", 2, sendList.size());
+        Assert.assertSame(pc2, sendList.get(0));
+        Assert.assertSame(pc3, sendList.get(1));
+        Assert.assertEquals(0, pc2.antarcticSendIdx);
+        Assert.assertEquals(1, pc3.antarcticSendIdx);
+        Assert.assertEquals(-1, pc1.antarcticSendIdx);
+    }
+}
