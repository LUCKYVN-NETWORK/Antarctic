+    @Test
+    public void testFastRandomBitExactParity() {
+        long[] seeds = { 0L, 1L, -1L, 341873128712L, 0xCAFEBABEDEADBEEFL };
+        int[] bounds = { 1, 2, 3, 4, 5, 6, 7, 10, 15, 16, 80, 256, 1000 };
+
+        for (long seed : seeds) {
+            Random ref = new Random(seed);
+            FastRandom opt = new FastRandom(seed);
+
+            for (int step = 0; step < 50000; ++step) {
+                int op = step % 8;
+                switch (op) {
+                    case 0:
+                        assertEquals("nextInt mismatch", ref.nextInt(), opt.nextInt());
+                        break;
+                    case 1:
+                        int b = bounds[step % bounds.length];
+                        assertEquals("nextInt(bound) mismatch b=" + b, ref.nextInt(b), opt.nextInt(b));
+                        break;
+                    case 2:
+                        assertEquals("nextLong mismatch", ref.nextLong(), opt.nextLong());
+                        break;
+                    case 3:
+                        assertEquals("nextFloat mismatch", Float.floatToRawIntBits(ref.nextFloat()), Float.floatToRawIntBits(opt.nextFloat()));
+                        break;
+                    case 4:
+                        assertEquals("nextDouble mismatch", Double.doubleToRawLongBits(ref.nextDouble()), Double.doubleToRawLongBits(opt.nextDouble()));
+                        break;
+                    case 5:
+                        assertEquals("nextBoolean mismatch", ref.nextBoolean(), opt.nextBoolean());
+                        break;
+                    case 6:
+                        assertEquals("nextGaussian mismatch", Double.doubleToRawLongBits(ref.nextGaussian()), Double.doubleToRawLongBits(opt.nextGaussian()));
+                        break;
+                    case 7:
+                        if (step % 511 == 0) {
+                            long newSeed = seed ^ (step * 0x9E3779B97F4A7C15L);
+                            ref.setSeed(newSeed);
+                            opt.setSeed(newSeed);
+                        } else {
+                            assertEquals("nextInt(5) mismatch", ref.nextInt(5), opt.nextInt(5));
+                        }
+                        break;
+                }
+            }
+        }
+    }
