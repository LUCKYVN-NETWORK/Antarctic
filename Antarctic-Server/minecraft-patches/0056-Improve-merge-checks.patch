From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Sat, 7 May 2022 20:09:43 +0200
Subject: [PATCH 056/176] Improve merge checks

- Backport Dionysus server/0044-Improve-merge-checks.patch
- Source: https://github.com/nopjmp/Dionysus at b5c71b62f6f1f555b22bd52f5751e33be4690b6e
- Author: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
- Add improve-merge-checks setting to AntarcticConfig (defaults to true)
- PlayerInventory: check stackability and slot capacity before expensive NBT comparison in merge checks
- PlayerInventory: short-circuit firstPartial for unstackable items

diff --git a/main/java/com/destroystokyo/paper/AntarcticConfig.java b/main/java/com/destroystokyo/paper/AntarcticConfig.java
index 0143812..9c5f8bd 100644
--- a/main/java/com/destroystokyo/paper/AntarcticConfig.java
+++ b/main/java/com/destroystokyo/paper/AntarcticConfig.java
@@ -191,4 +191,11 @@ public class AntarcticConfig {
         redactPlayerData = getBoolean("redact-player-data", redactPlayerData);
     }
 
+    public static boolean improveMergeChecks = true;
+    private static void improveMergeChecks() {
+        setComment("improve-merge-checks",
+            "Optimize inventory merge checks by testing stackability and counts before expensive NBT comparison.");
+        improveMergeChecks = getBoolean("improve-merge-checks", improveMergeChecks);
+    }
+
 }
diff --git a/main/java/net/minecraft/server/PlayerInventory.java b/main/java/net/minecraft/server/PlayerInventory.java
index 5c193db..91fa588 100644
--- a/main/java/net/minecraft/server/PlayerInventory.java
+++ b/main/java/net/minecraft/server/PlayerInventory.java
@@ -86,6 +86,11 @@ public class PlayerInventory implements IInventory {
     }
 
     private boolean a(ItemStack itemstack, ItemStack itemstack1) {
+        // Antarctic start - fast merge checks
+        if (com.destroystokyo.paper.AntarcticConfig.improveMergeChecks) {
+            return !itemstack.isEmpty() && itemstack.isStackable() && itemstack.getCount() < itemstack.getMaxStackSize() && itemstack.getCount() < this.getMaxStackSize() && this.b(itemstack, itemstack1);
+        }
+        // Antarctic end
         return !itemstack.isEmpty() && this.b(itemstack, itemstack1) && itemstack.isStackable() && itemstack.getCount() < itemstack.getMaxStackSize() && itemstack.getCount() < this.getMaxStackSize();
     }
 
@@ -265,6 +270,11 @@ public class PlayerInventory implements IInventory {
     }
 
     public int firstPartial(ItemStack itemstack) {
+        // Antarctic start - fast merge checks
+        if (com.destroystokyo.paper.AntarcticConfig.improveMergeChecks && !itemstack.isStackable()) {
+            return -1;
+        }
+        // Antarctic end
         if (this.a(this.getItem(this.itemInHandIndex), itemstack)) {
             return this.itemInHandIndex;
         } else if (this.a(this.getItem(40), itemstack)) {
