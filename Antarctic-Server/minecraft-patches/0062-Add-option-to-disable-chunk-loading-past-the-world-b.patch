From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AlexProgrammerDE <40795980+AlexProgrammerDE@users.noreply.github.com>
Date: Fri, 10 Jun 2022 19:12:12 +0200
Subject: [PATCH 062/191] Add option to disable chunk loading past the world
 border

- Add no-chunks-past-world-border config option (defaults to false)
- Prevent player tracking from loading/generating chunks outside the world border
- Allocate local MutableBlockPosition in WorldBorder bounds checks to avoid cross-thread collisions

diff --git a/main/java/com/destroystokyo/paper/AntarcticConfig.java b/main/java/com/destroystokyo/paper/AntarcticConfig.java
index 8c2b099..2fca861 100644
--- a/main/java/com/destroystokyo/paper/AntarcticConfig.java
+++ b/main/java/com/destroystokyo/paper/AntarcticConfig.java
@@ -249,4 +249,12 @@ public class AntarcticConfig {
         mapDecorationsLimit = getInt("map-decorations-limit", 25);
     }
 
+    public static boolean noChunksPastWorldBorder = false;
+    private static void noChunksPastWorldBorder() {
+        setComment("no-chunks-past-world-border",
+            "When enabled, prevents players from loading or generating chunks past the world border edge.",
+            "Defaults to false to preserve vanilla border visibility.");
+        noChunksPastWorldBorder = getBoolean("no-chunks-past-world-border", false);
+    }
+
 }
diff --git a/main/java/net/minecraft/server/PlayerChunk.java b/main/java/net/minecraft/server/PlayerChunk.java
index 01c6467..dfffda2 100644
--- a/main/java/net/minecraft/server/PlayerChunk.java
+++ b/main/java/net/minecraft/server/PlayerChunk.java
@@ -64,6 +64,7 @@ public class PlayerChunk {
         if (this.c.contains(entityplayer)) {
             PlayerChunk.a.debug("Failed to add player. {} already is in chunk {}, {}", entityplayer, Integer.valueOf(this.location.x), Integer.valueOf(this.location.z));
         } else {
+            if (!com.destroystokyo.paper.AntarcticConfig.noChunksPastWorldBorder || playerChunkMap.getWorld().getWorldBorder().isChunkInBounds(location.x, location.z)) { // Dionysus
             if (this.c.isEmpty()) {
                 this.i = this.playerChunkMap.getWorld().getTime();
             }
@@ -77,7 +78,7 @@ public class PlayerChunk {
                 this.sendChunk(entityplayer);
             }
             // CraftBukkit end
-
+            } // Dionysus
         }
     }
 
diff --git a/main/java/net/minecraft/server/WorldBorder.java b/main/java/net/minecraft/server/WorldBorder.java
index 1bb172b..f404894 100644
--- a/main/java/net/minecraft/server/WorldBorder.java
+++ b/main/java/net/minecraft/server/WorldBorder.java
@@ -36,10 +36,12 @@ public class WorldBorder {
     // Paper start
     private final BlockPosition.MutableBlockPosition mutPos = new BlockPosition.MutableBlockPosition();
     public boolean isBlockInBounds(int chunkX, int chunkZ) {
+        BlockPosition.MutableBlockPosition mutPos = new BlockPosition.MutableBlockPosition(); // Dionysus - avoid collisions with other threads
         mutPos.setValues(chunkX, 64, chunkZ);
         return isInBounds(mutPos);
     }
     public boolean isChunkInBounds(int chunkX, int chunkZ) {
+        BlockPosition.MutableBlockPosition mutPos = new BlockPosition.MutableBlockPosition(); // Dionysus - avoid collisions with other threads
         mutPos.setValues(((chunkX << 4) + 15), 64, (chunkZ << 4) + 15);
         return isInBounds(mutPos);
     }
