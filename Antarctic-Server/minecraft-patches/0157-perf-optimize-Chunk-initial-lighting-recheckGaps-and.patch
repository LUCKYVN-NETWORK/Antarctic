+package net.minecraft.server;
+
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.lang.reflect.Field;
+import java.util.Random;
+
+import static org.junit.Assert.*;
+
+public class ChunkInitLightingAndGapsPerfTest {
+
+    private static Unsafe UNSAFE;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+    }
+
+    private static Chunk createTestChunk(ChunkSection[] sections) throws Exception {
+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        setField(chunk, "sections", sections);
+        setField(chunk, "heightMap", new int[256]);
+        setField(chunk, "h", new int[256]);
+        setField(chunk, "locX", 3);
+        setField(chunk, "locZ", -4);
+        return chunk;
+    }
+
+    private static void setField(Object target, String name, Object value) throws Exception {
+        Field f = Chunk.class.getDeclaredField(name);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    private static int getTopSectionY(ChunkSection[] sections) {
+        for (int i = sections.length - 1; i >= 0; --i) {
+            if (sections[i] != null) {
+                return sections[i].getYPosition();
+            }
+        }
+        return 0;
+    }
+
+    private static int getOpacity(ChunkSection[] sections, int x, int y, int z) {
+        if (y >= 0 && y >> 4 < sections.length) {
+            ChunkSection sec = sections[y >> 4];
+            if (sec != null) {
+                return sec.getType(x, y & 15, z).c();
+            }
+        }
+        return 0;
+    }
+
+    private static int vanillaInitLightingReference(ChunkSection[] sections, int[] heightMap, int[] h, int locX, int locZ, boolean hasSky, boolean notifyLight, ListSink sink) {
+        int i = getTopSectionY(sections);
+        int v = Integer.MAX_VALUE;
+        for (int j = 0; j < 16; ++j) {
+            int k = 0;
+            while (k < 16) {
+                h[j + (k << 4)] = -999;
+                int l = i + 16;
+                while (true) {
+                    if (l > 0) {
+                        if (getOpacity(sections, j, l - 1, k) == 0) {
+                            --l;
+                            continue;
+                        }
+                        heightMap[k << 4 | j] = l;
+                        if (l < v) {
+                            v = l;
+                        }
+                    }
+                    if (hasSky) {
+                        l = 15;
+                        int i1 = i + 16 - 1;
+                        do {
+                            int j1 = getOpacity(sections, j, i1, k);
+                            if (j1 == 0 && l != 15) {
+                                j1 = 1;
+                            }
+                            l -= j1;
+                            if (l > 0) {
+                                ChunkSection sec = sections[i1 >> 4];
+                                if (sec != null) {
+                                    sec.a(j, i1 & 15, k, l);
+                                    if (notifyLight) {
+                                        sink.accept(new BlockPosition((locX << 4) + j, i1, (locZ << 4) + k));
+                                    }
+                                }
+                            }
+                            --i1;
+                        } while (i1 > 0 && l > 0);
+                    }
+                    ++k;
+                    break;
+                }
+            }
+        }
+        return v;
+    }
+
+    private interface ListSink {
+        void accept(BlockPosition pos);
+    }
+
+    private static ChunkSection[] cloneSections(ChunkSection[] src) {
+        ChunkSection[] copy = new ChunkSection[src.length];
+        for (int i = 0; i < src.length; ++i) {
+            if (src[i] != null) {
+                ChunkSection s = new ChunkSection(src[i].getYPosition(), true);
+                for (int y = 0; y < 16; ++y) {
+                    for (int z = 0; z < 16; ++z) {
+                        for (int x = 0; x < 16; ++x) {
+                            IBlockData d = src[i].getType(x, y, z);
+                            if (d.getBlock() != Blocks.AIR) {
+                                s.setType(x, y, z, d);
+                            }
+                        }
+                    }
+                }
+                copy[i] = s;
+            }
+        }
+        return copy;
+    }
