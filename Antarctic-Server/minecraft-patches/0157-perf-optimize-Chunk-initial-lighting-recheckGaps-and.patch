+    @Test
+    public void testInitLightingBenchmark() throws Exception {
+        ChunkSection[] baseSections = new ChunkSection[16];
+        for (int s = 0; s < 5; ++s) {
+            baseSections[s] = new ChunkSection(s << 4, true);
+        }
+        IBlockData stone = Blocks.STONE.getBlockData();
+        IBlockData water = Blocks.WATER.getBlockData();
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                for (int y = 0; y < 60; ++y) {
+                    baseSections[y >> 4].setType(x, y & 15, z, stone);
+                }
+                for (int y = 60; y < 64; ++y) {
+                    baseSections[y >> 4].setType(x, y & 15, z, water);
+                }
+            }
+        }
+
+        ChunkSection[] refSections = cloneSections(baseSections);
+        ChunkSection[] optSections = cloneSections(baseSections);
+        int[] refHeightMap = new int[256];
+        int[] refH = new int[256];
+        Chunk optChunk = createTestChunk(optSections);
+
+        final int[] sinkSum = new int[1];
+        ListSink sink = pos -> sinkSum[0] ^= pos.getY();
+
+        long blackhole = 0L;
+        for (int i = 0; i < 600; ++i) {
+            vanillaInitLightingReference(refSections, refHeightMap, refH, 3, -4, true, true, sink);
+            optChunk.computeInitialLighting(true, false);
+            blackhole ^= refHeightMap[i & 255] ^ optChunk.r()[i & 255] ^ sinkSum[0];
+        }
+
+        int iters = 1500;
+        long t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            int v = vanillaInitLightingReference(refSections, refHeightMap, refH, 3, -4, true, true, sink);
+            blackhole ^= v ^ refHeightMap[i & 255];
+        }
+        long vanillaNs = (System.nanoTime() - t0) / iters;
+
+        t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            optChunk.computeInitialLighting(true, false);
+            blackhole ^= optChunk.w() ^ optChunk.r()[i & 255];
+        }
+        long optNs = (System.nanoTime() - t0) / iters;
+
+        System.out.printf("A3_BENCH init_lighting_vanilla_ns=%d init_lighting_opt_ns=%d speedup=%.2fx blackhole=%d%n",
+                vanillaNs, optNs, (double) vanillaNs / Math.max(1L, optNs), blackhole);
+
+        assertTrue("Expected initLighting speedup > 1.5x, got " + vanillaNs + " vs " + optNs, optNs * 1.5 < vanillaNs);
+    }
