+    @Test
+    public void testSinglePassInitLightingParityIncludingY0Quirk() throws Exception {
+        ChunkSection[] refSections = new ChunkSection[16];
+        for (int s = 0; s < 5; ++s) {
+            refSections[s] = new ChunkSection(s << 4, true);
+        }
+
+        Random rng = new Random(0xA3A3A3A3L);
+        IBlockData stone = Blocks.STONE.getBlockData();
+        IBlockData water = Blocks.WATER.getBlockData();
+        IBlockData leaves = Blocks.LEAVES.getBlockData();
+        IBlockData glass = Blocks.GLASS.getBlockData();
+        IBlockData glowstone = Blocks.GLOWSTONE.getBlockData();
+
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                if (x == 0 && z == 0) {
+                    // Column (0, 0): all-air down to y=0 -> verifies y=0 skylight quirk
+                    continue;
+                }
+                if (x == 1 && z == 0) {
+                    // Column (1, 0): opaque block at y=0 only -> heightMap=1, v=1, y=0 skylight untouched
+                    refSections[0].setType(x, 0, z, stone);
+                    continue;
+                }
+                int top = 40 + rng.nextInt(32);
+                for (int y = 0; y <= top; ++y) {
+                    IBlockData d;
+                    if (y == top && (x + z) % 3 == 0) {
+                        d = leaves;
+                    } else if (y > top - 4 && (x & 1) == 0) {
+                        d = water;
+                    } else if (y == top - 2 && (z & 1) == 1) {
+                        d = glass;
+                    } else if (y == 12 && x == 5) {
+                        d = glowstone;
+                    } else {
+                        d = stone;
+                    }
+                    refSections[y >> 4].setType(x, y & 15, z, d);
+                }
+            }
+        }
+
+        ChunkSection[] optSections = cloneSections(refSections);
+        int[] refHeightMap = new int[256];
+        int[] refH = new int[256];
+        int refV = vanillaInitLightingReference(refSections, refHeightMap, refH, 3, -4, true, false, pos -> {});
+
+        Chunk optChunk = createTestChunk(optSections);
+        optChunk.computeInitialLighting(true, false);
+
+        assertArrayEquals(refHeightMap, optChunk.r());
+        assertEquals(refV, optChunk.w());
+
+        for (int s = 0; s < 5; ++s) {
+            assertArrayEquals("SkyLight mismatch in section " + s,
+                    refSections[s].getSkyLightArray().asBytes(),
+                    optSections[s].getSkyLightArray().asBytes());
+        }
+        // Explicitly verify y=0 skylight nibble on all-air column (0, 0) stayed 0
+        assertEquals(0, optSections[0].b(0, 0, 0));
+        // Explicitly verify y=0 skylight nibble on opaque-at-0 column (1, 0) stayed 0
+        assertEquals(0, optSections[0].b(1, 0, 0));
+    }
