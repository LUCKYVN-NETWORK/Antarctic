+    @Test
+    public void testLightSourceCountTracking() {
+        ChunkSection sec = new ChunkSection(0, true);
+        assertFalse(sec.hasLightSources());
+
+        sec.setType(1, 2, 3, Blocks.GLOWSTONE.getBlockData());
+        assertTrue(sec.hasLightSources());
+
+        sec.setType(1, 2, 3, Blocks.STONE.getBlockData());
+        assertFalse(sec.hasLightSources());
+
+        // Snapshot path
+        ChunkSnapshot snap = new ChunkSnapshot();
+        snap.a(4, 5, 6, Blocks.TORCH.getBlockData());
+        ChunkSection fromSnap = new ChunkSection(0, true);
+        assertTrue(fromSnap.fillFromSnapshot(snap.rawBlocks(), 0));
+        assertTrue(fromSnap.hasLightSources());
+
+        // Anvil load path
+        byte[] blocks = new byte[4096];
+        NibbleArray data = new NibbleArray();
+        fromSnap.getBlocks().exportData(blocks, data);
+        ChunkSection fromAnvil = new ChunkSection(0, null, new NibbleArray(), new NibbleArray());
+        fromAnvil.loadFromAnvil(blocks, data, null);
+        assertTrue(fromAnvil.hasLightSources());
+        fromAnvil.recalcBlockCounts();
+        assertTrue(fromAnvil.hasLightSources());
+    }
