+    // Antarctic start - cache slime chunk roll keyed by slimeSeed to avoid per-check new Random(...)
+    private byte antarcticSlimeChunkState; // 0 = uncomputed, 1 = false, 2 = true
+    private long antarcticSlimeSeed;
+
+    public boolean isSlimeChunk(long slimeSeed) {
+        byte state = this.antarcticSlimeChunkState;
+        if (state != 0 && this.antarcticSlimeSeed == slimeSeed) {
+            return state == 2;
+        }
+        boolean result = this.a(slimeSeed).nextInt(10) == 0;
+        this.antarcticSlimeSeed = slimeSeed;
+        this.antarcticSlimeChunkState = result ? (byte) 2 : (byte) 1;
+        return result;
+    }
+    // Antarctic end
