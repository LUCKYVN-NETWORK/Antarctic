diff --git a/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/MobSpawning.java b/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/MobSpawning.java
new file mode 100644
index 0000000..215db1a
--- /dev/null
+++ b/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/MobSpawning.java
@@ -0,0 +1,76 @@
+package com.destroystokyo.paper.config.toml.modules.optimizations;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import java.util.Locale;
+
+public class MobSpawning implements IConfigModule {
+
+    public static final int PRECHECK_OFF = 0;
+    public static final int PRECHECK_DETERMINISTIC = 1;
+    public static final int PRECHECK_SINGLE_ROLL = 2;
+
+    @ConfigInfo(
+        baseName = "precheck-light-mode",
+        comments = "Pre-construction spawn rejection mode in SpawnerCreature before allocating 14.9 KiB EntityInsentient instances:\n"
+            + "  'single-roll'   - (default, 6.3x-11.6x faster, 6.1x less GC churn) deterministic biome/Y/magma/slime/animal checks plus single-roll EntityMonster.s_() light check for exact vanilla classes (1-shot flag prevents double RNG roll; custom plugin subclasses are skipped).\n"
+            + "  'deterministic' - deterministic-only rejection (effective light >= 8, magma, peaceful, slime chunk/Y, sky, squid, bat, animal) with zero RNG pre-rolls.\n"
+            + "  'off'           - disable pre-construction rejection (vanilla construct-then-check)."
+    )
+    public static String precheckLightMode = "single-roll";
+
+    public static int getPrecheckLightMode() {
+        String mode = precheckLightMode;
+        if (mode == "single-roll") {
+            return PRECHECK_SINGLE_ROLL;
+        }
+        if (mode == "deterministic") {
+            return PRECHECK_DETERMINISTIC;
+        }
+        if (mode == "off" || mode == null) {
+            return PRECHECK_OFF;
+        }
+        String normalized = mode.trim().toLowerCase(Locale.ROOT);
+        if ("single-roll".equals(normalized)) {
+            return PRECHECK_SINGLE_ROLL;
+        }
+        if ("deterministic".equals(normalized)) {
+            return PRECHECK_DETERMINISTIC;
+        }
+        return PRECHECK_OFF;
+    }
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.OPTIMIZATIONS;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "mob-spawning";
+    }
+
+    @Override
+    public void onLoaded(com.electronwill.nightconfig.core.file.CommentedFileConfig config) {
+        if (precheckLightMode == null) {
+            throw new IllegalArgumentException("optimizations.mob-spawning.precheck-light-mode must not be null");
+        }
+        String normalized = precheckLightMode.trim().toLowerCase(Locale.ROOT);
+        switch (normalized) {
+            case "off":
+                precheckLightMode = "off";
+                break;
+            case "deterministic":
+                precheckLightMode = "deterministic";
+                break;
+            case "single-roll":
+                precheckLightMode = "single-roll";
+                break;
+            default:
+                throw new IllegalArgumentException(
+                    "optimizations.mob-spawning.precheck-light-mode must be one of 'off', 'deterministic', or 'single-roll', got: " + precheckLightMode
+                );
+        }
+    }
+}
