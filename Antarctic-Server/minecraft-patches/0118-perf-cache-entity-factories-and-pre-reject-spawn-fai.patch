+    @Test
+    public void testPrecheckPerformanceAndAllocationSavings() throws Exception {
+        Chunk[] out = new Chunk[1];
+        // Lit island / daytime stone surface (mirrors SuperiorWorld's 90.9% daytime light rejection)
+        TestWorld world = buildWorld(EnumDifficulty.NORMAL, 0, 15, 10, Blocks.STONE.getBlockData(), Blocks.AIR.getBlockData(), 64, 64, out);
+        Chunk chunk = out[0];
+        BlockPosition.MutableBlockPosition pos = new BlockPosition.MutableBlockPosition(8, 64, 8);
+
+        com.sun.management.ThreadMXBean tmxb = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        // Warmup both paths
+        int sink = 0;
+        for (int i = 0; i < 400; ++i) {
+            EntityZombie z = new EntityZombie(world);
+            z.setPositionRotation(8.5, 64.0, 8.5, 0.0F, 0.0F);
+            if (z.P()) sink++;
+            if (SpawnerCreature.precheckSpawn(world, chunk, EntityZombie.class, pos, MobSpawning.PRECHECK_SINGLE_ROLL) != SpawnerCreature.PRECHECK_RESULT_REJECT) {
+                sink++;
+            }
+        }
+
+        int attempts = 2_000;
+        long alloc0 = tmxb.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < attempts; ++i) {
+            EntityInsentient e = (EntityInsentient) EntityZombie.class.getConstructor(new Class[] { World.class }).newInstance(new Object[] { world });
+            e.setPositionRotation(8.5, 64.0, 8.5, 0.0F, 0.0F);
+            if (e.P()) sink++;
+        }
+        long oldNs = System.nanoTime() - t0;
+        long oldBytes = tmxb.getThreadAllocatedBytes(tid) - alloc0;
+
+        long alloc1 = tmxb.getThreadAllocatedBytes(tid);
+        long t1 = System.nanoTime();
+        for (int i = 0; i < attempts; ++i) {
+            if (SpawnerCreature.precheckSpawn(world, chunk, EntityZombie.class, pos, MobSpawning.PRECHECK_SINGLE_ROLL) != SpawnerCreature.PRECHECK_RESULT_REJECT) {
+                EntityInsentient e = (EntityInsentient) EntityTypes.createEntity(EntityZombie.class, world);
+                e.setPositionRotation(8.5, 64.0, 8.5, 0.0F, 0.0F);
+                if (e.P()) sink++;
+            }
+        }
+        long newNs = System.nanoTime() - t1;
+        long newBytes = tmxb.getThreadAllocatedBytes(tid) - alloc1;
+
+        assertEquals(0, sink);
+        double speedup = (double) oldNs / Math.max(1L, newNs);
+        System.out.printf("SpawnerCreaturePrecheckTest (%d daytime rejects): old=%.2fms (%.1f KiB) new=%.3fms (%.1f KiB) speedup=%.1fx%n",
+                attempts, oldNs / 1e6, oldBytes / 1024.0, newNs / 1e6, newBytes / 1024.0, speedup);
+        assertTrue("Expected >= 10x speedup on rejected daytime spawns, got " + speedup + "x", speedup >= 10.0);
+        assertTrue("Expected >= 90% allocation reduction, old=" + oldBytes + " new=" + newBytes, newBytes * 10L < oldBytes);
+    }
