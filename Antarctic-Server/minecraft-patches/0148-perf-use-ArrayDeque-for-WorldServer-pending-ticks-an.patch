diff --git a/test/java/net/minecraft/server/WorldServerPendingTickPerfTest.java b/test/java/net/minecraft/server/WorldServerPendingTickPerfTest.java
new file mode 100644
index 0000000..5734a5b
--- /dev/null
+++ b/test/java/net/minecraft/server/WorldServerPendingTickPerfTest.java
@@ -0,0 +1,171 @@
+package net.minecraft.server;
+
+import com.sun.management.ThreadMXBean;
+import java.lang.management.ManagementFactory;
+import java.lang.reflect.Field;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import me.stella.antarctic.collection.ChunkIndexedTreeSet;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+public class WorldServerPendingTickPerfTest {
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    @SuppressWarnings("unchecked")
+    private static WorldServer newTickWorld() throws Exception {
+        WorldServer world = LightPropagationParityTest.buildWorld(1, new LightPropagationParityTest.StubProvider[1]);
+        world.worldData = new WorldData();
+        world.worldData.setTime(100L);
+        BlockPosition.MutableBlockPosition probePos = new BlockPosition.MutableBlockPosition();
+        LightPropagationParityTest.set(WorldServer.class, world, "antarcticTickProbePos", probePos);
+        LightPropagationParityTest.set(WorldServer.class, world, "antarcticTickProbe", NextTickListEntry.createProbe(probePos));
+        Field locatorField = WorldServer.class.getDeclaredField("NEXT_TICK_LOCATOR");
+        locatorField.setAccessible(true);
+        ChunkIndexedTreeSet.Locator<NextTickListEntry> locator = (ChunkIndexedTreeSet.Locator<NextTickListEntry>) locatorField.get(null);
+        LightPropagationParityTest.set(WorldServer.class, world, "nextTickList", new ChunkIndexedTreeSet<NextTickListEntry>(locator));
+        LightPropagationParityTest.set(WorldServer.class, world, "W", new ArrayDeque<NextTickListEntry>());
+        LightPropagationParityTest.set(WorldServer.class, world, "currentTickBatch", new me.stella.antarctic.collection.MultiplicitySet<NextTickListEntry>());
+        return world;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static ChunkIndexedTreeSet<NextTickListEntry> getNextTickList(WorldServer world) throws Exception {
+        Field f = WorldServer.class.getDeclaredField("nextTickList");
+        f.setAccessible(true);
+        return (ChunkIndexedTreeSet<NextTickListEntry>) f.get(world);
+    }
+
+    @Test
+    public void testProbeDeduplicationUnloadedGuardAndPollFirstOrder() throws Exception {
+        WorldServer world = newTickWorld();
+        ChunkIndexedTreeSet<NextTickListEntry> queue = getNextTickList(world);
+
+        // Unloaded chunk must not enqueue
+        BlockPosition unloaded = new BlockPosition(5000, 64, 5000);
+        world.a(unloaded, Blocks.SAND, 5, 0);
+        Assert.assertTrue("Unloaded position must not schedule tick", queue.isEmpty());
+
+        // Loaded chunk schedules normally and deduplicates equivalent Block families (REDSTONE_TORCH == UNLIT_REDSTONE_TORCH)
+        BlockPosition p1 = new BlockPosition(2, 64, 2);
+        BlockPosition p2 = new BlockPosition(3, 64, 2);
+        BlockPosition p3 = new BlockPosition(4, 64, 2);
+        world.a(p1, Blocks.REDSTONE_TORCH, 10, 0);
+        world.a(p1, Blocks.UNLIT_REDSTONE_TORCH, 2, -1); // equal family -> ignored
+        world.a(p2, Blocks.SAND, 5, -1);
+        world.a(p3, Blocks.SAND, 5, 0);
+        Assert.assertEquals(3, queue.size());
+
+        // pollFirst() must pop in exact compareTo order: (time=105, prio=-1), (time=105, prio=0), (time=110, prio=0)
+        NextTickListEntry e1 = queue.pollFirst();
+        NextTickListEntry e2 = queue.pollFirst();
+        NextTickListEntry e3 = queue.pollFirst();
+        Assert.assertEquals(p2, e1.a);
+        Assert.assertEquals(p3, e2.a);
+        Assert.assertEquals(p1, e3.a);
+        Assert.assertTrue(queue.isEmpty());
+
+        // b() also deduplicates without allocating duplicates
+        world.b(p1, Blocks.SAND, 3, 0);
+        world.b(p1, Blocks.SAND, 1, 0);
+        Assert.assertEquals(1, queue.size());
+
+        // collect() wide query exercises fastIterator over populated buckets
+        world.b(new BlockPosition(64, 64, 64), Blocks.SAND, 2, 0);
+        List<NextTickListEntry> collected = queue.collect(-1000, -1000, 1000, 1000, true);
+        Assert.assertNotNull(collected);
+        Assert.assertEquals(2, collected.size());
+        Assert.assertTrue(queue.isEmpty());
+    }
+
+    @Test
+    public void testZeroAllocationDuplicateScheduleAndArrayDequeStormSpeedup() throws Exception {
+        WorldServer world = newTickWorld();
+        BlockPosition pos = new BlockPosition(4, 64, 4);
+        BlockPosition unloaded = new BlockPosition(9999, 64, 9999);
+        world.a(pos, Blocks.REDSTONE_TORCH, 4, 0);
+
+        final int warmup = 10_000;
+        final int measured = 50_000;
+        for (int i = 0; i < warmup; ++i) {
+            world.a(pos, Blocks.REDSTONE_TORCH, 4, 0);
+            world.b(pos, Blocks.REDSTONE_TORCH, 4, 0);
+            world.a(unloaded, Blocks.REDSTONE_TORCH, 4, 0);
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        long a0 = bean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            world.a(pos, Blocks.REDSTONE_TORCH, 4, 0);
+            world.b(pos, Blocks.REDSTONE_TORCH, 4, 0);
+            world.a(unloaded, Blocks.REDSTONE_TORCH, 4, 0);
+        }
+        long dupNs = System.nanoTime() - t0;
+        long dupAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a0);
+
+        // Compare ArrayList head-shift drain (old W) vs ArrayDeque pollFirst drain (new W) on a 15,000-entry tick storm
+        final int batchSize = 15_000;
+        NextTickListEntry[] entries = new NextTickListEntry[batchSize];
+        for (int i = 0; i < batchSize; ++i) {
+            entries[i] = new NextTickListEntry(new BlockPosition(i & 15, 64, i >> 4), Blocks.SAND);
+        }
+
+        ArrayList<NextTickListEntry> listBatch = new ArrayList<NextTickListEntry>(batchSize);
+        ArrayDeque<NextTickListEntry> dequeBatch = new ArrayDeque<NextTickListEntry>(batchSize);
+
+        // Warmup small batches
+        for (int w = 0; w < 5; ++w) {
+            for (int i = 0; i < 500; ++i) {
+                listBatch.add(entries[i]);
+                dequeBatch.addLast(entries[i]);
+            }
+            Iterator<NextTickListEntry> it = listBatch.iterator();
+            while (it.hasNext()) {
+                it.next();
+                it.remove();
+            }
+            while (dequeBatch.pollFirst() != null) {
+            }
+        }
+
+        for (int i = 0; i < batchSize; ++i) {
+            listBatch.add(entries[i]);
+        }
+        long listStart = System.nanoTime();
+        long sink = 0;
+        Iterator<NextTickListEntry> it = listBatch.iterator();
+        while (it.hasNext()) {
+            sink += it.next().a.getX();
+            it.remove();
+        }
+        long listNs = System.nanoTime() - listStart;
+
+        for (int i = 0; i < batchSize; ++i) {
+            dequeBatch.addLast(entries[i]);
+        }
+        long dequeStart = System.nanoTime();
+        NextTickListEntry polled;
+        while ((polled = dequeBatch.pollFirst()) != null) {
+            sink += polled.a.getX();
+        }
+        long dequeNs = System.nanoTime() - dequeStart;
+
+        System.out.printf(
+                "[perf] WorldServer dup/unloaded schedule (%d x 3 ops): %.2f ms (alloc=%d B) | tick batch drain (%d entries): ArrayList=%.2f ms vs ArrayDeque=%.2f ms (speedup=%.1fx, sink=%d)%n",
+                measured, dupNs / 1e6, dupAlloc, batchSize, listNs / 1e6, dequeNs / 1e6,
+                (double) listNs / Math.max(1L, dequeNs), sink);
+
+        Assert.assertEquals("Duplicate and unloaded schedule probes must allocate 0 bytes", 0L, dupAlloc);
+        Assert.assertTrue("ArrayDeque pollFirst must be vastly faster than ArrayList head removal",
+                dequeNs * 10L < listNs);
+    }
+}
