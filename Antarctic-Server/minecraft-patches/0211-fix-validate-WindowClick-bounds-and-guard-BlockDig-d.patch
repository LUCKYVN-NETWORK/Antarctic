+    @Test
+    public void testIllegalWindowClickStatesAreSoftRejectedAndUnlocked() throws Exception {
+        RecordingPlayerConnection conn = createConnection();
+        int size = conn.player.activeContainer.slots.size();
+
+        // Out-of-bounds upper slot
+        conn.a(windowClick(0, size, 0, (short) 10, InventoryClickType.PICKUP));
+        assertRejectedAndUnlockedCleanly(conn, (short) 10);
+        conn.sentPackets.clear();
+
+        // Illegal negative slot (-2)
+        conn.a(windowClick(0, -2, 0, (short) 11, InventoryClickType.PICKUP));
+        assertRejectedAndUnlockedCleanly(conn, (short) 11);
+        conn.sentPackets.clear();
+
+        // SWAP with negative slot or out-of-range hotbar button
+        conn.a(windowClick(0, -1, 0, (short) 12, InventoryClickType.SWAP));
+        assertRejectedAndUnlockedCleanly(conn, (short) 12);
+        conn.sentPackets.clear();
+
+        conn.a(windowClick(0, 9, 9, (short) 13, InventoryClickType.SWAP));
+        assertRejectedAndUnlockedCleanly(conn, (short) 13);
+        conn.sentPackets.clear();
+
+        conn.a(windowClick(0, 9, -1, (short) 14, InventoryClickType.SWAP));
+        assertRejectedAndUnlockedCleanly(conn, (short) 14);
+        conn.sentPackets.clear();
+
+        // QUICK_CRAFT phase 1 with negative slot (-1 and -999)
+        conn.a(windowClick(0, -1, 1, (short) 15, InventoryClickType.QUICK_CRAFT));
+        assertRejectedAndUnlockedCleanly(conn, (short) 15);
+        conn.sentPackets.clear();
+
+        conn.a(windowClick(0, -999, 1, (short) 16, InventoryClickType.QUICK_CRAFT));
+        assertRejectedAndUnlockedCleanly(conn, (short) 16);
+        conn.sentPackets.clear();
+
+        // Dead player click: resync transaction(false) without disconnect or NPE
+        conn.player.dead = true;
+        conn.a(windowClick(0, 9, 0, (short) 17, InventoryClickType.PICKUP));
+        assertFalse(conn.disconnected);
+        assertFalse(conn.sentPackets.isEmpty());
+    }
