+    private static void assertRejectedAndUnlockedCleanly(RecordingPlayerConnection conn, short actionId) throws Exception {
+        assertFalse("Soft-rejected packet must not disconnect player", conn.disconnected);
+        boolean foundRejectTxn = false;
+        for (Packet<?> p : conn.sentPackets) {
+            if (p instanceof PacketPlayOutTransaction) {
+                Field bField = PacketPlayOutTransaction.class.getDeclaredField("b");
+                Field cField = PacketPlayOutTransaction.class.getDeclaredField("c");
+                bField.setAccessible(true);
+                cField.setAccessible(true);
+                if (bField.getShort(p) == actionId && !cField.getBoolean(p)) {
+                    foundRejectTxn = true;
+                }
+            }
+        }
+        assertTrue("Must send PacketPlayOutTransaction(accepted=false) for actionId " + actionId, foundRejectTxn);
+        assertFalse("Container must be locked before client ack", conn.player.activeContainer.c(conn.player));
+
+        PacketPlayInTransaction ack = new PacketPlayInTransaction();
+        Field ta = PacketPlayInTransaction.class.getDeclaredField("a");
+        Field tb = PacketPlayInTransaction.class.getDeclaredField("b");
+        Field tc = PacketPlayInTransaction.class.getDeclaredField("c");
+        ta.setAccessible(true);
+        tb.setAccessible(true);
+        tc.setAccessible(true);
+        ta.setInt(ack, conn.player.activeContainer.windowId);
+        tb.setShort(ack, actionId);
+        tc.setBoolean(ack, false);
+        conn.a(ack);
+        assertTrue("Client PacketPlayInTransaction ack must unlock container", conn.player.activeContainer.c(conn.player));
+    }
