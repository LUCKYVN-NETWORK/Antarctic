+        conn.player.inventory.setCarried(new ItemStack(Items.GOLD_INGOT, 1));
+        conn.a(blockDig(PacketPlayInBlockDig.EnumPlayerDigType.DROP_ITEM));
+        conn.a(blockDig(PacketPlayInBlockDig.EnumPlayerDigType.DROP_ALL_ITEMS));
+        conn.a(blockDig(PacketPlayInBlockDig.EnumPlayerDigType.SWAP_HELD_ITEMS));
+        assertFalse(conn.disconnected);
+        assertEquals(10, conn.player.inventory.getItem(0).getCount());
+        assertFalse(conn.sentPackets.isEmpty());
+        conn.sentPackets.clear();
+
+        // 3. Dead player -> soft-cancelled without resync spam or kick
+        conn.player.inventory.setCarried(ItemStack.a);
+        conn.player.dead = true;
+        conn.a(blockDig(PacketPlayInBlockDig.EnumPlayerDigType.DROP_ALL_ITEMS));
+        assertFalse(conn.disconnected);
+        assertEquals(10, conn.player.inventory.getItem(0).getCount());
+        conn.player.dead = false;
+
+        // 4. DROP_ALL_ITEMS >= 20/tick soft-throttled without kick
+        Field ldtField = PlayerConnection.class.getDeclaredField("lastDropTick");
+        Field dcField = PlayerConnection.class.getDeclaredField("dropCount");
+        ldtField.setAccessible(true);
+        dcField.setAccessible(true);
+        ldtField.setInt(conn, MinecraftServer.currentTick);
+        dcField.setInt(conn, 20);
+        conn.a(blockDig(PacketPlayInBlockDig.EnumPlayerDigType.DROP_ALL_ITEMS));
+        assertFalse("DROP_ALL_ITEMS rate-limit must soft-cancel without kicking", conn.disconnected);
+        assertEquals(10, conn.player.inventory.getItem(0).getCount());
+        assertFalse(conn.sentPackets.isEmpty());
+    }
+
+    @Test
+    public void testValidWindowClickBoundsCheckEfficiency() throws Exception {
+        RecordingPlayerConnection conn = createConnection();
+        ContainerPlayer container = (ContainerPlayer) conn.player.activeContainer;
+        int slotCount = container.slots.size();
+
+        int accepted = 0;
+        long start = System.nanoTime();
+        for (int i = 0; i < 50_000; i++) {
+            int rawSlot = i % slotCount;
+            int button = 0;
+            InventoryClickType clickType = InventoryClickType.PICKUP;
+            boolean reject = clickType == null
+                    || rawSlot >= slotCount
+                    || (rawSlot < 0 && rawSlot != -999 && rawSlot != -1)
+                    || (clickType == InventoryClickType.SWAP && (rawSlot < 0 || button < 0 || button >= 9))
+                    || (clickType == InventoryClickType.QUICK_CRAFT && Container.c(button) == 1 && rawSlot < 0);
+            if (!reject) {
+                accepted++;
+            }
+        }
+        long elapsedMs = (System.nanoTime() - start) / 1_000_000L;
+        assertEquals(50_000, accepted);
+        assertTrue("50k bounds checks took too long: " + elapsedMs + " ms", elapsedMs < 20L);
+    }
