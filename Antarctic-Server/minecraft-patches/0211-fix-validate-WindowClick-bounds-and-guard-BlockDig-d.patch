+        assertEquals(ItemStack.a, container.a(999, 0, InventoryClickType.SWAP, conn.player));
+        assertEquals(ItemStack.a, container.a(999, 0, InventoryClickType.PICKUP, conn.player));
+        assertEquals(ItemStack.a, container.a(999, 0, InventoryClickType.QUICK_MOVE, conn.player));
