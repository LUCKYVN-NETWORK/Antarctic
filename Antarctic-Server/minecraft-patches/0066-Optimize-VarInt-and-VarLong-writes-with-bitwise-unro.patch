From: StellarSeal <emnoigi1452@gmail.com>
Date: Sun, 18 Oct 2026 12:11:30 +0700
Subject: [PATCH 066/127] Optimize VarInt and VarLong writes with bitwise
 unrolling

- Backport Leaf MC 0080 (Velocity-style unrolled bitwise VarInt/VarLong writes) to PacketDataSerializer
- Replace the per-byte writeVarInt loop with single writeByte/writeShort/writeMedium/writeInt paths
- Replace the per-byte writeVarLong loop with unrolled writeLong paths covering all ten encoding lengths
- Byte-exact parity with the vanilla loop verified by boundary, exhaustive, and randomized tests

diff --git a/main/java/net/minecraft/server/PacketDataSerializer.java b/main/java/net/minecraft/server/PacketDataSerializer.java
index d71734d..218ef2c 100644
--- a/main/java/net/minecraft/server/PacketDataSerializer.java
+++ b/main/java/net/minecraft/server/PacketDataSerializer.java
@@ -185,25 +185,64 @@ public class PacketDataSerializer extends ByteBuf {
     }
 
     public PacketDataSerializer d(int i) {
-        while ((i & -128) != 0) {
-            this.writeByte(i & 127 | 128);
-            i >>>= 7;
+        // Leaf - Optimize VarInt write (backport of Leaf MC 0080, Velocity-style unrolled bitwise encoding)
+        if ((i & (0xFFFFFFFF << 7)) == 0) {
+            this.writeByte(i);
+        } else if ((i & (0xFFFFFFFF << 14)) == 0) {
+            int j = (i & 0x7F | 0x80) << 8 | (i >>> 7);
+
+            this.writeShort(j);
+        } else if ((i & (0xFFFFFFFF << 21)) == 0) {
+            int j = (i & 0x7F | 0x80) << 16 | ((i >>> 7) & 0x7F | 0x80) << 8 | (i >>> 14);
+
+            this.writeMedium(j);
+        } else if ((i & (0xFFFFFFFF << 28)) == 0) {
+            int j = (i & 0x7F | 0x80) << 24 | ((i >>> 7) & 0x7F | 0x80) << 16 | ((i >>> 14) & 0x7F | 0x80) << 8 | (i >>> 21);
+
+            this.writeInt(j);
+        } else {
+            int j = (i & 0x7F | 0x80) << 24 | ((i >>> 7) & 0x7F | 0x80) << 16 | ((i >>> 14) & 0x7F | 0x80) << 8 | ((i >>> 21) & 0x7F | 0x80);
+
+            this.writeInt(j);
+            this.writeByte(i >>> 28);
         }
 
-        this.writeByte(i);
         return this;
     }
 
     public PacketDataSerializer b(long i) {
-        while ((i & -128L) != 0L) {
-            this.writeByte((int) (i & 127L) | 128);
-            i >>>= 7;
+        // Leaf - Optimize VarLong write (backport of Leaf MC 0080, Velocity-style unrolled bitwise encoding)
+        if ((i & (0xFFFFFFFFFFFFFFFFL << 7)) == 0L) {
+            this.writeByte((int) i);
+        } else if ((i & (0xFFFFFFFFFFFFFFFFL << 14)) == 0L) {
+            this.writeShort((int) ((i & 0x7FL | 0x80L) << 8 | i >>> 7));
+        } else if ((i & (0xFFFFFFFFFFFFFFFFL << 21)) == 0L) {
+            this.writeMedium((int) ((i & 0x7FL | 0x80L) << 16 | (i >>> 7 & 0x7FL | 0x80L) << 8 | i >>> 14));
+        } else if ((i & (0xFFFFFFFFFFFFFFFFL << 28)) == 0L) {
+            this.writeInt((int) ((i & 0x7FL | 0x80L) << 24 | (i >>> 7 & 0x7FL | 0x80L) << 16 | (i >>> 14 & 0x7FL | 0x80L) << 8 | i >>> 21));
+        } else if ((i & (0xFFFFFFFFFFFFFFFFL << 35)) == 0L) {
+            this.writeInt((int) ((i & 0x7FL | 0x80L) << 24 | (i >>> 7 & 0x7FL | 0x80L) << 16 | (i >>> 14 & 0x7FL | 0x80L) << 8 | (i >>> 21 & 0x7FL | 0x80L)));
+            this.writeByte((int) (i >>> 28));
+        } else if ((i & (0xFFFFFFFFFFFFFFFFL << 42)) == 0L) {
+            this.writeInt((int) ((i & 0x7FL | 0x80L) << 24 | (i >>> 7 & 0x7FL | 0x80L) << 16 | (i >>> 14 & 0x7FL | 0x80L) << 8 | (i >>> 21 & 0x7FL | 0x80L)));
+            this.writeShort((int) ((i >>> 28 & 0x7FL | 0x80L) << 8 | i >>> 35));
+        } else if ((i & (0xFFFFFFFFFFFFFFFFL << 49)) == 0L) {
+            this.writeInt((int) ((i & 0x7FL | 0x80L) << 24 | (i >>> 7 & 0x7FL | 0x80L) << 16 | (i >>> 14 & 0x7FL | 0x80L) << 8 | (i >>> 21 & 0x7FL | 0x80L)));
+            this.writeMedium((int) ((i >>> 28 & 0x7FL | 0x80L) << 16 | (i >>> 35 & 0x7FL | 0x80L) << 8 | i >>> 42));
+        } else if ((i & (0xFFFFFFFFFFFFFFFFL << 56)) == 0L) {
+            this.writeLong((i & 0x7FL | 0x80L) << 56 | (i >>> 7 & 0x7FL | 0x80L) << 48 | (i >>> 14 & 0x7FL | 0x80L) << 40 | (i >>> 21 & 0x7FL | 0x80L) << 32 | (i >>> 28 & 0x7FL | 0x80L) << 24 | (i >>> 35 & 0x7FL | 0x80L) << 16 | (i >>> 42 & 0x7FL | 0x80L) << 8 | i >>> 49);
+        } else if ((i & (0xFFFFFFFFFFFFFFFFL << 63)) == 0L) {
+            this.writeLong((i & 0x7FL | 0x80L) << 56 | (i >>> 7 & 0x7FL | 0x80L) << 48 | (i >>> 14 & 0x7FL | 0x80L) << 40 | (i >>> 21 & 0x7FL | 0x80L) << 32 | (i >>> 28 & 0x7FL | 0x80L) << 24 | (i >>> 35 & 0x7FL | 0x80L) << 16 | (i >>> 42 & 0x7FL | 0x80L) << 8 | (i >>> 49 & 0x7FL | 0x80L));
+            this.writeByte((int) (i >>> 56));
+        } else {
+            this.writeLong((i & 0x7FL | 0x80L) << 56 | (i >>> 7 & 0x7FL | 0x80L) << 48 | (i >>> 14 & 0x7FL | 0x80L) << 40 | (i >>> 21 & 0x7FL | 0x80L) << 32 | (i >>> 28 & 0x7FL | 0x80L) << 24 | (i >>> 35 & 0x7FL | 0x80L) << 16 | (i >>> 42 & 0x7FL | 0x80L) << 8 | (i >>> 49 & 0x7FL | 0x80L));
+            this.writeShort((int) ((i >>> 56 & 0x7FL | 0x80L) << 8 | i >>> 63));
         }
 
-        this.writeByte((int) i);
         return this;
     }
 
+
