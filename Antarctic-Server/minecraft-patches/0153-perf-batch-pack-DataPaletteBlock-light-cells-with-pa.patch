diff --git a/main/java/net/minecraft/server/DataPaletteBlock.java b/main/java/net/minecraft/server/DataPaletteBlock.java
index b0ce100..e551808 100644
--- a/main/java/net/minecraft/server/DataPaletteBlock.java
+++ b/main/java/net/minecraft/server/DataPaletteBlock.java
@@ -109,6 +109,70 @@ public class DataPaletteBlock implements DataPaletteExpandable {
 
     // Antarctic start - fast section cell packer for LightEngine snapshots (main thread)
     public void packLightCells(byte[] out) {
+        final int bits = this.e;
+        if (bits <= 8) {
+            final int paletteCap = 1 << bits;
+            final byte[] lut = new byte[paletteCap];
+            final DataPalette palette = this.c;
+            for (int p = 0; p < paletteCap; ++p) {
+                IBlockData data = palette.a(p);
+                if (data != null && data != DataPaletteBlock.a) {
+                    int opacity = data.c();
+                    int emission = data.d();
+                    if ((opacity | emission) != 0) {
+                        lut[p] = me.stella.antarctic.light.LightRules.pack(opacity, emission);
+                    }
+                }
+            }
+            final long[] words = this.b.a();
+            if (bits == 4) {
+                final byte zeroCell = lut[0];
+                for (int w = 0, idx = 0; w < 256; ++w, idx += 16) {
+                    long word = words[w];
+                    if (word == 0L) {
+                        if (zeroCell != 0) {
+                            java.util.Arrays.fill(out, idx, idx + 16, zeroCell);
+                        }
+                        continue;
+                    }
+                    out[idx]      = lut[(int) (word & 15L)];
+                    out[idx + 1]  = lut[(int) ((word >>> 4) & 15L)];
+                    out[idx + 2]  = lut[(int) ((word >>> 8) & 15L)];
+                    out[idx + 3]  = lut[(int) ((word >>> 12) & 15L)];
+                    out[idx + 4]  = lut[(int) ((word >>> 16) & 15L)];
+                    out[idx + 5]  = lut[(int) ((word >>> 20) & 15L)];
+                    out[idx + 6]  = lut[(int) ((word >>> 24) & 15L)];
+                    out[idx + 7]  = lut[(int) ((word >>> 28) & 15L)];
+                    out[idx + 8]  = lut[(int) ((word >>> 32) & 15L)];
+                    out[idx + 9]  = lut[(int) ((word >>> 36) & 15L)];
+                    out[idx + 10] = lut[(int) ((word >>> 40) & 15L)];
+                    out[idx + 11] = lut[(int) ((word >>> 44) & 15L)];
+                    out[idx + 12] = lut[(int) ((word >>> 48) & 15L)];
+                    out[idx + 13] = lut[(int) ((word >>> 52) & 15L)];
+                    out[idx + 14] = lut[(int) ((word >>> 56) & 15L)];
+                    out[idx + 15] = lut[(int) (word >>> 60)];
+                }
+                return;
+            }
+            final long mask = (1L << bits) - 1L;
+            int bitIndex = 0;
+            for (int i = 0; i < 4096; ++i) {
+                int wordIdx = bitIndex >>> 6;
+                int bitOffset = bitIndex & 63;
+                bitIndex += bits;
+                int paletteIdx;
+                if (bitOffset + bits <= 64) {
+                    paletteIdx = (int) ((words[wordIdx] >>> bitOffset) & mask);
+                } else {
+                    paletteIdx = (int) (((words[wordIdx] >>> bitOffset) | (words[wordIdx + 1] << (64 - bitOffset))) & mask);
+                }
+                byte packed = lut[paletteIdx];
+                if (packed != 0) {
+                    out[i] = packed;
+                }
+            }
+            return;
+        }
