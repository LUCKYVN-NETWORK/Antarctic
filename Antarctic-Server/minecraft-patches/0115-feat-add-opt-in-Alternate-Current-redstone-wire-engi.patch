+    @Test
+    public void lineAndDualSourceParityMatchesVanillaExactly() throws Exception {
+        Redstone.implementation = "alternate-current";
+        TrackingRedstoneWorld w = buildTrackingWorld(901L);
+
+        // Build 18-block stone base with wires at x=1..17
+        for (int x = 0; x <= 18; ++x) {
+            LightPropagationParityTest.setBlock(w, x, 39, 0, Blocks.STONE.getBlockData());
+        }
+        for (int x = 1; x <= 17; ++x) {
+            LightPropagationParityTest.setBlock(w, x, 40, 0, Blocks.REDSTONE_WIRE.getBlockData());
+        }
+        // Power at x=0 (redstone block)
+        LightPropagationParityTest.setBlock(w, 0, 40, 0, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(w.getType(new BlockPosition(1, 40, 0)), w, new BlockPosition(1, 40, 0), Blocks.REDSTONE_BLOCK, new BlockPosition(0, 40, 0));
+
+        for (int x = 1; x <= 15; ++x) {
+            assertEquals("wire at x=" + x, 16 - x, powerAt(w, x, 40, 0));
+        }
+        assertEquals(0, powerAt(w, 16, 40, 0));
+        assertEquals(0, powerAt(w, 17, 40, 0));
+
+        // Add second source at x=10 (side redstone block at (10,40,1))
+        LightPropagationParityTest.setBlock(w, 10, 40, 1, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(w.getType(new BlockPosition(10, 40, 0)), w, new BlockPosition(10, 40, 0), Blocks.REDSTONE_BLOCK, new BlockPosition(10, 40, 1));
+        assertEquals(15, powerAt(w, 10, 40, 0));
+        assertEquals(14, powerAt(w, 9, 40, 0));
+        assertEquals(15, powerAt(w, 1, 40, 0));
+
+        // Remove first source at x=0 -> line must settle cleanly to power from x=10 only!
+        LightPropagationParityTest.setBlock(w, 0, 40, 0, Blocks.AIR.getBlockData());
+        Blocks.REDSTONE_WIRE.a(w.getType(new BlockPosition(1, 40, 0)), w, new BlockPosition(1, 40, 0), Blocks.AIR, new BlockPosition(0, 40, 0));
+        for (int x = 1; x <= 17; ++x) {
+            int expected = Math.max(0, 15 - Math.abs(x - 10));
+            assertEquals("dual-source fallback at x=" + x, expected, powerAt(w, x, 40, 0));
+        }
+    }
