+    @Test
+    public void preservesGlowstoneOneWayUpwardDiodeAndStoneBidirectionalStaircaseAndCutRule() throws Exception {
+        Redstone.implementation = "alternate-current";
+
+        // 1) Glowstone one-way upward diode: UP allowed, DOWN blocked
+        TrackingRedstoneWorld wGlow = buildTrackingWorld(902L);
+        LightPropagationParityTest.setBlock(wGlow, 2, 39, 2, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(wGlow, 3, 40, 2, Blocks.GLOWSTONE.getBlockData());
+        LightPropagationParityTest.setBlock(wGlow, 2, 40, 2, Blocks.REDSTONE_WIRE.getBlockData()); // lower wire
+        LightPropagationParityTest.setBlock(wGlow, 3, 41, 2, Blocks.REDSTONE_WIRE.getBlockData()); // upper wire on glowstone
+
+        // Power lower wire -> MUST propagate UP onto glowstone
+        LightPropagationParityTest.setBlock(wGlow, 1, 40, 2, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wGlow.getType(new BlockPosition(2, 40, 2)), wGlow, new BlockPosition(2, 40, 2), Blocks.REDSTONE_BLOCK, new BlockPosition(1, 40, 2));
+        assertEquals(15, powerAt(wGlow, 2, 40, 2));
+        assertEquals("signal must climb UP onto glowstone", 14, powerAt(wGlow, 3, 41, 2));
+
+        // Remove lower source -> both must drop to 0
+        LightPropagationParityTest.setBlock(wGlow, 1, 40, 2, Blocks.AIR.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wGlow.getType(new BlockPosition(2, 40, 2)), wGlow, new BlockPosition(2, 40, 2), Blocks.AIR, new BlockPosition(1, 40, 2));
+        assertEquals(0, powerAt(wGlow, 2, 40, 2));
+        assertEquals(0, powerAt(wGlow, 3, 41, 2));
+
+        // Power upper wire on glowstone -> MUST NOT propagate DOWN off glowstone!
+        LightPropagationParityTest.setBlock(wGlow, 4, 41, 2, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wGlow.getType(new BlockPosition(3, 41, 2)), wGlow, new BlockPosition(3, 41, 2), Blocks.REDSTONE_BLOCK, new BlockPosition(4, 41, 2));
+        assertEquals(15, powerAt(wGlow, 3, 41, 2));
+        assertEquals("glowstone diode MUST block downward propagation", 0, powerAt(wGlow, 2, 40, 2));
+
+        // 2) Solid stone staircase: bidirectional UP & DOWN, cut by solid stone above lower wire
+        TrackingRedstoneWorld wStone = buildTrackingWorld(903L);
+        LightPropagationParityTest.setBlock(wStone, 2, 39, 2, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(wStone, 3, 40, 2, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(wStone, 2, 40, 2, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(wStone, 3, 41, 2, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(wStone, 4, 41, 2, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wStone.getType(new BlockPosition(3, 41, 2)), wStone, new BlockPosition(3, 41, 2), Blocks.REDSTONE_BLOCK, new BlockPosition(4, 41, 2));
+        assertEquals("solid stone staircase MUST propagate DOWN", 14, powerAt(wStone, 2, 40, 2));
+
+        // Place solid stone directly above lower wire at (2, 41, 2) -> cuts connection!
+        LightPropagationParityTest.setBlock(wStone, 2, 41, 2, Blocks.STONE.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wStone.getType(new BlockPosition(2, 40, 2)), wStone, new BlockPosition(2, 40, 2), Blocks.STONE, new BlockPosition(2, 41, 2));
+        assertEquals("solid block above lower wire must cut vertical connection", 0, powerAt(wStone, 2, 40, 2));
+    }
