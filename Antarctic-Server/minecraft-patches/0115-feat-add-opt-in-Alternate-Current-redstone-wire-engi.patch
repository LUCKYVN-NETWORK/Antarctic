+    @Test
+    public void lagCarpetDepoweringBenchmarkBeatsVanillaByOrderOfMagnitude() throws Exception {
+        // 15x15 redstone dust carpet (MC-81098 worst case: depowering a 2D carpet from center)
+        TrackingRedstoneWorld wVanilla = buildTrackingWorld(910L);
+        TrackingRedstoneWorld wAc = buildTrackingWorld(911L);
+        wVanilla.notifiedPositions = null;
+        wAc.notifiedPositions = null;
+
+        for (int x = 0; x < 15; ++x) {
+            for (int z = 0; z < 15; ++z) {
+                LightPropagationParityTest.setBlock(wVanilla, x, 39, z, Blocks.STONE.getBlockData());
+                LightPropagationParityTest.setBlock(wVanilla, x, 40, z, Blocks.REDSTONE_WIRE.getBlockData());
+                LightPropagationParityTest.setBlock(wAc, x, 39, z, Blocks.STONE.getBlockData());
+                LightPropagationParityTest.setBlock(wAc, x, 40, z, Blocks.REDSTONE_WIRE.getBlockData());
+            }
+        }
+
+        BlockPosition sourcePos = new BlockPosition(7, 41, 7);
+        BlockPosition centerWire = new BlockPosition(7, 40, 7);
+
+        // Warmup + parity check on 15x15 carpet ON and OFF
+        Redstone.implementation = "vanilla";
+        LightPropagationParityTest.setBlock(wVanilla, 7, 41, 7, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wVanilla.getType(centerWire), wVanilla, centerWire, Blocks.REDSTONE_BLOCK, sourcePos);
+
+        Redstone.implementation = "alternate-current";
+        LightPropagationParityTest.setBlock(wAc, 7, 41, 7, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wAc.getType(centerWire), wAc, centerWire, Blocks.REDSTONE_BLOCK, sourcePos);
+
+        // Verify 100% power parity across all 225 wires when powered ON!
+        for (int x = 0; x < 15; ++x) {
+            for (int z = 0; z < 15; ++z) {
+                assertEquals("ON parity mismatch at (" + x + "," + z + ")", powerAt(wVanilla, x, 40, z), powerAt(wAc, x, 40, z));
+            }
+        }
+
+        // Measure MC-81098 depowering (10 cycles after 5 warmup cycles)
+        for (int i = 0; i < 5; ++i) {
+            Redstone.implementation = "vanilla";
+            LightPropagationParityTest.setBlock(wVanilla, 7, 41, 7, Blocks.AIR.getBlockData());
+            Blocks.REDSTONE_WIRE.a(wVanilla.getType(centerWire), wVanilla, centerWire, Blocks.AIR, sourcePos);
+            LightPropagationParityTest.setBlock(wVanilla, 7, 41, 7, Blocks.REDSTONE_BLOCK.getBlockData());
+            Blocks.REDSTONE_WIRE.a(wVanilla.getType(centerWire), wVanilla, centerWire, Blocks.REDSTONE_BLOCK, sourcePos);
+
+            Redstone.implementation = "alternate-current";
+            LightPropagationParityTest.setBlock(wAc, 7, 41, 7, Blocks.AIR.getBlockData());
+            Blocks.REDSTONE_WIRE.a(wAc.getType(centerWire), wAc, centerWire, Blocks.AIR, sourcePos);
+            LightPropagationParityTest.setBlock(wAc, 7, 41, 7, Blocks.REDSTONE_BLOCK.getBlockData());
+            Blocks.REDSTONE_WIRE.a(wAc.getType(centerWire), wAc, centerWire, Blocks.REDSTONE_BLOCK, sourcePos);
+        }
+
+        wVanilla.setTypeCount.set(0);
+        wVanilla.neighborNotifyCount.set(0);
+        wAc.setTypeCount.set(0);
+        wAc.neighborNotifyCount.set(0);
+
+        final int cycles = 10;
+        long vanillaNs = 0L;
+        long acNs = 0L;
+        for (int i = 0; i < cycles; ++i) {
+            Redstone.implementation = "vanilla";
+            LightPropagationParityTest.setBlock(wVanilla, 7, 41, 7, Blocks.AIR.getBlockData());
+            long t0 = System.nanoTime();
+            Blocks.REDSTONE_WIRE.a(wVanilla.getType(centerWire), wVanilla, centerWire, Blocks.AIR, sourcePos);
+            vanillaNs += System.nanoTime() - t0;
+            LightPropagationParityTest.setBlock(wVanilla, 7, 41, 7, Blocks.REDSTONE_BLOCK.getBlockData());
+            Blocks.REDSTONE_WIRE.a(wVanilla.getType(centerWire), wVanilla, centerWire, Blocks.REDSTONE_BLOCK, sourcePos);
+
+            Redstone.implementation = "alternate-current";
+            LightPropagationParityTest.setBlock(wAc, 7, 41, 7, Blocks.AIR.getBlockData());
+            long t1 = System.nanoTime();
+            Blocks.REDSTONE_WIRE.a(wAc.getType(centerWire), wAc, centerWire, Blocks.AIR, sourcePos);
+            acNs += System.nanoTime() - t1;
+            LightPropagationParityTest.setBlock(wAc, 7, 41, 7, Blocks.REDSTONE_BLOCK.getBlockData());
+            Blocks.REDSTONE_WIRE.a(wAc.getType(centerWire), wAc, centerWire, Blocks.REDSTONE_BLOCK, sourcePos);
+        }
+
+        // Verify OFF parity after final depower
+        Redstone.implementation = "vanilla";
+        LightPropagationParityTest.setBlock(wVanilla, 7, 41, 7, Blocks.AIR.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wVanilla.getType(centerWire), wVanilla, centerWire, Blocks.AIR, sourcePos);
+        Redstone.implementation = "alternate-current";
+        LightPropagationParityTest.setBlock(wAc, 7, 41, 7, Blocks.AIR.getBlockData());
+        Blocks.REDSTONE_WIRE.a(wAc.getType(centerWire), wAc, centerWire, Blocks.AIR, sourcePos);
+        for (int x = 0; x < 15; ++x) {
+            for (int z = 0; z < 15; ++z) {
+                assertEquals("OFF parity mismatch at (" + x + "," + z + ")", 0, powerAt(wAc, x, 40, z));
+            }
+        }
+
+        double speedup = (double) vanillaNs / (double) Math.max(1L, acNs);
+        System.out.printf("[perf] AlternateCurrent 15x15 lag-carpet depower (%d cycles): vanilla=%.2f ms (setType=%d, notifies=%d) vs AC=%.2f ms (setType=%d, notifies=%d), speedup=%.1fx%n",
+            cycles, vanillaNs / 1e6, wVanilla.setTypeCount.get(), wVanilla.neighborNotifyCount.get(),
+            acNs / 1e6, wAc.setTypeCount.get(), wAc.neighborNotifyCount.get(), speedup);
+
+        assertTrue("AC must emit >= 10x fewer neighbor notifications on lag carpet",
+            wAc.neighborNotifyCount.get() * 10L < wVanilla.neighborNotifyCount.get());
+        assertTrue("AC must do >= 3x fewer setTypeAndData writes on lag carpet",
+            wAc.setTypeCount.get() * 3L < wVanilla.setTypeCount.get());
+        assertTrue("AC must be >= 5x faster than vanilla on 15x15 lag carpet depower (speedup=" + speedup + "x)",
+            acNs * 5L < vanillaNs);
+    }
+}
