+        Files.write(invalid.toPath(), "[optimizations.redstone]\nimplementation = \"invalid-engine\"\n".getBytes(StandardCharsets.UTF_8));
+        try {
+            AntarcticTomlConfig.load(invalid);
+            fail("invalid redstone implementation must be rejected");
+        } catch (IOException expected) {
+            assertNotNull(expected.getCause());
+        }
+        assertEquals("alternate-current", Redstone.implementation);
+    }
