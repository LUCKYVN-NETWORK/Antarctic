+    @Test
+    public void notifiesManhattanTwoQuasiConnectivityNeighborsAndRecoversFromExceptions() throws Exception {
+        Redstone.implementation = "alternate-current";
+        TrackingRedstoneWorld w = buildTrackingWorld(904L);
+
+        LightPropagationParityTest.setBlock(w, 5, 39, 5, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(w, 5, 38, 5, Blocks.PISTON.getBlockData()); // Manhattan-2 below wire (QC!)
+        LightPropagationParityTest.setBlock(w, 5, 40, 5, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(w, 4, 40, 5, Blocks.REDSTONE_BLOCK.getBlockData());
+
+        // Trigger exception during neighbor notification; handler state must remain completely uncorrupted!
+        w.throwOnNeighbor.set(true);
+        try {
+            Blocks.REDSTONE_WIRE.a(w.getType(new BlockPosition(5, 40, 5)), w, new BlockPosition(5, 40, 5), Blocks.REDSTONE_BLOCK, new BlockPosition(4, 40, 5));
+            fail("expected neighbor exception");
+        } catch (RuntimeException expected) {
+            assertEquals("simulated neighbor failure", expected.getMessage());
+        }
+
+        // Recover: reset wire and verify QC piston at (5, 38, 5) receives notification!
+        w.throwOnNeighbor.set(false);
+        w.notifiedPositions.clear();
+        LightPropagationParityTest.setBlock(w, 5, 40, 5, Blocks.REDSTONE_WIRE.getBlockData());
+        Blocks.REDSTONE_WIRE.a(w.getType(new BlockPosition(5, 40, 5)), w, new BlockPosition(5, 40, 5), Blocks.REDSTONE_BLOCK, new BlockPosition(4, 40, 5));
+
+        assertEquals(15, powerAt(w, 5, 40, 5));
+        assertTrue("piston 2 blocks below wire must be notified for 1.12.2 QC",
+            w.notifiedPositions.contains(new BlockPosition(5, 38, 5)));
+
+        // Per-world isolation check
+        TrackingRedstoneWorld w2 = buildTrackingWorld(905L);
+        LightPropagationParityTest.setBlock(w2, 5, 39, 5, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(w2, 5, 40, 5, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(w2, 4, 40, 5, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(w2.getType(new BlockPosition(5, 40, 5)), w2, new BlockPosition(5, 40, 5), Blocks.REDSTONE_BLOCK, new BlockPosition(4, 40, 5));
+        assertNotSame(w.alternateCurrentWireHandler, w2.alternateCurrentWireHandler);
+    }
