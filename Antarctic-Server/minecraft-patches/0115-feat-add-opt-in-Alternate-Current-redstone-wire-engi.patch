+    @Test
+    public void respectsBlockRedstoneEventListenerOverride() throws Exception {
+        Redstone.implementation = "alternate-current";
+        TrackingRedstoneWorld w = buildTrackingWorld(906L);
+        AtomicInteger calls = new AtomicInteger();
+        Plugin dummyPlugin = (Plugin) java.lang.reflect.Proxy.newProxyInstance(
+            Plugin.class.getClassLoader(),
+            new Class<?>[]{Plugin.class},
+            (proxy, method, args) -> "isEnabled".equals(method.getName()) ? true : ("getName".equals(method.getName()) ? "ACTest" : null)
+        );
+        this.registeredListener = new RegisteredListener(
+            new Listener() {},
+            (listener, event) -> {
+                if (event instanceof BlockRedstoneEvent) {
+                    calls.incrementAndGet();
+                    ((BlockRedstoneEvent) event).setNewCurrent(6);
+                }
+            },
+            EventPriority.NORMAL,
+            dummyPlugin,
+            false
+        );
+        BlockRedstoneEvent.getHandlerList().register(this.registeredListener);
+
+        LightPropagationParityTest.setBlock(w, 2, 39, 2, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(w, 2, 40, 2, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(w, 1, 40, 2, Blocks.REDSTONE_BLOCK.getBlockData());
+        Blocks.REDSTONE_WIRE.a(w.getType(new BlockPosition(2, 40, 2)), w, new BlockPosition(2, 40, 2), Blocks.REDSTONE_BLOCK, new BlockPosition(1, 40, 2));
+
+        assertEquals(1, calls.get());
+        assertEquals(6, powerAt(w, 2, 40, 2));
+    }
