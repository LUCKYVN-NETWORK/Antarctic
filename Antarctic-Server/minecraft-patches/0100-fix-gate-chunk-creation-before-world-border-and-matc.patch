+    // Antarctic start - world border chunk gating and border expansion refresh
+    private boolean isChunkAllowedByWorldBorder(int chunkX, int chunkZ) {
+        return !com.destroystokyo.paper.config.toml.modules.optimizations.WorldBorder.noChunksPastWorldBorder
+            || this.world.getWorldBorder().isChunkInBounds(chunkX, chunkZ);
+    }
+
+    public void refreshWorldBorderChunks() {
+        if (!com.destroystokyo.paper.config.toml.modules.optimizations.WorldBorder.noChunksPastWorldBorder || this.managedPlayers.isEmpty()) {
+            return;
+        }
+        boolean addedAny = false;
+        for (int idx = 0; idx < this.managedPlayers.size(); ++idx) {
+            EntityPlayer entityplayer = this.managedPlayers.get(idx);
+            int centerX = (int) entityplayer.d >> 4;
+            int centerZ = (int) entityplayer.e >> 4;
+            int viewDistance = entityplayer.getViewDistance();
+            for (int cx = centerX - viewDistance; cx <= centerX + viewDistance; ++cx) {
+                for (int cz = centerZ - viewDistance; cz <= centerZ + viewDistance; ++cz) {
+                    if (this.isChunkAllowedByWorldBorder(cx, cz)) {
+                        PlayerChunk playerchunk = this.c(cx, cz);
+                        if (!playerchunk.d(entityplayer)) {
+                            playerchunk.a(entityplayer);
+                            addedAny = true;
+                        }
+                    }
+                }
+            }
+        }
+        if (addedAny) {
+            this.e();
+        }
+    }
+    // Antarctic end
     // Paper end
 
