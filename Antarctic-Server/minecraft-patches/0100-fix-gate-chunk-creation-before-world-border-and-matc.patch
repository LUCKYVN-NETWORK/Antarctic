+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.lang.management.ManagementFactory;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class WorldBorderChunkBoundsTest {
+
+    private static Unsafe unsafe;
+
+    private static final class RecordingChunkProvider extends ChunkProviderServer {
+        final List<Long> loadRequests = new ArrayList<>();
+
+        RecordingChunkProvider(WorldServer world) {
+            super(world, null, null);
+        }
+
+        @Override
+        public Chunk getChunkAt(int x, int z, Runnable runnable, boolean generate) {
+            this.loadRequests.add(ChunkCoordIntPair.a(x, z));
+            return null;
+        }
+    }
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        Field field = Unsafe.class.getDeclaredField("theUnsafe");
+        field.setAccessible(true);
+        unsafe = (Unsafe) field.get(null);
+    }
+
+    private boolean prevAsyncCatcher;
+
+    @org.junit.Before
+    public void disableAsyncCatcher() {
+        this.prevAsyncCatcher = org.spigotmc.AsyncCatcher.enabled;
+        org.spigotmc.AsyncCatcher.enabled = false;
+    }
+
+    @After
+    public void resetConfig() {
+        com.destroystokyo.paper.config.toml.modules.optimizations.WorldBorder.noChunksPastWorldBorder = false;
+        org.spigotmc.AsyncCatcher.enabled = this.prevAsyncCatcher;
+    }
+
+    private static void set(Class<?> owner, Object instance, String name, Object value) throws Exception {
+        Field f = owner.getDeclaredField(name);
+        f.setAccessible(true);
+        f.set(instance, value);
+    }
+
+    private static Object get(Class<?> owner, Object instance, String name) throws Exception {
+        Field f = owner.getDeclaredField(name);
+        f.setAccessible(true);
+        return f.get(instance);
+    }
+
+    @Test
+    public void isChunkInBoundsMatchesVanillaChunkPosAcross20kTrials() {
+        WorldBorder border = new WorldBorder();
+        Random rng = new Random(0x5EED1234L);
+        for (int trial = 0; trial < 20_000; ++trial) {
+            double centerX = (rng.nextInt(400) - 200) + rng.nextDouble();
+            double centerZ = (rng.nextInt(400) - 200) + rng.nextDouble();
+            double size = 1.0D + rng.nextInt(256) + rng.nextDouble();
+            border.setCenter(centerX, centerZ);
+            border.setSize(size);
+
+            int cx = (int) Math.floor(centerX / 16.0D) + rng.nextInt(25) - 12;
+            int cz = (int) Math.floor(centerZ / 16.0D) + rng.nextInt(25) - 12;
+            boolean expected = border.isInBounds(new ChunkCoordIntPair(cx, cz));
+            boolean actual = border.isChunkInBounds(cx, cz);
+            assertEquals("chunk parity mismatch at trial=" + trial + " (" + cx + "," + cz + ")", expected, actual);
+
+            int bx = (cx << 4) + rng.nextInt(16);
+            int bz = (cz << 4) + rng.nextInt(16);
+            boolean expectedBlock = border.isInBounds(new BlockPosition(bx, 64, bz));
+            boolean actualBlock = border.isBlockInBounds(bx, bz);
+            assertEquals("block parity mismatch at trial=" + trial + " (" + bx + "," + bz + ")", expectedBlock, actualBlock);
+        }
+    }
+
+    @Test
+    public void boundsChecksAllocateZeroBytes() {
+        WorldBorder border = new WorldBorder();
+        border.setCenter(10.5D, -22.25D);
+        border.setSize(128.0D);
+
+        // Warmup
+        int sink = 0;
+        for (int i = 0; i < 20_000; ++i) {
+            sink += border.isChunkInBounds((i & 31) - 16, ((i >> 5) & 31) - 16) ? 1 : 0;
+            sink += border.isBlockInBounds(i & 255, (i >> 8) & 255) ? 1 : 0;
+        }
+        assertTrue(sink >= 0);
+
+        com.sun.management.ThreadMXBean mx = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        long before = mx.getThreadAllocatedBytes(tid);
+        for (int i = 0; i < 50_000; ++i) {
+            sink += border.isChunkInBounds((i & 31) - 16, ((i >> 5) & 31) - 16) ? 1 : 0;
+            sink += border.isBlockInBounds(i & 255, (i >> 8) & 255) ? 1 : 0;
+        }
+        long after = mx.getThreadAllocatedBytes(tid);
+        assertTrue(sink >= 0);
+        assertEquals("isChunkInBounds/isBlockInBounds must allocate 0 bytes", 0L, after - before);
+    }
+
+    @Test
+    public void gatingPreventsLeakedPlayerChunksAndOutsideLoads() throws Exception {
+        WorldServer world = (WorldServer) unsafe.allocateInstance(WorldServer.class);
+        WorldBorder border = new WorldBorder();
+        border.world = world;
+        border.setCenter(0.0D, 0.0D);
+        border.setSize(32.0D); // chunks (-1..0, -1..0) in bounds; chunks outside [-1, 0] are out of bounds
+        set(World.class, world, "P", border);
+        set(World.class, world, "worldData", unsafe.allocateInstance(WorldData.class));
+        RecordingChunkProvider provider = new RecordingChunkProvider(world);
+        set(World.class, world, "chunkProvider", provider);
+        set(World.class, world, "paperConfig", unsafe.allocateInstance(com.destroystokyo.paper.PaperWorldConfig.class));
+
+        PlayerChunkMap map = (PlayerChunkMap) unsafe.allocateInstance(PlayerChunkMap.class);
+        set(PlayerChunkMap.class, map, "world", world);
+        set(PlayerChunkMap.class, map, "managedPlayers", new ArrayList<EntityPlayer>());
+        set(PlayerChunkMap.class, map, "e", new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<PlayerChunk>(4096));
+        set(PlayerChunkMap.class, map, "f", new java.util.HashSet<PlayerChunk>());
+        set(PlayerChunkMap.class, map, "g", new java.util.LinkedList<PlayerChunk>());
+        set(PlayerChunkMap.class, map, "h", new java.util.LinkedList<PlayerChunk>());
+        set(PlayerChunkMap.class, map, "i", new ArrayList<PlayerChunk>());
+        set(PlayerChunkMap.class, map, "j", 4);
+        set(WorldServer.class, world, "manager", map);
+
+        EntityPlayer player = (EntityPlayer) unsafe.allocateInstance(EntityPlayer.class);
+        player.locX = 0.0D;
+        player.locZ = 0.0D;
+        set(Entity.class, player, "world", world);
+        player.setViewDistance(4);
+
+        // Enable gating: only chunks in bounds should be created or loaded
+        com.destroystokyo.paper.config.toml.modules.optimizations.WorldBorder.noChunksPastWorldBorder = true;
+        map.addPlayer(player);
+
+        @SuppressWarnings("unchecked")
+        List<PlayerChunk> activeChunks = (List<PlayerChunk>) get(PlayerChunkMap.class, map, "i");
+        assertEquals("only the 4 in-border chunks should be created", 4, activeChunks.size());
+        assertEquals("only the 4 in-border chunks should request loads", 4, provider.loadRequests.size());
+        assertNotNull(map.getChunk(0, 0));
+        assertNull("out-of-border chunk must not create PlayerChunk", map.getChunk(3, 3));
+
+        // Expand border: newly in-bounds chunks within view distance must be added automatically
+        border.setSize(96.0D); // chunks -3..2 in bounds
+        assertNotNull("expanding border must populate newly in-bounds chunk", map.getChunk(2, 2));
+        assertTrue(map.getChunk(2, 2).d(player));
+        assertNull("still out-of-border chunk must not be created", map.getChunk(4, 4));
+
+        // Shrink view distance: must not create out-of-border PlayerChunks on removal
+        int loadsBeforeShrink = provider.loadRequests.size();
+        map.setViewDistance(player, 3, true);
+        player.setViewDistance(3);
+        assertEquals("shrinking view distance must not trigger new chunk loads", loadsBeforeShrink, provider.loadRequests.size());
+        assertNull(map.getChunk(4, 4));
+
+        // Remove player: zero leaked PlayerChunks remain
+        map.removePlayer(player);
+        assertEquals("zero PlayerChunks may leak after player leaves", 0, activeChunks.size());
+
+        // Disable gating (vanilla default): full (2*3+1)^2 = 49 chunks created
+        com.destroystokyo.paper.config.toml.modules.optimizations.WorldBorder.noChunksPastWorldBorder = false;
+        border.setSize(32.0D);
+        map.addPlayer(player);
+        assertEquals("with gating disabled, vanilla creates all 49 chunks in view distance", 49, activeChunks.size());
+        map.removePlayer(player);
+        assertEquals(0, activeChunks.size());
+    }
+}
