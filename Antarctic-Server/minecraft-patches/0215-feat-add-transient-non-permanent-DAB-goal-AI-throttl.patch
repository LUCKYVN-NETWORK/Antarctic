diff --git a/test/java/net/minecraft/server/DabThrottlingTest.java b/test/java/net/minecraft/server/DabThrottlingTest.java
new file mode 100644
index 0000000..798713f
--- /dev/null
+++ b/test/java/net/minecraft/server/DabThrottlingTest.java
@@ -0,0 +1,202 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.Dab;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class DabThrottlingTest {
+
+    private static Unsafe UNSAFE;
+    private static boolean defEnabled;
+    private static int defStartDist;
+    private static int defMaxFreq;
+    private static int defDistMod;
+    private static boolean defDontWater;
+    private static List<String> defBlacklist;
+
+    @BeforeClass
+    public static void setupTest() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+        defEnabled = Dab.enabled;
+        defStartDist = Dab.startDistance;
+        defMaxFreq = Dab.maxTickFreq;
+        defDistMod = Dab.activationDistMod;
+        defDontWater = Dab.dontEnableIfInWater;
+        defBlacklist = new ArrayList<>(Dab.blacklistedEntities);
+    }
+
+    @After
+    public void restoreConfig() {
+        Dab.enabled = defEnabled;
+        Dab.startDistance = defStartDist;
+        Dab.maxTickFreq = defMaxFreq;
+        Dab.activationDistMod = defDistMod;
+        Dab.dontEnableIfInWater = defDontWater;
+        Dab.blacklistedEntities = new ArrayList<>(defBlacklist);
+        Dab.refreshDerivedState();
+    }
+
+    private static final class DummyWorld extends WorldServer {
+        DummyWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public boolean isMainThread() {
+            return true;
+        }
+    }
+
+    private static DummyWorld createWorld() throws Exception {
+        DummyWorld world = (DummyWorld) UNSAFE.allocateInstance(DummyWorld.class);
+        Field csField = World.class.getDeclaredField("isClientSide");
+        csField.setAccessible(true);
+        csField.setBoolean(world, true);
+        world.worldData = new WorldData();
+        world.worldProvider = new WorldProviderNormal();
+        Field mpField = World.class.getDeclaredField("methodProfiler");
+        mpField.setAccessible(true);
+        mpField.set(world, new MethodProfiler());
+        Field randomField = World.class.getDeclaredField("random");
+        randomField.setAccessible(true);
+        randomField.set(world, new java.util.Random(1L));
+        Field spigotField = World.class.getDeclaredField("spigotConfig");
+        spigotField.setAccessible(true);
+        spigotField.set(world, UNSAFE.allocateInstance(org.spigotmc.SpigotWorldConfig.class));
+        Field paperField = World.class.getDeclaredField("paperConfig");
+        paperField.setAccessible(true);
+        paperField.set(world, UNSAFE.allocateInstance(com.destroystokyo.paper.PaperWorldConfig.class));
+        return world;
+    }
+
+    @Test
+    public void testDabNeverSetsNoAiAndRestoresImmediately() throws Exception {
+        DummyWorld world = createWorld();
+        EntityZombie zombie = new EntityZombie(world);
+        Dab.enabled = true;
+        Dab.startDistance = 12;
+        Dab.maxTickFreq = 20;
+        Dab.activationDistMod = 8;
+        Dab.refreshDerivedState();
+
+        // Distant mob: throttles >60% of ticks across 20 ticks, staggered by ID
+        zombie.antarcticDabTickStamp = 100;
+        zombie.antarcticDabDistSq = 5120; // 5120 >> 8 = 20
+        int skipped = 0;
+        for (int t = 100; t < 120; t++) {
+            zombie.antarcticDabTickStamp = t;
+            if (zombie.shouldSkipAiForDab(t)) {
+                skipped++;
+            }
+        }
+        assertEquals("Distant mob must skip 19 of 20 ticks", 19, skipped);
+        assertFalse("DAB must never mutate DataWatcher NoAI", zombie.isNoAI());
+
+        NBTTagCompound saved = new NBTTagCompound();
+        zombie.b(saved);
+        assertFalse("DAB must never persist NoAI:1b to NBT", saved.getBoolean("NoAI"));
+
+        // Player walks within startDistance (distSq = 64 <= 144) -> immediate full AI
+        zombie.antarcticDabTickStamp = 120;
+        zombie.antarcticDabDistSq = 64;
+        assertFalse("Approaching player must restore AI immediately", zombie.shouldSkipAiForDab(120));
+
+        // Hot-reload disable restores immediately even when far
+        zombie.antarcticDabDistSq = 10_000;
+        Dab.enabled = false;
+        assertFalse("Disabling DAB must restore AI immediately", zombie.shouldSkipAiForDab(120));
+    }
+
+    @Test
+    public void testDabExemptions() throws Exception {
+        DummyWorld world = createWorld();
+        Dab.enabled = true;
+        Dab.startDistance = 12;
+        Dab.maxTickFreq = 20;
+        Dab.dontEnableIfInWater = true;
+        Dab.refreshDerivedState();
+
+        // 1. Named mob exempt
+        EntityZombie named = new EntityZombie(world);
+        named.setCustomName("Guard");
+        assertTrue(named.isDabExempt());
+
+        // 2. Hurt mob exempt
+        EntityZombie hurt = new EntityZombie(world);
+        hurt.hurtTicks = 5;
+        assertTrue(hurt.isDabExempt());
+
+        // 3. In water exempt when dontEnableIfInWater=true
+        EntityZombie wet = new EntityZombie(world);
+        wet.inWater = true;
+        assertTrue(wet.isDabExempt());
+        Dab.dontEnableIfInWater = false;
+        assertFalse(wet.isDabExempt());
+
+        // 4. Blacklisted villager (case & minecraft: prefix normalization)
+        assertTrue(Dab.isBlacklisted("villager"));
+        assertTrue(Dab.isBlacklisted("minecraft:Villager"));
+        assertFalse(Dab.isBlacklisted("zombie"));
+
+        EntityVillager villager = new EntityVillager(world) {
+            @Override
+            public String getMinecraftKeyString() {
+                return "minecraft:villager";
+            }
+        };
+        assertTrue(villager.isDabExempt());
+
+        // 5. Boss exempt
+        EntityWither wither = new EntityWither(world);
+        assertTrue(wither.isDabExempt());
+
+        // 6. Tamed wolf exempt
+        EntityWolf wolf = new EntityWolf(world);
+        wolf.setTamed(true);
+        assertTrue(wolf.isDabExempt());
+    }
+
+    @Test
+    public void testDab500MobPerfAndReduction() throws Exception {
+        DummyWorld world = createWorld();
+        Dab.enabled = true;
+        Dab.startDistance = 12;
+        Dab.maxTickFreq = 20;
+        Dab.activationDistMod = 8;
+        Dab.refreshDerivedState();
+
+        EntityZombie[] mobs = new EntityZombie[500];
+        for (int i = 0; i < mobs.length; i++) {
+            mobs[i] = new EntityZombie(world);
+        }
+
+        long start = System.nanoTime();
+        int totalTicks = 0;
+        int executedAiTicks = 0;
+        for (int t = 1; t <= 200; t++) {
+            for (EntityZombie mob : mobs) {
+                mob.antarcticDabTickStamp = t;
+                mob.antarcticDabDistSq = 4096; // 4096 >> 8 = 16
+                totalTicks++;
+                if (!mob.shouldSkipAiForDab(t)) {
+                    executedAiTicks++;
+                }
+            }
+        }
+        long elapsedMs = (System.nanoTime() - start) / 1_000_000L;
+        double reduction = 1.0D - ((double) executedAiTicks / totalTicks);
+        assertTrue("Expected >60% AI reduction, got " + reduction, reduction > 0.60D);
+        assertTrue("500-mob x 200-tick DAB check took too long: " + elapsedMs + " ms", elapsedMs < 150L);
+    }
+}
