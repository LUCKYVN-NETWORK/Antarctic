diff --git a/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/Dab.java b/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/Dab.java
new file mode 100644
index 0000000..67a4de1
--- /dev/null
+++ b/main/java/com/destroystokyo/paper/config/toml/modules/optimizations/Dab.java
@@ -0,0 +1,93 @@
+package com.destroystokyo.paper.config.toml.modules.optimizations;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+
+import javax.annotation.Nullable;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+public class Dab implements IConfigModule {
+
+    @ConfigInfo(baseName = "enabled", comments = "Transient Dynamic Activation of Brain (goal AI throttling) for distant mobs. Never sets NoAI or mutates NBT/DataWatcher. Default false.")
+    public static boolean enabled = false;
+
+    @ConfigInfo(baseName = "start-distance", comments = "Distance in blocks from the nearest player within which mobs always run full AI every tick. Default 12.")
+    public static int startDistance = 12;
+
+    @ConfigInfo(baseName = "max-tick-freq", comments = "Maximum interval (in ticks) between AI updates for very distant mobs. Default 20.")
+    public static int maxTickFreq = 20;
+
+    @ConfigInfo(baseName = "activation-dist-mod", comments = "Right-shift divisor on squared distance when computing DAB tick frequency (freq = distSq >> mod). Default 8.")
+    public static int activationDistMod = 8;
+
+    @ConfigInfo(baseName = "dont-enable-if-in-water", comments = "If true, mobs currently in water are exempt from DAB AI throttling. Default false.")
+    public static boolean dontEnableIfInWater = false;
+
+    @ConfigInfo(baseName = "blacklisted-entities", comments = "1.12.2 entity keys exempt from DAB throttling (e.g., villager, iron_golem, zombie_pigman).")
+    public static List<String> blacklistedEntities = new ArrayList<>(Arrays.asList("villager", "iron_golem", "zombie_pigman"));
+
+    public static int startDistanceSquared = 144;
+    private static volatile Set<String> blacklistedSet = buildBlacklist(blacklistedEntities);
+
+    private static Set<String> buildBlacklist(@Nullable List<String> entries) {
+        if (entries == null || entries.isEmpty()) {
+            return Set.of();
+        }
+        Set<String> set = new HashSet<>(entries.size());
+        for (String raw : entries) {
+            if (raw == null) {
+                continue;
+            }
+            String trimmed = raw.trim().toLowerCase(Locale.ROOT);
+            if (trimmed.startsWith("minecraft:")) {
+                trimmed = trimmed.substring(10);
+            }
+            if (!trimmed.isEmpty()) {
+                set.add(trimmed);
+            }
+        }
+        return Set.copyOf(set);
+    }
+
+    public static void refreshDerivedState() {
+        startDistance = Math.max(0, startDistance);
+        maxTickFreq = Math.max(1, maxTickFreq);
+        activationDistMod = Math.max(1, Math.min(30, activationDistMod));
+        startDistanceSquared = startDistance * startDistance;
+        blacklistedSet = buildBlacklist(blacklistedEntities);
+    }
+
+    public static boolean isBlacklisted(@Nullable String key) {
+        Set<String> set = blacklistedSet;
+        if (key == null || set.isEmpty()) {
+            return false;
+        }
+        String normalized = key;
+        if (normalized.regionMatches(true, 0, "minecraft:", 0, 10)) {
+            normalized = normalized.substring(10);
+        }
+        return set.contains(normalized.toLowerCase(Locale.ROOT));
+    }
+
+    @Override
+    public void onLoaded(CommentedFileConfig config) {
+        refreshDerivedState();
+    }
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.OPTIMIZATIONS;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "dab";
+    }
+}
diff --git a/main/java/net/minecraft/server/EntityInsentient.java b/main/java/net/minecraft/server/EntityInsentient.java
index 2115c0b..4829696 100644
--- a/main/java/net/minecraft/server/EntityInsentient.java
+++ b/main/java/net/minecraft/server/EntityInsentient.java
@@ -673,6 +673,45 @@ public abstract class EntityInsentient extends EntityLiving {
         }
     }
 
+    public int antarcticDabDistSq = Integer.MAX_VALUE;
+    public int antarcticDabTickStamp = Integer.MIN_VALUE;
+
+    boolean isDabExempt() {
+        if (this instanceof EntityWither
+                || this instanceof EntityEnderDragon
+                || this instanceof EntityGuardianElder
+                || this.hasCustomName()
+                || this.isLeashed()
+                || this.isVehicle()
+                || this.isPassenger()
+                || this.hurtTicks > 0
+                || this.lastDamageByPlayerTime > 0) {
+            return true;
+        }
+        if (this instanceof EntityTameableAnimal && ((EntityTameableAnimal) this).isTamed()) {
+            return true;
+        }
+        if (com.destroystokyo.paper.config.toml.modules.optimizations.Dab.dontEnableIfInWater && this.inWater) {
+            return true;
+        }
+        return com.destroystokyo.paper.config.toml.modules.optimizations.Dab.isBlacklisted(this.getMinecraftKeyString());
+    }
+
+    boolean shouldSkipAiForDab(int currentTick) {
+        if (!com.destroystokyo.paper.config.toml.modules.optimizations.Dab.enabled || this.isDabExempt()) {
+            return false;
+        }
+        int distSq = (this.antarcticDabTickStamp == currentTick) ? this.antarcticDabDistSq : Integer.MAX_VALUE;
+        if (distSq <= com.destroystokyo.paper.config.toml.modules.optimizations.Dab.startDistanceSquared) {
+            return false;
+        }
+        int maxFreq = com.destroystokyo.paper.config.toml.modules.optimizations.Dab.maxTickFreq;
+        int freq = (distSq == Integer.MAX_VALUE)
+                ? maxFreq
+                : Math.min(maxFreq, Math.max(1, distSq >> com.destroystokyo.paper.config.toml.modules.optimizations.Dab.activationDistMod));
+        return freq > 1 && ((currentTick + this.getId()) & 0x7FFFFFFF) % freq != 0;
+    }
+
     protected final void doTick() {
         ++this.ticksFarFromPlayer;
         this.world.methodProfiler.a("checkDespawn");
@@ -690,6 +729,13 @@ public abstract class EntityInsentient extends EntityLiving {
             return;
         }
         // Spigot End
+        if (com.destroystokyo.paper.config.toml.modules.optimizations.Dab.enabled && this.shouldSkipAiForDab(MinecraftServer.currentTick)) {
+            if (this.inWater && this.goalFloat != null) {
+                if (this.goalFloat.validConditions()) this.goalFloat.update();
+                this.getControllerJump().jumpIfSet();
+            }
+            return;
+        }
         this.world.methodProfiler.a("sensing");
         this.bw.a();
         this.world.methodProfiler.b();
