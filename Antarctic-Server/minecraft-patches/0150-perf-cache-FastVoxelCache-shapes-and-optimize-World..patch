diff --git a/test/java/net/minecraft/server/FastVoxelAndGetCubesPerfTest.java b/test/java/net/minecraft/server/FastVoxelAndGetCubesPerfTest.java
new file mode 100644
index 0000000..35d7761
--- /dev/null
+++ b/test/java/net/minecraft/server/FastVoxelAndGetCubesPerfTest.java
@@ -0,0 +1,119 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.Physics;
+import com.sun.management.ThreadMXBean;
+import java.lang.management.ManagementFactory;
+import me.stella.antarctic.spatial.FastVoxelCache;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+public class FastVoxelAndGetCubesPerfTest {
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    @Test
+    public void testCachedClassifyMatchesUncachedForEveryRegisteredBlockState() {
+        int count = 0;
+        for (IBlockData state : Block.REGISTRY_ID) {
+            ++count;
+            FastVoxelCache.ShapeType expected = FastVoxelCache.computeShapeType(state);
+            FastVoxelCache.ShapeType first = FastVoxelCache.classify(state);
+            FastVoxelCache.ShapeType second = FastVoxelCache.classify(state);
+            Assert.assertEquals("Mismatch for " + state, expected, first);
+            Assert.assertSame("Cached classification must return identical enum instance", first, second);
+        }
+        Assert.assertTrue("Expected full 1.12.2 block state registry", count > 1000);
+    }
+
+    @Test
+    public void testCachedClassifyAndHasAnyCollisionThroughputAndAllocation() throws Exception {
+        IBlockData[] palette = new IBlockData[] {
+            Blocks.STONE.getBlockData(),
+            Blocks.DIRT.getBlockData(),
+            Blocks.GRASS.getBlockData(),
+            Blocks.COBBLESTONE.getBlockData(),
+            Blocks.AIR.getBlockData(),
+            Blocks.SOUL_SAND.getBlockData(),
+            Blocks.OAK_STAIRS.getBlockData(),
+            Blocks.GLASS.getBlockData()
+        };
+
+        final int warmup = 200_000;
+        final int measured = 2_000_000;
+        int sink = 0;
+
+        for (int i = 0; i < warmup; ++i) {
+            IBlockData s = palette[i & 7];
+            sink += FastVoxelCache.computeShapeType(s).ordinal();
+            sink += FastVoxelCache.classify(s).ordinal();
+        }
+
+        long t0 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            sink += FastVoxelCache.computeShapeType(palette[i & 7]).ordinal();
+        }
+        long uncachedNs = System.nanoTime() - t0;
+
+        long t1 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            sink += FastVoxelCache.classify(palette[i & 7]).ordinal();
+        }
+        long cachedNs = System.nanoTime() - t1;
+
+        // Also benchmark World.getCubes(...).isEmpty() vs World.hasAnyBlockOrEntityCollision(...) on a solid floor
+        WorldServer world = LightPropagationParityTest.buildWorld(1, new LightPropagationParityTest.StubProvider[1]);
+        LightPropagationParityTest.set(World.class, world, "P", new WorldBorder());
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                LightPropagationParityTest.setBlock(world, x, 63, z, Blocks.STONE.getBlockData());
+            }
+        }
+
+        boolean prev = Physics.optimizeVoxelCollisions;
+        Physics.optimizeVoxelCollisions = true;
+        try {
+            AxisAlignedBB box = new AxisAlignedBB(4.2D, 62.8D, 4.2D, 4.8D, 64.6D, 4.8D);
+            Assert.assertEquals(!world.getCubes(null, box).isEmpty(), world.hasAnyBlockOrEntityCollision(null, box));
+
+            for (int i = 0; i < 10_000; ++i) {
+                if (!world.getCubes(null, box).isEmpty()) sink++;
+                if (world.hasAnyBlockOrEntityCollision(null, box)) sink++;
+            }
+
+            ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+            long tid = Thread.currentThread().getId();
+
+            long a0 = bean.getThreadAllocatedBytes(tid);
+            long g0 = System.nanoTime();
+            for (int i = 0; i < 100_000; ++i) {
+                if (!world.getCubes(null, box).isEmpty()) sink++;
+            }
+            long getCubesNs = System.nanoTime() - g0;
+            long getCubesAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a0);
+
+            long a1 = bean.getThreadAllocatedBytes(tid);
+            long g1 = System.nanoTime();
+            for (int i = 0; i < 100_000; ++i) {
+                if (world.hasAnyBlockOrEntityCollision(null, box)) sink++;
+            }
+            long earlyExitNs = System.nanoTime() - g1;
+            long earlyExitAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a1);
+
+            System.out.printf(
+                    "[perf] FastVoxelCache.classify (%d ops): uncached=%.2f ms vs cached=%.2f ms (%.2fx) | collision check (100k ops): getCubes=%.2f ms (alloc=%.2f MB) vs hasAny=%.2f ms (alloc=%d B, %.2fx, sink=%d)%n",
+                    measured, uncachedNs / 1e6, cachedNs / 1e6, (double) uncachedNs / Math.max(1L, cachedNs),
+                    getCubesNs / 1e6, getCubesAlloc / (1024.0 * 1024.0),
+                    earlyExitNs / 1e6, earlyExitAlloc, (double) getCubesNs / Math.max(1L, earlyExitNs), sink);
+
+            Assert.assertEquals("hasAnyBlockOrEntityCollision on full-cube floor must allocate 0 bytes", 0L, earlyExitAlloc);
+            Assert.assertTrue("Cached classify must be faster than uncached ClassValue lookup", cachedNs < uncachedNs);
+            Assert.assertTrue("Early-exit collision check must be faster than getCubes().isEmpty()", earlyExitNs < getCubesNs);
+        } finally {
+            Physics.optimizeVoxelCollisions = prev;
+        }
+    }
+}
