+    @Test
+    @SuppressWarnings("unchecked")
+    public void testEntityTrackerChunkQueryAndIdleEntryParity() throws Exception {
+        TestWorld world = createWorld();
+        EntityTracker tracker = (EntityTracker) unsafe.allocateInstance(EntityTracker.class);
+        unsafe.putObject(tracker, unsafe.objectFieldOffset(EntityTracker.class.getDeclaredField("world")), world);
+        unsafe.putObject(tracker, unsafe.objectFieldOffset(EntityTracker.class.getDeclaredField("c")), new HashSet<>());
+        IntHashMap<EntityTrackerEntry> trackedMap = new IntHashMap<>();
+        unsafe.putObject(tracker, unsafe.objectFieldOffset(EntityTracker.class.getDeclaredField("trackedEntities")), trackedMap);
+        unsafe.putInt(tracker, unsafe.objectFieldOffset(EntityTracker.class.getDeclaredField("e")), 64);
+
+        Chunk chunk = world.getChunkIfLoaded(0, 0);
+        List<EntityTrackerEntry> seenUpdates = new ArrayList<>();
+
+        // Create 5 tracked entities in chunk (0,0) and 1 untracked (dangling tracker)
+        for (int i = 0; i < 5; i++) {
+            EntityZombie zombie = new EntityZombie(world);
+            zombie.setPosition(8.0D, 64.0D, 8.0D);
+            zombie.ab = 0;
+            zombie.ad = 0;
+            chunk.getEntitySlices()[4].add(zombie);
+            EntityTrackerEntry entry = new EntityTrackerEntry(zombie, 80, 80, 3, true) {
+                @Override
+                public void updatePlayer(EntityPlayer p) {
+                    seenUpdates.add(this);
+                }
+            };
+            zombie.tracker = entry;
+            trackedMap.a(zombie.getId(), entry);
+        }
+
+        // Dangling entity.tracker that was untracked must be ignored
+        EntityZombie untracked = new EntityZombie(world);
+        untracked.ab = 0;
+        untracked.ad = 0;
+        chunk.getEntitySlices()[4].add(untracked);
+        EntityTrackerEntry staleEntry = new EntityTrackerEntry(untracked, 80, 80, 3, true) {
+            @Override
+            public void updatePlayer(EntityPlayer p) {
+                seenUpdates.add(this);
+            }
+        };
+        untracked.tracker = staleEntry;
+        trackedMap.a(untracked.getId(), staleEntry);
+        // Untrack must clear dangling reference
+        tracker.untrackEntity(untracked);
+        Assert.assertNull(untracked.tracker);
+
+        EntityPlayer viewer = (EntityPlayer) unsafe.allocateInstance(EntityPlayer.class);
+        tracker.a(viewer, chunk);
+        Assert.assertEquals(5, seenUpdates.size());
+
+        // Idle EntityTrackerEntry.track() clears DataWatcher dirty flag and increments a
+        EntityZombie idleMob = new EntityZombie(world);
+        idleMob.setPosition(10.0D, 64.0D, 10.0D);
+        idleMob.setCustomName("IdleMob");
+        Assert.assertTrue(idleMob.getDataWatcher().a());
+        EntityTrackerEntry idleEntry = new EntityTrackerEntry(idleMob, 80, 80, 3, true);
+        idleEntry.track(Collections.emptyList());
+        Assert.assertFalse("Idle track() must clear DataWatcher dirty flag", idleMob.getDataWatcher().a());
+        Assert.assertEquals(1, idleEntry.a);
+    }
