+    @Test
+    @SuppressWarnings("unchecked")
+    public void testEntityTrackerPerf() throws Exception {
+        TestWorld world = createWorld();
+        EntityTracker tracker = (EntityTracker) unsafe.allocateInstance(EntityTracker.class);
+        unsafe.putObject(tracker, unsafe.objectFieldOffset(EntityTracker.class.getDeclaredField("world")), world);
+        HashSet<EntityTrackerEntry> entrySet = new HashSet<>();
+        unsafe.putObject(tracker, unsafe.objectFieldOffset(EntityTracker.class.getDeclaredField("c")), entrySet);
+        IntHashMap<EntityTrackerEntry> trackedMap = new IntHashMap<>();
+        unsafe.putObject(tracker, unsafe.objectFieldOffset(EntityTracker.class.getDeclaredField("trackedEntities")), trackedMap);
+        unsafe.putInt(tracker, unsafe.objectFieldOffset(EntityTracker.class.getDeclaredField("e")), 64);
+
+        Chunk chunk = world.getChunkIfLoaded(0, 0);
+        // Populate 2,000 tracked entities across distant chunks, 10 in chunk (0,0)
+        for (int i = 0; i < 2000; i++) {
+            EntityZombie z = new EntityZombie(world);
+            int cx = (i < 10) ? 0 : (i / 10);
+            z.ab = cx;
+            z.ad = 0;
+            if (cx == 0) {
+                chunk.getEntitySlices()[4].add(z);
+            }
+            EntityTrackerEntry entry = new EntityTrackerEntry(z, 80, 80, 3, true) {
+                @Override
+                public void updatePlayer(EntityPlayer p) {
+                    // no-op for benchmark
+                }
+            };
+            z.tracker = entry;
+            entrySet.add(entry);
+            trackedMap.a(z.getId(), entry);
+        }
+
+        EntityPlayer viewer = (EntityPlayer) unsafe.allocateInstance(EntityPlayer.class);
+        EntityZombie idleMob = new EntityZombie(world);
+        EntityTrackerEntry idleEntry = new EntityTrackerEntry(idleMob, 80, 80, 3, true);
+
+        final int warmup = 2000;
+        final int iters = 1000;
+        long sink = 0L;
+
+        for (int i = 0; i < warmup; i++) {
+            for (EntityTrackerEntry e : entrySet) {
+                Entity ent = e.b();
+                if (ent != viewer && ent.ab == chunk.locX && ent.ad == chunk.locZ) {
+                    sink++;
+                }
+            }
+            tracker.a(viewer, chunk);
+            idleEntry.track(Collections.emptyList());
+            sink += idleEntry.a;
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        bean.getThreadAllocatedBytes(tid);
+
+        long vanBytes0 = bean.getThreadAllocatedBytes(tid);
+        long vanT0 = System.nanoTime();
+        for (int i = 0; i < iters; i++) {
+            ArrayList<Entity> l1 = new ArrayList<>();
+            ArrayList<Entity> l2 = new ArrayList<>();
+            for (EntityTrackerEntry e : entrySet) {
+                Entity ent = e.b();
+                if (ent != viewer && ent.ab == chunk.locX && ent.ad == chunk.locZ) {
+                    sink++;
+                }
+            }
+            sink += l1.size() + l2.size();
+        }
+        long vanNs = System.nanoTime() - vanT0;
+        long vanBytes = bean.getThreadAllocatedBytes(tid) - vanBytes0;
+
+        long optBytes0 = bean.getThreadAllocatedBytes(tid);
+        long optT0 = System.nanoTime();
+        for (int i = 0; i < iters; i++) {
+            tracker.a(viewer, chunk);
+            idleEntry.track(Collections.emptyList());
+            sink += idleEntry.a;
+        }
+        long optNs = System.nanoTime() - optT0;
+        long optBytes = bean.getThreadAllocatedBytes(tid) - optBytes0;
+
+        double speedup = (double) vanNs / Math.max(1L, optNs);
+        System.out.println("C10_BENCH vanilla_ns=" + vanNs + " opt_ns=" + optNs
+            + " speedup=" + String.format("%.2fx", speedup)
+            + " vanilla_bytes=" + vanBytes + " opt_bytes=" + optBytes + " sink=" + sink);
+
+        Assert.assertEquals("Optimized path should allocate 0 bytes", 0L, optBytes);
+        Assert.assertTrue("Expected >= 5.0x speedup, got " + speedup, speedup > 5.0D);
+    }
