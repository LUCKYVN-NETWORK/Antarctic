+    @Test
+    public void isolatedBlockShapesMatchActualWorldQueries() throws Exception {
+        WorldServer world = world();
+        AxisAlignedBB query = new AxisAlignedBB(-0.25D, 63.75D, -0.25D, 1.25D, 65.25D, 1.25D);
+        for (Block block : new Block[] {Blocks.AIR, Blocks.STONE, Blocks.CARPET, Blocks.WATERLILY, Blocks.OAK_STAIRS}) {
+            block(world, 0, 64, 0, block);
+            List<AxisAlignedBB> boxes = parity(world, query);
+            if (block == Blocks.AIR) {
+                assertTrue(boxes.isEmpty());
+            } else {
+                assertFalse("baseline must exercise " + block, boxes.isEmpty());
+            }
+            if (block == Blocks.CARPET || block == Blocks.WATERLILY) {
+                double inset = block == Blocks.CARPET ? 0.0D : 0.0625D;
+                double height = block == Blocks.CARPET ? 0.0625D : 0.09375D;
+                assertEquals(1, boxes.size());
+                assertBoxes("thin shape", java.util.Collections.singletonList(
+                        new AxisAlignedBB(inset, 64, inset, 1 - inset, 64 + height, 1 - inset)), boxes);
+            }
+        }
+    }
