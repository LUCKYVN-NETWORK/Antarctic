+    @Test
+    public void mixedShapesPreserveOrderedBoxesAcrossChunkEdges() throws Exception {
+        WorldServer world = world();
+        Block[] blocks = {Blocks.AIR, Blocks.STONE, Blocks.CARPET, Blocks.WATERLILY, Blocks.OAK_STAIRS};
+        for (int x = -18; x <= 18; ++x) {
+            for (int z = -3; z <= 3; ++z) {
+                block(world, x, 64, z, blocks[Math.floorMod(x + z, blocks.length)]);
+                if ((x + z) % 3 == 0) {
+                    block(world, x, 65, z, Blocks.STONE);
+                }
+            }
+        }
+        assertTrue(parity(world, new AxisAlignedBB(-18.2D, 63.9D, -3.2D, 18.2D, 66.1D, 3.2D)).size() > 20);
+        for (int x : new int[] {-17, -16, -1, 0, 15, 16}) {
+            parity(world, new AxisAlignedBB(x - 0.3D, 64, -0.3D, x + 0.3D, 65.8D, 0.3D));
+        }
