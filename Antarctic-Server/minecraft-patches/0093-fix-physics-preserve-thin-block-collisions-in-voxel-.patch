+    public void reportStoneAirSweepTimings() throws Exception {
+        WorldServer world = world();
+        for (int x = -12; x <= 12; ++x) {
+            for (int z = -12; z <= 12; ++z) {
+                block(world, x, 64, z, Blocks.STONE);
+                if ((x + z) % 7 == 0) {
+                    block(world, x, 65, z, Blocks.STONE);
+                }
+            }
+        }
+        AxisAlignedBB[] queries = new AxisAlignedBB[128];
+        for (int i = 0; i < queries.length; ++i) {
+            double x = (i % 16) - 8 + 0.15D;
+            double z = (i / 16) - 4 + 0.35D;
+            double y = i % 3 == 0 ? 67 : 64.8D;
+            queries[i] = new AxisAlignedBB(x - 0.3D, y, z - 0.3D, x + 0.3D, y + 1.8D, z + 0.3D);
+            parity(world, queries[i]);
+        }
+        for (int warmup = 0; warmup < 4; ++warmup) {
+            sweep(world, queries, false, 10);
+            sweep(world, queries, true, 10);
+        }
+        long baseline = 0;
+        long optimized = 0;
+        for (int sample = 0; sample < 4; ++sample) {
+            // Alternate measurement order; timings are diagnostic, never a pass/fail threshold.
+            if ((sample & 1) == 0) {
+                baseline += sweep(world, queries, false, 25);
+                optimized += sweep(world, queries, true, 25);
+            } else {
+                optimized += sweep(world, queries, true, 25);
+                baseline += sweep(world, queries, false, 25);
+            }
+        }
+        System.out.printf("VoxelCollisionTest stone/air sweeps: queries/path=%d baseline=%.3f ms optimized=%.3f ms checksum=%d%n",
+                queries.length * 100, baseline / 1_000_000.0D, optimized / 1_000_000.0D, benchmarkChecksum);
