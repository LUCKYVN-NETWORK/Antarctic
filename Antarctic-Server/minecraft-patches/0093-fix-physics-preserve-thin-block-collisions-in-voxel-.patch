+    private static void assertBoxes(String context, List<AxisAlignedBB> expected, List<AxisAlignedBB> actual) {
+        assertEquals(context + " count", expected.size(), actual.size());
+        for (int i = 0; i < expected.size(); ++i) {
+            AxisAlignedBB a = expected.get(i);
+            AxisAlignedBB b = actual.get(i);
+            String message = context + " box " + i;
+            assertEquals(message + " minX", a.a, b.a, 0.0D);
+            assertEquals(message + " minY", a.b, b.b, 0.0D);
+            assertEquals(message + " minZ", a.c, b.c, 0.0D);
+            assertEquals(message + " maxX", a.d, b.d, 0.0D);
+            assertEquals(message + " maxY", a.e, b.e, 0.0D);
+            assertEquals(message + " maxZ", a.f, b.f, 0.0D);
+        }
+    }
+
+    private static List<AxisAlignedBB> parity(World world, AxisAlignedBB query) {
+        Physics.optimizeVoxelCollisions = false;
+        List<AxisAlignedBB> expected = world.getCubes(null, query);
+        Physics.optimizeVoxelCollisions = true;
+        assertBoxes("query " + query, expected, world.getCubes(null, query));
+        return expected;
+    }
