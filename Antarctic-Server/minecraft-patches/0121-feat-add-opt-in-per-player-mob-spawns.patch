+    @Test
+    public void testDefaultsAndAutoRadiusBlocksR4InfiniteSpawnExploit() throws Exception {
+        assertFalse("per-player-mob-spawns must default to false", MobSpawning.perPlayerMobSpawns);
+        assertEquals("per-player-mob-count-radius-chunks must default to 0 (auto)", 0, MobSpawning.perPlayerMobCountRadiusChunks);
+
+        TestWorld world = newWorld(70);
+        // Auto radius for hardDespawnDistance=128^2 must be 8 chunks (128 blocks), NOT mobSpawnRange=4!
+        assertEquals(8, SpawnerCreature.resolvePerPlayerMobCountRadius(world));
+
+        // Explicit override works
+        MobSpawning.perPlayerMobCountRadiusChunks = 6;
+        assertEquals(6, SpawnerCreature.resolvePerPlayerMobCountRadius(world));
+        MobSpawning.perPlayerMobCountRadiusChunks = 0;
+
+        // Exploit defense test: place Player A at (0, 0) and push 70 mobs to chunk (6, 0) (96 blocks < 128 despawn!)
+        EntityPlayer playerA = addPlayer(world, 0, 0);
+        addSpawnableChunk(world, 0, 0, true);
+        Chunk exploitHoldingChunk = addSpawnableChunk(world, 6, 0, false);
+        addMonsters(world, exploitHoldingChunk, 70);
+
+        MobSpawning.perPlayerMobSpawns = true;
+        SpawnerCreature spawner = new SpawnerCreature();
+        for (int t = 0; t < 20; ++t) {
+            spawner.a(world, true, false, false);
+        }
+        assertEquals("Player A must see all 70 mobs at distance 6 chunks (96 blocks) within auto r=8", 70, playerA.getLocalMobCount(EnumCreatureType.MONSTER));
+        assertEquals("Auto r=8 must completely block infinite-spawn exploit at 96 blocks", 0, world.spawnsNearA);
+
+        // Cross-border pack walk guard: Player B at (13, 0) has uncapped chunk (9, 0) (dist 9 from A, dist 4 from B).
+        // Chunk (8, 0) is dist 8 from A (capped at 70). A pack starting at (9, 0) walking into (8, 0) must NOT overflow Player A past 70!
+        addPlayer(world, 13, 0);
+        addSpawnableChunk(world, 9, 0, true);
+        addSpawnableChunk(world, 8, 0, true);
+        for (int t = 0; t < 100; ++t) {
+            spawner.a(world, true, false, false);
+        }
+        assertEquals("Cross-border pack walk must never overflow neighboring capped Player A past 70",
+                70, playerA.getLocalMobCount(EnumCreatureType.MONSTER));
+    }
