+    @Test
+    public void testTwoPlayerIsolationWhenEnabledVsGlobalStarvationWhenDisabled() throws Exception {
+        // 1. Default global mode (perPlayerMobSpawns = false): Player A's 100 monsters starve Player B
+        TestWorld globalWorld = newWorld(70);
+        addPlayer(globalWorld, 0, 0);
+        addPlayer(globalWorld, 100, 0);
+        Chunk chunkA = addSpawnableChunk(globalWorld, 0, 0, true);
+        addSpawnableChunk(globalWorld, 100, 0, true);
+        addMonsters(globalWorld, chunkA, 100);
+
+        MobSpawning.perPlayerMobSpawns = false;
+        SpawnerCreature spawner = new SpawnerCreature();
+        for (int t = 0; t < 50; ++t) {
+            spawner.a(globalWorld, true, false, false);
+        }
+        assertEquals("Global mode must starve Player B when global cap is filled by Player A", 0, globalWorld.spawnsNearB);
+
+        // 2. Per-player mode (perPlayerMobSpawns = true): Player A stays blocked at 70/70, Player B spawns freely up to 70!
+        TestWorld localWorld = newWorld(70);
+        EntityPlayer playerA = addPlayer(localWorld, 0, 0);
+        EntityPlayer playerB = addPlayer(localWorld, 100, 0);
+        Chunk localChunkA = addSpawnableChunk(localWorld, 0, 0, true);
+        addSpawnableChunk(localWorld, 100, 0, true);
+        addMonsters(localWorld, localChunkA, 70);
+
+        MobSpawning.perPlayerMobSpawns = true;
+        for (int t = 0; t < 150; ++t) {
+            spawner.a(localWorld, true, false, false);
+        }
+        assertEquals("Player A at 70/70 must receive 0 additional spawns", 0, localWorld.spawnsNearA);
+        assertTrue("Isolated Player B at 0/70 must receive spawns freely, got " + localWorld.spawnsNearB, localWorld.spawnsNearB > 0);
+        assertTrue("Player B must never exceed local cap of 70, got " + playerB.getLocalMobCount(EnumCreatureType.MONSTER),
+                playerB.getLocalMobCount(EnumCreatureType.MONSTER) <= 70);
+        assertEquals(70, playerA.getLocalMobCount(EnumCreatureType.MONSTER));
+    }
