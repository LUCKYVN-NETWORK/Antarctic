+            int pcz = this.localCapPlayerChunkZ.getInt(p);
+            for (int dx = -radius; dx <= radius; ++dx) {
+                int cx = pcx + dx;
+                for (int dz = -radius; dz <= radius; ++dz) {
+                    Chunk chunk = worldserver.getChunkIfLoaded(cx, pcz + dz);
+                    if (chunk != null) {
+                        int[] cc = chunk.antarcticCreatureCounts;
+                        counts[0] += cc[0];
+                        counts[1] += cc[1];
+                        counts[2] += cc[2];
