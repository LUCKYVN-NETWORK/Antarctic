+    static int resolvePerPlayerMobCountRadius(WorldServer worldserver) {
+        int configured = MobSpawning.perPlayerMobCountRadiusChunks;
+        if (configured > 0) {
+            return configured;
+        }
+        int spawnRange = Math.min(8, Math.min(worldserver.spigotConfig.mobSpawnRange, worldserver.spigotConfig.viewDistance));
+        int hardDespawnDistSq = worldserver.paperConfig != null ? worldserver.paperConfig.hardDespawnDistance : (128 * 128);
+        int despawnChunks = hardDespawnDistSq > 0 ? (int) Math.ceil(Math.sqrt((double) hardDespawnDistSq) / 16.0D) : 8;
+        return Math.max(1, Math.max(spawnRange, despawnChunks));
+    }
