+        setField(Chunk.class, chunk, "antarcticCreatureCounts", new int[EnumCreatureType.values().length]);
+        world.getChunkProviderServer().chunks.put(key, chunk);
+        chunk.addEntities();
+
+        PlayerChunk pc = (PlayerChunk) unsafe.allocateInstance(PlayerChunk.class);
+        setField(PlayerChunk.class, pc, "done", true);
+        ((FastPlayerChunkMap) world.getPlayerChunkMap()).map.put(LongHash.toLong(cx, cz), pc);
+        return chunk;
+    }
+
+    private static EntityPlayer addPlayer(TestWorld world, int cx, int cz) throws Exception {
+        EntityPlayer p = (EntityPlayer) unsafe.allocateInstance(EntityPlayer.class);
+        p.world = world;
+        p.locX = cx * 16.0 + 8.0;
+        p.locY = 64.0;
+        p.locZ = cz * 16.0 + 8.0;
+        p.affectsSpawning = true;
+        p.uniqueID = UUID.randomUUID();
+        p.antarcticLocalMobCounts = new int[EnumCreatureType.values().length];
+        PlayerInteractManager pim = (PlayerInteractManager) unsafe.allocateInstance(PlayerInteractManager.class);
+        setField(PlayerInteractManager.class, pim, "gamemode", EnumGamemode.SURVIVAL);
+        setField(EntityPlayer.class, p, "playerInteractManager", pim);
+        p.bukkitEntity = (CraftPlayer) unsafe.allocateInstance(CraftPlayer.class);
+        world.players.add(p);
+        return p;
+    }
+
+    private static void addMonsters(TestWorld world, Chunk chunk, int count) throws Exception {
+        for (int i = 0; i < count; ++i) {
+            EntityZombie z = (EntityZombie) unsafe.allocateInstance(EntityZombie.class);
+            setField(Entity.class, z, "id", nextEntityId++);
+            z.world = world;
+            z.locX = chunk.locX * 16.0 + 8.0;
+            z.locY = 10.0;
+            z.locZ = chunk.locZ * 16.0 + 8.0;
+            z.uniqueID = UUID.randomUUID();
+            z.persistent = false;
+            chunk.a(z);
+        }
+    }
