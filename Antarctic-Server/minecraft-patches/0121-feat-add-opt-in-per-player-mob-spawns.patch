+    @Test
+    public void testHighLoadPerPlayerTallyZeroAllocAndLowLatency() throws Exception {
+        TestWorld world = newWorld(70);
+        // 100 disjoint players, each with 1 chunk loaded at their position containing 70 monsters (so spawning short-circuits after tally)
+        for (int p = 0; p < 100; ++p) {
+            int cx = p * 25;
+            addPlayer(world, cx, 0);
+            Chunk c = addSpawnableChunk(world, cx, 0, false);
+            addMonsters(world, c, 70);
+        }
+
+        MobSpawning.perPlayerMobSpawns = true;
+        SpawnerCreature spawner = new SpawnerCreature();
+
+        // Warmup
+        for (int t = 0; t < 30; ++t) {
+            spawner.a(world, true, false, false);
+        }
+
+        com.sun.management.ThreadMXBean tmxb = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        int ticks = 100;
+
+        long alloc0 = tmxb.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int t = 0; t < ticks; ++t) {
+            spawner.a(world, true, false, false);
+        }
+        long ns = System.nanoTime() - t0;
+        long bytes = tmxb.getThreadAllocatedBytes(tid) - alloc0;
+
+        double msPerTick = (ns / 1e6) / ticks;
+        double kibPerTick = (bytes / 1024.0) / ticks;
+        System.out.printf("PerPlayerMobSpawnsTest (100p r=8 tally, %d ticks): %.3f ms/tick, %.2f KiB/tick%n",
+                ticks, msPerTick, kibPerTick);
+        assertTrue("Expected < 2.0 KiB/tick steady-state allocation, got " + kibPerTick, kibPerTick < 2.0);
+    }
