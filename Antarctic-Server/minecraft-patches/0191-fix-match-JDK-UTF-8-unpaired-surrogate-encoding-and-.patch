@@ -490,7 +490,7 @@ public class EntityTrackerEntry {
                     // Antarctic - send initial head rotation only to the joining viewer; only sync headYaw if this is the first viewer
                     if (livingTracker != null) {
                         int initialHeadYaw = MathHelper.d(livingTracker.getHeadRotation() * 256.0F / 360.0F);
-                        if (wasUntracked) {
