-    private static int utf8Length(String s) {
+    private static int measureUtf8(String s) {
         final int len = s.length();
         int bytes = 0;
+        boolean ascii = true;
         for (int i = 0; i < len; ++i) {
             char c = s.charAt(i);
             if (c < 0x80) {
