                         arr[off++] = (byte) (0x80 | ((cp >> 6) & 0x3F));
                         arr[off++] = (byte) (0x80 | (cp & 0x3F));
                     } else if (Character.isSurrogate(c)) {
-                        arr[off++] = (byte) 0xEF;
-                        arr[off++] = (byte) 0xBF;
-                        arr[off++] = (byte) 0xBD;
+                        arr[off++] = (byte) '?';
                     } else {
                         arr[off++] = (byte) (0xE0 | (c >> 12));
                         arr[off++] = (byte) (0x80 | ((c >> 6) & 0x3F));
@@ -407,7 +411,7 @@ public class PacketDataSerializer extends ByteBuf {
             buf.writerIndex(wIdx + utf8Len);
             return;
         }
-        if (utf8Len == len) {
+        if (ascii) {
             for (int i = 0; i < len; ++i) {
                 buf.writeByte(s.charAt(i));
             }
@@ -427,9 +431,7 @@ public class PacketDataSerializer extends ByteBuf {
                 buf.writeByte(0x80 | ((cp >> 6) & 0x3F));
                 buf.writeByte(0x80 | (cp & 0x3F));
             } else if (Character.isSurrogate(c)) {
-                buf.writeByte(0xEF);
-                buf.writeByte(0xBF);
-                buf.writeByte(0xBD);
+                buf.writeByte('?');
             } else {
                 buf.writeByte(0xE0 | (c >> 12));
                 buf.writeByte(0x80 | ((c >> 6) & 0x3F));
@@ -443,12 +445,14 @@ public class PacketDataSerializer extends ByteBuf {
         if (s.length() > 44767) {
             throw new EncoderException("String too big (was " + s.length() + " chars, max " + 44767 + ")");
         }
-        int utf8Len = utf8Length(s);
+        int measured = measureUtf8(s);
+        boolean ascii = measured >= 0;
+        int utf8Len = ascii ? measured : -measured - 1;
         if (utf8Len > 44767) { // Paper - raise limit a bit more as normal means can trigger this
             throw new EncoderException("String too big (was " + s.length() + " bytes encoded, max " + 44767 + ")"); // Paper
         } else {
             this.d(utf8Len);
-            writeUtf8Direct(this.a, s, utf8Len);
+            writeUtf8Direct(this.a, s, utf8Len, ascii);
