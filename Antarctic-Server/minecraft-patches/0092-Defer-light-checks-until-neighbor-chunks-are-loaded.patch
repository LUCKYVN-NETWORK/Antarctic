diff --git a/test/java/me/stella/antarctic/collection/PendingLightRegistryTest.java b/test/java/me/stella/antarctic/collection/PendingLightRegistryTest.java
new file mode 100644
index 0000000..9db4aa6
--- /dev/null
+++ b/test/java/me/stella/antarctic/collection/PendingLightRegistryTest.java
@@ -0,0 +1,155 @@
+package me.stella.antarctic.collection;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Test;
+
+public class PendingLightRegistryTest {
+
+    private static final PendingLightRegistry.Gate READY = key -> PendingLightRegistry.Gate.READY;
+
+    private static final class Recorder implements PendingLightRegistry.Visitor {
+        final List<long[]> seen = new ArrayList<long[]>();
+
+        @Override
+        public void accept(long chunkKey, int localX, int y, int localZ, boolean sky) {
+            seen.add(new long[] {chunkKey, localX, y, localZ, sky ? 1 : 0});
+        }
+    }
+
+    @Test
+    public void packRoundTripsEveryField() {
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                for (int y : new int[] {0, 1, 63, 127, 128, 254, 255}) {
+                    for (boolean sky : new boolean[] {false, true}) {
+                        int packed = PendingLightRegistry.pack(x, y, z, sky);
+                        assertEquals(x, PendingLightRegistry.unpackX(packed));
+                        assertEquals(z, PendingLightRegistry.unpackZ(packed));
+                        assertEquals(y, PendingLightRegistry.unpackY(packed));
+                        assertEquals(sky, PendingLightRegistry.unpackSky(packed));
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    public void negativeWorldCoordinatesPackToTheirChunkLocalValues() {
+        // -1 & 15 == 15, -16 & 15 == 0: the registry stores chunk-local data, callers pass `x & 15`
+        assertEquals(15, PendingLightRegistry.unpackX(PendingLightRegistry.pack(-1 & 15, 5, -1 & 15, false)));
+        assertEquals(0, PendingLightRegistry.unpackZ(PendingLightRegistry.pack(-16 & 15, 5, -16 & 15, true)));
+    }
+
+    @Test
+    public void duplicatesAreIgnoredAndTheCapDropsNewEntries() {
+        PendingLightRegistry registry = new PendingLightRegistry(3);
+        assertTrue(registry.add(1L, PendingLightRegistry.pack(1, 1, 1, true)));
+        assertFalse("duplicate", registry.add(1L, PendingLightRegistry.pack(1, 1, 1, true)));
+        assertTrue(registry.add(1L, PendingLightRegistry.pack(1, 1, 1, false)));
+        assertTrue(registry.add(2L, PendingLightRegistry.pack(1, 1, 1, true)));
+        assertFalse("cap reached", registry.add(2L, PendingLightRegistry.pack(2, 2, 2, true)));
+        assertEquals(3, registry.size());
+        assertEquals(1, registry.dropped());
+        assertEquals(2, registry.pendingChunks());
+    }
+
+    @Test
+    public void emptyRegistryDrainsNothing() {
+        PendingLightRegistry registry = new PendingLightRegistry(10);
+        assertEquals(0, registry.drain(100, READY, new Recorder()));
+        assertFalse(registry.hasPending(5L));
+        registry.markReady(5L); // no entries: must not queue anything
+        assertEquals(0, registry.drain(100, READY, new Recorder()));
+    }
+
+    @Test
+    public void drainRespectsTheBudgetAndCarriesTheRemainderOver() {
+        PendingLightRegistry registry = new PendingLightRegistry(1000);
+        for (int i = 0; i < 10; ++i) {
+            registry.add(7L, PendingLightRegistry.pack(i, 10, i, true));
+        }
+        registry.markReady(7L);
+        registry.markReady(7L); // idempotent
+        Recorder recorder = new Recorder();
+        assertEquals(4, registry.drain(4, READY, recorder));
+        assertEquals(6, registry.size());
+        assertEquals(4, registry.drain(4, READY, recorder));
+        assertEquals(2, registry.drain(4, READY, recorder));
+        assertEquals(0, registry.size());
+        assertEquals(0, registry.pendingChunks());
+        assertEquals(10, recorder.seen.size());
+        assertEquals(0, registry.drain(4, READY, recorder));
+    }
+
+    @Test
+    public void minimumOnePerChunkOrderIsOldestQueuedFirst() {
+        PendingLightRegistry registry = new PendingLightRegistry(100);
+        registry.add(10L, PendingLightRegistry.pack(0, 0, 0, true));
+        registry.add(20L, PendingLightRegistry.pack(0, 0, 0, true));
+        registry.markReady(20L);
+        registry.markReady(10L);
+        Recorder recorder = new Recorder();
+        registry.drain(10, READY, recorder);
+        assertEquals(20L, recorder.seen.get(0)[0]);
+        assertEquals(10L, recorder.seen.get(1)[0]);
+    }
+
+    @Test
+    public void waitingChunksKeepTheirEntriesAndGoneChunksLoseThem() {
+        PendingLightRegistry registry = new PendingLightRegistry(100);
+        registry.add(1L, PendingLightRegistry.pack(0, 0, 0, true));
+        registry.add(2L, PendingLightRegistry.pack(0, 0, 0, true));
+        registry.markReady(1L);
+        registry.markReady(2L);
+        Recorder recorder = new Recorder();
+        int replayed = registry.drain(10, key -> key == 1L ? PendingLightRegistry.Gate.WAIT : PendingLightRegistry.Gate.GONE, recorder);
+        assertEquals(0, replayed);
+        assertTrue("WAIT keeps the entries", registry.hasPending(1L));
+        assertFalse("GONE discards them", registry.hasPending(2L));
+        assertEquals(1, registry.size());
+        // After the next load event the waiting chunk can be queued again and replayed.
+        registry.markReady(1L);
+        assertEquals(1, registry.drain(10, READY, recorder));
+        assertEquals(0, registry.size());
+    }
+
+    @Test
+    public void clearChunkFixesTheTotalAndSurvivesStaleQueueEntries() {
+        PendingLightRegistry registry = new PendingLightRegistry(100);
+        registry.add(3L, PendingLightRegistry.pack(1, 1, 1, true));
+        registry.add(3L, PendingLightRegistry.pack(2, 2, 2, true));
+        registry.markReady(3L);
+        registry.clearChunk(3L);
+        assertEquals(0, registry.size());
+        assertFalse(registry.hasPending(3L));
+        // Re-add after clearing: the stale queue slot must not replay the new entry twice.
+        registry.add(3L, PendingLightRegistry.pack(5, 5, 5, false));
+        registry.markReady(3L);
+        Recorder recorder = new Recorder();
+        assertEquals(1, registry.drain(10, READY, recorder));
+        assertEquals(1, recorder.seen.size());
+        assertEquals(0, registry.size());
+    }
+
+    @Test
+    public void aVisitorThatRecordsNewEntriesCannotCorruptTheDrain() {
+        PendingLightRegistry registry = new PendingLightRegistry(100);
+        for (int i = 0; i < 5; ++i) {
+            registry.add(4L, PendingLightRegistry.pack(i, 0, 0, true));
+        }
+        registry.markReady(4L);
+        final int[] visits = {0};
+        int replayed = registry.drain(100, READY, (key, x, y, z, sky) -> {
+            ++visits[0];
+            registry.add(4L, PendingLightRegistry.pack(x, 1, 1, false)); // new entries for the same chunk
+        });
+        assertEquals(5, replayed);
+        assertEquals(5, visits[0]);
+        assertEquals("the new entries stay for a later drain", 5, registry.size());
+    }
+}
diff --git a/test/java/net/minecraft/server/DeferredLightPerfTest.java b/test/java/net/minecraft/server/DeferredLightPerfTest.java
new file mode 100644
index 0000000..c3833ef
--- /dev/null
+++ b/test/java/net/minecraft/server/DeferredLightPerfTest.java
@@ -0,0 +1,77 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.Lighting;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/** Cost of recording and replaying deferred light checks, and proof the toggle adds nothing to the normal path. */
+public class DeferredLightPerfTest {
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    @After
+    public void restore() {
+        Lighting.deferLightUpdates = true;
+    }
+
+    @Test
+    public void fullyLoadedPathIsUnaffectedByTheToggle() throws Exception {
+        long[] best = {Long.MAX_VALUE, Long.MAX_VALUE};
+        for (int round = 0; round < 12; ++round) { // alternate the modes so JIT warm-up and GC hit both equally
+            for (int mode = 0; mode < 2; ++mode) {
+                Lighting.deferLightUpdates = mode == 1;
+                WorldServer world = LightPropagationParityTest.buildWorld(21, new LightPropagationParityTest.StubProvider[1]);
+                long t0 = System.nanoTime();
+                for (int i = 0; i < 400; ++i) {
+                    BlockPosition pos = new BlockPosition(i % 20 - 10, 5 + i % 3, i / 20 - 10);
+                    LightPropagationParityTest.setBlock(world, pos.getX(), pos.getY(), pos.getZ(), i % 2 == 0 ? Blocks.TORCH.getBlockData() : Blocks.AIR.getBlockData());
+                    world.w(pos);
+                }
+                best[mode] = Math.min(best[mode], System.nanoTime() - t0);
+                assertEquals("neighbors are all loaded: nothing may be deferred", 0, world.pendingLight.size());
+            }
+        }
+        System.out.println("[perf] fully loaded relight (400 edits, best of 12): defer off=" + best[0] / 1000 + "us defer on=" + best[1] / 1000 + "us");
+        assertTrue("the toggle must not slow the normal path", best[1] < best[0] * 1.25 + 1_000_000);
+    }
+
+    @Test
+    public void replayCostPerTickBudget() throws Exception {
+        long recordNanos = Long.MAX_VALUE;
+        long replayNanos = Long.MAX_VALUE;
+        for (int round = 0; round < 5; ++round) {
+            WorldServer world = LightPropagationParityTest.buildWorld(22, new LightPropagationParityTest.StubProvider[1]);
+            LightPropagationParityTest.set(Chunk.class, world.getChunkIfLoaded(0, 0), "neighbors", 0x1 << 12);
+            // 2048 positions with a light-emitting block each = 4096 checks (sky + block), a worst-case-ish paste edge
+            long t0 = System.nanoTime();
+            for (int i = 0; i < 2048; ++i) {
+                BlockPosition pos = new BlockPosition(i % 16, 8 + i / 256, i / 16 % 16);
+                LightPropagationParityTest.setBlock(world, pos.getX(), pos.getY(), pos.getZ(), i % 7 == 0 ? Blocks.GLOWSTONE.getBlockData() : Blocks.STONE.getBlockData());
+                world.w(pos);
+            }
+            recordNanos = Math.min(recordNanos, System.nanoTime() - t0);
+            assertEquals(4096, world.pendingLight.size());
+            LightPropagationParityTest.set(Chunk.class, world.getChunkIfLoaded(0, 0), "neighbors", -1);
+            world.onChunkNeighborsLinked(world.getChunkIfLoaded(0, 0));
+            int budget = Lighting.deferredLightUpdatesPerTick;
+            t0 = System.nanoTime();
+            int replayed = world.drainDeferredLight(budget); // one tick's worth at the default budget
+            replayNanos = Math.min(replayNanos, System.nanoTime() - t0);
+            assertEquals(budget, replayed);
+            assertEquals(4096 - budget, world.pendingLight.size());
+            while (world.drainDeferredLight(budget) > 0) {
+                // the rest replays over the following ticks
+            }
+            assertEquals(0, world.pendingLight.size());
+        }
+        System.out.println("[perf] deferred light: recording 4096 checks=" + recordNanos / 1000 + "us, replaying one default budget (" + Lighting.deferredLightUpdatesPerTick + " checks)=" + replayNanos / 1000 + "us");
+        assertTrue("replaying one tick's budget should stay well under a tick (50 ms)", replayNanos < 50_000_000L);
+    }
+}
diff --git a/test/java/net/minecraft/server/DeferredLightUpdateTest.java b/test/java/net/minecraft/server/DeferredLightUpdateTest.java
new file mode 100644
index 0000000..4ff52df
--- /dev/null
+++ b/test/java/net/minecraft/server/DeferredLightUpdateTest.java
@@ -0,0 +1,166 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.Lighting;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/**
+ * Light checks vanilla drops at a partially loaded border are deferred and replayed once the neighbors load; the replay
+ * must leave exactly the light an immediate update on a fully loaded world would have left.
+ */
+public class DeferredLightUpdateTest {
+
+    private static final int ONLY_SELF = 0x1 << 12;
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    @After
+    public void restoreConfig() {
+        Lighting.deferLightUpdates = true;
+        Lighting.deferredLightUpdatesPerTick = 1024;
+    }
+
+    private static void setNeighbors(WorldServer world, int cx, int cz, int mask) throws Exception {
+        LightPropagationParityTest.set(Chunk.class, world.getChunkIfLoaded(cx, cz), "neighbors", mask);
+    }
+
+    @Test
+    public void defaultsAreSafe() {
+        assertTrue("deferral restores light vanilla loses; documented as an intentional deviation", Lighting.deferLightUpdates);
+        assertEquals(1024, Lighting.deferredLightUpdatesPerTick);
+        assertEquals(262144, Lighting.deferredLightMaxEntries);
+    }
+
+    /**
+     * Vanilla's incremental light algorithm is path dependent: relighting after each block change gives a different result
+     * than placing every block first and relighting afterwards (the second source's own propagation is cut off, because
+     * the first source's search has already raised its cell and the radius-17 limit is measured from the first source).
+     * That is a vanilla property, measured here, and the likely reason bulk pastes light incorrectly.
+     */
+    @Test
+    public void vanillaRelightingIsPathDependent() throws Exception {
+        BlockPosition[] torches = {new BlockPosition(5, 10, 5), new BlockPosition(3, 12, 9), new BlockPosition(12, 9, 2)};
+        WorldServer sequential = LightPropagationParityTest.buildWorld(11, new LightPropagationParityTest.StubProvider[1]);
+        WorldServer batched = LightPropagationParityTest.buildWorld(11, new LightPropagationParityTest.StubProvider[1]);
+        for (BlockPosition p : torches) {
+            LightPropagationParityTest.setBlock(sequential, p.getX(), p.getY(), p.getZ(), Blocks.TORCH.getBlockData());
+            sequential.w(p);
+            LightPropagationParityTest.setBlock(batched, p.getX(), p.getY(), p.getZ(), Blocks.TORCH.getBlockData());
+        }
+        for (BlockPosition p : torches) {
+            batched.w(p);
+        }
+        int differing = 0;
+        for (int x = -32; x < 32; ++x) {
+            for (int z = -32; z < 32; ++z) {
+                for (int y = 0; y < 40; ++y) {
+                    if (sequential.getBrightness(EnumSkyBlock.BLOCK, x, y, z) != batched.getBrightness(EnumSkyBlock.BLOCK, x, y, z)) {
+                        ++differing;
+                    }
+                }
+            }
+        }
+        assertTrue("expected the vanilla algorithm to be path dependent, differing cells: " + differing, differing > 0);
+    }
+
+    @Test
+    public void deferredChecksReplayAsIfRunAfterAllBlockChanges() throws Exception {
+        LightPropagationParityTest.StubProvider[] hd = new LightPropagationParityTest.StubProvider[1];
+        LightPropagationParityTest.StubProvider[] hr = new LightPropagationParityTest.StubProvider[1];
+        WorldServer deferred = LightPropagationParityTest.buildWorld(11, hd);
+        WorldServer reference = LightPropagationParityTest.buildWorld(11, hr);
+
+        // The deferred world's chunk (0,0) only knows about itself, so vanilla drops the checks. The reference world gets the
+        // same block changes and runs the same checks in the same order, but after all of the changes, with every neighbor loaded.
+        setNeighbors(deferred, 0, 0, ONLY_SELF);
+        BlockPosition[] torches = {new BlockPosition(5, 10, 5), new BlockPosition(3, 12, 9), new BlockPosition(12, 9, 2)};
+        for (BlockPosition pos : torches) {
+            LightPropagationParityTest.setBlock(deferred, pos.getX(), pos.getY(), pos.getZ(), Blocks.TORCH.getBlockData());
+            LightPropagationParityTest.setBlock(reference, pos.getX(), pos.getY(), pos.getZ(), Blocks.TORCH.getBlockData());
+            assertFalse("vanilla result is unchanged: the check returns false", deferred.w(pos));
+        }
+        for (BlockPosition pos : torches) {
+            assertTrue(reference.w(pos));
+        }
+        assertEquals("one sky and one block check per torch", 6, deferred.pendingLight.size());
+        assertEquals("nothing replays before the neighbors are linked", 0, deferred.drainDeferredLight(100));
+        assertEquals(0, deferred.getBrightness(EnumSkyBlock.BLOCK, 5, 10, 5));
+
+        setNeighbors(deferred, 0, 0, -1); // all neighbors now loaded
+        deferred.onChunkNeighborsLinked(deferred.getChunkIfLoaded(0, 0));
+        assertEquals(6, deferred.drainDeferredLight(100));
+        assertEquals(0, deferred.pendingLight.size());
+        LightPropagationParityTest.assertSameLight(reference, deferred, "replay");
+        assertEquals(14, deferred.getBrightness(EnumSkyBlock.BLOCK, 5, 10, 5));
+    }
+
+    @Test
+    public void replayIsBudgetedPerTick() throws Exception {
+        LightPropagationParityTest.StubProvider[] hd = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = LightPropagationParityTest.buildWorld(12, hd);
+        setNeighbors(world, 0, 0, ONLY_SELF);
+        for (int i = 0; i < 10; ++i) {
+            BlockPosition pos = new BlockPosition(i, 10, 3);
+            LightPropagationParityTest.setBlock(world, pos.getX(), pos.getY(), pos.getZ(), Blocks.TORCH.getBlockData());
+            world.w(pos);
+        }
+        assertEquals(20, world.pendingLight.size());
+        setNeighbors(world, 0, 0, -1);
+        world.onChunkNeighborsLinked(world.getChunkIfLoaded(0, 0));
+        assertEquals(8, world.drainDeferredLight(8));
+        assertEquals(12, world.pendingLight.size());
+        assertEquals(8, world.drainDeferredLight(8));
+        assertEquals(4, world.drainDeferredLight(8));
+        assertEquals(0, world.pendingLight.size());
+    }
+
+    @Test
+    public void toggleOffKeepsVanillaBehavior() throws Exception {
+        LightPropagationParityTest.StubProvider[] hd = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = LightPropagationParityTest.buildWorld(13, hd);
+        setNeighbors(world, 0, 0, ONLY_SELF);
+        Lighting.deferLightUpdates = false;
+        BlockPosition pos = new BlockPosition(5, 10, 5);
+        LightPropagationParityTest.setBlock(world, 5, 10, 5, Blocks.TORCH.getBlockData());
+        assertFalse(world.w(pos));
+        assertEquals("nothing is remembered with the toggle off", 0, world.pendingLight.size());
+        setNeighbors(world, 0, 0, -1);
+        world.onChunkNeighborsLinked(world.getChunkIfLoaded(0, 0));
+        assertEquals(0, world.drainDeferredLight(100));
+        assertEquals("the light stays as vanilla left it", 0, world.getBrightness(EnumSkyBlock.BLOCK, 5, 10, 5));
+    }
+
+    @Test
+    public void unloadedCenterChunkIsNotRecordedAndUnloadClearsEntries() throws Exception {
+        LightPropagationParityTest.StubProvider[] hd = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = LightPropagationParityTest.buildWorld(14, hd);
+        // A check whose own chunk is not loaded is dropped (the chunk's load path lights it); nothing is recorded.
+        assertFalse(world.c(EnumSkyBlock.BLOCK, new BlockPosition(500, 10, 500)));
+        assertEquals(0, world.pendingLight.size());
+        // An unload clears the chunk's entries.
+        setNeighbors(world, 0, 0, ONLY_SELF);
+        LightPropagationParityTest.setBlock(world, 5, 10, 5, Blocks.TORCH.getBlockData());
+        world.w(new BlockPosition(5, 10, 5));
+        assertTrue(world.pendingLight.size() > 0);
+        world.pendingLight.clearChunk(world.getChunkIfLoaded(0, 0).chunkKey);
+        assertEquals(0, world.pendingLight.size());
+    }
+
+    @Test
+    public void outOfRangeYIsNeverRecorded() throws Exception {
+        LightPropagationParityTest.StubProvider[] hd = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = LightPropagationParityTest.buildWorld(15, hd);
+        setNeighbors(world, 0, 0, ONLY_SELF);
+        world.c(EnumSkyBlock.BLOCK, new BlockPosition(1, -1, 1));
+        world.c(EnumSkyBlock.BLOCK, new BlockPosition(1, 256, 1));
+        assertEquals(0, world.pendingLight.size());
+    }
+}
