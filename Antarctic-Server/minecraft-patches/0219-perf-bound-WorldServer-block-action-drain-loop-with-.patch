+    @Test
+    public void testVanillaParityWhenDisabled() throws Exception {
+        RedstoneGuard.enabled = false;
+        RecordingBlock block = new RecordingBlock();
+        TestWorldServer world = newTestWorld(block.getBlockData());
+
+        for (int i = 0; i < 10; i++) {
+            world.playBlockAction(new BlockPosition(i, 64, 0), block, 0, i);
+        }
+        world.drainBlockActions();
+
+        assertEquals(10, block.executedIds.size());
+        for (int i = 0; i < 10; i++) {
+            assertEquals(Integer.valueOf(i), block.executedIds.get(i));
+        }
+        assertEquals(10, world.mockPlayerList.sentPackets.size());
+    }
+
+    @Test
+    public void testIntraTickPingPongBoundedAndDeferred() throws Exception {
+        RedstoneGuard.enabled = true;
+        RedstoneGuard.maxBlockActionsPerTick = 50;
+        RedstoneGuard.maxBlockActionsPerChunkPerTick = 1000;
+
+        RecordingBlock block = new RecordingBlock();
+        block.pingPongRemaining = 120;
+        TestWorldServer world = newTestWorld(block.getBlockData());
+
+        world.playBlockAction(new BlockPosition(0, 64, 0), block, 0, 0);
+        world.drainBlockActions();
+        assertEquals(50, block.executedIds.size());
+
+        world.drainBlockActions();
+        assertEquals(100, block.executedIds.size());
+
+        world.drainBlockActions();
+        assertEquals(121, block.executedIds.size());
+    }
+
+    @Test
+    public void testPerChunkFairnessAndNextTickFifoCompletion() throws Exception {
+        RedstoneGuard.enabled = true;
+        RedstoneGuard.maxBlockActionsPerTick = 100;
+        RedstoneGuard.maxBlockActionsPerChunkPerTick = 4;
+
+        RecordingBlock block = new RecordingBlock();
+        TestWorldServer world = newTestWorld(block.getBlockData());
+
+        // 20 actions in chunk (0, 0), 4 actions in chunk (1, 0)
+        for (int i = 0; i < 20; i++) {
+            world.playBlockAction(new BlockPosition(i & 15, 64 + (i >> 4), 0), block, 0, i);
+        }
+        for (int i = 0; i < 4; i++) {
+            world.playBlockAction(new BlockPosition(16 + i, 64, 0), block, 0, 100 + i);
+        }
+
+        // Tick 1: 4 from chunk A + all 4 from chunk B
+        world.drainBlockActions();
+        assertEquals(8, block.executedIds.size());
+        assertEquals(List.of(0, 1, 2, 3, 100, 101, 102, 103), block.executedIds);
+
+        // Drain remaining 16 actions from chunk A across 4 more ticks in strict FIFO order
+        for (int t = 0; t < 4; t++) {
+            world.drainBlockActions();
+        }
+        assertEquals(24, block.executedIds.size());
+        for (int i = 4; i < 20; i++) {
+            assertEquals(Integer.valueOf(i), block.executedIds.get(4 + i));
+        }
+    }
+
+    @Test
+    public void testNoteBlockBacklogCapNeverDropsPistons() throws Exception {
+        RedstoneGuard.enabled = true;
+        RedstoneGuard.maxBlockActionsPerTick = 10;
+        RedstoneGuard.maxBlockActionsPerChunkPerTick = 10;
+        RedstoneGuard.maxNoteBlockDeferredPerChunk = 32;
+
+        RecordingBlock pistonLike = new RecordingBlock();
+        TestWorldServer world = newTestWorld(pistonLike.getBlockData());
+
+        for (int i = 0; i < 200; i++) {
+            world.playBlockAction(new BlockPosition(i & 15, 64 + (i >> 4), 0), Blocks.NOTEBLOCK, 0, i % 25);
+        }
+        for (int i = 0; i < 15; i++) {
+            world.playBlockAction(new BlockPosition(i, 80, 0), pistonLike, 0, i);
+        }
+
+        Field uField = WorldServer.class.getDeclaredField("U");
+        uField.setAccessible(true);
+        Field vField = WorldServer.class.getDeclaredField("V");
+        vField.setAccessible(true);
+        ObjectLinkedOpenHashSet<?>[] queues = (ObjectLinkedOpenHashSet<?>[]) uField.get(world);
+        int activeIdx = vField.getInt(world);
+        // 32 note blocks capped + 15 piston-like actions preserved = 47 total queued
+        assertEquals(47, queues[activeIdx].size());
+
+        for (int t = 0; t < 6; t++) {
+            world.drainBlockActions();
+        }
+        assertEquals(15, pistonLike.executedIds.size());
+    }
