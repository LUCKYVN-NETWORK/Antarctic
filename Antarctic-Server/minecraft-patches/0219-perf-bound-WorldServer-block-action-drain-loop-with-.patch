+
+        RecordingBlock() {
+            super(Material.STONE);
+        }
+
+        @Override
+        public boolean a(IBlockData iblockdata, World world, BlockPosition pos, int id, int param) {
+            executedIds.add(param);
+            if (pingPongRemaining > 0) {
+                pingPongRemaining--;
+                world.playBlockAction(pos.up(), this, id, param + 1);
+            }
+            return true;
+        }
+    }
+
+    private static final class MockPlayerList extends PlayerList {
