+import static org.junit.Assert.*;
+
+public class BlockActionGuardTest {
+
+    private static Unsafe UNSAFE;
+
+    private boolean prevEnabled = RedstoneGuard.enabled;
+    private int prevMaxTotal = RedstoneGuard.maxBlockActionsPerTick;
+    private int prevMaxPerChunk = RedstoneGuard.maxBlockActionsPerChunkPerTick;
+    private int prevMaxNoteDeferred = RedstoneGuard.maxNoteBlockDeferredPerChunk;
+
+    @BeforeClass
+    public static void init() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+    }
+
+    @After
+    public void restoreConfig() {
+        RedstoneGuard.enabled = prevEnabled;
+        RedstoneGuard.maxBlockActionsPerTick = prevMaxTotal;
+        RedstoneGuard.maxBlockActionsPerChunkPerTick = prevMaxPerChunk;
+        RedstoneGuard.maxNoteBlockDeferredPerChunk = prevMaxNoteDeferred;
+    }
+
+    private static final class RecordingBlock extends Block {
+        final List<Integer> executedIds = new ArrayList<>();
