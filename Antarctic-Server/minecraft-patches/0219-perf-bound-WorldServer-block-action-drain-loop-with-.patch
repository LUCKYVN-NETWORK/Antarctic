+package com.destroystokyo.paper.config.toml.modules.optimizations;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+
+public class RedstoneGuard implements IConfigModule {
+
+    @ConfigInfo(
+        baseName = "enabled",
+        comments = "Enable bounded block-action draining and per-chunk redstone lag-machine guardrails. Default false preserves exact vanilla 1.12.2 behavior."
+    )
+    public static boolean enabled = false;
+
+    @ConfigInfo(
+        baseName = "max-block-actions-per-tick",
+        comments = "Maximum block actions (pistons, note blocks, chests) executed per world per tick before deferring excess to the next tick. Default 4096."
+    )
+    public static int maxBlockActionsPerTick = 4096;
+
+    @ConfigInfo(
+        baseName = "max-block-actions-per-chunk-per-tick",
+        comments = "Maximum block actions executed per chunk per tick before deferring that chunk's remaining actions to the next tick. Default 256."
+    )
+    public static int maxBlockActionsPerChunkPerTick = 256;
+
+    @ConfigInfo(
+        baseName = "max-noteblock-deferred-per-chunk",
+        comments = "Maximum deferred NoteBlock actions queued per chunk before dropping redundant NoteBlock backlog overflow (never drops pistons). Default 1024."
+    )
+    public static int maxNoteBlockDeferredPerChunk = 1024;
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.OPTIMIZATIONS;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "redstone-guard";
+    }
+
+    @Override
+    public void onLoaded(CommentedFileConfig config) {
+        maxBlockActionsPerTick = Math.max(1, maxBlockActionsPerTick);
+        maxBlockActionsPerChunkPerTick = Math.max(1, maxBlockActionsPerChunkPerTick);
+        maxNoteBlockDeferredPerChunk = Math.max(0, maxNoteBlockDeferredPerChunk);
+    }
+}
