+package net.minecraft.server;
+
+import com.sun.management.ThreadMXBean;
+import java.lang.management.ManagementFactory;
+import java.lang.reflect.Field;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class WorldFluidSweepOptimizationTest {
+
+    private static Unsafe UNSAFE;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        LightPropagationParityTest.bootstrap();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+    }
+
+    @Test
+    public void testChunkSectionFluidAndFireOrLavaCounters() {
+        ChunkSection sec = new ChunkSection(64, true);
+        Assert.assertFalse(sec.hasFluids());
+        Assert.assertFalse(sec.hasFireOrLava());
+
+        sec.setType(1, 2, 3, Blocks.WATER.getBlockData());
+        Assert.assertTrue(sec.hasFluids());
+        Assert.assertFalse(sec.hasFireOrLava());
+
+        sec.setType(1, 2, 3, Blocks.FIRE.getBlockData());
+        Assert.assertFalse(sec.hasFluids());
+        Assert.assertTrue(sec.hasFireOrLava());
+
+        sec.setType(4, 5, 6, Blocks.FLOWING_LAVA.getBlockData());
+        Assert.assertTrue(sec.hasFluids());
+        Assert.assertTrue(sec.hasFireOrLava());
+
+        sec.setType(1, 2, 3, Blocks.STONE.getBlockData());
+        Assert.assertTrue(sec.hasFluids());
+        Assert.assertTrue(sec.hasFireOrLava());
+
+        sec.setType(4, 5, 6, Blocks.AIR.getBlockData());
+        Assert.assertFalse(sec.hasFluids());
+        Assert.assertFalse(sec.hasFireOrLava());
+
+        // Verify recalcBlockCounts() rebuilds both counters identically
+        sec.setType(0, 0, 0, Blocks.LAVA.getBlockData());
+        sec.recalcBlockCounts();
+        Assert.assertTrue(sec.hasFluids());
+        Assert.assertTrue(sec.hasFireOrLava());
+
+        sec.setType(0, 0, 0, Blocks.AIR.getBlockData());
+        sec.recalcBlockCounts();
+        Assert.assertFalse(sec.hasFluids());
+        Assert.assertFalse(sec.hasFireOrLava());
+    }
+
+    @Test
+    public void testFluidAndFireSweepParityAcrossSectionsAndEdgeCases() throws Exception {
+        WorldServer world = LightPropagationParityTest.buildWorld(2, new LightPropagationParityTest.StubProvider[1]);
+        // Fill solid ground at y=63 so section 3 (y=48..63) and section 4 (y=64..79) are populated dry sections
+        for (int x = -2; x <= 18; ++x) {
+            for (int z = -2; z <= 18; ++z) {
+                LightPropagationParityTest.setBlock(world, x, 63, z, Blocks.STONE.getBlockData());
+            }
+        }
+        LightPropagationParityTest.setBlock(world, 0, 64, 0, Blocks.TORCH.getBlockData()); // non-empty dry section 4
+
+        AxisAlignedBB dryBox = new AxisAlignedBB(2.0D, 64.0D, 2.0D, 2.6D, 65.8D, 2.6D);
+        Assert.assertFalse(world.containsLiquid(dryBox));
+        Assert.assertFalse(world.e(dryBox));
+        Assert.assertFalse(world.a(dryBox, Material.LAVA));
+        Assert.assertTrue(world.a(dryBox.b(0.0D, -1.0D, 0.0D), Material.STONE)); // non-liquid fallback
+
+        EntityZombie entity = (EntityZombie) UNSAFE.allocateInstance(EntityZombie.class);
+        entity.world = world;
+        Assert.assertFalse(world.a(dryBox, Material.WATER, entity));
+        Assert.assertEquals(0.0D, entity.motX, 0.0D);
+        Assert.assertEquals(0.0D, entity.motY, 0.0D);
+        Assert.assertEquals(0.0D, entity.motZ, 0.0D);
+
+        // Place fire at (2, 64, 2) -> e(AABB) must detect it, liquid checks must stay false
+        LightPropagationParityTest.setBlock(world, 2, 64, 2, Blocks.FIRE.getBlockData());
+        Assert.assertTrue(world.e(dryBox));
+        Assert.assertFalse(world.containsLiquid(dryBox));
+        Assert.assertFalse(world.a(dryBox, Material.LAVA));
+
+        // Replace with lava -> all of containsLiquid, e(AABB), a(AABB, LAVA) must detect it
+        LightPropagationParityTest.setBlock(world, 2, 64, 2, Blocks.LAVA.getBlockData());
+        Assert.assertTrue(world.e(dryBox));
+        Assert.assertTrue(world.containsLiquid(dryBox));
+        Assert.assertTrue(world.a(dryBox, Material.LAVA));
+        Assert.assertFalse(world.a(dryBox, Material.WATER, entity));
+
+        // Remove lava -> back to dry
+        LightPropagationParityTest.setBlock(world, 2, 64, 2, Blocks.AIR.getBlockData());
+        Assert.assertFalse(world.e(dryBox));
+        Assert.assertFalse(world.containsLiquid(dryBox));
+        Assert.assertFalse(world.a(dryBox, Material.LAVA));
+
+        // Place flowing water slope across chunk boundary (x=15 -> x=16) and verify exact push vector parity
+        LightPropagationParityTest.setBlock(world, 15, 64, 5, Blocks.FLOWING_WATER.getBlockData().set(BlockFluids.LEVEL, 1));
+        LightPropagationParityTest.setBlock(world, 16, 64, 5, Blocks.FLOWING_WATER.getBlockData().set(BlockFluids.LEVEL, 2));
+        AxisAlignedBB crossChunkBox = new AxisAlignedBB(15.2D, 64.0D, 5.2D, 16.5D, 65.5D, 5.8D);
+
+        EntityZombie eOpt = (EntityZombie) UNSAFE.allocateInstance(EntityZombie.class);
+        eOpt.world = world;
+        EntityZombie eRef = (EntityZombie) UNSAFE.allocateInstance(EntityZombie.class);
+        eRef.world = world;
+
+        boolean optInWater = world.a(crossChunkBox, Material.WATER, eOpt);
+        boolean refInWater = referenceHandleMaterialAcceleration(world, crossChunkBox, Material.WATER, eRef);
+        Assert.assertEquals(refInWater, optInWater);
+        Assert.assertTrue(optInWater);
+        Assert.assertEquals("motX must match vanilla bit-for-bit", Double.doubleToLongBits(eRef.motX), Double.doubleToLongBits(eOpt.motX));
+        Assert.assertEquals("motY must match vanilla bit-for-bit", Double.doubleToLongBits(eRef.motY), Double.doubleToLongBits(eOpt.motY));
+        Assert.assertEquals("motZ must match vanilla bit-for-bit", Double.doubleToLongBits(eRef.motZ), Double.doubleToLongBits(eOpt.motZ));
+
+        // Out-of-Y-bounds safety
+        Assert.assertFalse(world.containsLiquid(new AxisAlignedBB(0, -10, 0, 1, -5, 1)));
+        Assert.assertFalse(world.e(new AxisAlignedBB(0, 260, 0, 1, 265, 1)));
+        Assert.assertFalse(world.a(new AxisAlignedBB(0, -10, 0, 1, -5, 1), Material.LAVA));
+    }
+
+    @Test
+    public void testDrySectionSweepSpeedupAndZeroAllocation() throws Exception {
+        WorldServer world = LightPropagationParityTest.buildWorld(1, new LightPropagationParityTest.StubProvider[1]);
+        // Populated non-empty dry section (e.g. a house/base full of stone/wood/air, no water/fire)
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                LightPropagationParityTest.setBlock(world, x, 64, z, Blocks.STONE.getBlockData());
+            }
+        }
+
+        AxisAlignedBB box = new AxisAlignedBB(4.2D, 65.0D, 4.2D, 4.8D, 66.8D, 4.8D);
+        EntityZombie entity = (EntityZombie) UNSAFE.allocateInstance(EntityZombie.class);
+        entity.world = world;
+
+        final int warmup = 20_000;
+        final int measured = 200_000;
+        long sink = 0;
+
+        for (int i = 0; i < warmup; ++i) {
+            if (referenceAllSweeps(world, box, entity)) sink++;
+            if (optimizedAllSweeps(world, box, entity)) sink++;
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        long a0 = bean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            if (referenceAllSweeps(world, box, entity)) sink++;
+        }
+        long baseNs = System.nanoTime() - t0;
+        long baseAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a0);
+
+        long a1 = bean.getThreadAllocatedBytes(tid);
+        long t1 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            if (optimizedAllSweeps(world, box, entity)) sink++;
+        }
+        long optNs = System.nanoTime() - t1;
+        long optAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a1);
+
+        System.out.printf(
