diff --git a/test/java/net/minecraft/server/ShapelessRecipesBitmaskTest.java b/test/java/net/minecraft/server/ShapelessRecipesBitmaskTest.java
new file mode 100644
index 0000000..732e4d7
--- /dev/null
+++ b/test/java/net/minecraft/server/ShapelessRecipesBitmaskTest.java
@@ -0,0 +1,140 @@
+package net.minecraft.server;
+
+import com.google.common.collect.Lists;
+import com.sun.management.ThreadMXBean;
+import java.lang.management.ManagementFactory;
+import java.util.List;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+public class ShapelessRecipesBitmaskTest {
+
+    @BeforeClass
+    public static void setup() {
+        DispenserRegistry.c();
+    }
+
+    private static InventoryCrafting newGrid(ItemStack... slots) {
+        Container dummy = new Container() {
+            @Override
+            public boolean canUse(EntityHuman entityhuman) {
+                return true;
+            }
+
+            @Override
+            public void a(IInventory iinventory) {
+            }
+
+            @Override
+            public org.bukkit.inventory.InventoryView getBukkitView() {
+                return null;
+            }
+        };
+        InventoryCrafting grid = new InventoryCrafting(dummy, 3, 3);
+        for (int i = 0; i < slots.length; ++i) {
+            grid.setItem(i, slots[i]);
+        }
+        return grid;
+    }
+
+    @Test
+    public void testMatchingParityForExactPermutationsDuplicatesAndMismatches() {
+        NonNullList<RecipeItemStack> ingredients = NonNullList.a();
+        ingredients.add(RecipeItemStack.a(new Item[] { Items.SUGAR }));
+        ingredients.add(RecipeItemStack.a(new Item[] { Items.EGG }));
+        ingredients.add(RecipeItemStack.a(new Item[] { Items.SUGAR }));
+        ingredients.add(RecipeItemStack.a(new Item[] { Items.WHEAT }));
+
+        ShapelessRecipes recipe = new ShapelessRecipes("", new ItemStack(Items.CAKE), ingredients);
+
+        // Exact match in scrambled grid slots
+        InventoryCrafting match = newGrid(
+                ItemStack.a, new ItemStack(Items.WHEAT), ItemStack.a,
+                new ItemStack(Items.SUGAR), ItemStack.a, new ItemStack(Items.EGG),
+                ItemStack.a, new ItemStack(Items.SUGAR), ItemStack.a);
+        Assert.assertTrue(recipe.a(match, null));
+
+        // Missing duplicate ingredient (only 1 sugar instead of 2)
+        InventoryCrafting missingDup = newGrid(
+                new ItemStack(Items.WHEAT), new ItemStack(Items.SUGAR), new ItemStack(Items.EGG));
+        Assert.assertFalse(recipe.a(missingDup, null));
+
+        // Extra unexpected item
+        InventoryCrafting extra = newGrid(
+                new ItemStack(Items.WHEAT), new ItemStack(Items.SUGAR), new ItemStack(Items.SUGAR),
+                new ItemStack(Items.EGG), new ItemStack(Items.STICK));
+        Assert.assertFalse(recipe.a(extra, null));
+
+        // Empty grid
+        Assert.assertFalse(recipe.a(newGrid(), null));
+    }
+
+    @Test
+    public void testZeroAllocationAndThroughputGainOverListCopyBaseline() {
+        NonNullList<RecipeItemStack> ingredients = NonNullList.a();
+        ingredients.add(RecipeItemStack.a(new Item[] { Items.SUGAR }));
+        ingredients.add(RecipeItemStack.a(new Item[] { Items.EGG }));
+        ingredients.add(RecipeItemStack.a(new Item[] { Items.WHEAT }));
+        ingredients.add(RecipeItemStack.a(new Item[] { Items.COAL }));
+
+        ShapelessRecipes recipe = new ShapelessRecipes("", new ItemStack(Items.CAKE), ingredients);
+        InventoryCrafting matchGrid = newGrid(
+                new ItemStack(Items.COAL), ItemStack.a, new ItemStack(Items.SUGAR),
+                ItemStack.a, new ItemStack(Items.WHEAT), ItemStack.a,
+                new ItemStack(Items.EGG));
+        InventoryCrafting missGrid = newGrid(new ItemStack(Items.STICK));
+
+        final int warmup = 50_000;
+        final int iters = 300_000;
+        int sink = 0;
+        for (int i = 0; i < warmup; ++i) {
+            if (recipe.a((i & 1) == 0 ? matchGrid : missGrid, null)) sink++;
+            if (baselineMatch(ingredients, (i & 1) == 0 ? matchGrid : missGrid)) sink++;
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        long baseAllocBefore = bean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            if (baselineMatch(ingredients, (i & 1) == 0 ? matchGrid : missGrid)) sink++;
+        }
+        long baseNs = System.nanoTime() - t0;
+        long baseAlloc = bean.getThreadAllocatedBytes(tid) - baseAllocBefore;
+
+        long optAllocBefore = bean.getThreadAllocatedBytes(tid);
+        long t1 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            if (recipe.a((i & 1) == 0 ? matchGrid : missGrid, null)) sink++;
+        }
+        long optNs = System.nanoTime() - t1;
+        long optAlloc = bean.getThreadAllocatedBytes(tid) - optAllocBefore;
+
+        double speedup = (double) baseNs / (double) Math.max(1L, optNs);
+        System.out.printf("[perf] ShapelessRecipes.a (%d ops): baseline=%.2f ms (alloc=%.2f MB) vs bitmask=%.2f ms (alloc=%d B), speedup=%.1fx (sink=%d)%n",
+                iters, baseNs / 1e6, baseAlloc / (1024.0 * 1024.0), optNs / 1e6, optAlloc, speedup, sink);
+
+        Assert.assertEquals("Bitmask ShapelessRecipes.a must allocate 0 bytes", 0L, optAlloc);
+        Assert.assertTrue("Baseline should have allocated significantly (> 1 MB)", baseAlloc > 1_000_000L);
+        Assert.assertTrue("Bitmask matching must be faster than baseline list copy (got " + speedup + "x)", optNs < baseNs);
+    }
+
+    private static boolean baselineMatch(NonNullList<RecipeItemStack> src, InventoryCrafting inv) {
+        List<RecipeItemStack> list = Lists.newArrayList(src.toArray(new RecipeItemStack[0]));
+        outer: for (int index = 0; index < inv.getSize(); index++) {
+            ItemStack itemStack = inv.getItem(index);
+            if (!itemStack.isEmpty()) {
+                for (int i = 0; i < list.size(); i++) {
+                    if (list.get(i).a(itemStack)) {
+                        list.remove(i);
+                        continue outer;
+                    }
+                }
+                return false;
+            }
+        }
+        return list.isEmpty();
+    }
+}
