+package net.minecraft.server;
+
+import com.destroystokyo.paper.PaperWorldConfig;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.ListIterator;
+import java.util.Map;
+import java.util.Random;
+import java.util.Set;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import org.spigotmc.SpigotWorldConfig;
+import sun.misc.Unsafe;
+
+public class TileTickListAndChunkRelightParityTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void init() throws Exception {
+        DispenserRegistry.c();
+        org.spigotmc.AsyncCatcher.enabled = false;
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    private static final class DummyTileEntity extends TileEntity {
+    }
+
+    @Test
+    public void testTickableTileEntityListMaintainsFlagAcrossAllMutators() {
+        World.TickableTileEntityList list = new World.TickableTileEntityList();
+        TileEntity a = new DummyTileEntity();
+        TileEntity b = new DummyTileEntity();
+        TileEntity c = new DummyTileEntity();
+        TileEntity d = new DummyTileEntity();
+
+        // removeAll
+        list.add(a);
+        list.add(b);
+        Assert.assertTrue(list.removeAll(Collections.singletonList(a)));
+        Assert.assertFalse(a.antarcticInTickList);
+        Assert.assertTrue(b.antarcticInTickList);
+        Assert.assertTrue(list.add(a));
+
+        // retainAll
+        Assert.assertTrue(list.retainAll(Collections.singletonList(a)));
+        Assert.assertFalse(b.antarcticInTickList);
+        Assert.assertTrue(a.antarcticInTickList);
+
+        // removeIf
+        list.add(b);
+        Assert.assertTrue(list.removeIf(te -> te == b));
+        Assert.assertFalse(b.antarcticInTickList);
+        Assert.assertTrue(list.add(b));
+
+        // subList().clear() -> removeRange
+        list.add(c);
+        list.subList(1, 3).clear();
+        Assert.assertFalse(b.antarcticInTickList);
+        Assert.assertFalse(c.antarcticInTickList);
+        Assert.assertTrue(a.antarcticInTickList);
+
+        // replaceAll
+        list.replaceAll(te -> d);
+        Assert.assertFalse(a.antarcticInTickList);
+        Assert.assertTrue(d.antarcticInTickList);
+        Assert.assertTrue(list.add(a));
+
+        // listIterator().remove() and set()
+        ListIterator<TileEntity> it = list.listIterator();
+        Assert.assertSame(d, it.next());
+        it.set(b);
+        Assert.assertFalse(d.antarcticInTickList);
+        Assert.assertTrue(b.antarcticInTickList);
+        Assert.assertSame(a, it.next());
+        it.remove();
+        Assert.assertFalse(a.antarcticInTickList);
+        Assert.assertTrue(list.add(a));
+    }
+
+    private static final class RelightHookWorld extends WorldServer {
+        final Set<Integer> relitY = new HashSet<>();
+        Chunk targetChunk;
+
+        RelightHookWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public boolean w(BlockPosition blockposition) {
+            relitY.add(blockposition.getY());
+            // When i1 = 0 (y = 64) is relit on an empty section (j = 4), allocate section[4] mid-column
+            if (blockposition.getY() == 64 && targetChunk != null && targetChunk.getSections()[4] == Chunk.a) {
+                targetChunk.getSections()[4] = new ChunkSection(64, true);
+            }
+            return true;
+        }
+
+        @Override
+        public IBlockData getTypeIfLoaded(int x, int y, int z) {
+            return Blocks.AIR.getBlockData();
+        }
+    }
+
+    @Test
+    public void testChunkNRelightsMidColumnWhenWAllocatesSection() throws Exception {
+        RelightHookWorld world = (RelightHookWorld) unsafe.allocateInstance(RelightHookWorld.class);
+        unsafe.putObject(world, unsafe.objectFieldOffset(RelightHookWorld.class.getDeclaredField("relitY")), new HashSet<>());
+        world.worldData = new WorldData();
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("spigotConfig")), unsafe.allocateInstance(SpigotWorldConfig.class));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("paperConfig")), unsafe.allocateInstance(PaperWorldConfig.class));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("random")), new Random(1L));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("methodProfiler")), new MethodProfiler());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("P")), new WorldBorder());
+        world.worldProvider = new WorldProviderNormal();
+        world.worldProvider.a(world);
+
+        Chunk chunk = (Chunk) unsafe.allocateInstance(Chunk.class);
+        unsafe.putObject(chunk, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("world")), world);
+        unsafe.putInt(chunk, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("locX")), 0);
+        unsafe.putInt(chunk, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("locZ")), 0);
+        ChunkSection[] secs = new ChunkSection[16];
+        for (int i = 0; i < 16; i++) {
+            secs[i] = Chunk.a;
+        }
+        unsafe.putObject(chunk, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("sections")), secs);
+        world.targetChunk = chunk;
+
+        // Position Chunk.x at j=4, k=8, l=8 -> x = 4 + 16 * 8 + 256 * 8 = 2180
+        unsafe.putInt(chunk, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("x")), 4 + 16 * 8 + 256 * 8);
+        chunk.n();
+
+        for (int y = 64; y < 80; y++) {
+            Assert.assertTrue("Expected y=" + y + " to be relit after section[4] allocation at y=64", world.relitY.contains(y));
+        }
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    public void testTrackedRecipeMapRemoveNullValueIncrementsVersion() throws Exception {
+        Class<?> cls = Class.forName("net.minecraft.server.RecipesFurnace$TrackedRecipeMap");
+        Constructor<?> ctor = cls.getDeclaredConstructor();
+        ctor.setAccessible(true);
+        Map<ItemStack, ItemStack> map = (Map<ItemStack, ItemStack>) ctor.newInstance();
+        Field vf = cls.getDeclaredField("version");
+        vf.setAccessible(true);
+
+        ItemStack key = new ItemStack(Blocks.STONE);
+        map.put(key, null);
+        int vAfterPut = vf.getInt(map);
+
+        map.remove(key);
+        int vAfterRemove = vf.getInt(map);
+        Assert.assertEquals("Removing a key mapped to null must increment version", vAfterPut + 1, vAfterRemove);
+    }
+}
