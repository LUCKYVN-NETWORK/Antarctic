+    @Test
+    public void testFastIteratorEliminatesViewerEntryBoxingOverhead() throws Exception {
+        Object2BooleanOpenHashMap<EntityPlayer> map = new Object2BooleanOpenHashMap<EntityPlayer>(64);
+        for (int i = 0; i < 64; ++i) {
+            map.put(newViewer(false), false);
+        }
+        Packet<?> pkt = new PacketPlayOutEntity.PacketPlayOutRelEntityMove(1, 16L, 0L, 0L, true);
+
+        final int warmup = 10_000;
+        final int measured = 50_000;
+
+        for (int i = 0; i < warmup; ++i) {
+            deliverBaseline(map, pkt);
+            deliverFast(map, pkt);
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        long a0 = bean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            deliverBaseline(map, pkt);
+        }
+        long baseNs = System.nanoTime() - t0;
+        long baseAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a0);
+
+        long a1 = bean.getThreadAllocatedBytes(tid);
+        long t1 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            deliverFast(map, pkt);
+        }
+        long fastNs = System.nanoTime() - t1;
+        long fastAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a1);
+
+        long delivered = 0;
+        for (EntityPlayer p : map.keySet()) {
+            delivered += ((CountingConnection) p.playerConnection).count;
+        }
+
+        System.out.printf(
+                "[perf] EntityTrackerEntry viewer loop (%d x 64 viewers): baseline=%.2f ms (alloc=%.2f MB) vs fastIterator=%.2f ms (alloc=%.2f MB), speedup=%.2fx (sent=%d)%n",
+                measured, baseNs / 1e6, baseAlloc / (1024.0 * 1024.0),
+                fastNs / 1e6, fastAlloc / (1024.0 * 1024.0),
+                (double) baseNs / Math.max(1L, fastNs), delivered);
+
+        Assert.assertTrue("fastIterator must allocate far less than boxing entrySet (base=" + baseAlloc + ", fast=" + fastAlloc + ")",
+                fastAlloc * 10L < baseAlloc);
+    }
+
+    private static void deliverBaseline(Map<EntityPlayer, Boolean> map, Packet<?> pkt) {
+        for (Map.Entry<EntityPlayer, Boolean> viewer : map.entrySet()) {
+            if (!viewer.getValue()) {
+                viewer.getKey().playerConnection.sendPacket(pkt);
+            }
+        }
+    }
+
+    private static void deliverFast(Object2BooleanOpenHashMap<EntityPlayer> map, Packet<?> pkt) {
