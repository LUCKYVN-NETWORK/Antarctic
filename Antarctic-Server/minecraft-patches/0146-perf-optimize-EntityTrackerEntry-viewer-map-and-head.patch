+    @Test
+    public void testUpdatePlayerHeadRotationIsUnicastAndPreservesExistingViewerDelta() throws Exception {
+        EntityLiving zombie = newLivingTracker();
+        EntityTrackerEntry entry = new EntityTrackerEntry(zombie, 64, 64, 1, false);
+
+        // Existing viewer already tracking the zombie (headYaw == 45 deg)
+        EntityPlayer existing = newViewer(true);
+        entry.trackedPlayerMap.put(existing, Boolean.FALSE);
+
+        // Zombie rotates head to 90 deg BEFORE new viewer joins, and before next track()
+        zombie.setHeadRotation(90.0F);
+
+        // New viewer joins via updatePlayer()
+        EntityPlayer joining = newViewer(true);
+        joining.world = newMinimalWorldServer();
+        boolean prevCatcher = org.spigotmc.AsyncCatcher.enabled;
+        org.spigotmc.AsyncCatcher.enabled = false;
+        try {
+            entry.updatePlayer(joining);
+        } finally {
+            org.spigotmc.AsyncCatcher.enabled = prevCatcher;
+        }
+
+        RecordingConnection existingConn = (RecordingConnection) existing.playerConnection;
+        RecordingConnection joiningConn = (RecordingConnection) joining.playerConnection;
+
+        // Existing viewer must NOT receive a spurious head rotation packet when another player starts tracking
+        long existingHeadPackets = existingConn.packets.stream()
+                .filter(p -> p instanceof PacketPlayOutEntityHeadRotation)
+                .count();
+        Assert.assertEquals("Existing viewers must not receive broadcast head-rotation storm on new viewer join",
+                0L, existingHeadPackets);
+
+        // Joining viewer MUST receive exactly one PacketPlayOutEntityHeadRotation with the current headYaw (90 deg)
+        long joiningHeadPackets = joiningConn.packets.stream()
+                .filter(p -> p instanceof PacketPlayOutEntityHeadRotation)
+                .count();
+        Assert.assertEquals("Joining viewer must receive initial head rotation packet", 1L, joiningHeadPackets);
+
+        // Next track() must still detect the 45 -> 90 deg delta and broadcast to existing viewer
+        entry.track(Collections.<EntityHuman>emptyList());
+        long existingHeadAfterTrack = existingConn.packets.stream()
+                .filter(p -> p instanceof PacketPlayOutEntityHeadRotation)
+                .count();
+        Assert.assertEquals("Existing viewer must still receive head rotation delta on next track()",
+                1L, existingHeadAfterTrack);
+    }
