+        viewer.locY = 64.0D;
+        viewer.locZ = 0.0D;
+        viewer.playerConnection = recordList ? allocateRecordingConnection() : allocateCountingConnection();
+        return viewer;
+    }
+
+    private static RecordingConnection allocateRecordingConnection() throws Exception {
+        RecordingConnection conn = (RecordingConnection) UNSAFE.allocateInstance(RecordingConnection.class);
+        Field packetsField = RecordingConnection.class.getDeclaredField("packets");
+        packetsField.setAccessible(true);
+        packetsField.set(conn, new ArrayList<Packet<?>>());
+        return conn;
+    }
+
+    private static CountingConnection allocateCountingConnection() throws Exception {
+        return (CountingConnection) UNSAFE.allocateInstance(CountingConnection.class);
+    }
