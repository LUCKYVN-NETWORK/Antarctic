+    private static final class RecordingConnection extends PlayerConnection {
+        final List<Packet<?>> packets = new ArrayList<Packet<?>>();
+        int count;
+
+        RecordingConnection() {
+            super(null, null, null);
+        }
+
+        @Override
+        public void sendPacket(Packet<?> packet) {
+            this.count++;
+            if (this.packets != null) {
+                this.packets.add(packet);
+            }
+        }
+    }
+
+    private static final class CountingConnection extends PlayerConnection {
+        int count;
+
+        CountingConnection() {
+            super(null, null, null);
+        }
+
+        @Override
+        public void sendPacket(Packet<?> packet) {
+            this.count++;
+        }
+    }
+
+    private static void setField(Class<?> owner, Object target, String name, Object value) throws Exception {
+        Field f = owner.getDeclaredField(name);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    private static EntityPlayer newViewer(boolean recordList) throws Exception {
