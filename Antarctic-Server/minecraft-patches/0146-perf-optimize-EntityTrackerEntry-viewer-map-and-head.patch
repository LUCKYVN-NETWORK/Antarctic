+    @Test
+    public void testFirstUpdateTeleportAndMoveLookBranchParity() throws Exception {
+        EntityLiving zombie = newLivingTracker();
+        EntityTrackerEntry entry = new EntityTrackerEntry(zombie, 64, 64, 1, false);
+        entry.a = 1; // past tick 0
+
+        EntityPlayer fresh = newViewer(true);
+        EntityPlayer steady = newViewer(true);
+        entry.trackedPlayerMap.put(fresh, Boolean.TRUE);
+        entry.trackedPlayerMap.put(steady, Boolean.FALSE);
+
+        // Move slightly -> fresh gets Teleport & flips to false; steady gets RelEntityMove
+        zombie.locX = 1.0D;
+        entry.track(Collections.<EntityHuman>emptyList());
+
+        RecordingConnection freshConn = (RecordingConnection) fresh.playerConnection;
+        RecordingConnection steadyConn = (RecordingConnection) steady.playerConnection;
+
+        Assert.assertTrue("Fresh viewer must receive PacketPlayOutEntityTeleport on first update",
+                freshConn.packets.stream().anyMatch(p -> p instanceof PacketPlayOutEntityTeleport));
+        Assert.assertFalse("Fresh viewer flag must clear after first teleport",
+                entry.trackedPlayerMap.get(fresh));
+        Assert.assertTrue("Steady viewer must receive PacketPlayOutRelEntityMove",
+                steadyConn.packets.stream().anyMatch(p -> p instanceof PacketPlayOutEntity.PacketPlayOutRelEntityMove));
+
+        freshConn.packets.clear();
+        steadyConn.packets.clear();
+
+        // Rotate only -> both get PacketPlayOutEntityLook
+        zombie.yaw = 30.0F;
+        entry.track(Collections.<EntityHuman>emptyList());
+        Assert.assertTrue(freshConn.packets.stream().anyMatch(p -> p instanceof PacketPlayOutEntity.PacketPlayOutEntityLook));
+        Assert.assertTrue(steadyConn.packets.stream().anyMatch(p -> p instanceof PacketPlayOutEntity.PacketPlayOutEntityLook));
+
+        freshConn.packets.clear();
+        steadyConn.packets.clear();
+
+        // Move AND rotate -> both get PacketPlayOutRelEntityMoveLook
+        zombie.locZ = 1.0D;
+        zombie.yaw = 60.0F;
+        entry.track(Collections.<EntityHuman>emptyList());
+        Assert.assertTrue(freshConn.packets.stream().anyMatch(p -> p instanceof PacketPlayOutEntity.PacketPlayOutRelEntityMoveLook));
+        Assert.assertTrue(steadyConn.packets.stream().anyMatch(p -> p instanceof PacketPlayOutEntity.PacketPlayOutRelEntityMoveLook));
+
+        // Arrow with zero move/rotate still sends RelEntityMoveLook (vanilla parity)
+        EntityTippedArrow arrow = (EntityTippedArrow) UNSAFE.allocateInstance(EntityTippedArrow.class);
+        arrow.h(nextEntityId++);
+        arrow.locX = 0.0D;
+        arrow.locY = 64.0D;
+        arrow.locZ = 0.0D;
+        arrow.onGround = true;
+        setField(Entity.class, arrow, "passengers", Collections.emptyList());
+        arrow.datawatcher = newBaseDataWatcher(arrow);
+        EntityTrackerEntry arrowEntry = new EntityTrackerEntry(arrow, 64, 64, 1, false);
+        EntityPlayer arrowViewer = newViewer(true);
+        arrowEntry.trackedPlayerMap.put(arrowViewer, Boolean.FALSE);
+        arrowEntry.track(Collections.<EntityHuman>emptyList());
+
+        RecordingConnection arrowConn = (RecordingConnection) arrowViewer.playerConnection;
+        Assert.assertTrue("Arrow must emit RelEntityMoveLook even with zero delta",
+                arrowConn.packets.stream().anyMatch(p -> p instanceof PacketPlayOutEntity.PacketPlayOutRelEntityMoveLook));
+        Assert.assertEquals("Non-EntityLiving must never emit PacketPlayOutEntityHeadRotation",
+                0L, arrowConn.packets.stream().filter(p -> p instanceof PacketPlayOutEntityHeadRotation).count());
+    }
