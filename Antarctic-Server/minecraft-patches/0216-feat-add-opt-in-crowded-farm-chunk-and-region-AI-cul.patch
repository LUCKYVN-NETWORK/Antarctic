@@ -0,0 +1,56 @@
+package com.destroystokyo.paper.config.toml.modules.optimizations;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+
+public class FarmAiCulling implements IConfigModule {
+
+    @ConfigInfo(baseName = "enabled", comments = "Opt-in AI culling for crowded farm slices/chunks/regions with hysteresis auto-resume. Never sets NoAI. Default false.")
+    public static boolean enabled = false;
+
+    @ConfigInfo(baseName = "slice-threshold", comments = "Insentient mob count in a 16x16x16 chunk slice to engage culling (0 disables). Default 32.")
+    public static int sliceThreshold = 32;
+
+    @ConfigInfo(baseName = "chunk-threshold", comments = "Insentient mob count in a full chunk to engage culling (0 disables). Default 64.")
+    public static int chunkThreshold = 64;
+
+    @ConfigInfo(baseName = "region-threshold", comments = "Insentient mob count across a loaded 3x3 chunk region to engage culling (0 disables). Default 0.")
+    public static int regionThreshold = 0;
+
+    @ConfigInfo(baseName = "resume-ratio", comments = "Hysteresis ratio below threshold at which full AI resumes automatically. Default 0.75.")
+    public static double resumeRatio = 0.75D;
+
+    @ConfigInfo(baseName = "culled-ai-tick-interval", comments = "AI tick interval while crowded (0 suspends goal AI until count drops; > 0 runs 1 AI tick per N ticks). Default 0.")
+    public static int culledAiTickInterval = 0;
+
+    @ConfigInfo(baseName = "allow-float-in-water", comments = "Allow culled mobs to run goalFloat when in water so grinders and water streams work normally. Default true.")
+    public static boolean allowFloatInWater = true;
+
+    @ConfigInfo(baseName = "exempt-villagers", comments = "Never cull villager AI so trading halls keep working normally. Default true.")
+    public static boolean exemptVillagers = true;
+
+    @ConfigInfo(baseName = "wake-on-hurt-ticks", comments = "Temporarily wake culled mobs for this many ticks when damaged. Default 40.")
+    public static int wakeOnHurtTicks = 40;
+
+    @Override
+    public void onLoaded(CommentedFileConfig config) {
+        sliceThreshold = Math.max(0, sliceThreshold);
+        chunkThreshold = Math.max(0, chunkThreshold);
+        regionThreshold = Math.max(0, regionThreshold);
+        resumeRatio = Math.max(0.0D, Math.min(1.0D, resumeRatio));
+        culledAiTickInterval = Math.max(0, culledAiTickInterval);
+        wakeOnHurtTicks = Math.max(0, wakeOnHurtTicks);
+    }
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.OPTIMIZATIONS;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "farm-ai-culling";
+    }
+}
