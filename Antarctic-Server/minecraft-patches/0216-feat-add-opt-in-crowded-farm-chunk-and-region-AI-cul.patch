+    boolean isFarmAiCulledForSlice(int sliceY, int currentTick) {
+        if (sliceY < 0 || sliceY >= 16 || this.antarcticInsentientSliceCounts == null || this.antarcticSliceAiCulled == null) {
+            return false;
+        }
+        final double ratio = com.destroystokyo.paper.config.toml.modules.optimizations.FarmAiCulling.resumeRatio;
+        final int sliceThreshold = com.destroystokyo.paper.config.toml.modules.optimizations.FarmAiCulling.sliceThreshold;
+        if (sliceThreshold > 0) {
+            int count = this.antarcticInsentientSliceCounts[sliceY];
+            if (this.antarcticSliceAiCulled[sliceY]) {
+                if (count <= (int) (sliceThreshold * ratio)) {
+                    this.antarcticSliceAiCulled[sliceY] = false;
+                }
+            } else if (count >= sliceThreshold) {
+                this.antarcticSliceAiCulled[sliceY] = true;
+            }
+            if (this.antarcticSliceAiCulled[sliceY]) {
+                return true;
+            }
+        }
+        final int chunkThreshold = com.destroystokyo.paper.config.toml.modules.optimizations.FarmAiCulling.chunkThreshold;
+        if (chunkThreshold > 0) {
+            if (this.antarcticChunkAiCulled) {
+                if (this.antarcticInsentientCount <= (int) (chunkThreshold * ratio)) {
+                    this.antarcticChunkAiCulled = false;
+                }
+            } else if (this.antarcticInsentientCount >= chunkThreshold) {
+                this.antarcticChunkAiCulled = true;
+            }
+            if (this.antarcticChunkAiCulled) {
+                return true;
+            }
+        }
+        final int regionThreshold = com.destroystokyo.paper.config.toml.modules.optimizations.FarmAiCulling.regionThreshold;
+        if (regionThreshold > 0) {
+            if (this.antarcticRegionCountStamp != currentTick) {
+                int sum = 0;
+                for (int dx = -1; dx <= 1; ++dx) {
+                    for (int dz = -1; dz <= 1; ++dz) {
+                        Chunk neighbor = (dx == 0 && dz == 0) ? this : this.world.getChunkIfLoaded(this.locX + dx, this.locZ + dz);
+                        if (neighbor != null) {
+                            sum += neighbor.antarcticInsentientCount;
+                        }
+                    }
+                }
+                this.antarcticCachedRegionInsentientCount = sum;
+                this.antarcticRegionCountStamp = currentTick;
+            }
+            if (this.antarcticRegionAiCulled) {
+                if (this.antarcticCachedRegionInsentientCount <= (int) (regionThreshold * ratio)) {
+                    this.antarcticRegionAiCulled = false;
+                }
+            } else if (this.antarcticCachedRegionInsentientCount >= regionThreshold) {
+                this.antarcticRegionAiCulled = true;
+            }
+            return this.antarcticRegionAiCulled;
+        }
+        return false;
+    }
