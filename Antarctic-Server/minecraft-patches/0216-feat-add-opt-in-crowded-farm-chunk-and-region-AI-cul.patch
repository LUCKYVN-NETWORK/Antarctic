+    @Test
+    public void testSliceCountsAndHysteresisAutoResume() throws Exception {
+        DummyWorld world = createWorld();
+        Chunk chunk = createChunk(world, 0, 0);
+        FarmAiCulling.enabled = true;
+        FarmAiCulling.sliceThreshold = 32;
+        FarmAiCulling.chunkThreshold = 0;
+        FarmAiCulling.regionThreshold = 0;
+        FarmAiCulling.resumeRatio = 0.75D;
+
+        EntityZombie[] mobs = new EntityZombie[32];
+        for (int i = 0; i < 32; i++) {
+            mobs[i] = new EntityZombie(world);
+            mobs[i].locX = 8.0D;
+            mobs[i].locY = 68.0D; // slice 4
+            mobs[i].locZ = 8.0D;
+            chunk.a(mobs[i]);
+        }
+        assertEquals(32, chunk.antarcticInsentientSliceCounts[4]);
+        assertEquals(32, chunk.antarcticInsentientCount);
+        assertTrue("Culling must engage at sliceThreshold=32", chunk.isFarmAiCulledForSlice(4, 1));
+
+        // Remove 4 mobs -> 28 remaining (> 24 hysteresis floor) -> stays culled
+        for (int i = 0; i < 4; i++) {
+            chunk.b(mobs[i]);
+        }
+        assertEquals(28, chunk.antarcticInsentientSliceCounts[4]);
+        assertEquals(28, chunk.antarcticInsentientCount);
+        assertTrue("Hysteresis must keep culling active at 28 (> 24)", chunk.isFarmAiCulledForSlice(4, 2));
+
+        // Remove 4 more -> 24 remaining (<= 24 floor) -> auto-resumes
+        for (int i = 4; i < 8; i++) {
+            chunk.b(mobs[i]);
+        }
+        assertEquals(24, chunk.antarcticInsentientSliceCounts[4]);
+        assertFalse("Culling must auto-resume at <= 24", chunk.isFarmAiCulledForSlice(4, 3));
+    }
+
+    @Test
+    public void testRegionThresholdAndExemptionsAndNoAiPreserved() throws Exception {
+        DummyWorld world = createWorld();
+        Chunk center = createChunk(world, 0, 0);
+        Chunk neighbor = createChunk(world, 1, 0);
+
+        FarmAiCulling.enabled = true;
+        FarmAiCulling.sliceThreshold = 0;
+        FarmAiCulling.chunkThreshold = 0;
+        FarmAiCulling.regionThreshold = 20;
+        FarmAiCulling.resumeRatio = 0.5D;
+        FarmAiCulling.culledAiTickInterval = 0;
+        FarmAiCulling.exemptVillagers = true;
+        FarmAiCulling.wakeOnHurtTicks = 40;
+
+        for (int i = 0; i < 10; i++) {
+            EntityZombie z1 = new EntityZombie(world);
+            z1.locX = 8.0D; z1.locY = 64.0D; z1.locZ = 8.0D;
+            center.a(z1);
+            EntityZombie z2 = new EntityZombie(world);
+            z2.locX = 24.0D; z2.locY = 64.0D; z2.locZ = 8.0D;
+            neighbor.a(z2);
+        }
+        assertTrue("3x3 region sum=20 must engage culling", center.isFarmAiCulledForSlice(4, 10));
+
+        // Non-exempt mob in center chunk is culled without setting NoAI
+        EntityZombie farmMob = new EntityZombie(world);
+        farmMob.locX = 8.0D; farmMob.locY = 64.0D; farmMob.locZ = 8.0D;
+        center.a(farmMob);
+        assertTrue(farmMob.shouldSkipAiForFarmCulling(10));
+        assertFalse("Farm AI culling must never mutate NoAI", farmMob.isNoAI());
+
+        // Hurt wake-up
+        farmMob.hurtTicks = 5;
+        assertTrue(farmMob.shouldSkipAiForFarmCulling(10) == false);
+        farmMob.hurtTicks = 0;
+        assertFalse("Wake window must keep mob awake for wakeOnHurtTicks", farmMob.shouldSkipAiForFarmCulling(20));
+        assertTrue("Mob re-enters culling after wake window expires", farmMob.shouldSkipAiForFarmCulling(60));
+
+        // Named, villager, boss, tamed exempt
+        EntityZombie named = new EntityZombie(world);
+        named.setCustomName("BossGuard");
+        center.a(named);
+        assertFalse(named.shouldSkipAiForFarmCulling(60));
+
