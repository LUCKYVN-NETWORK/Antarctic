+    @Test
+    public void testPhysicsDispatchBenchmark() throws Exception {
+        TestWorld world = createWorld();
+        ChunkSection sec = world.chunk.getSections()[4];
+        for (int dx = -1; dx <= 1; dx++) {
+            for (int dz = -1; dz <= 1; dz++) {
+                sec.setType(8 + dx, 1, 8 + dz, Blocks.STONE.getBlockData());
+            }
+        }
+        BlockPosition center = new BlockPosition(8, 65, 8);
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        for (int i = 0; i < 5000; i++) {
+            runVanillaApplyPhysicsAndC(world, center, Blocks.STONE);
+            world.notifyAndUpdatePhysics(center, world.chunk, Blocks.AIR.getBlockData(), Blocks.STONE.getBlockData(), 1);
+        }
+
+        final int iters = 50000;
+        long vAlloc0 = bean.getThreadAllocatedBytes(tid);
+        long vT0 = System.nanoTime();
+        int sink = 0;
+        for (int i = 0; i < iters; i++) {
+            sink += runVanillaApplyPhysicsAndC(world, center, Blocks.STONE);
+        }
+        long vNs = System.nanoTime() - vT0;
+        long vBytes = bean.getThreadAllocatedBytes(tid) - vAlloc0;
+
+        long oAlloc0 = bean.getThreadAllocatedBytes(tid);
+        long oT0 = System.nanoTime();
+        for (int i = 0; i < iters; i++) {
+            world.notifyAndUpdatePhysics(center, world.chunk, Blocks.AIR.getBlockData(), Blocks.STONE.getBlockData(), 1);
+        }
+        long oNs = System.nanoTime() - oT0;
+        long oBytes = bean.getThreadAllocatedBytes(tid) - oAlloc0;
+
+        double speedup = (double) vNs / (double) Math.max(1L, oNs);
+        System.out.println(String.format(
+                "C1_BENCH vanilla_ns=%d opt_ns=%d speedup=%.2fx vanilla_bytes=%d opt_bytes=%d sink=%d",
+                vNs, oNs, speedup, vBytes, oBytes, sink));
+
+        Assert.assertEquals("Optimized applyPhysics+c on stone/air should allocate 0 bytes", 0L, oBytes);
+        Assert.assertTrue("Expected speedup > 1.5x, got " + speedup, speedup > 1.5D);
+    }
+
+    private static int runVanillaApplyPhysicsAndC(World world, BlockPosition pos, Block block) {
+        int acc = 0;
+        BlockPosition w = pos.west(); IBlockData dw = world.getType(w); dw.doPhysics(world, w, block, pos); acc += Block.getId(dw.getBlock());
+        BlockPosition e = pos.east(); IBlockData de = world.getType(e); de.doPhysics(world, e, block, pos); acc += Block.getId(de.getBlock());
+        BlockPosition d = pos.down(); IBlockData dd = world.getType(d); dd.doPhysics(world, d, block, pos); acc += Block.getId(dd.getBlock());
+        BlockPosition u = pos.up(); IBlockData du = world.getType(u); du.doPhysics(world, u, block, pos); acc += Block.getId(du.getBlock());
+        BlockPosition n = pos.north(); IBlockData dn = world.getType(n); dn.doPhysics(world, n, block, pos); acc += Block.getId(dn.getBlock());
+        BlockPosition s = pos.south(); IBlockData ds = world.getType(s); ds.doPhysics(world, s, block, pos); acc += Block.getId(ds.getBlock());
+
+        BlockPosition w2 = pos.west(); if (world.getType(w2).getBlock() == Blocks.dk) acc++;
+        BlockPosition e2 = pos.east(); if (world.getType(e2).getBlock() == Blocks.dk) acc++;
+        BlockPosition d2 = pos.down(); if (world.getType(d2).getBlock() == Blocks.dk) acc++;
+        BlockPosition u2 = pos.up(); if (world.getType(u2).getBlock() == Blocks.dk) acc++;
+        BlockPosition n2 = pos.north(); if (world.getType(n2).getBlock() == Blocks.dk) acc++;
+        BlockPosition s2 = pos.south(); if (world.getType(s2).getBlock() == Blocks.dk) acc++;
+        return acc;
+    }
