+        public void sendPacket(Packet<?> packet) {
+            this.sentPackets.add(packet);
+        }
+
+        @Override
+        public void disconnect(String s) {
+            this.disconnected = true;
+        }
+
+        @Override
+        public void disconnect(IChatBaseComponent ichatbasecomponent) {
+            this.disconnected = true;
+        }
+    }
+
