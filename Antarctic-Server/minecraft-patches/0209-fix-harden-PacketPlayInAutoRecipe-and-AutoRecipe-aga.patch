+    @Test
+    public void testPacketPlayInAutoRecipeRejectsIllegalStatesWithoutKick() throws Exception {
+        RecordingPlayerConnection conn = (RecordingPlayerConnection) UNSAFE.allocateInstance(RecordingPlayerConnection.class);
+        Field sentField = RecordingPlayerConnection.class.getDeclaredField("sentPackets");
+        sentField.setAccessible(true);
+        sentField.set(conn, new ArrayList<Packet<?>>());
+        Field nmField = PlayerConnection.class.getDeclaredField("networkManager");
+        nmField.setAccessible(true);
+        nmField.set(conn, new NetworkManager(EnumProtocolDirection.SERVERBOUND) {
+            @Override
+            public boolean isConnected() {
+                return !conn.disconnected;
+            }
+        });
+        EntityPlayer player = createMockPlayer(conn, false);
+        conn.player = player;
+
+        // Track whether AutoRecipe.a(...) is invoked by using a dummy subclass in PlayerConnection.H
+        final boolean[] autoRecipeCalled = new boolean[1];
+        AutoRecipe spy = new AutoRecipe() {
+            @Override
+            public void a(EntityPlayer ep, IRecipe recipe, boolean flag) {
+                autoRecipeCalled[0] = true;
+            }
+        };
+        Field hField = PlayerConnection.class.getDeclaredField("H");
+        hField.setAccessible(true);
+        hField.set(conn, spy);
+
+        // Build a synthetic PacketPlayInAutoRecipe with windowId=99 (mismatch)
+        PacketPlayInAutoRecipe badWindow = (PacketPlayInAutoRecipe) UNSAFE.allocateInstance(PacketPlayInAutoRecipe.class);
+        Field winField = PacketPlayInAutoRecipe.class.getDeclaredField("a");
+        winField.setAccessible(true);
+        winField.setInt(badWindow, 99);
