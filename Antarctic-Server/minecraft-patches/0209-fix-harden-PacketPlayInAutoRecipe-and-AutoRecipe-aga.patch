+    @Test
+    public void testCumulativeCapacityRejectsMultiSlotOverflow() throws Exception {
+        RecordingPlayerConnection conn = (RecordingPlayerConnection) UNSAFE.allocateInstance(RecordingPlayerConnection.class);
+        EntityPlayer player = createMockPlayer(conn, false);
+        ContainerPlayer container = (ContainerPlayer) player.activeContainer;
+
+        // Fill 35 of 36 inventory slots with unstackable swords; leave 1 empty slot (slot 35)
+        for (int i = 0; i < 35; i++) {
+            player.inventory.items.set(i, new ItemStack(Items.IRON_SWORD, 1));
+        }
+
+        // Put 2 distinct items in crafting grid: only 1 empty slot exists, so cumulative clear must NOT run!
+        container.craftInventory.setItem(0, new ItemStack(Items.DIAMOND, 1));
+        container.craftInventory.setItem(1, new ItemStack(Items.EMERALD, 1));
+
+        AutoRecipe ar = new AutoRecipe();
+        setupAutoRecipe(ar, player, container);
+
+        Method cMethod = AutoRecipe.class.getDeclaredMethod("c");
+        cMethod.setAccessible(true);
+        assertFalse("Cumulative capacity check must reject 2 items when only 1 empty slot exists",
+                (Boolean) cMethod.invoke(ar));
+
+        // Verify a() aborts cleanly without passing j == -1 or losing items
+        Method aMethod = AutoRecipe.class.getDeclaredMethod("a");
+        aMethod.setAccessible(true);
+        boolean cleared = (Boolean) aMethod.invoke(ar);
+        assertFalse(cleared);
+        // Diamond moved to slot 35, emerald stayed safely in grid slot 1 (total: 1 diamond + 1 emerald, 0 loss, 0 dupe)
+        assertEquals(Items.DIAMOND, player.inventory.items.get(35).getItem());
+        assertTrue(container.craftInventory.getItem(0).isEmpty());
+        assertEquals(Items.EMERALD, container.craftInventory.getItem(1).getItem());
+        assertEquals(1, container.craftInventory.getItem(1).getCount());
+    }
