+
+public class Player implements IConfigModule {
+
+    @ConfigInfo(baseName = "max-use-item-distance", comments = "Maximum distance (in blocks) for UseItem block-change resync packets. Prevents NoCom remote chunk loading. Set <= 0 to disable distance cap. Default 8.0.")
