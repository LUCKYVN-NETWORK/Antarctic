diff --git a/test/java/net/minecraft/server/UseItemNoComGuardTest.java b/test/java/net/minecraft/server/UseItemNoComGuardTest.java
new file mode 100644
index 0000000..682c708
--- /dev/null
+++ b/test/java/net/minecraft/server/UseItemNoComGuardTest.java
@@ -0,0 +1,323 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.gameplay.Player;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class UseItemNoComGuardTest {
+
+    private static Unsafe UNSAFE;
+    private static double defaultMaxDist;
+
+    @BeforeClass
+    public static void setupTest() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+        defaultMaxDist = Player.maxUseItemDistance;
+    }
+
+    @After
+    public void restoreConfig() {
+        Player.maxUseItemDistance = defaultMaxDist;
+    }
+
+    private static final class DummyNetworkManager extends NetworkManager {
+        DummyNetworkManager() {
+            super(EnumProtocolDirection.SERVERBOUND);
+        }
+
+        @Override
+        public boolean isConnected() {
+            return true;
+        }
+    }
+
+    private static final class RecordingPlayerConnection extends PlayerConnection {
+        final List<Packet<?>> sentPackets = new ArrayList<>();
+        boolean disconnected = false;
+
+        RecordingPlayerConnection() throws Exception {
+            super(null, null, null);
+        }
+
+        @Override
+        public void sendPacket(Packet<?> packet) {
+            this.sentPackets.add(packet);
+        }
+
+        @Override
+        public void disconnect(String s) {
+            this.disconnected = true;
+        }
+
+        @Override
+        public void disconnect(IChatBaseComponent ichatbasecomponent) {
+            this.disconnected = true;
+        }
+    }
+
+    private static final class TrackingWorld extends WorldServer {
+        boolean loaded = false;
+        int isLoadedCalls = 0;
+        int getTypeCalls = 0;
+
+        TrackingWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public boolean isMainThread() {
+            return true;
+        }
+
+        @Override
+        public boolean isLoaded(BlockPosition blockposition) {
+            isLoadedCalls++;
+            return loaded;
+        }
+
+        @Override
+        public IBlockData getType(BlockPosition blockposition) {
+            getTypeCalls++;
+            return Blocks.STONE.getBlockData();
+        }
+    }
+
+    private static final class DummyMinecraftServer extends MinecraftServer {
+        TrackingWorld world;
+
+        DummyMinecraftServer() {
+            super(null, null, null, null, null, null, null);
+        }
+
+        @Override
+        public WorldServer getWorldServer(int i) {
+            return this.world;
+        }
+
+        @Override
+        public int getMaxBuildHeight() {
+            return 256;
+        }
+
+        @Override
+        public boolean isMainThread() {
+            return true;
+        }
+
+        @Override
+        public PropertyManager getPropertyManager() {
+            return null;
+        }
+
+        @Override
+        public boolean init() {
+            return true;
+        }
+
+        @Override
+        public boolean getGenerateStructures() {
+            return false;
+        }
+
+        @Override
+        public EnumGamemode getGamemode() {
+            return EnumGamemode.SURVIVAL;
+        }
+
+        @Override
+        public EnumDifficulty getDifficulty() {
+            return EnumDifficulty.NORMAL;
+        }
+
+        @Override
+        public boolean isHardcore() {
+            return false;
+        }
+
+        @Override
+        public int q() {
+            return 4;
+        }
+
+        @Override
+        public boolean r() {
+            return false;
+        }
+
+        @Override
+        public boolean s() {
+            return false;
+        }
+
+        @Override
+        public boolean aa() {
+            return false;
+        }
+
+        @Override
+        public boolean af() {
+            return false;
+        }
+
+        @Override
+        public boolean getEnableCommandBlock() {
+            return false;
+        }
+
+        @Override
+        public String a(EnumGamemode gamemode, boolean flag) {
+            return "";
+        }
+    }
+
+    private static RecordingPlayerConnection createConnection(TrackingWorld world) throws Exception {
+        Field csField = World.class.getDeclaredField("isClientSide");
+        csField.setAccessible(true);
+        csField.setBoolean(world, true);
+        world.worldData = new WorldData();
+        world.worldProvider = new WorldProviderNormal();
+
+        DummyMinecraftServer server = (DummyMinecraftServer) UNSAFE.allocateInstance(DummyMinecraftServer.class);
+        server.world = world;
+
+        RecordingPlayerConnection conn = (RecordingPlayerConnection) UNSAFE.allocateInstance(RecordingPlayerConnection.class);
+        Field spField = RecordingPlayerConnection.class.getDeclaredField("sentPackets");
+        spField.setAccessible(true);
+        spField.set(conn, new ArrayList<>());
+        Field msField = PlayerConnection.class.getDeclaredField("minecraftServer");
+        msField.setAccessible(true);
+        msField.set(conn, server);
+        Field nmField = PlayerConnection.class.getDeclaredField("networkManager");
+        nmField.setAccessible(true);
+        nmField.set(conn, UNSAFE.allocateInstance(DummyNetworkManager.class));
+        Field llpField = PlayerConnection.class.getDeclaredField("lastLimitedPacket");
+        llpField.setAccessible(true);
+        llpField.setLong(conn, -1L);
+        Field tpField = PlayerConnection.class.getDeclaredField("teleportPos");
+        tpField.setAccessible(true);
+        // Set teleportPos non-null to isolate the BlockChange resync path cleanly without WorldBorder/InteractManager setup
+        tpField.set(conn, new Vec3D(0.0D, 64.0D, 0.0D));
+
+        EntityPlayer player = (EntityPlayer) UNSAFE.allocateInstance(EntityPlayer.class);
+        player.world = world;
+        player.playerConnection = conn;
+        player.locX = 0.0D;
+        player.locY = 64.0D;
+        player.locZ = 0.0D;
+        org.bukkit.craftbukkit.entity.CraftPlayer craftPlayer =
+                (org.bukkit.craftbukkit.entity.CraftPlayer) UNSAFE.allocateInstance(org.bukkit.craftbukkit.entity.CraftPlayer.class);
+        Field entityField = org.bukkit.craftbukkit.entity.CraftEntity.class.getDeclaredField("entity");
+        entityField.setAccessible(true);
+        entityField.set(craftPlayer, player);
+        Field cpHealth = org.bukkit.craftbukkit.entity.CraftPlayer.class.getDeclaredField("health");
+        cpHealth.setAccessible(true);
+        cpHealth.setDouble(craftPlayer, 20.0D);
+        Field beField = Entity.class.getDeclaredField("bukkitEntity");
+        beField.setAccessible(true);
+        beField.set(player, craftPlayer);
+        DataWatcher dw = new DataWatcher(player);
+        dw.register(EntityLiving.HEALTH, 20.0F);
+        Field dwField = Entity.class.getDeclaredField("datawatcher");
+        dwField.setAccessible(true);
+        dwField.set(player, dw);
+        player.inventory = new PlayerInventory(player);
+        conn.player = player;
+        return conn;
+    }
+
+    private static PacketPlayInUseItem useItemPacket(int x, int y, int z, EnumDirection face, long timestamp) throws Exception {
+        PacketPlayInUseItem pkt = new PacketPlayInUseItem();
+        Field a = PacketPlayInUseItem.class.getDeclaredField("a");
+        Field b = PacketPlayInUseItem.class.getDeclaredField("b");
+        Field c = PacketPlayInUseItem.class.getDeclaredField("c");
+        a.setAccessible(true);
+        b.setAccessible(true);
+        c.setAccessible(true);
+        a.set(pkt, new BlockPosition(x, y, z));
+        b.set(pkt, face);
+        c.set(pkt, EnumHand.MAIN_HAND);
+        pkt.timestamp = timestamp;
+        return pkt;
+    }
+
+    @Test
+    public void testOutOfRangeUseItemLoadsZeroChunksAndEmitsZeroPackets() throws Exception {
+        TrackingWorld world = (TrackingWorld) UNSAFE.allocateInstance(TrackingWorld.class);
+        world.loaded = true;
+        RecordingPlayerConnection conn = createConnection(world);
+
+        conn.a(useItemPacket(100000, 64, 100000, EnumDirection.UP, 1000L));
+        assertFalse("Out-of-range UseItem must not kick player", conn.disconnected);
+        assertEquals("Out-of-range UseItem must not probe loaded chunks", 0, world.isLoadedCalls);
+        assertEquals("Out-of-range UseItem must not call getType", 0, world.getTypeCalls);
+        assertTrue("Out-of-range UseItem must emit 0 packets", conn.sentPackets.isEmpty());
+    }
+
+    @Test
+    public void testInRangeLoadedAndUnloadedResyncBehavior() throws Exception {
+        TrackingWorld world = (TrackingWorld) UNSAFE.allocateInstance(TrackingWorld.class);
+        RecordingPlayerConnection conn = createConnection(world);
+
+        // In-range but unloaded -> 0 packets, 0 getType calls
+        world.loaded = false;
+        conn.a(useItemPacket(2, 64, 2, EnumDirection.UP, 1000L));
+        assertEquals(2, world.isLoadedCalls);
+        assertEquals(0, world.getTypeCalls);
+        assertTrue(conn.sentPackets.isEmpty());
+
+        // In-range and loaded -> 2 PacketPlayOutBlockChange resync packets
+        world.loaded = true;
+        world.isLoadedCalls = 0;
+        conn.a(useItemPacket(2, 64, 2, EnumDirection.UP, 2000L));
+        assertEquals(2, world.isLoadedCalls);
+        assertEquals(2, world.getTypeCalls);
+        assertEquals(2, conn.sentPackets.size());
+        assertTrue(conn.sentPackets.get(0) instanceof PacketPlayOutBlockChange);
+        assertTrue(conn.sentPackets.get(1) instanceof PacketPlayOutBlockChange);
+
+        // Config <= 0 disables distance cap while still honoring isLoaded
+        Player.maxUseItemDistance = -1.0D;
+        conn.sentPackets.clear();
+        world.loaded = false;
+        conn.a(useItemPacket(50000, 64, 50000, EnumDirection.UP, 3000L));
+        assertTrue("Unloaded remote block must still emit 0 packets when distance cap disabled", conn.sentPackets.isEmpty());
+        world.loaded = true;
+        conn.a(useItemPacket(50000, 64, 50000, EnumDirection.UP, 4000L));
+        assertEquals("Loaded remote block must emit resync when distance cap <= 0", 2, conn.sentPackets.size());
+    }
+
+    @Test
+    public void testOutOfRangeRejectionEfficiency() throws Exception {
+        TrackingWorld world = (TrackingWorld) UNSAFE.allocateInstance(TrackingWorld.class);
+        world.loaded = true;
+        RecordingPlayerConnection conn = createConnection(world);
+        PacketPlayInUseItem pkt = useItemPacket(100000, 64, 100000, EnumDirection.UP, 1000L);
+
+        long ts = 10_000L;
+        for (int i = 0; i < 5_000; i++) {
+            pkt.timestamp = (ts += 1000L);
+            conn.a(pkt);
+        }
+
+        long start = System.nanoTime();
+        for (int i = 0; i < 50_000; i++) {
+            pkt.timestamp = (ts += 1000L);
+            conn.a(pkt);
+        }
+        long elapsedMs = (System.nanoTime() - start) / 1_000_000L;
+        assertEquals(0, world.getTypeCalls);
+        assertTrue(conn.sentPackets.isEmpty());
+        assertTrue("50k NoCom rejections took too long: " + elapsedMs + " ms", elapsedMs < 100L);
+    }
+}
