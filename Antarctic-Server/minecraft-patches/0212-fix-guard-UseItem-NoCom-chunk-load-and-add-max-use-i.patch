@@ -1126,8 +1126,18 @@ public class PlayerConnection implements PacketListenerPlayIn, ITickable {
             this.player.playerInteractManager.a(this.player, worldserver, itemstack, enumhand, blockposition, enumdirection, packetplayinuseitem.d(), packetplayinuseitem.e(), packetplayinuseitem.f());
         }
 
-        this.player.playerConnection.sendPacket(new PacketPlayOutBlockChange(worldserver, blockposition));
-        this.player.playerConnection.sendPacket(new PacketPlayOutBlockChange(worldserver, blockposition.shift(enumdirection)));
+        double maxDist = com.destroystokyo.paper.config.toml.modules.gameplay.Player.maxUseItemDistance;
+        boolean withinDist = maxDist <= 0.0D
+                || this.player.d((double) blockposition.getX() + 0.5D, (double) blockposition.getY() + 0.5D, (double) blockposition.getZ() + 0.5D) <= maxDist * maxDist;
+        if (withinDist) {
+            if (worldserver.isLoaded(blockposition)) {
+                this.player.playerConnection.sendPacket(new PacketPlayOutBlockChange(worldserver, blockposition));
+            }
+            BlockPosition shifted = blockposition.shift(enumdirection);
+            if (worldserver.isLoaded(shifted)) {
+                this.player.playerConnection.sendPacket(new PacketPlayOutBlockChange(worldserver, shifted));
+            }
+        }
