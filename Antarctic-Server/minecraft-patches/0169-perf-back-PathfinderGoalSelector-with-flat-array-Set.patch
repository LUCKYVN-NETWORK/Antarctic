+    @Test
+    public void testGoalSelectorTickBenchmark() {
+        MethodProfiler profiler = new MethodProfiler();
+        PathfinderGoalSelector opt = new PathfinderGoalSelector(profiler);
+        VanillaLinkedGoalSelector ref = new VanillaLinkedGoalSelector();
+
