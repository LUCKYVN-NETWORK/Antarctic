+    @Test
+    public void testGoalSelectorParityAndReentrancy() throws Exception {
+        MethodProfiler profiler = new MethodProfiler();
+        PathfinderGoalSelector sel = new PathfinderGoalSelector(profiler);
+
+        // Reflection Set compatibility
+        Field bField = PathfinderGoalSelector.class.getDeclaredField("b");
+        Field cField = PathfinderGoalSelector.class.getDeclaredField("c");
+        bField.setAccessible(true);
+        cField.setAccessible(true);
+        assertTrue(bField.get(sel) instanceof Set);
+        assertTrue(cField.get(sel) instanceof Set);
+
+        DummyGoal g1 = new DummyGoal(1);
+        DummyGoal g2 = new DummyGoal(1);
+        DummyGoal g3 = new DummyGoal(2);
+        g1.shouldStart = true;
+        g1.shouldContinue = true;
+        g3.shouldStart = true;
+        g3.shouldContinue = true;
+
+        sel.a(2, g1);
+        sel.a(1, g1); // duplicate ignored
+        sel.a(1, g2);
+        sel.a(3, g3);
+        assertEquals(3, ((Set<?>) bField.get(sel)).size());
+
+        // Tick 0: g1 and g3 start
+        sel.a();
+        assertEquals(1, g1.startCount);
+        assertEquals(0, g2.startCount);
+        assertEquals(1, g3.startCount);
+
+        // Mutex block on g3 bit (2)
+        sel.c(2);
+        g3.shouldContinue = false;
+        sel.a(); // stops g3 on non-setup or setup tick
+        assertEquals(1, g3.stopCount);
+        sel.d(2);
+
+        // Reentrant removal inside e()
+        g1.onTick = () -> sel.a(g1);
+        sel.a();
+        assertEquals(1, g1.stopCount);
+        assertEquals(2, ((Set<?>) bField.get(sel)).size());
+
+        // Non-interruptible higher-priority goal blocks preemption
+        g2.shouldStart = true;
+        g2.shouldContinue = true;
+        g2.interruptible = false;
+        sel.a();
+        sel.a();
+        sel.a(); // ensures setup tick ran
+        assertEquals(1, g2.startCount);
+        DummyGoal g0 = new DummyGoal(1);
+        g0.shouldStart = true;
+        g0.shouldContinue = true;
+        sel.a(0, g0);
+        sel.a();
+        sel.a();
+        sel.a();
+        assertEquals(0, g0.startCount);
+    }
