+            boolean active = i < 2;
+            DummyGoal gOpt = new DummyGoal(1 << (i % 3));
+            gOpt.shouldStart = active;
+            gOpt.shouldContinue = active;
+            opt.a(i, gOpt);
+
+            DummyGoal gRef = new DummyGoal(1 << (i % 3));
+            gRef.shouldStart = active;
+            gRef.shouldContinue = active;
+            ref.add(i, gRef);
+        }
+
+        for (int w = 0; w < 5000; ++w) {
+            ref.tick();
+            opt.a();
+        }
+
+        ThreadMXBean threadBean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        int ticks = 50000;
+
+        long a0 = threadBean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < ticks; ++i) {
+            ref.tick();
+        }
+        long vanillaNs = System.nanoTime() - t0;
+        long vanillaBytes = Math.max(0L, threadBean.getThreadAllocatedBytes(tid) - a0);
+
+        a0 = threadBean.getThreadAllocatedBytes(tid);
+        t0 = System.nanoTime();
+        for (int i = 0; i < ticks; ++i) {
+            opt.a();
+        }
+        long optNs = System.nanoTime() - t0;
+        long optBytes = Math.max(0L, threadBean.getThreadAllocatedBytes(tid) - a0);
+
+        System.out.printf("B5_BENCH goal50k_vanilla_ns=%d goal50k_opt_ns=%d speedup=%.2fx vanilla_bytes=%d opt_bytes=%d%n",
+                vanillaNs, optNs, (double) vanillaNs / Math.max(1L, optNs), vanillaBytes, optBytes);
+
+        assertEquals("PathfinderGoalSelector steady tick must allocate 0 bytes", 0L, optBytes);
+        assertTrue("Expected PathfinderGoalSelector speedup > 1.2x, got " + vanillaNs + " vs " + optNs,
+                optNs * 1.2 < vanillaNs);
+    }
