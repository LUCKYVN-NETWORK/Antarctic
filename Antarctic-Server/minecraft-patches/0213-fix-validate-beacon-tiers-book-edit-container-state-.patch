+    private static PacketPlayInCustomPayload customPayload(String channel, byte[] bytes) throws Exception {
+        PacketDataSerializer buf = new PacketDataSerializer(Unpooled.wrappedBuffer(bytes));
+        PacketPlayInCustomPayload pkt = new PacketPlayInCustomPayload();
+        Field a = PacketPlayInCustomPayload.class.getDeclaredField("a");
+        Field b = PacketPlayInCustomPayload.class.getDeclaredField("b");
+        a.setAccessible(true);
+        b.setAccessible(true);
+        a.set(pkt, channel);
+        b.set(pkt, buf);
+        return pkt;
+    }
