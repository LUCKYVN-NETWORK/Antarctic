diff --git a/main/java/net/minecraft/server/TileEntityBeacon.java b/main/java/net/minecraft/server/TileEntityBeacon.java
index a3a4dab..71c9420 100644
--- a/main/java/net/minecraft/server/TileEntityBeacon.java
+++ b/main/java/net/minecraft/server/TileEntityBeacon.java
@@ -324,6 +324,41 @@ public class TileEntityBeacon extends TileEntityContainer implements ITickable,
         return TileEntityBeacon.f.contains(mobeffectlist) ? mobeffectlist : null;
     }
 
+    static boolean isValidTierSelection(int levels, int primaryId, int secondaryId) {
+        if (levels <= 0) {
+            return false;
+        }
+        MobEffectList primary = f(primaryId);
+        if (primary == null) {
+            return false;
+        }
+        int maxPrimaryRow = Math.min(levels, 3);
+        boolean primaryAllowed = false;
+        for (int row = 0; row < maxPrimaryRow; ++row) {
+            MobEffectList[] rowEffects = TileEntityBeacon.a[row];
+            for (int col = 0; col < rowEffects.length; ++col) {
+                if (rowEffects[col] == primary) {
+                    primaryAllowed = true;
+                    break;
+                }
+            }
+            if (primaryAllowed) {
+                break;
+            }
+        }
+        if (!primaryAllowed) {
+            return false;
+        }
+        if (secondaryId <= 0) {
+            return true;
+        }
+        if (levels < 4) {
+            return false;
+        }
+        MobEffectList secondary = f(secondaryId);
+        return secondary != null && (secondary == primary || secondary == MobEffects.REGENERATION);
+    }
