+    private static DummyWorld createWorld() throws Exception {
+        DummyWorld world = (DummyWorld) UNSAFE.allocateInstance(DummyWorld.class);
+        Field csField = World.class.getDeclaredField("isClientSide");
+        csField.setAccessible(true);
+        csField.setBoolean(world, true);
+        world.worldData = new WorldData();
+        world.worldProvider = new WorldProviderNormal();
+        Field uField = World.class.getDeclaredField("u");
+        uField.setAccessible(true);
+        uField.set(world, Collections.emptyList());
+        return world;
+    }
+
+    private static RecordingPlayerConnection createConnection(DummyWorld world) throws Exception {
+        RecordingPlayerConnection conn = (RecordingPlayerConnection) UNSAFE.allocateInstance(RecordingPlayerConnection.class);
+        Field spField = RecordingPlayerConnection.class.getDeclaredField("sentPackets");
+        spField.setAccessible(true);
+        spField.set(conn, new ArrayList<>());
+        Field nmField = PlayerConnection.class.getDeclaredField("networkManager");
+        nmField.setAccessible(true);
+        nmField.set(conn, UNSAFE.allocateInstance(DummyNetworkManager.class));
+
+        EntityPlayer player = (EntityPlayer) UNSAFE.allocateInstance(EntityPlayer.class);
+        player.world = world;
+        player.playerConnection = conn;
+        player.locX = 0.0D;
+        player.locY = 64.0D;
+        player.locZ = 0.0D;
+        CraftPlayer craftPlayer = (CraftPlayer) UNSAFE.allocateInstance(CraftPlayer.class);
+        Field entityField = CraftEntity.class.getDeclaredField("entity");
+        entityField.setAccessible(true);
+        entityField.set(craftPlayer, player);
+        Field cpHealth = CraftPlayer.class.getDeclaredField("health");
+        cpHealth.setAccessible(true);
+        cpHealth.setDouble(craftPlayer, 20.0D);
+        Field beField = Entity.class.getDeclaredField("bukkitEntity");
+        beField.setAccessible(true);
+        beField.set(player, craftPlayer);
+        DataWatcher dw = new DataWatcher(player);
+        dw.register(EntityLiving.HEALTH, 20.0F);
+        Field dwField = Entity.class.getDeclaredField("datawatcher");
+        dwField.setAccessible(true);
+        dwField.set(player, dw);
+        player.inventory = new PlayerInventory(player);
+        ContainerPlayer container = new ContainerPlayer(player.inventory, true, player);
+        container.windowId = 0;
+        player.defaultContainer = container;
+        player.activeContainer = container;
