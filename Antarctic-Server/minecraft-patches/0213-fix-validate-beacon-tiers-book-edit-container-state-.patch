+    @Test
+    public void testContainerMerchantReachAndVirtualMerchantAndTrSel() throws Exception {
+        DummyWorld worldA = createWorld();
+        DummyWorld worldB = createWorld();
+        RecordingPlayerConnection conn = createConnection(worldA);
+        EntityPlayer player = conn.player;
+
+        // 1. Virtual non-Entity IMerchant works cleanly
+        IMerchant virtualMerchant = new IMerchant() {
+            private EntityHuman trader = player;
+            @Override public void setTradingPlayer(EntityHuman h) { trader = h; }
+            @Override public EntityHuman getTrader() { return trader; }
+            @Override public MerchantRecipeList getOffers(EntityHuman h) { return new MerchantRecipeList(); }
+            @Override public void a(MerchantRecipe r) {}
+            @Override public void a(ItemStack s) {}
+            @Override public IChatBaseComponent getScoreboardDisplayName() { return new ChatComponentText("Virtual"); }
+            @Override public World u_() { return worldA; }
+            @Override public BlockPosition v_() { return BlockPosition.ZERO; }
+        };
+        ContainerMerchant virtualContainer = new ContainerMerchant(player.inventory, virtualMerchant, worldA);
+        assertTrue("Virtual non-Entity merchant must remain usable", virtualContainer.canUse(player));
+
+        // 2. Real EntityVillager enforces valid, alive, world, reach
+        EntityVillager villager = (EntityVillager) UNSAFE.allocateInstance(EntityVillager.class);
+        villager.world = worldA;
+        villager.valid = true;
+        villager.dead = false;
+        villager.locX = 2.0D;
+        villager.locY = 64.0D;
+        villager.locZ = 0.0D;
+        DataWatcher vdw = new DataWatcher(villager);
+        vdw.register(EntityLiving.HEALTH, 20.0F);
+        Field vdwField = Entity.class.getDeclaredField("datawatcher");
+        vdwField.setAccessible(true);
+        vdwField.set(villager, vdw);
+        villager.setTradingPlayer(player);
+        ContainerMerchant villagerContainer = new ContainerMerchant(player.inventory, villager, worldA);
+        assertTrue(villagerContainer.canUse(player));
+
+        villager.valid = false;
+        assertFalse(villagerContainer.canUse(player));
+        villager.valid = true;
+
+        villager.dead = true;
+        assertFalse(villagerContainer.canUse(player));
+        villager.dead = false;
+
+        villager.world = worldB;
+        assertFalse(villagerContainer.canUse(player));
+        villager.world = worldA;
+
+        villager.locX = 10.0D;
+        assertFalse(villagerContainer.canUse(player));
+
+        // checkReachable = false honors remote plugin merchant while still enforcing alive/valid
+        villagerContainer.checkReachable = false;
+        assertTrue("checkReachable=false must allow remote plugin merchant", villagerContainer.canUse(player));
+        villager.dead = true;
+        assertFalse("checkReachable=false must still reject dead merchant", villagerContainer.canUse(player));
+        villager.dead = false;
+
+        // 3. MC|TrSel rejects negative trade index
+        villager.locX = 2.0D;
+        villagerContainer.checkReachable = true;
+        villagerContainer.windowId = 5;
+        player.activeContainer = villagerContainer;
+        PacketDataSerializer trBuf = new PacketDataSerializer(Unpooled.buffer());
+        trBuf.writeInt(-1);
+        byte[] trBytes = new byte[trBuf.readableBytes()];
+        trBuf.readBytes(trBytes);
+        conn.a(customPayload("MC|TrSel", trBytes));
+        assertFalse(conn.disconnected);
+    }
