+    @Test
+    public void testBeaconTierValidationAndPacketGuard() throws Exception {
+        assertFalse(TileEntityBeacon.isValidTierSelection(0, MobEffectList.getId(MobEffects.FASTER_MOVEMENT), 0));
+        assertTrue(TileEntityBeacon.isValidTierSelection(1, MobEffectList.getId(MobEffects.FASTER_MOVEMENT), 0));
+        assertTrue(TileEntityBeacon.isValidTierSelection(1, MobEffectList.getId(MobEffects.FASTER_DIG), 0));
+        assertFalse("Tier 1 beacon must reject Strength", TileEntityBeacon.isValidTierSelection(1, MobEffectList.getId(MobEffects.INCREASE_DAMAGE), 0));
+        assertFalse("Tier 1 beacon must reject secondary Regen", TileEntityBeacon.isValidTierSelection(1, MobEffectList.getId(MobEffects.FASTER_MOVEMENT), MobEffectList.getId(MobEffects.REGENERATION)));
+        assertTrue("Tier 4 must accept Speed II", TileEntityBeacon.isValidTierSelection(4, MobEffectList.getId(MobEffects.FASTER_MOVEMENT), MobEffectList.getId(MobEffects.FASTER_MOVEMENT)));
+        assertTrue("Tier 4 must accept Speed + Regen", TileEntityBeacon.isValidTierSelection(4, MobEffectList.getId(MobEffects.FASTER_MOVEMENT), MobEffectList.getId(MobEffects.REGENERATION)));
+        assertFalse("Regen cannot be primary effect", TileEntityBeacon.isValidTierSelection(4, MobEffectList.getId(MobEffects.REGENERATION), 0));
+        assertFalse("Invalid potion effect must be rejected", TileEntityBeacon.isValidTierSelection(4, MobEffectList.getId(MobEffects.LEVITATION), 0));
+
+        // SPIGOT-3598: TileEntityBeacon.load(NBT) must preserve manually set non-default effects
+        TileEntityBeacon loadedBeacon = new TileEntityBeacon();
+        NBTTagCompound tag = new NBTTagCompound();
+        tag.setInt("Levels", 1);
+        tag.setInt("Primary", MobEffectList.getId(MobEffects.INCREASE_DAMAGE));
+        tag.setInt("Secondary", MobEffectList.getId(MobEffects.REGENERATION));
+        loadedBeacon.load(tag);
+        assertEquals(MobEffects.INCREASE_DAMAGE, loadedBeacon.primaryEffect);
+        assertEquals(MobEffects.REGENERATION, loadedBeacon.secondaryEffect);
+
+        // MC|Beacon packet guard
+        DummyWorld world = createWorld();
+        RecordingPlayerConnection conn = createConnection(world);
+        TileEntityBeacon beacon = new TileEntityBeacon() {
+            @Override
+            public boolean a(EntityHuman human) {
+                return true;
+            }
+        };
+        beacon.setProperty(0, 1);
+        beacon.setItem(0, new ItemStack(Items.EMERALD, 1));
+        ContainerBeacon containerBeacon = new ContainerBeacon(conn.player.inventory, beacon);
+        containerBeacon.windowId = 3;
+        conn.player.activeContainer = containerBeacon;
+
+        PacketDataSerializer badBuf = new PacketDataSerializer(Unpooled.buffer());
+        badBuf.writeInt(MobEffectList.getId(MobEffects.INCREASE_DAMAGE));
+        badBuf.writeInt(0);
+        byte[] badBytes = new byte[badBuf.readableBytes()];
+        badBuf.readBytes(badBytes);
+        conn.a(customPayload("MC|Beacon", badBytes));
+        assertFalse(conn.disconnected);
+        assertEquals("Rejected MC|Beacon must not consume payment item", 1, beacon.getItem(0).getCount());
+        assertNull(beacon.primaryEffect);
+        assertFalse("Rejected MC|Beacon must send resync", conn.sentPackets.isEmpty());
+
+        PacketDataSerializer goodBuf = new PacketDataSerializer(Unpooled.buffer());
+        goodBuf.writeInt(MobEffectList.getId(MobEffects.FASTER_MOVEMENT));
+        goodBuf.writeInt(0);
+        byte[] goodBytes = new byte[goodBuf.readableBytes()];
+        goodBuf.readBytes(goodBytes);
+        conn.a(customPayload("MC|Beacon", goodBytes));
+        assertTrue("Valid MC|Beacon must consume payment item", beacon.getItem(0).isEmpty());
+        assertEquals(MobEffects.FASTER_MOVEMENT, beacon.primaryEffect);
+    }
