+    @Test
+    public void testBeaconValidationEfficiency() {
+        int idSpeed = MobEffectList.getId(MobEffects.FASTER_MOVEMENT);
+        int idRegen = MobEffectList.getId(MobEffects.REGENERATION);
+        for (int i = 0; i < 5_000; i++) {
+            TileEntityBeacon.isValidTierSelection(4, idSpeed, idRegen);
+        }
+        int valid = 0;
+        long start = System.nanoTime();
+        for (int i = 0; i < 50_000; i++) {
+            if (TileEntityBeacon.isValidTierSelection(4, idSpeed, idRegen)) {
+                valid++;
+            }
+        }
+        long elapsedMs = (System.nanoTime() - start) / 1_000_000L;
+        assertEquals(50_000, valid);
+        assertTrue("50k beacon tier checks took too long: " + elapsedMs + " ms", elapsedMs < 50L);
+    }
