+    @Test
+    public void testBookEditAndSignRequireDefaultContainerAndAlive() throws Exception {
+        DummyWorld world = createWorld();
+        RecordingPlayerConnection conn = createConnection(world);
+        ContainerChest chest = new ContainerChest(conn.player.inventory, new InventorySubcontainer("Chest", false, 27), conn.player);
+        chest.windowId = 4;
+        conn.player.activeContainer = chest;
+
+        Field lbtField = PlayerConnection.class.getDeclaredField("lastBookTick");
+        lbtField.setAccessible(true);
+        lbtField.setInt(conn, -999);
+
+        conn.a(customPayload("MC|BEdit", new byte[0]));
+        assertFalse(conn.disconnected);
+        assertFalse("Non-default container MC|BEdit must send resync", conn.sentPackets.isEmpty());
+        assertEquals("Non-default container MC|BEdit must abort before lastBookTick", -999, lbtField.getInt(conn));
+
+        conn.sentPackets.clear();
+        conn.player.activeContainer = conn.player.defaultContainer;
+        conn.player.dead = true;
+        conn.a(customPayload("MC|BSign", new byte[0]));
+        assertFalse(conn.disconnected);
+        assertTrue("Dead player MC|BSign must return cleanly without resync spam", conn.sentPackets.isEmpty());
+    }
