+    @Test
+    public void testHorseDieClosesViewersAndClearsSlots() throws Exception {
+        DummyWorld world = createWorld(false);
+        EntityPlayer player = createMockPlayer(world, 1.0D, 64.0D, 0.0D);
+        EntityHorseDonkey donkey = createMockDonkey(world, true);
+
+        donkey.inventoryChest.setItem(0, new ItemStack(Items.SADDLE, 1));
+        donkey.inventoryChest.setItem(2, new ItemStack(Items.DIAMOND, 16));
+
+        TrackingCraftPlayer viewer = (TrackingCraftPlayer) player.getBukkitEntity();
+        viewer.backingInventory = donkey.inventoryChest;
+        donkey.inventoryChest.onOpen(viewer);
+
+        try {
+            donkey.die(DamageSource.GENERIC);
+        } catch (NullPointerException expectedFromCraftEventFactoryWithoutServer) {
+            // EntityLiving.die() invokes CraftEventFactory.callEntityDeathEvent after EntityHorseAbstract.die()
+            // has already closed viewers and drained+cleared inventoryChest.
+        }
+
+        assertEquals("Horse die() must close open chest viewers", 1, viewer.closeCount);
+        assertTrue("Viewer must be removed from transaction list", donkey.inventoryChest.transaction.isEmpty());
+        for (int i = 0; i < donkey.inventoryChest.getSize(); i++) {
+            assertTrue("Slot " + i + " must be cleared on die() to prevent duplication", donkey.inventoryChest.getItem(i).isEmpty());
+        }
+        assertFalse("Killed chested donkey must drop its items", world.spawnedEntities.isEmpty());
+    }
