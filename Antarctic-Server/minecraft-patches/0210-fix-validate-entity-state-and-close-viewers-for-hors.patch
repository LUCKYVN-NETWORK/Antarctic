+    @Test
+    public void testContainerHorseRejectsInvalidEntityStatesAndAcceptsValidStates() throws Exception {
+        DummyWorld worldA = createWorld(true);
+        DummyWorld worldB = createWorld(true);
+        EntityPlayer player = createMockPlayer(worldA, 2.0D, 64.0D, 0.0D);
+
+        // Chestless donkey opened for saddle must still work
+        EntityHorseDonkey saddleDonkey = createMockDonkey(worldA, false);
+        ContainerHorse saddleContainer = new ContainerHorse(player.inventory, saddleDonkey.inventoryChest, saddleDonkey, player);
+        assertTrue("Chestless horse/donkey saddle container must remain usable", saddleContainer.canUse(player));
+
+        // Chested donkey in range, same world
+        EntityHorseDonkey donkey = createMockDonkey(worldA, true);
+        ContainerHorse container = new ContainerHorse(player.inventory, donkey.inventoryChest, donkey, player);
+        assertTrue("Valid chested donkey in range must be usable", container.canUse(player));
+
+        // 1. valid = false (unloaded chunk)
+        donkey.valid = false;
+        assertFalse("Unloaded/removed horse must fail canUse", container.canUse(player));
+        donkey.valid = true;
+
+        // 2. dead = true
+        donkey.dead = true;
+        assertFalse("Dead horse must fail canUse", container.canUse(player));
+        donkey.dead = false;
+
+        // 3. inventoryChest replaced (loadChest())
+        donkey.loadChest();
+        assertFalse("Replaced inventoryChest must fail canUse", container.canUse(player));
+
+        // Re-open with new chest
+        container = new ContainerHorse(player.inventory, donkey.inventoryChest, donkey, player);
+        assertTrue(container.canUse(player));
+
+        // 4. chest removed after opening
+        donkey.setCarryingChest(false);
+        assertFalse("Removed chest after opening must fail canUse", container.canUse(player));
+        donkey.setCarryingChest(true);
+
+        // 5. distance >= 8.0 blocks (64.0 sq)
+        player.locX = 8.0D;
+        assertFalse("Out-of-range horse (>= 8 blocks) must fail canUse", container.canUse(player));
+        player.locX = 2.0D;
+
+        // 6. world mismatch
+        player.world = worldB;
+        assertFalse("Cross-world horse must fail canUse", container.canUse(player));
+
+        // 7. checkReachable = false honors remote plugin GUI while still enforcing valid/alive
+        container.checkReachable = false;
+        assertTrue("checkReachable=false must allow remote plugin GUI when alive and valid", container.canUse(player));
+        donkey.dead = true;
+        assertFalse("checkReachable=false must still reject dead horse", container.canUse(player));
+    }
