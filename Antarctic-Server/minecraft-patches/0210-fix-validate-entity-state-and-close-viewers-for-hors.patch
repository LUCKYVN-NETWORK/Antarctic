+    @Test
+    public void testCanUseAndEmptyViewerCloseEfficiency() throws Exception {
+        DummyWorld world = createWorld(true);
+        EntityPlayer player = createMockPlayer(world, 2.0D, 64.0D, 0.0D);
+        EntityHorseDonkey donkey = createMockDonkey(world, true);
+        ContainerHorse container = new ContainerHorse(player.inventory, donkey.inventoryChest, donkey, player);
+        EntityMinecartChest cart = createMockMinecartChest(world);
+
+        for (int i = 0; i < 5_000; i++) {
+            container.canUse(player);
+            cart.a((EntityHuman) player);
+            donkey.closeChestViewers();
+            cart.closeContainerViewers();
+        }
+
+        long start = System.nanoTime();
+        int ok = 0;
+        for (int i = 0; i < 50_000; i++) {
+            if (container.canUse(player) && cart.a((EntityHuman) player)) {
+                ok++;
+            }
+            donkey.closeChestViewers();
+            cart.closeContainerViewers();
+        }
+        long elapsedMs = (System.nanoTime() - start) / 1_000_000L;
+        assertEquals(50_000, ok);
+        assertTrue("50k container checks took too long: " + elapsedMs + " ms", elapsedMs < 100L);
+    }
