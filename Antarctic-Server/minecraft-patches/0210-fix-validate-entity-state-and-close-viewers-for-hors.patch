+    @Test
+    public void testMinecartContainerGuardsAndWorldRemoval() throws Exception {
+        DummyWorld worldA = createWorld(true);
+        DummyWorld worldB = createWorld(true);
+        EntityPlayer player = createMockPlayer(worldA, 2.0D, 64.0D, 0.0D);
+        EntityMinecartChest cart = createMockMinecartChest(worldA);
+
+        assertTrue("Valid minecart in range must be usable", cart.a((EntityHuman) player));
+
+        cart.valid = false;
+        assertFalse("Invalid/unloaded minecart must fail a(EntityHuman)", cart.a((EntityHuman) player));
+        cart.valid = true;
+
+        cart.dead = true;
+        assertFalse("Dead minecart must fail a(EntityHuman)", cart.a((EntityHuman) player));
+        cart.dead = false;
+
+        player.world = worldB;
+        assertFalse("Cross-world minecart must fail a(EntityHuman)", cart.a((EntityHuman) player));
+        player.world = worldA;
+
+        player.locX = 9.0D;
+        assertFalse("Out-of-range minecart must fail a(EntityHuman)", cart.a((EntityHuman) player));
+        player.locX = 2.0D;
+
+        TrackingCraftPlayer viewer = (TrackingCraftPlayer) player.getBukkitEntity();
+        viewer.backingInventory = cart;
+        cart.onOpen(viewer);
+
+        // World.c(Entity) must close open viewers before valid=false
+        worldA.c(cart);
+        assertEquals("World.c(Entity) must close minecart viewers", 1, viewer.closeCount);
+        assertFalse("World.c(Entity) must mark entity invalid", cart.valid);
+        assertTrue("Minecart transaction list must be empty after close", cart.transaction.isEmpty());
+
+        // die() also closes viewers cleanly
+        cart.valid = true;
+        cart.onOpen(viewer);
+        cart.die();
+        assertEquals("Minecart die() must close open viewers", 2, viewer.closeCount);
+        assertTrue(cart.transaction.isEmpty());
+    }
