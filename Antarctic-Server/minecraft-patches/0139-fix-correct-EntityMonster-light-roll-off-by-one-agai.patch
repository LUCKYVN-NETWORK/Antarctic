From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: StellarSeal <emnoigi1452@gmail.com>
Date: Tue, 24 Nov 2026 01:11:36 +0700
Subject: [PATCH 139/167] fix: correct EntityMonster light roll off-by-one
 against MCP-940


diff --git a/main/java/net/minecraft/server/EntityMonster.java b/main/java/net/minecraft/server/EntityMonster.java
index 670451c..3004735 100644
--- a/main/java/net/minecraft/server/EntityMonster.java
+++ b/main/java/net/minecraft/server/EntityMonster.java
@@ -132,9 +132,9 @@ public abstract class EntityMonster extends EntityCreature implements IMonster {
                 int j = this.world.ah();
 
                 this.world.c(10);
-                passes = !world.isLightLevel(blockposition, this.random.nextInt(9)); // Paper
+                passes = !world.isLightLevel(blockposition, this.random.nextInt(8) + 1); // Paper / Antarctic - exact MCP-940 parity (light <= nextInt(8))
                 this.world.c(j);
-            } else { passes = !world.isLightLevel(blockposition, this.random.nextInt(9)); } // Paper
+            } else { passes = !world.isLightLevel(blockposition, this.random.nextInt(8) + 1); } // Paper / Antarctic
 
             return passes; // Paper
         }
diff --git a/main/java/net/minecraft/server/SpawnerCreature.java b/main/java/net/minecraft/server/SpawnerCreature.java
index 109281a..0417796 100644
--- a/main/java/net/minecraft/server/SpawnerCreature.java
+++ b/main/java/net/minecraft/server/SpawnerCreature.java
@@ -220,14 +220,14 @@ public final class SpawnerCreature {
             if (world.X()) {
                 int savedSkySubtracted = world.ah();
                 world.c(10);
-                passes = !world.isLightLevel(pos, world.random.nextInt(9));
+                passes = !world.isLightLevel(pos, world.random.nextInt(8) + 1);
                 world.c(savedSkySubtracted);
             } else {
-                passes = !world.isLightLevel(pos, world.random.nextInt(9));
+                passes = !world.isLightLevel(pos, world.random.nextInt(8) + 1);
             }
             return passes;
         }
-        // Deterministic mode: EntityMonster.s_() checks !world.isLightLevel(pos, nextInt(9)), max roll is 8.
+        // Deterministic mode: EntityMonster.s_() checks !world.isLightLevel(pos, nextInt(8) + 1), max roll is 8.
         // Whenever effective light >= 8 (accounting for thunderstorm skySubtracted=10), s_() always returns false.
         boolean tooBright;
         if (world.X()) {
diff --git a/test/java/net/minecraft/server/EntityMonsterLightRollParityTest.java b/test/java/net/minecraft/server/EntityMonsterLightRollParityTest.java
new file mode 100644
index 0000000..ee8f23b
--- /dev/null
+++ b/test/java/net/minecraft/server/EntityMonsterLightRollParityTest.java
@@ -0,0 +1,88 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.MobSpawning;
+import java.lang.reflect.Field;
+import java.util.Random;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class EntityMonsterLightRollParityTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    @Test
+    public void testPitchBlackZeroLightAlwaysPassesMonsterSpawnCheck() throws Exception {
+        World world = (World) unsafe.allocateInstance(WorldServer.class);
+        Random zeroRng = new Random(0L) {
+            @Override
+            public int nextInt(int bound) {
+                return 0; // worst-case roll: previously nextInt(9) returned 0 and rejected light==0!
+            }
+        };
+        Field rngField = World.class.getDeclaredField("random");
+        rngField.setAccessible(true);
+        rngField.set(world, zeroRng);
+        WorldData wd = (WorldData) unsafe.allocateInstance(WorldData.class);
+        Field diffField = WorldData.class.getDeclaredField("C");
+        diffField.setAccessible(true);
+        diffField.set(wd, EnumDifficulty.NORMAL);
+        Field wdField = World.class.getDeclaredField("worldData");
+        wdField.setAccessible(true);
+        wdField.set(world, wd);
+        WorldProviderNormal provider = new WorldProviderNormal();
+        provider.f = true;
+        provider.a();
+        Field wpField = World.class.getDeclaredField("worldProvider");
+        wpField.setAccessible(true);
+        wpField.set(world, provider);
+
+        Chunk chunk = (Chunk) unsafe.allocateInstance(Chunk.class);
+        Field cwField = Chunk.class.getDeclaredField("world");
+        cwField.setAccessible(true);
+        cwField.set(chunk, world);
+        ChunkSection[] sections = new ChunkSection[16];
+        sections[4] = new ChunkSection(64, true);
+        sections[4].a(5, 0, 5, 0);
+        sections[4].b(5, 0, 5, 0);
+        Field secField = Chunk.class.getDeclaredField("sections");
+        secField.setAccessible(true);
+        secField.set(chunk, sections);
+
+        ChunkProviderServer cps = (ChunkProviderServer) unsafe.allocateInstance(ChunkProviderServer.class);
+        Field cpsWorld = ChunkProviderServer.class.getDeclaredField("world");
+        cpsWorld.setAccessible(true);
+        cpsWorld.set(cps, world);
+        cps.chunks = new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+        cps.chunks.put(ChunkCoordIntPair.a(0, 0), chunk);
+        Field cpField = World.class.getDeclaredField("chunkProvider");
+        cpField.setAccessible(true);
+        cpField.set(world, cps);
+        Field pcField = World.class.getDeclaredField("paperConfig");
+        pcField.setAccessible(true);
+        pcField.set(world, unsafe.allocateInstance(com.destroystokyo.paper.PaperWorldConfig.class));
+
+        BlockPosition pos = new BlockPosition(5, 64, 5);
+        int precheck = SpawnerCreature.precheckSpawn(world, chunk, EntityZombie.class, pos, MobSpawning.PRECHECK_SINGLE_ROLL);
+        Assert.assertNotEquals("Light 0 must NEVER be rejected on nextInt(8)==0 roll (vanilla 100% pass)",
+                SpawnerCreature.PRECHECK_RESULT_REJECT, precheck);
+
+        EntityZombie zombie = (EntityZombie) unsafe.allocateInstance(EntityZombie.class);
+        zombie.world = world;
+        zombie.random = world.random;
+        zombie.locX = 5.5D;
+        zombie.locY = 64.0D;
+        zombie.locZ = 5.5D;
+        zombie.a(new AxisAlignedBB(5.2D, 64.0D, 5.2D, 5.8D, 65.8D, 5.8D));
+        Assert.assertTrue("EntityMonster.s_() must return true for light 0 when nextInt(8) rolls 0", zombie.s_());
+    }
+}
