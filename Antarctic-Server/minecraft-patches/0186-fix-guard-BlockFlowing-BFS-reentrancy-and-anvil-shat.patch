+        } else {
+            bfs = new FlowBfsState();
+        }
         if (bfs.nextStamp > Integer.MAX_VALUE - 32) {
             java.util.Arrays.fill(bfs.stamp, 0);
             bfs.nextStamp = 10;
@@ -371,6 +381,9 @@ public class BlockFlowing extends BlockFluids {
             chunks[1] = null;
             chunks[2] = null;
             chunks[3] = null;
+            if (pooled) {
+                bfs.inUse = false;
+            }
         }
     }
 
