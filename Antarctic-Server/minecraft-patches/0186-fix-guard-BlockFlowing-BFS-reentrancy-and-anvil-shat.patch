diff --git a/test/java/net/minecraft/server/FluidReentrancyAndAnvilShatterTest.java b/test/java/net/minecraft/server/FluidReentrancyAndAnvilShatterTest.java
new file mode 100644
index 0000000..6353071
--- /dev/null
+++ b/test/java/net/minecraft/server/FluidReentrancyAndAnvilShatterTest.java
@@ -0,0 +1,207 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.PaperWorldConfig;
+import com.destroystokyo.paper.antixray.ChunkPacketBlockController;
+import it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Random;
+import java.util.Set;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import org.spigotmc.SpigotWorldConfig;
+import sun.misc.Unsafe;
+
+public class FluidReentrancyAndAnvilShatterTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void init() throws Exception {
+        DispenserRegistry.c();
+        org.spigotmc.AsyncCatcher.enabled = false;
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    private static Chunk createChunk(World world, int cx, int cz) throws Exception {
+        Chunk c = (Chunk) unsafe.allocateInstance(Chunk.class);
+        Field wf = Chunk.class.getDeclaredField("world");
+        wf.setAccessible(true);
+        wf.set(c, world);
+        Field lx = Chunk.class.getDeclaredField("locX");
+        lx.setAccessible(true);
+        lx.setInt(c, cx);
+        Field lz = Chunk.class.getDeclaredField("locZ");
+        lz.setAccessible(true);
+        lz.setInt(c, cz);
+        Field sf = Chunk.class.getDeclaredField("sections");
+        sf.setAccessible(true);
+        ChunkSection[] secs = new ChunkSection[16];
+        for (int i = 0; i < 16; i++) {
+            secs[i] = Chunk.a;
+        }
+        secs[4] = new ChunkSection(64, true);
+        sf.set(c, secs);
+        int[] hard = new int[16];
+        hard[4] = 1;
+        unsafe.putObject(c, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("hardCollidableCounts")), hard);
+        unsafe.putObject(c, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("heightMap")), new int[256]);
+        @SuppressWarnings("unchecked")
+        java.util.List<Entity>[] slices = new java.util.List[16];
+        for (int i = 0; i < 16; i++) {
+            slices[i] = new ArrayList<>();
+        }
+        unsafe.putObject(c, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("entitySlices")), slices);
+        unsafe.putObject(c, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("entityCounts")), new co.aikar.util.Counter<>());
+        return c;
+    }
+
+    private static final class ReentrantFluidWorld extends WorldServer {
+        final Long2ObjectOpenHashMap<Chunk> map = new Long2ObjectOpenHashMap<>();
+        boolean triggeredNested = false;
+        int nestedResult;
+
+        ReentrantFluidWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public Chunk getChunkIfLoaded(int x, int z) {
+            return map.get(ChunkCoordIntPair.a(x, z));
+        }
+
+        @Override
+        public Chunk getChunkAt(int x, int z) {
+            Chunk c = map.get(ChunkCoordIntPair.a(x, z));
+            if (c == null) {
+                try {
+                    c = createChunk(this, x, z);
+                    map.put(ChunkCoordIntPair.a(x, z), c);
+                    if (!triggeredNested) {
+                        triggeredNested = true;
+                        // Simulate WorldGenLiquids calling BlockFlowing re-entrantly during neighbor chunk population
+                        nestedResult = ((BlockFlowing) Blocks.FLOWING_WATER).getFlowDirections(this, new BlockPosition((x << 4) + 8, 65, (z << 4) + 8));
+                    }
+                } catch (Exception e) {
+                    throw new RuntimeException(e);
+                }
+            }
+            return c;
+        }
+
+        @Override
+        public boolean isChunkLoaded(int x, int z, boolean allowEmpty) {
+            return map.containsKey(ChunkCoordIntPair.a(x, z));
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static ReentrantFluidWorld createWorld() throws Exception {
+        ReentrantFluidWorld world = (ReentrantFluidWorld) unsafe.allocateInstance(ReentrantFluidWorld.class);
+        Field mapField = ReentrantFluidWorld.class.getDeclaredField("map");
+        mapField.setAccessible(true);
+        Long2ObjectOpenHashMap<Chunk> map = new Long2ObjectOpenHashMap<>();
+        mapField.set(world, map);
+
+        world.worldData = new WorldData();
+        world.u = new ArrayList<>();
+        world.J = new int[32768];
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("players")), new ArrayList<>());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("j")), new ArrayList<>());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("f")), new HashSet<>());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("entityList")), new ArrayList<>());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("tileEntityListTick")), new World.TickableTileEntityList());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("b")), new ArrayList<>());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("tileEntityListUnload")), new HashSet<>());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("random")), new Random(42L));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("spigotConfig")), unsafe.allocateInstance(SpigotWorldConfig.class));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("paperConfig")), unsafe.allocateInstance(PaperWorldConfig.class));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("chunkPacketBlockController")), new ChunkPacketBlockController() {});
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("pendingLight")), new me.stella.antarctic.collection.PendingLightRegistry(256));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("methodProfiler")), new MethodProfiler());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("P")), new WorldBorder());
+        world.worldProvider = new WorldProviderNormal();
+        world.worldProvider.a(world);
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("chunkProvider")), new IChunkProvider() {
+            @Override
+            public Chunk getLoadedChunkAt(int x, int z) {
+                return world.getChunkIfLoaded(x, z);
+            }
+
+            @Override
+            public Chunk getChunkAt(int x, int z) {
+                return world.getChunkAt(x, z);
+            }
+
+            @Override
+            public boolean unloadChunks() {
+                return false;
+            }
+
+            @Override
+            public String getName() {
+                return "test";
+            }
+
+            @Override
+            public boolean e(int x, int z) {
+                return world.isChunkLoaded(x, z, true);
+            }
+        });
+
+        Chunk c0 = createChunk(world, 0, 0);
+        // Stone floor at y=64 except drop hole at x=16 (in chunk 1,0)
+        for (int x = 10; x < 16; x++) {
+            for (int z = 4; z <= 12; z++) {
+                c0.getSections()[4].setType(x, 0, z, Blocks.STONE.getBlockData());
+            }
+        }
+        map.put(ChunkCoordIntPair.a(0, 0), c0);
+        return world;
+    }
+
+    @Test
+    public void testBlockFlowingReentrantBfsDoesNotCorruptOrCrash() throws Exception {
+        ReentrantFluidWorld world = createWorld();
+        // Flow source at x=15, y=65, z=8 (1 block from unloaded chunk 1,0)
+        int outerMask = ((BlockFlowing) Blocks.FLOWING_WATER).getFlowDirections(world, new BlockPosition(15, 65, 8));
+        Assert.assertTrue("Nested getFlowDirections must have triggered during getChunkAt", world.triggeredNested);
+        Assert.assertTrue("Nested flow mask should be non-zero", world.nestedResult != 0);
+        // BlockFlowing uses DX = {0, 1, 0, -1}, DZ = {-1, 0, 1, 0} (NORTH=0, EAST=1, SOUTH=2, WEST=3)
+        int eastBit = 1 << 1;
+        Assert.assertTrue("Outer flow must still find EAST drop into chunk (1,0), mask=" + outerMask, (outerMask & eastBit) != 0);
+    }
+
+    @Test
+    public void testShatteringFallingAnvilDoesNotNpe() throws Exception {
+        ReentrantFluidWorld world = createWorld();
+        final BlockPosition[] shatteredPos = new BlockPosition[1];
+        IWorldAccess access = (IWorldAccess) java.lang.reflect.Proxy.newProxyInstance(
+            IWorldAccess.class.getClassLoader(),
+            new Class<?>[] { IWorldAccess.class },
+            (proxy, method, args) -> {
+                if ("a".equals(method.getName()) && args != null && args.length == 4
+                    && args[1] instanceof Integer && ((Integer) args[1]) == 1029) {
+                    shatteredPos[0] = (BlockPosition) args[2];
+                }
+                return null;
+            }
+        );
+        world.u.add(access);
+        Chunk c0 = world.getChunkAt(0, 0);
+        c0.getSections()[4].setType(8, 0, 8, Blocks.STONE.getBlockData());
+        EntityFallingBlock anvil = new EntityFallingBlock(world, 8.5D, 65.0D, 8.5D, Blocks.ANVIL.getBlockData());
+        anvil.motY = -0.1D;
+        anvil.ticksLived = 1;
+        Field fField = EntityFallingBlock.class.getDeclaredField("f");
+        fField.setAccessible(true);
+        fField.setBoolean(anvil, true); // Shattered anvil
+        anvil.B_();
+        Assert.assertTrue(anvil.dead);
+        Assert.assertEquals(new BlockPosition(8, 65, 8), shatteredPos[0]);
+    }
+}
