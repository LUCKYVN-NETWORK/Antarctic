+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.ChunkLoading;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.bukkit.craftbukkit.chunkio.ChunkIOExecutor;
+import org.bukkit.craftbukkit.util.AsynchronousExecutor;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class ChunkLoadingScalingTest {
+
+    private static Unsafe unsafe;
+    private boolean prevAsyncCatcher;
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        Field uf = Unsafe.class.getDeclaredField("theUnsafe");
+        uf.setAccessible(true);
+        unsafe = (Unsafe) uf.get(null);
+    }
+
+    @Before
+    public void disableAsyncCatcher() {
+        this.prevAsyncCatcher = org.spigotmc.AsyncCatcher.enabled;
+        org.spigotmc.AsyncCatcher.enabled = false;
+    }
+
+    @After
+    public void restoreDefaults() {
+        ChunkLoading.maxStage2MillisPerTick = 0;
+        ChunkLoading.maxStage2ChunkLoadsPerTick = 0;
+        org.spigotmc.AsyncCatcher.enabled = this.prevAsyncCatcher;
+    }
+
+    @Test
+    public void configDefaultsPreserveVanillaParity() {
+        assertEquals(0, ChunkLoading.maxStage2MillisPerTick);
+        assertEquals(0, ChunkLoading.maxStage2ChunkLoadsPerTick);
+    }
+
+    @Test
+    public void adjustPoolSizeFixesIntegerTruncation() {
+        assertEquals(2, ChunkIOExecutor.computePoolSize(0, 2));
+        assertEquals(2, ChunkIOExecutor.computePoolSize(50, 2));
+        assertEquals(2, ChunkIOExecutor.computePoolSize(100, 2));
+        assertEquals(3, ChunkIOExecutor.computePoolSize(101, 2));
+        assertEquals(3, ChunkIOExecutor.computePoolSize(150, 2));
+        assertEquals(4, ChunkIOExecutor.computePoolSize(151, 2));
+        assertEquals(2, ChunkIOExecutor.computePoolSize(51, 1));
+    }
+
+    @Test
+    public void stage2BudgetLimitsWorkPerTickAndGuaranteesForwardProgress() throws Exception {
+        AtomicInteger stage2Count = new AtomicInteger();
+        CountDownLatch stage1Done = new CountDownLatch(12);
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> exec =
+            new AsynchronousExecutor<>(new AsynchronousExecutor.CallBackProvider<Integer, Integer, Runnable, RuntimeException>() {
+                @Override
+                public Integer callStage1(Integer parameter) {
+                    stage1Done.countDown();
+                    return parameter * 2;
+                }
+
+                @Override
+                public void callStage2(Integer parameter, Integer object) {
+                    stage2Count.incrementAndGet();
+                }
+
+                @Override
+                public void callStage3(Integer parameter, Integer object, Runnable callback) {
+                    callback.run();
+                }
+
+                @Override
+                public Thread newThread(Runnable r) {
+                    Thread t = new Thread(r, "stage2-budget-test");
+                    t.setDaemon(true);
+                    return t;
+                }
+            }, 2);
+
+        AtomicInteger callbacks = new AtomicInteger();
+        for (int i = 0; i < 12; ++i) {
+            exec.add(i, callbacks::incrementAndGet);
+        }
+        assertTrue(stage1Done.await(5, TimeUnit.SECONDS));
+        // Brief spin until all tasks are enqueued in finished
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(2);
+        int drained = 0;
+        while (drained < 12 && System.nanoTime() < deadline) {
+            int batch = exec.finishActive(4, 0L);
+            assertTrue("task count cap must never exceed 4 per tick", batch <= 4);
+            drained += batch;
+            if (batch == 0) {
+                Thread.sleep(1);
+            }
+        }
+        assertEquals(12, drained);
+        assertEquals(12, stage2Count.get());
+        assertEquals(12, callbacks.get());
+
+        // Time budget of 1 ns must still process at least 1 task (forward progress guarantee)
+        CountDownLatch oneDone = new CountDownLatch(3);
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> exec2 =
+            new AsynchronousExecutor<>(new AsynchronousExecutor.CallBackProvider<Integer, Integer, Runnable, RuntimeException>() {
+                @Override
+                public Integer callStage1(Integer parameter) {
+                    oneDone.countDown();
+                    return parameter;
+                }
+
+                @Override
+                public void callStage2(Integer parameter, Integer object) {
+                }
+
+                @Override
+                public void callStage3(Integer parameter, Integer object, Runnable callback) {
+                }
+
+                @Override
+                public Thread newThread(Runnable r) {
+                    Thread t = new Thread(r, "stage2-progress-test");
+                    t.setDaemon(true);
+                    return t;
+                }
+            }, 1);
+        for (int i = 0; i < 3; ++i) {
+            exec2.add(i, () -> {});
+        }
+        assertTrue(oneDone.await(5, TimeUnit.SECONDS));
+        int processed = 0;
+        long d2 = System.nanoTime() + TimeUnit.SECONDS.toNanos(2);
+        while (processed == 0 && System.nanoTime() < d2) {
+            processed = exec2.finishActive(0, 1L);
+            if (processed == 0) {
+                Thread.sleep(1);
+            }
+        }
+        assertEquals("tiny nano budget must still make forward progress of 1 task", 1, processed);
+    }
