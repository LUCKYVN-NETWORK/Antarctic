index cf1258c..b59ac9b 100644
--- a/main/java/org/bukkit/craftbukkit/util/AsynchronousExecutor.java
+++ b/main/java/org/bukkit/craftbukkit/util/AsynchronousExecutor.java
@@ -348,6 +348,40 @@ public final class AsynchronousExecutor<P, T, C, E extends Throwable> {
         }
     }
 
+    // Antarctic start - budgeted Stage-2 drain (always processes at least 1 task for forward progress)
+    public int finishActive(final int maxTasks, final long maxNanos) throws E {
+        final Queue<Task> finished = this.finished;
+        int processed = 0;
+        if (maxTasks <= 0 && maxNanos <= 0L) {
+            while (!finished.isEmpty()) {
+                Task task = finished.poll();
+                if (task == null) {
+                    break;
+                }
+                task.finish();
+                processed++;
+            }
+            return processed;
+        }
+        final long deadline = maxNanos > 0L ? System.nanoTime() + maxNanos : 0L;
+        while (!finished.isEmpty()) {
+            Task task = finished.poll();
+            if (task == null) {
+                break;
+            }
+            task.finish();
+            processed++;
+            if (maxTasks > 0 && processed >= maxTasks) {
+                break;
+            }
+            if (maxNanos > 0L && System.nanoTime() >= deadline) {
+                break;
+            }
+        }
+        return processed;
+    }
+    // Antarctic end
+
     public void setActiveThreads(final int coreSize) {
         pool.setCorePoolSize(coreSize);
     }
