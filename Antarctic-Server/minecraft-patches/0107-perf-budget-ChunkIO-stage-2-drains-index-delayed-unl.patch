@@ -0,0 +1,34 @@
+package com.destroystokyo.paper.config.toml.modules.optimizations;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+
+public class ChunkLoading implements IConfigModule {
+
+    @ConfigInfo(baseName = "max-stage2-millis-per-tick", comments = "Maximum wall-clock milliseconds spent per tick finalizing asynchronously loaded chunks (ChunkIO Stage 2) on the main thread.\nAlways processes at least one chunk per tick for forward progress.\nSet to 0 to disable the time budget (vanilla/Paper parity default). Values like 8-12 help smooth join and teleport storms.")
+    public static int maxStage2MillisPerTick = 0;
+
+    @ConfigInfo(baseName = "max-stage2-chunk-loads-per-tick", comments = "Maximum number of asynchronously loaded chunks finalized (ChunkIO Stage 2) per tick on the main thread.\nAlways processes at least one chunk per tick for forward progress.\nSet to 0 for unlimited (vanilla/Paper parity default).")
+    public static int maxStage2ChunkLoadsPerTick = 0;
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.OPTIMIZATIONS;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "chunk-loading";
+    }
+
+    @Override
+    public void onLoaded(com.electronwill.nightconfig.core.file.CommentedFileConfig config) {
+        if (maxStage2MillisPerTick < 0) {
+            throw new IllegalArgumentException("optimizations.chunk-loading.max-stage2-millis-per-tick must be >= 0");
+        }
+        if (maxStage2ChunkLoadsPerTick < 0) {
+            throw new IllegalArgumentException("optimizations.chunk-loading.max-stage2-chunk-loads-per-tick must be >= 0");
+        }
+    }
+}
