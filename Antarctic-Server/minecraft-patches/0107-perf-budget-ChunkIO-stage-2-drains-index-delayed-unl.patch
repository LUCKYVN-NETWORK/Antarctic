+    @Test
+    public void playerChunkMapSwapRemoveMaintainsIndicesAndBeatsLinearRemoval() throws Exception {
+        WorldServer world = (WorldServer) unsafe.allocateInstance(WorldServer.class);
+        com.destroystokyo.paper.PaperWorldConfig paperConfig =
+            (com.destroystokyo.paper.PaperWorldConfig) unsafe.allocateInstance(com.destroystokyo.paper.PaperWorldConfig.class);
+        LightPropagationParityTest.set(World.class, world, "paperConfig", paperConfig);
+        WorldBorder border = new WorldBorder();
+        border.world = world;
+        LightPropagationParityTest.set(World.class, world, "P", border);
+        LightPropagationParityTest.set(World.class, world, "worldData", unsafe.allocateInstance(WorldData.class));
+
+        ChunkProviderServer stubCps = new ChunkProviderServer(world, null, null) {
+            @Override
+            public Chunk getChunkAt(int x, int z, Runnable runnable, boolean generate) {
+                return null;
+            }
+        };
+        LightPropagationParityTest.set(World.class, world, "chunkProvider", stubCps);
+
+        PlayerChunkMap map = (PlayerChunkMap) unsafe.allocateInstance(PlayerChunkMap.class);
+        LightPropagationParityTest.set(PlayerChunkMap.class, map, "world", world);
+        LightPropagationParityTest.set(PlayerChunkMap.class, map, "managedPlayers", new ArrayList<EntityPlayer>());
+        LightPropagationParityTest.set(PlayerChunkMap.class, map, "e", new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<PlayerChunk>(4096));
+        LightPropagationParityTest.set(PlayerChunkMap.class, map, "f", new java.util.HashSet<PlayerChunk>());
+        LightPropagationParityTest.set(PlayerChunkMap.class, map, "g", new it.unimi.dsi.fastutil.objects.ObjectArrayList<PlayerChunk>());
+        LightPropagationParityTest.set(PlayerChunkMap.class, map, "h", new it.unimi.dsi.fastutil.objects.ObjectArrayList<PlayerChunk>());
+        LightPropagationParityTest.set(PlayerChunkMap.class, map, "i", new it.unimi.dsi.fastutil.objects.ObjectArrayList<PlayerChunk>());
+        LightPropagationParityTest.set(PlayerChunkMap.class, map, "j", 10);
+
+        // Add 2,500 PlayerChunks via private c(x, z), then remove them all in shuffled order via b(pc)
+        java.lang.reflect.Method cMethod = PlayerChunkMap.class.getDeclaredMethod("c", int.class, int.class);
+        cMethod.setAccessible(true);
+
+        long swapRemoveNanos = Long.MAX_VALUE;
+        long linearNanos = Long.MAX_VALUE;
+        for (int round = 0; round < 3; ++round) {
+            List<PlayerChunk> created = new ArrayList<>(2500);
+            for (int x = 0; x < 50; ++x) {
+                for (int z = 0; z < 50; ++z) {
+                    created.add((PlayerChunk) cMethod.invoke(map, x, z));
+                }
+            }
+            List<PlayerChunk> shuffled = new ArrayList<>(created);
+            java.util.Collections.shuffle(shuffled, new java.util.Random(42 + round));
+
+            long t0 = System.nanoTime();
+            for (PlayerChunk pc : shuffled) {
+                map.b(pc);
+            }
+            swapRemoveNanos = Math.min(swapRemoveNanos, System.nanoTime() - t0);
+
+            ArrayList<PlayerChunk> linearI = new ArrayList<>(created);
+            java.util.LinkedList<PlayerChunk> linearG = new java.util.LinkedList<>(created);
+            java.util.LinkedList<PlayerChunk> linearH = new java.util.LinkedList<>(created);
+            long t1 = System.nanoTime();
+            for (PlayerChunk pc : shuffled) {
+                linearI.remove(pc);
+                linearG.remove(pc);
+                linearH.remove(pc);
+            }
+            linearNanos = Math.min(linearNanos, System.nanoTime() - t1);
+        }
+
+        Field iField = PlayerChunkMap.class.getDeclaredField("i");
+        Field gField = PlayerChunkMap.class.getDeclaredField("g");
+        Field hField = PlayerChunkMap.class.getDeclaredField("h");
+        iField.setAccessible(true);
+        gField.setAccessible(true);
+        hField.setAccessible(true);
+        assertEquals(0, ((List<?>) iField.get(map)).size());
+        assertEquals(0, ((List<?>) gField.get(map)).size());
+        assertEquals(0, ((List<?>) hField.get(map)).size());
+
+        System.out.println("[perf] PlayerChunkMap remove 2.5k entries (shuffled): linear=" + (linearNanos / 1000) + "us swapRemove="
+            + (swapRemoveNanos / 1000) + "us ratio=" + (linearNanos / Math.max(1, swapRemoveNanos)) + "x");
+        assertTrue("intrusive swap-remove must be at least 3x faster than linear removal", swapRemoveNanos * 3 < linearNanos);
+    }
