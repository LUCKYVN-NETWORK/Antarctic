+    @Test
+    public void indexedDelayedUnloadsMatchParityAndBeatFullChunkScan() throws Exception {
+        WorldServer world = (WorldServer) unsafe.allocateInstance(WorldServer.class);
+        com.destroystokyo.paper.PaperWorldConfig paperConfig =
+            (com.destroystokyo.paper.PaperWorldConfig) unsafe.allocateInstance(com.destroystokyo.paper.PaperWorldConfig.class);
+        paperConfig.delayChunkUnloadsBy = 10_000L;
+        LightPropagationParityTest.set(World.class, world, "paperConfig", paperConfig);
+        WorldProvider wp = (WorldProvider) unsafe.allocateInstance(WorldProviderNormal.class);
+        LightPropagationParityTest.set(WorldProvider.class, wp, "b", world);
+        world.worldProvider = wp;
+        WorldData wd = (WorldData) unsafe.allocateInstance(WorldData.class);
+        LightPropagationParityTest.set(WorldData.class, wd, "c", 100_000);
+        LightPropagationParityTest.set(WorldData.class, wd, "e", 100_000);
+        LightPropagationParityTest.set(World.class, world, "worldData", wd);
+        LightPropagationParityTest.set(World.class, world, "P", new WorldBorder());
+        world.keepSpawnInMemory = false;
+        world.savingDisabled = false;
+
+        IChunkLoader noopLoader = new IChunkLoader() {
+            @Override public Chunk a(World w, int x, int z) { return null; }
+            @Override public void saveChunk(World w, Chunk c, boolean u) {}
+            @Override public void b() {}
+            @Override public void c() {}
+            @Override public boolean chunkExists(int x, int z) { return false; }
+        };
+        ChunkProviderServer cps = new ChunkProviderServer(world, noopLoader, null);
+
+        // Populate 8,000 loaded chunks; only 12 scheduled for delayed unload (6 expired, 6 still waiting)
+        long now = System.currentTimeMillis();
+        List<Chunk> expiredChunks = new ArrayList<>();
+        List<Chunk> waitingChunks = new ArrayList<>();
+        for (int cx = 0; cx < 80; ++cx) {
+            for (int cz = 0; cz < 100; ++cz) {
+                Chunk c = (Chunk) unsafe.allocateInstance(Chunk.class);
+                LightPropagationParityTest.set(Chunk.class, c, "locX", cx);
+                LightPropagationParityTest.set(Chunk.class, c, "locZ", cz);
+                c.chunkKey = ChunkCoordIntPair.a(cx, cz);
+                cps.chunks.put(c.chunkKey, c);
+                if (cx == 0 && cz < 6) {
+                    cps.scheduleDelayedUnload(c, now - 20_000L);
+                    expiredChunks.add(c);
+                } else if (cx == 1 && cz < 6) {
+                    cps.scheduleDelayedUnload(c, now + 60_000L);
+                    waitingChunks.add(c);
+                }
+            }
+        }
+
+        // Cancel one expired chunk before tick -> must NOT be unloaded
+        Chunk cancelled = expiredChunks.remove(0);
+        cps.cancelDelayedUnload(cancelled);
+        assertNull(cancelled.scheduledForUnload);
+
+        cps.unloadChunks();
+        assertFalse("cancelled chunk must not enter unloadQueue", cancelled.d);
+        for (Chunk exp : expiredChunks) {
+            assertTrue("expired chunk must enter unloadQueue", exp.d);
+            assertNull("expired chunk must clear scheduledForUnload", exp.scheduledForUnload);
+        }
+        for (Chunk wait : waitingChunks) {
+            assertFalse("not-yet-expired chunk must stay loaded", wait.d);
+            assertTrue(wait.scheduledForUnload != null);
+        }
+
+        // Perf comparison: indexed unloadChunks() vs scanning all 8,000 chunks across 2,000 ticks
+        cps.unloadQueue.clear();
+        for (int i = 0; i < 200; ++i) {
+            cps.unloadChunks();
+        }
+        long t0 = System.nanoTime();
+        for (int i = 0; i < 2_000; ++i) {
+            cps.unloadChunks();
+        }
+        long indexedNanos = System.nanoTime() - t0;
+
+        int sink = 0;
+        long t1 = System.nanoTime();
+        for (int i = 0; i < 2_000; ++i) {
+            long cur = System.currentTimeMillis();
+            for (Chunk chunk : cps.chunks.values()) {
+                if (chunk.scheduledForUnload != null && cur - chunk.scheduledForUnload > 10_000L) {
+                    sink++;
+                }
+            }
+        }
+        long scanNanos = System.nanoTime() - t1;
+        assertEquals(0, sink);
+        System.out.println("[perf] delayed-unload scan (8k chunks x 2k ticks): fullScan=" + (scanNanos / 1000) + "us indexed="
+            + (indexedNanos / 1000) + "us ratio=" + (scanNanos / Math.max(1, indexedNanos)) + "x");
+        assertTrue("indexed delayed-unload scan must be at least 10x faster than full scan", indexedNanos * 10 < scanNanos);
+    }
