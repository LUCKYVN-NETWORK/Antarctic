+    @Test
+    public void testSmallEntityFluidAndFireAndApParity() throws Exception {
+        TestWorld world = createWorld();
+
+        // EntityItem (height 0.25) in water -> aq() must detect water
+        EntityItem item = new EntityItem(world, 8.5D, 64.0D, 8.5D, new ItemStack(Blocks.STONE));
+        Assert.assertTrue("EntityItem in water must be detected by aq()", item.aq());
+        // EntitySquid (height 0.8) in water -> aq() must detect water
+        EntitySquid squid = new EntitySquid(world);
+        squid.setPosition(8.5D, 64.0D, 8.5D);
+        Assert.assertTrue("EntitySquid in water must be detected by aq()", squid.aq());
+        // EntityChicken (height 0.7) in water -> aq() must detect water
+        EntityChicken chicken = new EntityChicken(world);
+        chicken.setPosition(8.5D, 64.0D, 8.5D);
+        Assert.assertTrue("EntityChicken in water must be detected by aq()", chicken.aq());
+        // Entity.ap() parity against vanilla AABB call
+        EntityZombie zombie = new EntityZombie(world);
+        zombie.setPosition(8.5D, 64.0D, 8.5D);
+        Assert.assertEquals(
+            world.a(zombie.getBoundingBox().grow(0.0D, -20.0D, 0.0D).shrink(0.001D), Material.WATER, zombie),
+            zombie.ap());
+        Assert.assertTrue("Zombie at y=64 water must return true for ap()", zombie.ap());
+
+        // Small entity in lava -> au() must detect lava
+        EntityItem lavaItem = new EntityItem(world, 10.5D, 64.0D, 8.5D, new ItemStack(Blocks.STONE));
+        Assert.assertTrue("EntityItem in lava must be detected by au()", lavaItem.au());
+
+        // Zero-width ArmorStand marker in fire -> world.e normalized check must match vanilla shrink(0.001D)
+        EntityArmorStand marker = new EntityArmorStand(world, 12.5D, 64.5D, 8.5D);
+        marker.setMarker(true);
+        AxisAlignedBB fireBB = marker.getBoundingBox();
+        double fx1 = fireBB.a + 0.001D, fx2 = fireBB.d - 0.001D;
+        double fy1 = fireBB.b + 0.001D, fy2 = fireBB.e - 0.001D;
+        double fz1 = fireBB.c + 0.001D, fz2 = fireBB.f - 0.001D;
+        Assert.assertEquals(
+            world.e(fireBB.shrink(0.001D)),
+            world.e(Math.min(fx1, fx2), Math.min(fy1, fy2), Math.min(fz1, fz2),
+                Math.max(fx1, fx2), Math.max(fy1, fy2), Math.max(fz1, fz2)));
+    }
