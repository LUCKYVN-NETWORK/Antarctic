+    @Test
+    public void testChunkMergeNearbyItemsSafeAgainstSliceMutation() throws Exception {
+        TestWorld world = createWorld();
+        Chunk chunk = world.getChunkIfLoaded(0, 0);
+
+        final EntityItem self = new EntityItem(world, 8.5D, 65.0D, 8.5D, new ItemStack(Blocks.STONE)) {
+            @Override
+            boolean tryMergeWith(EntityItem other) {
+                // Simulate ItemMergeEvent listener removing entities from the same slice mid-merge
+                chunk.entitySlices[4].remove(other);
+                return false;
+            }
+        };
+        EntityItem other1 = new EntityItem(world, 8.6D, 65.0D, 8.5D, new ItemStack(Blocks.STONE));
+        EntityItem other2 = new EntityItem(world, 8.7D, 65.0D, 8.5D, new ItemStack(Blocks.STONE));
+        chunk.a(self);
+        chunk.a(other1);
+        chunk.a(other2);
+
+        AxisAlignedBB box = self.getBoundingBox().grow(0.5D, 0.0D, 0.5D);
+        chunk.mergeNearbyItems(self, box.a, box.b, box.c, box.d, box.e, box.f, chunk, 4);
+        Assert.assertEquals(1, chunk.entitySlices[4].size());
+    }
