-                        self.tryMergeWith((EntityItem) entity);
-                        if (!self.isAlive()) {
-                            return;
+        MergeScratch scratch = MERGE_SCRATCH.get();
+        boolean pooled = !scratch.inUse;
+        java.util.ArrayList<EntityItem> candidates;
+        if (pooled) {
+            scratch.inUse = true;
+            candidates = scratch.list;
+            candidates.clear();
+        } else {
+            candidates = new java.util.ArrayList<>();
+        }
+        try {
+            for (int k = i; k <= j; ++k) {
+                if (this.itemCounts[k] <= (this == selfChunk && k == selfSlice ? 1 : 0)) {
+                    continue;
+                }
+                List<Entity> slice = this.entitySlices[k];
+                for (int idx = 0, len = slice.size(); idx < len; ++idx) {
+                    Entity entity = slice.get(idx);
+                    if (entity instanceof EntityItem && entity != self) {
+                        AxisAlignedBB entityBB = entity.getBoundingBox();
+                        if (entityBB.d > minX && entityBB.a < maxX && entityBB.e > minY && entityBB.b < maxY && entityBB.f > minZ && entityBB.c < maxZ) {
+                            candidates.add((EntityItem) entity);
                         }
                     }
                 }
             }
+            for (int idx = 0, len = candidates.size(); idx < len; ++idx) {
+                self.tryMergeWith(candidates.get(idx));
+                if (!self.isAlive()) {
+                    return;
+                }
+            }
+        } finally {
+            candidates.clear();
+            if (pooled) {
+                scratch.inUse = false;
+            }
         }
