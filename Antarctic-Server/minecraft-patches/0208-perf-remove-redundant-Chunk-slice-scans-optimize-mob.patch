@@ -0,0 +1,40 @@
+package com.destroystokyo.paper.config.toml.modules.fixes;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+
+public class VanillaBugFix implements IConfigModule {
+
+    @ConfigInfo(
+        baseName = "mc-301114-combat-tracker-memory-leak",
+        comments = "Evict oldest CombatEntry records from CombatTracker once mc-301114-max-combat-entries is exceeded.\nPrevents unbounded memory growth on long-lived mobs/players taking repeated damage while preserving the latest killer and death message (default: false)."
+    )
+    public static boolean mc301114CombatTrackerMemoryLeak = false;
+
+    @ConfigInfo(
+        baseName = "mc-301114-max-combat-entries",
+        comments = "Maximum CombatEntry records retained per CombatTracker when mc-301114-combat-tracker-memory-leak is enabled (>= 64, default: 10240)."
+    )
+    public static int mc301114MaxCombatEntries = 10240;
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.FIXES;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "vanilla-bug-fix";
+    }
+
+    @Override
+    public void onLoaded(CommentedFileConfig config) {
+        if (mc301114MaxCombatEntries < 64) {
+            throw new IllegalArgumentException(
+                "fixes.vanilla-bug-fix.mc-301114-max-combat-entries must be >= 64, got: " + mc301114MaxCombatEntries
+            );
+        }
+    }
+}
