@@ -0,0 +1,285 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.AntarcticTomlConfig;
+import com.destroystokyo.paper.config.toml.modules.fixes.VanillaBugFix;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.io.File;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class ChunkSliceAndCombatTrackerTest {
+
+    private static Unsafe UNSAFE;
+    private static int nextEntityId = 30000;
+    private static boolean savedMc301114;
+    private static int savedMaxEntries;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+        savedMc301114 = VanillaBugFix.mc301114CombatTrackerMemoryLeak;
+        savedMaxEntries = VanillaBugFix.mc301114MaxCombatEntries;
+    }
+
+    @After
+    public void restoreConfig() {
+        VanillaBugFix.mc301114CombatTrackerMemoryLeak = savedMc301114;
+        VanillaBugFix.mc301114MaxCombatEntries = savedMaxEntries;
+    }
+
+    private static final class SliceTestWorld extends World {
+        final Chunk chunk;
+
+        SliceTestWorld(Chunk chunk) {
+            super(null, new WorldData(), new WorldProviderNormal(), new MethodProfiler(), false, null, null);
+            this.chunk = chunk;
+        }
+
+        @Override
+        protected IChunkProvider n() {
+            return null;
+        }
+
+        @Override
+        protected boolean isChunkLoaded(int i, int j, boolean flag) {
+            return i == 0 && j == 0;
+        }
+
+        @Override
+        public Chunk getChunkIfLoaded(int i, int j) {
+            return (i == 0 && j == 0) ? this.chunk : null;
+        }
+    }
+
+    private static SliceTestWorld createTestWorld() throws Exception {
+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        Field secField = Chunk.class.getDeclaredField("sections");
+        secField.setAccessible(true);
+        ChunkSection[] sections = new ChunkSection[16];
+        for (int s = 0; s < 16; ++s) {
+            sections[s] = new ChunkSection(s << 4, true);
+        }
+        secField.set(chunk, sections);
+
+        Field slicesField = Chunk.class.getDeclaredField("entitySlices");
+        slicesField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        List<Entity>[] slices = new List[16];
+        for (int s = 0; s < 16; ++s) {
+            slices[s] = new ArrayList<>();
+        }
+        slicesField.set(chunk, slices);
+
+        for (String fn : new String[]{"hardCollidableCounts", "itemCounts", "inventoryEntityCounts", "itemFrameCounts"}) {
+            Field f = Chunk.class.getDeclaredField(fn);
+            f.setAccessible(true);
+            f.set(chunk, new int[16]);
+        }
+        Field ec = Chunk.class.getDeclaredField("entityCounts");
+        ec.setAccessible(true);
+        ec.set(chunk, new co.aikar.util.Counter<String>());
+        Field ect = Chunk.class.getDeclaredField("entityCount");
+        ect.setAccessible(true);
+        ect.set(chunk, new gnu.trove.map.hash.TObjectIntHashMap<Class>());
+        Field acc = Chunk.class.getDeclaredField("antarcticCreatureCounts");
+        acc.setAccessible(true);
+        acc.set(chunk, new int[EnumCreatureType.values().length]);
+
+        SliceTestWorld world = (SliceTestWorld) UNSAFE.allocateInstance(SliceTestWorld.class);
+        Field cf = SliceTestWorld.class.getDeclaredField("chunk");
+        cf.setAccessible(true);
+        cf.set(world, chunk);
+        Field wc = Chunk.class.getDeclaredField("world");
+        wc.setAccessible(true);
+        wc.set(chunk, world);
+        Field pwc = World.class.getDeclaredField("paperConfig");
+        pwc.setAccessible(true);
+        pwc.set(world, UNSAFE.allocateInstance(com.destroystokyo.paper.PaperWorldConfig.class));
+        Field swc = World.class.getDeclaredField("spigotConfig");
+        swc.setAccessible(true);
+        swc.set(world, UNSAFE.allocateInstance(org.spigotmc.SpigotWorldConfig.class));
+        world.worldProvider = new WorldProviderNormal();
+        Field cpField = World.class.getDeclaredField("chunkProvider");
+        cpField.setAccessible(true);
+        cpField.set(world, new IChunkProvider() {
+            @Override public Chunk getLoadedChunkAt(int i, int j) { return (i == 0 && j == 0) ? chunk : null; }
+            @Override public Chunk getChunkAt(int i, int j) { return (i == 0 && j == 0) ? chunk : null; }
+            @Override public boolean unloadChunks() { return false; }
+            @Override public String getName() { return "SliceTestChunkProvider"; }
+            @Override public boolean e(int i, int j) { return i == 0 && j == 0; }
+        });
+        return world;
+    }
+
+    private static EntityItem createItem(World world, double x, double y, double z) throws Exception {
+        EntityItem item = (EntityItem) UNSAFE.allocateInstance(EntityItem.class);
+        item.h(nextEntityId++);
+        item.world = world;
+        item.locX = x;
+        item.locY = y;
+        item.locZ = z;
+        item.a(new AxisAlignedBB(x - 0.125, y, z - 0.125, x + 0.125, y + 0.25, z + 0.125));
+        return item;
+    }
+
+    private static EntityMinecartRideable createMinecart(World world, double x, double y, double z) throws Exception {
+        EntityMinecartRideable cart = (EntityMinecartRideable) UNSAFE.allocateInstance(EntityMinecartRideable.class);
+        cart.h(nextEntityId++);
+        cart.world = world;
+        cart.locX = x;
+        cart.locY = y;
+        cart.locZ = z;
+        cart.a(new AxisAlignedBB(x - 0.49, y, z - 0.49, x + 0.49, y + 0.7, z + 0.49));
+        return cart;
+    }
+
+    @Test
+    public void testChunkSliceInvariantsAndBounds() throws Exception {
+        SliceTestWorld world = createTestWorld();
+        EntityItem item = createItem(world, 8.0, 20.0, 8.0);
+        EntityMinecartRideable cart = createMinecart(world, 8.0, 20.0, 8.0);
+
+        Field itemCountsField = Chunk.class.getDeclaredField("itemCounts");
+        itemCountsField.setAccessible(true);
+        int[] itemCounts = (int[]) itemCountsField.get(world.chunk);
+
+        assertFalse(world.hasAnyItemInBounds(6.0, 18.0, 6.0, 10.0, 22.0, 10.0));
+        world.chunk.a(item);
+        world.chunk.a(cart);
+        assertEquals(1, itemCounts[1]);
+        assertEquals(1, world.chunk.hardCollidableCounts[1]);
+        assertSame(world.chunk.entitySlices[1], item.entitySlice);
+        assertTrue(world.hasAnyItemInBounds(6.0, 18.0, 6.0, 10.0, 22.0, 10.0));
+
+        // Duplicate add to same slice is a no-op
+        world.chunk.a(item);
+        assertEquals(1, itemCounts[1]);
+        assertEquals(2, world.chunk.entitySlices[1].size());
+
+        // Move item to slice 3 (y=52)
+        item.locY = 52.0;
+        world.chunk.a(item);
+        assertEquals(0, itemCounts[1]);
+        assertEquals(1, itemCounts[3]);
+        assertSame(world.chunk.entitySlices[3], item.entitySlice);
+
+        // Remove both
+        world.chunk.a(item, 3);
+        world.chunk.a(cart, 1);
+        assertEquals(0, itemCounts[3]);
+        assertEquals(0, world.chunk.hardCollidableCounts[1]);
+        assertNull(item.entitySlice);
+        assertFalse(world.hasAnyItemInBounds(6.0, 48.0, 6.0, 10.0, 56.0, 10.0));
+    }
+
+    @Test
+    public void testGameRulesMobGriefingCacheParity() {
+        GameRules rules = new GameRules();
+        assertTrue(rules.getMobGriefing());
+        assertEquals(rules.getBoolean("mobGriefing"), rules.getMobGriefing());
+
+        rules.set("mobGriefing", "false");
+        assertFalse(rules.getMobGriefing());
+        assertFalse(rules.getBoolean("mobGriefing"));
+
+        rules.set("mobGriefing", "true");
+        assertTrue(rules.getMobGriefing());
+        assertTrue(rules.getBoolean("mobGriefing"));
+    }
+
+    @Test
+    public void testCombatTrackerCapAndTomlConfig() throws Exception {
+        File tempDir = Files.createTempDirectory("antarctic-a4-toml").toFile();
+        try {
+            File toml = new File(tempDir, "antarctic.toml");
