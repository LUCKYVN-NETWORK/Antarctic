@@ -0,0 +1,231 @@
+package net.minecraft.server;
+
+import com.sun.management.ThreadMXBean;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.lang.management.ManagementFactory;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.Callable;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+
+import static org.junit.Assert.*;
+
+public class EntityBlockCollisionAndPoolPerfTest {
+
+    private static Unsafe UNSAFE;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+    }
+
+    private static final class SyncedPooledPos {
+        private boolean released;
+        int x, y, z;
+        private static final List<SyncedPooledPos> POOL = new ArrayList<SyncedPooledPos>();
+
+        static SyncedPooledPos acquire(int x, int y, int z) {
+            synchronized (POOL) {
+                if (!POOL.isEmpty()) {
+                    SyncedPooledPos p = POOL.remove(POOL.size() - 1);
+                    if (p != null && p.released) {
+                        p.released = false;
+                        p.x = x;
+                        p.y = y;
+                        p.z = z;
+                        return p;
+                    }
+                }
+            }
+            SyncedPooledPos p = new SyncedPooledPos();
+            p.x = x;
+            p.y = y;
+            p.z = z;
+            return p;
+        }
+
+        void free() {
+            synchronized (POOL) {
+                if (POOL.size() < 100) {
+                    POOL.add(this);
+                }
+                this.released = true;
+            }
+        }
+    }
+
+    @Test
+    public void testBlockCollisionCallbackDetectionAndPoolParity() throws Exception {
+        assertFalse(((BlockDataAbstract) Blocks.AIR.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertFalse(((BlockDataAbstract) Blocks.STONE.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertFalse(((BlockDataAbstract) Blocks.DIRT.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertFalse(((BlockDataAbstract) Blocks.GRASS.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertFalse(((BlockDataAbstract) Blocks.SAND.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertFalse(((BlockDataAbstract) Blocks.FIRE.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertFalse(((BlockDataAbstract) Blocks.HOPPER.getBlockData()).antarcticHasEntityCollisionCallback());
+
+        assertTrue(((BlockDataAbstract) Blocks.CACTUS.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertTrue(((BlockDataAbstract) Blocks.WEB.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertTrue(((BlockDataAbstract) Blocks.SOUL_SAND.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertTrue(((BlockDataAbstract) Blocks.PORTAL.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertTrue(((BlockDataAbstract) Blocks.WOODEN_PRESSURE_PLATE.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertTrue(((BlockDataAbstract) Blocks.TRIPWIRE.getBlockData()).antarcticHasEntityCollisionCallback());
+        assertTrue(((BlockDataAbstract) Blocks.cauldron.getBlockData()).antarcticHasEntityCollisionCallback());
+
+        // Pool reuse & non-aliasing
+        BlockPosition.PooledBlockPosition p1 = BlockPosition.PooledBlockPosition.e(1, 2, 3);
+        BlockPosition.PooledBlockPosition p2 = BlockPosition.PooledBlockPosition.e(4, 5, 6);
+        assertNotSame(p1, p2);
+        assertEquals(1, p1.getX());
+        assertEquals(5, p2.getY());
+        p2.t();
+        p1.t();
+
+        BlockPosition.PooledBlockPosition p3 = BlockPosition.PooledBlockPosition.e(7, 8, 9);
+        assertSame(p1, p3);
+        assertEquals(7, p3.getX());
+        assertEquals(8, p3.getY());
+        assertEquals(9, p3.getZ());
+        p3.t();
+
+        // 2-thread isolation check
+        ExecutorService exec = Executors.newFixedThreadPool(2);
+        try {
+            Callable<Boolean> task = () -> {
+                for (int i = 0; i < 5000; ++i) {
+                    BlockPosition.PooledBlockPosition a = BlockPosition.PooledBlockPosition.e(i, i + 1, i + 2);
+                    BlockPosition.PooledBlockPosition b = BlockPosition.PooledBlockPosition.e(i + 3, i + 4, i + 5);
+                    if (a == b || a.getX() != i || b.getZ() != i + 5) {
+                        return false;
+                    }
+                    b.t();
+                    a.t();
+                }
+                return true;
+            };
+            Future<Boolean> f1 = exec.submit(task);
+            Future<Boolean> f2 = exec.submit(task);
+            assertTrue(f1.get());
+            assertTrue(f2.get());
+        } finally {
+            exec.shutdownNow();
+        }
+    }
+
+    @Test
+    public void testPooledBlockPositionAndCheckBlockCollisionsBenchmark() throws Exception {
+        ThreadMXBean threadBean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        // Warmup PooledBlockPosition on main thread
+        for (int w = 0; w < 5000; ++w) {
+            BlockPosition.PooledBlockPosition a = BlockPosition.PooledBlockPosition.e(1, 2, 3);
+            BlockPosition.PooledBlockPosition b = BlockPosition.PooledBlockPosition.e(4, 5, 6);
+            BlockPosition.PooledBlockPosition c = BlockPosition.PooledBlockPosition.s();
+            c.t();
+            b.t();
+            a.t();
+        }
+
+        long allocBefore = threadBean.getThreadAllocatedBytes(tid);
+        long sink = 0L;
+        for (int i = 0; i < 10000; ++i) {
+            BlockPosition.PooledBlockPosition a = BlockPosition.PooledBlockPosition.e(i, 64, i);
+            BlockPosition.PooledBlockPosition b = BlockPosition.PooledBlockPosition.e(i + 1, 65, i + 1);
+            BlockPosition.PooledBlockPosition c = BlockPosition.PooledBlockPosition.s();
+            c.f(i, 64, i);
+            sink += a.getX() + b.getY() + c.getZ();
+            c.t();
+            b.t();
+            a.t();
+        }
+        long allocBytes = Math.max(0L, threadBean.getThreadAllocatedBytes(tid) - allocBefore);
+        assertEquals("Steady-state PooledBlockPosition acquire/free must allocate 0 bytes", 0L, allocBytes);
+
+        // 2-thread contention benchmark: SyncedPooledPos vs ThreadLocal PooledBlockPosition
+        ExecutorService exec = Executors.newFixedThreadPool(2);
+        try {
+            final java.util.concurrent.CyclicBarrier barrier = new java.util.concurrent.CyclicBarrier(2);
+            Callable<Long> syncWork = () -> {
+                long s = 0L;
+                for (int i = 0; i < 100000; ++i) {
+                    SyncedPooledPos a = SyncedPooledPos.acquire(i, 64, i);
+                    SyncedPooledPos b = SyncedPooledPos.acquire(i + 1, 65, i + 1);
+                    SyncedPooledPos c = SyncedPooledPos.acquire(0, 0, 0);
+                    c.x = i;
+                    s += a.x + b.y + c.z;
+                    c.free();
+                    b.free();
+                    a.free();
+                }
+                barrier.await();
+                for (int i = 0; i < 500000; ++i) {
+                    SyncedPooledPos a = SyncedPooledPos.acquire(i, 64, i);
+                    SyncedPooledPos b = SyncedPooledPos.acquire(i + 1, 65, i + 1);
+                    SyncedPooledPos c = SyncedPooledPos.acquire(0, 0, 0);
+                    c.x = i;
+                    s += a.x + b.y + c.z;
+                    c.free();
+                    b.free();
+                    a.free();
+                }
+                return s;
+            };
+            Callable<Long> tlWork = () -> {
+                long s = 0L;
+                for (int i = 0; i < 100000; ++i) {
+                    BlockPosition.PooledBlockPosition a = BlockPosition.PooledBlockPosition.e(i, 64, i);
+                    BlockPosition.PooledBlockPosition b = BlockPosition.PooledBlockPosition.e(i + 1, 65, i + 1);
+                    BlockPosition.PooledBlockPosition c = BlockPosition.PooledBlockPosition.s();
+                    c.f(i, 64, i);
+                    s += a.getX() + b.getY() + c.getZ();
+                    c.t();
+                    b.t();
+                    a.t();
+                }
+                barrier.await();
+                for (int i = 0; i < 500000; ++i) {
+                    BlockPosition.PooledBlockPosition a = BlockPosition.PooledBlockPosition.e(i, 64, i);
+                    BlockPosition.PooledBlockPosition b = BlockPosition.PooledBlockPosition.e(i + 1, 65, i + 1);
+                    BlockPosition.PooledBlockPosition c = BlockPosition.PooledBlockPosition.s();
+                    c.f(i, 64, i);
+                    s += a.getX() + b.getY() + c.getZ();
+                    c.t();
+                    b.t();
+                    a.t();
+                }
+                return s;
+            };
+
+            long t0 = System.nanoTime();
+            Future<Long> s1 = exec.submit(syncWork);
+            Future<Long> s2 = exec.submit(syncWork);
+            sink += s1.get() + s2.get();
+            long syncNs = System.nanoTime() - t0;
+
+            t0 = System.nanoTime();
+            Future<Long> o1 = exec.submit(tlWork);
+            Future<Long> o2 = exec.submit(tlWork);
+            sink += o1.get() + o2.get();
+            long optNs = System.nanoTime() - t0;
+
+            double speedup = (double) syncNs / Math.max(1L, optNs);
+            System.out.printf("B1_BENCH pool2t_sync_ns=%d pool2t_opt_ns=%d speedup=%.2fx steady_alloc=%d blackhole=%d%n",
+                    syncNs, optNs, speedup, allocBytes, sink);
+
+            assertTrue("Expected PooledBlockPosition 2-thread speedup > 1.5x, got " + syncNs + " vs " + optNs,
+                    optNs * 1.5 < syncNs);
+        } finally {
+            exec.shutdownNow();
+        }
+    }
+}
