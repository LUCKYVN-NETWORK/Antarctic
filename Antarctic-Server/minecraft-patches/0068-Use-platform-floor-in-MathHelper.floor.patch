+package net.minecraft.server;
+
+import org.junit.Test;
+
+import java.util.Random;
+
+import static org.junit.Assert.assertEquals;
+
+public class MathHelperFloorTest {
+
+    private static int referenceFloor(double value) {
+        int i = (int) value;
+        return value < (double) i ? i - 1 : i;
+    }
+
+    @Test
+    public void floorMatchesLegacyComparisonOnSpecialValues() {
+        double[] specials = {
+            0.0, -0.0, 1.0, -1.0, 0.5, -0.5, 0.49999999999999994, -0.49999999999999994,
+            Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY,
+            Double.MIN_VALUE, -Double.MIN_VALUE, Double.MAX_VALUE, -Double.MAX_VALUE,
+            (double) Integer.MAX_VALUE, (double) Integer.MIN_VALUE,
+            (double) Integer.MAX_VALUE + 1.0, (double) Integer.MIN_VALUE - 1.0,
+            2147483647.9, -2147483648.9, 2147483648.0, -2147483649.0,
+            1e300, -1e300, 4503599627370495.9, 4503599627370496.0
+        };
+        for (double value : specials) {
+            assertEquals("floor diverges at " + value, referenceFloor(value), MathHelper.floor(value));
+        }
+    }
+
+    @Test
+    public void floorMatchesLegacyComparisonOnIntegerAndFractionalGrids() {
+        for (int i = -1000000; i <= 1000000; i++) {
+            assertEquals("floor diverges at " + i, referenceFloor(i), MathHelper.floor(i));
+            double d = i + 0.5;
+            assertEquals("floor diverges at " + d, referenceFloor(d), MathHelper.floor(d));
+            d = i + 0.25;
+            assertEquals("floor diverges at " + d, referenceFloor(d), MathHelper.floor(d));
+            d = i - 0.75;
+            assertEquals("floor diverges at " + d, referenceFloor(d), MathHelper.floor(d));
+        }
+    }
+
+    @Test
+    public void floorMatchesLegacyComparisonOnRandomBitPatterns() {
+        Random random = new Random(0xF10CCL);
+        for (int i = 0; i < 10000000; i++) {
+            double value = Double.longBitsToDouble(random.nextLong());
+            assertEquals("floor diverges at " + value, referenceFloor(value), MathHelper.floor(value));
+        }
+    }
+
+    @Test
+    public void floorMatchesLegacyComparisonOnRandomFiniteValues() {
+        Random random = new Random(0x0FF5EEDL);
+        for (int i = 0; i < 5000000; i++) {
+            double value = (random.nextDouble() - 0.5) * 2.0e9;
+            assertEquals("floor diverges at " + value, referenceFloor(value), MathHelper.floor(value));
+            value = (random.nextDouble() - 0.5) * 2.0e18;
+            assertEquals("floor diverges at " + value, referenceFloor(value), MathHelper.floor(value));
+        }
+    }
+
+    @Test
+    public void floorMatchesLegacyComparisonAcrossAllFloatValues() {
+        // Every representable float converted to double exercises the cast-saturation edges.
+        Random random = new Random(0x51A7ECL);
+        for (int i = 0; i < 3000000; i++) {
+            float f = Float.intBitsToFloat(random.nextInt());
+            double value = (double) f;
+            assertEquals("floor diverges at " + value, referenceFloor(value), MathHelper.floor(value));
+        }
+    }
+}
