+        ChunkCache cache = createTestChunkCache();
+        EntityZombie mob = createTestZombie(2.5, 65.0, 2.5);
+        PathfinderNormal pf = new PathfinderNormal();
+        pf.a((IBlockAccess) cache, mob);
+
+        Map<PathType, Float> malusMap = new EnumMap<PathType, Float>(PathType.class);
+        ThreadMXBean threadBean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        long sink = 0L;
+        for (int w = 0; w < 2000; ++w) {
+            int x = 1 + (w % 13);
+            sink += vanillaRef(pf, cache, x, 65, 2, mob, 1, 2, 1, true, true, malusMap).ordinal();
+            sink += pf.a(cache, x, 65, 2, mob, 1, 2, 1, true, true).ordinal();
+        }
+
+        int evals = 20000;
+        long a0 = threadBean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < evals; ++i) {
+            int x = 1 + (i % 13);
+            sink += vanillaRef(pf, cache, x, 65, 2, mob, 1, 2, 1, true, true, malusMap).ordinal();
+        }
+        long vanillaNs = System.nanoTime() - t0;
+        long vanillaBytes = Math.max(0L, threadBean.getThreadAllocatedBytes(tid) - a0);
+
+        a0 = threadBean.getThreadAllocatedBytes(tid);
+        t0 = System.nanoTime();
+        for (int i = 0; i < evals; ++i) {
+            int x = 1 + (i % 13);
+            sink += pf.a(cache, x, 65, 2, mob, 1, 2, 1, true, true).ordinal();
+        }
+        long optNs = System.nanoTime() - t0;
+        long optBytes = Math.max(0L, threadBean.getThreadAllocatedBytes(tid) - a0);
+
+        System.out.printf("B2_BENCH path20k_vanilla_ns=%d path20k_opt_ns=%d speedup=%.2fx vanilla_bytes=%d opt_bytes=%d blackhole=%d%n",
+                vanillaNs, optNs, (double) vanillaNs / Math.max(1L, optNs), vanillaBytes, optBytes, sink);
+
+        assertTrue("Expected PathfinderNormal speedup > 1.5x, got " + vanillaNs + " vs " + optNs, optNs * 1.5 < vanillaNs);
+        assertTrue("Expected optBytes < vanillaBytes / 2, got " + optBytes + " vs " + vanillaBytes, optBytes * 2L < vanillaBytes);
+    }
