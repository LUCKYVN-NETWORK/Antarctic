+
+    /** Synchronously verifies a loaded chunk against its live 3x3 neighbourhood on the main thread. */
+    public static LightChecker.Report verifyChunk(WorldServer world, int cx, int cz, LightChecker.Scope scope, int maxReported) {
+        Chunk center = world.getChunkIfLoaded(cx, cz);
+        if (center == null) {
+            return null;
+        }
+        boolean hasSky = world.worldProvider != null && world.worldProvider.m();
+        LightRegion region = new LightRegion(cx - 1, cz - 1, 3, 3, hasSky);
+        region.put(cx, cz, liveColumnView(center, hasSky, true), true);
+        // Only the 4 orthogonal neighbours are read by LightChecker.expected()
+        Chunk west = world.getChunkIfLoaded(cx - 1, cz);
+        if (west != null) region.put(cx - 1, cz, liveColumnView(west, hasSky, false), false);
+        Chunk east = world.getChunkIfLoaded(cx + 1, cz);
+        if (east != null) region.put(cx + 1, cz, liveColumnView(east, hasSky, false), false);
+        Chunk north = world.getChunkIfLoaded(cx, cz - 1);
+        if (north != null) region.put(cx, cz - 1, liveColumnView(north, hasSky, false), false);
+        Chunk south = world.getChunkIfLoaded(cx, cz + 1);
+        if (south != null) region.put(cx, cz + 1, liveColumnView(south, hasSky, false), false);
+        return LightChecker.check(region, cx, cz, scope, maxReported);
+    }
+
+    private static LightColumn liveColumnView(Chunk chunk, boolean hasSky, boolean includeCells) {
+        LightColumn column = new LightColumn(chunk.r());
+        ChunkSection[] sections = chunk.getSections();
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            ChunkSection sec = sections[s];
+            if (sec != Chunk.a) {
+                if (includeCells) {
+                    byte[] cells = new byte[LightRules.SECTION_CELLS];
+                    sec.getBlocks().packLightCells(cells);
+                    column.setCells(s, cells);
+                }
+                byte[] sky = hasSky && sec.getSkyLightArray() != null ? sec.getSkyLightArray().asBytes() : null;
+                byte[] block = sec.getEmittedLightArray() != null ? sec.getEmittedLightArray().asBytes() : null;
+                column.setStored(s, sky, block);
+            }
+        }
+        return column;
+    }
+
+    /** Post-apply border shell verification (Design §6): queues repairs into PendingLightRegistry with a 3-attempt cap. */
     void onChunkApplied(Chunk live, int cx, int cz) {
+        if (!Lighting.verifyAfterRelight) {
+            return;
+        }
+        LightChecker.Report report = verifyChunk(this.world, cx, cz, LightChecker.Scope.BORDER, MAX_BORDER_REPAIRS_PER_VERIFY);
+        if (report == null) {
+            return;
+        }
+        if (report.consistent()) {
+            this.nonConvergedAttempts.remove(live.chunkKey);
+            return;
+        }
+        int attempts = this.nonConvergedAttempts.addTo(live.chunkKey, 1) + 1;
+        if (attempts > MAX_BORDER_REPAIR_ATTEMPTS) {
+            if (attempts == MAX_BORDER_REPAIR_ATTEMPTS + 1) {
+                LOGGER.warn("Light border verification for chunk {},{} did not converge after {} attempts ({} inconsistent border cells); pausing automatic repair until next trigger",
+                    cx, cz, MAX_BORDER_REPAIR_ATTEMPTS, report.violations());
+            }
+            return;
+        }
+        int[] positions = report.positions();
+        boolean addedAny = false;
+        for (int packed : positions) {
+            if (this.world.pendingLight.add(live.chunkKey, packed)) {
+                addedAny = true;
+            }
+        }
+        if (addedAny && live.areNeighborsLoaded(1)) {
+            this.world.pendingLight.markReady(live.chunkKey);
+        }
     }
 
     private static boolean matchesSnapshot(Chunk live, TargetChunkSnapshot snap) {
@@ -516,6 +597,7 @@ public final class RelightService {
