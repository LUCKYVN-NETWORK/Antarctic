diff --git a/test/java/net/minecraft/server/RelightVerifierTest.java b/test/java/net/minecraft/server/RelightVerifierTest.java
new file mode 100644
index 0000000..567b954
--- /dev/null
+++ b/test/java/net/minecraft/server/RelightVerifierTest.java
@@ -0,0 +1,131 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.Lighting;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/**
+ * T5: post-apply border shell verification feeds border inconsistencies into PendingLightRegistry for repair,
+ * on-demand isLightConsistent checks the full chunk, and repeated non-convergence is capped after 3 attempts.
+ */
+public class RelightVerifierTest {
+
+    private boolean prevAsyncCatcher;
+    private WorldServer activeWorld;
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    @Before
+    public void setUp() {
+        this.prevAsyncCatcher = org.spigotmc.AsyncCatcher.enabled;
+        org.spigotmc.AsyncCatcher.enabled = false;
+        Lighting.asyncBulkRelight = true;
+        Lighting.asyncRelightThreads = 1;
+        Lighting.relightSnapshotBudgetMs = 50;
+        Lighting.relightApplyBudgetMs = 50;
+        Lighting.verifyAfterRelight = true;
+    }
+
+    @After
+    public void tearDown() {
+        if (this.activeWorld != null) {
+            this.activeWorld.shutdownRelightService();
+            this.activeWorld = null;
+        }
+        Lighting.asyncBulkRelight = false;
+        Lighting.asyncRelightThreads = 0;
+        Lighting.relightSnapshotBudgetMs = 5;
+        Lighting.relightApplyBudgetMs = 2;
+        Lighting.verifyAfterRelight = true;
+        org.spigotmc.AsyncCatcher.enabled = this.prevAsyncCatcher;
+    }
+
+    private WorldServer makeWorld(long seed) throws Exception {
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = LightPropagationParityTest.buildWorld(seed, p);
+        LightPropagationParityTest.set(World.class, world, "chunkPacketBlockController",
+            com.destroystokyo.paper.antixray.ChunkPacketBlockController.NO_OPERATION_INSTANCE);
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                Chunk c = world.getChunkIfLoaded(cx, cz);
+                LightPropagationParityTest.set(Chunk.class, c, "locX", cx);
+                LightPropagationParityTest.set(Chunk.class, c, "locZ", cz);
+            }
+        }
+        this.activeWorld = world;
+        return world;
+    }
+
+    private static void driveUntilDone(RelightService service, CompletableFuture<Integer> future) throws Exception {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (!future.isDone() && System.nanoTime() < deadline) {
+            service.tick();
+            if (!future.isDone()) {
+                Thread.sleep(1);
+            }
+        }
+        assertTrue(future.isDone());
+    }
+
+    @Test
+    public void postApplyBorderVerifierDetectsNeighbourDriftAndRepairsViaPendingLight() throws Exception {
+        WorldServer world = makeWorld(501L);
+        RelightService service = world.getRelightService();
+
+        // First relight chunk (0,0) cleanly so baseline is consistent
+        driveUntilDone(service, service.submit(new long[]{ChunkCoordIntPair.a(0, 0)}));
+        assertTrue("cleanly relit chunk must pass isLightConsistent", world.isLightConsistent(0, 0));
+
+        // Now start a relight on (0,0), snapshot it while neighbour (-1,0) is dark, then light up (-1,0)'s edge at x=-1!
+        CompletableFuture<Integer> f = service.submit(new long[]{ChunkCoordIntPair.a(0, 0)});
+        service.tick(); // snapshots (0,0) with dark neighbour (-1,0)
+
+        // While worker computes (0,0), a glowstone is placed right across the border in (-1,0) at (-1, 40, 8)
+        LightPropagationParityTest.setBlock(world, -1, 40, 8, Blocks.GLOWSTONE.getBlockData());
+        world.getChunkIfLoaded(-1, 0).a(EnumSkyBlock.BLOCK, new BlockPosition(-1, 40, 8), 15);
+
+        // Apply finishes on (0,0): border cell (0, 40, 8) is 0 while neighbour (-1, 40, 8) is 15 -> verifier detects & queues repair!
+        driveUntilDone(service, f);
+        assertFalse("chunk (0,0) border is inconsistent before deferred replay", world.isLightConsistent(0, 0));
+        assertTrue("verifier must feed inconsistent border cells into PendingLightRegistry", world.pendingLight.hasPending(ChunkCoordIntPair.a(0, 0)));
+
+        // Replaying PendingLightRegistry repairs the border cell cleanly!
+        int replayed = world.drainDeferredLight(1024);
+        assertTrue("deferred replay must run border repairs", replayed > 0);
+        assertEquals("border cell (0, 40, 8) must be repaired to light 14", 14, world.getBrightness(EnumSkyBlock.BLOCK, 0, 40, 8));
+        assertTrue("chunk (0,0) must be consistent after border repair", world.isLightConsistent(0, 0));
+    }
+
+    @Test
+    public void nonConvergingBorderRepairPausesAfterThreeAttempts() throws Exception {
+        WorldServer world = makeWorld(502L);
+        RelightService service = world.getRelightService();
+        Chunk target = world.getChunkIfLoaded(0, 0);
+
+        // Force a persistent border inconsistency (corrupt block light at (0, 40, 5) without fixing it)
+        target.a(EnumSkyBlock.BLOCK, new BlockPosition(0, 40, 5), 11);
+        assertFalse(world.isLightConsistent(0, 0));
+
+        // Invoke onChunkApplied 4 times without draining/fixing: first 3 queue repairs, 4th pauses
+        for (int attempt = 1; attempt <= 3; ++attempt) {
+            world.pendingLight.clearChunk(target.chunkKey);
+            service.onChunkApplied(target, 0, 0);
+            assertTrue("attempt " + attempt + " must queue border repair", world.pendingLight.hasPending(target.chunkKey));
+        }
+
+        world.pendingLight.clearChunk(target.chunkKey);
+        service.onChunkApplied(target, 0, 0);
+        assertFalse("4th consecutive non-converging verification must pause automatic repair", world.pendingLight.hasPending(target.chunkKey));
+    }
+}
