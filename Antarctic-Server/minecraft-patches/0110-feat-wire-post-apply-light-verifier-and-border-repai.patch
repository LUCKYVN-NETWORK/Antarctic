-    /** Hook invoked on main thread immediately after a chunk's light is written (wired to LightChecker verifier in Commit C3). */
+    /** Main-thread on-demand consistency check for the entire chunk (all sections, sky and block). */
+    public static boolean isLightConsistent(WorldServer world, int cx, int cz) {
+        LightChecker.Report report = verifyChunk(world, cx, cz, LightChecker.Scope.ALL, 0);
+        return report != null && report.consistent();
