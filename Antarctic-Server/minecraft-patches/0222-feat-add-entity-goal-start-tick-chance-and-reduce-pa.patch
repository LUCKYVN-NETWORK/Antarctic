@@ -0,0 +1,76 @@
+package com.destroystokyo.paper.config.toml.modules.optimizations;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+import java.util.Random;
+
+public class EntityGoal implements IConfigModule {
+
+    @ConfigInfo(
+        baseName = "start-tick-chance.nearest-attackable-target",
+        comments = "Probability (0.0-1.0) per tick to run PathfinderGoalNearestAttackableTarget.a() start check. Default -1.0 preserves vanilla roll."
+    )
+    public static double nearestAttackableTargetStartTickChance = -1.0D;
+
+    @ConfigInfo(
+        baseName = "start-tick-chance.avoid-target",
+        comments = "Probability (0.0-1.0) per tick to run PathfinderGoalAvoidTarget.a() start check. Default -1.0 preserves vanilla."
+    )
+    public static double avoidTargetStartTickChance = -1.0D;
+
+    @ConfigInfo(
+        baseName = "start-tick-chance.tempt",
+        comments = "Probability (0.0-1.0) per tick to run PathfinderGoalTempt.a() start check when not already tempting. Default -1.0 preserves vanilla."
+    )
+    public static double temptStartTickChance = -1.0D;
+
+    @ConfigInfo(
+        baseName = "start-tick-chance.follow-parent",
+        comments = "Probability (0.0-1.0) per tick to run PathfinderGoalFollowParent.a() start check. Default -1.0 preserves vanilla."
+    )
+    public static double followParentStartTickChance = -1.0D;
+
+    @ConfigInfo(
+        baseName = "start-tick-chance.enderman-look-for-player",
+        comments = "Probability (0.0-1.0) per tick to run EntityEnderman look-for-player goal start check. Default -1.0 preserves vanilla."
+    )
+    public static double endermanLookForPlayerStartTickChance = -1.0D;
+
+    public static boolean shouldSkipStartTick(double chance, Random random) {
+        if (chance < 0.0D || chance >= 1.0D) {
+            return false;
+        }
+        if (chance == 0.0D) {
+            return true;
+        }
+        return random.nextDouble() >= chance;
+    }
+
+    private static double normalizeChance(double value) {
+        if (value < 0.0D) {
+            return -1.0D;
+        }
+        return Math.min(1.0D, value);
+    }
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.OPTIMIZATIONS;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "entity-goal";
+    }
+
+    @Override
+    public void onLoaded(CommentedFileConfig config) {
+        nearestAttackableTargetStartTickChance = normalizeChance(nearestAttackableTargetStartTickChance);
+        avoidTargetStartTickChance = normalizeChance(avoidTargetStartTickChance);
+        temptStartTickChance = normalizeChance(temptStartTickChance);
+        followParentStartTickChance = normalizeChance(followParentStartTickChance);
+        endermanLookForPlayerStartTickChance = normalizeChance(endermanLookForPlayerStartTickChance);
+    }
+}
