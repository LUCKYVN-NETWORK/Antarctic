+
+public class NettyCodecAndSerializerPerfTest {
+
+    @BeforeClass
+    public static void init() {
+        DispenserRegistry.c();
+    }
+
+    @Test
+    public void testFramingZlibCodecsAndSerializerParity() throws Exception {
+        // 1. PacketPrepender + PacketSplitter round-trip & error paths
+        EmbeddedChannel frameChannel = new EmbeddedChannel(new PacketPrepender(), new PacketSplitter());
+        int[] sizes = {1, 127, 128, 16383, 16384, 65536};
+        for (int size : sizes) {
+            byte[] payload = new byte[size];
+            for (int i = 0; i < size; i++) {
+                payload[i] = (byte) (i * 31 + 7);
+            }
+            ByteBuf outBuf = Unpooled.wrappedBuffer(payload);
+            Assert.assertTrue(frameChannel.writeOutbound(outBuf));
+            ByteBuf framed = frameChannel.readOutbound();
+            Assert.assertTrue(frameChannel.writeInbound(framed));
+            ByteBuf decoded = frameChannel.readInbound();
+            byte[] actual = new byte[decoded.readableBytes()];
+            decoded.readBytes(actual);
+            decoded.release();
+            Assert.assertArrayEquals(payload, actual);
+        }
+
+        // Partial frame reset (writeInbound takes ownership of partial)
+        ByteBuf partial = Unpooled.buffer();
+        partial.writeByte(0x85); // incomplete 2-byte VarInt
+        Assert.assertFalse(frameChannel.writeInbound(partial));
+        Assert.assertEquals(0, partial.readerIndex());
+
+        // > 21-bit CorruptedFrameException
+        ByteBuf tooWide = Unpooled.buffer();
+        tooWide.writeByte(0x80).writeByte(0x80).writeByte(0x80).writeByte(0x01);
+        try {
+            frameChannel.writeInbound(tooWide);
+            Assert.fail("Expected CorruptedFrameException");
+        } catch (CorruptedFrameException expected) {
+            // pass
+        }
+        frameChannel.finishAndReleaseAll();
+
+        // Prepender > 3 bytes IllegalArgumentException
+        PacketPrepender prepender = new PacketPrepender();
+        ByteBuf oversized = Unpooled.buffer(2097152);
+        oversized.writerIndex(2097152);
+        ByteBuf dst = Unpooled.buffer(16);
+        try {
+            prepender.a(null, oversized, dst);
+            Assert.fail("Expected IllegalArgumentException");
+        } catch (IllegalArgumentException expected) {
+            // pass
+        } finally {
+            oversized.release();
+            dst.release();
+        }
+
+        // 2. PacketCompressor + PacketDecompressor heap & direct round-trip + error/leak check
+        EmbeddedChannel codecChannel = new EmbeddedChannel(new PacketCompressor(64), new PacketDecompressor(64));
+        byte[] small = "hello".getBytes(StandardCharsets.UTF_8);
+        byte[] large = new byte[1024];
+        for (int i = 0; i < large.length; i++) {
+            large[i] = (byte) (i & 15);
+        }
+
+        for (boolean direct : new boolean[]{false, true}) {
+            for (byte[] data : new byte[][]{small, large}) {
+                ByteBuf in = direct ? Unpooled.directBuffer(data.length) : Unpooled.buffer(data.length);
+                in.writeBytes(data);
+                Assert.assertTrue(codecChannel.writeOutbound(in));
+                ByteBuf compressed = codecChannel.readOutbound();
+                Assert.assertTrue(codecChannel.writeInbound(compressed));
+                ByteBuf decompressed = codecChannel.readInbound();
+                byte[] actual = new byte[decompressed.readableBytes()];
+                decompressed.readBytes(actual);
+                decompressed.release();
+                Assert.assertArrayEquals(data, actual);
+            }
+        }
+
+        // Corrupted zlib stream must throw DataFormatException and release allocated output buffer (no leak)
+        ByteBuf badZlib = Unpooled.buffer();
+        badZlib.writeByte(100); // uncompressed size = 100 >= threshold 64
+        badZlib.writeBytes(new byte[]{1, 2, 3, 4, 5});
+        try {
+            codecChannel.writeInbound(badZlib);
+            Assert.fail("Expected DataFormatException");
+        } catch (Exception ex) {
+            Assert.assertTrue(ex instanceof DataFormatException || ex.getCause() instanceof DataFormatException);
+        }
+        codecChannel.finishAndReleaseAll(); // also exercises handlerRemoved0() -> Inflater.end() & Deflater.end()
+
+        // 3. PacketDataSerializer parity: a(long[]), a(String) (including Paper 44767 limit), a(ItemStack)
+        long[] longs = {0L, 1L, -1L, 0x0102030405060708L, Long.MIN_VALUE, Long.MAX_VALUE};
+        ByteBuf bufOpt = Unpooled.buffer(256);
+        ByteBuf bufVan = Unpooled.buffer(256);
+        PacketDataSerializer serOpt = new PacketDataSerializer(bufOpt);
+        PacketDataSerializer serVan = new PacketDataSerializer(bufVan);
+
+        serOpt.a(longs);
+        serVan.d(longs.length);
+        for (long v : longs) {
+            serVan.writeLong(v);
+        }
+        Assert.assertEquals(bufVan, bufOpt);
+
+        String unicode = "Antarctic-1.12.2-\u00E9\u4E2D\uD83D\uDE80";
+        bufOpt.clear();
+        bufVan.clear();
+        serOpt.a(unicode);
+        byte[] utf8 = unicode.getBytes(StandardCharsets.UTF_8);
+        serVan.d(utf8.length);
+        serVan.writeBytes(utf8);
+        Assert.assertEquals(bufVan, bufOpt);
+
+        // Paper 44767 limit preserved (40000 chars allowed; 44768 throws EncoderException)
+        String ok40k = "a".repeat(40000);
+        bufOpt.clear();
+        serOpt.a(ok40k);
+        Assert.assertTrue(bufOpt.readableBytes() > 40000);
+        try {
+            serOpt.a("a".repeat(44768));
+            Assert.fail("Expected EncoderException above 44767");
+        } catch (EncoderException expected) {
+            // pass
+        }
+
+        // a(ItemStack) fast path when tag is null or empty (no Bukkit.server NPE)
+        bufOpt.clear();
+        ItemStack swordNoTag = new ItemStack(Items.DIAMOND_SWORD);
+        serOpt.a(swordNoTag);
+        swordNoTag.setTag(new NBTTagCompound());
+        serOpt.a(swordNoTag);
+        Assert.assertTrue(bufOpt.readableBytes() > 0);
+        bufOpt.release();
+        bufVan.release();
+    }
