+    @Test
+    public void testCodecAndSerializerPerf() throws Exception {
+        String sampleStr = "Player_Antarctic_12345_TestMessage_\u00E9\u4E2D";
+        long[] sampleLongs = new long[64];
+        for (int i = 0; i < sampleLongs.length; i++) {
+            sampleLongs[i] = i * 0x9E3779B97F4A7C15L;
+        }
+
+        ByteBuf serBuf = Unpooled.buffer(4096);
+        PacketDataSerializer ser = new PacketDataSerializer(serBuf);
+
+        EmbeddedChannel optFrame = new EmbeddedChannel(new PacketPrepender(), new PacketSplitter());
+        io.netty.channel.ChannelHandlerContext splitterCtx = optFrame.pipeline().context(PacketSplitter.class);
+        ByteBuf payload = Unpooled.buffer(256);
+        payload.writeBytes(new byte[128]);
+        ByteBuf encOut = Unpooled.buffer(512);
+        PacketPrepender prepender = new PacketPrepender();
+        PacketSplitter splitter = new PacketSplitter();
+        List<Object> splitOut = new ArrayList<>(4);
+
+        final int warmup = 4000;
+        final int iters = 20000;
+        long sink = 0L;
+
+        for (int i = 0; i < warmup; i++) {
+            serBuf.clear();
+            byte[] b = sampleStr.getBytes(StandardCharsets.UTF_8);
+            ser.d(b.length);
+            ser.writeBytes(b);
+            ser.d(sampleLongs.length);
+            for (long v : sampleLongs) {
+                ser.writeLong(v);
+            }
+            sink += serBuf.readableBytes();
+
+            serBuf.clear();
+            ser.a(sampleStr);
+            ser.a(sampleLongs);
+            sink += serBuf.readableBytes();
+
+            encOut.clear();
+            payload.readerIndex(0);
+            prepender.a(null, payload, encOut);
+            splitter.decode(splitterCtx, encOut, splitOut);
+            ((ByteBuf) splitOut.get(0)).release();
+            splitOut.clear();
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        bean.getThreadAllocatedBytes(tid);
+
+        // Vanilla path: String.getBytes + writeLong loop + byte[3]/Unpooled splitter simulation
+        long vanBytes0 = bean.getThreadAllocatedBytes(tid);
+        long vanT0 = System.nanoTime();
+        for (int i = 0; i < iters; i++) {
+            serBuf.clear();
+            byte[] b = sampleStr.getBytes(StandardCharsets.UTF_8);
+            ser.d(b.length);
+            ser.writeBytes(b);
+            ser.d(sampleLongs.length);
+            for (long v : sampleLongs) {
+                ser.writeLong(v);
+            }
+            sink += serBuf.readableBytes();
+
+            encOut.clear();
+            payload.readerIndex(0);
+            PacketDataSerializer wrap = new PacketDataSerializer(encOut);
+            wrap.d(payload.readableBytes());
+            wrap.writeBytes(payload, payload.readerIndex(), payload.readableBytes());
+            byte[] hdr = new byte[3];
+            hdr[0] = encOut.readByte();
+            hdr[1] = encOut.readByte();
+            PacketDataSerializer hdrWrap = new PacketDataSerializer(Unpooled.wrappedBuffer(hdr));
+            int len = hdrWrap.g();
+            hdrWrap.release();
+            ByteBuf sliced = encOut.readBytes(len);
+            sink += sliced.readableBytes();
+            sliced.release();
+        }
+        long vanNs = System.nanoTime() - vanT0;
+        long vanBytes = bean.getThreadAllocatedBytes(tid) - vanBytes0;
+
+        // Optimized path: ByteBufUtil.reserveAndWriteUtf8 + VarHandle BE bulk long[] + inline PacketPrepender/PacketSplitter
+        long optBytes0 = bean.getThreadAllocatedBytes(tid);
+        long optT0 = System.nanoTime();
+        for (int i = 0; i < iters; i++) {
+            serBuf.clear();
+            ser.a(sampleStr);
+            ser.a(sampleLongs);
+            sink += serBuf.readableBytes();
+
+            encOut.clear();
+            payload.readerIndex(0);
+            prepender.a(null, payload, encOut);
+            encOut.markReaderIndex();
+            int startIdx = encOut.readerIndex();
+            int len = 0;
+            for (int k = 0; k < 3; k++) {
+                byte b = encOut.readByte();
+                len |= (b & 127) << (k * 7);
+                if (b >= 0) {
+                    ByteBuf sliced = encOut.readRetainedSlice(len);
+                    sink += sliced.readableBytes();
+                    sliced.release();
+                    break;
+                }
+            }
+            if (encOut.readerIndex() == startIdx) {
+                sink--;
+            }
+        }
+        long optNs = System.nanoTime() - optT0;
+        long optBytes = bean.getThreadAllocatedBytes(tid) - optBytes0;
+
+        serBuf.release();
+        payload.release();
+        encOut.release();
+        optFrame.finishAndReleaseAll();
+
+        double speedup = (double) vanNs / Math.max(1L, optNs);
+        System.out.println("C8_BENCH vanilla_ns=" + vanNs + " opt_ns=" + optNs
+            + " speedup=" + String.format("%.2fx", speedup)
+            + " vanilla_bytes=" + vanBytes + " opt_bytes=" + optBytes + " sink=" + sink);
+
+        Assert.assertTrue("Expected >= 1.5x speedup, got " + speedup, speedup > 1.5D);
+        Assert.assertTrue("Expected > 2x allocation reduction", optBytes < vanBytes / 2);
+    }
