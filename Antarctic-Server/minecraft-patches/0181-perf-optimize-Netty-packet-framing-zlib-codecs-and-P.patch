+package net.minecraft.server;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.handler.codec.ByteToMessageDecoder;
+import io.netty.handler.codec.DecoderException;
+import java.nio.ByteBuffer;
+import java.util.List;
+import java.util.zip.Inflater;
+
+public class PacketDecompressor extends ByteToMessageDecoder {
+
+    private final Inflater a;
+    private int b;
+
+    public PacketDecompressor(int i) {
+        this.b = i;
+        this.a = new Inflater();
+    }
+
+    // Antarctic start - zero-copy pooled ByteBuf decompression and Inflater lifecycle cleanup
+    @Override
+    protected void handlerRemoved0(ChannelHandlerContext ctx) throws Exception {
+        this.a.end();
+        super.handlerRemoved0(ctx);
+    }
+
+    private static int readVarInt(ByteBuf buf) {
+        int i = 0;
+        int j = 0;
+        byte b0;
+        do {
+            b0 = buf.readByte();
+            i |= (b0 & 127) << (j++ * 7);
+            if (j > 5) {
+                throw new RuntimeException("VarInt too big");
+            }
+        } while ((b0 & 128) == 128);
+        return i;
+    }
+
+    protected void decode(ChannelHandlerContext channelhandlercontext, ByteBuf bytebuf, List<Object> list) throws Exception {
+        if (bytebuf.readableBytes() != 0) {
+            int i = readVarInt(bytebuf);
+
+            if (i == 0) {
+                list.add(bytebuf.readRetainedSlice(bytebuf.readableBytes()));
+            } else {
+                if (i < this.b) {
+                    throw new DecoderException("Badly compressed packet - size of " + i + " is below server threshold of " + this.b);
+                }
+
+                if (i > 2097152) {
+                    throw new DecoderException("Badly compressed packet - size of " + i + " is larger than protocol maximum of " + 2097152);
+                }
+
+                int readable = bytebuf.readableBytes();
+                ByteBuf out = channelhandlercontext.alloc().buffer(i);
+                boolean success = false;
+                try {
+                    if (bytebuf.hasArray()) {
+                        this.a.setInput(bytebuf.array(), bytebuf.arrayOffset() + bytebuf.readerIndex(), readable);
+                        bytebuf.skipBytes(readable);
+                    } else if (bytebuf.nioBufferCount() == 1) {
+                        this.a.setInput(bytebuf.nioBuffer());
+                        bytebuf.skipBytes(readable);
+                    } else {
+                        byte[] abyte = new byte[readable];
+                        bytebuf.readBytes(abyte);
+                        this.a.setInput(abyte);
+                    }
+
+                    if (out.hasArray()) {
+                        byte[] outArr = out.array();
+                        int outOff = out.arrayOffset() + out.writerIndex();
+                        int total = 0;
+                        while (total < i && !this.a.finished() && !this.a.needsInput()) {
+                            int inflated = this.a.inflate(outArr, outOff + total, i - total);
+                            if (inflated == 0) {
+                                break;
+                            }
+                            total += inflated;
+                        }
+                        out.writerIndex(out.writerIndex() + total);
+                    } else if (out.nioBufferCount() == 1) {
+                        ByteBuffer outNio = out.nioBuffer(out.writerIndex(), i);
+                        int total = 0;
+                        while (total < i && !this.a.finished() && !this.a.needsInput()) {
+                            int inflated = this.a.inflate(outNio);
+                            if (inflated == 0) {
+                                break;
+                            }
+                            total += inflated;
+                        }
+                        out.writerIndex(out.writerIndex() + total);
+                    } else {
+                        byte[] abyte1 = new byte[i];
+                        int total = 0;
+                        while (total < i && !this.a.finished() && !this.a.needsInput()) {
+                            int inflated = this.a.inflate(abyte1, total, i - total);
+                            if (inflated == 0) {
+                                break;
+                            }
+                            total += inflated;
+                        }
+                        out.writeBytes(abyte1, 0, total);
+                    }
