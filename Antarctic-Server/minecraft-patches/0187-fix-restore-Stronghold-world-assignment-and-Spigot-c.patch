diff --git a/test/java/net/minecraft/server/StructureSeedAndStrongholdParityTest.java b/test/java/net/minecraft/server/StructureSeedAndStrongholdParityTest.java
new file mode 100644
index 0000000..a2dcdd1
--- /dev/null
+++ b/test/java/net/minecraft/server/StructureSeedAndStrongholdParityTest.java
@@ -0,0 +1,135 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.PaperWorldConfig;
+import java.lang.reflect.Field;
+import java.util.HashSet;
+import java.util.Random;
+import java.util.Set;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import org.spigotmc.SpigotWorldConfig;
+import sun.misc.Unsafe;
+
+public class StructureSeedAndStrongholdParityTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void init() throws Exception {
+        DispenserRegistry.c();
+        org.spigotmc.AsyncCatcher.enabled = false;
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    private static final class SeedRecordingWorld extends WorldServer {
+        final Set<Integer> salts = new HashSet<>();
+
+        SeedRecordingWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public Random a(int i, int j, int k) {
+            salts.add(k);
+            return new Random((long) i * 341873128712L + (long) j * 132897987541L + 12345L + (long) k);
+        }
+
+        @Override
+        public WorldChunkManager getWorldChunkManager() {
+            return new WorldChunkManager(new WorldData()) {
+                @Override
+                public BiomeBase getBiome(BlockPosition blockposition) {
+                    return Biomes.d;
+                }
+
+                @Override
+                public boolean a(int i, int j, int k, java.util.List<BiomeBase> list) {
+                    return false;
+                }
+            };
+        }
+
+        @Override
+        public PersistentBase a(Class<? extends PersistentBase> oclass, String s) {
+            return null;
+        }
+
+        @Override
+        public void a(String s, PersistentBase persistentbase) {
+        }
+    }
+
+    private static SeedRecordingWorld createWorld() throws Exception {
+        SeedRecordingWorld world = (SeedRecordingWorld) unsafe.allocateInstance(SeedRecordingWorld.class);
+        unsafe.putObject(world, unsafe.objectFieldOffset(SeedRecordingWorld.class.getDeclaredField("salts")), new HashSet<>());
+        world.worldData = new WorldData();
+        SpigotWorldConfig spigot = (SpigotWorldConfig) unsafe.allocateInstance(SpigotWorldConfig.class);
+        spigot.saveStructureInfo = false;
+        spigot.largeFeatureSeed = 111111;
+        spigot.monumentSeed = 222222;
+        spigot.villageSeed = 333333;
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("spigotConfig")), spigot);
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("paperConfig")), unsafe.allocateInstance(PaperWorldConfig.class));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("random")), new Random(42L));
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("methodProfiler")), new MethodProfiler());
+        unsafe.putObject(world, unsafe.objectFieldOffset(World.class.getDeclaredField("P")), new WorldBorder());
+        world.worldProvider = new WorldProviderNormal();
+        world.worldProvider.a(world);
+        return world;
+    }
+
+    @Test
+    public void testStrongholdGetNearestGeneratedFeatureAssignsWorldBeforeInit() throws Exception {
+        SeedRecordingWorld world = createWorld();
+        WorldGenStronghold stronghold = new WorldGenStronghold();
+        BlockPosition nearest = stronghold.getNearestGeneratedFeature(world, new BlockPosition(0, 64, 0), false);
+        Assert.assertNotNull(nearest);
+        Assert.assertSame(world, stronghold.g);
+    }
+
+    @Test
+    public void testCustomSpigotStructureSeedsAreUsedInScanAndLookup() throws Exception {
+        SeedRecordingWorld world = createWorld();
+        ChunkSnapshot snapshot = new ChunkSnapshot();
+
+        WorldGenLargeFeature largeFeature = new WorldGenLargeFeature();
+        largeFeature.a(world, 0, 0, snapshot);
+        largeFeature.getNearestGeneratedFeature(world, new BlockPosition(0, 64, 0), false);
+        Assert.assertTrue("Expected custom largeFeatureSeed 111111", world.salts.contains(111111));
+        Assert.assertFalse("Hardcoded vanilla salt 14357617 must not be used", world.salts.contains(14357617));
+
+        world.salts.clear();
+        WorldGenMonument monument = new WorldGenMonument();
+        monument.a(world, 0, 0, snapshot);
+        monument.getNearestGeneratedFeature(world, new BlockPosition(0, 64, 0), false);
+        Assert.assertTrue("Expected custom monumentSeed 222222", world.salts.contains(222222));
+        Assert.assertFalse("Hardcoded vanilla salt 10387313 must not be used", world.salts.contains(10387313));
+
+        world.salts.clear();
+        WorldGenVillage village = new WorldGenVillage();
+        village.a(world, 0, 0, snapshot);
+        village.getNearestGeneratedFeature(world, new BlockPosition(0, 64, 0), false);
+        Assert.assertTrue("Expected custom villageSeed 333333", world.salts.contains(333333));
+        Assert.assertFalse("Hardcoded vanilla salt 10387312 must not be used", world.salts.contains(10387312));
+    }
+
+    @Test
+    public void testWorldGenCavesAssociativityMatchesVanilla() throws Exception {
+        SeedRecordingWorld world = createWorld();
+        ChunkSnapshot snapshot = new ChunkSnapshot();
+        IBlockData stone = Blocks.STONE.getBlockData();
+        for (int x = 0; x < 16; x++) {
+            for (int z = 0; z < 16; z++) {
+                for (int y = 1; y < 60; y++) {
+                    snapshot.a(x, y, z, stone);
+                }
+            }
+        }
+        WorldGenCaves caves = new WorldGenCaves();
+        caves.a(world, 0, 0, snapshot);
+        Assert.assertNotNull(snapshot.a(0, 10, 0));
+    }
+}
