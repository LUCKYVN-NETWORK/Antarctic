diff --git a/main/java/net/minecraft/server/IntCache.java b/main/java/net/minecraft/server/IntCache.java
index 140f34f..ed68f8b 100644
--- a/main/java/net/minecraft/server/IntCache.java
+++ b/main/java/net/minecraft/server/IntCache.java
@@ -18,8 +18,14 @@ public class IntCache {
 
     private static final ThreadLocal<Pool> POOL = ThreadLocal.withInitial(Pool::new);
 
+    private static int effectiveCacheLimit() {
+        int limit = org.spigotmc.SpigotConfig.intCacheLimit;
+        return (limit <= 0 || limit > MAX_FREE) ? MAX_FREE : limit;
+    }
+
     public static int[] a(int i) {
         Pool pool = POOL.get();
+        int limit = effectiveCacheLimit();
 
         if (i <= 256) {
             int idx = pool.smallCursor++;
@@ -27,7 +33,7 @@ public class IntCache {
                 return pool.small[idx];
             }
             int[] aint = new int[256];
-            if (idx < MAX_FREE) {
+            if (idx < limit) {
                 pool.small[idx] = aint;
                 pool.smallCount = idx + 1;
             }
@@ -48,7 +54,7 @@ public class IntCache {
             return pool.large[idx];
         }
         int[] aint = new int[pool.maxSize];
-        if (idx < MAX_FREE) {
+        if (idx < limit) {
             pool.large[idx] = aint;
             pool.largeCount = idx + 1;
         }
@@ -57,6 +63,19 @@ public class IntCache {
 
     public static void a() {
         Pool pool = POOL.get();
+        int limit = effectiveCacheLimit();
+        while (pool.smallCount > limit) {
+            pool.small[--pool.smallCount] = null;
+        }
+        if (pool.smallCount > pool.smallCursor) {
+            pool.small[--pool.smallCount] = null;
+        }
+        while (pool.largeCount > limit) {
+            pool.large[--pool.largeCount] = null;
+        }
+        if (pool.largeCount > pool.largeCursor) {
+            pool.large[--pool.largeCount] = null;
+        }
         pool.smallCursor = 0;
         pool.largeCursor = 0;
     }
