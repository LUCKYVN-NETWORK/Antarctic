diff --git a/test/java/net/minecraft/server/RegionZlibAndIntCacheParityTest.java b/test/java/net/minecraft/server/RegionZlibAndIntCacheParityTest.java
new file mode 100644
index 0000000..bd2da5b
--- /dev/null
+++ b/test/java/net/minecraft/server/RegionZlibAndIntCacheParityTest.java
@@ -0,0 +1,130 @@
+package net.minecraft.server;
+
+import java.io.ByteArrayOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.lang.reflect.Constructor;
+import java.util.Arrays;
+import java.util.zip.DeflaterOutputStream;
+import org.junit.Assert;
+import org.junit.Test;
+import org.spigotmc.SpigotConfig;
+
+public class RegionZlibAndIntCacheParityTest {
+
+    private static byte[] compress(byte[] raw) throws IOException {
+        ByteArrayOutputStream baos = new ByteArrayOutputStream();
+        try (DeflaterOutputStream dos = new DeflaterOutputStream(baos)) {
+            dos.write(raw);
+        }
+        return baos.toByteArray();
+    }
+
+    private static InputStream openPooledZlibStream(byte[] compressed) {
+        return RegionFile.inflateZlib(compressed);
+    }
+
+    @Test
+    public void testTruncatedZlibThrowsEofOnByteAndBulkRead() throws Exception {
+        byte[] payload = new byte[128];
+        for (int i = 0; i < payload.length; i++) {
+            payload[i] = (byte) (i * 31 + 7);
+        }
+        byte[] valid = compress(payload);
+        byte[] truncated = Arrays.copyOf(valid, Math.max(4, valid.length - 4));
+
+        // 1) Single-byte read loop must throw EOFException
+        try (InputStream in = openPooledZlibStream(truncated)) {
+            boolean threwEof = false;
+            try {
+                while (in.read() != -1) {
+                    // consume available decompressed prefix
+                }
+            } catch (EOFException expected) {
+                threwEof = true;
+            }
+            Assert.assertTrue("Truncated ZLIB stream must throw EOFException on read()", threwEof);
+        }
+
+        // 2) Direct bulk read (>= internal buffer size) must throw EOFException
+        try (InputStream in = openPooledZlibStream(truncated)) {
+            byte[] largeBuf = new byte[8192];
+            boolean threwEof = false;
+            try {
+                while (in.read(largeBuf, 0, largeBuf.length) != -1) {
+                    // consume
+                }
+            } catch (EOFException expected) {
+                threwEof = true;
+            }
+            Assert.assertTrue("Truncated ZLIB stream must throw EOFException on bulk read()", threwEof);
+        }
+    }
+
+    @Test
+    public void testClosedPooledZlibStreamRejectsUnreadBufferedBytes() throws Exception {
+        byte[] payload = new byte[512];
+        Arrays.fill(payload, (byte) 42);
+        byte[] compressed = compress(payload);
+
+        InputStream in = openPooledZlibStream(compressed);
+        Assert.assertEquals(42, in.read());
+        in.close();
+
+        boolean singleReadRejected = false;
+        try {
+            in.read();
+        } catch (IOException expected) {
+            singleReadRejected = true;
+        }
+        Assert.assertTrue("read() after close() must throw IOException even with buffered bytes", singleReadRejected);
+
+        boolean bulkReadRejected = false;
+        try {
+            in.read(new byte[16], 0, 16);
+        } catch (IOException expected) {
+            bulkReadRejected = true;
+        }
+        Assert.assertTrue("read(byte[],int,int) after close() must throw IOException even with buffered bytes", bulkReadRejected);
+    }
+
+    @Test
+    public void testIntCacheRespectsSpigotLimitAndDecaysUnusedArrays() {
+        int prevLimit = SpigotConfig.intCacheLimit;
+        try {
+            // Drain any existing arrays on this thread
+            for (int i = 0; i < 70; i++) {
+                IntCache.a();
+            }
+
+            // Positive intCacheLimit caps retention
+            SpigotConfig.intCacheLimit = 3;
+            for (int i = 0; i < 6; i++) {
+                IntCache.a(256);
+                IntCache.a(512);
+            }
+            IntCache.a();
+            String statsAfterCap = IntCache.b();
+            Assert.assertTrue("Expected tcache: 3 when intCacheLimit=3, got: " + statsAfterCap, statsAfterCap.contains("tcache: 3"));
+            Assert.assertTrue("Expected cache: 3 when intCacheLimit=3, got: " + statsAfterCap, statsAfterCap.contains("cache: 3"));
+
+            // Unused arrays decay by 1 per IntCache.a() call
+            IntCache.a();
+            String statsAfterDecay = IntCache.b();
+            Assert.assertTrue("Expected tcache: 2 after decay, got: " + statsAfterDecay, statsAfterDecay.contains("tcache: 2"));
+            Assert.assertTrue("Expected cache: 2 after decay, got: " + statsAfterDecay, statsAfterDecay.contains("cache: 2"));
+
+            // intCacheLimit <= 0 behaves as unlimited (capped at MAX_FREE = 64)
+            SpigotConfig.intCacheLimit = 0;
+            for (int i = 0; i < 10; i++) {
+                IntCache.a(256);
+            }
+            IntCache.a();
+            String statsUnlimited = IntCache.b();
+            Assert.assertTrue("Expected tcache: 10 when intCacheLimit=0, got: " + statsUnlimited, statsUnlimited.contains("tcache: 10"));
+        } finally {
+            SpigotConfig.intCacheLimit = prevLimit;
+        }
+    }
+}
