+    @Test
+    public void testPushCollectionBenchmark() throws Exception {
+        PushTestWorld world = createTestWorld();
+        EntityZombie self = createMob(world, 5.0, 65.0, 5.0);
+        world.chunk.a(self);
+        for (int i = 0; i < 30; ++i) {
+            if (i < 2) {
+                world.chunk.a(createMob(world, 5.05 + i * 0.05, 65.0, 5.05));
+            } else {
+                world.chunk.a(createMob(world, 1.0 + (i % 6) * 2.5, 65.0, 1.0 + (i / 6) * 2.5));
+            }
+        }
+
+        ArrayList<Entity> scratch = new ArrayList<Entity>(32);
+        ThreadMXBean threadBean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        long sink = 0L;
+        for (int w = 0; w < 2000; ++w) {
+            sink += world.getEntities(self, self.getBoundingBox(), IEntitySelector.a(self)).size();
+            scratch.clear();
+            world.collectPushableEntities(self, self.getBoundingBox(), null, ScoreboardTeamBase.EnumTeamPush.ALWAYS, scratch);
+            sink += scratch.size();
+        }
+
+        int iters = 10000;
+        long a0 = threadBean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            sink += world.getEntities(self, self.getBoundingBox(), IEntitySelector.a(self)).size();
+        }
+        long vanillaNs = System.nanoTime() - t0;
+        long vanillaBytes = Math.max(0L, threadBean.getThreadAllocatedBytes(tid) - a0);
+
+        a0 = threadBean.getThreadAllocatedBytes(tid);
+        t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            scratch.clear();
+            world.collectPushableEntities(self, self.getBoundingBox(), null, ScoreboardTeamBase.EnumTeamPush.ALWAYS, scratch);
+            sink += scratch.size();
+        }
+        long optNs = System.nanoTime() - t0;
+        long optBytes = Math.max(0L, threadBean.getThreadAllocatedBytes(tid) - a0);
+
+        System.out.printf("B4_BENCH push10k_vanilla_ns=%d push10k_opt_ns=%d speedup=%.2fx vanilla_bytes=%d opt_bytes=%d blackhole=%d%n",
+                vanillaNs, optNs, (double) vanillaNs / Math.max(1L, optNs), vanillaBytes, optBytes, sink);
+
+        assertEquals("Push collection with reusable list must allocate 0 bytes", 0L, optBytes);
+        assertTrue("Expected push collection speedup > 1.2x, got " + vanillaNs + " vs " + optNs, optNs * 1.2 < vanillaNs);
+    }
