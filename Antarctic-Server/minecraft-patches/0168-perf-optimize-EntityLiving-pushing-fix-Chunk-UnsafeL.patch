+    private static EntityZombie createMob(World world, double x, double y, double z) throws Exception {
+        EntityZombie e = (EntityZombie) UNSAFE.allocateInstance(EntityZombie.class);
+        e.h(nextEntityId++);
+        e.world = world;
+        initLivingHealth(e);
+        e.locX = x; e.locY = y; e.locZ = z;
+        e.a(new AxisAlignedBB(x - 0.3, y, z - 0.3, x + 0.3, y + 1.95, z + 0.3));
+        return e;
+    }
