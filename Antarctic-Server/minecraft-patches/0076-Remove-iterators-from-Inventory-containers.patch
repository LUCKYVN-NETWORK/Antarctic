Date: Sun, 18 Oct 2026 17:37:53 +0700
Subject: [PATCH 076/120] Remove iterators from Inventory containers

- Backport Leaf MC 0191 (Remove iterators from Inventory)
- Replace iterator allocations with indexed loops in isEmpty (x_) checks across TileEntityChest, TileEntityHopper, TileEntityDispenser, TileEntityFurnace, TileEntityBrewingStand, InventorySubcontainer, EntityMinecartContainer, InventoryCrafting, InventoryCraftResult, and PlayerInventory
- Replace iterator allocations in hopper isFull check (r) and recipe manager feeding loops (a)
- Eliminate iterator garbage during hopper ticking and container inventory inspections

diff --git a/main/java/net/minecraft/server/EntityMinecartContainer.java b/main/java/net/minecraft/server/EntityMinecartContainer.java
index 15f392d..decf483 100644
--- a/main/java/net/minecraft/server/EntityMinecartContainer.java
+++ b/main/java/net/minecraft/server/EntityMinecartContainer.java
@@ -98,19 +98,14 @@ public abstract class EntityMinecartContainer extends EntityMinecartAbstract imp
     }
 
     public boolean x_() {
-        Iterator iterator = this.items.iterator();
-
-        ItemStack itemstack;
-
-        do {
-            if (!iterator.hasNext()) {
-                return true;
+        // Leaf start - Remove iterators from inventory (backport of Leaf MC 0191)
+        for (int i = 0; i < this.items.size(); ++i) {
+            if (!this.items.get(i).isEmpty()) {
+                return false;
             }
-
-            itemstack = (ItemStack) iterator.next();
-        } while (itemstack.isEmpty());
-
-        return false;
+        }
+        return true;
+        // Leaf end
     }
 
     public ItemStack getItem(int i) {
