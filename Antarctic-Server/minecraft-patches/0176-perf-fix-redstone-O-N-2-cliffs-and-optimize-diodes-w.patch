+    @Test
+    public void testRedstoneCliffsAndComponentsBenchmark() throws Exception {
+        TestWorld world = createWorld();
+        BlockRedstoneWire wire = (BlockRedstoneWire) Blocks.REDSTONE_WIRE;
+        IBlockData wire10 = wire.getBlockData().set(BlockRedstoneWire.POWER, 10);
+        setBlock(world, 8, 65, 8, wire10);
+        setBlock(world, 8, 65, 7, wire10);
+        setBlock(world, 8, 65, 9, wire10);
+        BlockPosition wirePos = new BlockPosition(8, 65, 8);
+        BlockPosition powerPos = new BlockPosition(5, 65, 5);
+
+        // Pre-populate 500-torch deque/counts
+        ArrayDeque<BlockRedstoneTorch.RedstoneUpdateInfo> deque = new ArrayDeque<>();
+        it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap counts = new it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap();
+        for (int i = 0; i < 500; i++) {
+            BlockPosition bp = new BlockPosition(i & 15, 65, (i >> 4) & 15);
+            deque.add(new BlockRedstoneTorch.RedstoneUpdateInfo(bp, 100L));
+            counts.addTo(bp.asLong(), 1);
+        }
+        BlockPosition probeTorch = new BlockPosition(15, 65, 15);
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        for (int i = 0; i < 6000; i++) {
+            runVanillaComponentQuery(world, wire, wire10, wirePos, powerPos);
+            runOptComponentQuery(world, wire, wire10, wirePos, powerPos);
+        }
+        bean.getThreadAllocatedBytes(tid);
+
+        // Component query bench (50k)
+        final int compIters = 50000;
+        long cvT0 = System.nanoTime();
+        int sink = 0;
+        for (int i = 0; i < compIters; i++) {
+            sink += runVanillaComponentQuery(world, wire, wire10, wirePos, powerPos);
+        }
+        long cvNs = System.nanoTime() - cvT0;
+
+        long coAlloc0 = bean.getThreadAllocatedBytes(tid);
+        long coT0 = System.nanoTime();
+        for (int i = 0; i < compIters; i++) {
+            sink += runOptComponentQuery(world, wire, wire10, wirePos, powerPos);
+        }
+        long coNs = System.nanoTime() - coT0;
+        long coBytes = bean.getThreadAllocatedBytes(tid) - coAlloc0;
+
+        // Cliff bench: 2000 playBlockAction dedups + 500 torch burnout lookups
+        long cliffVT0 = System.nanoTime();
+        List<BlockActionData> vanillaList = new ArrayList<>(2048);
+        for (int i = 0; i < 2000; i++) {
+            BlockActionData d = new BlockActionData(new BlockPosition(i & 15, 64, i >> 4), Blocks.PISTON, 0, 1);
+            boolean exists = false;
+            for (int j = 0, sz = vanillaList.size(); j < sz; j++) {
+                if (vanillaList.get(j).equals(d)) { exists = true; break; }
+            }
+            if (!exists) vanillaList.add(d);
+        }
+        for (int i = 0; i < 500; i++) {
+            int c = 0;
+            for (BlockRedstoneTorch.RedstoneUpdateInfo info : deque) {
+                if (info.a.equals(probeTorch)) c++;
+            }
+            sink += c;
+        }
+        long cliffVNs = System.nanoTime() - cliffVT0;
+
+        long cliffOT0 = System.nanoTime();
+        ObjectLinkedOpenHashSet<BlockActionData> optSet = new ObjectLinkedOpenHashSet<>(2048);
+        for (int i = 0; i < 2000; i++) {
+            optSet.add(new BlockActionData(new BlockPosition(i & 15, 64, i >> 4), Blocks.PISTON, 0, 1));
+        }
+        long tKey = probeTorch.asLong();
+        for (int i = 0; i < 500; i++) {
+            sink += counts.get(tKey);
+        }
+        long cliffONs = System.nanoTime() - cliffOT0;
+
+        long totalV = cvNs + cliffVNs;
+        long totalO = coNs + cliffONs;
+        double speedup = (double) totalV / (double) Math.max(1L, totalO);
+        System.out.println(String.format(
+                "C3_BENCH vanilla_ns=%d opt_ns=%d speedup=%.2fx comp_opt_bytes=%d cliff_speedup=%.2fx sink=%d",
+                totalV, totalO, speedup, coBytes, (double) cliffVNs / Math.max(1L, cliffONs), sink));
+
+        Assert.assertEquals("Component queries must allocate 0 bytes", 0L, coBytes);
+        Assert.assertTrue("Expected speedup > 2.5x, got " + speedup, speedup > 2.5D);
+    }
+
+    private static int runVanillaComponentQuery(World world, BlockRedstoneWire wire, IBlockData wireData, BlockPosition wirePos, BlockPosition powerPos) {
+        int acc = 0;
+        if (Blocks.UNPOWERED_REPEATER.D(Blocks.POWERED_REPEATER.getBlockData())) acc++;
+        EnumSet<EnumDirection> set = EnumSet.noneOf(EnumDirection.class);
+        Iterator<EnumDirection> it = EnumDirection.EnumDirectionLimit.HORIZONTAL.iterator();
+        while (it.hasNext()) {
+            EnumDirection dir = it.next();
+            if (world.getType(wirePos.shift(dir)).getBlock() == Blocks.REDSTONE_WIRE) {
+                set.add(dir);
+            }
+        }
+        acc += set.size();
+        for (EnumDirection d : EnumDirection.values()) {
+            acc += world.getBlockFacePower(powerPos.shift(d), d);
+        }
+        return acc;
+    }
+
+    private static int runOptComponentQuery(World world, BlockRedstoneWire wire, IBlockData wireData, BlockPosition wirePos, BlockPosition powerPos) {
+        int acc = 0;
+        if (BlockDiodeAbstract.isDiode(Blocks.POWERED_REPEATER.getBlockData())) acc++;
+        acc += wire.b(wireData, world, wirePos, EnumDirection.EAST);
+        acc += world.z(powerPos);
+        return acc;
+    }
