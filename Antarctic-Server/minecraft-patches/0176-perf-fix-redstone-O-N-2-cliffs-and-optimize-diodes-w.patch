+        // Dot (no neighbors) -> UP=12, DOWN=0, N/E/S/W=12
+        Assert.assertEquals(12, wire.b(wire12, world, new BlockPosition(10, 65, 10), EnumDirection.UP));
+        Assert.assertEquals(0, wire.b(wire12, world, new BlockPosition(10, 65, 10), EnumDirection.DOWN));
+        Assert.assertEquals(12, wire.b(wire12, world, new BlockPosition(10, 65, 10), EnumDirection.NORTH));
+        Assert.assertEquals(12, wire.b(wire12, world, new BlockPosition(10, 65, 10), EnumDirection.EAST));
+        // Straight line N-S: NORTH=12, SOUTH=12, EAST=0, WEST=0
+        setBlock(world, 10, 65, 9, wire12);
+        setBlock(world, 10, 65, 11, wire12);
+        Assert.assertEquals(12, wire.b(wire12, world, new BlockPosition(10, 65, 10), EnumDirection.NORTH));
+        Assert.assertEquals(0, wire.b(wire12, world, new BlockPosition(10, 65, 10), EnumDirection.EAST));
+        // Step-up blocked by opaque block above center
+        setBlock(world, 10, 65, 9, Blocks.STONE.getBlockData());
+        setBlock(world, 10, 66, 9, wire12);
+        setBlock(world, 10, 65, 11, Blocks.AIR.getBlockData());
+        Assert.assertEquals(12, wire.b(wire12, world, new BlockPosition(10, 65, 10), EnumDirection.NORTH));
+        setBlock(world, 10, 66, 10, Blocks.STONE.getBlockData()); // blocks step-up!
+        Assert.assertEquals(12, wire.b(wire12, world, new BlockPosition(10, 65, 10), EnumDirection.EAST)); // back to dot
+
+        // 5. Comparator item frame 0 / 1 / 2 check
+        BlockRedstoneComparator comp = (BlockRedstoneComparator) Blocks.UNPOWERED_COMPARATOR;
+        Method findFrame = BlockRedstoneComparator.class.getDeclaredMethod("a", World.class, EnumDirection.class, int.class, int.class, int.class);
+        findFrame.setAccessible(true);
+        Assert.assertNull(findFrame.invoke(comp, world, EnumDirection.NORTH, 12, 65, 12));
+        EntityItemFrame f1 = createItemFrame(world, 12, 65, 12, EnumDirection.NORTH);
+        Assert.assertSame(f1, findFrame.invoke(comp, world, EnumDirection.NORTH, 12, 65, 12));
+        createItemFrame(world, 12, 65, 12, EnumDirection.NORTH);
+        Assert.assertNull(findFrame.invoke(comp, world, EnumDirection.NORTH, 12, 65, 12));
+
+        // 6. World.z() & isBlockIndirectlyPowered()
+        setBlock(world, 4, 65, 4, Blocks.REDSTONE_BLOCK.getBlockData());
+        Assert.assertEquals(15, world.z(new BlockPosition(5, 65, 4)));
+        Assert.assertTrue(world.isBlockIndirectlyPowered(new BlockPosition(5, 65, 4)));
+        Assert.assertEquals(0, world.z(new BlockPosition(2, 65, 2)));
+        Assert.assertFalse(world.isBlockIndirectlyPowered(new BlockPosition(2, 65, 2)));
+    }
