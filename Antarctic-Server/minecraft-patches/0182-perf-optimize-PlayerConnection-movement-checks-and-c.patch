+        AxisAlignedBB[] boxes = {
+            new AxisAlignedBB(4.8D, 64.5D, 4.8D, 5.2D, 65.5D, 5.2D),   // tall grass (non-solid material? plants -> yes!)
+            new AxisAlignedBB(-3.5D, 65.5D, -4.5D, -2.5D, 66.5D, -3.5D), // negative coords stone
+            new AxisAlignedBB(15.2D, 64.5D, 15.2D, 16.8D, 65.8D, 16.8D), // across chunk border + torch
+            new AxisAlignedBB(1.5D, -3.0D, 1.5D, 2.5D, 0.5D, 2.5D),      // below y=0 into y=0 bedrock
+            new AxisAlignedBB(1.5D, 254.5D, 1.5D, 2.5D, 260.0D, 2.5D),   // above y=256 into y=255 stone
