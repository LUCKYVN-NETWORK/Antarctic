+    private static boolean vanillaWorldC(World world, AxisAlignedBB aabb) {
+        int i = MathHelper.floor(aabb.a);
+        int j = MathHelper.f(aabb.d);
+        int k = MathHelper.floor(aabb.b);
+        int l = MathHelper.f(aabb.e);
+        int i1 = MathHelper.floor(aabb.c);
+        int j1 = MathHelper.f(aabb.f);
+        BlockPosition.PooledBlockPosition pos = BlockPosition.PooledBlockPosition.s();
+        for (int k1 = i; k1 < j; ++k1) {
+            for (int l1 = k; l1 < l; ++l1) {
+                for (int i2 = i1; i2 < j1; ++i2) {
+                    if (world.getType(pos.f(k1, l1, i2)).getMaterial() != Material.AIR) {
+                        pos.t();
+                        return true;
+                    }
+                }
+            }
+        }
+        pos.t();
+        return false;
+    }
