From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nopjmp <kthompson@hey.com>
Date: Thu, 11 Feb 2021 01:02:59 -0600
Subject: [PATCH 049/154] Customizable Deflate Compression

- Backport Dionysus server/0026-Customizable-Deflate-Compression.patch
- Source: https://github.com/nopjmp/Dionysus at b5c71b62f6f1f555b22bd52f5751e33be4690b6e
- Add compression-level setting to AntarcticConfig (-1 default, 0-9 configurable)
- Apply compression level to NBT GZIPOutputStream and Netty PacketCompressor

diff --git a/main/java/com/destroystokyo/paper/AntarcticConfig.java b/main/java/com/destroystokyo/paper/AntarcticConfig.java
index cc8ce09..6891a80 100644
--- a/main/java/com/destroystokyo/paper/AntarcticConfig.java
+++ b/main/java/com/destroystokyo/paper/AntarcticConfig.java
@@ -165,4 +165,16 @@ public class AntarcticConfig {
         if (delay < 1) throw new IllegalArgumentException("pathfinder.goal-selection-delay must be positive");
         pathfinderGoalSelectionDelay = delay;
     }
+    public static int compressionLevel = -1;
+    private static void compressionLevel() {
+        setComment("compression-level",
+            "Deflate compression level used for packets and chunk/NBT saving.",
+            "Valid values: -1 (default), 0 (none), 1 (fastest) through 9 (maximum).");
+        compressionLevel = getInt("compression-level", -1);
+        if (compressionLevel < -1 || compressionLevel > 9) {
+            logError("Compression level is invalid resetting to default. Valid compression levels are -1 (Default), 0 (None), 1 (Fast) through 9 (Best)");
+            compressionLevel = -1;
+        }
+    }
+
 }
diff --git a/main/java/net/minecraft/server/NBTCompressedStreamTools.java b/main/java/net/minecraft/server/NBTCompressedStreamTools.java
index 8b5aeb1..1229e0a 100644
--- a/main/java/net/minecraft/server/NBTCompressedStreamTools.java
+++ b/main/java/net/minecraft/server/NBTCompressedStreamTools.java
@@ -1,5 +1,7 @@
 package net.minecraft.server;
 
+import com.destroystokyo.paper.AntarcticConfig;
+
 import java.io.BufferedInputStream;
 import java.io.BufferedOutputStream;
 import java.io.DataInput;
@@ -29,7 +31,7 @@ public class NBTCompressedStreamTools {
     }
 
     public static void a(NBTTagCompound nbttagcompound, OutputStream outputstream) throws IOException {
-        DataOutputStream dataoutputstream = new DataOutputStream(new BufferedOutputStream(new GZIPOutputStream(outputstream)));
+        DataOutputStream dataoutputstream = new DataOutputStream(new BufferedOutputStream(new GZIPOutputStream(outputstream) {{ def.setLevel(AntarcticConfig.compressionLevel);}})); // Antarctic - NBT Compression Level
 
         try {
             a(nbttagcompound, (DataOutput) dataoutputstream);
diff --git a/main/java/net/minecraft/server/PacketCompressor.java b/main/java/net/minecraft/server/PacketCompressor.java
new file mode 100644
index 0000000..cad960a
--- /dev/null
+++ b/main/java/net/minecraft/server/PacketCompressor.java
@@ -0,0 +1,56 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.AntarcticConfig;
+
+import io.netty.buffer.ByteBuf;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.handler.codec.MessageToByteEncoder;
+import java.util.zip.Deflater;
+
+public class PacketCompressor extends MessageToByteEncoder<ByteBuf> {
+
+    private final byte[] a = new byte[8192];
+    private final Deflater b;
+    private int c;
+
+    public PacketCompressor(int i) {
+        this.c = i;
+        this.b = new Deflater();
+        this.b.setLevel(AntarcticConfig.compressionLevel); // Antarctic - Packet Compression Level
+    }
+
+    protected void a(ChannelHandlerContext channelhandlercontext, ByteBuf bytebuf, ByteBuf bytebuf1) throws Exception {
+        int i = bytebuf.readableBytes();
+        PacketDataSerializer packetdataserializer = new PacketDataSerializer(bytebuf1);
+
+        if (i < this.c) {
+            packetdataserializer.d(0);
+            packetdataserializer.writeBytes(bytebuf);
+        } else {
+            byte[] abyte = new byte[i];
+
+            bytebuf.readBytes(abyte);
+            packetdataserializer.d(abyte.length);
+            this.b.setInput(abyte, 0, i);
+            this.b.finish();
+
+            while (!this.b.finished()) {
+                int j = this.b.deflate(this.a);
+
+                packetdataserializer.writeBytes(this.a, 0, j);
+            }
+
+            this.b.reset();
+        }
+
+    }
+
+    public void a(int i) {
+        this.c = i;
+    }
+
+    @Override
+    protected void encode(ChannelHandlerContext channelhandlercontext, ByteBuf object, ByteBuf bytebuf) throws Exception {
+        this.a(channelhandlercontext, object, bytebuf);
+    }
+}
