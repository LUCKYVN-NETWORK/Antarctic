diff --git a/test/java/net/minecraft/server/CreativeAndCloseWindowGuardTest.java b/test/java/net/minecraft/server/CreativeAndCloseWindowGuardTest.java
new file mode 100644
index 0000000..80056a1
--- /dev/null
+++ b/test/java/net/minecraft/server/CreativeAndCloseWindowGuardTest.java
@@ -0,0 +1,261 @@
+package net.minecraft.server;
+
+import org.bukkit.craftbukkit.entity.CraftEntity;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class CreativeAndCloseWindowGuardTest {
+
+    private static Unsafe UNSAFE;
+
+    @BeforeClass
+    public static void setupTest() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+    }
+
+    private static final class DummyNetworkManager extends NetworkManager {
+        DummyNetworkManager() {
+            super(EnumProtocolDirection.SERVERBOUND);
+        }
+
+        @Override
+        public boolean isConnected() {
+            return true;
+        }
+    }
+
+    private static final class RecordingPlayerConnection extends PlayerConnection {
+        final List<Packet<?>> sentPackets = new ArrayList<>();
+        boolean disconnected = false;
+
+        RecordingPlayerConnection() throws Exception {
+            super(null, null, null);
+        }
+
+        @Override
+        public void sendPacket(Packet<?> packet) {
+            this.sentPackets.add(packet);
+        }
+
+        @Override
+        public void disconnect(String s) {
+            this.disconnected = true;
+        }
+
+        @Override
+        public void disconnect(IChatBaseComponent ichatbasecomponent) {
+            this.disconnected = true;
+        }
+    }
+
+    private static final class TrackingWorld extends WorldServer {
+        boolean loaded = false;
+        int isLoadedCalls = 0;
+        int getTileEntityCalls = 0;
+        TileEntity tileToReturn = null;
+
+        TrackingWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public boolean isMainThread() {
+            return true;
+        }
+
+        @Override
+        public boolean isLoaded(BlockPosition blockposition) {
+            isLoadedCalls++;
+            return loaded;
+        }
+
+        @Override
+        public TileEntity getTileEntity(BlockPosition blockposition) {
+            getTileEntityCalls++;
+            return tileToReturn;
+        }
+    }
+
+    private static RecordingPlayerConnection createConnection(TrackingWorld world) throws Exception {
+        Field csField = World.class.getDeclaredField("isClientSide");
+        csField.setAccessible(true);
+        csField.setBoolean(world, true);
+        world.worldData = new WorldData();
+        world.worldProvider = new WorldProviderNormal();
+        Field uField = World.class.getDeclaredField("u");
+        uField.setAccessible(true);
+        uField.set(world, Collections.emptyList());
+
+        RecordingPlayerConnection conn = (RecordingPlayerConnection) UNSAFE.allocateInstance(RecordingPlayerConnection.class);
+        Field spField = RecordingPlayerConnection.class.getDeclaredField("sentPackets");
+        spField.setAccessible(true);
+        spField.set(conn, new ArrayList<>());
+        Field nmField = PlayerConnection.class.getDeclaredField("networkManager");
+        nmField.setAccessible(true);
+        nmField.set(conn, UNSAFE.allocateInstance(DummyNetworkManager.class));
+
+        EntityPlayer player = (EntityPlayer) UNSAFE.allocateInstance(EntityPlayer.class);
+        player.world = world;
+        player.playerConnection = conn;
+        player.locX = 0.0D;
+        player.locY = 64.0D;
+        player.locZ = 0.0D;
+        CraftPlayer craftPlayer = (CraftPlayer) UNSAFE.allocateInstance(CraftPlayer.class);
+        Field entityField = CraftEntity.class.getDeclaredField("entity");
+        entityField.setAccessible(true);
+        entityField.set(craftPlayer, player);
+        Field cpHealth = CraftPlayer.class.getDeclaredField("health");
+        cpHealth.setAccessible(true);
+        cpHealth.setDouble(craftPlayer, 20.0D);
+        Field beField = Entity.class.getDeclaredField("bukkitEntity");
+        beField.setAccessible(true);
+        beField.set(player, craftPlayer);
+        DataWatcher dw = new DataWatcher(player);
+        dw.register(EntityLiving.HEALTH, 20.0F);
+        Field dwField = Entity.class.getDeclaredField("datawatcher");
+        dwField.setAccessible(true);
+        dwField.set(player, dw);
+        PlayerInteractManager pim = (PlayerInteractManager) UNSAFE.allocateInstance(PlayerInteractManager.class);
+        Field gmField = PlayerInteractManager.class.getDeclaredField("gamemode");
+        gmField.setAccessible(true);
+        gmField.set(pim, EnumGamemode.CREATIVE);
+        Field pimField = EntityPlayer.class.getDeclaredField("playerInteractManager");
+        pimField.setAccessible(true);
+        pimField.set(player, pim);
+        player.inventory = new PlayerInventory(player);
+        ContainerPlayer container = new ContainerPlayer(player.inventory, true, player);
+        container.windowId = 0;
+        player.defaultContainer = container;
+        player.activeContainer = container;
+        conn.player = player;
+        return conn;
+    }
+
+    private static PacketPlayInSetCreativeSlot creativeSlotPacket(int slot, ItemStack stack) throws Exception {
+        PacketPlayInSetCreativeSlot pkt = new PacketPlayInSetCreativeSlot();
+        Field slotField = PacketPlayInSetCreativeSlot.class.getDeclaredField("slot");
+        Field itemField = PacketPlayInSetCreativeSlot.class.getDeclaredField("b");
+        slotField.setAccessible(true);
+        itemField.setAccessible(true);
+        slotField.setInt(pkt, slot);
+        itemField.set(pkt, stack);
+        return pkt;
+    }
+
+    private static ItemStack chestWithBlockEntityCoords(int x, int y, int z) {
+        ItemStack stack = new ItemStack(Item.getItemOf(Blocks.CHEST), 1);
+        NBTTagCompound root = new NBTTagCompound();
+        NBTTagCompound be = new NBTTagCompound();
+        be.setInt("x", x);
+        be.setInt("y", y);
+        be.setInt("z", z);
+        root.set("BlockEntityTag", be);
+        stack.setTag(root);
+        return stack;
+    }
+
+    @Test
+    public void testSetCreativeSlotGuardsRemoteAndUnloadedBlockEntityTagAndDeadPlayer() throws Exception {
+        TrackingWorld world = (TrackingWorld) UNSAFE.allocateInstance(TrackingWorld.class);
+        RecordingPlayerConnection conn = createConnection(world);
+
+        // 1. Out-of-range BlockEntityTag -> 0 getTileEntity calls, x/y/z stripped
+        world.loaded = true;
+        ItemStack farStack = chestWithBlockEntityCoords(50000, 64, 50000);
+        conn.a(creativeSlotPacket(0, farStack));
+        assertEquals("Out-of-range BlockEntityTag must not call getTileEntity", 0, world.getTileEntityCalls);
+        NBTTagCompound strippedFar = farStack.getTag().getCompound("BlockEntityTag");
+        assertFalse(strippedFar.hasKey("x"));
+        assertFalse(strippedFar.hasKey("y"));
+        assertFalse(strippedFar.hasKey("z"));
+
+        // 2. In-range but unloaded -> 0 getTileEntity calls, x/y/z stripped
+        world.loaded = false;
+        ItemStack unloadedStack = chestWithBlockEntityCoords(2, 64, 2);
+        conn.a(creativeSlotPacket(0, unloadedStack));
+        assertEquals(0, world.getTileEntityCalls);
+        NBTTagCompound strippedUnloaded = unloadedStack.getTag().getCompound("BlockEntityTag");
+        assertFalse(strippedUnloaded.hasKey("x"));
+        assertFalse(strippedUnloaded.hasKey("y"));
+        assertFalse(strippedUnloaded.hasKey("z"));
+
+        // 3. In-range and loaded -> copies TileEntity NBT without x/y/z
+        world.loaded = true;
+        TileEntityChest chest = new TileEntityChest();
+        chest.setCustomName("SecretChest");
+        world.tileToReturn = chest;
+        ItemStack loadedStack = chestWithBlockEntityCoords(2, 64, 2);
+        conn.a(creativeSlotPacket(0, loadedStack));
+        assertEquals(1, world.getTileEntityCalls);
+        NBTTagCompound copied = loadedStack.getTag().getCompound("BlockEntityTag");
+        assertEquals("SecretChest", copied.getString("CustomName"));
+        assertFalse(copied.hasKey("x"));
+
+        // 4. Dead player -> returns immediately without probing world
+        world.isLoadedCalls = 0;
+        world.getTileEntityCalls = 0;
+        conn.player.dead = true;
+        conn.a(creativeSlotPacket(0, chestWithBlockEntityCoords(2, 64, 2)));
+        assertEquals(0, world.isLoadedCalls);
+        assertEquals(0, world.getTileEntityCalls);
+    }
+
+    @Test
+    public void testCloseWindowIgnoresStaleWindowId() throws Exception {
+        TrackingWorld world = (TrackingWorld) UNSAFE.allocateInstance(TrackingWorld.class);
+        RecordingPlayerConnection conn = createConnection(world);
+
+        assertEquals(0, new PacketPlayInCloseWindow(0).getWindowId());
+        assertEquals(2, new PacketPlayInCloseWindow(2).getWindowId());
+
+        ContainerChest chest = new ContainerChest(conn.player.inventory, new InventorySubcontainer("Chest", false, 27), conn.player);
+        chest.windowId = 2;
+        conn.player.activeContainer = chest;
+
+        // Stale close packet for previous windowId=1 must be ignored cleanly
+        conn.a(new PacketPlayInCloseWindow(1));
+        assertSame("Stale CloseWindow must not close active container", chest, conn.player.activeContainer);
+        assertFalse(conn.disconnected);
+    }
+
+    @Test
+    public void testCreativeAndCloseWindowGuardEfficiency() throws Exception {
+        TrackingWorld world = (TrackingWorld) UNSAFE.allocateInstance(TrackingWorld.class);
+        world.loaded = true;
+        RecordingPlayerConnection conn = createConnection(world);
+
+        ContainerChest chest = new ContainerChest(conn.player.inventory, new InventorySubcontainer("Chest", false, 27), conn.player);
+        chest.windowId = 2;
+        conn.player.activeContainer = chest;
+
+        PacketPlayInCloseWindow staleClose = new PacketPlayInCloseWindow(1);
+        ItemStack farStack = chestWithBlockEntityCoords(50000, 64, 50000);
+        PacketPlayInSetCreativeSlot farCreative = creativeSlotPacket(0, farStack);
+
+        for (int i = 0; i < 5_000; i++) {
+            conn.a(staleClose);
+            conn.a(farCreative);
+        }
+
+        long start = System.nanoTime();
+        for (int i = 0; i < 50_000; i++) {
+            conn.a(staleClose);
+            conn.a(farCreative);
+        }
+        long elapsedMs = (System.nanoTime() - start) / 1_000_000L;
+        assertEquals(0, world.getTileEntityCalls);
+        assertTrue("50k C3 guard checks took too long: " + elapsedMs + " ms", elapsedMs < 150L);
+    }
+}
