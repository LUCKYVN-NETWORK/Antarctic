+    @Test
+    public void testTripwireDupePreventionReChecksHookBlock() throws Exception {
+        MockWorld world = newMockWorld();
+        BlockPosition hook1 = new BlockPosition(0, 64, 0);
+        BlockPosition wire1 = new BlockPosition(1, 64, 0);
+        BlockPosition hook2 = new BlockPosition(2, 64, 0);
+
+        IBlockData attachedWire = Blocks.TRIPWIRE.getBlockData()
+                .set(BlockTripwire.DISARMED, Boolean.FALSE)
+                .set(BlockTripwire.POWERED, Boolean.FALSE);
+        IBlockData hook2State = Blocks.TRIPWIRE_HOOK.getBlockData()
+                .set(BlockTripwireHook.FACING, EnumDirection.WEST)
+                .set(BlockTripwireHook.ATTACHED, Boolean.TRUE);
+        world.blocks.put(wire1, attachedWire);
+        world.blocks.put(hook2, hook2State);
+
+        // Simulate hook1 already broken (now AIR) during update
+        world.blocks.put(hook1, Blocks.AIR.getBlockData());
+
+        Tripwire.allowTripwireDupe = false;
+        ((BlockTripwireHook) Blocks.TRIPWIRE_HOOK).a(world, hook1, hook2State.set(BlockTripwireHook.FACING, EnumDirection.EAST), false, true, -1, null);
+
+        // hook1 MUST remain AIR (not recreated into a duped tripwire hook!), while hook2 (still TRIPWIRE_HOOK) updated
+        assertEquals(Blocks.AIR, world.blocks.get(hook1).getBlock());
+        assertEquals(Blocks.TRIPWIRE_HOOK, world.blocks.get(hook2).getBlock());
+    }
