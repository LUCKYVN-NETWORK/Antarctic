+        DeathItemDropKnockback.horizontalForce = prevHoriz;
+        DeathItemDropKnockback.verticalForce = prevVert;
+        com.destroystokyo.paper.config.toml.modules.gameplay.World.iceAndSnowChance = prevIceSnow;
+        Tripwire.allowTripwireDupe = prevTripwire;
+    }
+
