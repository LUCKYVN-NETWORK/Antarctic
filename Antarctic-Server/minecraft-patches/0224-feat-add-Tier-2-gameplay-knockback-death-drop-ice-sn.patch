+    @Test
+    public void testVanilla1122Defaults() {
+        assertEquals(16, com.destroystokyo.paper.config.toml.modules.gameplay.World.iceAndSnowChance);
+        assertEquals(0.5D, DeathItemDropKnockback.horizontalForce, 1e-9);
+        assertEquals(0.2D, DeathItemDropKnockback.verticalForce, 1e-9);
+        assertTrue(DeathItemDropKnockback.dropAround);
+        assertFalse(Knockback.snowballKnockbackPlayers);
+        assertFalse(Knockback.eggKnockbackPlayers);
