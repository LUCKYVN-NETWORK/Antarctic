+            }
+            rotateHandle.invokeExact(checker, 3, 4);
+            fallHandle.invokeExact((BlockFalling) Blocks.SAND, (World) world, sandPos);
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        bean.getThreadAllocatedBytes(tid);
+
+        long vanBytes0 = bean.getThreadAllocatedBytes(tid);
