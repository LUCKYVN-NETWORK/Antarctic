+    private static boolean vanillaPistonPowerCheck(World world, BlockPosition pos, EnumDirection facing) {
+        for (EnumDirection dir : EnumDirection.values()) {
+            if (dir != facing && world.isBlockFacePowered(pos.shift(dir), dir)) {
+                return true;
+            }
+        }
+        if (world.isBlockFacePowered(pos, EnumDirection.DOWN)) {
+            return true;
+        }
+        BlockPosition up = pos.up();
+        for (EnumDirection dir : EnumDirection.values()) {
+            if (dir != EnumDirection.DOWN && world.isBlockFacePowered(up.shift(dir), dir)) {
+                return true;
+            }
+        }
+        return false;
+    }
