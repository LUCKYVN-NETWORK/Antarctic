+    @Test
+    public void testPersistenceTransitionsEliminateGhostMobSwitchAndNegativeDrift() throws Exception {
+        WorldServer world = newStubWorld();
+        Chunk chunk = newStubChunk(world, 0, 0);
+        chunk.addEntities();
+
+        List<EntityZombie> zombies = new ArrayList<EntityZombie>();
+        for (int i = 0; i < 70; ++i) {
+            EntityZombie z = newStubEntity(EntityZombie.class, world, 8.0, 64.0, 8.0, false);
+            chunk.a(z);
+            zombies.add(z);
+        }
+        assertEquals(70, chunk.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(70, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(70, chunk.entityCount.get(IMonster.class));
+
+        // Transition all 70 natural zombies to persistent (simulating item pickup / nametag / setRemoveWhenFarAway(false))
+        for (int i = 0; i < 70; ++i) {
+            if ((i & 1) == 0) {
+                zombies.get(i).cW();
+            } else {
+                zombies.get(i).setPersistent(true);
+            }
+        }
+        assertEquals(0, chunk.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, chunk.entityCount.get(IMonster.class));
+
+        // Remove all 70 zombies - must stay exactly 0 (no ghost 70, no negative drift)
+        for (EntityZombie z : zombies) {
+            chunk.removeEntity(z);
+        }
+        assertEquals(0, chunk.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, chunk.entityCount.get(IMonster.class));
+
+        // Reverse transition: spawn persistent -> unpersist -> remove (must not go negative)
+        EntityZombie pz = newStubEntity(EntityZombie.class, world, 8.0, 64.0, 8.0, true);
+        chunk.a(pz);
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.MONSTER));
+        pz.setPersistent(false);
+        assertEquals(1, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(1, chunk.entityCount.get(IMonster.class));
+        chunk.removeEntity(pz);
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, chunk.entityCount.get(IMonster.class));
+    }
