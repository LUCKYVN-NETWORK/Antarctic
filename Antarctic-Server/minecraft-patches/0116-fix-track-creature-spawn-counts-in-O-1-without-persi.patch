+        setField(Chunk.class, chunk, "itemCounts", new int[16]);
+        setField(Chunk.class, chunk, "inventoryEntityCounts", new int[16]);
+        setField(Chunk.class, chunk, "entityCount", new gnu.trove.map.hash.TObjectIntHashMap<Class>());
+        setField(Chunk.class, chunk, "antarcticCreatureCounts", new int[EnumCreatureType.values().length]);
+        setField(Chunk.class, chunk, "antarcticCountsInWorld", false);
+        world.getChunkProviderServer().chunks.put(key, chunk);
+        return chunk;
+    }
+
+    private static <T extends Entity> T newStubEntity(Class<T> cls, World world, double x, double y, double z, boolean persistent) throws Exception {
+        T entity = cls.cast(unsafe.allocateInstance(cls));
+        setField(Entity.class, entity, "id", nextEntityId++);
+        entity.world = world;
+        entity.locX = x;
+        entity.locY = y;
+        entity.locZ = z;
+        entity.uniqueID = UUID.randomUUID();
+        entity.random = new Random(1L);
+        if (entity instanceof EntityInsentient) {
+            ((EntityInsentient) entity).persistent = persistent;
+        }
+        return entity;
+    }
