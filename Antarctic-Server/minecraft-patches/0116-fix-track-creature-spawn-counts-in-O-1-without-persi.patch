+    @Test
+    public void testRandomizedLifecycleZeroDrift() throws Exception {
+        WorldServer world = newStubWorld();
+        Chunk[] chunks = new Chunk[8];
+        for (int i = 0; i < chunks.length; ++i) {
+            chunks[i] = newStubChunk(world, i, 0);
+            chunks[i].addEntities();
+        }
+
+        Random rng = new Random(20261123L);
+        List<Entity> live = new ArrayList<Entity>();
+        for (int op = 0; op < 10_000; ++op) {
+            int action = rng.nextInt(100);
+            if (action < 40 || live.isEmpty()) {
+                int ci = rng.nextInt(chunks.length);
+                int kind = rng.nextInt(5);
+                boolean pers = rng.nextBoolean();
+                Entity e;
+                double x = ci * 16.0 + 8.0;
+                if (kind == 0) e = newStubEntity(EntityZombie.class, world, x, 64.0, 8.0, pers);
+                else if (kind == 1) e = newStubEntity(EntityCow.class, world, x, 64.0, 8.0, pers);
+                else if (kind == 2) e = newStubEntity(EntityBat.class, world, x, 64.0, 8.0, pers);
+                else if (kind == 3) e = newStubEntity(EntitySquid.class, world, x, 48.0, 8.0, pers);
+                else e = newStubEntity(EntityItem.class, world, x, 64.0, 8.0, false);
+                chunks[ci].a(e);
+                live.add(e);
+            } else if (action < 65) {
+                Entity e = live.get(rng.nextInt(live.size()));
+                if (e instanceof EntityInsentient) {
+                    EntityInsentient ins = (EntityInsentient) e;
+                    if (rng.nextBoolean()) {
+                        ins.setPersistent(!ins.persistent);
+                    } else {
+                        ins.persistent = !ins.persistent;
+                        ins.L();
+                    }
+                }
+            } else if (action < 85) {
+                int idx = rng.nextInt(live.size());
+                Entity e = live.remove(idx);
+                Chunk c = e.getCurrentChunk();
+                if (c != null) {
+                    c.removeEntity(e);
+                }
+            } else if (action < 95) {
+                Entity e = live.get(rng.nextInt(live.size()));
+                int target = rng.nextInt(chunks.length);
+                e.locX = target * 16.0 + 8.0;
+                chunks[target].a(e);
+            } else {
+                int ci = rng.nextInt(chunks.length);
+                Chunk old = chunks[ci];
+                old.removeEntities();
+                world.getChunkProviderServer().chunks.remove(old.chunkKey);
+                live.removeIf(ent -> ent.entitySlice == null);
+                chunks[ci] = newStubChunk(world, ci, 0);
+                chunks[ci].addEntities();
+            }
+        }
+
+        // Verify exact parity against ground truth across all 4 categories and legacy Trove maps
+        int[] expectedWorld = new int[EnumCreatureType.values().length];
+        for (Entity e : live) {
+            byte mask = Chunk.computeSpawnCountMask(e);
+            for (int ord = 0; ord < expectedWorld.length; ++ord) {
+                if ((mask & (1 << ord)) != 0) {
+                    expectedWorld[ord]++;
+                }
+            }
+        }
+        for (EnumCreatureType type : EnumCreatureType.values()) {
+            int ord = type.ordinal();
+            assertEquals("World count mismatch for " + type, expectedWorld[ord], world.getCreatureCount(type));
+            int sumChunk = 0;
+            int sumTrove = 0;
+            for (Chunk c : chunks) {
+                sumChunk += c.getCreatureCount(type);
+                sumTrove += c.entityCount.get(type.a());
+            }
+            assertEquals("Chunk array sum mismatch for " + type, expectedWorld[ord], sumChunk);
+            assertEquals("Legacy Trove sum mismatch for " + type, expectedWorld[ord], sumTrove);
+        }
+    }
