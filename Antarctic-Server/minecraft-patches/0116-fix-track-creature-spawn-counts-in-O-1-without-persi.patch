+    @Test
+    public void testChunkLoadDuplicateUuidUnloadAndCrossChunkMove() throws Exception {
+        WorldServer world = newStubWorld();
+        Chunk chunkA = newStubChunk(world, 0, 0);
+        Chunk chunkB = newStubChunk(world, 1, 0);
+        chunkB.addEntities();
+
+        // Simulate ChunkRegionLoader adding entities BEFORE chunkA.addEntities()
+        UUID dupUuid = UUID.randomUUID();
+        EntityZombie existing = newStubEntity(EntityZombie.class, world, 24.0, 64.0, 8.0, false);
+        existing.uniqueID = dupUuid;
+        chunkB.a(existing);
+        world.entitiesByUUID.put(dupUuid, existing);
+        assertEquals(1, world.getCreatureCount(EnumCreatureType.MONSTER));
+
+        EntityZombie dupe = newStubEntity(EntityZombie.class, world, 8.0, 64.0, 8.0, false);
+        dupe.uniqueID = dupUuid;
+        EntityZombie normal = newStubEntity(EntityZombie.class, world, 8.0, 64.0, 8.0, false);
+        EntityCow cow = newStubEntity(EntityCow.class, world, 8.0, 64.0, 8.0, true); // EntityAnimal: isTypeNotPersistent() == false, still counted!
+        EntityBat bat = newStubEntity(EntityBat.class, world, 8.0, 64.0, 8.0, false);
+        EntitySquid squid = newStubEntity(EntitySquid.class, world, 8.0, 48.0, 8.0, false);
+        EntityItem item = newStubEntity(EntityItem.class, world, 8.0, 64.0, 8.0, false);
+
+        chunkA.a(dupe);
+        chunkA.a(normal);
+        chunkA.a(cow);
+        chunkA.a(bat);
+        chunkA.a(squid);
+        chunkA.a(item);
+
+        // Before addEntities, world count must not include chunkA yet
+        assertEquals(1, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.CREATURE));
+        assertEquals(2, chunkA.getCreatureCount(EnumCreatureType.MONSTER));
+
+        // addEntities deletes dupe and publishes remaining chunkA counts to world
+        chunkA.addEntities();
+        assertTrue(dupe.dead);
+        assertEquals(0, dupe.antarcticSpawnCountMask);
+        assertEquals(1, chunkA.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(2, world.getCreatureCount(EnumCreatureType.MONSTER)); // existing in B + normal in A
+        assertEquals(1, world.getCreatureCount(EnumCreatureType.CREATURE));
+        assertEquals(1, world.getCreatureCount(EnumCreatureType.AMBIENT));
+        assertEquals(1, world.getCreatureCount(EnumCreatureType.WATER_CREATURE));
+
+        // Move normal zombie from chunkA to chunkB AND across a vertical Y-slice boundary (y=64 slice 4 -> y=12 slice 0)
+        normal.locX = 24.0;
+        normal.locY = 12.0;
+        chunkB.a(normal);
+        assertEquals(0, chunkA.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(2, chunkB.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(2, world.getCreatureCount(EnumCreatureType.MONSTER));
+
+        // Vertical-only slice move within the same chunkB (y=12 slice 0 -> y=96 slice 6) directly via chunkB.a(normal)
+        normal.locY = 96.0;
+        chunkB.a(normal);
+        assertEquals(2, chunkB.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(2, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(2, chunkB.entityCount.get(IMonster.class));
+
+        // Unload chunkA - world counts drop by chunkA's cow/bat/squid, idempotent on second call
+        chunkA.removeEntities();
+        assertEquals(0, chunkA.getCreatureCount(EnumCreatureType.CREATURE));
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.CREATURE));
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.AMBIENT));
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.WATER_CREATURE));
+        assertEquals(2, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, cow.antarcticSpawnCountMask);
+
+        chunkA.removeEntities();
+        world.getChunkProviderServer().chunks.remove(chunkA.chunkKey);
+        assertEquals(2, world.getCreatureCount(EnumCreatureType.MONSTER));
+
+        // Reload a new chunk at the same (0, 0) and mutate stale unloaded entity's persistence:
+        // must NOT corrupt the newly loaded chunk's or world's creature counts!
+        Chunk reloadedA = newStubChunk(world, 0, 0);
+        reloadedA.addEntities();
+        bat.setPersistent(true);
+        bat.setPersistent(false);
+        assertEquals(0, reloadedA.getCreatureCount(EnumCreatureType.AMBIENT));
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.AMBIENT));
+    }
