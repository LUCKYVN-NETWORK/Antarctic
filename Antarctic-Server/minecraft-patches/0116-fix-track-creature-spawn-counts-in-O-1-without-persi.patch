+    @Test
+    public void testO1CountPerformanceVsTroveChunkScan() throws Exception {
+        WorldServer world = newStubWorld();
+        int numChunks = 8_000;
+        List<Chunk> chunks = new ArrayList<Chunk>(numChunks);
+        for (int i = 0; i < numChunks; ++i) {
+            Chunk c = newStubChunk(world, i & 127, i >> 7);
+            c.addEntities();
+            if ((i & 7) == 0) {
+                EntityZombie z = newStubEntity(EntityZombie.class, world, (i & 127) * 16.0 + 8.0, 64.0, (i >> 7) * 16.0 + 8.0, false);
+                c.a(z);
+            }
+            chunks.add(c);
+        }
+
+        int expected = world.getCreatureCount(EnumCreatureType.MONSTER);
+        assertEquals(1_000, expected);
+
+        // Warmup
+        long sink = 0;
+        for (int i = 0; i < 100; ++i) {
+            int sum = 0;
+            for (int j = 0; j < numChunks; ++j) {
+                sum += chunks.get(j).entityCount.get(IMonster.class);
+            }
+            sink += sum;
+            sink += world.getCreatureCount(EnumCreatureType.MONSTER);
+        }
+
+        int iters = 500;
+        long t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            int sum = 0;
+            for (int j = 0; j < numChunks; ++j) {
+                sum += chunks.get(j).entityCount.get(IMonster.class);
+            }
+            sink += sum;
+        }
+        long oldNs = System.nanoTime() - t0;
+
+        long t1 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            sink += world.getCreatureCount(EnumCreatureType.MONSTER);
+        }
+        long newNs = System.nanoTime() - t1;
+
+        assertTrue("Unexpected sink: " + sink, sink > 0);
+        double speedup = (double) oldNs / Math.max(1L, newNs);
+        System.out.printf("MobSpawnCountAccountingTest (8k chunks x %d): old=%.2fms new=%.4fms speedup=%.1fx%n",
+                iters, oldNs / 1e6, newNs / 1e6, speedup);
+        assertTrue("Expected >= 50x speedup over Trove scan, got " + speedup + "x", speedup >= 50.0);
+    }
