+    @Test
+    public void testDirectPersistentFieldWriteSelfHealsInDespawnTick() throws Exception {
+        WorldServer world = newStubWorld();
+        Chunk chunk = newStubChunk(world, 0, 0);
+        chunk.addEntities();
+
+        EntityZombie z = newStubEntity(EntityZombie.class, world, 8.0, 64.0, 8.0, false);
+        chunk.a(z);
+        assertEquals(1, world.getCreatureCount(EnumCreatureType.MONSTER));
+
+        // Direct NMS field write bypassing setPersistent()
+        z.persistent = true;
+        z.L();
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, chunk.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(0, chunk.entityCount.get(IMonster.class));
+
+        // Direct NMS field write back to false
+        z.persistent = false;
+        z.L();
+        assertEquals(1, world.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(1, chunk.getCreatureCount(EnumCreatureType.MONSTER));
+        assertEquals(1, chunk.entityCount.get(IMonster.class));
+
+        chunk.removeEntity(z);
+        assertEquals(0, world.getCreatureCount(EnumCreatureType.MONSTER));
+    }
