diff --git a/test/java/net/minecraft/server/BlockMinecartDetectorOnPlaceTest.java b/test/java/net/minecraft/server/BlockMinecartDetectorOnPlaceTest.java
new file mode 100644
index 0000000..d3c8e7c
--- /dev/null
+++ b/test/java/net/minecraft/server/BlockMinecartDetectorOnPlaceTest.java
@@ -0,0 +1,82 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import java.util.Collections;
+import java.util.List;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class BlockMinecartDetectorOnPlaceTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    private static final class RecordingWorld extends World {
+        IBlockData currentState;
+        int setTypeCalls;
+        int getEntitiesCalls;
+
+        RecordingWorld() {
+            super(null, null, null, null, false, null, null);
+        }
+
+        @Override
+        protected IChunkProvider n() {
+            return null;
+        }
+
+        @Override
+        protected boolean isChunkLoaded(int i, int j, boolean flag) {
+            return true;
+        }
+
+        @Override
+        public IBlockData getType(BlockPosition pos) {
+            return currentState;
+        }
+
+        @Override
+        public boolean setTypeAndData(BlockPosition pos, IBlockData state, int flags) {
+            setTypeCalls++;
+            currentState = state;
+            return true;
+        }
+
+        @Override
+        public <T extends Entity> List<T> a(Class<? extends T> oclass, AxisAlignedBB axisalignedbb) {
+            getEntitiesCalls++;
+            return Collections.emptyList();
+        }
+
+        @Override
+        public void updateAdjacentComparators(BlockPosition pos, Block block) {
+        }
+    }
+
+    @Test
+    public void testOnPlaceReReadsStateAndSkipsIfBlockChangedToAir() throws Exception {
+        RecordingWorld world = (RecordingWorld) unsafe.allocateInstance(RecordingWorld.class);
+        // Simulate super.onPlace() having broken/replaced the detector rail with AIR before e() runs
+        Field clientSide = World.class.getDeclaredField("isClientSide");
+        clientSide.setAccessible(true);
+        clientSide.setBoolean(world, true); // skip super.onPlace track connection while testing re-read
+        world.currentState = Blocks.AIR.getBlockData();
+
+        BlockMinecartDetector detector = (BlockMinecartDetector) Blocks.DETECTOR_RAIL;
+        IBlockData staleDetectorState = detector.getBlockData();
+
+        detector.onPlace(world, new BlockPosition(0, 64, 0), staleDetectorState);
+
+        Assert.assertEquals("Must abort e() when world.getType(pos) is no longer detector rail", 0, world.getEntitiesCalls);
+        Assert.assertEquals("Must not overwrite AIR with stale detector rail state", 0, world.setTypeCalls);
+    }
+}
