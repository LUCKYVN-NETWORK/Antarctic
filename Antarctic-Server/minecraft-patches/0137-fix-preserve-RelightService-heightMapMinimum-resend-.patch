diff --git a/test/java/net/minecraft/server/RelightServiceLifecycleTest.java b/test/java/net/minecraft/server/RelightServiceLifecycleTest.java
new file mode 100644
index 0000000..60c63bd
--- /dev/null
+++ b/test/java/net/minecraft/server/RelightServiceLifecycleTest.java
@@ -0,0 +1,77 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import java.util.concurrent.CompletableFuture;
+import me.stella.antarctic.collection.PendingLightRegistry;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import org.spigotmc.AsyncCatcher;
+import sun.misc.Unsafe;
+
+public class RelightServiceLifecycleTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    @Test
+    public void testShutdownCancelsPendingFuturesAndUnloadClearsTracking() throws Exception {
+        boolean prevAsync = AsyncCatcher.enabled;
+        AsyncCatcher.enabled = false;
+        try {
+            WorldServer world = (WorldServer) unsafe.allocateInstance(WorldServer.class);
+            ChunkProviderServer cps = (ChunkProviderServer) unsafe.allocateInstance(ChunkProviderServer.class);
+            cps.chunks = new it.unimi.dsi.fastutil.longs.Long2ObjectOpenHashMap<>();
+            Field cpField = World.class.getDeclaredField("chunkProvider");
+            cpField.setAccessible(true);
+            cpField.set(world, cps);
+
+            RelightService service = new RelightService(world);
+            long chunkKey = ChunkCoordIntPair.a(3, -4);
+            CompletableFuture<Integer> future = service.submit(new long[] { chunkKey });
+            Assert.assertFalse("Submitted future must be pending before tick/shutdown", future.isDone());
+
+            // Shutting down must cancel outstanding futures rather than stranding callers forever
+            service.shutdown();
+            Assert.assertTrue("shutdown() must complete/cancel pending futures", future.isDone());
+            Assert.assertTrue("shutdown() must cancel incomplete futures", future.isCancelled());
+        } finally {
+            AsyncCatcher.enabled = prevAsync;
+        }
+    }
+
+    @Test
+    public void testCaptureLightPendingSeesWorldPendingLightRegistry() throws Exception {
+        WorldServer world = (WorldServer) unsafe.allocateInstance(WorldServer.class);
+        PendingLightRegistry registry = new PendingLightRegistry(1024);
+        Field plField = World.class.getDeclaredField("pendingLight");
+        plField.setAccessible(true);
+        plField.set(world, registry);
+
+        Chunk chunk = (Chunk) unsafe.allocateInstance(Chunk.class);
+        Field keyField = Chunk.class.getDeclaredField("chunkKey");
+        keyField.setAccessible(true);
+        long key = ChunkCoordIntPair.a(5, 7);
+        keyField.setLong(chunk, key);
+        chunk.antarcticLightPending = false;
+
+        Assert.assertFalse(ChunkRegionLoader.captureLightPending(world, chunk));
+        registry.add(key, 123);
+        Assert.assertTrue("captureLightPending must detect queued entries in world.pendingLight",
+                ChunkRegionLoader.captureLightPending(world, chunk));
+    }
+
+    @Test
+    public void testChunkSetHeightMapMinimumUpdatesFieldV() throws Exception {
+        Chunk chunk = (Chunk) unsafe.allocateInstance(Chunk.class);
+        chunk.setHeightMapMinimum(42);
+        Assert.assertEquals(42, chunk.w());
+    }
+}
