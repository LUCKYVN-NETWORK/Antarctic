Subject: [PATCH 198/203] perf: track section observer counts to skip interior
 observer scans


diff --git a/main/java/net/minecraft/server/Chunk.java b/main/java/net/minecraft/server/Chunk.java
index 1cd81ad..461a199 100644
--- a/main/java/net/minecraft/server/Chunk.java
+++ b/main/java/net/minecraft/server/Chunk.java
@@ -623,6 +623,26 @@ public class Chunk {
         return getBlockData(i, j, k);
     }
 
+    // Antarctic start - O(1) section observer presence check for World.c interior skip
+    public boolean hasObserversNearY(int y) {
+        int minSec = (y - 1) >> 4;
+        if (minSec < 0) {
+            minSec = 0;
+        }
+        int maxSec = (y + 1) >> 4;
+        if (maxSec >= this.sections.length) {
+            maxSec = this.sections.length - 1;
+        }
+        for (int s = minSec; s <= maxSec; ++s) {
+            ChunkSection sec = this.sections[s];
+            if (sec != Chunk.a && sec.hasObservers()) {
+                return true;
+            }
+        }
+        return false;
+    }
+    // Antarctic end
+
     public IBlockData unused(final int i, final int j, final int k) {
     // Paper end
         if (this.world.N() == WorldType.DEBUG_ALL_BLOCK_STATES) {
