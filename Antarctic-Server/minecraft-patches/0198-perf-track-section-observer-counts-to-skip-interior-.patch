diff --git a/main/java/net/minecraft/server/World.java b/main/java/net/minecraft/server/World.java
index feca496..d547e47 100644
--- a/main/java/net/minecraft/server/World.java
+++ b/main/java/net/minecraft/server/World.java
@@ -896,6 +896,11 @@ public abstract class World implements IBlockAccess {
         int x = blockposition.getX();
         int y = blockposition.getY();
         int z = blockposition.getZ();
+        int lx = x & 15;
+        int lz = z & 15;
+        if (chunk != null && !this.captureTreeGeneration && lx > 0 && lx < 15 && lz > 0 && lz < 15 && !chunk.hasObserversNearY(y)) {
+            return;
+        }
         this.notifyObserver(chunk, x - 1, y, z, block, blockposition);
         this.notifyObserver(chunk, x + 1, y, z, block, blockposition);
         this.notifyObserver(chunk, x, y - 1, z, block, blockposition);
