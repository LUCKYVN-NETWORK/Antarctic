+    @Test
+    public void testZeroDeltaSkipsGetCubesButPreservesVanillaMoveSemantics() throws Exception {
+        StubWorld world = newStubWorld();
+        StubEntity entity = newStubEntity(world);
+
+        // Pre-seed stale state that vanilla move(0, 0, 0) must still process/reset
+        entity.onGround = true;
+        entity.positionChanged = true;
+        entity.B = true;
+        entity.C = true;
+        entity.E = true; // in cobweb
+        entity.motX = 0.5D;
+        entity.motY = -0.2D;
+        entity.motZ = 0.3D;
+        world.flammable = true;
+
+        // First stationary tick
+        entity.move(EnumMoveType.SELF, 0.0D, 0.0D, 0.0D);
+        // Second consecutive stationary tick (previously completely skipped by 0083)
+        entity.move(EnumMoveType.SELF, 0.0D, 0.0D, 0.0D);
+
+        Assert.assertEquals("Zero-delta move must skip unused World.getCubes", 0, world.getCubesCalls);
+        Assert.assertEquals("Stationary entity must still check fire/lava contact each tick", 2, world.flammableCheckCalls);
+        Assert.assertEquals("Stationary entity in fire/lava must still take burn(1) each tick", 2, entity.burnCalls);
+        Assert.assertEquals("Stationary entity must still run updateFallState each tick", 2, entity.updateFallStateCalls);
+        Assert.assertFalse("Zero-delta move must reset onGround", entity.onGround);
+        Assert.assertFalse("Zero-delta move must reset positionChanged", entity.positionChanged);
+        Assert.assertFalse("Zero-delta move must reset B", entity.B);
+        Assert.assertFalse("Zero-delta move must reset C", entity.C);
+        Assert.assertFalse("Zero-delta move must clear cobweb flag E", entity.E);
+        Assert.assertEquals(0.0D, entity.motX, 0.0D);
+        Assert.assertEquals(0.0D, entity.motY, 0.0D);
+        Assert.assertEquals(0.0D, entity.motZ, 0.0D);
+    }
