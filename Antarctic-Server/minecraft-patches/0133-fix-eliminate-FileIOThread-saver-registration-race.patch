diff --git a/test/java/net/minecraft/server/FileIOThreadConcurrencyTest.java b/test/java/net/minecraft/server/FileIOThreadConcurrencyTest.java
new file mode 100644
index 0000000..c827e73
--- /dev/null
+++ b/test/java/net/minecraft/server/FileIOThreadConcurrencyTest.java
@@ -0,0 +1,57 @@
+package net.minecraft.server;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class FileIOThreadConcurrencyTest {
+
+    @Test
+    public void testConcurrentReenqueueDuringSaverCompletionIsNeverDropped() throws Exception {
+        FileIOThread io = FileIOThread.a();
+        AtomicInteger remainingChunks = new AtomicInteger(1);
+        AtomicInteger savedCount = new AtomicInteger(0);
+        CountDownLatch enteredFirstEmptyReturn = new CountDownLatch(1);
+        CountDownLatch allowFirstReturn = new CountDownLatch(1);
+
+        IAsyncChunkSaver saver = new IAsyncChunkSaver() {
+            private boolean injectedRace = false;
+
+            @Override
+            public boolean a() {
+                if (remainingChunks.get() > 0) {
+                    remainingChunks.decrementAndGet();
+                    savedCount.incrementAndGet();
+                    return true;
+                }
+                if (!injectedRace) {
+                    injectedRace = true;
+                    enteredFirstEmptyReturn.countDown();
+                    try {
+                        allowFirstReturn.await(5, TimeUnit.SECONDS);
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                }
+                return false;
+            }
+        };
+
+        io.a(saver);
+        Assert.assertTrue("Saver must reach its empty return point", enteredFirstEmptyReturn.await(5, TimeUnit.SECONDS));
+
+        // Simulate main thread enqueuing a new chunk and calling FileIOThread.a(saver)
+        // right before saver.a() returns false!
+        remainingChunks.incrementAndGet();
+        io.a(saver);
+        allowFirstReturn.countDown();
+
+        // Wait for FileIOThread to finish all queued work
+        io.b();
+
+        Assert.assertEquals("Re-enqueued chunk during saver completion must NOT be dropped", 2, savedCount.get());
+        Assert.assertEquals(0, remainingChunks.get());
+    }
+}
