+    @Test
+    public void testAnvilLoadExportAndInflateBenchmark() throws IOException {
+        ChunkSection template = new ChunkSection(16, true);
+        IBlockData stone = Blocks.STONE.getBlockData();
+        IBlockData dirt = Blocks.DIRT.getBlockData();
+        IBlockData grass = Blocks.GRASS.getBlockData();
+        IBlockData water = Blocks.WATER.getBlockData();
+        for (int y = 0; y < 16; ++y) {
+            for (int z = 0; z < 16; ++z) {
+                for (int x = 0; x < 16; ++x) {
+                    IBlockData d = y < 10 ? stone : (y < 13 ? dirt : (y == 13 ? grass : (x < 6 ? water : Blocks.AIR.getBlockData())));
+                    if (d.getBlock() != Blocks.AIR) {
+                        template.setType(x, y, z, d);
+                    }
+                }
+            }
+        }
+
+        byte[] blocks = new byte[4096];
+        NibbleArray data = new NibbleArray();
+        template.getBlocks().exportData(blocks, data);
+        NibbleArray[] refAddOut = new NibbleArray[1];
+
+        // Compress realistic 4-section chunk NBTTagCompound for inflate + NBT parse benchmark
+        NBTTagCompound chunkNbt = new NBTTagCompound();
+        NBTTagCompound levelNbt = new NBTTagCompound();
+        levelNbt.setInt("xPos", 3);
+        levelNbt.setInt("zPos", -5);
+        levelNbt.setByteArray("Biomes", new byte[256]);
+        levelNbt.setIntArray("HeightMap", new int[256]);
+        NBTTagList sectionsList = new NBTTagList();
+        for (int sec = 0; sec < 4; ++sec) {
+            NBTTagCompound secNbt = new NBTTagCompound();
+            secNbt.setByte("Y", (byte) sec);
+            secNbt.setByteArray("Blocks", blocks.clone());
+            secNbt.setByteArray("Data", data.asBytes().clone());
+            secNbt.setByteArray("BlockLight", new byte[2048]);
+            secNbt.setByteArray("SkyLight", new byte[2048]);
+            sectionsList.add(secNbt);
+        }
+        levelNbt.set("Sections", sectionsList);
+        chunkNbt.set("Level", levelNbt);
+
+        ByteArrayOutputStream uncompressedOut = new ByteArrayOutputStream();
+        try (java.io.DataOutputStream dos = new java.io.DataOutputStream(uncompressedOut)) {
+            NBTCompressedStreamTools.a(chunkNbt, (java.io.DataOutput) dos);
+        }
+        byte[] rawPayload = uncompressedOut.toByteArray();
+        Deflater deflater = new Deflater();
+        deflater.setInput(rawPayload);
+        deflater.finish();
+        ByteArrayOutputStream compressedOut = new ByteArrayOutputStream();
+        byte[] tmp = new byte[4096];
+        while (!deflater.finished()) {
+            int n = deflater.deflate(tmp);
+            compressedOut.write(tmp, 0, n);
+        }
+        deflater.end();
+        byte[] compressed = compressedOut.toByteArray();
+
+        NibbleArray emittedLight = new NibbleArray();
+        NibbleArray skyLight = new NibbleArray();
+
+        long blackhole = 0L;
+        for (int i = 0; i < 2500; ++i) {
+            ChunkSection sRef = new ChunkSection(16, true);
+            vanillaLoadReference(sRef.getBlocks(), blocks, data, null);
+            sRef.a(emittedLight);
+            sRef.b(skyLight);
+            sRef.recalcBlockCounts();
+
+            ChunkSection sOpt = new ChunkSection(16, null, emittedLight, skyLight);
+            sOpt.loadFromAnvil(blocks, data, null);
+
+            vanillaExportReference(template.getBlocks(), blocks, data, refAddOut);
+            template.getBlocks().exportData(blocks, data);
+
+            try (DataInputStream in1 = new DataInputStream(new BufferedInputStream(new InflaterInputStream(new ByteArrayInputStream(compressed))));
+                 DataInputStream in2 = RegionFile.inflateZlib(compressed)) {
+                NBTTagCompound nbt1 = NBTCompressedStreamTools.a(in1);
+                NBTTagCompound nbt2 = NBTCompressedStreamTools.a(in2);
+                if (i == 0) {
+                    assertEquals(chunkNbt, nbt1);
+                    assertEquals(chunkNbt, nbt2);
+                }
+                blackhole ^= nbt1.getCompound("Level").getInt("xPos") ^ nbt2.getCompound("Level").getInt("zPos")
+                        ^ (sRef.shouldTick() ? 1L : 0L) ^ (sOpt.shouldTick() ? 2L : 0L);
+            }
+        }
+
+        int iters = 3000;
+        long t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            ChunkSection sRef = new ChunkSection(16, true);
+            vanillaLoadReference(sRef.getBlocks(), blocks, data, null);
+            sRef.a(emittedLight);
+            sRef.b(skyLight);
+            sRef.recalcBlockCounts();
+            blackhole ^= sRef.hasFluids() ? 1L : 0L;
+        }
+        long vanillaLoadNs = (System.nanoTime() - t0) / iters;
+
+        t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            ChunkSection sOpt = new ChunkSection(16, null, emittedLight, skyLight);
+            sOpt.loadFromAnvil(blocks, data, null);
+            blackhole ^= sOpt.hasFluids() ? 1L : 0L;
+        }
+        long optLoadNs = (System.nanoTime() - t0) / iters;
+
+        t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            vanillaExportReference(template.getBlocks(), blocks, data, refAddOut);
+            blackhole ^= blocks[i & 4095];
+        }
+        long vanillaExportNs = (System.nanoTime() - t0) / iters;
+
+        t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            template.getBlocks().exportData(blocks, data);
+            blackhole ^= blocks[i & 4095];
+        }
+        long optExportNs = (System.nanoTime() - t0) / iters;
+
+        int inflateIters = 1500;
+        t0 = System.nanoTime();
+        for (int i = 0; i < inflateIters; ++i) {
+            try (DataInputStream in = new DataInputStream(new BufferedInputStream(new InflaterInputStream(new ByteArrayInputStream(compressed))))) {
+                NBTTagCompound loaded = NBTCompressedStreamTools.a(in);
+                blackhole ^= loaded.getCompound("Level").getInt("xPos");
+            }
+        }
+        long vanillaInflateNs = (System.nanoTime() - t0) / inflateIters;
+
+        t0 = System.nanoTime();
+        for (int i = 0; i < inflateIters; ++i) {
+            try (DataInputStream in = RegionFile.inflateZlib(compressed)) {
+                NBTTagCompound loaded = NBTCompressedStreamTools.a(in);
+                blackhole ^= loaded.getCompound("Level").getInt("xPos");
+            }
+        }
+        long optInflateNs = (System.nanoTime() - t0) / inflateIters;
+
+        System.out.printf("A2_BENCH load_vanilla_ns=%d load_opt_ns=%d load_speedup=%.2fx export_vanilla_ns=%d export_opt_ns=%d export_speedup=%.2fx inflate_vanilla_ns=%d inflate_opt_ns=%d inflate_speedup=%.2fx blackhole=%d%n",
+                vanillaLoadNs, optLoadNs, (double) vanillaLoadNs / Math.max(1L, optLoadNs),
+                vanillaExportNs, optExportNs, (double) vanillaExportNs / Math.max(1L, optExportNs),
+                vanillaInflateNs, optInflateNs, (double) vanillaInflateNs / Math.max(1L, optInflateNs),
+                blackhole);
+
+        assertTrue("Expected Anvil load speedup > 1.2x, got " + vanillaLoadNs + " vs " + optLoadNs, optLoadNs * 1.2 < vanillaLoadNs);
+        assertTrue("Expected Anvil export speedup > 1.2x, got " + vanillaExportNs + " vs " + optExportNs, optExportNs * 1.2 < vanillaExportNs);
+        assertTrue("Expected Zlib inflate+NBT no regression (<= 1.05x), got " + vanillaInflateNs + " vs " + optInflateNs, optInflateNs <= vanillaInflateNs * 1.05);
+    }
