+    @Test
+    public void testAnvilSectionLoadAndExportParityAllPaletteWidths() {
+        // 4-bit mixed
+        List<IBlockData> mixed4 = Arrays.asList(
+                Blocks.AIR.getBlockData(),
+                Blocks.STONE.getBlockData(),
+                Blocks.GRASS.getBlockData(),
+                Blocks.WATER.getBlockData(),
+                Blocks.LAVA.getBlockData(),
+                Blocks.FIRE.getBlockData()
+        );
+        assertSectionRoundTripParity(mixed4, null, true);
+
+        // Exact 16-unique-state (must remain 4-bit)
+        assertSectionRoundTripParity(ALL_VALID_STATES.subList(0, 16), null, true);
+
+        // 5-bit (24 states)
+        assertSectionRoundTripParity(ALL_VALID_STATES.subList(0, 24), null, false);
+
+        // 8-bit (140 states)
+        assertSectionRoundTripParity(ALL_VALID_STATES.subList(0, 140), null, false);
+
+        // Global palette (>256 states)
+        assertSectionRoundTripParity(ALL_VALID_STATES.subList(0, 300), null, false);
+
+        // Anti-Xray predefinedBlockData (Paper initializes 5-bit palette when predefinedBlockData != null)
+        IBlockData[] predefined = new IBlockData[] {
+                Blocks.STONE.getBlockData(), Blocks.DIAMOND_ORE.getBlockData(), Blocks.GOLD_ORE.getBlockData()
+        };
+        assertSectionRoundTripParity(mixed4, predefined, false);
+    }
