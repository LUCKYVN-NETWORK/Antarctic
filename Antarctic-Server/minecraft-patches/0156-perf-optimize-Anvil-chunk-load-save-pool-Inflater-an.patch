+    @Test
+    public void testAnvilAddNibbleAndCorruptBlockFallbackParity() {
+        byte[] blocks = new byte[4096];
+        NibbleArray data = new NibbleArray();
+        NibbleArray add = new NibbleArray();
+
+        // Fill with stone (id=1, data=0) and inject corrupt metadata (id=1, data=15) + Add nibble entries
+        java.util.Arrays.fill(blocks, (byte) 1);
+        blocks[10] = (byte) 1;
+        data.a(10, 15); // unmapped stone metadata -> CraftBukkit fallback
+        add.a(25, 0);
+
+        DataPaletteBlock ref = new DataPaletteBlock();
+        vanillaLoadReference(ref, blocks, data, add);
+
+        ChunkSection optSec = new ChunkSection(0, null, new NibbleArray(), new NibbleArray());
+        optSec.loadFromAnvil(blocks, data, add);
+
+        for (int i = 0; i < 4096; ++i) {
+            assertEquals("Add/corrupt fallback mismatch at " + i, ref.a(i), optSec.getBlocks().a(i));
+        }
+
+        // Also test corrupt block without Add nibble (fast path)
+        DataPaletteBlock refNoAdd = new DataPaletteBlock();
+        vanillaLoadReference(refNoAdd, blocks, data, null);
+        ChunkSection optNoAdd = new ChunkSection(0, null, new NibbleArray(), new NibbleArray());
+        optNoAdd.loadFromAnvil(blocks, data, null);
+        for (int i = 0; i < 4096; ++i) {
+            assertEquals("Corrupt fallback (no-add) mismatch at " + i, refNoAdd.a(i), optNoAdd.getBlocks().a(i));
+        }
+    }
