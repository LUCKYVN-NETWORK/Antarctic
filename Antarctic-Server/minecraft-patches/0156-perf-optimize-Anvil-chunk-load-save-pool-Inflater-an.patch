+    @Test
+    public void testDataBitsParityAcrossWidths() {
+        Random rng = new Random(0xDABA1234L);
+        for (int bits = 4; bits <= 13; ++bits) {
+            DataBits db = new DataBits(bits, 4096);
+            int[] expected = new int[4096];
+            int maxVal = (1 << bits) - 1;
+            for (int i = 0; i < 4096; ++i) {
+                int v = rng.nextInt(maxVal + 1);
+                expected[i] = v;
+                db.a(i, v);
+            }
+            for (int i = 0; i < 4096; ++i) {
+                assertEquals("DataBits mismatch at bits=" + bits + " i=" + i, expected[i], db.a(i));
+            }
+        }
+    }
+
+    private void assertSectionRoundTripParity(List<IBlockData> statesToUse, IBlockData[] predefined, boolean check4BitStay4Bit) {
+        ChunkSection expectedSection = new ChunkSection(16, true, predefined);
+        Random rng = new Random(42L + statesToUse.size());
+        for (int i = 0; i < 4096; ++i) {
+            int x = i & 15;
+            int y = (i >> 8) & 15;
+            int z = (i >> 4) & 15;
+            IBlockData state = statesToUse.get(i < statesToUse.size() ? i : rng.nextInt(statesToUse.size()));
+            expectedSection.setType(x, y, z, state);
+        }
+
+        byte[] refBlocks = new byte[4096];
+        NibbleArray refData = new NibbleArray();
+        NibbleArray[] refAddOut = new NibbleArray[1];
+        vanillaExportReference(expectedSection.getBlocks(), refBlocks, refData, refAddOut);
+
+        byte[] optBlocks = new byte[4096];
+        NibbleArray optData = new NibbleArray();
+        NibbleArray optAdd = expectedSection.getBlocks().exportData(optBlocks, optData);
+
+        assertArrayEquals(refBlocks, optBlocks);
+        assertArrayEquals(refData.asBytes(), optData.asBytes());
+        if (refAddOut[0] == null) {
+            assertNull(optAdd);
+        } else {
+            assertNotNull(optAdd);
+            assertArrayEquals(refAddOut[0].asBytes(), optAdd.asBytes());
+        }
+
+        // Load via optimized single-pass loader
+        ChunkSection actualSection = new ChunkSection(16, predefined, new NibbleArray(), new NibbleArray());
+        actualSection.loadFromAnvil(optBlocks, optData, optAdd);
+
+        assertEquals(expectedSection.getBlocks().getDataBits().a().length, actualSection.getBlocks().getDataBits().a().length);
+        if (check4BitStay4Bit) {
+            assertEquals("Expected 4-bit DataBits (256 longs) for <=16 states", 256, actualSection.getBlocks().getDataBits().a().length);
+        }
+
+        for (int y = 0; y < 16; ++y) {
+            for (int z = 0; z < 16; ++z) {
+                for (int x = 0; x < 16; ++x) {
+                    assertEquals("Block mismatch at " + x + "," + y + "," + z,
+                            expectedSection.getType(x, y, z), actualSection.getType(x, y, z));
+                }
+            }
+        }
+
+        assertEquals(expectedSection.shouldTick(), actualSection.shouldTick());
+        assertEquals(expectedSection.hasFluids(), actualSection.hasFluids());
+        assertEquals(expectedSection.hasFireOrLava(), actualSection.hasFireOrLava());
+
+        boolean tickBefore = actualSection.shouldTick();
+        boolean fluidBefore = actualSection.hasFluids();
+        boolean fireBefore = actualSection.hasFireOrLava();
+        actualSection.recalcBlockCounts();
+        assertEquals(tickBefore, actualSection.shouldTick());
+        assertEquals(fluidBefore, actualSection.hasFluids());
+        assertEquals(fireBefore, actualSection.hasFireOrLava());
+    }
