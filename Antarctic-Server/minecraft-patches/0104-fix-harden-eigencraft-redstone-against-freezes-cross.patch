@@ -0,0 +1,275 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNotSame;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import com.destroystokyo.paper.util.RedstoneWireTurbo;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.Listener;
+import org.bukkit.event.block.BlockRedstoneEvent;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.PluginManager;
+import org.bukkit.plugin.RegisteredListener;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class RedstoneWireTurboHardeningTest {
+
+    private static Unsafe unsafe;
+    private RegisteredListener registeredListener;
+
+    private static final class StubCraftWorld extends org.bukkit.craftbukkit.CraftWorld {
+        StubCraftWorld() {
+            super(null, null, null);
+        }
+
+        @Override
+        public org.bukkit.block.Block getBlockAt(int x, int y, int z) {
+            return (org.bukkit.block.Block) java.lang.reflect.Proxy.newProxyInstance(
+                org.bukkit.block.Block.class.getClassLoader(),
+                new Class<?>[]{org.bukkit.block.Block.class},
+                (proxy, method, args) -> {
+                    if ("getX".equals(method.getName())) return x;
+                    if ("getY".equals(method.getName())) return y;
+                    if ("getZ".equals(method.getName())) return z;
+                    return null;
+                }
+            );
+        }
+    }
+
+    private static org.bukkit.plugin.SimplePluginManager makePluginManager() {
+        return new org.bukkit.plugin.SimplePluginManager(null, null);
+    }
+
+    private static final class ThrowingWorld extends WorldServer {
+        AtomicBoolean shouldThrow;
+        AtomicInteger neighborCallsAfterRecovery;
+        org.bukkit.craftbukkit.CraftWorld stubWorld;
+        org.bukkit.craftbukkit.CraftServer stubServer;
+
+        ThrowingWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public org.bukkit.craftbukkit.CraftWorld getWorld() {
+            return this.stubWorld;
+        }
+
+        @Override
+        public org.bukkit.craftbukkit.CraftServer getServer() {
+            return this.stubServer;
+        }
+
+        @Override
+        public void a(BlockPosition pos, Block block, BlockPosition fromPos) {
+            if (this.shouldThrow.get()) {
+                throw new RuntimeException("simulated plugin/block exception during walk");
+            }
+            this.neighborCallsAfterRecovery.incrementAndGet();
+        }
+
+        @Override
+        public boolean setTypeAndData(BlockPosition pos, IBlockData data, int flags) {
+            LightPropagationParityTest.setBlock(this, pos.getX(), pos.getY(), pos.getZ(), data);
+            return true;
+        }
+    }
+
+    private static final class EventWorld extends WorldServer {
+        org.bukkit.craftbukkit.CraftWorld stubWorld;
+        org.bukkit.craftbukkit.CraftServer stubServer;
+
+        EventWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public org.bukkit.craftbukkit.CraftWorld getWorld() {
+            return this.stubWorld;
+        }
+
+        @Override
+        public org.bukkit.craftbukkit.CraftServer getServer() {
+            return this.stubServer;
+        }
+
+        @Override
+        public boolean setTypeAndData(BlockPosition pos, IBlockData data, int flags) {
+            LightPropagationParityTest.setBlock(this, pos.getX(), pos.getY(), pos.getZ(), data);
+            return true;
+        }
+    }
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+        Field uf = Unsafe.class.getDeclaredField("theUnsafe");
+        uf.setAccessible(true);
+        unsafe = (Unsafe) uf.get(null);
+    }
+
+    @After
+    public void cleanupListeners() {
+        if (this.registeredListener != null) {
+            BlockRedstoneEvent.getHandlerList().unregister(this.registeredListener);
+            this.registeredListener = null;
+        }
+    }
+
+    @Test
+    public void diagonalHeadingsProduceBothDirectionsEvenly() throws Exception {
+        Method computeHeading = RedstoneWireTurbo.class.getDeclaredMethod("computeHeading", int.class, int.class);
+        computeHeading.setAccessible(true);
+
+        int[][] diagonals = {{-1, -1}, {1, -1}, {-1, 1}, {1, 1}};
+        int[][] expectedPairs = {{0, 3}, {0, 1}, {2, 3}, {2, 1}}; // N=0, E=1, S=2, W=3
+
+        for (int d = 0; d < diagonals.length; ++d) {
+            int first = 0;
+            int second = 0;
+            for (int trial = 0; trial < 10_000; ++trial) {
+                int heading = (Integer) computeHeading.invoke(null, diagonals[d][0], diagonals[d][1]);
+                if (heading == expectedPairs[d][0]) {
+                    first++;
+                } else if (heading == expectedPairs[d][1]) {
+                    second++;
+                } else {
+                    fail("unexpected heading " + heading + " for diagonal (" + diagonals[d][0] + "," + diagonals[d][1] + ")");
+                }
+            }
+            assertTrue("first diagonal branch must occur (~50%): got " + first, first > 4000 && first < 6000);
+            assertTrue("second diagonal branch must occur (~50%): got " + second, second > 4000 && second < 6000);
+        }
+    }
+
+    @Test
+    public void exceptionDuringWalkDoesNotPermanentlyFreezeSubsequentUpdates() throws Exception {
+        LightPropagationParityTest.StubProvider[] providerOut = new LightPropagationParityTest.StubProvider[1];
+        WorldServer base = LightPropagationParityTest.buildWorld(101L, providerOut);
+
+        ThrowingWorld world = (ThrowingWorld) unsafe.allocateInstance(ThrowingWorld.class);
+        world.shouldThrow = new AtomicBoolean(true);
+        world.neighborCallsAfterRecovery = new AtomicInteger();
+        world.stubWorld = (org.bukkit.craftbukkit.CraftWorld) unsafe.allocateInstance(StubCraftWorld.class);
+        world.stubServer = (org.bukkit.craftbukkit.CraftServer) unsafe.allocateInstance(org.bukkit.craftbukkit.CraftServer.class);
+        LightPropagationParityTest.set(org.bukkit.craftbukkit.CraftServer.class, world.stubServer, "pluginManager", makePluginManager());
+        LightPropagationParityTest.set(World.class, world, "paperConfig", base.paperConfig);
+        world.paperConfig.useEigencraftRedstone = true;
+        LightPropagationParityTest.set(World.class, world, "chunkProvider", providerOut[0]);
+        LightPropagationParityTest.set(World.class, world, "worldProvider", base.worldProvider);
+        LightPropagationParityTest.set(World.class, world, "isClientSide", false);
+
+        for (int x = 0; x <= 4; ++x) {
+            LightPropagationParityTest.setBlock(world, x, 39, 0, Blocks.STONE.getBlockData());
+        }
+        LightPropagationParityTest.setBlock(world, 0, 40, 0, Blocks.REDSTONE_BLOCK.getBlockData());
+        LightPropagationParityTest.setBlock(world, 1, 40, 0, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(world, 2, 40, 0, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(world, 3, 40, 0, Blocks.REDSTONE_WIRE.getBlockData());
+
+        BlockPosition trigger = new BlockPosition(1, 40, 0);
+        try {
+            Blocks.REDSTONE_WIRE.a(world.getType(trigger), world, trigger, Blocks.REDSTONE_BLOCK, new BlockPosition(0, 40, 0));
+            fail("expected simulated exception to propagate out of walk");
+        } catch (RuntimeException expected) {
+            assertEquals("simulated plugin/block exception during walk", expected.getMessage());
+        }
+
+        // Disable throwing and run another update: previously nodeCache stayed non-empty and froze all wire updates forever!
+        world.shouldThrow.set(false);
+        LightPropagationParityTest.setBlock(world, 1, 40, 0, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(world, 2, 40, 0, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(world, 3, 40, 0, Blocks.REDSTONE_WIRE.getBlockData());
+        Blocks.REDSTONE_WIRE.a(world.getType(trigger), world, trigger, Blocks.REDSTONE_BLOCK, new BlockPosition(0, 40, 0));
+
+        assertEquals("wire at x=1 must recover to power 15", 15, world.getType(new BlockPosition(1, 40, 0)).get(BlockRedstoneWire.POWER).intValue());
+        assertEquals("wire at x=2 must recover to power 14", 14, world.getType(new BlockPosition(2, 40, 0)).get(BlockRedstoneWire.POWER).intValue());
+        assertEquals("wire at x=3 must recover to power 13", 13, world.getType(new BlockPosition(3, 40, 0)).get(BlockRedstoneWire.POWER).intValue());
+        assertTrue("neighbor updates must resume after exception", world.neighborCallsAfterRecovery.get() > 0);
+    }
+
+    @Test
+    public void separateWorldsUseDistinctTurboInstances() throws Exception {
+        LightPropagationParityTest.StubProvider[] p1 = new LightPropagationParityTest.StubProvider[1];
+        LightPropagationParityTest.StubProvider[] p2 = new LightPropagationParityTest.StubProvider[1];
+        WorldServer worldA = LightPropagationParityTest.buildWorld(201L, p1);
+        WorldServer worldB = LightPropagationParityTest.buildWorld(202L, p2);
+        worldA.paperConfig.useEigencraftRedstone = true;
+        worldB.paperConfig.useEigencraftRedstone = true;
+
+        LightPropagationParityTest.setBlock(worldA, 2, 39, 2, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(worldA, 2, 40, 2, Blocks.REDSTONE_WIRE.getBlockData());
+        LightPropagationParityTest.setBlock(worldB, 2, 39, 2, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(worldB, 2, 40, 2, Blocks.REDSTONE_WIRE.getBlockData());
+
+        BlockPosition pos = new BlockPosition(2, 40, 2);
+        Blocks.REDSTONE_WIRE.a(worldA.getType(pos), worldA, pos, Blocks.STONE, pos);
+        Blocks.REDSTONE_WIRE.a(worldB.getType(pos), worldB, pos, Blocks.STONE, pos);
+
+        assertNotNull(worldA.redstoneWireTurbo);
+        assertNotNull(worldB.redstoneWireTurbo);
+        assertNotSame("worlds must never share a singleton RedstoneWireTurbo", worldA.redstoneWireTurbo, worldB.redstoneWireTurbo);
+    }
+
+    @Test
+    public void triggerWireFiresBlockRedstoneEventWhenListenerRegistered() throws Exception {
+        AtomicInteger eventCalls = new AtomicInteger();
+        Plugin dummyPlugin = (Plugin) java.lang.reflect.Proxy.newProxyInstance(
+            Plugin.class.getClassLoader(),
+            new Class<?>[]{Plugin.class},
+            (proxy, method, args) -> {
+                if ("isEnabled".equals(method.getName())) return true;
+                if ("getName".equals(method.getName())) return "TestPlugin";
+                return null;
+            }
+        );
+
+        this.registeredListener = new RegisteredListener(
+            new Listener() {},
+            (listener, event) -> {
+                if (event instanceof BlockRedstoneEvent) {
+                    eventCalls.incrementAndGet();
+                    ((BlockRedstoneEvent) event).setNewCurrent(7);
+                }
+            },
+            EventPriority.NORMAL,
+            dummyPlugin,
+            false
+        );
+        BlockRedstoneEvent.getHandlerList().register(this.registeredListener);
+
+        LightPropagationParityTest.StubProvider[] p = new LightPropagationParityTest.StubProvider[1];
+        WorldServer base = LightPropagationParityTest.buildWorld(303L, p);
+
+        EventWorld world = (EventWorld) unsafe.allocateInstance(EventWorld.class);
+        world.stubWorld = (org.bukkit.craftbukkit.CraftWorld) unsafe.allocateInstance(StubCraftWorld.class);
+        world.stubServer = (org.bukkit.craftbukkit.CraftServer) unsafe.allocateInstance(org.bukkit.craftbukkit.CraftServer.class);
+        LightPropagationParityTest.set(org.bukkit.craftbukkit.CraftServer.class, world.stubServer, "pluginManager", makePluginManager());
+        LightPropagationParityTest.set(World.class, world, "paperConfig", base.paperConfig);
+        world.paperConfig.useEigencraftRedstone = true;
+        LightPropagationParityTest.set(World.class, world, "chunkProvider", p[0]);
+        LightPropagationParityTest.set(World.class, world, "worldProvider", base.worldProvider);
+        LightPropagationParityTest.set(World.class, world, "isClientSide", false);
+
+        LightPropagationParityTest.setBlock(world, 0, 40, 0, Blocks.REDSTONE_BLOCK.getBlockData());
+        LightPropagationParityTest.setBlock(world, 1, 39, 0, Blocks.STONE.getBlockData());
+        LightPropagationParityTest.setBlock(world, 1, 40, 0, Blocks.REDSTONE_WIRE.getBlockData());
+
+        BlockPosition trigger = new BlockPosition(1, 40, 0);
+        IBlockData result = Blocks.REDSTONE_WIRE.calculateCurrentChanges(world, trigger, trigger, world.getType(trigger));
+
+        assertEquals("trigger wire must fire BlockRedstoneEvent", 1, eventCalls.get());
+        assertEquals("listener-modified current must be applied to trigger wire", 7, result.get(BlockRedstoneWire.POWER).intValue());
+    }
+}
