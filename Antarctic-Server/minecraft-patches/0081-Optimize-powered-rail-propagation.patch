+    private boolean findPoweredRailSignalOptimized(World world, BlockPosition pos, IBlockData data, boolean forward) {
+        BlockMinecartTrackAbstract.EnumTrackPosition shape = (BlockMinecartTrackAbstract.EnumTrackPosition) data.get(BlockPoweredRail.SHAPE);
+        if (shape != BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH && shape != BlockMinecartTrackAbstract.EnumTrackPosition.EAST_WEST) {
+            return this.a(world, pos, data, forward, 0);
+        }
+        int dx = (shape == BlockMinecartTrackAbstract.EnumTrackPosition.EAST_WEST) ? (forward ? -1 : 1) : 0;
+        int dz = (shape == BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH) ? (forward ? 1 : -1) : 0;
+        BlockPosition.PooledBlockPosition pooledPos = BlockPosition.PooledBlockPosition.s();
+        try {
+            int cx = pos.getX();
+            int cy = pos.getY();
+            int cz = pos.getZ();
+            for (int dist = 0; dist < 8; ++dist) {
+                cx += dx;
+                cz += dz;
+                pooledPos.f(cx, cy, cz);
+                IBlockData neighbor = world.getType(pooledPos);
+                if (neighbor.getBlock() != this) {
+                    pooledPos.f(cx, cy - 1, cz);
+                    neighbor = world.getType(pooledPos);
+                    if (neighbor.getBlock() != this) {
+                        return false;
+                    }
+                    cy -= 1;
+                }
+                BlockMinecartTrackAbstract.EnumTrackPosition nShape = (BlockMinecartTrackAbstract.EnumTrackPosition) neighbor.get(BlockPoweredRail.SHAPE);
+                if (shape == BlockMinecartTrackAbstract.EnumTrackPosition.EAST_WEST && (nShape == BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH || nShape == BlockMinecartTrackAbstract.EnumTrackPosition.ASCENDING_NORTH || nShape == BlockMinecartTrackAbstract.EnumTrackPosition.ASCENDING_SOUTH)) {
+                    return false;
+                }
+                if (shape == BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH && (nShape == BlockMinecartTrackAbstract.EnumTrackPosition.EAST_WEST || nShape == BlockMinecartTrackAbstract.EnumTrackPosition.ASCENDING_EAST || nShape == BlockMinecartTrackAbstract.EnumTrackPosition.ASCENDING_WEST)) {
+                    return false;
+                }
+                if (!((Boolean) neighbor.get(BlockPoweredRail.POWERED)).booleanValue()) {
+                    return false;
+                }
+                if (world.isBlockIndirectlyPowered(pooledPos)) {
+                    return true;
+                }
+                if (nShape.c()) {
+                    return this.a(world, pooledPos.h(), neighbor, forward, dist + 1);
+                }
+            }
+            return false;
+        } finally {
+            pooledPos.t();
+        }
+    }
