+    @Test
+    public void testTerrainDensityParityRealisticAndCancellationEdgeCase() {
+        IBlockData stone = Blocks.STONE.getBlockData();
+        IBlockData water = Blocks.WATER.getBlockData();
+        char stoneId = (char) Block.REGISTRY_ID.getId(stone);
+        char waterId = (char) Block.REGISTRY_ID.getId(water);
+        int seaLevel = 63;
+
+        Random rng = new Random(0xA1A1A1A1L);
+        for (int trial = 0; trial < 12; ++trial) {
+            double[] density = new double[825];
+            for (int xz = 0; xz < 25; ++xz) {
+                for (int y = 0; y < 33; ++y) {
+                    double base = (8.0 - y) * 18.0 + (rng.nextDouble() - 0.5) * 40.0;
+                    density[xz * 33 + y] = base;
+                }
+            }
+
+            ChunkSnapshot expected = new ChunkSnapshot();
+            ChunkSnapshot actual = new ChunkSnapshot();
+            vanillaTerrainReference(density, expected, stone, water, seaLevel);
+            ChunkProviderGenerate.fillTerrainFromDensity(density, actual.rawBlocks(), stoneId, waterId, seaLevel);
+
+            assertArrayEquals("Terrain mismatch on trial " + trial, expected.rawBlocks(), actual.rawBlocks());
+        }
+
+        // IEEE-754 cancellation edge case: small +1e-16 and large +1000.0 (falls back to vanilla via <= 1.0D guard)
+        double[] cancelDensity = new double[825];
+        Arrays.fill(cancelDensity, 1e-16);
+        for (int i = 0; i < cancelDensity.length; i += 3) {
+            cancelDensity[i] = 1000.0;
+        }
+        cancelDensity[33] = -1e-16;
+        cancelDensity[34] = -500.0;
+
+        ChunkSnapshot expectedCancel = new ChunkSnapshot();
+        ChunkSnapshot actualCancel = new ChunkSnapshot();
+        vanillaTerrainReference(cancelDensity, expectedCancel, stone, water, seaLevel);
+        ChunkProviderGenerate.fillTerrainFromDensity(cancelDensity, actualCancel.rawBlocks(), stoneId, waterId, seaLevel);
+        assertArrayEquals("Cancellation edge case mismatch", expectedCancel.rawBlocks(), actualCancel.rawBlocks());
+    }
