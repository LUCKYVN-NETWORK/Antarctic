+    @Test
+    public void testChunkSectionFillFromSnapshotParity() {
+        ChunkSnapshot snap = new ChunkSnapshot();
+        IBlockData stone = Blocks.STONE.getBlockData();
+        IBlockData grass = Blocks.GRASS.getBlockData();
+        IBlockData water = Blocks.WATER.getBlockData();
+        IBlockData lava = Blocks.LAVA.getBlockData();
+        IBlockData fire = Blocks.FIRE.getBlockData();
+
+        // Section 0: empty
+        ChunkSection emptySection = new ChunkSection(0, true);
+        assertFalse(emptySection.fillFromSnapshot(snap.rawBlocks(), 0));
+
+        // Section 1 (y = 16..31): mixed blocks including ticking, liquid, fire/lava
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                snap.a(x, 16, z, stone);
+                if (x < 4) {
+                    snap.a(x, 17, z, water);
+                } else if (x < 8) {
+                    snap.a(x, 17, z, grass);
+                } else if (x < 10) {
+                    snap.a(x, 17, z, lava);
+                } else if (x == 12) {
+                    snap.a(x, 17, z, fire);
+                }
+            }
+        }
+
+        IBlockData[] predefined = new IBlockData[] { stone, grass, water, lava };
+        ChunkSection expected = new ChunkSection(16, true, predefined);
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                for (int dy = 0; dy < 16; ++dy) {
+                    IBlockData data = snap.a(x, 16 + dy, z);
+                    if (data.getMaterial() != Material.AIR) {
+                        expected.setType(x, dy, z, data);
+                    }
+                }
+            }
+        }
+
+        ChunkSection actual = new ChunkSection(16, true, predefined);
+        assertTrue(actual.fillFromSnapshot(snap.rawBlocks(), 16));
+
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                for (int dy = 0; dy < 16; ++dy) {
+                    assertEquals("Block mismatch at " + x + "," + dy + "," + z,
+                            expected.getType(x, dy, z), actual.getType(x, dy, z));
+                }
+            }
+        }
+        assertEquals(expected.shouldTick(), actual.shouldTick());
+        assertEquals(expected.hasFluids(), actual.hasFluids());
+        assertEquals(expected.hasFireOrLava(), actual.hasFireOrLava());
+
+        // Verify counters match recalcBlockCounts()
+        boolean beforeTick = actual.shouldTick();
+        boolean beforeFluid = actual.hasFluids();
+        boolean beforeFire = actual.hasFireOrLava();
+        actual.recalcBlockCounts();
+        assertEquals(beforeTick, actual.shouldTick());
+        assertEquals(beforeFluid, actual.hasFluids());
+        assertEquals(beforeFire, actual.hasFireOrLava());
+    }
