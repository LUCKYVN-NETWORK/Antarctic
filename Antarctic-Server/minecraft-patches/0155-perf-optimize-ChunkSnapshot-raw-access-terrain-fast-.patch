+        char waterId = (char) Block.REGISTRY_ID.getId(water);
+
+        snap.a(7, 65, 7, stone);
+        assertEquals(stoneId, snap.getRaw(7, 65, 7));
+        snap.setRaw(3, 12, 11, waterId);
+        assertEquals(water, snap.a(3, 12, 11));
+
+        // Woodland mansion height helper a(x, z) preserves exact vanilla this.b[k + l] quirk
+        assertEquals(0, snap.a(7, 7));
+        assertEquals(66, snap.a(7, 6));
+        assertEquals(0, snap.a(0, 0));
+
+        snap.clear();
+        for (char c : snap.rawBlocks()) {
+            assertEquals('\0', c);
+        }
+    }
