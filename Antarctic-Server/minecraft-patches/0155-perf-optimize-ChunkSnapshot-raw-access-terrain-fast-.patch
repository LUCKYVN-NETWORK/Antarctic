+    // Antarctic start - single-pass section population from ChunkSnapshot raw char[]
+    boolean fillFromSnapshot(char[] raw, int baseY) {
+        boolean wroteAny = false;
+        int nonEmpty = 0;
+        int ticking = 0;
+        int fluids = 0;
+        int fireOrLava = 0;
+
+        char lastId = 0;
+        IBlockData lastData = null;
+        boolean lastNotAir = false;
+        boolean lastTicking = false;
+        boolean lastLiquid = false;
+        boolean lastFireOrLava = false;
+
+        for (int dy = 0; dy < 16; ++dy) {
+            int y = baseY + dy;
+            int dyShift = dy << 8;
+            for (int z = 0; z < 16; ++z) {
+                int zyShift = dyShift | (z << 4);
+                int zSnap = (z << 8) | y;
+                for (int x = 0; x < 16; ++x) {
+                    char id = raw[(x << 12) | zSnap];
+                    if (id == 0) {
+                        continue;
+                    }
+                    if (id != lastId) {
+                        IBlockData data = Block.REGISTRY_ID.fromId(id);
+                        if (data == null || data.getMaterial() == Material.AIR) {
+                            continue;
+                        }
+                        lastId = id;
+                        lastData = data;
+                        Block block = data.getBlock();
+                        lastNotAir = block != Blocks.AIR;
+                        lastTicking = lastNotAir && block.isTicking();
+                        lastLiquid = data.getMaterial().isLiquid();
+                        lastFireOrLava = block == Blocks.FIRE || block == Blocks.FLOWING_LAVA || block == Blocks.LAVA;
+                    }
+                    wroteAny = true;
+                    if (lastNotAir) {
+                        ++nonEmpty;
+                        if (lastTicking) {
+                            ++ticking;
+                        }
+                        if (lastLiquid) {
+                            ++fluids;
+                        }
+                        if (lastFireOrLava) {
+                            ++fireOrLava;
+                        }
+                    }
+                    this.blockIds.setBlockIndex(zyShift | x, lastData);
+                }
+            }
+        }
+
+        this.nonEmptyBlockCount = nonEmpty;
+        this.tickingBlockCount = ticking;
+        this.fluidCount = fluids;
+        this.fireOrLavaCount = fireOrLava;
+        return wroteAny;
+    }
+    // Antarctic end
