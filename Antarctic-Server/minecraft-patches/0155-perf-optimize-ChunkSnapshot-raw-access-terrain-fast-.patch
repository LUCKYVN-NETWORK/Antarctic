+    @Test
+    public void testChunkGenAndSectionBuildBenchmark() {
+        IBlockData stone = Blocks.STONE.getBlockData();
+        IBlockData water = Blocks.WATER.getBlockData();
+        char stoneId = (char) Block.REGISTRY_ID.getId(stone);
+        char waterId = (char) Block.REGISTRY_ID.getId(water);
+        int seaLevel = 63;
+
+        double[] density = new double[825];
+        for (int xz = 0; xz < 25; ++xz) {
+            for (int y = 0; y < 33; ++y) {
+                density[xz * 33 + y] = (8.0 - y) * 18.0;
+            }
+        }
+
+        ChunkSnapshot snap = new ChunkSnapshot();
+        long blackhole = 0L;
+
+        // Warmup
+        for (int i = 0; i < 400; ++i) {
+            snap.clear();
+            vanillaTerrainReference(density, snap, stone, water, seaLevel);
+            blackhole ^= snap.rawBlocks()[i & 4095];
+
+            snap.clear();
+            ChunkProviderGenerate.fillTerrainFromDensity(density, snap.rawBlocks(), stoneId, waterId, seaLevel);
+            blackhole ^= snap.rawBlocks()[i & 4095];
+        }
+
+        int terrainIters = 1500;
+        long t0 = System.nanoTime();
+        for (int i = 0; i < terrainIters; ++i) {
+            snap.clear();
+            vanillaTerrainReference(density, snap, stone, water, seaLevel);
+            blackhole ^= snap.rawBlocks()[i & 4095];
+        }
+        long vanillaTerrainNs = (System.nanoTime() - t0) / terrainIters;
+
+        t0 = System.nanoTime();
+        for (int i = 0; i < terrainIters; ++i) {
+            snap.clear();
+            ChunkProviderGenerate.fillTerrainFromDensity(density, snap.rawBlocks(), stoneId, waterId, seaLevel);
+            blackhole ^= snap.rawBlocks()[i & 4095];
+        }
+        long optTerrainNs = (System.nanoTime() - t0) / terrainIters;
+
+        // Section build benchmark (4 sections: y=0, 16, 32, 48)
+        int sectionIters = 600;
+        for (int i = 0; i < 150; ++i) {
+            ChunkSection s1 = new ChunkSection(16, true);
+            for (int x = 0; x < 16; ++x) {
+                for (int z = 0; z < 16; ++z) {
+                    for (int dy = 0; dy < 16; ++dy) {
+                        IBlockData d = snap.a(x, 16 + dy, z);
+                        if (d.getMaterial() != Material.AIR) {
+                            s1.setType(x, dy, z, d);
+                        }
+                    }
+                }
+            }
+            ChunkSection s2 = new ChunkSection(16, true);
+            s2.fillFromSnapshot(snap.rawBlocks(), 16);
+            blackhole ^= (s1.shouldTick() ? 1 : 0) ^ (s2.shouldTick() ? 2 : 0);
+        }
+
+        t0 = System.nanoTime();
+        for (int i = 0; i < sectionIters; ++i) {
+            for (int secY = 0; secY < 4; ++secY) {
+                int baseY = secY << 4;
+                ChunkSection s = new ChunkSection(baseY, true);
+                for (int x = 0; x < 16; ++x) {
+                    for (int z = 0; z < 16; ++z) {
+                        for (int dy = 0; dy < 16; ++dy) {
+                            IBlockData d = snap.a(x, baseY + dy, z);
+                            if (d.getMaterial() != Material.AIR) {
+                                s.setType(x, dy, z, d);
+                            }
+                        }
+                    }
+                }
+                blackhole ^= s.hasFluids() ? 1L : 0L;
+            }
+        }
+        long vanillaSectionNs = (System.nanoTime() - t0) / sectionIters;
+
+        t0 = System.nanoTime();
+        for (int i = 0; i < sectionIters; ++i) {
+            for (int secY = 0; secY < 4; ++secY) {
+                int baseY = secY << 4;
+                ChunkSection s = new ChunkSection(baseY, true);
+                s.fillFromSnapshot(snap.rawBlocks(), baseY);
+                blackhole ^= s.hasFluids() ? 1L : 0L;
+            }
+        }
+        long optSectionNs = (System.nanoTime() - t0) / sectionIters;
+
+        System.out.printf("A1_BENCH terrain_vanilla_ns=%d terrain_opt_ns=%d terrain_speedup=%.2fx section4_vanilla_ns=%d section4_opt_ns=%d section_speedup=%.2fx blackhole=%d%n",
+                vanillaTerrainNs, optTerrainNs, (double) vanillaTerrainNs / Math.max(1L, optTerrainNs),
+                vanillaSectionNs, optSectionNs, (double) vanillaSectionNs / Math.max(1L, optSectionNs), blackhole);
+
+        assertTrue("Expected terrain fast-path speedup > 1.2x, got " + vanillaTerrainNs + " vs " + optTerrainNs,
+                optTerrainNs * 1.2 < vanillaTerrainNs);
+        assertTrue("Expected section build speedup > 1.2x, got " + vanillaSectionNs + " vs " + optSectionNs,
+                optSectionNs * 1.2 < vanillaSectionNs);
+    }
+}
