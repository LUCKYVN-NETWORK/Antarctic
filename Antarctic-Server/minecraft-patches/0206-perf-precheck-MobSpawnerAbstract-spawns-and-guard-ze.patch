diff --git a/test/java/net/minecraft/server/MobSpawnerPrecheckParityTest.java b/test/java/net/minecraft/server/MobSpawnerPrecheckParityTest.java
new file mode 100644
index 0000000..6237317
--- /dev/null
+++ b/test/java/net/minecraft/server/MobSpawnerPrecheckParityTest.java
@@ -0,0 +1,278 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.PaperWorldConfig;
+import com.destroystokyo.paper.config.toml.AntarcticTomlConfig;
+import com.destroystokyo.paper.config.toml.modules.optimizations.MobSpawning;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.io.File;
+import java.lang.reflect.Field;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+import static org.junit.Assert.*;
+
+public class MobSpawnerPrecheckParityTest {
+
+    private static Unsafe UNSAFE;
+    private static int savedBackoffTicks;
+    private static String savedPrecheckMode;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+        savedBackoffTicks = MobSpawning.spawnerFailedAttemptBackoffTicks;
+        savedPrecheckMode = MobSpawning.precheckLightMode;
+    }
+
+    @After
+    public void restoreConfig() {
+        MobSpawning.spawnerFailedAttemptBackoffTicks = savedBackoffTicks;
+        MobSpawning.precheckLightMode = savedPrecheckMode;
+    }
+
+    private static final class SpawnerTestWorld extends World {
+        final Chunk chunk;
+        int lightLevel = 15;
+        boolean playerNearby = true;
+
+        SpawnerTestWorld(Chunk chunk) {
+            super(null, new WorldData(), new WorldProviderNormal(), new MethodProfiler(), false, null, null);
+            this.chunk = chunk;
+        }
+
+        @Override
+        protected IChunkProvider n() {
+            return null;
+        }
+
+        @Override
+        protected boolean isChunkLoaded(int i, int j, boolean flag) {
+            return i == 0 && j == 0;
+        }
+
+        @Override
+        public Chunk getChunkIfLoaded(int i, int j) {
+            return (i == 0 && j == 0) ? this.chunk : null;
+        }
+
+        @Override
+        public boolean isPlayerNearby(double d0, double d1, double d2, double d3) {
+            return this.playerNearby;
+        }
+
+        @Override
+        public EnumDifficulty getDifficulty() {
+            return EnumDifficulty.NORMAL;
+        }
+
+        @Override
+        public boolean isLightLevel(BlockPosition pos, int max) {
+            return this.lightLevel > max;
+        }
+
+        @Override
+        public int getBrightness(EnumSkyBlock type, int x, int y, int z) {
+            return this.lightLevel;
+        }
+
+        @Override
+        public boolean X() {
+            return false;
+        }
+    }
+
+    private static SpawnerTestWorld createTestWorld() throws Exception {
+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        Field secField = Chunk.class.getDeclaredField("sections");
+        secField.setAccessible(true);
+        ChunkSection[] sections = new ChunkSection[16];
+        for (int s = 0; s < 16; ++s) {
+            sections[s] = new ChunkSection(s << 4, true);
+        }
+        secField.set(chunk, sections);
+
+        Field slicesField = Chunk.class.getDeclaredField("entitySlices");
+        slicesField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        List<Entity>[] slices = new List[16];
+        for (int s = 0; s < 16; ++s) {
+            slices[s] = new ArrayList<>();
+        }
+        slicesField.set(chunk, slices);
+
+        for (String fn : new String[]{"hardCollidableCounts", "itemCounts", "inventoryEntityCounts", "itemFrameCounts"}) {
+            Field f = Chunk.class.getDeclaredField(fn);
+            f.setAccessible(true);
+            f.set(chunk, new int[16]);
+        }
+
+        SpawnerTestWorld world = (SpawnerTestWorld) UNSAFE.allocateInstance(SpawnerTestWorld.class);
+        Field randField = World.class.getDeclaredField("random");
+        randField.setAccessible(true);
+        randField.set(world, new Random(12345L));
+        world.playerNearby = true;
+        world.lightLevel = 15;
+        Field cf = SpawnerTestWorld.class.getDeclaredField("chunk");
+        cf.setAccessible(true);
+        cf.set(world, chunk);
+        Field wc = Chunk.class.getDeclaredField("world");
+        wc.setAccessible(true);
+        wc.set(chunk, world);
+        Field wdField = World.class.getDeclaredField("worldData");
+        wdField.setAccessible(true);
+        WorldData wd = new WorldData();
+        wdField.set(world, wd);
+        Field pwc = World.class.getDeclaredField("paperConfig");
+        pwc.setAccessible(true);
+        PaperWorldConfig config = (PaperWorldConfig) UNSAFE.allocateInstance(PaperWorldConfig.class);
+        config.mobSpawnerTickRate = 1;
+        pwc.set(world, config);
+        Field cpField = World.class.getDeclaredField("chunkProvider");
+        cpField.setAccessible(true);
+        cpField.set(world, new IChunkProvider() {
+            @Override public Chunk getLoadedChunkAt(int i, int j) { return (i == 0 && j == 0) ? chunk : null; }
+            @Override public Chunk getChunkAt(int i, int j) { return (i == 0 && j == 0) ? chunk : null; }
+            @Override public boolean unloadChunks() { return false; }
+            @Override public String getName() { return "SpawnerTestChunkProvider"; }
+            @Override public boolean e(int i, int j) { return i == 0 && j == 0; }
+        });
+        return world;
+    }
+
+    @Test
+    public void testConfigDefaultAndValidation() throws Exception {
+        assertEquals(0, MobSpawning.spawnerFailedAttemptBackoffTicks);
+        File tempDir = Files.createTempDirectory("antarctic-a2-toml").toFile();
+        try {
+            File toml = new File(tempDir, "antarctic.toml");
+            AntarcticTomlConfig.load(toml);
+            assertEquals(0, MobSpawning.spawnerFailedAttemptBackoffTicks);
+
+            MobSpawning module = new MobSpawning();
+            MobSpawning.spawnerFailedAttemptBackoffTicks = -1;
+            try {
+                module.onLoaded(AntarcticTomlConfig.getTomlConfig());
+                fail("Expected IllegalArgumentException for negative backoff");
+            } catch (IllegalArgumentException expected) {
+                // expected
+            }
+        } finally {
+            MobSpawning.spawnerFailedAttemptBackoffTicks = savedBackoffTicks;
+            for (File f : tempDir.listFiles()) {
+                f.delete();
+            }
+            tempDir.delete();
+        }
+    }
+
+    @Test
+    public void testPrecheckAndBackoffParity() throws Exception {
+        SpawnerTestWorld world = createTestWorld();
+        BlockPosition spawnerPos = new BlockPosition(8, 64, 8);
+        MobSpawnerAbstract spawner = new MobSpawnerAbstract() {
+            @Override public void a(int i) {}
+            @Override public World a() { return world; }
+            @Override public BlockPosition b() { return spawnerPos; }
+        };
+        spawner.setMobName(new MinecraftKey("zombie"));
+
+        // Bright light (15) -> precheckSpawn rejects before EntityZombie construction
+        world.lightLevel = 15;
+        assertEquals(SpawnerCreature.PRECHECK_RESULT_REJECT,
+                SpawnerCreature.precheckSpawn(world, world.chunk, EntityZombie.class, spawnerPos, MobSpawning.PRECHECK_SINGLE_ROLL));
+
+        // Dark light (0) -> passes and sets PRECHECK_RESULT_PASS_LIGHT_PRECHECKED
+        world.lightLevel = 0;
+        assertEquals(SpawnerCreature.PRECHECK_RESULT_PASS_LIGHT_PRECHECKED,
+                SpawnerCreature.precheckSpawn(world, world.chunk, EntityZombie.class, spawnerPos, MobSpawning.PRECHECK_SINGLE_ROLL));
+
+        // Backoff = 0 (vanilla): failed cycle leaves spawnDelay == 0
+        world.lightLevel = 15;
+        MobSpawning.spawnerFailedAttemptBackoffTicks = 0;
+        spawner.spawnDelay = 0;
+        spawner.c();
+        assertEquals(0, spawner.spawnDelay);
+
+        // Backoff = 20: failed cycle sets spawnDelay == 20
+        MobSpawning.spawnerFailedAttemptBackoffTicks = 20;
+        spawner.spawnDelay = 0;
+        spawner.c();
+        assertEquals(20, spawner.spawnDelay);
+    }
+
+    @Test
+    public void testSetAirTicksZeroListenerFastPath() throws Exception {
+        SpawnerTestWorld world = createTestWorld();
+        EntityZombie zombie = (EntityZombie) UNSAFE.allocateInstance(EntityZombie.class);
+        zombie.world = world;
+        DataWatcher dw = new DataWatcher(zombie);
+        Field airField = Entity.class.getDeclaredField("aA");
+        airField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        DataWatcherObject<Integer> airObj = (DataWatcherObject<Integer>) airField.get(null);
+        dw.register(airObj, 300);
+        Field dwField = Entity.class.getDeclaredField("datawatcher");
+        dwField.setAccessible(true);
+        dwField.set(zombie, dw);
+
+        zombie.setAirTicks(150);
+        assertEquals(150, zombie.getAirTicks());
+    }
+
+    @Test
+    public void testTorchedSpawnerPrecheckPerformance() throws Exception {
+        SpawnerTestWorld world = createTestWorld();
+        world.lightLevel = 15;
+        BlockPosition spawnerPos = new BlockPosition(8, 64, 8);
+        MobSpawnerAbstract spawner = new MobSpawnerAbstract() {
+            @Override public void a(int i) {}
+            @Override public World a() { return world; }
+            @Override public BlockPosition b() { return spawnerPos; }
+        };
+        spawner.setMobName(new MinecraftKey("zombie"));
+
+        MobSpawning.spawnerFailedAttemptBackoffTicks = 0;
+
+        // Warmup precheck-on vs precheck-off
+        MobSpawning.precheckLightMode = "single-roll";
+        for (int i = 0; i < 200; i++) {
+            spawner.spawnDelay = 0;
+            spawner.c();
+        }
+        MobSpawning.precheckLightMode = "off";
+        for (int i = 0; i < 200; i++) {
+            spawner.spawnDelay = 0;
+            spawner.c();
+        }
+
+        MobSpawning.precheckLightMode = "single-roll";
+        long t0 = System.nanoTime();
+        for (int i = 0; i < 500; i++) {
+            spawner.spawnDelay = 0;
+            spawner.c();
+        }
+        long optNs = System.nanoTime() - t0;
+
+        MobSpawning.precheckLightMode = "off";
+        long t1 = System.nanoTime();
+        for (int i = 0; i < 500; i++) {
+            spawner.spawnDelay = 0;
+            spawner.c();
+        }
+        long offNs = System.nanoTime() - t1;
+
+        double speedup = (double) offNs / Math.max(1L, optNs);
+        System.out.printf("[A2 Perf] Torched spawner precheck=%d us vs off=%d us (%.1fx)%n",
+                optNs / 1000L, offNs / 1000L, speedup);
+        assertTrue("Expected >= 5x speedup on torched spawner precheck, got " + speedup, speedup >= 5.0);
+    }
+}
