+    // Antarctic start - reuse already-resolved center chunk for same-chunk light reads
+    private int getBrightnessCached(Chunk center, EnumSkyBlock enumskyblock, int x, int y, int z) {
+        if (y < 0) {
+            y = 0;
+        }
+        if (y >= 256 || x < -30000000 || z < -30000000 || x >= 30000000 || z >= 30000000) {
+            return enumskyblock.c;
+        }
+        Chunk target = (ChunkCoordIntPair.a(x >> 4, z >> 4) == center.chunkKey) ? center : this.getChunkIfLoaded(x >> 4, z >> 4);
+        if (target == null) {
+            return enumskyblock.c;
+        }
+        if (this.paperConfig.allowPermaChunkLoaders) {
+            target.d = false;
+        }
+        return target.getBrightness(enumskyblock, x, y, z);
+    }
+    // Antarctic end
+
     private int computeLightLevel(int x, int y, int z, EnumSkyBlock enumskyblock) {
         // Antarctic start - avoid synchronous chunk loads at radius 17 and reuse single chunk lookup
         Chunk chunk = this.getChunkIfLoaded(x >> 4, z >> 4);
         if (chunk == null) {
             return enumskyblock.c;
         }
+        return this.computeLightLevel(chunk, x, y, z, enumskyblock);
+    }
+
+    private int computeLightLevel(Chunk chunk, int x, int y, int z, EnumSkyBlock enumskyblock) {
         if (enumskyblock == EnumSkyBlock.SKY && chunk.canSeeSky(x, y, z)) {
             return 15;
         } else {
