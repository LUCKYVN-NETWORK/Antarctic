+    @Test
+    public void testStackedRailParityEdgeCases() throws Exception {
+        RailTestWorld w = newWorld();
+        BlockPosition origin = new BlockPosition(0, 64, 0);
+        IBlockData originData = railState(BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH, true);
+
+        // Case 1: unpowered rail at (0, 64, 1) stacked above powered indirectly-powered rail at (0, 63, 1)
+        w.set(0, 64, 0, originData);
+        w.set(0, 64, 1, railState(BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH, false));
+        w.set(0, 63, 1, railState(BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH, true));
+        w.power(0, 63, 1);
+        Assert.assertTrue("vanilla must fall back to y-1", rail.a(w, origin, originData, true, 0));
+        Assert.assertEquals(rail.a(w, origin, originData, true, 0), rail.findPoweredRailSignalOptimized(w, origin, originData, true));
+
+        // Case 2: perpendicular rail at (0, 64, 1) stacked above compatible powered rail at (0, 63, 1)
+        w.clear();
+        w.set(0, 64, 0, originData);
+        w.set(0, 64, 1, railState(BlockMinecartTrackAbstract.EnumTrackPosition.EAST_WEST, true));
+        w.set(0, 63, 1, railState(BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH, true));
+        w.power(0, 63, 1);
+        Assert.assertTrue(rail.a(w, origin, originData, true, 0));
+        Assert.assertEquals(rail.a(w, origin, originData, true, 0), rail.findPoweredRailSignalOptimized(w, origin, originData, true));
+
