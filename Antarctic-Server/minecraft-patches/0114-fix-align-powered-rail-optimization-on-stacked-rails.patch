+        w.set(0, 64, 3, railState(BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH, true));
+        w.set(0, 63, 2, railState(BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH, true));
+        w.set(0, 63, 3, railState(BlockMinecartTrackAbstract.EnumTrackPosition.NORTH_SOUTH, true));
+        w.power(0, 63, 3);
