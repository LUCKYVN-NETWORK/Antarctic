+    @Test
+    public void testRandomizedTenThousandTrackParityIncludingStackedRails() throws Exception {
+        RailTestWorld w = newWorld();
+        Random rng = new Random(0x5A17_1122L);
+        BlockPosition origin = new BlockPosition(0, 64, 0);
+        int trueCount = 0;
+
+        for (int trial = 0; trial < 10_000; ++trial) {
+            w.clear();
+            BlockMinecartTrackAbstract.EnumTrackPosition originShape = VALID_SHAPES[rng.nextInt(VALID_SHAPES.length)];
+            boolean forward = rng.nextBoolean();
+            IBlockData originData = railState(originShape, true);
+            w.set(0, 64, 0, originData);
+
+            boolean ew = originShape == BlockMinecartTrackAbstract.EnumTrackPosition.EAST_WEST
+                    || originShape == BlockMinecartTrackAbstract.EnumTrackPosition.ASCENDING_EAST
+                    || originShape == BlockMinecartTrackAbstract.EnumTrackPosition.ASCENDING_WEST;
+
+            // Populate dense 10x9 vertical slice along the axis (including vertically stacked plugin rails)
+            for (int step = -9; step <= 9; ++step) {
+                if (step == 0) continue;
+                for (int dy = -6; dy <= 4; ++dy) {
+                    if (rng.nextInt(100) < 42) {
+                        int x = ew ? step : 0;
+                        int z = ew ? 0 : step;
+                        BlockMinecartTrackAbstract.EnumTrackPosition s = VALID_SHAPES[rng.nextInt(VALID_SHAPES.length)];
+                        boolean powered = rng.nextInt(100) < 72;
+                        w.set(x, 64 + dy, z, railState(s, powered));
+                        if (rng.nextInt(100) < 25) {
+                            w.power(x, 64 + dy, z);
+                        }
+                    }
+                }
+            }
+
+            boolean vanilla = rail.a(w, origin, originData, forward, 0);
+            boolean optimized = rail.findPoweredRailSignalOptimized(w, origin, originData, forward);
+            if (vanilla) {
+                trueCount++;
+            }
+            Assert.assertEquals("parity mismatch on trial " + trial + " shape=" + originShape + " forward=" + forward, vanilla, optimized);
+        }
+        Assert.assertTrue("random suite must exercise both powered and unpowered outcomes (trueCount=" + trueCount + ")", trueCount > 500 && trueCount < 9500);
+    }
