+
+        double speedup = (double) vanillaNs / (double) Math.max(1L, optNs);
+        System.out.printf("PoweredRailPerf (real WorldServer 8-block flat chain, %d iters): vanilla=%.2f ms (%d KiB), optimized=%.2f ms (%d KiB), speedup=%.2fx (sink=%d)%n",
+            iterations, vanillaNs / 1e6, vanillaAlloc / 1024, optNs / 1e6, optAlloc / 1024, speedup, sink);
+        Assert.assertTrue("optimized powered rail search must be faster than vanilla (speedup=" + speedup + "x)", optNs < vanillaNs);
+        Assert.assertTrue("optimized powered rail search must allocate >= 50x less than vanilla (opt=" + optAlloc + " vs vanilla=" + vanillaAlloc + ")", optAlloc * 50 < vanillaAlloc);
+    }
 }
