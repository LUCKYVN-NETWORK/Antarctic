+    }
+
+    private static TestWorld createWorld(boolean nether) throws Exception {
+        TestWorld world = (TestWorld) unsafe.allocateInstance(TestWorld.class);
+        Field mapField = TestWorld.class.getDeclaredField("map");
+        mapField.setAccessible(true);
+        Long2ObjectOpenHashMap<Chunk> map = new Long2ObjectOpenHashMap<>();
+        mapField.set(world, map);
+
+        Field wpField = World.class.getDeclaredField("worldProvider");
+        wpField.setAccessible(true);
+        wpField.set(world, nether ? new WorldProviderHell() : new WorldProviderNormal());
+
+        for (int cx = 0; cx <= 2; cx++) {
+            for (int cz = 0; cz <= 2; cz++) {
+                Chunk c = (Chunk) unsafe.allocateInstance(Chunk.class);
+                Field wf = Chunk.class.getDeclaredField("world");
+                wf.setAccessible(true);
+                wf.set(c, world);
+                Field lx = Chunk.class.getDeclaredField("locX");
+                lx.setAccessible(true);
+                lx.setInt(c, cx);
+                Field lz = Chunk.class.getDeclaredField("locZ");
+                lz.setAccessible(true);
+                lz.setInt(c, cz);
+                Field sf = Chunk.class.getDeclaredField("sections");
+                sf.setAccessible(true);
+                ChunkSection[] secs = new ChunkSection[16];
+                for (int i = 0; i < 16; i++) {
+                    secs[i] = Chunk.a;
+                }
+                secs[4] = new ChunkSection(64, true);
+                secs[3] = new ChunkSection(48, true);
+                sf.set(c, secs);
+                map.put(ChunkCoordIntPair.a(cx, cz), c);
+            }
+        }
+
+        TestChunkProviderServer cps = (TestChunkProviderServer) unsafe.allocateInstance(TestChunkProviderServer.class);
