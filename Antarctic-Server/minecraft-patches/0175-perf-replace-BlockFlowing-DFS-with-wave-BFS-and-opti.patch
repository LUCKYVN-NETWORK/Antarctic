+    }
+
+    private static void setBlock(TestWorld world, int x, int y, int z, IBlockData data) {
+        Chunk c = world.getChunkIfLoaded(x >> 4, z >> 4);
+        c.getSections()[y >> 4].setType(x & 15, y & 15, z & 15, data);
+    }
+
+    private static boolean vanillaBlocksFlow(IBlockData iblockdata) {
+        Block block = iblockdata.getBlock();
+        return !(block instanceof BlockDoor) && block != Blocks.STANDING_SIGN && block != Blocks.LADDER && block != Blocks.REEDS
+                ? (block.material != Material.PORTAL && block.material != Material.J ? block.material.isSolid() : true)
+                : true;
+    }
+
+    private static int vanillaSlopeDistance(BlockFlowing flowing, World world, BlockPosition.MutableBlockPosition pos, int x, int y, int z, int depth, int limit, EnumDirection from) {
+        int best = 1000;
+        for (int n = 0; n < 4; ++n) {
+            EnumDirection direction = EnumDirection.HORIZONTAL[n];
+            if (direction != from) {
+                int nx = x + direction.getAdjacentX();
+                int nz = z + direction.getAdjacentZ();
+                IBlockData iblockdata = world.getType(pos.c(nx, y, nz));
+                if (!vanillaBlocksFlow(iblockdata) && (iblockdata.getMaterial() != flowing.material || iblockdata.get(BlockFlowing.LEVEL).intValue() > 0)) {
+                    if (!vanillaBlocksFlow(world.getType(pos.c(nx, y - 1, nz)))) {
+                        return depth;
+                    }
+                    if (depth < limit) {
+                        int k = vanillaSlopeDistance(flowing, world, pos, nx, y, nz, depth + 1, limit, direction.opposite());
+                        if (k < best) {
+                            best = k;
+                        }
+                    }
+                }
+            }
+        }
+        return best;
+    }
+
+    private static int vanillaGetFlowDirections(BlockFlowing flowing, World world, BlockPosition blockposition) {
+        int best = 1000;
+        int mask = 0;
+        int limit = flowing.material == Material.LAVA && !world.worldProvider.l() ? 2 : 4;
+        int x = blockposition.getX();
+        int y = blockposition.getY();
+        int z = blockposition.getZ();
+        BlockPosition.MutableBlockPosition pos = new BlockPosition.MutableBlockPosition();
+        for (int n = 0; n < 4; ++n) {
+            EnumDirection direction = EnumDirection.HORIZONTAL[n];
+            int nx = x + direction.getAdjacentX();
+            int nz = z + direction.getAdjacentZ();
+            IBlockData iblockdata = world.getType(pos.c(nx, y, nz));
+            if (!vanillaBlocksFlow(iblockdata) && (iblockdata.getMaterial() != flowing.material || iblockdata.get(BlockFlowing.LEVEL).intValue() > 0)) {
+                int j;
+                if (vanillaBlocksFlow(world.getType(pos.c(nx, y - 1, nz)))) {
+                    j = vanillaSlopeDistance(flowing, world, pos, nx, y, nz, 1, limit, direction.opposite());
+                } else {
+                    j = 0;
+                }
+                if (j < best) {
+                    mask = 0;
+                }
+                if (j <= best) {
+                    mask |= 1 << n;
+                    best = j;
+                }
+            }
+        }
+        return mask;
+    }
+
+    private static void clearArena(TestWorld world, int cx, int cz) {
+        for (int dx = -6; dx <= 6; dx++) {
+            for (int dz = -6; dz <= 6; dz++) {
+                setBlock(world, cx + dx, 64, cz + dz, Blocks.AIR.getBlockData());
+                setBlock(world, cx + dx, 63, cz + dz, Blocks.STONE.getBlockData());
+            }
+        }
+    }
+
+    @Test
+    public void testWaveBfsParity() throws Exception {
+        TestWorld overworld = createWorld(false);
+        TestWorld nether = createWorld(true);
+        BlockFlowing water = (BlockFlowing) Blocks.FLOWING_WATER;
+        BlockFlowing lava = (BlockFlowing) Blocks.FLOWING_LAVA;
+
+        // Test across chunk boundary (15, 64, 16) and interior (20, 64, 20)
+        BlockPosition[] origins = {
+            new BlockPosition(15, 64, 16),
+            new BlockPosition(20, 64, 20)
+        };
+
+        Random rng = new Random(0xC0FFEE1234L);
+        int checks = 0;
+        for (BlockPosition origin : origins) {
+            for (int trial = 0; trial < 120; trial++) {
+                TestWorld w = (trial % 3 == 2) ? nether : overworld;
+                BlockFlowing fluid = (trial % 2 == 0) ? water : lava;
+                clearArena(w, origin.getX(), origin.getZ());
+
+                // Populate random obstacles at y=64 and drops at y=63
+                for (int dx = -5; dx <= 5; dx++) {
+                    for (int dz = -5; dz <= 5; dz++) {
+                        if (dx == 0 && dz == 0) continue;
+                        int r = rng.nextInt(10);
+                        if (r == 0) {
+                            setBlock(w, origin.getX() + dx, 64, origin.getZ() + dz, Blocks.STONE.getBlockData());
+                        } else if (r == 1) {
+                            setBlock(w, origin.getX() + dx, 64, origin.getZ() + dz, Blocks.LADDER.getBlockData());
+                        } else if (r == 2) {
+                            setBlock(w, origin.getX() + dx, 64, origin.getZ() + dz, fluid.getBlockData().set(BlockFlowing.LEVEL, 0));
+                        }
+                        if (rng.nextInt(8) == 0) {
+                            setBlock(w, origin.getX() + dx, 63, origin.getZ() + dz, Blocks.AIR.getBlockData());
+                        }
+                    }
+                }
+
+                int expected = vanillaGetFlowDirections(fluid, w, origin);
+                int actual = fluid.getFlowDirections(w, origin);
+                Assert.assertEquals("Mismatch at trial=" + trial + " origin=" + origin + " fluid=" + fluid, expected, actual);
+                checks++;
+            }
+        }
+        Assert.assertTrue(checks >= 240);
+    }
+
+    @Test
+    public void testWaveBfsBenchmark() throws Exception {
+        TestWorld world = createWorld(false);
+        BlockFlowing water = (BlockFlowing) Blocks.FLOWING_WATER;
+        BlockPosition flatOrigin = new BlockPosition(20, 64, 20);
+        clearArena(world, 20, 20);
+
+        BlockPosition dropOrigin = new BlockPosition(36, 64, 20);
+        clearArena(world, 36, 20);
+        setBlock(world, 36, 63, 19, Blocks.AIR.getBlockData()); // immediate NORTH drop
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        for (int i = 0; i < 3000; i++) {
+            vanillaGetFlowDirections(water, world, flatOrigin);
+            water.getFlowDirections(world, flatOrigin);
+            vanillaGetFlowDirections(water, world, dropOrigin);
+            water.getFlowDirections(world, dropOrigin);
+        }
+        bean.getThreadAllocatedBytes(tid);
+
+        final int iters = 2000;
+        long vAlloc0 = bean.getThreadAllocatedBytes(tid);
+        long vT0 = System.nanoTime();
+        int sink = 0;
+        for (int i = 0; i < iters; i++) {
+            sink += vanillaGetFlowDirections(water, world, flatOrigin);
+            sink += vanillaGetFlowDirections(water, world, dropOrigin);
+        }
+        long vNs = System.nanoTime() - vT0;
+        long vBytes = bean.getThreadAllocatedBytes(tid) - vAlloc0;
+
+        long oAlloc0 = bean.getThreadAllocatedBytes(tid);
+        long oT0 = System.nanoTime();
+        for (int i = 0; i < iters; i++) {
+            sink += water.getFlowDirections(world, flatOrigin);
+            sink += water.getFlowDirections(world, dropOrigin);
+        }
+        long oNs = System.nanoTime() - oT0;
+        long oBytes = bean.getThreadAllocatedBytes(tid) - oAlloc0;
+
+        double speedup = (double) vNs / (double) Math.max(1L, oNs);
+        System.out.println(String.format(
+                "C2_BENCH vanilla_ns=%d opt_ns=%d speedup=%.2fx vanilla_bytes=%d opt_bytes=%d sink=%d",
+                vNs, oNs, speedup, vBytes, oBytes, sink));
+
+        Assert.assertTrue("Wave BFS must allocate <= 64 bytes (ThreadMXBean jitter), got " + oBytes, oBytes <= 64L);
+        Assert.assertTrue("Expected speedup > 3.0x, got " + speedup, speedup > 3.0D);
+    }
