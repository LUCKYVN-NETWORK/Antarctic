+
+    private static final class TestWorld extends World {
+        final Long2ObjectOpenHashMap<Chunk> map = new Long2ObjectOpenHashMap<>();
+
+        TestWorld() {
+            super(null, null, null, null, false, null, null);
+        }
+
+        @Override
+        protected IChunkProvider n() {
+            return null;
+        }
+
+        @Override
+        public Chunk getChunkIfLoaded(int x, int z) {
+            return map.get(ChunkCoordIntPair.a(x, z));
+        }
+
+        @Override
+        public Chunk getChunkAt(int x, int z) {
+            return map.get(ChunkCoordIntPair.a(x, z));
+        }
+
+        @Override
+        public boolean isChunkLoaded(int x, int z, boolean allowEmpty) {
+            return map.containsKey(ChunkCoordIntPair.a(x, z));
+        }
+    }
+
+    private static final class TestChunkProviderServer extends ChunkProviderServer {
+        Long2ObjectOpenHashMap<Chunk> map;
+
+        TestChunkProviderServer() {
+            super(null, null, null);
+        }
+
+        @Override
+        public Chunk getChunkIfLoaded(int x, int z) {
+            return map.get(ChunkCoordIntPair.a(x, z));
+        }
+
+        @Override
+        public Chunk getChunkAt(int x, int z) {
