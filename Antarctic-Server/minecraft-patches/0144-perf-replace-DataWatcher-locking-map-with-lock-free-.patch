+        Assert.assertEquals(Byte.valueOf((byte) 0), watcher.get(flags));
+        Assert.assertEquals(Integer.valueOf(300), watcher.get(air));
+        Assert.assertEquals("Test", watcher.get(name));
+        Assert.assertEquals(20.0F, watcher.get(health), 0.0F);
+        Assert.assertEquals(Boolean.FALSE, watcher.get(highId));
+
+        // Clear dirty via e(), then mutate health & highId
