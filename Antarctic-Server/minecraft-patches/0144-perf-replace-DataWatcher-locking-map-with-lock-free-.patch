+    @Test
+    public void testConcurrentNettySnapshotReadsAreSafe() throws Exception {
+        Entity entity = newStubEntity();
+        DataWatcher watcher = new DataWatcher(entity);
+        DataWatcherObject<Integer> k0 = DataWatcherRegistry.b.a(0);
+        DataWatcherObject<Integer> k1 = DataWatcherRegistry.b.a(1);
+        watcher.register(k0, 0);
