+    @Test
+    public void testLockFreeDenseArrayBenchmarkAndZeroAllocGets() throws Exception {
+        Entity entity = newStubEntity();
+        DataWatcher watcher = new DataWatcher(entity);
+        @SuppressWarnings("unchecked")
+        DataWatcherObject<Integer>[] keys = new DataWatcherObject[12];
+        Map<Integer, DataWatcher.Item<?>> baselineMap = new Int2ObjectOpenHashMap<>();
+        ReentrantReadWriteLock baselineLock = new ReentrantReadWriteLock();
+        for (int i = 0; i < keys.length; ++i) {
+            keys[i] = DataWatcherRegistry.b.a(i);
+            watcher.register(keys[i], i + 1);
+            baselineMap.put(i, new DataWatcher.Item<>(keys[i], i + 1));
+        }
+
+        final int warmup = 200_000;
+        final int iters = 2_000_000;
+        long sink = 0;
+        for (int i = 0; i < warmup; ++i) {
+            DataWatcherObject<Integer> k = keys[i % keys.length];
+            sink += watcher.get(k);
+            baselineLock.readLock().lock();
+            sink += (Integer) baselineMap.get(Integer.valueOf(k.a())).b();
+            baselineLock.readLock().unlock();
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        long t0 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            DataWatcherObject<Integer> k = keys[i % keys.length];
+            baselineLock.readLock().lock();
+            sink += (Integer) baselineMap.get(Integer.valueOf(k.a())).b();
+            baselineLock.readLock().unlock();
+        }
+        long baselineNs = System.nanoTime() - t0;
+
+        long allocBefore = bean.getThreadAllocatedBytes(tid);
+        long t1 = System.nanoTime();
+        for (int i = 0; i < iters; ++i) {
+            DataWatcherObject<Integer> k = keys[i % keys.length];
+            sink += watcher.get(k);
+        }
+        long optimizedNs = System.nanoTime() - t1;
+        long allocBytes = bean.getThreadAllocatedBytes(tid) - allocBefore;
+
+        double speedup = (double) baselineNs / (double) Math.max(1L, optimizedNs);
+        System.out.printf("[perf] DataWatcher.get (%d ops): baseline=%.2f ms vs lock-free=%.2f ms (%.1fx speedup), alloc=%d B (sink=%d)%n",
+                iters, baselineNs / 1e6, optimizedNs / 1e6, speedup, allocBytes, sink);
+
+        Assert.assertEquals("DataWatcher.get must allocate 0 bytes", 0L, allocBytes);
+        Assert.assertTrue("Lock-free dense DataWatcher.get must be >= 2x faster than RWLock+Map baseline (got " + speedup + "x)",
+                optimizedNs * 2L < baselineNs);
+    }
