+                        ByteBuf buf = Unpooled.buffer(128);
+                        try {
+                            PacketDataSerializer ser = new PacketDataSerializer(buf);
+                            for (int i = 0; i < 2000; ++i) {
+                                buf.clear();
+                                watcher.a(ser);
+                                List<DataWatcher.Item<?>> snap = watcher.c();
+                                Assert.assertNotNull(snap);
+                                Assert.assertTrue(snap.size() >= 2);
+                            }
+                        } finally {
+                            buf.release();
+                        }
+                    } catch (Exception e) {
+                        throw new RuntimeException(e);
+                    }
+                });
+            }
+
+            start.countDown();
+            for (int i = 0; i < 4000; ++i) {
