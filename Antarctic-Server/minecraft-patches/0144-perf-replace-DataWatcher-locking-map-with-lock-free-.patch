+        Entity entity = newStubEntity();
+        DataWatcher watcher = new DataWatcher(entity);
+
+        DataWatcherObject<Byte> flags = DataWatcherRegistry.a.a(0);
+        DataWatcherObject<Integer> air = DataWatcherRegistry.b.a(1);
+        DataWatcherObject<String> name = DataWatcherRegistry.d.a(2);
+        DataWatcherObject<Float> health = DataWatcherRegistry.c.a(7);
+        DataWatcherObject<Boolean> highId = DataWatcherRegistry.h.a(42); // forces array growth > 16
+
+        Assert.assertTrue(watcher.d());
+        watcher.register(flags, (byte) 0);
+        watcher.register(air, 300);
+        watcher.register(name, "Test");
+        watcher.register(health, 20.0F);
+        watcher.register(highId, Boolean.FALSE);
+        Assert.assertFalse(watcher.d());
+
+        // Duplicate registration must still throw
+        try {
+            watcher.register(air, 100);
+            Assert.fail("Duplicate ID must throw IllegalArgumentException");
