diff --git a/test/java/net/minecraft/server/SunBurnTickTest.java b/test/java/net/minecraft/server/SunBurnTickTest.java
new file mode 100644
index 0000000..6a77bb3
--- /dev/null
+++ b/test/java/net/minecraft/server/SunBurnTickTest.java
@@ -0,0 +1,44 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.SunBurn;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class SunBurnTickTest {
+
+    @Test
+    public void testSunBurnOptimizationConfigDefault() {
+        Assert.assertTrue("SunBurn.optimizeSunBurnTick should be enabled by default", SunBurn.optimizeSunBurnTick);
+    }
+
+    @Test
+    public void testEyePositionCalculationParity() {
+        double locX = 12.34;
+        double locY = 64.0;
+        double locZ = -56.78;
+        float headHeight = 1.74F;
+
+        double headY = locY + (double) headHeight;
+        BlockPosition expected = new BlockPosition(locX, headY, locZ);
+
+        Assert.assertEquals(MathHelper.floor(locX), expected.getX());
+        Assert.assertEquals(MathHelper.floor(headY), expected.getY());
+        Assert.assertEquals(MathHelper.floor(locZ), expected.getZ());
+    }
+
+    @Test
+    public void testSkeletonPositionCalculationParity() {
+        double locX = -10.5;
+        double locY = 70.2;
+        double locZ = 45.9;
+
+        BlockPosition expectedNormal = new BlockPosition(locX, (double) Math.round(locY), locZ);
+        BlockPosition expectedBoat = expectedNormal.up();
+
+        Assert.assertEquals(MathHelper.floor(locX), expectedNormal.getX());
+        Assert.assertEquals((int) Math.round(locY), expectedNormal.getY());
+        Assert.assertEquals(MathHelper.floor(locZ), expectedNormal.getZ());
+
+        Assert.assertEquals(expectedNormal.getY() + 1, expectedBoat.getY());
+    }
+}
