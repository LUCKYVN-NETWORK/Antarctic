diff --git a/test/java/net/minecraft/server/MinecraftKeyTest.java b/test/java/net/minecraft/server/MinecraftKeyTest.java
new file mode 100644
index 0000000..b079534
--- /dev/null
+++ b/test/java/net/minecraft/server/MinecraftKeyTest.java
@@ -0,0 +1,29 @@
+package net.minecraft.server;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+public class MinecraftKeyTest {
+
+    @Test
+    public void testHashAndToStringEquivalence() {
+        String[] namespaces = { "minecraft", "paper", "antarctic", "custom_mod" };
+        String[] keys = { "stone", "block/dirt", "items/iron_sword", "entity.zombie.hurt" };
+
+        for (String ns : namespaces) {
+            for (String k : keys) {
+                MinecraftKey key = new MinecraftKey(ns, k);
+                int expectedHash = 31 * ns.hashCode() + k.hashCode();
+                String expectedString = ns + ":" + k;
+
+                // First call (computes and caches)
+                Assert.assertEquals("Hash mismatch for " + expectedString, expectedHash, key.hashCode());
+                Assert.assertEquals("String mismatch for " + expectedString, expectedString, key.toString());
+
+                // Second call (hits cache)
+                Assert.assertEquals(expectedHash, key.hashCode());
+                Assert.assertSame("toString should return cached instance", key.toString(), key.toString());
+            }
+        }
+    }
+}
