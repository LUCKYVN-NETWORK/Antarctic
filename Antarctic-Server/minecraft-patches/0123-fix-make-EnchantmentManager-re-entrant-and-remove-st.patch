diff --git a/test/java/net/minecraft/server/EnchantmentManagerReentrancyTest.java b/test/java/net/minecraft/server/EnchantmentManagerReentrancyTest.java
new file mode 100644
index 0000000..d960a18
--- /dev/null
+++ b/test/java/net/minecraft/server/EnchantmentManagerReentrancyTest.java
@@ -0,0 +1,144 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Random;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class EnchantmentManagerReentrancyTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    private static final class StubLiving extends EntityLiving {
+        List<ItemStack> armor = Collections.emptyList();
+        ItemStack mainHand = ItemStack.a;
+        int damageReceived;
+        boolean triggerReentrantThorns;
+
+        StubLiving() {
+            super(null);
+        }
+
+        @Override
+        public Iterable<ItemStack> getArmorItems() {
+            return armor;
+        }
+
+        @Override
+        public Iterable<ItemStack> aQ() {
+            return armor;
+        }
+
+        @Override
+        public ItemStack getEquipment(EnumItemSlot slot) {
+            if (slot == EnumItemSlot.MAINHAND) {
+                return mainHand;
+            }
+            if (slot == EnumItemSlot.CHEST && !armor.isEmpty()) {
+                return armor.get(0);
+            }
+            if (slot == EnumItemSlot.LEGS && armor.size() > 1) {
+                return armor.get(1);
+            }
+            return ItemStack.a;
+        }
+
+        @Override
+        public void setSlot(EnumItemSlot slot, ItemStack stack) {
+        }
+
+        @Override
+        public EnumMainHand getMainHand() {
+            return EnumMainHand.RIGHT;
+        }
+
+        @Override
+        public boolean damageEntity(DamageSource damagesource, float f) {
+            damageReceived++;
+            if (triggerReentrantThorns && damagesource.getEntity() instanceof EntityLiving) {
+                triggerReentrantThorns = false;
+                // Simulate re-entrant Thorns retaliation while outer defender's armor loop is still active
+                EnchantmentManager.a(this, damagesource.getEntity());
+            }
+            return true;
+        }
+    }
+
+    private static StubLiving newStubLiving(Random rng, List<ItemStack> armor) throws Exception {
+        StubLiving entity = (StubLiving) unsafe.allocateInstance(StubLiving.class);
+        entity.random = rng;
+        entity.armor = armor;
+        entity.mainHand = ItemStack.a;
+        return entity;
+    }
+
+    private static ItemStack enchantedItem(Item item, Enchantment ench, int level) {
+        ItemStack stack = new ItemStack(item);
+        stack.addEnchantment(ench, level);
+        return stack;
+    }
+
+    @Test
+    public void testReentrantThornsDoesNotThrowNPE() throws Exception {
+        // Random that always returns 0.0f so Thorns (chance 0.15 * level) always procs
+        Random alwaysProc = new Random() {
+            @Override
+            public float nextFloat() {
+                return 0.0F;
+            }
+
+            @Override
+            public int nextInt(int bound) {
+                return 0;
+            }
+        };
+
+        ItemStack chest = enchantedItem(Items.DIAMOND_CHESTPLATE, Enchantments.THORNS, 3);
+        ItemStack legs = enchantedItem(Items.DIAMOND_LEGGINGS, Enchantments.THORNS, 3);
+        ItemStack attackerChest = enchantedItem(Items.DIAMOND_CHESTPLATE, Enchantments.THORNS, 3);
+
+        StubLiving defender = newStubLiving(alwaysProc, Arrays.asList(chest, legs));
+        StubLiving attacker = newStubLiving(alwaysProc, Collections.singletonList(attackerChest));
+        attacker.triggerReentrantThorns = true;
+
+        // Previously threw NullPointerException on defender's 2nd Thorns armor piece
+        // because re-entrant EnchantmentManager.a(attacker, defender) nulled static c.a/c.b.
+        EnchantmentManager.a(defender, attacker);
+
+        Assert.assertEquals("Attacker must receive Thorns damage from both defender pieces", 2, attacker.damageReceived);
+        Assert.assertEquals("Defender must receive re-entrant Thorns damage from attacker", 1, defender.damageReceived);
+    }
+
+    @Test
+    public void testProtectionDamageAndLevelParity() {
+        ItemStack helm = enchantedItem(Items.DIAMOND_HELMET, Enchantments.PROTECTION_ENVIRONMENTAL, 4);
+        helm.addEnchantment(Enchantments.DURABILITY, 3);
+        ItemStack boots = enchantedItem(Items.DIAMOND_BOOTS, Enchantments.PROTECTION_FALL, 4);
+
+        Assert.assertEquals(4, EnchantmentManager.getEnchantmentLevel(Enchantments.PROTECTION_ENVIRONMENTAL, helm));
+        Assert.assertEquals(3, EnchantmentManager.getEnchantmentLevel(Enchantments.DURABILITY, helm));
+        Assert.assertEquals(0, EnchantmentManager.getEnchantmentLevel(Enchantments.THORNS, helm));
+        Assert.assertEquals(0, EnchantmentManager.getEnchantmentLevel(Enchantments.THORNS, ItemStack.a));
+
+        int fallProt = EnchantmentManager.a(Arrays.asList(helm, boots), DamageSource.FALL);
+        // Prot IV = 4, Feather Falling IV = 12 -> total 16
+        Assert.assertEquals(16, fallProt);
+
+        ItemStack sword = enchantedItem(Items.DIAMOND_SWORD, Enchantments.DAMAGE_UNDEAD, 5);
+        Assert.assertEquals(12.5F, EnchantmentManager.a(sword, EnumMonsterType.UNDEAD), 0.0001F);
+        Assert.assertEquals(0.0F, EnchantmentManager.a(sword, EnumMonsterType.UNDEFINED), 0.0001F);
+    }
+}
