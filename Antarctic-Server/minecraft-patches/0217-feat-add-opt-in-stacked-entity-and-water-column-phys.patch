@@ -0,0 +1,57 @@
+package com.destroystokyo.paper.config.toml.modules.optimizations;
+
+import com.destroystokyo.paper.config.toml.EnumConfigCategory;
+import com.destroystokyo.paper.config.toml.IConfigModule;
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+
+public class EntityPhysicsGuard implements IConfigModule {
+
+    @ConfigInfo(baseName = "enabled", comments = "Opt-in guard against stacked-entity and water-column physics lag machines (e.g., 5k-10k bouncing armor stands). Default false.")
+    public static boolean enabled = false;
+
+    @ConfigInfo(baseName = "slice-check-threshold", comments = "Minimum entities in a 16x16x16 chunk slice before running O(S) cell density detection. Normal slices pay 1 int check. Default 48.")
+    public static int sliceCheckThreshold = 48;
+
+    @ConfigInfo(baseName = "soft-cell-threshold", comments = "Entities in one block cell before overriding EAR water/air immunity and throttling physics ticks. Default 24.")
+    public static int softCellThreshold = 24;
+
+    @ConfigInfo(baseName = "throttled-physics-interval", comments = "Physics tick interval (1 in N ticks) for non-exempt entities in soft-throttled cells. Default 10.")
+    public static int throttledPhysicsInterval = 10;
+
+    @ConfigInfo(baseName = "splash-suppress-threshold", comments = "Cell density at which water splash/bubble particle & sound spam in Entity.ar() is suppressed (0 disables). Default 12.")
+    public static int splashSuppressThreshold = 12;
+
+    @ConfigInfo(baseName = "hard-cell-cull-threshold", comments = "Cell density at which hard-action ('freeze' or 'cull') engages (0 disables). Default 0.")
+    public static int hardCellCullThreshold = 0;
+
+    @ConfigInfo(baseName = "hard-action", comments = "Action when hard-cell-cull-threshold is exceeded: 'freeze' (skip physics) or 'cull' (die excess entities). Default 'freeze'.")
+    public static String hardAction = "freeze";
+
+    @ConfigInfo(baseName = "exempt-plugin-metadata", comments = "Exempt entities with Bukkit plugin metadata (Entity#setMetadata) from throttling and culling. Default true.")
+    public static boolean exemptPluginMetadata = true;
+
+    @Override
+    public void onLoaded(CommentedFileConfig config) {
+        sliceCheckThreshold = Math.max(1, sliceCheckThreshold);
+        softCellThreshold = Math.max(1, softCellThreshold);
+        throttledPhysicsInterval = Math.max(1, throttledPhysicsInterval);
+        splashSuppressThreshold = Math.max(0, splashSuppressThreshold);
+        hardCellCullThreshold = Math.max(0, hardCellCullThreshold);
+        if (!"cull".equalsIgnoreCase(hardAction)) {
+            hardAction = "freeze";
+        } else {
+            hardAction = "cull";
+        }
+    }
+
+    @Override
+    public EnumConfigCategory getCategory() {
+        return EnumConfigCategory.OPTIMIZATIONS;
+    }
+
+    @Override
+    public String getBaseName() {
+        return "entity-physics-guard";
+    }
+}
diff --git a/main/java/me/stella/antarctic/spatial/CellDensityScratch.java b/main/java/me/stella/antarctic/spatial/CellDensityScratch.java
new file mode 100644
index 0000000..89a9b42
--- /dev/null
+++ b/main/java/me/stella/antarctic/spatial/CellDensityScratch.java
@@ -0,0 +1,62 @@
+package me.stella.antarctic.spatial;
+
+/**
+ * Reusable zero-allocation per-slice spatial density histogram (16x16x16 = 4096 cells).
+ * Clears only touched indices on reset() so O(S) slice scans pay zero allocation and zero full-array clear cost.
+ */
+public final class CellDensityScratch {
+
+    public static final int CELL_COUNT = 4096;
+
+    private final short[] totalCounts = new short[CELL_COUNT];
+    private final short[] fluidOrAirCounts = new short[CELL_COUNT];
+    private final int[] touchedIndices = new int[CELL_COUNT];
+    private int touchedCount;
+
+    public static int packIndex(int localX, int localY, int localZ) {
+        return ((localY & 15) << 8) | ((localZ & 15) << 4) | (localX & 15);
+    }
+
+    public void record(int idx, boolean inWaterOrAirborne) {
+        short prev = this.totalCounts[idx];
+        if (prev == 0) {
+            this.touchedIndices[this.touchedCount++] = idx;
+        }
+        if (prev < Short.MAX_VALUE) {
+            this.totalCounts[idx] = (short) (prev + 1);
+        }
+        if (inWaterOrAirborne) {
+            short prevFluid = this.fluidOrAirCounts[idx];
+            if (prevFluid < Short.MAX_VALUE) {
+                this.fluidOrAirCounts[idx] = (short) (prevFluid + 1);
+            }
+        }
+    }
+
+    public short getTotalCount(int idx) {
+        return this.totalCounts[idx];
+    }
+
+    public void decrementTotal(int idx) {
+        if (this.totalCounts[idx] > 0) {
+            this.totalCounts[idx]--;
+        }
+    }
+
+    public short getFluidOrAirCount(int idx) {
+        return this.fluidOrAirCounts[idx];
+    }
+
+    public int getTouchedCount() {
+        return this.touchedCount;
+    }
+
+    public void reset() {
+        for (int i = 0; i < this.touchedCount; ++i) {
+            int idx = this.touchedIndices[i];
+            this.totalCounts[idx] = 0;
+            this.fluidOrAirCounts[idx] = 0;
+        }
+        this.touchedCount = 0;
+    }
+}
diff --git a/main/java/net/minecraft/server/Chunk.java b/main/java/net/minecraft/server/Chunk.java
index 4e3d9b2..aa8460d 100644
--- a/main/java/net/minecraft/server/Chunk.java
+++ b/main/java/net/minecraft/server/Chunk.java
@@ -1049,6 +1049,89 @@ public class Chunk {
         return false;
     }
 
+    private static final ThreadLocal<me.stella.antarctic.spatial.CellDensityScratch> PHYSICS_SCRATCH =
+            ThreadLocal.withInitial(me.stella.antarctic.spatial.CellDensityScratch::new);
+    private final int[] antarcticPhysicsGuardStamp = new int[16];
+    private static int antarcticLastPhysicsWarnTick = Integer.MIN_VALUE;
+
+    int scanDenseSliceIfNeeded(int sliceY, int currentTick) {
+        if (!com.destroystokyo.paper.config.toml.modules.optimizations.EntityPhysicsGuard.enabled
+                || sliceY < 0 || sliceY >= 16
+                || this.antarcticPhysicsGuardStamp == null
+                || this.antarcticPhysicsGuardStamp[sliceY] == currentTick) {
+            return 0;
+        }
+        List<Entity> slice = this.entitySlices[sliceY];
+        int size = slice.size();
+        if (size < com.destroystokyo.paper.config.toml.modules.optimizations.EntityPhysicsGuard.sliceCheckThreshold) {
+            return 0;
+        }
+        this.antarcticPhysicsGuardStamp[sliceY] = currentTick;
+        me.stella.antarctic.spatial.CellDensityScratch scratch = PHYSICS_SCRATCH.get();
+        int culled = 0;
+        int maxCellSeen = 0;
+        int warnX = 0, warnY = 0, warnZ = 0;
+        try {
+            for (int i = 0; i < size; ++i) {
+                Entity e = slice.get(i);
+                if (e.dead || e.isPhysicsGuardExempt()) {
+                    continue;
+                }
+                int idx = me.stella.antarctic.spatial.CellDensityScratch.packIndex(
+                        MathHelper.floor(e.locX), MathHelper.floor(e.locY), MathHelper.floor(e.locZ));
+                scratch.record(idx, e.inWater || !e.onGround);
+            }
+            final int hardThreshold = com.destroystokyo.paper.config.toml.modules.optimizations.EntityPhysicsGuard.hardCellCullThreshold;
+            final boolean doCull = hardThreshold > 0
+                    && "cull".equalsIgnoreCase(com.destroystokyo.paper.config.toml.modules.optimizations.EntityPhysicsGuard.hardAction);
+            for (int i = 0; i < size; ++i) {
+                Entity e = slice.get(i);
+                if (e.dead || e.isPhysicsGuardExempt()) {
+                    continue;
+                }
+                int idx = me.stella.antarctic.spatial.CellDensityScratch.packIndex(
+                        MathHelper.floor(e.locX), MathHelper.floor(e.locY), MathHelper.floor(e.locZ));
+                short density = scratch.getTotalCount(idx);
+                e.antarcticCellDensity = density;
+                e.antarcticCellDensityStamp = currentTick;
+                if (density > maxCellSeen) {
+                    maxCellSeen = density;
+                    warnX = MathHelper.floor(e.locX);
+                    warnY = MathHelper.floor(e.locY);
+                    warnZ = MathHelper.floor(e.locZ);
+                }
+            }
+            if (doCull && maxCellSeen > hardThreshold) {
+                for (int i = slice.size() - 1; i >= 0; --i) {
+                    Entity e = slice.get(i);
+                    if (e.dead || e.isPhysicsGuardExempt()) {
+                        continue;
+                    }
+                    if (!(e instanceof EntityArmorStand || e instanceof EntityBoat || e instanceof EntityMinecartAbstract
+                            || e instanceof EntityFallingBlock || e instanceof EntityItem || e instanceof EntityInsentient)) {
+                        continue;
+                    }
+                    int idx = me.stella.antarctic.spatial.CellDensityScratch.packIndex(
+                            MathHelper.floor(e.locX), MathHelper.floor(e.locY), MathHelper.floor(e.locZ));
+                    short cur = scratch.getTotalCount(idx);
+                    if (cur > hardThreshold) {
+                        e.die();
+                        culled++;
+                        scratch.decrementTotal(idx);
+                    }
+                }
+                if (culled > 0 && currentTick - antarcticLastPhysicsWarnTick >= 100) {
+                    antarcticLastPhysicsWarnTick = currentTick;
+                    Chunk.e.warn("[Antarctic PhysicsGuard] Culled {} stacked entities at ({}, {}, {}) in world '{}'",
+                            culled, warnX, warnY, warnZ, this.world.getWorldData().getName());
+                }
+            }
+        } finally {
+            scratch.reset();
+        }
+        return culled;
+    }
+
     public boolean c(BlockPosition blockposition) {
         int i = blockposition.getX() & 15;
         int j = blockposition.getY();
