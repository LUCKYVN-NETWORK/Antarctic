+    @Test
+    public void testHologramMetadataAndPlayerExemptions() throws Exception {
+        TrackingWorld world = createWorld();
+        Chunk chunk = createChunk(world);
+        EntityPhysicsGuard.enabled = true;
+        EntityPhysicsGuard.sliceCheckThreshold = 10;
+        EntityPhysicsGuard.softCellThreshold = 5;
+        EntityPhysicsGuard.hardCellCullThreshold = 5;
+        EntityPhysicsGuard.hardAction = "cull";
+        EntityPhysicsGuard.exemptPluginMetadata = true;
+
+        EntityArmorStand marker = new EntityArmorStand(world, 8.0D, 64.0D, 8.0D);
+        marker.setMarker(true);
+        EntityArmorStand noGravity = new EntityArmorStand(world, 8.0D, 64.0D, 8.0D);
+        noGravity.setNoGravity(true);
+        EntityArmorStand named = new EntityArmorStand(world, 8.0D, 64.0D, 8.0D);
+        named.setCustomName("Hologram");
+        EntityArmorStand metadataStand = new EntityArmorStand(world, 8.0D, 64.0D, 8.0D);
+        metadataStand.antarcticHasBukkitMetadata = true;
+        EntityBoat playerBoat = new EntityBoat(world, 8.0D, 64.0D, 8.0D);
+        EntityPlayer passenger = (EntityPlayer) UNSAFE.allocateInstance(EntityPlayer.class);
+        playerBoat.passengers.add(passenger);
+
+        chunk.a(marker);
+        chunk.a(noGravity);
+        chunk.a(named);
+        chunk.a(metadataStand);
+        chunk.a(playerBoat);
+
+        // Add 20 non-exempt normal armor stands to trigger hard cull at 5
+        for (int i = 0; i < 20; i++) {
