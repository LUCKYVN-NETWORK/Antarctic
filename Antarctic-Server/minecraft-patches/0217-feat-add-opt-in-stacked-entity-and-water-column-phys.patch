+    @Test
+    public void test5000WaterColumnArmorStandsGuardAndPerf() throws Exception {
+        TrackingWorld world = createWorld();
+        Chunk chunk = createChunk(world);
+        EntityPhysicsGuard.enabled = true;
+        EntityPhysicsGuard.sliceCheckThreshold = 48;
+        EntityPhysicsGuard.softCellThreshold = 24;
+        EntityPhysicsGuard.throttledPhysicsInterval = 10;
+        EntityPhysicsGuard.splashSuppressThreshold = 12;
+        EntityPhysicsGuard.hardCellCullThreshold = 0;
+
+        // Sparse slice short-circuit (< 48)
+        for (int i = 0; i < 10; i++) {
+            chunk.a(new EntityArmorStand(world, 8.0D, 32.0D, 8.0D));
+        }
+        assertEquals(0, chunk.scanDenseSliceIfNeeded(2, 1));
+
+        // 5,000 bouncing water-column armor stands in 1 cell (slice 4)
+        EntityArmorStand[] stands = new EntityArmorStand[5_000];
+        for (int i = 0; i < stands.length; i++) {
+            stands[i] = new EntityArmorStand(world, 8.5D, 64.5D, 8.5D);
+            stands[i].inWater = true;
+            stands[i].onGround = false;
+            chunk.a(stands[i]);
+        }
+
+        long start = System.nanoTime();
+        chunk.scanDenseSliceIfNeeded(4, 200);
+        long scanMs = (System.nanoTime() - start) / 1_000_000L;
+        assertTrue("5k cell scan took too long: " + scanMs + " ms", scanMs < 30L);
+
+        // ActivationRange water/air immunity overridden
+        MinecraftServer.currentTick = 200;
+        assertFalse("Dense water-column entity must lose EAR water/air immunity",
+                org.spigotmc.ActivationRange.checkEntityImmunities(stands[0]));
+        assertTrue(stands[0].isPhysicsGuardThrottled(200));
+
+        // Splash particle spam suppressed in ar()
+        world.particleCalls = 0;
+        stands[0].ar();
+        assertEquals("Splash particle spam must be suppressed in dense cell", 0, world.particleCalls);
+    }
