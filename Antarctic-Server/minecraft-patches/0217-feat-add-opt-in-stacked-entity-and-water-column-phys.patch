+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.EntityPhysicsGuard;
+import me.stella.antarctic.spatial.CellDensityScratch;
+import org.junit.After;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class EntityPhysicsGuardTest {
+
+    private static Unsafe UNSAFE;
+    private static boolean defEnabled;
+    private static int defSliceThresh;
+    private static int defSoftCellThresh;
+    private static int defInterval;
+    private static int defSplashThresh;
+    private static int defHardThresh;
+    private static String defHardAction;
+    private static boolean defExemptMeta;
+
+    @BeforeClass
+    public static void setupTest() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+        defEnabled = EntityPhysicsGuard.enabled;
+        defSliceThresh = EntityPhysicsGuard.sliceCheckThreshold;
+        defSoftCellThresh = EntityPhysicsGuard.softCellThreshold;
+        defInterval = EntityPhysicsGuard.throttledPhysicsInterval;
+        defSplashThresh = EntityPhysicsGuard.splashSuppressThreshold;
+        defHardThresh = EntityPhysicsGuard.hardCellCullThreshold;
+        defHardAction = EntityPhysicsGuard.hardAction;
+        defExemptMeta = EntityPhysicsGuard.exemptPluginMetadata;
+    }
+
+    @After
+    public void restoreConfig() {
+        EntityPhysicsGuard.enabled = defEnabled;
+        EntityPhysicsGuard.sliceCheckThreshold = defSliceThresh;
+        EntityPhysicsGuard.softCellThreshold = defSoftCellThresh;
+        EntityPhysicsGuard.throttledPhysicsInterval = defInterval;
+        EntityPhysicsGuard.splashSuppressThreshold = defSplashThresh;
+        EntityPhysicsGuard.hardCellCullThreshold = defHardThresh;
+        EntityPhysicsGuard.hardAction = defHardAction;
+        EntityPhysicsGuard.exemptPluginMetadata = defExemptMeta;
+    }
+
+    private static final class TrackingWorld extends WorldServer {
+        int particleCalls = 0;
+
+        TrackingWorld() {
+            super(null, null, null, 0, null, null, null);
+        }
+
+        @Override
+        public boolean isMainThread() {
+            return true;
+        }
+
+        @Override
+        public void addParticle(EnumParticle enumparticle, double d0, double d1, double d2, double d3, double d4, double d5, int... aint) {
+            particleCalls++;
+        }
+    }
+
+    private static TrackingWorld createWorld() throws Exception {
+        TrackingWorld world = (TrackingWorld) UNSAFE.allocateInstance(TrackingWorld.class);
+        Field csField = World.class.getDeclaredField("isClientSide");
+        csField.setAccessible(true);
+        csField.setBoolean(world, true);
+        world.worldData = new WorldData();
+        world.worldProvider = new WorldProviderNormal();
+        Field mpField = World.class.getDeclaredField("methodProfiler");
+        mpField.setAccessible(true);
+        mpField.set(world, new MethodProfiler());
+        Field randomField = World.class.getDeclaredField("random");
+        randomField.setAccessible(true);
+        randomField.set(world, new java.util.Random(1L));
+        Field spigotField = World.class.getDeclaredField("spigotConfig");
+        spigotField.setAccessible(true);
+        spigotField.set(world, UNSAFE.allocateInstance(org.spigotmc.SpigotWorldConfig.class));
+        Field paperField = World.class.getDeclaredField("paperConfig");
+        paperField.setAccessible(true);
+        paperField.set(world, UNSAFE.allocateInstance(com.destroystokyo.paper.PaperWorldConfig.class));
+        return world;
+    }
+
+    private static Chunk createChunk(TrackingWorld world) throws Exception {
+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        Field worldField = Chunk.class.getDeclaredField("world");
+        worldField.setAccessible(true);
+        worldField.set(chunk, world);
+        Field slicesField = Chunk.class.getDeclaredField("entitySlices");
+        slicesField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        List<Entity>[] slices = new List[16];
+        for (int i = 0; i < 16; i++) {
+            slices[i] = new ArrayList<>();
+        }
+        slicesField.set(chunk, slices);
+        Field ecField = Chunk.class.getDeclaredField("entityCounts");
+        ecField.setAccessible(true);
+        ecField.set(chunk, new co.aikar.util.Counter<String>());
+        Field icField = Chunk.class.getDeclaredField("itemCounts");
+        icField.setAccessible(true);
+        icField.set(chunk, new int[16]);
+        Field iecField = Chunk.class.getDeclaredField("inventoryEntityCounts");
+        iecField.setAccessible(true);
+        iecField.set(chunk, new int[16]);
+        Field ifcField = Chunk.class.getDeclaredField("itemFrameCounts");
+        ifcField.setAccessible(true);
+        ifcField.set(chunk, new int[16]);
+        Field hccField = Chunk.class.getDeclaredField("hardCollidableCounts");
+        hccField.setAccessible(true);
+        hccField.set(chunk, new int[16]);
+        Field sCountsField = Chunk.class.getDeclaredField("antarcticInsentientSliceCounts");
+        sCountsField.setAccessible(true);
+        sCountsField.set(chunk, new int[16]);
+        Field sCulledField = Chunk.class.getDeclaredField("antarcticSliceAiCulled");
+        sCulledField.setAccessible(true);
+        sCulledField.set(chunk, new boolean[16]);
+        Field accField = Chunk.class.getDeclaredField("antarcticCreatureCounts");
+        accField.setAccessible(true);
+        accField.set(chunk, new int[EnumCreatureType.values().length]);
+        Field eCountField = Chunk.class.getDeclaredField("entityCount");
+        eCountField.setAccessible(true);
+        eCountField.set(chunk, new gnu.trove.map.hash.TObjectIntHashMap<>());
+        Field pStampField = Chunk.class.getDeclaredField("antarcticPhysicsGuardStamp");
+        pStampField.setAccessible(true);
+        pStampField.set(chunk, new int[16]);
+        return chunk;
+    }
