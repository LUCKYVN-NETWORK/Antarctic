+        assertFalse(marker.dead);
+        assertFalse(noGravity.dead);
+        assertFalse(named.dead);
+        assertFalse(metadataStand.dead);
+        assertFalse(playerBoat.dead);
+        assertFalse(marker.isPhysicsGuardThrottled(100));
+        assertFalse(metadataStand.isPhysicsGuardThrottled(100));
+    }
