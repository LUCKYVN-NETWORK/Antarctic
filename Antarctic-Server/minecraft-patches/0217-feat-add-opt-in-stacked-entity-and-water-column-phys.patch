+    @Test
+    public void testCellDensityScratchAndReset() {
+        CellDensityScratch scratch = new CellDensityScratch();
+        int idxA = CellDensityScratch.packIndex(3, 4, 5);
+        int idxB = CellDensityScratch.packIndex(15, 15, 15);
+        scratch.record(idxA, true);
+        scratch.record(idxA, false);
+        scratch.record(idxB, true);
+        assertEquals(2, scratch.getTotalCount(idxA));
+        assertEquals(1, scratch.getFluidOrAirCount(idxA));
+        assertEquals(1, scratch.getTotalCount(idxB));
+        assertEquals(2, scratch.getTouchedCount());
+
+        scratch.decrementTotal(idxA);
+        assertEquals(1, scratch.getTotalCount(idxA));
+
+        scratch.reset();
+        assertEquals(0, scratch.getTotalCount(idxA));
+        assertEquals(0, scratch.getFluidOrAirCount(idxA));
+        assertEquals(0, scratch.getTotalCount(idxB));
+        assertEquals(0, scratch.getTouchedCount());
+    }
