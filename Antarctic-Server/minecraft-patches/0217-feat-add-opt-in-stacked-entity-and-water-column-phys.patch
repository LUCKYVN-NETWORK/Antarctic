+        if (this.isVehicle()) {
+            for (int i = 0, len = this.passengers.size(); i < len; ++i) {
+                if (this.passengers.get(i) instanceof EntityHuman) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    public boolean isPhysicsGuardThrottled(int currentTick) {
+        if (!com.destroystokyo.paper.config.toml.modules.optimizations.EntityPhysicsGuard.enabled
+                || this.antarcticCellDensityStamp != currentTick
+                || this.isPhysicsGuardExempt()) {
+            return false;
+        }
+        return this.antarcticCellDensity >= com.destroystokyo.paper.config.toml.modules.optimizations.EntityPhysicsGuard.softCellThreshold;
+    }
