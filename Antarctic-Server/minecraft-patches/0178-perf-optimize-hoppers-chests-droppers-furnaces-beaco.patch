+    private static ItemStack vanillaGetResult(RecipesFurnace rf, ItemStack stack) {
+        boolean vanilla = false;
+        Iterator<Map.Entry<ItemStack, ItemStack>> it = rf.customRecipes.entrySet().iterator();
+        while (true) {
+            if (!it.hasNext()) {
+                if (!vanilla && !rf.recipes.isEmpty()) {
+                    it = rf.recipes.entrySet().iterator();
+                    vanilla = true;
+                } else {
+                    return ItemStack.a;
+                }
+            }
+            Map.Entry<ItemStack, ItemStack> e = it.next();
+            ItemStack key = e.getKey();
+            if (key.getItem() == stack.getItem() && (key.getData() == 32767 || key.getData() == stack.getData())) {
+                return e.getValue();
+            }
+        }
+    }
