+        Assert.assertEquals(5.0F, rf.b(ironOre), 0.0001F);
+
+        // Iterator remove() coherence
+        Iterator<ItemStack> it = rf.customRecipes.keySet().iterator();
+        while (it.hasNext()) {
+            if (it.next().getItem() == Item.getItemOf(Blocks.IRON_ORE)) {
+                it.remove();
+            }
+        }
+        Assert.assertEquals(Items.IRON_INGOT, rf.getResult(ironOre).getItem());
+
+        // clearRecipes coherence
+        rf.recipes.clear();
+        rf.customRecipes.clear();
