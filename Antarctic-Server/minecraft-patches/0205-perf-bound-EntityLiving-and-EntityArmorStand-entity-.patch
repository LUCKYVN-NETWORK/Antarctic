+
+import static org.junit.Assert.*;
+
+public class EntityPushBoundParityTest {
+
+    private static Unsafe UNSAFE;
+    private static int nextEntityId = 10000;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+    }
+
+    private static final class TestWorld extends World {
+        final Chunk chunk;
+
+        TestWorld(Chunk chunk) {
+            super(null, new WorldData(), new WorldProviderNormal(), new MethodProfiler(), false, null, null);
+            this.chunk = chunk;
+        }
+
+        @Override
+        protected IChunkProvider n() {
+            return null;
+        }
+
+        @Override
+        protected boolean isChunkLoaded(int i, int j, boolean flag) {
+            return i == 0 && j == 0;
+        }
+
+        @Override
+        public Chunk getChunkIfLoaded(int i, int j) {
+            return (i == 0 && j == 0) ? this.chunk : null;
+        }
+    }
+
+    private static TestWorld createTestWorld() throws Exception {
+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        Field secField = Chunk.class.getDeclaredField("sections");
+        secField.setAccessible(true);
+        ChunkSection[] sections = new ChunkSection[16];
+        for (int s = 0; s < 16; ++s) {
+            sections[s] = new ChunkSection(s << 4, true);
+        }
+        secField.set(chunk, sections);
+
+        Field slicesField = Chunk.class.getDeclaredField("entitySlices");
+        slicesField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        List<Entity>[] slices = new List[16];
+        for (int s = 0; s < 16; ++s) {
+            slices[s] = new ArrayList<>();
+        }
+        slicesField.set(chunk, slices);
+
+        for (String fn : new String[]{"hardCollidableCounts", "itemCounts", "inventoryEntityCounts", "itemFrameCounts"}) {
+            Field f = Chunk.class.getDeclaredField(fn);
+            f.setAccessible(true);
+            f.set(chunk, new int[16]);
+        }
+        Field ec = Chunk.class.getDeclaredField("entityCounts");
+        ec.setAccessible(true);
+        ec.set(chunk, new co.aikar.util.Counter<String>());
+        Field ect = Chunk.class.getDeclaredField("entityCount");
+        ect.setAccessible(true);
+        ect.set(chunk, new gnu.trove.map.hash.TObjectIntHashMap<Class>());
+        Field acc = Chunk.class.getDeclaredField("antarcticCreatureCounts");
+        acc.setAccessible(true);
+        acc.set(chunk, new int[EnumCreatureType.values().length]);
+
+        TestWorld world = (TestWorld) UNSAFE.allocateInstance(TestWorld.class);
+        Field cf = TestWorld.class.getDeclaredField("chunk");
+        cf.setAccessible(true);
+        cf.set(world, chunk);
+        Field wc = Chunk.class.getDeclaredField("world");
+        wc.setAccessible(true);
+        wc.set(chunk, world);
+        Field pwc = World.class.getDeclaredField("paperConfig");
+        pwc.setAccessible(true);
+        PaperWorldConfig config = (PaperWorldConfig) UNSAFE.allocateInstance(PaperWorldConfig.class);
+        config.maxCollisionsPerEntity = 8;
+        pwc.set(world, config);
+        Field cpField = World.class.getDeclaredField("chunkProvider");
+        cpField.setAccessible(true);
+        cpField.set(world, new IChunkProvider() {
+            @Override public Chunk getLoadedChunkAt(int i, int j) { return (i == 0 && j == 0) ? chunk : null; }
+            @Override public Chunk getChunkAt(int i, int j) { return (i == 0 && j == 0) ? chunk : null; }
+            @Override public boolean unloadChunks() { return false; }
+            @Override public String getName() { return "TestChunkProvider"; }
+            @Override public boolean e(int i, int j) { return i == 0 && j == 0; }
+        });
+        return world;
+    }
+
+    private static EntityZombie createMob(World world, double x, double y, double z, boolean passenger) throws Exception {
+        EntityZombie e = (EntityZombie) UNSAFE.allocateInstance(EntityZombie.class);
+        e.h(nextEntityId++);
+        e.world = world;
+        e.locX = x;
+        e.locY = y;
+        e.locZ = z;
+        e.a(new AxisAlignedBB(x - 0.3, y, z - 0.3, x + 0.3, y + 1.95, z + 0.3));
+        DataWatcher dw = new DataWatcher(e);
+        dw.register(EntityLiving.HEALTH, 20.0F);
+        Field dwField = Entity.class.getDeclaredField("datawatcher");
+        dwField.setAccessible(true);
+        dwField.set(e, dw);
+        e.collides = true;
+        if (passenger) {
+            Field vehicleField = Entity.class.getDeclaredField("au");
+            vehicleField.setAccessible(true);
+            vehicleField.set(e, createDummyStand(world, x, y, z));
+        }
+        return e;
+    }
+
+    private static EntityArmorStand createDummyStand(World world, double x, double y, double z) throws Exception {
+        EntityArmorStand stand = (EntityArmorStand) UNSAFE.allocateInstance(EntityArmorStand.class);
+        stand.h(nextEntityId++);
+        stand.world = world;
+        stand.locX = x;
+        stand.locY = y;
+        stand.locZ = z;
+        stand.a(new AxisAlignedBB(x - 0.25, y, z - 0.25, x + 0.25, y + 1.975, z + 0.25));
+        return stand;
+    }
+
+    private static EntityMinecartRideable createMinecart(World world, double x, double y, double z) throws Exception {
+        EntityMinecartRideable cart = (EntityMinecartRideable) UNSAFE.allocateInstance(EntityMinecartRideable.class);
+        cart.h(nextEntityId++);
+        cart.world = world;
+        cart.locX = x;
+        cart.locY = y;
+        cart.locZ = z;
+        cart.a(new AxisAlignedBB(x - 0.49, y, z - 0.49, x + 0.49, y + 0.7, z + 0.49));
+        return cart;
+    }
+
+    @Test
+    public void testBoundedPushParityAndPassengerExclusion() throws Exception {
+        TestWorld world = createTestWorld();
+        EntityZombie self = createMob(world, 8.0, 64.0, 8.0, false);
+        world.chunk.a(self);
+
+        List<Entity> expectedAll = new ArrayList<>();
+        for (int i = 0; i < 24; i++) {
+            EntityZombie passenger = createMob(world, 8.0, 64.0, 8.0, true);
+            world.chunk.a(passenger);
+            expectedAll.add(passenger);
+        }
+
+        List<Entity> bounded = new ArrayList<>();
+        int[] counts = new int[2];
+        world.collectPushableEntities(self, self.getBoundingBox(), null, ScoreboardTeamBase.EnumTeamPush.ALWAYS, bounded, 8, 24, counts);
+
+        assertEquals(8, bounded.size());
+        assertEquals(expectedAll.subList(0, 8), bounded);
+        assertEquals(24, counts[0]);
+        assertEquals(0, counts[1]);
+
+        // Add 24 non-passenger mobs: cramming threshold (counts[1] >= 24) must trigger cleanly
+        for (int i = 0; i < 24; i++) {
+            EntityZombie standing = createMob(world, 8.0, 64.0, 8.0, false);
+            world.chunk.a(standing);
+        }
+        bounded.clear();
+        counts[0] = 0;
+        counts[1] = 0;
+        world.collectPushableEntities(self, self.getBoundingBox(), null, ScoreboardTeamBase.EnumTeamPush.ALWAYS, bounded, 8, 24, counts);
+        assertEquals(8, bounded.size());
+        assertEquals(24, counts[1]);
+    }
+
+    @Test
+    public void testHardCollidableBoundsAndArmorStandSkip() throws Exception {
+        TestWorld world = createTestWorld();
+        for (int i = 0; i < 500; i++) {
+            world.chunk.a(createDummyStand(world, 8.0, 64.0, 8.0));
+        }
+
+        AxisAlignedBB probeBox = new AxisAlignedBB(7.75, 64.0, 7.75, 8.25, 65.975, 8.25);
+        assertFalse(world.hasAnyHardCollidableInBounds(probeBox));
+
+        EntityMinecartRideable cart = createMinecart(world, 8.0, 64.0, 8.0);
+        world.chunk.a(cart);
+        assertTrue(world.hasAnyHardCollidableInBounds(probeBox));
+
+        world.chunk.b(cart);
+        assertFalse(world.hasAnyHardCollidableInBounds(probeBox));
+    }
+
+    @Test
+    public void testBoundedPushAndArmorStandPerformance() throws Exception {
+        TestWorld world = createTestWorld();
+        EntityZombie self = createMob(world, 8.0, 64.0, 8.0, false);
+        world.chunk.a(self);
+        for (int i = 0; i < 1000; i++) {
+            world.chunk.a(createMob(world, 8.0, 64.0, 8.0, false));
+        }
+
+        List<Entity> out = new ArrayList<>(16);
+        int[] counts = new int[2];
+
+        // Warmup
+        for (int i = 0; i < 500; i++) {
+            out.clear();
+            counts[0] = 0;
+            counts[1] = 0;
+            world.collectPushableEntities(self, self.getBoundingBox(), null, ScoreboardTeamBase.EnumTeamPush.ALWAYS, out, 8, 24, counts);
+            out.clear();
+            world.collectPushableEntities(self, self.getBoundingBox(), null, ScoreboardTeamBase.EnumTeamPush.ALWAYS, out);
+        }
+
+        long t0 = System.nanoTime();
+        for (int i = 0; i < 2000; i++) {
+            out.clear();
+            counts[0] = 0;
+            counts[1] = 0;
+            world.collectPushableEntities(self, self.getBoundingBox(), null, ScoreboardTeamBase.EnumTeamPush.ALWAYS, out, 8, 24, counts);
+            assertEquals(8, out.size());
+        }
+        long boundedNs = System.nanoTime() - t0;
+
+        long t1 = System.nanoTime();
+        for (int i = 0; i < 2000; i++) {
+            out.clear();
+            world.collectPushableEntities(self, self.getBoundingBox(), null, ScoreboardTeamBase.EnumTeamPush.ALWAYS, out);
+        }
+        long unboundedNs = System.nanoTime() - t1;
+
+        // Armor stand skip benchmark on 2,000 stands
+        TestWorld standWorld = createTestWorld();
+        for (int i = 0; i < 2000; i++) {
+            standWorld.chunk.a(createDummyStand(standWorld, 8.0, 64.0, 8.0));
+        }
+        Field bxField = EntityArmorStand.class.getDeclaredField("bx");
+        bxField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        com.google.common.base.Predicate<? super Entity> minecartPred = (com.google.common.base.Predicate<? super Entity>) bxField.get(null);
+        AxisAlignedBB standBb = new AxisAlignedBB(7.75, 64.0, 7.75, 8.25, 65.975, 8.25);
+        for (int i = 0; i < 500; i++) {
+            standWorld.hasAnyHardCollidableInBounds(standBb);
+            standWorld.getEntities(null, standBb, minecartPred);
+        }
+
+        long s0 = System.nanoTime();
+        for (int i = 0; i < 2000; i++) {
+            assertFalse(standWorld.hasAnyHardCollidableInBounds(standBb));
+        }
+        long standFastNs = System.nanoTime() - s0;
+
+        long s1 = System.nanoTime();
+        for (int i = 0; i < 2000; i++) {
+            standWorld.getEntities(null, standBb, minecartPred);
+        }
+        long standScanNs = System.nanoTime() - s1;
+
+        double pushSpeedup = (double) unboundedNs / Math.max(1L, boundedNs);
+        double standSpeedup = (double) standScanNs / Math.max(1L, standFastNs);
+        System.out.printf("[A1 Perf] Push bounded=%d us vs unbounded=%d us (%.1fx) | ArmorStand skip=%d us vs scan=%d us (%.1fx)%n",
+                boundedNs / 1000L, unboundedNs / 1000L, pushSpeedup,
+                standFastNs / 1000L, standScanNs / 1000L, standSpeedup);
+
+        assertTrue("Expected >= 3x push speedup, got " + pushSpeedup, pushSpeedup >= 3.0);
+        assertTrue("Expected >= 10x armor-stand skip speedup, got " + standSpeedup, standSpeedup >= 10.0);
+    }
+}
