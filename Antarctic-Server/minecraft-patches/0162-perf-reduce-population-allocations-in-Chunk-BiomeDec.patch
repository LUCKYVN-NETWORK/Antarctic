+    @Test
+    public void testChunkFBenchmark() throws Exception {
+        ChunkSection[] sections = new ChunkSection[16];
+        for (int s = 0; s < 5; ++s) {
+            sections[s] = new ChunkSection(s << 4, true);
+        }
+        IBlockData stone = Blocks.STONE.getBlockData();
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                for (int y = 0; y < 56; ++y) {
+                    sections[y >> 4].setType(x, y & 15, z, stone);
+                }
+            }
+        }
+
+        Chunk chunk = createTestChunk(sections);
+        Field hField = Chunk.class.getDeclaredField("h");
+        hField.setAccessible(true);
+        int[] chunkH = (int[]) hField.get(chunk);
+        int[] refH = new int[256];
+
+        BlockPosition[] queries = new BlockPosition[256];
+        for (int i = 0; i < 256; ++i) {
+            queries[i] = new BlockPosition(i & 15, 0, i >> 4);
+        }
+
+        long blackhole = 0L;
+        for (int w = 0; w < 300; ++w) {
+            Arrays.fill(refH, -999);
+            Arrays.fill(chunkH, -999);
+            for (int i = 0; i < 256; ++i) {
+                blackhole ^= vanillaChunkFReference(chunk, refH, queries[i]).getY();
+                blackhole ^= chunk.f(queries[i]).getY();
+            }
+        }
+
+        int chunks = 600;
+        long t0 = System.nanoTime();
+        for (int c = 0; c < chunks; ++c) {
+            Arrays.fill(refH, -999);
+            for (int i = 0; i < 256; ++i) {
+                blackhole += vanillaChunkFReference(chunk, refH, queries[i]).getY();
+            }
+        }
+        long vanillaNs = (System.nanoTime() - t0) / chunks;
+
+        t0 = System.nanoTime();
+        for (int c = 0; c < chunks; ++c) {
+            Arrays.fill(chunkH, -999);
+            for (int i = 0; i < 256; ++i) {
+                blackhole += chunk.f(queries[i]).getY();
+            }
+        }
+        long optNs = (System.nanoTime() - t0) / chunks;
+
+        System.out.printf("A7_BENCH chunkF256_vanilla_ns=%d chunkF256_opt_ns=%d speedup=%.2fx blackhole=%d%n",
+                vanillaNs, optNs, (double) vanillaNs / Math.max(1L, optNs), blackhole);
+
+        assertTrue("Expected Chunk.f speedup > 1.2x, got " + vanillaNs + " vs " + optNs, optNs * 1.2 < vanillaNs);
+    }
+}
