+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        setField("sections", chunk, sections);
+        int[] h = new int[256];
+        Arrays.fill(h, -999);
+        setField("h", chunk, h);
+        setField("heightMap", chunk, new int[256]);
+        return chunk;
+    }
+
+    private static void setField(String name, Object target, Object value) throws Exception {
+        Field f = Chunk.class.getDeclaredField(name);
+        f.setAccessible(true);
+        f.set(target, value);
+    }
+
+    private static BlockPosition vanillaChunkFReference(Chunk chunk, int[] h, BlockPosition blockposition) {
+        int i = blockposition.getX() & 15;
+        int j = blockposition.getZ() & 15;
+        int k = i | j << 4;
+        BlockPosition blockposition1 = new BlockPosition(blockposition.getX(), h[k], blockposition.getZ());
+        if (blockposition1.getY() == -999) {
+            int l = chunk.g() + 15;
+            blockposition1 = new BlockPosition(blockposition.getX(), l, blockposition.getZ());
+            int i1 = -1;
+            while (blockposition1.getY() > 0 && i1 == -1) {
+                IBlockData iblockdata = chunk.getBlockData(blockposition1);
+                Material material = iblockdata.getMaterial();
+                if (!material.isSolid() && !material.isLiquid()) {
+                    blockposition1 = blockposition1.down();
+                } else {
+                    i1 = blockposition1.getY() + 1;
+                }
+            }
+            h[k] = i1;
+        }
+        return new BlockPosition(blockposition.getX(), h[k], blockposition.getZ());
+    }
+
+    @Test
+    public void testChunkFAndMinablePredicateParity() throws Exception {
+        ChunkSection[] sections = new ChunkSection[16];
+        for (int s = 0; s < 5; ++s) {
+            sections[s] = new ChunkSection(s << 4, true);
+        }
+        IBlockData stone = Blocks.STONE.getBlockData();
+        IBlockData water = Blocks.WATER.getBlockData();
+        IBlockData tallgrass = Blocks.TALLGRASS.getBlockData();
+
+        // Column (0,0): stone up to 50, tallgrass at 51 -> top solid/liquid = 51
+        for (int y = 0; y <= 50; ++y) sections[y >> 4].setType(0, y & 15, 0, stone);
+        sections[51 >> 4].setType(0, 51 & 15, 0, tallgrass);
+
+        // Column (1,0): stone up to 40, water up to 62 -> top = 63
+        for (int y = 0; y <= 40; ++y) sections[y >> 4].setType(1, y & 15, 0, stone);
+        for (int y = 41; y <= 62; ++y) sections[y >> 4].setType(1, y & 15, 0, water);
+
+        // Column (2,0): all air -> -1
+        // Column (3,0): solid at y=0 only -> -1 (while y > 0 stops at 0)
+        sections[0].setType(3, 0, 0, stone);
+        // Column (4,0): glass (opacity 0, solid) at y=60 -> 61
+        sections[60 >> 4].setType(4, 60 & 15, 0, Blocks.GLASS.getBlockData());
+
+        Chunk optChunk = createTestChunk(sections);
+        int[] refH = new int[256];
+        Arrays.fill(refH, -999);
+
+        for (int x = 0; x < 5; ++x) {
+            BlockPosition query = new BlockPosition(32 + x, 0, -16);
+            BlockPosition expected = vanillaChunkFReference(optChunk, refH, query);
+            BlockPosition actual = optChunk.f(query);
+            assertEquals("Chunk.f mismatch for x=" + x, expected, actual);
+            // Repeat cached query
+            assertEquals(expected, optChunk.f(query));
+        }
+
+        // Null middle section: sections[3] = null, sections[4] has stone at (0,0) y=68, sections[2] has stone at (5,0) y=35
+        ChunkSection[] sparseSections = new ChunkSection[16];
+        sparseSections[2] = new ChunkSection(32, true);
+        sparseSections[2].setType(5, 3, 0, stone);
+        sparseSections[4] = new ChunkSection(64, true);
+        sparseSections[4].setType(0, 4, 0, stone);
+        Chunk sparseChunk = createTestChunk(sparseSections);
+        int[] sparseRefH = new int[256];
+        Arrays.fill(sparseRefH, -999);
+        for (int x : new int[]{0, 5}) {
+            BlockPosition query = new BlockPosition(x, 0, 0);
+            assertEquals("Sparse Chunk.f mismatch for x=" + x,
+                    vanillaChunkFReference(sparseChunk, sparseRefH, query),
+                    sparseChunk.f(query));
+        }
+
+        // WorldGenMinable predicate parity
+        WorldGenMinable.a pred = new WorldGenMinable.a(null);
+        assertTrue(pred.a(Blocks.STONE.getBlockData()));
+        assertTrue(pred.a(Blocks.STONE.getBlockData().set(BlockStone.VARIANT, BlockStone.EnumStoneVariant.GRANITE)));
+        assertTrue(pred.a(Blocks.STONE.getBlockData().set(BlockStone.VARIANT, BlockStone.EnumStoneVariant.DIORITE)));
+        assertTrue(pred.a(Blocks.STONE.getBlockData().set(BlockStone.VARIANT, BlockStone.EnumStoneVariant.ANDESITE)));
+        assertFalse(pred.a(Blocks.DIRT.getBlockData()));
+        assertFalse(pred.a(Blocks.AIR.getBlockData()));
+        assertFalse(pred.a(Blocks.STONE.getBlockData().set(BlockStone.VARIANT, BlockStone.EnumStoneVariant.GRANITE_SMOOTH)));
+    }
