+    @Test
+    public void testChunkProviderServerChunksCacheInvalidatesOnBoxedAndViewMutators() throws Exception {
+        ChunkProviderServer cps = (ChunkProviderServer) unsafe.allocateInstance(ChunkProviderServer.class);
+        // Construct the anonymous chunks map from ChunkProviderServer field initializer
+        ChunkProviderServer real = new ChunkProviderServer(null, null, null);
+        cps.chunks = real.chunks;
+
+        Chunk c1 = createStubChunk(1, 2);
+        Chunk c2 = createStubChunk(1, 2);
+        long key = ChunkCoordIntPair.a(1, 2);
+
+        // Boxed put(Long, Chunk) updates lastChunkByPos
+        cps.chunks.put(key, c1);
+        Assert.assertSame(c1, cps.chunks.get(key));
+        cps.chunks.put(Long.valueOf(key), c2);
+        Assert.assertSame("Boxed put(Long, Chunk) must update cached lastChunkByPos", c2, cps.chunks.get(key));
+
+        // Boxed remove(Object) invalidates lastChunkByPos
+        cps.chunks.remove(Long.valueOf(key));
+        Assert.assertNull("Boxed remove(Object) must invalidate lastChunkByPos", cps.chunks.get(key));
+        Assert.assertFalse(cps.chunks.containsKey(Long.valueOf(key)));
+
+        // putAll invalidates lastChunkByPos
+        cps.chunks.put(key, c1);
+        Assert.assertSame(c1, cps.chunks.get(key));
+        cps.chunks.putAll(Collections.singletonMap(Long.valueOf(key), c2));
+        Assert.assertSame("putAll must invalidate stale lastChunkByPos", c2, cps.chunks.get(key));
+
+        // values().iterator().remove() invalidates lastChunkByPos
+        Iterator<Chunk> vit = cps.chunks.values().iterator();
+        vit.next();
+        vit.remove();
+        Assert.assertNull("values().iterator().remove must invalidate lastChunkByPos", cps.chunks.get(key));
+
+        // keySet().remove(long) invalidates lastChunkByPos
+        cps.chunks.put(key, c1);
+        Assert.assertSame(c1, cps.chunks.get(key));
+        cps.chunks.keySet().remove(key);
+        Assert.assertNull("keySet().remove(long) must invalidate lastChunkByPos", cps.chunks.get(key));
+
+        // long2ObjectEntrySet().fastIterator() setValue & remove invalidate lastChunkByPos
+        cps.chunks.put(key, c1);
+        Assert.assertSame(c1, cps.chunks.get(key));
+        Iterator<Long2ObjectMap.Entry<Chunk>> eit = cps.chunks.long2ObjectEntrySet().fastIterator();
+        Long2ObjectMap.Entry<Chunk> e = eit.next();
+        e.setValue(c2);
+        Assert.assertSame("Entry.setValue must invalidate lastChunkByPos", c2, cps.chunks.get(key));
+        eit.remove();
+        Assert.assertNull("Entry iterator remove must invalidate lastChunkByPos", cps.chunks.get(key));
+    }
