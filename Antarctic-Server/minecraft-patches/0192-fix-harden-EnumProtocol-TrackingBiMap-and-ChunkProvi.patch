@@ -0,0 +1,157 @@
+package net.minecraft.server;
+
+import com.google.common.collect.BiMap;
+import com.google.common.collect.HashBiMap;
+import it.unimi.dsi.fastutil.longs.Long2ObjectMap;
+import java.lang.reflect.Field;
+import java.util.Collections;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReferenceArray;
+import java.util.function.Supplier;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class ProtocolAndChunkMapInvalidationTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void init() throws Exception {
+        DispenserRegistry.c();
+        org.spigotmc.AsyncCatcher.enabled = false;
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    public void testEnumProtocolTrackingBiMapInvalidatesOnForcePutViewsAndReplaceAll() throws Exception {
+        Field hField = EnumProtocol.class.getDeclaredField("h");
+        hField.setAccessible(true);
+        Field tableField = EnumProtocol.class.getDeclaredField("supplierTable");
+        tableField.setAccessible(true);
+
+        EnumProtocol proto = EnumProtocol.HANDSHAKING;
+        Map<EnumProtocolDirection, BiMap<Integer, Class<? extends Packet<?>>>> h =
+                (Map<EnumProtocolDirection, BiMap<Integer, Class<? extends Packet<?>>>>) hField.get(proto);
+        BiMap<Integer, Class<? extends Packet<?>>> serverbound = h.get(EnumProtocolDirection.SERVERBOUND);
+        AtomicReferenceArray<Supplier<? extends Packet<?>>[]> table =
+                (AtomicReferenceArray<Supplier<? extends Packet<?>>[]>) tableField.get(proto);
+
+        int dirIdx = EnumProtocolDirection.SERVERBOUND.ordinal();
+        BiMap<Integer, Class<? extends Packet<?>>> snapshotMap = HashBiMap.create(serverbound);
+        Supplier<? extends Packet<?>>[] snapshotRow = table.get(dirIdx) != null ? table.get(dirIdx).clone() : null;
+
+        try {
+            // 1) forcePut(99, PacketHandshakingInSetProtocol.class) must invalidate BOTH slot 99 and displaced slot 0
+            Assert.assertNotNull(table.get(dirIdx)[0]);
+            serverbound.forcePut(99, PacketHandshakingInSetProtocol.class);
+            Assert.assertNull("Displaced key slot 0 must be invalidated on forcePut", table.get(dirIdx)[0]);
+            Assert.assertEquals(99, serverbound.inverse().get(PacketHandshakingInSetProtocol.class).intValue());
+
+            // Restore and verify keySet().remove(...)
+            serverbound.forcePut(0, PacketHandshakingInSetProtocol.class);
+            table.set(dirIdx, snapshotRow.clone());
+            serverbound.keySet().remove(0);
+            Assert.assertNull("keySet().remove must invalidate supplierTable", table.get(dirIdx));
+
+            // Restore and verify values().remove(...)
+            serverbound.put(0, PacketHandshakingInSetProtocol.class);
+            table.set(dirIdx, snapshotRow.clone());
+            serverbound.values().remove(PacketHandshakingInSetProtocol.class);
+            Assert.assertNull("values().remove must invalidate supplierTable", table.get(dirIdx));
+
+            // Restore and verify entrySet().iterator().next().setValue(...) and remove()
+            serverbound.put(0, PacketHandshakingInSetProtocol.class);
+            table.set(dirIdx, snapshotRow.clone());
+            Iterator<Map.Entry<Integer, Class<? extends Packet<?>>>> it = serverbound.entrySet().iterator();
+            Map.Entry<Integer, Class<? extends Packet<?>>> entry = it.next();
+            entry.setValue(PacketLoginInStart.class);
+            Assert.assertNull("entrySet().setValue must invalidate supplierTable", table.get(dirIdx));
+
+            table.set(dirIdx, snapshotRow.clone());
+            it.remove();
+            Assert.assertNull("entrySet().iterator().remove must invalidate supplierTable", table.get(dirIdx));
+
+            // Restore and verify replaceAll(...)
+            serverbound.put(0, PacketHandshakingInSetProtocol.class);
+            table.set(dirIdx, snapshotRow.clone());
+            serverbound.replaceAll((k, v) -> v);
+            Assert.assertNull("replaceAll must invalidate supplierTable", table.get(dirIdx));
+
+            // Verify inverse().keySet().remove(...) and inverse().replaceAll(...)
+            table.set(dirIdx, snapshotRow.clone());
+            serverbound.inverse().replaceAll((k, v) -> v);
+            Assert.assertNull("inverse().replaceAll must invalidate supplierTable", table.get(dirIdx));
+
+            table.set(dirIdx, snapshotRow.clone());
+            serverbound.inverse().keySet().remove(PacketHandshakingInSetProtocol.class);
+            Assert.assertNull("inverse().keySet().remove must invalidate supplierTable", table.get(dirIdx));
+        } finally {
+            serverbound.clear();
+            serverbound.putAll(snapshotMap);
+            table.set(dirIdx, snapshotRow);
+        }
+    }
+
+    private static Chunk createStubChunk(int cx, int cz) throws Exception {
+        Chunk c = (Chunk) unsafe.allocateInstance(Chunk.class);
+        unsafe.putLong(c, unsafe.objectFieldOffset(Chunk.class.getDeclaredField("chunkKey")), ChunkCoordIntPair.a(cx, cz));
+        return c;
+    }
