+    private static void setBlock(TestWorld world, int x, int y, int z, IBlockData data) {
+        Chunk c = world.getChunkIfLoaded(x >> 4, z >> 4);
+        if (c == null || y < 0 || y >= 256) return;
+        ChunkSection[] sections = c.getSections();
+        ChunkSection sec = sections[y >> 4];
+        if (sec == Chunk.a) {
+            sec = new ChunkSection((y >> 4) << 4, true);
+            sections[y >> 4] = sec;
+        }
+        sec.setType(x & 15, y & 15, z & 15, data);
+    }
