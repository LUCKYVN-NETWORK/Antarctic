+    private static void assertHitEquals(String ctx, @Nullable MovingObjectPosition expected, @Nullable MovingObjectPosition actual) {
+        if (expected == null) {
+            Assert.assertNull(ctx + ": expected null hit", actual);
+            return;
+        }
+        Assert.assertNotNull(ctx + ": expected non-null hit", actual);
+        Assert.assertEquals(ctx + ": type mismatch", expected.type, actual.type);
+        Assert.assertEquals(ctx + ": direction mismatch", expected.direction, actual.direction);
+        Assert.assertEquals(ctx + ": block pos mismatch", expected.a(), actual.a());
+        Assert.assertEquals(ctx + ": pos.x mismatch", expected.pos.x, actual.pos.x, 0.0D);
+        Assert.assertEquals(ctx + ": pos.y mismatch", expected.pos.y, actual.pos.y, 0.0D);
+        Assert.assertEquals(ctx + ": pos.z mismatch", expected.pos.z, actual.pos.z, 0.0D);
+    }
