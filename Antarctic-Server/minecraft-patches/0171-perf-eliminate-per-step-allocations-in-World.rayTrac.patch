+        Field locXField = Chunk.class.getDeclaredField("locX");
+        locXField.setAccessible(true);
+        locXField.setInt(c, cx);
+        Field locZField = Chunk.class.getDeclaredField("locZ");
+        locZField.setAccessible(true);
+        locZField.setInt(c, cz);
+        ChunkSection[] sections = new ChunkSection[16];
+        for (int i = 0; i < 16; i++) {
+            sections[i] = Chunk.a;
+        }
+        Field secField = Chunk.class.getDeclaredField("sections");
+        secField.setAccessible(true);
+        secField.set(c, sections);
+    }
