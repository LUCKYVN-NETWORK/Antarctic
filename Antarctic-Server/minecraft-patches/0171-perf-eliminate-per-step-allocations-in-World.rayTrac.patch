+        cps.tw = world;
+        world.chunkProvider = cps;
+        for (int cx = 0; cx < 4; cx++) {
+            for (int cz = 0; cz < 4; cz++) {
+                Chunk c = (Chunk) unsafe.allocateInstance(Chunk.class);
+                initChunk(c, world, cx, cz);
+                world.grid[cx][cz] = c;
+            }
+        }
