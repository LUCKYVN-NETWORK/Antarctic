+                IBlockData iblockdata = world.getTypeIfLoaded(blockposition);
+                if (iblockdata == null) return null;
+                Block block = iblockdata.getBlock();
+
+                if ((!flag1 || iblockdata.d(world, blockposition) != Block.k) && block.a(iblockdata, flag)) {
+                    MovingObjectPosition movingobjectposition = iblockdata.a(world, blockposition, vec3d, vec3d1);
+                    if (movingobjectposition != null) {
