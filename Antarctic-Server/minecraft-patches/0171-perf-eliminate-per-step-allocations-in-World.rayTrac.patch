+    @Test
+    public void testRayTraceParity() throws Exception {
+        TestWorld world = createWorld();
+        // Stone wall across chunk boundary (x=25, y=60..68, z=10..30)
+        for (int y = 60; y <= 68; y++) {
+            for (int z = 10; z <= 30; z++) {
+                setBlock(world, 25, y, z, Blocks.STONE.getBlockData());
+            }
+        }
+        // Glass, slabs, stairs, water, tall grass, portal
+        setBlock(world, 15, 64, 15, Blocks.GLASS.getBlockData());
+        setBlock(world, 16, 64, 15, Blocks.STONE_SLAB.getBlockData());
+        setBlock(world, 17, 64, 15, Blocks.OAK_STAIRS.getBlockData());
+        setBlock(world, 18, 64, 15, Blocks.WATER.getBlockData());
+        setBlock(world, 19, 64, 15, Blocks.TALLGRASS.getBlockData());
+        setBlock(world, 20, 64, 15, Blocks.PORTAL.getBlockData());
+        // Start-inside-block fixture
+        setBlock(world, 10, 64, 10, Blocks.STONE.getBlockData());
+
+        List<Vec3D[]> rays = new ArrayList<>();
+        // Start inside stone
+        rays.add(new Vec3D[]{new Vec3D(10.5D, 64.5D, 10.5D), new Vec3D(12.5D, 64.5D, 10.5D)});
+        // NaN cases
+        rays.add(new Vec3D[]{new Vec3D(Double.NaN, 64.0D, 10.0D), new Vec3D(12.0D, 64.0D, 10.0D)});
+        rays.add(new Vec3D[]{new Vec3D(10.0D, 64.0D, 10.0D), new Vec3D(12.0D, Double.NaN, 10.0D)});
+        // Unloaded chunk border (x=64 is chunk 4, unloaded)
+        rays.add(new Vec3D[]{new Vec3D(55.5D, 64.5D, 16.5D), new Vec3D(72.5D, 64.5D, 16.5D)});
+        // Open-air miss (no blocks in y=90)
+        rays.add(new Vec3D[]{new Vec3D(8.2D, 90.5D, 8.2D), new Vec3D(35.8D, 92.3D, 34.7D)});
+        // Through glass, slab, stairs, water, tallgrass, portal
+        rays.add(new Vec3D[]{new Vec3D(12.5D, 64.25D, 15.5D), new Vec3D(28.5D, 64.25D, 15.5D)});
+        rays.add(new Vec3D[]{new Vec3D(12.5D, 64.85D, 15.5D), new Vec3D(28.5D, 64.85D, 15.5D)});
+        // Deterministic 15+ diagonal/axis rays across chunks
+        for (int idx = 0; idx < 16; idx++) {
+            double sx = 5.1D + idx * 0.7D;
+            double sy = 60.2D + (idx % 5) * 1.1D;
+            double sz = 8.3D + idx * 0.9D;
+            double ex = 32.4D - idx * 0.4D;
+            double ey = 66.8D - (idx % 4) * 1.3D;
+            double ez = 31.6D - idx * 0.6D;
+            rays.add(new Vec3D[]{new Vec3D(sx, sy, sz), new Vec3D(ex, ey, ez)});
+        }
+
+        // 23 rays * 8 boolean combinations = 184 parity checks
+        int checks = 0;
+        for (int r = 0; r < rays.size(); r++) {
+            Vec3D start = rays.get(r)[0];
+            Vec3D end = rays.get(r)[1];
+            for (int mask = 0; mask < 8; mask++) {
+                boolean f0 = (mask & 1) != 0;
+                boolean f1 = (mask & 2) != 0;
+                boolean f2 = (mask & 4) != 0;
+                MovingObjectPosition expected = vanillaRayTrace(world, start, end, f0, f1, f2);
+                MovingObjectPosition actual = world.rayTrace(start, end, f0, f1, f2);
+                assertHitEquals("ray=" + r + " mask=" + mask, expected, actual);
+                checks++;
+            }
+        }
+        Assert.assertTrue(checks >= 120);
