diff --git a/test/java/net/minecraft/server/LightBorderNoSyncLoadTest.java b/test/java/net/minecraft/server/LightBorderNoSyncLoadTest.java
new file mode 100644
index 0000000..35ac741
--- /dev/null
+++ b/test/java/net/minecraft/server/LightBorderNoSyncLoadTest.java
@@ -0,0 +1,105 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+public class LightBorderNoSyncLoadTest {
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    /**
+     * Round 2 simulation reproducer: with only the 3x3 chunks (-1..1, -1..1) loaded (chunk cx=-2 unloaded),
+     * removing a glowstone at x=0 while an unlit light trail reaches x=-15 (distance 15, radius-17 darkening/relight
+     * probes x=-16 in cx=-2) must never trigger a synchronous chunk load on cx=-2.
+     */
+    @Test
+    public void radius17BorderDarkeningAndRelightNeverLoadsUnloadedChunk() throws Exception {
+        LightPropagationParityTest.StubProvider[] providerOut = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = LightPropagationParityTest.buildWorld(42L, providerOut);
+
+        // Unload all cx == -2 chunks so only the 3x3 around (0, 0) plus (+1) exist, matching areNeighborsLoaded(1) == true
+        for (int cz = -2; cz <= 1; ++cz) {
+            providerOut[0].chunks.remove(ChunkCoordIntPair.a(-2, cz));
+        }
+
+        // Place glowstone at (0, 40, 0) (above all random stone pillars) and populate its light first
+        BlockPosition glowstonePos = new BlockPosition(0, 40, 0);
+        LightPropagationParityTest.setBlock(world, 0, 40, 0, Blocks.GLOWSTONE.getBlockData());
+
+        assertTrue(world.c(EnumSkyBlock.BLOCK, glowstonePos));
+        assertEquals(15, world.getBrightness(EnumSkyBlock.BLOCK, 0, 40, 0));
+        assertEquals(1, world.getBrightness(EnumSkyBlock.BLOCK, -14, 40, 0));
+
+        // Now place an unlit torch at (-15, 40, 0) and remove the glowstone:
+        // darkening reaches x=-15 (distance 15), relight lights the torch at x=-15 and probes x=-16 (cx=-2)
+        LightPropagationParityTest.setBlock(world, -15, 40, 0, Blocks.TORCH.getBlockData());
+        LightPropagationParityTest.setBlock(world, 0, 40, 0, Blocks.AIR.getBlockData());
+        // This previously called World.getType(-16, 40, 0) -> originalGetChunkAt(-2, 0) -> AssertionError!
+        assertTrue(world.c(EnumSkyBlock.BLOCK, glowstonePos));
+        assertTrue(world.c(EnumSkyBlock.SKY, glowstonePos));
+
+        // Ensure torch at (-15, 40, 0) shines properly on the loaded chunk without loading cx=-2
+        assertEquals(14, world.getBrightness(EnumSkyBlock.BLOCK, -15, 40, 0));
+        assertEquals(13, world.getBrightness(EnumSkyBlock.BLOCK, -14, 40, 0));
+
+        // Chunk.n() border relight scan on chunk (-1, 0) must also never load cx=-2
+        Chunk borderChunk = world.getChunkIfLoaded(-1, 0);
+        LightPropagationParityTest.set(Chunk.class, borderChunk, "locX", -1);
+        LightPropagationParityTest.set(Chunk.class, borderChunk, "locZ", 0);
+        borderChunk.m(); // reset x = 0
+        for (int step = 0; step < 32; ++step) {
+            borderChunk.n();
+        }
+    }
+
+    @Test
+    public void chunkCheckLightUnloadedNeighborAndEmptyVoidFastPath() throws Exception {
+        LightPropagationParityTest.StubProvider[] providerOut = new LightPropagationParityTest.StubProvider[1];
+        WorldServer world = LightPropagationParityTest.buildWorld(77L, providerOut);
+        // Allocate minimal WorldTimingsHandler with a no-op Timing for Chunk.o()
+        java.lang.reflect.Field uf = sun.misc.Unsafe.class.getDeclaredField("theUnsafe");
+        uf.setAccessible(true);
+        sun.misc.Unsafe u = (sun.misc.Unsafe) uf.get(null);
+        co.aikar.timings.WorldTimingsHandler handler = (co.aikar.timings.WorldTimingsHandler) u.allocateInstance(co.aikar.timings.WorldTimingsHandler.class);
+        LightPropagationParityTest.set(co.aikar.timings.WorldTimingsHandler.class, handler, "lightChunk", co.aikar.timings.NullTimingHandler.NULL);
+        LightPropagationParityTest.set(World.class, world, "timings", handler);
+        LightPropagationParityTest.set(World.class, world, "chunkPacketBlockController", com.destroystokyo.paper.antixray.ChunkPacketBlockController.NO_OPERATION_INSTANCE);
+
+        // Configure chunk (0, 0) as pure void (all sections == Chunk.a)
+        Chunk center = world.getChunkIfLoaded(0, 0);
+        LightPropagationParityTest.set(Chunk.class, center, "locX", 0);
+        LightPropagationParityTest.set(Chunk.class, center, "locZ", 0);
+        LightPropagationParityTest.set(Chunk.class, center, "sections", new ChunkSection[16]);
+        LightPropagationParityTest.set(Chunk.class, center, "h", new int[256]);
+        LightPropagationParityTest.set(Chunk.class, center, "i", new boolean[256]);
+        LightPropagationParityTest.set(Chunk.class, center, "v", 0);
+
+        // 1. When 3x3 neighbors are NOT loaded, Chunk.o() must leave lit=false without throwing or loading chunks
+        LightPropagationParityTest.set(Chunk.class, center, "neighbors", 0x1 << 12);
+        center.e(false);
+        center.o();
+        assertFalse("missing neighbors must keep lit=false", center.v());
+
+        // 2. When 3x3 neighbors ARE loaded, pure-void fast path must complete and mark lit=true
+        for (int cx = -1; cx <= 1; ++cx) {
+            for (int cz = -1; cz <= 1; ++cz) {
+                Chunk c = world.getChunkIfLoaded(cx, cz);
+                LightPropagationParityTest.set(Chunk.class, c, "locX", cx);
+                LightPropagationParityTest.set(Chunk.class, c, "locZ", cz);
+                LightPropagationParityTest.set(Chunk.class, c, "h", new int[256]);
+                LightPropagationParityTest.set(Chunk.class, c, "i", new boolean[256]);
+                LightPropagationParityTest.set(Chunk.class, c, "neighbors", -1);
+                c.d(true); // done = true
+            }
+        }
+        center.o();
+        assertTrue("pure-void chunk with 3x3 neighbors loaded must become lit=true", center.v());
+    }
+}
