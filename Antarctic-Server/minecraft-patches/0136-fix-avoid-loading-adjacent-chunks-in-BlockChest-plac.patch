diff --git a/test/java/net/minecraft/server/BlockChestNoChunkLoadTest.java b/test/java/net/minecraft/server/BlockChestNoChunkLoadTest.java
new file mode 100644
index 0000000..0351189
--- /dev/null
+++ b/test/java/net/minecraft/server/BlockChestNoChunkLoadTest.java
@@ -0,0 +1,75 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import sun.misc.Unsafe;
+
+public class BlockChestNoChunkLoadTest {
+
+    private static Unsafe unsafe;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        unsafe = (Unsafe) f.get(null);
+    }
+
+    private static final class GuardedWorld extends World {
+        int syncGetTypeCalls;
+        int getTypeIfLoadedCalls;
+
+        GuardedWorld() {
+            super(null, null, null, null, false, null, null);
+        }
+
+        @Override
+        protected IChunkProvider n() {
+            return null;
+        }
+
+        @Override
+        protected boolean isChunkLoaded(int i, int j, boolean flag) {
+            return i == 0 && j == 0;
+        }
+
+        @Override
+        public IBlockData getType(BlockPosition pos) {
+            syncGetTypeCalls++;
+            throw new AssertionError("BlockChest must not call sync World.getType on neighbor " + pos);
+        }
+
+        @Override
+        public IBlockData getTypeIfLoaded(BlockPosition pos) {
+            getTypeIfLoadedCalls++;
+            // Only chunk (0, 0) is loaded; neighbors across chunk border return null
+            if ((pos.getX() >> 4) == 0 && (pos.getZ() >> 4) == 0) {
+                return Blocks.AIR.getBlockData();
+            }
+            return null;
+        }
+
+        @Override
+        public boolean setTypeAndData(BlockPosition pos, IBlockData state, int flags) {
+            return true;
+        }
+    }
+
+    @Test
+    public void testOnPlaceAtChunkBorderNeverCallsSyncGetType() throws Exception {
+        GuardedWorld world = (GuardedWorld) unsafe.allocateInstance(GuardedWorld.class);
+        Field clientSide = World.class.getDeclaredField("isClientSide");
+        clientSide.setAccessible(true);
+        clientSide.setBoolean(world, false);
+
+        BlockChest chest = (BlockChest) Blocks.CHEST;
+        // Place at chunk border (0, 64, 0) where north (0, 64, -1) and west (-1, 64, 0) are in unloaded chunks
+        chest.onPlace(world, new BlockPosition(0, 64, 0), chest.getBlockData());
+
+        Assert.assertEquals("BlockChest.onPlace/e must never trigger synchronous World.getType", 0, world.syncGetTypeCalls);
+        Assert.assertTrue("BlockChest must inspect neighbors via getTypeIfLoaded", world.getTypeIfLoadedCalls >= 4);
+    }
+}
