diff --git a/test/java/net/minecraft/server/PlayerListIpBanNullGuardTest.java b/test/java/net/minecraft/server/PlayerListIpBanNullGuardTest.java
new file mode 100644
index 0000000..972a211
--- /dev/null
+++ b/test/java/net/minecraft/server/PlayerListIpBanNullGuardTest.java
@@ -0,0 +1,62 @@
+package net.minecraft.server;
+
+import java.io.File;
+import java.net.InetSocketAddress;
+import java.net.SocketAddress;
+import java.util.Date;
+import org.junit.Assert;
+import org.junit.Test;
+
+public class PlayerListIpBanNullGuardTest {
+
+    @Test
+    public void testExpiredRacyAndActiveIpBanResolution() {
+        SocketAddress addr = new InetSocketAddress("203.0.113.10", 25565);
+
+        // Simulate a race where isBanned() returns true right before get() evicts/returns null
+        IpBanList racyList = new IpBanList(new File("banned-ips-test.json")) {
+            @Override
+            public boolean isBanned(SocketAddress socketaddress) {
+                return true;
+            }
+
+            @Override
+            public IpBanEntry get(SocketAddress socketaddress) {
+                return null;
+            }
+        };
+        Assert.assertNull("Null entry from get() after isBanned()==true must return null without NPE",
+                PlayerList.resolveActiveIpBan(racyList, addr));
+
+        // Expired entry returned by get() must also resolve to null
+        final IpBanEntry expired = new IpBanEntry("203.0.113.10", new Date(0L), "test", new Date(1000L), "old");
+        IpBanList expiredList = new IpBanList(new File("banned-ips-test.json")) {
+            @Override
+            public boolean isBanned(SocketAddress socketaddress) {
+                return true;
+            }
+
+            @Override
+            public IpBanEntry get(SocketAddress socketaddress) {
+                return expired;
+            }
+        };
+        Assert.assertNull("Expired IP ban must return null", PlayerList.resolveActiveIpBan(expiredList, addr));
+
+        // Active entry must be returned intact
+        final IpBanEntry active = new IpBanEntry("203.0.113.10", new Date(), "test", new Date(System.currentTimeMillis() + 600_000L), "active");
+        IpBanList activeList = new IpBanList(new File("banned-ips-test.json")) {
+            @Override
+            public boolean isBanned(SocketAddress socketaddress) {
+                return true;
+            }
+
+            @Override
+            public IpBanEntry get(SocketAddress socketaddress) {
+                return active;
+            }
+        };
+        Assert.assertSame("Active IP ban must be returned", active, PlayerList.resolveActiveIpBan(activeList, addr));
+        Assert.assertNull("Null socketaddress must return null safely", PlayerList.resolveActiveIpBan(activeList, null));
+    }
+}
