@@ -603,6 +603,17 @@ public abstract class PlayerList {
         return entity;
     }
 
+    // Antarctic start - avoid NPE when an IP ban expires between isBanned() and get()
+    @Nullable
+    static IpBanEntry resolveActiveIpBan(IpBanList ipBans, SocketAddress socketaddress) {
+        if (socketaddress == null || !ipBans.isBanned(socketaddress)) {
+            return null;
+        }
+        IpBanEntry entry = ipBans.get(socketaddress);
+        return (entry != null && !entry.hasExpired()) ? entry : null;
+    }
+    // Antarctic end
+
