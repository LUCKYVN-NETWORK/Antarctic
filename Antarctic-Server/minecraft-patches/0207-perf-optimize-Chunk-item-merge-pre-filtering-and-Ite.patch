+public class ItemXpMergeParityTest {
+
+    private static Unsafe UNSAFE;
+    private static int nextEntityId = 20000;
+
+    @BeforeClass
+    public static void setup() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+    }
+
+    private static final class MergeTestWorld extends World {
+        final Chunk chunk;
+
+        MergeTestWorld(Chunk chunk) {
+            super(null, new WorldData(), new WorldProviderNormal(), new MethodProfiler(), false, null, null);
+            this.chunk = chunk;
+        }
+
+        @Override
+        protected IChunkProvider n() {
+            return null;
+        }
+
+        @Override
+        protected boolean isChunkLoaded(int i, int j, boolean flag) {
+            return i == 0 && j == 0;
+        }
+
+        @Override
+        public Chunk getChunkIfLoaded(int i, int j) {
+            return (i == 0 && j == 0) ? this.chunk : null;
+        }
+    }
+
+    private static MergeTestWorld createTestWorld() throws Exception {
+        Chunk chunk = (Chunk) UNSAFE.allocateInstance(Chunk.class);
+        Field secField = Chunk.class.getDeclaredField("sections");
+        secField.setAccessible(true);
+        ChunkSection[] sections = new ChunkSection[16];
+        for (int s = 0; s < 16; ++s) {
+            sections[s] = new ChunkSection(s << 4, true);
+        }
+        secField.set(chunk, sections);
+
+        Field slicesField = Chunk.class.getDeclaredField("entitySlices");
+        slicesField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        List<Entity>[] slices = new List[16];
+        for (int s = 0; s < 16; ++s) {
+            slices[s] = new ArrayList<>();
+        }
+        slicesField.set(chunk, slices);
+
+        for (String fn : new String[]{"hardCollidableCounts", "itemCounts", "inventoryEntityCounts", "itemFrameCounts"}) {
+            Field f = Chunk.class.getDeclaredField(fn);
+            f.setAccessible(true);
+            f.set(chunk, new int[16]);
+        }
+        Field ec = Chunk.class.getDeclaredField("entityCounts");
+        ec.setAccessible(true);
+        ec.set(chunk, new co.aikar.util.Counter<String>());
+        Field ect = Chunk.class.getDeclaredField("entityCount");
+        ect.setAccessible(true);
+        ect.set(chunk, new gnu.trove.map.hash.TObjectIntHashMap<Class>());
+        Field acc = Chunk.class.getDeclaredField("antarcticCreatureCounts");
+        acc.setAccessible(true);
+        acc.set(chunk, new int[EnumCreatureType.values().length]);
+
+        MergeTestWorld world = (MergeTestWorld) UNSAFE.allocateInstance(MergeTestWorld.class);
+        Field cf = MergeTestWorld.class.getDeclaredField("chunk");
+        cf.setAccessible(true);
+        cf.set(world, chunk);
+        Field wc = Chunk.class.getDeclaredField("world");
+        wc.setAccessible(true);
+        wc.set(chunk, world);
+        Field sc = World.class.getDeclaredField("spigotConfig");
+        sc.setAccessible(true);
+        SpigotWorldConfig spigotConfig = (SpigotWorldConfig) UNSAFE.allocateInstance(SpigotWorldConfig.class);
+        spigotConfig.itemMerge = 2.5D;
+        spigotConfig.expMerge = 3.0D;
+        sc.set(world, spigotConfig);
+        Field pwc = World.class.getDeclaredField("paperConfig");
+        pwc.setAccessible(true);
+        PaperWorldConfig paperConfig = (PaperWorldConfig) UNSAFE.allocateInstance(PaperWorldConfig.class);
+        paperConfig.expMergeMaxValue = 100;
+        pwc.set(world, paperConfig);
+        world.worldProvider = new WorldProviderNormal();
+        return world;
+    }
+
+    private static EntityItem createItem(World world, double x, double y, double z, ItemStack stack) throws Exception {
+        EntityItem item = (EntityItem) UNSAFE.allocateInstance(EntityItem.class);
+        item.h(nextEntityId++);
+        item.world = world;
+        item.locX = x;
+        item.locY = y;
+        item.locZ = z;
+        item.a(new AxisAlignedBB(x - 0.125, y, z - 0.125, x + 0.125, y + 0.25, z + 0.125));
+        DataWatcher dw = new DataWatcher(item);
+        Field cField = EntityItem.class.getDeclaredField("c");
+        cField.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        DataWatcherObject<ItemStack> itemKey = (DataWatcherObject<ItemStack>) cField.get(null);
+        dw.register(itemKey, stack);
+        Field dwField = Entity.class.getDeclaredField("datawatcher");
+        dwField.setAccessible(true);
+        dwField.set(item, dw);
+        return item;
