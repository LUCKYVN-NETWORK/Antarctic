+    @Test
+    public void testMixedItemMergeFilteringParity() throws Exception {
+        MergeTestWorld world = createTestWorld();
+        List<EntityItem> mergeCandidatesReached = new ArrayList<>();
+        EntityItem self = new EntityItem(world, 8.0, 64.0, 8.0, new ItemStack(Items.COAL, 10)) {
+            @Override
+            boolean tryMergeWith(EntityItem other) {
+                mergeCandidatesReached.add(other);
+                ItemStack s1 = this.getItemStack();
+                ItemStack s2 = other.getItemStack();
+                if (s1.getItem() == s2.getItem() && (!s1.hasTag() && !s2.hasTag())) {
+                    s1.add(s2.getCount());
+                    this.setItemStack(s1);
+                    other.die();
+                    return true;
+                }
+                return false;
+            }
+        };
+        EntityItem match = createItem(world, 8.5, 64.0, 8.5, new ItemStack(Items.COAL, 12));
+        EntityItem fullStack = createItem(world, 8.5, 64.0, 8.5, new ItemStack(Items.COAL, 64));
+        EntityItem noPickup = createItem(world, 8.5, 64.0, 8.5, new ItemStack(Items.COAL, 5));
+        noPickup.pickupDelay = 32767;
+        EntityItem immortal = createItem(world, 8.5, 64.0, 8.5, new ItemStack(Items.COAL, 5));
+        Field ageField = EntityItem.class.getDeclaredField("age");
+        ageField.setAccessible(true);
+        ageField.setInt(immortal, -32768);
+        EntityItem sword = createItem(world, 8.5, 64.0, 8.5, new ItemStack(Items.IRON_SWORD, 1));
+        EntityItem nbtDiff = createItem(world, 8.5, 64.0, 8.5, new ItemStack(Items.COAL, 5));
+        NBTTagCompound tag = new NBTTagCompound();
+        tag.setInt("Custom", 1);
+        nbtDiff.getItemStack().setTag(tag);
+
+        world.chunk.a(self);
+        world.chunk.a(match);
+        world.chunk.a(fullStack);
+        world.chunk.a(noPickup);
+        world.chunk.a(immortal);
+        world.chunk.a(sword);
+        world.chunk.a(nbtDiff);
+
+        world.mergeNearbyItems(self, 2.5D);
+        // match (12) merges into self (10) -> 22; ineligible items are pre-filtered before tryMergeWith (only match + same-item nbtDiff can reach it)
+        assertEquals(22, self.getItemStack().getCount());
+        assertFalse(match.isAlive());
+        assertTrue(mergeCandidatesReached.contains(match));
+        assertFalse(mergeCandidatesReached.contains(fullStack));
+        assertFalse(mergeCandidatesReached.contains(noPickup));
+        assertFalse(mergeCandidatesReached.contains(immortal));
+        assertFalse(mergeCandidatesReached.contains(sword));
+        assertTrue(fullStack.isAlive());
+        assertTrue(noPickup.isAlive());
+        assertTrue(immortal.isAlive());
+        assertTrue(sword.isAlive());
+        assertTrue(nbtDiff.isAlive());
+
+        // Unstackable self exits immediately without scanning
+        world.mergeNearbyItems(sword, 2.5D);
+        assertTrue(sword.isAlive());
+    }
+
+    @Test
+    public void testExperienceOrbMergeZeroAllocAndMaxCapParity() throws Exception {
+        MergeTestWorld world = createTestWorld();
+        EntityExperienceOrb orb1 = createOrb(world, 8.0, 64.0, 8.0, 60);
+        EntityExperienceOrb orb2 = createOrb(world, 8.5, 64.0, 8.5, 70);
+        EntityItem nonOrb = createItem(world, 8.5, 64.0, 8.5, new ItemStack(Items.APPLE, 1));
+        world.chunk.a(orb1);
+        world.chunk.a(nonOrb);
+
+        // Merge orb2 (70) into orb1 (60) with maxValue=100 -> orb2 caps at 100 and orb1 keeps remainder 30
+        world.mergeNearbyExperienceOrbs(orb2, 3.0D, 100);
+        assertEquals(100, orb2.value);
+        assertEquals(30, orb1.value);
+        assertTrue(orb1.isAlive());
+        assertTrue(nonOrb.isAlive());
+    }
+
+    @Test
+    public void testMixedUnstackableItemMergePerformance() throws Exception {
+        MergeTestWorld world = createTestWorld();
+        EntityItem self = createItem(world, 8.0, 64.0, 8.0, new ItemStack(Items.COAL, 1));
+        world.chunk.a(self);
+        for (int i = 0; i < 1000; i++) {
+            world.chunk.a(createItem(world, 8.2, 64.0, 8.2, new ItemStack(Items.STONE_SWORD, 1)));
+        }
+
+        ThreadMXBean threadBean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        for (int i = 0; i < 200; i++) {
+            world.mergeNearbyItems(self, 2.5D);
+        }
+
+        long a0 = threadBean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < 1000; i++) {
+            world.mergeNearbyItems(self, 2.5D);
+        }
+        long elapsedNs = System.nanoTime() - t0;
+        long allocBytes = Math.max(0L, threadBean.getThreadAllocatedBytes(tid) - a0);
+
+        System.out.printf("[A3 Perf] 1000x mergeNearbyItems over 1000 mismatched items: %d us, alloc=%d bytes%n",
+                elapsedNs / 1000L, allocBytes);
+        assertTrue("Expected zero candidate-list allocation on mismatched slice, got " + allocBytes, allocBytes <= 4096L);
+    }
+}
