+        int[] extremes = {Integer.MIN_VALUE, -30000001, -30000000, -33, -32, -1, 0, 1, 31, 32, 33, 29999999, 30000000, Integer.MAX_VALUE};
+        int mismatches = 0;
+        for (int n = 0; n < 20000; ++n) {
+            int x = n % 4 == 0 ? extremes[random.nextInt(extremes.length)] : random.nextInt(80) - 40; // beyond -32..31 is unloaded
+            int z = n % 5 == 0 ? extremes[random.nextInt(extremes.length)] : random.nextInt(80) - 40;
+            int y = n % 7 == 0 ? random.nextInt(600) - 200 : random.nextInt(256);
+            for (EnumSkyBlock type : EnumSkyBlock.values()) {
