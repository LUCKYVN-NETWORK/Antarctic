+package net.minecraft.server;
+
+import static org.junit.Assert.assertTrue;
+
+import java.lang.management.ManagementFactory;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/** Timed and allocation-counting comparison of old and new light propagation on identical worlds and identical edits. */
+public class LightPropagationPerfTest {
+
+    private static final com.sun.management.ThreadMXBean MX = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+    private static long sink;
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    private static long allocated() {
+        return MX.getThreadAllocatedBytes(Thread.currentThread().getId());
+    }
+
+    /** One scenario = the same list of (position, block) edits applied and relit on a fresh world. */
+    private static void run(String name, int[][] edits, IBlockData[] states) throws Exception {
+        long oldNanos = Long.MAX_VALUE;
+        long newNanos = Long.MAX_VALUE;
+        long oldBytes = 0;
+        long newBytes = 0;
+        for (int round = 0; round < 5; ++round) {
+            LightPropagationParityTest.StubProvider[] ha = new LightPropagationParityTest.StubProvider[1];
+            LightPropagationParityTest.StubProvider[] hb = new LightPropagationParityTest.StubProvider[1];
+            WorldServer oldWorld = LightPropagationParityTest.buildWorld(3, ha);
+            WorldServer newWorld = LightPropagationParityTest.buildWorld(3, hb);
+
+            long b0 = allocated();
+            long t0 = System.nanoTime();
+            for (int i = 0; i < edits.length; ++i) {
+                LightPropagationParityTest.setBlock(oldWorld, edits[i][0], edits[i][1], edits[i][2], states[i]);
+                sink += LightPropagationParityTest.oldW(oldWorld, new BlockPosition(edits[i][0], edits[i][1], edits[i][2])) ? 1 : 0;
+            }
+            oldNanos = Math.min(oldNanos, System.nanoTime() - t0);
+            oldBytes = allocated() - b0;
+
+            b0 = allocated();
+            t0 = System.nanoTime();
+            for (int i = 0; i < edits.length; ++i) {
+                LightPropagationParityTest.setBlock(newWorld, edits[i][0], edits[i][1], edits[i][2], states[i]);
+                sink += newWorld.w(new BlockPosition(edits[i][0], edits[i][1], edits[i][2])) ? 1 : 0;
+            }
+            newNanos = Math.min(newNanos, System.nanoTime() - t0);
+            newBytes = allocated() - b0;
+
+            LightPropagationParityTest.assertSameLight(oldWorld, newWorld, name);
+        }
+        System.out.println("[perf] light " + name + ": old=" + oldNanos / 1000 + "us/" + oldBytes / 1024 + "KiB new=" + newNanos / 1000 + "us/" + newBytes / 1024
+                + "KiB time=" + String.format("%.2f", (double) oldNanos / Math.max(1, newNanos)) + "x alloc=" + String.format("%.1f", (double) oldBytes / Math.max(1, newBytes)) + "x");
+        assertTrue(name + ": the new propagation must allocate clearly less", newBytes * 2 < oldBytes);
+        assertTrue(name + ": the new propagation must not be slower", newNanos <= oldNanos);
+    }
+
+    @Test
+    public void lightEmittingPasteTorchTogglesAndMixedEdits() throws Exception {
+        // A 6x6x6 glowstone cube placed block by block: every placement relights a radius-15 volume (a light-emitting paste).
+        int n = 6 * 6 * 6;
+        int[][] cube = new int[n][];
+        IBlockData[] glow = new IBlockData[n];
+        int i = 0;
+        for (int x = -3; x < 3; ++x) {
+            for (int y = 20; y < 26; ++y) {
+                for (int z = -3; z < 3; ++z) {
+                    cube[i] = new int[] {x, y, z};
+                    glow[i++] = Blocks.GLOWSTONE.getBlockData();
+                }
+            }
+        }
+        run("glowstone cube paste (216 blocks)", cube, glow);
+
+        java.util.Random random = new java.util.Random(8);
+        int[][] torches = new int[400][];
+        IBlockData[] states = new IBlockData[400];
+        for (int k = 0; k < torches.length; ++k) {
+            torches[k] = new int[] {random.nextInt(24) - 12, 5 + random.nextInt(3), random.nextInt(24) - 12};
+            states[k] = k % 2 == 0 ? Blocks.TORCH.getBlockData() : Blocks.AIR.getBlockData();
+        }
+        run("torch place/remove (400)", torches, states);
+
+        int[][] mixed = new int[1500][];
+        IBlockData[] mixedStates = new IBlockData[1500];
+        for (int k = 0; k < mixed.length; ++k) {
+            mixed[k] = new int[] {random.nextInt(28) - 14, 1 + random.nextInt(random.nextInt(4) == 0 ? 80 : 14), random.nextInt(28) - 14};
+            mixedStates[k] = LightPropagationParityTest.block(random.nextInt(6));
+        }
+        run("mixed random edits (1500)", mixed, mixedStates);
+    }
+}
