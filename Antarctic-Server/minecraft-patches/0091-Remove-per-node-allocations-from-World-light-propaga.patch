+    }
+
+    static void assertSameLight(World a, World b, String message) {
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                ChunkSection[] sa = a.getChunkIfLoaded(cx, cz).getSections();
+                ChunkSection[] sb = b.getChunkIfLoaded(cx, cz).getSections();
+                for (int i = 0; i < 16; ++i) {
+                    assertArrayEquals(message + " sky chunk " + cx + "," + cz + " section " + i, sa[i].getSkyLightArray().asBytes(), sb[i].getSkyLightArray().asBytes());
+                    assertArrayEquals(message + " block chunk " + cx + "," + cz + " section " + i, sa[i].getEmittedLightArray().asBytes(), sb[i].getEmittedLightArray().asBytes());
+                }
+            }
+        }
+    }
+
+    // ----------------------------------------------------------------- tests
+
+    @Test
+    public void randomizedBlockChangesLeaveIdenticalLight() throws Exception {
+        for (long seed = 1; seed <= 6; ++seed) {
+            StubProvider[] ha = new StubProvider[1];
+            StubProvider[] hb = new StubProvider[1];
+            WorldServer oldWorld = buildWorld(seed, ha);
+            WorldServer newWorld = buildWorld(seed, hb);
+            assertSameLight(oldWorld, newWorld, "initial");
+            Random random = new Random(seed * 77);
+            int changed = 0;
+            for (int op = 0; op < 400; ++op) {
+                int x = random.nextInt(28) - 14; // the radius-17 search plus its neighbor reads must stay inside the loaded -32..31
+                int z = random.nextInt(28) - 14;
+                int y = 1 + random.nextInt(random.nextInt(4) == 0 ? 80 : 14);
+                IBlockData state = block(random.nextInt(6));
+                setBlock(oldWorld, x, y, z, state);
+                setBlock(newWorld, x, y, z, state);
+                BlockPosition pos = new BlockPosition(x, y, z);
+                boolean oldResult = oldW(oldWorld, pos);
+                boolean newResult = newWorld.w(pos);
+                assertEquals("return value seed=" + seed + " op=" + op, oldResult, newResult);
+                if (op % 25 == 24) {
+                    assertSameLight(oldWorld, newWorld, "seed=" + seed + " after op " + op);
+                }
+                ++changed;
+            }
+            assertSameLight(oldWorld, newWorld, "seed=" + seed + " final");
+            assertTrue(changed > 0);
+        }
+    }
