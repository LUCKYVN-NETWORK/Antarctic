+    @Test
+    public void permanentChunkLoaderOptionStillClearsTheUnloadFlag() throws Exception {
+        StubProvider[] holder = new StubProvider[1];
+        WorldServer world = buildWorld(4, holder);
+        Chunk chunk = world.getChunkIfLoaded(0, 0);
+        // allow-permanent-chunk-loaders = false (the default): neither path touches Chunk.d
+        chunk.d = true;
+        world.getBrightness(EnumSkyBlock.BLOCK, 3, 10, 3);
+        assertTrue(chunk.d);
+        world.getBrightness(EnumSkyBlock.BLOCK, new BlockPosition(3, 10, 3));
+        assertTrue(chunk.d);
+        // true: the old path went through getLoadedChunkAt, which clears the flag; the int path must as well
+        world.paperConfig.allowPermaChunkLoaders = true;
+        chunk.d = true;
+        world.getBrightness(EnumSkyBlock.BLOCK, new BlockPosition(3, 10, 3));
+        assertFalse(chunk.d);
+        chunk.d = true;
+        world.getBrightness(EnumSkyBlock.BLOCK, 3, 10, 3);
+        assertFalse(chunk.d);
+    }
