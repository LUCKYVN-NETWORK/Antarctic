@@ -0,0 +1,80 @@
+package com.destroystokyo.paper.config.toml;
+
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+import org.bukkit.configuration.ConfigurationSection;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.bukkit.configuration.InvalidConfigurationException;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * One-shot antarctic.yml -> antarctic.toml migrator, run when the TOML file
+ * does not exist yet. The legacy file is renamed to antarctic.yml.migrated
+ * only after the TOML was written, so no setting can be lost.
+ * Adapted from the Leaf legacy converter (Winds-Studio/Leaf, GPL-3.0-only),
+ * org.dreeam.leaf.config.legacy.upgrader.V1ToV200.
+ */
+final class AntarcticLegacyConverter {
+
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final Map<String, String> KEY_MIGRATIONS = new LinkedHashMap<>();
+
+    static {
+        KEY_MIGRATIONS.put("server-mod-name", "misc.rebrand.server-mod-name");
+        KEY_MIGRATIONS.put("redact-player-data", "misc.privacy.redact-player-data");
+        KEY_MIGRATIONS.put("compression-level", "network.deflate.compression-level");
+        KEY_MIGRATIONS.put("pathfinder.goal-selection-delay", "optimizations.pathfinder.goal-selection-delay");
+        KEY_MIGRATIONS.put("suffocation-optimization", "optimizations.suffocation.enable-suffocation-optimization");
+        KEY_MIGRATIONS.put("projectile.max-loads-per-tick", "optimizations.projectiles.max-loads-per-tick");
+        KEY_MIGRATIONS.put("projectile.max-loads-per-projectile", "optimizations.projectiles.max-loads-per-projectile");
+        KEY_MIGRATIONS.put("optimize-armourstands", "optimizations.armour-stands.enabled");
+        KEY_MIGRATIONS.put("no-chunks-past-world-border", "optimizations.world-border.no-chunks-past-world-border");
+        KEY_MIGRATIONS.put("improve-merge-checks", "gameplay.merge-checks.enabled");
+        KEY_MIGRATIONS.put("chunk-overload-dupe.allow", "gameplay.chunk-overload-dupe.allow");
+        KEY_MIGRATIONS.put("chunk-overload-dupe.log", "gameplay.chunk-overload-dupe.log");
+        KEY_MIGRATIONS.put("map-decorations-limit", "fixes.map-decorations.limit");
+        KEY_MIGRATIONS.put("enable-books", "fixes.books.enable-books");
+    }
+
+    private AntarcticLegacyConverter() {
+    }
+
+    static void convert(File legacyYaml, File tomlFile) throws IOException {
+        YamlConfiguration yaml = new YamlConfiguration();
+        try {
+            yaml.load(legacyYaml);
+        } catch (InvalidConfigurationException e) {
+            throw new IOException("Invalid legacy antarctic.yml", e);
+        }
+
+        File parent = tomlFile.getParentFile();
+        if (parent != null) parent.mkdirs();
+        tomlFile.createNewFile();
+        CommentedFileConfig toml = CommentedFileConfig.builder(tomlFile).sync().build();
+        toml.load();
+        for (Map.Entry<String, String> entry : KEY_MIGRATIONS.entrySet()) {
+            if (yaml.contains(entry.getKey())) {
+                toml.set(entry.getValue(), yaml.get(entry.getKey()));
+            }
+        }
+        toml.save();
+
+        for (String key : yaml.getKeys(true)) {
+            if (!KEY_MIGRATIONS.containsKey(key) && !(yaml.get(key) instanceof ConfigurationSection)) {
+                LOGGER.warn("Legacy config key {} has no antarctic.toml equivalent and was dropped", key);
+            }
+        }
+
+        try {
+            Files.move(legacyYaml.toPath(), legacyYaml.toPath().resolveSibling(legacyYaml.getName() + ".migrated"));
+        } catch (IOException e) {
+            LOGGER.error("Failed to rename {} after migration; it was already converted and will be ignored", legacyYaml.getName(), e);
+        }
+    }
+}
