diff --git a/test/java/com/destroystokyo/paper/config/toml/AntarcticTomlConfigTest.java b/test/java/com/destroystokyo/paper/config/toml/AntarcticTomlConfigTest.java
new file mode 100644
index 0000000..52e4dbb
--- /dev/null
+++ b/test/java/com/destroystokyo/paper/config/toml/AntarcticTomlConfigTest.java
@@ -0,0 +1,87 @@
+package com.destroystokyo.paper.config.toml;
+
+import com.destroystokyo.paper.config.toml.modules.fixes.Books;
+import com.destroystokyo.paper.config.toml.modules.misc.Rebrand;
+import com.destroystokyo.paper.config.toml.modules.network.Deflate;
+import com.destroystokyo.paper.config.toml.modules.optimizations.Pathfinder;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+import static org.junit.Assert.*;
+
+public class AntarcticTomlConfigTest {
+    @Rule public TemporaryFolder temporary = new TemporaryFolder();
+
+    @Test public void createsNestedFileAndReloadsWithoutRecursiveSave() throws Exception {
+        File file = new File(temporary.getRoot(), "nested/antarctic.toml");
+        int before = AntarcticTomlConfig.getUpdates();
+        AntarcticTomlConfig.load(file);
+        assertTrue(file.isFile());
+        assertEquals(-1, Deflate.compressionLevel);
+        assertEquals("Antarctic", Rebrand.serverModName);
+        assertEquals(before + 1, AntarcticTomlConfig.getUpdates());
+        assertEquals(-1, (int) AntarcticTomlConfig.getYamlFacade().getInt("network.deflate.compression-level"));
+
+        Files.write(file.toPath(), "[network.deflate]\ncompression-level = 6\n".getBytes(StandardCharsets.UTF_8));
+        AntarcticTomlConfig.load();
+        assertEquals(6, Deflate.compressionLevel);
+        assertEquals(before + 2, AntarcticTomlConfig.getUpdates());
+        assertEquals(6, (int) AntarcticTomlConfig.getYamlFacade().getInt("network.deflate.compression-level"));
+    }
+
+    @Test public void rejectsMalformedTomlWithoutOverwritingIt() throws Exception {
+        File file = temporary.newFile("invalid.toml");
+        String invalid = "broken = [unterminated\n";
+        Files.write(file.toPath(), invalid.getBytes(StandardCharsets.UTF_8));
+        int before = AntarcticTomlConfig.getUpdates();
+        try {
+            AntarcticTomlConfig.load(file);
+            fail("Malformed TOML must fail to load");
+        } catch (IOException expected) {
+            assertNotNull(expected.getCause());
+        }
+        assertEquals(invalid, new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8));
+        assertEquals(before, AntarcticTomlConfig.getUpdates());
+    }
+
+    @Test public void validatesPathfinderIntervalAndPreservesInvalidFile() throws Exception {
+        File file = temporary.newFile("pathfinder.toml");
+        Files.write(file.toPath(), "[optimizations.pathfinder]\ngoal-selection-delay = 7\n".getBytes(StandardCharsets.UTF_8));
+        AntarcticTomlConfig.load(file);
+        assertEquals(7, Pathfinder.goalSelectionDelay);
+        String invalid = "[optimizations.pathfinder]\ngoal-selection-delay = 0\n";
+        Files.write(file.toPath(), invalid.getBytes(StandardCharsets.UTF_8));
+        int before = AntarcticTomlConfig.getUpdates();
+        try {
+            AntarcticTomlConfig.load(file);
+            fail("Zero interval must be rejected");
+        } catch (IOException expected) {
+            assertNotNull(expected.getCause());
+        }
+        assertEquals(7, Pathfinder.goalSelectionDelay);
+        assertEquals(before, AntarcticTomlConfig.getUpdates());
+        assertEquals(invalid, new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8));
+    }
+
+    @Test public void migratesLegacyYamlToToml() throws Exception {
+        File dir = temporary.newFolder("migrate");
+        File legacy = new File(dir, "antarctic.yml");
+        Files.write(legacy.toPath(), "server-mod-name: TestServer\ncompression-level: 6\nenable-books: false\n"
+                .getBytes(StandardCharsets.UTF_8));
+        File toml = new File(dir, "antarctic.toml");
+        AntarcticTomlConfig.load(toml);
+        assertTrue(toml.isFile());
+        assertFalse(legacy.isFile());
+        assertTrue(new File(dir, "antarctic.yml.migrated").isFile());
+        assertEquals("TestServer", Rebrand.serverModName);
+        assertEquals(6, Deflate.compressionLevel);
+        assertFalse(Books.enableBooks);
+        assertEquals("TestServer", AntarcticTomlConfig.getYamlFacade().getString("misc.rebrand.server-mod-name"));
+    }
+}
