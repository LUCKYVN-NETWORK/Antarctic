@@ -0,0 +1,183 @@
+package com.destroystokyo.paper.config.toml;
+
+import com.destroystokyo.paper.config.toml.annotations.ConfigInfo;
+import com.destroystokyo.paper.config.toml.annotations.DoNotLoad;
+import com.destroystokyo.paper.config.toml.annotations.HotReloadUnsupported;
+import com.destroystokyo.paper.config.toml.modules.fixes.Books;
+import com.destroystokyo.paper.config.toml.modules.fixes.MapDecorations;
+import com.destroystokyo.paper.config.toml.modules.gameplay.ChunkOverloadDupe;
+import com.destroystokyo.paper.config.toml.modules.gameplay.MergeChecks;
+import com.destroystokyo.paper.config.toml.modules.misc.Privacy;
+import com.destroystokyo.paper.config.toml.modules.misc.Rebrand;
+import com.destroystokyo.paper.config.toml.modules.network.Deflate;
+import com.destroystokyo.paper.config.toml.modules.optimizations.ArmourStands;
+import com.destroystokyo.paper.config.toml.modules.optimizations.Pathfinder;
+import com.destroystokyo.paper.config.toml.modules.optimizations.Projectiles;
+import com.destroystokyo.paper.config.toml.modules.optimizations.Suffocation;
+import com.destroystokyo.paper.config.toml.modules.optimizations.WorldBorder;
+import com.electronwill.nightconfig.core.file.CommentedFileConfig;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+import org.bukkit.configuration.file.YamlConfiguration;
+
+import java.io.File;
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * antarctic.toml engine. Thread-safe reads via a synchronized CommentedFileConfig;
+ * loads, saves and reloads run on the main server thread. Night-Config 3.8.0's
+ * ofConcurrent() builds an AsyncFileConfig whose save() is debounced to a background
+ * executor, which would lose writes on crash; builder().sync() keeps them durable.
+ * Adapted from Leaf Config v2 and the Leaf legacy converter
+ * (Winds-Studio/Leaf, GPL-3.0-only), org.dreeam.leaf.config.LeafConfig.
+ */
+public final class AntarcticTomlConfig {
+
+    private static final Logger LOGGER = LogManager.getLogger();
+    private static final List<IConfigModule> MODULES = List.of(
+            new Rebrand(), new Privacy(),
+            new Deflate(),
+            new Pathfinder(), new Suffocation(), new Projectiles(), new ArmourStands(), new WorldBorder(),
+            new MergeChecks(), new ChunkOverloadDupe(),
+            new MapDecorations(), new Books());
+    private static final YamlConfiguration yamlFacade = new YamlConfiguration();
+    private static File configFile = new File("antarctic.toml");
+    private static CommentedFileConfig configFileInstance;
+    private static int updates;
+    private static boolean initialized;
+
+    private AntarcticTomlConfig() {
+    }
+
+    public static void load(File file) throws IOException {
+        configFile = file;
+        load();
+    }
+
+    public static void load() throws IOException {
+        if (!configFile.exists()) {
+            File legacy = new File(configFile.getParentFile(), "antarctic.yml");
+            if (legacy.isFile()) {
+                AntarcticLegacyConverter.convert(legacy, configFile);
+                LOGGER.info("Migrated legacy antarctic.yml to {}", configFile.getName());
+            } else {
+                File parent = configFile.getParentFile();
+                if (parent != null) parent.mkdirs();
+                configFile.createNewFile();
+            }
+        }
+
+        CommentedFileConfig previous = configFileInstance;
+        configFileInstance = CommentedFileConfig.builder(configFile).sync().build();
+        try {
+            configFileInstance.load();
+        } catch (RuntimeException e) {
+            configFileInstance = previous;
+            throw new IOException("Invalid Antarctic configuration", e);
+        }
+
+        configFileInstance.setComment("", "Antarctic configuration\nGenerated from antarctic.toml; comments are preserved on save.");
+
+        Map<Field, Object> snapshot = new HashMap<>();
+        try {
+            for (IConfigModule module : MODULES) {
+                loadModule(module, snapshot);
+            }
+        } catch (IllegalAccessException | RuntimeException e) {
+            restore(snapshot);
+            configFileInstance = previous;
+            throw new IOException("Failed to load Antarctic configuration", e);
+        }
+
+        configFileInstance.save();
+        rebuildYamlFacade();
+        updates++;
+        initialized = true;
+    }
+
+    public static CommentedFileConfig getTomlConfig() {
+        return Objects.requireNonNull(configFileInstance, "antarctic.toml has not been loaded yet");
+    }
+
+    /** Binary-compat facade for plugins and TimingsExport, mirroring the TOML values. */
+    public static YamlConfiguration getYamlFacade() {
+        return yamlFacade;
+    }
+
+    public static int getUpdates() {
+        return updates;
+    }
+
+    private static void loadModule(IConfigModule module, Map<Field, Object> snapshot) throws IllegalAccessException {
+        for (Field field : module.getClass().getDeclaredFields()) {
+            if (!Modifier.isStatic(field.getModifiers()) || Modifier.isFinal(field.getModifiers())) continue;
+            if (field.isAnnotationPresent(DoNotLoad.class)) continue;
+            ConfigInfo info = field.getAnnotation(ConfigInfo.class);
+            if (info == null) continue;
+            if (initialized && field.isAnnotationPresent(HotReloadUnsupported.class)) continue;
+
+            String key = configKey(module, info);
+            field.setAccessible(true);
+            snapshot.put(field, field.get(null));
+
+            Object value;
+            if (configFileInstance.contains(key)) {
+                value = coerce(configFileInstance.get(key), field.getType());
+            } else {
+                value = field.get(null);
+                if (value == null) throw new IllegalStateException("Config default for " + key + " must not be null");
+                if (!info.comments().isBlank()) configFileInstance.setComment(key, info.comments());
+                configFileInstance.set(key, value);
+            }
+            field.set(null, value);
+        }
+        module.onLoaded(configFileInstance);
+    }
+
+    private static String configKey(IConfigModule module, ConfigInfo info) {
+        return module.getCategory().getBaseKeyName() + "." + module.getBaseName() + "." + info.baseName();
+    }
+
+    /** TOML integers may parse as Long; unbox to the field's primitive type. */
+    private static Object coerce(Object value, Class<?> type) {
+        if (value instanceof Number) {
+            if (type == int.class) return ((Number) value).intValue();
+            if (type == long.class) return ((Number) value).longValue();
+            if (type == double.class) return ((Number) value).doubleValue();
+            if (type == float.class) return ((Number) value).floatValue();
+        }
+        return value;
+    }
+
+    private static void restore(Map<Field, Object> snapshot) {
+        for (Map.Entry<Field, Object> entry : snapshot.entrySet()) {
+            try {
+                entry.getKey().set(null, entry.getValue());
+            } catch (IllegalAccessException ignored) {
+            }
+        }
+    }
+
+    private static void rebuildYamlFacade() {
+        for (String key : new ArrayList<>(yamlFacade.getKeys(false))) {
+            yamlFacade.set(key, null);
+        }
+        for (IConfigModule module : MODULES) {
+            for (Field field : module.getClass().getDeclaredFields()) {
+                ConfigInfo info = field.getAnnotation(ConfigInfo.class);
+                if (info == null) continue;
+                try {
+                    yamlFacade.set(configKey(module, info), field.get(null));
+                } catch (IllegalAccessException ignored) {
+                }
+            }
+        }
+    }
+}
