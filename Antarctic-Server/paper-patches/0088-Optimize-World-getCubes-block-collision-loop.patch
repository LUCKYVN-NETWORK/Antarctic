+package net.minecraft.server;
+
+import com.destroystokyo.paper.config.toml.modules.optimizations.Physics;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class VoxelCollisionTest {
+
+    @BeforeClass
+    public static void setUp() {
+        DispenserRegistry.c();
+    }
+
+    @Test
+    public void testPhysicsConfigDefault() {
+        assertTrue(Physics.optimizeVoxelCollisions);
+    }
+
+    @Test
+    public void testVoxelFastCacheClassification() {
+        assertTrue(me.stella.antarctic.spatial.FastVoxelCache.isEmpty(Blocks.AIR.getBlockData()));
+        assertTrue(me.stella.antarctic.spatial.FastVoxelCache.isFullCube(Blocks.STONE.getBlockData()));
+        assertFalse(me.stella.antarctic.spatial.FastVoxelCache.isFullCube(Blocks.OAK_STAIRS.getBlockData()));
+    }
