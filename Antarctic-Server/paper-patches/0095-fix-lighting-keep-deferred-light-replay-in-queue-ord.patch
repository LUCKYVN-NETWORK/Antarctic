+    /** Straightforward reference: per-chunk insertion-ordered lists plus a plain list of ready chunks, oldest first. */
+    private static final class Model {
+        final java.util.Map<Long, java.util.LinkedHashSet<Integer>> pending = new java.util.HashMap<Long, java.util.LinkedHashSet<Integer>>();
+        final java.util.List<Long> ready = new ArrayList<Long>();
+        int total;
+
+        boolean add(long key, int packed, int cap) {
+            java.util.LinkedHashSet<Integer> set = pending.get(key);
+            if (set != null && set.contains(packed)) {
+                return false;
+            }
+            if (total >= cap) {
+                return false;
+            }
+            if (set == null) {
+                set = new java.util.LinkedHashSet<Integer>();
+                pending.put(key, set);
+            }
+            set.add(packed);
+            ++total;
+            return true;
+        }
+
+        void markReady(long key) {
+            if (pending.containsKey(key) && !ready.contains(key)) {
+                ready.add(key);
+            }
+        }
+
+        void clear(long key) {
+            java.util.LinkedHashSet<Integer> set = pending.remove(key);
+            if (set != null) {
+                total -= set.size();
+            }
+            ready.remove(key);
+        }
+
+        List<long[]> drain(int budget, java.util.Map<Long, Integer> gates) {
+            List<long[]> out = new ArrayList<long[]>();
+            while (out.size() < budget && !ready.isEmpty()) {
+                long key = ready.get(0);
+                int gate = gates.getOrDefault(key, PendingLightRegistry.Gate.READY);
+                if (gate == PendingLightRegistry.Gate.GONE) {
+                    clear(key);
+                    continue;
+                }
+                if (gate == PendingLightRegistry.Gate.WAIT) {
+                    ready.remove(0);
+                    continue;
+                }
+                java.util.LinkedHashSet<Integer> set = pending.get(key);
+                java.util.Iterator<Integer> it = set.iterator();
+                int take = Math.min(budget - out.size(), set.size());
+                for (int i = 0; i < take; ++i) {
+                    int packed = it.next();
+                    it.remove();
+                    out.add(new long[] {key, PendingLightRegistry.unpackX(packed), PendingLightRegistry.unpackY(packed),
+                            PendingLightRegistry.unpackZ(packed), PendingLightRegistry.unpackSky(packed) ? 1 : 0});
+                }
+                total -= take;
+                if (set.isEmpty()) {
+                    pending.remove(key);
+                    ready.remove(0);
+                }
+            }
+            return out;
+        }
+    }
+
+    @Test
+    public void randomOperationSequencesMatchAReferenceModel() {
+        for (long seed = 1; seed <= 300; ++seed) {
+            java.util.Random random = new java.util.Random(seed);
+            int cap = 5 + random.nextInt(40);
+            PendingLightRegistry registry = new PendingLightRegistry(cap);
+            Model model = new Model();
+            for (int step = 0; step < 400; ++step) {
+                long key = random.nextInt(6);
+                switch (random.nextInt(5)) {
+                    case 0:
+                    case 1: {
+                        int packed = PendingLightRegistry.pack(random.nextInt(4), random.nextInt(4), random.nextInt(4), random.nextBoolean());
+                        assertEquals("seed " + seed + " step " + step + " add", model.add(key, packed, cap), registry.add(key, packed));
+                        break;
+                    }
+                    case 2:
+                        model.markReady(key);
+                        registry.markReady(key);
+                        break;
+                    case 3:
+                        model.clear(key);
+                        registry.clearChunk(key);
+                        break;
+                    default: {
+                        java.util.Map<Long, Integer> gates = new java.util.HashMap<Long, Integer>();
+                        for (long k = 0; k < 6; ++k) {
+                            int roll = random.nextInt(8);
+                            gates.put(k, roll == 0 ? PendingLightRegistry.Gate.WAIT : roll == 1 ? PendingLightRegistry.Gate.GONE : PendingLightRegistry.Gate.READY);
+                        }
+                        int budget = 1 + random.nextInt(7);
+                        Recorder recorder = new Recorder();
+                        registry.drain(budget, key2 -> gates.get(key2), recorder);
+                        List<long[]> expected = model.drain(budget, gates);
+                        assertEquals("seed " + seed + " step " + step + " drained count", expected.size(), recorder.seen.size());
+                        for (int i = 0; i < expected.size(); ++i) {
+                            assertTrue("seed " + seed + " step " + step + " entry " + i,
+                                    java.util.Arrays.equals(expected.get(i), recorder.seen.get(i)));
+                        }
+                    }
+                }
+                assertEquals("seed " + seed + " step " + step + " size", model.total, registry.size());
+                assertEquals("seed " + seed + " step " + step + " chunks", model.pending.size(), registry.pendingChunks());
+            }
+        }
+    }
