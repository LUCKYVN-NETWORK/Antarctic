+    @Test
+    public void emissionOneAndScratchReuseMatchStatelessAndPassChecker() {
+        LightScene scene = new LightScene(0, 0, 3, 3, true).onlyTarget(1, 1);
+        scene.fill(16, 0, 16, 31, 0, 31, 15, 0); // bedrock floor at y=0
+        scene.set(20, 1, 20, 0, 1); // emission=1 (brown mushroom) at y=1
+        scene.set(22, 255, 22, 0, 1); // emission=1 at y=255
+        scene.deriveHeights();
+
+        LightRegion regionStateless = scene.region();
+        LightRegion regionScratch = scene.region();
+        LightResult r1 = ENGINE.relight(regionStateless);
+        LightEngine.Scratch scratch = new LightEngine.Scratch();
+        ENGINE.relight(regionScratch, scratch); // prime scratch
+        LightResult r2 = ENGINE.relight(regionScratch, scratch);
+
+        assertEquals(r1.cellsRaised(), r2.cellsRaised());
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            org.junit.Assert.assertArrayEquals("sky section " + s, r1.sky(1, 1, s), r2.sky(1, 1, s));
+            org.junit.Assert.assertArrayEquals("block section " + s, r1.block(1, 1, s), r2.block(1, 1, s));
+        }
+
+        r2.storeInto(regionScratch);
+        assertEquals(1, regionScratch.column(1, 1).stored(false, 4, 1, 4));
+        assertEquals(0, regionScratch.column(1, 1).stored(false, 5, 1, 4));
+        assertEquals(1, regionScratch.column(1, 1).stored(false, 6, 255, 6));
+        assertTrue(LightChecker.check(regionScratch, 1, 1, LightChecker.Scope.ALL, 16).consistent());
+    }
+
+    @Test
+    public void prunedCheckerMatchesFullScanCountsWithAbsentNeighboursAndStaleHeightMap() {
+        // Pure void with one absent horizontal neighbour: tests pruned-layer checked/skipped accounting
+        LightScene voidScene = new LightScene(0, 0, 3, 3, true).onlyTarget(1, 1);
+        voidScene.absent(0, 1); // west neighbour missing
+        voidScene.deriveHeights();
+        LightRegion voidRegion = voidScene.region();
+        LightChecker.Report allReport = LightChecker.check(voidRegion, 1, 1, LightChecker.Scope.ALL, 8);
+        assertTrue(allReport.consistent());
+        assertEquals("sky all 256*256 + block (256-16)*256", 256 * 256 + 240 * 256, allReport.checked());
+        assertEquals("block west edge 16*256 skipped", 16 * 256, allReport.skipped());
+
+        // Stale heightmap on an otherwise empty column must still be checked up to maxH
+        LightRegion stale = new LightScene(0, 0, 3, 3, true).onlyTarget(1, 1).region();
+        stale.column(1, 1).heightMap()[0] = 120; // stale height=120 with no storedSky -> sky=0 below 120 vs neighbour 15
+        LightChecker.Report staleReport = LightChecker.check(stale, 1, 1, LightChecker.Scope.ALL, 16);
+        assertFalse("pruned checker must still detect violations caused by stale high heightmap", staleReport.consistent());
+    }
