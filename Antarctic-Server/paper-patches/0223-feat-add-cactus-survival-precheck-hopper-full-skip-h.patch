+    static void cooldownHopperWhenFull(IHopper hopper) {
+        int skipTicks = com.destroystokyo.paper.config.toml.modules.optimizations.Hopper.throttleWhenFullSkipTicks;
+        if (skipTicks <= 0) {
+            cooldownHopper(hopper);
+            return;
+        }
+        if (hopper instanceof TileEntityHopper) {
+            ((TileEntityHopper) hopper).setCooldown(skipTicks);
+        } else if (hopper instanceof EntityMinecartHopper) {
+            ((EntityMinecartHopper) hopper).setCooldown(Math.max(1, skipTicks / 2));
+        }
+    }
