+
+    private static final class MockWorld extends World {
+        final Map<BlockPosition, IBlockData> blocks = new HashMap<>();
+        final List<Entity> addedEntities = new ArrayList<>();
+
+        MockWorld() throws Exception {
+            super(null, null, null, null, false, null, null);
+        }
+
+        @Override
+        protected IChunkProvider n() {
+            return null;
+        }
+
+        @Override
+        protected boolean isChunkLoaded(int i, int j, boolean flag) {
+            return true;
+        }
+
+        @Override
+        public IBlockData getType(BlockPosition pos) {
+            return blocks.getOrDefault(pos, Blocks.AIR.getBlockData());
+        }
+
+        @Override
+        public boolean setTypeAndData(BlockPosition pos, IBlockData data, int flags) {
+            blocks.put(pos.h(), data);
+            return true;
+        }
+
+        @Override
+        public boolean isEmpty(BlockPosition pos) {
+            return getType(pos).getMaterial() == Material.AIR;
+        }
+
+        @Override
+        public boolean addEntity(Entity entity) {
+            addedEntities.add(entity);
+            return true;
+        }
+    }
+
+    private static MockWorld newMockWorld() throws Exception {
+        MockWorld world = (MockWorld) UNSAFE.allocateInstance(MockWorld.class);
+        Field bField = MockWorld.class.getDeclaredField("blocks");
+        bField.setAccessible(true);
+        bField.set(world, new HashMap<BlockPosition, IBlockData>());
+        Field aeField = MockWorld.class.getDeclaredField("addedEntities");
+        aeField.setAccessible(true);
+        aeField.set(world, new ArrayList<Entity>());
+
+        Field randField = World.class.getDeclaredField("random");
+        randField.setAccessible(true);
+        randField.set(world, new Random(7L));
+
+        WorldData wd = new WorldData() {};
+        Field wdField = World.class.getDeclaredField("worldData");
+        wdField.setAccessible(true);
+        wdField.set(world, wd);
+
+        Field wpField = World.class.getDeclaredField("worldProvider");
+        wpField.setAccessible(true);
+        wpField.set(world, new WorldProviderNormal());
+
+        PaperWorldConfig pwc = (PaperWorldConfig) UNSAFE.allocateInstance(PaperWorldConfig.class);
+        pwc.cactusMaxHeight = 3;
+        Field pwcField = World.class.getDeclaredField("paperConfig");
+        pwcField.setAccessible(true);
+        pwcField.set(world, pwc);
+
+        SpigotWorldConfig swc = (SpigotWorldConfig) UNSAFE.allocateInstance(SpigotWorldConfig.class);
+        swc.cactusModifier = 100;
+        swc.hopperTransfer = 8;
+        Field swcField = World.class.getDeclaredField("spigotConfig");
+        swcField.setAccessible(true);
+        swcField.set(world, swc);
+
+        return world;
+    }
+
+    @Test
+    public void testCactusSurvivalPrecheckDropsWithoutPlacing() throws Exception {
+        Growth.cactusCheckSurvival = true;
+        MockWorld world = newMockWorld();
+        BlockPosition cactusPos = new BlockPosition(0, 64, 0);
+        BlockPosition upPos = cactusPos.up();
+        world.blocks.put(cactusPos.down(), Blocks.SAND.getBlockData());
+        IBlockData age15 = Blocks.CACTUS.getBlockData().set(BlockCactus.AGE, 15);
+        world.blocks.put(cactusPos, age15);
+        // Solid stone adjacent to upPos -> cactus cannot survive at upPos
+        world.blocks.put(upPos.north(), Blocks.STONE.getBlockData());
+
+        Blocks.CACTUS.b(world, cactusPos, age15, world.random);
+
+        // Parent age reset to 0, upPos stayed AIR (never placed), cactus item dropped
+        assertEquals(Integer.valueOf(0), world.blocks.get(cactusPos).get(BlockCactus.AGE));
+        assertEquals(Blocks.AIR, world.blocks.getOrDefault(upPos, Blocks.AIR.getBlockData()).getBlock());
+        assertEquals(1, world.addedEntities.size());
+        assertTrue(world.addedEntities.get(0) instanceof EntityItem);
+    }
+
+    @Test
+    public void testHopperFullSkipTicksConfig() throws Exception {
+        MockWorld world = newMockWorld();
+        world.spigotConfig.hopperTransfer = 12;
+
+        TileEntityHopper hopper = new TileEntityHopper();
+        hopper.a(world);
+        Field cdField = TileEntityHopper.class.getDeclaredField("f");
+        cdField.setAccessible(true);
+
+        Hopper.throttleWhenFullSkipTicks = 8;
+        TileEntityHopper.cooldownHopperWhenFull(hopper);
+        assertEquals(8, cdField.getInt(hopper));
+
+        Hopper.throttleWhenFullSkipTicks = 20;
+        TileEntityHopper.cooldownHopperWhenFull(hopper);
+        assertEquals(20, cdField.getInt(hopper));
+
+        Hopper.throttleWhenFullSkipTicks = 0;
+        TileEntityHopper.cooldownHopperWhenFull(hopper);
+        assertEquals(12, cdField.getInt(hopper));
+    }
+
+    @Test
+    public void testPlayerInventoryOnlyTickItemsInHand() throws Exception {
+        final List<String> ticked = new ArrayList<>();
+        Item recordingItem = new Item() {
+            @Override
+            public void a(ItemStack itemstack, World world, Entity entity, int slot, boolean selected) {
+                ticked.add(slot + ":" + selected);
+            }
+        };
+
+        EntityPlayer player = (EntityPlayer) UNSAFE.allocateInstance(EntityPlayer.class);
+        PlayerInventory inv = new PlayerInventory(player);
+        inv.itemInHandIndex = 2;
+        inv.setItem(0, new ItemStack(recordingItem)); // hotbar 0 (not selected)
+        inv.setItem(2, new ItemStack(recordingItem)); // mainhand (selected)
+        inv.setItem(10, new ItemStack(recordingItem)); // main inventory
+        inv.extraSlots.set(0, new ItemStack(recordingItem)); // offhand
+
+        Inventory.onlyTickItemsInHand = false;
+        ticked.clear();
+        inv.n();
+        assertEquals(4, ticked.size());
+
+        Inventory.onlyTickItemsInHand = true;
+        ticked.clear();
+        inv.n();
+        assertEquals(List.of("2:true", "0:false"), ticked);
+    }
+
+    @Test
+    public void testVirtualThreadsTogglesForSchedulerAndProfileLookup() throws Exception {
+        // Test TileEntitySkull.createSkullExecutor()
+        VirtualThreads.profileLookup = false;
+        ExecutorService skullPlatform = TileEntitySkull.createSkullExecutor();
+        try {
+            Future<Boolean> f = skullPlatform.submit(() -> Thread.currentThread().isVirtual());
+            assertFalse(f.get());
+        } finally {
+            skullPlatform.shutdownNow();
+        }
+
+        VirtualThreads.profileLookup = true;
+        ExecutorService skullVirtual = TileEntitySkull.createSkullExecutor();
+        try {
+            Future<Boolean> f = skullVirtual.submit(() -> Thread.currentThread().isVirtual());
+            assertTrue(f.get());
+        } finally {
+            skullVirtual.shutdownNow();
+        }
+
+        // Test CraftAsyncScheduler.createExecutor() via package-private bridge
+        VirtualThreads.bukkitAsyncScheduler = false;
+        ExecutorService asyncPlatform = CraftAsyncSchedulerAccess.createExecutor();
+        try {
+            Future<Boolean> f = asyncPlatform.submit(() -> Thread.currentThread().isVirtual());
+            assertFalse(f.get());
+        } finally {
+            asyncPlatform.shutdownNow();
+        }
+
+        VirtualThreads.bukkitAsyncScheduler = true;
+        ExecutorService asyncVirtual = CraftAsyncSchedulerAccess.createExecutor();
+        try {
+            Future<Boolean> f = asyncVirtual.submit(() -> Thread.currentThread().isVirtual());
+            assertTrue(f.get());
+        } finally {
+            asyncVirtual.shutdownNow();
+        }
+    }
+}
