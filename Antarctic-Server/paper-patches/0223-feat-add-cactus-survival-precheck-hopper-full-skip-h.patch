+import static org.junit.Assert.*;
+
+public class Tier1OptimizationsConfigTest {
+
+    private static Unsafe UNSAFE;
+
+    private final boolean prevCactusCheck = Growth.cactusCheckSurvival;
+    private final int prevHopperSkip = Hopper.throttleWhenFullSkipTicks;
+    private final boolean prevOnlyInHand = Inventory.onlyTickItemsInHand;
+    private final boolean prevBukkitVirtual = VirtualThreads.bukkitAsyncScheduler;
+    private final boolean prevProfileVirtual = VirtualThreads.profileLookup;
+
+    @BeforeClass
+    public static void init() throws Exception {
+        DispenserRegistry.c();
+        Field f = Unsafe.class.getDeclaredField("theUnsafe");
+        f.setAccessible(true);
+        UNSAFE = (Unsafe) f.get(null);
+    }
+
+    @After
+    public void restoreConfig() {
+        Growth.cactusCheckSurvival = prevCactusCheck;
+        Hopper.throttleWhenFullSkipTicks = prevHopperSkip;
+        Inventory.onlyTickItemsInHand = prevOnlyInHand;
+        VirtualThreads.bukkitAsyncScheduler = prevBukkitVirtual;
+        VirtualThreads.profileLookup = prevProfileVirtual;
