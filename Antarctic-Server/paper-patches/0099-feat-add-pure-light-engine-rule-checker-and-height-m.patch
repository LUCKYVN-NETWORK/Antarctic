+++ b/test/java/me/stella/antarctic/light/LightEngineTest.java
@@ -0,0 +1,331 @@
+package me.stella.antarctic.light;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Random;
+import org.junit.Test;
+
+/** Hand-built scenes with values worked out by hand; the randomized comparison against a reference is LightEngineFuzzTest. */
+public class LightEngineTest {
+
+    private static final LightEngine ENGINE = new LightEngine();
+
+    private static int manhattan(int x0, int y0, int z0, int x1, int y1, int z1) {
+        return Math.abs(x0 - x1) + Math.abs(y0 - y1) + Math.abs(z0 - z1);
+    }
+
+    /** 3x3 chunks (0..2) with only the centre chunk computed. */
+    private static LightScene centreScene(boolean sky) {
+        return new LightScene(0, 0, 3, 3, sky).onlyTarget(1, 1);
+    }
+
+    @Test
+    public void aTorchInOpenAirFallsOffWithManhattanDistance() {
+        LightScene scene = centreScene(false);
+
+        scene.set(24, 64, 24, 0, 14);
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        for (int x = 16; x < 32; ++x) {
+            for (int z = 16; z < 32; ++z) {
+                for (int y = 48; y < 80; ++y) {
+                    int expected = Math.max(0, 14 - manhattan(x, y, z, 24, 64, 24));
+
+                    assertEquals("cell " + x + "," + y + "," + z, expected, scene.resultLight(result, false, x, y, z));
+                }
+            }
+        }
+    }
+
+    @Test
+    public void onlySectionsTheLightReachedAreCreated() {
+        LightScene scene = centreScene(false);
+
+        scene.set(24, 64, 24, 0, 14); // section 4 (y 64..79); light reaches y 50..78
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertNull("section 2 (y 32..47) is out of reach and does not exist", result.block(1, 1, 2));
+        assertNotNull("section 3 (y 48..63) receives light and must be created", result.block(1, 1, 3));
+        assertNotNull("section 4 exists", result.block(1, 1, 4));
+        assertNull("y 80 is 16 above the torch, out of reach", result.block(1, 1, 5));
+        assertNull("ring columns are never written", result.block(0, 1, 4));
+        assertNull("ring columns are never written", result.block(1, 0, 4));
+    }
+
+    @Test
+    public void translucentBlocksCostTheirOpacityAndStoneBlocks() {
+        LightScene scene = centreScene(false);
+
+        // a stone tube around a corridor of water-like cells (opacity 3), so light can only travel through the water
+        scene.fill(24, 63, 23, 30, 65, 25, 15, 0);
+        for (int x = 25; x <= 29; ++x) {
+            scene.set(x, 64, 24, 3, 0);
+        }
+
+        scene.set(24, 64, 24, 0, 14); // the torch sits at the mouth of the tube
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertEquals(14, scene.resultLight(result, false, 24, 64, 24));
+        assertEquals("first water cell: 14 - 3", 11, scene.resultLight(result, false, 25, 64, 24));
+        assertEquals(8, scene.resultLight(result, false, 26, 64, 24));
+        assertEquals(5, scene.resultLight(result, false, 27, 64, 24));
+        assertEquals(2, scene.resultLight(result, false, 28, 64, 24));
+        assertEquals("the fifth water cell would be -1", 0, scene.resultLight(result, false, 29, 64, 24));
+        assertEquals("a stone cell is never lit", 0, scene.resultLight(result, false, 25, 65, 24));
+        assertEquals("the open side of the torch is lit normally", 13, scene.resultLight(result, false, 23, 64, 24));
+    }
+
+    @Test
+    public void aTorchInsideAStoneBoxLightsOnlyItsCavity() {
+        LightScene scene = centreScene(false);
+
+        scene.fill(20, 60, 20, 28, 68, 28, 15, 0);
+        scene.fill(21, 61, 21, 27, 67, 27, 0, 0); // hollow 7x7x7
+        scene.set(24, 64, 24, 0, 14);
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertEquals("3 below the torch inside the cavity", 14 - 3, scene.resultLight(result, false, 24, 61, 24));
+        assertEquals("|dx| 3 + |dz| 2 inside the cavity", 14 - 5, scene.resultLight(result, false, 21, 64, 22));
+        assertEquals("the wall around the cavity is dark", 0, scene.resultLight(result, false, 20, 64, 24));
+        assertEquals("outside the box is dark", 0, scene.resultLight(result, false, 29, 64, 24));
+    }
+
+    @Test
+    public void anOpaqueEmitterPassesLightAtCostOneLikeVanilla() {
+        LightScene scene = centreScene(false);
+
+        scene.set(24, 64, 24, 0, 14);
+        scene.set(25, 64, 24, 15, 1); // opaque but emitting 1: vanilla gives it cost 1
+        scene.set(24, 64, 20, 15, 0); // a plain stone block elsewhere stays dark
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertEquals("max(emission 1, 14 - 1)", 13, scene.resultLight(result, false, 25, 64, 24));
+        assertEquals("light continues through it", 12, scene.resultLight(result, false, 26, 64, 24));
+        assertEquals(0, scene.resultLight(result, false, 24, 64, 20));
+    }
+
+    @Test
+    public void lightCrossesChunkBordersBetweenTargets() {
+        LightScene scene = new LightScene(0, 0, 2, 2, false);
+
+        scene.set(15, 64, 15, 0, 15); // the corner where four chunks meet
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        for (int x = 8; x < 24; ++x) {
+            for (int z = 8; z < 24; ++z) {
+                int expected = Math.max(0, 15 - manhattan(x, 64, z, 15, 64, 15));
+
+                assertEquals("cell " + x + "," + z, expected, scene.resultLight(result, false, x, 64, z));
+            }
+        }
+    }
+
+    @Test
+    public void ringLightIsAFixedInputForTheTargetEdge() {
+        LightScene scene = centreScene(false);
+
+        scene.deriveHeights();
+        scene.storeBlock(15, 64, 24, 15); // the ring chunk (0,1) holds 15 at its last column
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        for (int dx = 0; dx <= 14; ++dx) {
+            assertEquals("distance " + (dx + 1) + " from the ring cell", 15 - (dx + 1), scene.resultLight(result, false, 16 + dx, 64, 24));
+        }
+
+        assertEquals(14 - 1, scene.resultLight(result, false, 16, 65, 24));
+        assertNull("ring light is never rewritten", result.block(0, 1, 4));
+    }
+
+    @Test
+    public void anAbsentNeighbourContributesNothing() {
+        LightScene scene = centreScene(false);
+
+        scene.deriveHeights();
+        scene.storeBlock(15, 64, 24, 15);
+        scene.absent(0, 1);
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertEquals(0, scene.resultLight(result, false, 16, 64, 24));
+        assertEquals(0, result.cellsRaised());
+    }
+
+    @Test
+    public void openSkyIsFifteenAboveTheHeightAndSolidGroundIsDark() {
+        LightScene scene = centreScene(true);
+
+        for (int s = 0; s < 4; ++s) {
+            scene.section(1, 1, s);
+        }
+
+        scene.fill(16, 0, 16, 31, 63, 31, 15, 0);
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertEquals(64, scene.height(20, 20));
+        for (int y = 0; y < 64; ++y) {
+            assertEquals(0, scene.resultLight(result, true, 20, y, 20));
+        }
+
+        for (int y = 64; y < 256; ++y) {
+            assertEquals(15, scene.resultLight(result, true, 20, y, 20));
+        }
+
+        assertNull("sections above the ground do not exist and read 15 implicitly", result.sky(1, 1, 4));
+        assertNotNull(result.sky(1, 1, 3));
+        for (byte b : result.sky(1, 1, 3)) {
+            assertEquals("solid ground, all dark", 0, b);
+        }
+    }
+
+    @Test
+    public void skyLightLeaksUnderARoofAndFadesByOnePerBlock() {
+        LightScene scene = new LightScene(0, 0, 3, 3, true);
+
+        scene.fill(0, 0, 0, 47, 63, 47, 15, 0); // ground
+        scene.fill(8, 80, 8, 39, 80, 39, 15, 0); // roof slab y = 80
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertEquals("roof columns end at 81", 81, scene.height(24, 24));
+        assertEquals("open columns end at the ground", 64, scene.height(2, 2));
+        assertEquals("under the roof edge: one step from open air", 14, scene.resultLight(result, true, 8, 70, 24));
+        assertEquals(13, scene.resultLight(result, true, 9, 70, 24));
+        assertEquals("four steps in from x = 7", 10, scene.resultLight(result, true, 12, 70, 24));
+        assertEquals("a corner is fed from two sides but still two steps away", 13, scene.resultLight(result, true, 9, 70, 9));
+        assertEquals("sixteen steps in from the nearest open column, nothing is left", 0, scene.resultLight(result, true, 24, 70, 24));
+        assertNotNull("light spilled into the nonexistent section y 64..79 under the roof, so it is created", result.sky(1, 1, 4));
+        assertNull("above the roof the nonexistent section reads 15 implicitly and needs no array", result.sky(1, 1, 15));
+    }
+
+    @Test
+    public void aColumnCappedAtTheTopOfTheWorldReadsFifteenAboveY255() {
+        // every column has an opaque cap at y = 255 except (5, 5), which has a leaves-like cap: otherwise open columns
+        // beside it would feed sky light in sideways
+        LightScene scene = new LightScene(0, 0, 1, 1, true);
+
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                scene.set(x, 255, z, 15, 0);
+            }
+        }
+
+        scene.set(5, 255, 5, 1, 0);
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertEquals(256, scene.height(5, 5));
+        assertEquals("15 from above minus the cost 1", 14, scene.resultLight(result, true, 5, 255, 5));
+        assertEquals(13, scene.resultLight(result, true, 5, 254, 5));
+        assertEquals(1, scene.resultLight(result, true, 5, 242, 5));
+        assertEquals(0, scene.resultLight(result, true, 5, 241, 5));
+        assertEquals("the opaque caps stay dark", 0, scene.resultLight(result, true, 6, 255, 5));
+        assertEquals("and the light spreads sideways below them", 12, scene.resultLight(result, true, 6, 254, 5));
+        assertNull("section 14 (y 224..239) is out of reach and stays implicit", result.sky(0, 0, 14));
+        assertNotNull(result.sky(0, 0, 15));
+
+        LightScene sealed = new LightScene(0, 0, 1, 1, true);
+
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                sealed.set(x, 255, z, 15, 0);
+            }
+        }
+
+        sealed.deriveHeights();
+
+        LightResult dark = ENGINE.relight(sealed.region());
+
+        assertEquals(0, sealed.resultLight(dark, true, 5, 255, 5));
+        assertEquals(0, sealed.resultLight(dark, true, 5, 254, 5));
+        assertEquals(0, dark.cellsRaised());
+    }
+
+    @Test
+    public void worldsWithoutSkyLightProduceNoSkyArrays() {
+        LightScene scene = centreScene(false);
+
+        scene.set(24, 64, 24, 0, 10);
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            assertNull(result.sky(1, 1, s));
+        }
+
+        assertNotNull(result.block(1, 1, 4));
+    }
+
+    @Test
+    public void lightAlreadyStoredInTheTargetIsIgnoredBecauseTheResultIsFromScratch() {
+        LightScene clean = centreScene(true);
+        LightScene dirty = centreScene(true);
+        Random random = new Random(11);
+
+        for (LightScene scene : new LightScene[] {clean, dirty}) {
+            scene.fill(16, 0, 16, 31, 40, 31, 15, 0);
+            scene.set(24, 50, 24, 0, 13);
+            scene.deriveHeights();
+        }
+
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            byte[] sky = new byte[LightRules.NIBBLE_BYTES];
+            byte[] block = new byte[LightRules.NIBBLE_BYTES];
+
+            random.nextBytes(sky);
+            random.nextBytes(block);
+            dirty.storedSky[dirty.columnOfChunk(1, 1)][s] = sky;
+            dirty.storedBlock[dirty.columnOfChunk(1, 1)][s] = block;
+        }
+
+        LightResult a = ENGINE.relight(clean.region());
+        LightResult b = ENGINE.relight(dirty.region());
+
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            assertArrayEqualsNullSafe(a.sky(1, 1, s), b.sky(1, 1, s));
+            assertArrayEqualsNullSafe(a.block(1, 1, s), b.block(1, 1, s));
+        }
+    }
+
+    private static void assertArrayEqualsNullSafe(byte[] expected, byte[] actual) {
+        if (expected == null || actual == null) {
+            assertTrue(expected == actual);
+        } else {
+            org.junit.Assert.assertArrayEquals(expected, actual);
+        }
+    }
+
+    @Test
+    public void emptyTargetColumnsComputeNothing() {
+        LightScene scene = centreScene(false);
+
+        scene.deriveHeights();
+
+        LightResult result = ENGINE.relight(scene.region());
+
+        assertEquals(0, result.cellsRaised());
+        for (int s = 0; s < LightRules.SECTIONS; ++s) {
+            assertNull(result.block(1, 1, s));
+        }
+    }
+}
diff --git a/test/java/me/stella/antarctic/light/LightRulesTest.java b/test/java/me/stella/antarctic/light/LightRulesTest.java
new file mode 100644
index 0000000..8f278a3
--- /dev/null
+++ b/test/java/me/stella/antarctic/light/LightRulesTest.java
@@ -0,0 +1,97 @@
+package me.stella.antarctic.light;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Random;
+import me.stella.antarctic.collection.PendingLightRegistry;
+import org.junit.Test;
+
+public class LightRulesTest {
+
+    /** Vanilla's cost rule written out directly (World.a(BlockPosition, EnumSkyBlock)), for every possible byte. */
+    private static int vanillaCost(int opacity, int emission) {
+        int j = opacity;
+
+        if (j >= 15 && emission > 0) {
+            j = 1;
+        }
+
+        if (j < 1) {
+            j = 1;
+        }
+
+        return j;
+    }
+
+    @Test
+    public void costTableMatchesTheVanillaRuleForEveryCell() {
+        for (int opacity = 0; opacity < 16; ++opacity) {
+            for (int emission = 0; emission < 16; ++emission) {
+                byte cell = LightRules.pack(opacity, emission);
+
+                assertEquals(opacity, LightRules.opacity(cell));
+                assertEquals(emission, LightRules.emission(cell));
+                assertEquals("opacity " + opacity + " emission " + emission, vanillaCost(opacity, emission), LightRules.cost(cell));
+            }
+        }
+    }
+
+    @Test
+    public void packClampsOpacityAndEmissionLikeTheBlockStatesProduceThem() {
+        // vanilla opacity is 0..255 (255 for full cubes) and only "15 or more" matters
+        assertEquals(15, LightRules.opacity(LightRules.pack(255, 0)));
+        assertEquals(15, LightRules.opacity(LightRules.pack(16, 0)));
+        assertEquals(0, LightRules.opacity(LightRules.pack(-3, 0)));
+        assertEquals(15, LightRules.emission(LightRules.pack(0, 99)));
+        assertEquals(0, LightRules.emission(LightRules.pack(0, -1)));
+        assertEquals(LightRules.BLOCKED, LightRules.cost(LightRules.pack(255, 0)));
+        assertEquals("emissive opaque blocks stay passable at cost 1", 1, LightRules.cost(LightRules.pack(255, 7)));
+        assertEquals("zero opacity still costs 1", 1, LightRules.cost(LightRules.pack(0, 0)));
+    }
+
+    @Test
+    public void nibbleHelpersUseTheVanillaLayout() {
+        byte[] nibbles = new byte[LightRules.NIBBLE_BYTES];
+        Random random = new Random(1);
+        int[] expected = new int[LightRules.SECTION_CELLS];
+
+        for (int i = 0; i < expected.length; ++i) {
+            expected[i] = random.nextInt(16);
+            LightRules.setNibble(nibbles, i, expected[i]);
+        }
+
+        for (int i = 0; i < expected.length; ++i) {
+            assertEquals(expected[i], LightRules.getNibble(nibbles, i));
+        }
+
+        // low nibble is the even index, as in net.minecraft.server.NibbleArray
+        byte[] pair = new byte[LightRules.NIBBLE_BYTES];
+
+        LightRules.setNibble(pair, 0, 0xA);
+        LightRules.setNibble(pair, 1, 0x5);
+        assertEquals((byte) 0x5A, pair[0]);
+        assertEquals(1 << 8 | 2 << 4 | 3, LightRules.cellIndex(3, 1, 2));
+    }
+
+    @Test
+    public void positionPackingMatchesThePendingLightRegistry() {
+        for (int x = 0; x < 16; ++x) {
+            for (int z = 0; z < 16; ++z) {
+                for (int y : new int[] {0, 1, 63, 128, 255}) {
+                    for (boolean sky : new boolean[] {false, true}) {
+                        int packed = LightRules.packPosition(x, y, z, sky);
+
+                        assertEquals(PendingLightRegistry.pack(x, y, z, sky), packed);
+                        assertEquals(x, LightRules.positionX(packed));
+                        assertEquals(y, LightRules.positionY(packed));
+                        assertEquals(z, LightRules.positionZ(packed));
+                        assertEquals(sky, LightRules.positionIsSky(packed));
+                    }
+                }
+            }
+        }
+
+        assertTrue(LightRules.packPosition(15, 255, 15, true) > 0);
+    }
+}
diff --git a/test/java/me/stella/antarctic/light/LightScene.java b/test/java/me/stella/antarctic/light/LightScene.java
new file mode 100644
index 0000000..98bf28d
--- /dev/null
+++ b/test/java/me/stella/antarctic/light/LightScene.java
@@ -0,0 +1,170 @@
+package me.stella.antarctic.light;
+
+/**
+ * Test helper: a rectangle of chunks addressed with global block coordinates. Everything is air with implicit light until
+ * set. Columns are targets unless marked ring or absent.
+ */
+final class LightScene {
+
+    final int minCx;
+    final int minCz;
+    final int width;
+    final int depth;
+    final boolean hasSky;
+    final byte[][][] cells;
+    final int[][] heights;
+    final byte[][][] storedSky;
+    final byte[][][] storedBlock;
+    final boolean[] ring;
+    final boolean[] absent;
+
+    LightScene(int minCx, int minCz, int width, int depth, boolean hasSky) {
+        this.minCx = minCx;
+        this.minCz = minCz;
+        this.width = width;
+        this.depth = depth;
+        this.hasSky = hasSky;
+        int n = width * depth;
+        this.cells = new byte[n][LightRules.SECTIONS][];
+        this.storedSky = new byte[n][LightRules.SECTIONS][];
+        this.storedBlock = new byte[n][LightRules.SECTIONS][];
+        this.heights = new int[n][256];
+        this.ring = new boolean[n];
+        this.absent = new boolean[n];
+    }
+
+    int column(int x, int z) {
+        return ((z >> 4) - this.minCz) * this.width + ((x >> 4) - this.minCx);
+    }
+
+    int columnOfChunk(int cx, int cz) {
+        return (cz - this.minCz) * this.width + (cx - this.minCx);
+    }
+
+    LightScene ring(int cx, int cz) {
+        this.ring[this.columnOfChunk(cx, cz)] = true;
+        return this;
+    }
+
+    LightScene absent(int cx, int cz) {
+        this.absent[this.columnOfChunk(cx, cz)] = true;
+        return this;
+    }
+
+    /** Makes every column ring except the given target chunk. */
+    LightScene onlyTarget(int cx, int cz) {
+        for (int i = 0; i < this.ring.length; ++i) {
+            this.ring[i] = true;
+        }
+
+        this.ring[this.columnOfChunk(cx, cz)] = false;
+        return this;
+    }
+
+    void set(int x, int y, int z, int opacity, int emission) {
+        int c = this.column(x, z);
+        int s = y >> 4;
+
+        if (this.cells[c][s] == null) {
+            this.cells[c][s] = new byte[LightRules.SECTION_CELLS];
+        }
+
+        this.cells[c][s][LightRules.cellIndex(x & 15, y & 15, z & 15)] = LightRules.pack(opacity, emission);
+    }
+
+    /** Creates the section as an all-air existing section. */
+    void section(int cx, int cz, int s) {
+        int c = this.columnOfChunk(cx, cz);
+
+        if (this.cells[c][s] == null) {
+            this.cells[c][s] = new byte[LightRules.SECTION_CELLS];
+        }
+    }
+
+    byte cell(int x, int y, int z) {
+        byte[] section = this.cells[this.column(x, z)][y >> 4];
+
+        return section == null ? 0 : section[LightRules.cellIndex(x & 15, y & 15, z & 15)];
+    }
+
+    void fill(int x0, int y0, int z0, int x1, int y1, int z1, int opacity, int emission) {
+        for (int x = x0; x <= x1; ++x) {
+            for (int y = y0; y <= y1; ++y) {
+                for (int z = z0; z <= z1; ++z) {
+                    this.set(x, y, z, opacity, emission);
+                }
+            }
+        }
+    }
+
+    void storeBlock(int x, int y, int z, int value) {
+        int c = this.column(x, z);
+        int s = y >> 4;
+
+        if (this.storedBlock[c][s] == null) {
+            this.storedBlock[c][s] = new byte[LightRules.NIBBLE_BYTES];
+        }
+
+        LightRules.setNibble(this.storedBlock[c][s], LightRules.cellIndex(x & 15, y & 15, z & 15), value);
+    }
+
+    void storeSky(int x, int y, int z, int value) {
+        int c = this.column(x, z);
+        int s = y >> 4;
+
+        if (this.storedSky[c][s] == null) {
+            this.storedSky[c][s] = new byte[LightRules.NIBBLE_BYTES];
+        }
+
+        LightRules.setNibble(this.storedSky[c][s], LightRules.cellIndex(x & 15, y & 15, z & 15), value);
+    }
+
+    void deriveHeights() {
+        for (int c = 0; c < this.cells.length; ++c) {
+            System.arraycopy(HeightMaps.compute(this.cells[c]), 0, this.heights[c], 0, 256);
+        }
+    }
+
+    void setHeight(int x, int z, int height) {
+        this.heights[this.column(x, z)][(z & 15) << 4 | x & 15] = height;
+    }
+
+    int height(int x, int z) {
+        return this.heights[this.column(x, z)][(z & 15) << 4 | x & 15];
+    }
+
+    LightRegion region() {
+        LightRegion region = new LightRegion(this.minCx, this.minCz, this.width, this.depth, this.hasSky);
+
+        for (int c = 0; c < this.cells.length; ++c) {
+            if (this.absent[c]) {
+                continue;
+            }
+
+            LightColumn column = new LightColumn(this.heights[c]);
+
+            for (int s = 0; s < LightRules.SECTIONS; ++s) {
+                column.setCells(s, this.cells[c][s]);
+                column.setStored(s, this.storedSky[c][s], this.storedBlock[c][s]);
+            }
+
+            region.put(this.minCx + c % this.width, this.minCz + c / this.width, column, !this.ring[c]);
+        }
+
+        return region;
+    }
+
+    // ------------------------------------------------------------------------ reading engine output
+
+    /** Light of a cell after the engine ran, following the result's "null = implicit" convention. */
+    int resultLight(LightResult result, boolean sky, int x, int y, int z) {
+        int c = this.column(x, z);
+        byte[] nibbles = sky ? result.sky(c, y >> 4) : result.block(c, y >> 4);
+
+        if (nibbles != null) {
+            return LightRules.getNibble(nibbles, LightRules.cellIndex(x & 15, y & 15, z & 15));
+        }
+
+        return sky && y >= this.height(x, z) ? 15 : 0;
+    }
+}
diff --git a/test/java/me/stella/antarctic/light/ReferenceSolver.java b/test/java/me/stella/antarctic/light/ReferenceSolver.java
new file mode 100644
index 0000000..00c8797
--- /dev/null
+++ b/test/java/me/stella/antarctic/light/ReferenceSolver.java
@@ -0,0 +1,161 @@
+package me.stella.antarctic.light;
+
+/**
+ * Deliberately naive third implementation of the light rule for tests: start every target cell at 0 and apply the rule in
+ * place until nothing changes. The rule only ever raises a value from below, so this reaches the same unique fixed point
+ * as the engine, using none of its code and none of the checker's.
+ */
+final class ReferenceSolver {
+
+    private final LightScene scene;
+    private final boolean sky;
+    private final int blocksX;
+    private final int blocksZ;
+    private final int[] light;
+    private int sweeps;
+
+    private ReferenceSolver(LightScene scene, boolean sky) {
+        this.scene = scene;
+        this.sky = sky;
+        this.blocksX = scene.width << 4;
+        this.blocksZ = scene.depth << 4;
+        this.light = new int[LightRules.WORLD_HEIGHT * this.blocksX * this.blocksZ];
+    }
+
+    static int[] solve(LightScene scene, boolean sky) {
+        ReferenceSolver solver = new ReferenceSolver(scene, sky);
+
+        solver.run();
+        return solver.light;
+    }
+
+    static int sweepsFor(LightScene scene, boolean sky) {
+        ReferenceSolver solver = new ReferenceSolver(scene, sky);
+
+        solver.run();
+        return solver.sweeps;
+    }
+
+    static int at(LightScene scene, int[] solved, int x, int y, int z) {
+        int blocksX = scene.width << 4;
+        int blocksZ = scene.depth << 4;
+        int rx = x - (scene.minCx << 4);
+        int rz = z - (scene.minCz << 4);
+
+        return solved[(y * blocksZ + rz) * blocksX + rx];
+    }
+
+    private int index(int rx, int y, int rz) {
+        return (y * this.blocksZ + rz) * this.blocksX + rx;
+    }
+
+    private int columnAt(int rx, int rz) {
+        return (rz >> 4) * this.scene.width + (rx >> 4);
+    }
+
+    private void run() {
+        // ring columns hold their stored light for the whole run
+        for (int rz = 0; rz < this.blocksZ; ++rz) {
+            for (int rx = 0; rx < this.blocksX; ++rx) {
+                int c = this.columnAt(rx, rz);
+
+                if (this.scene.absent[c] || !this.scene.ring[c]) {
+                    continue;
+                }
+
+                for (int y = 0; y < LightRules.WORLD_HEIGHT; ++y) {
+                    this.light[this.index(rx, y, rz)] = this.ringValue(c, rx & 15, y, rz & 15);
+                }
+            }
+        }
+
+        boolean changed = true;
+
+        while (changed) {
+            changed = false;
+            ++this.sweeps;
+            for (int rz = 0; rz < this.blocksZ; ++rz) {
+                for (int rx = 0; rx < this.blocksX; ++rx) {
+                    int c = this.columnAt(rx, rz);
+
+                    if (this.scene.absent[c] || this.scene.ring[c]) {
+                        continue;
+                    }
+
+                    for (int y = 0; y < LightRules.WORLD_HEIGHT; ++y) {
+                        int value = this.rule(c, rx, y, rz);
+
+                        if (value != this.light[this.index(rx, y, rz)]) {
+                            this.light[this.index(rx, y, rz)] = value;
+                            changed = true;
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private int ringValue(int c, int localX, int y, int localZ) {
+        byte[] nibbles = this.sky ? this.scene.storedSky[c][y >> 4] : this.scene.storedBlock[c][y >> 4];
+
+        if (nibbles != null) {
+            int i = (y & 15) << 8 | localZ << 4 | localX;
+
+            return (nibbles[i >> 1] >> ((i & 1) * 4)) & 15;
+        }
+
+        return this.sky && y >= this.scene.heights[c][localZ << 4 | localX] ? 15 : 0;
+    }
+
+    private int neighbour(int rx, int y, int rz) {
+        if (y > 255) {
+            return this.sky ? 15 : 0;
+        }
+
+        if (y < 0 || rx < 0 || rz < 0 || rx >= this.blocksX || rz >= this.blocksZ || this.scene.absent[this.columnAt(rx, rz)]) {
+            return 0;
+        }
+
+        return this.light[this.index(rx, y, rz)];
+    }
+
+    private int rule(int c, int rx, int y, int rz) {
+        int localX = rx & 15;
+        int localZ = rz & 15;
+
+        if (this.sky && y >= this.scene.heights[c][localZ << 4 | localX]) {
+            return 15;
+        }
+
+        byte[] section = this.scene.cells[c][y >> 4];
+        int v = section == null ? 0 : section[(y & 15) << 8 | localZ << 4 | localX] & 0xFF;
+        int opacity = v & 15;
+        int emission = v >> 4;
+        int cost = opacity;
+
+        if (cost >= 15 && emission > 0) {
+            cost = 1;
+        }
+
+        if (cost < 1) {
+            cost = 1;
+        }
+
+        if (cost >= 15) {
+            return 0;
+        }
+
+        int best = this.sky ? 0 : emission;
+
+        best = Math.max(best, this.neighbour(rx + 1, y, rz) - cost);
+        best = Math.max(best, this.neighbour(rx - 1, y, rz) - cost);
+        best = Math.max(best, this.neighbour(rx, y, rz + 1) - cost);
+        best = Math.max(best, this.neighbour(rx, y, rz - 1) - cost);
+        best = Math.max(best, this.neighbour(rx, y + 1, rz) - cost);
+        if (y > 0) {
+            best = Math.max(best, this.neighbour(rx, y - 1, rz) - cost);
+        }
+
+        return best;
+    }
+}
diff --git a/test/java/net/minecraft/server/LightEngineNmsParityTest.java b/test/java/net/minecraft/server/LightEngineNmsParityTest.java
new file mode 100644
index 0000000..19a6c17
--- /dev/null
+++ b/test/java/net/minecraft/server/LightEngineNmsParityTest.java
@@ -0,0 +1,393 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import java.lang.reflect.Method;
+import java.util.Random;
+import me.stella.antarctic.light.HeightMaps;
+import me.stella.antarctic.light.LightChecker;
+import me.stella.antarctic.light.LightColumn;
+import me.stella.antarctic.light.LightEngine;
+import me.stella.antarctic.light.LightRegion;
+import me.stella.antarctic.light.LightResult;
+import me.stella.antarctic.light.LightRules;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/**
+ * Ties the pure light engine to the real server:
+ * <ul>
+ * <li>{@link LightChecker#expected} must equal the server's own rule, {@code World.a(BlockPosition, EnumSkyBlock)}, for every
+ * cell on arbitrary (even nonsensical) stored light and arbitrary blocks and heights;</li>
+ * <li>the engine's from-scratch result must equal vanilla's incremental result wherever vanilla is path independent (isolated
+ * light sources far apart, and their removal);</li>
+ * <li>{@link HeightMaps} must match {@code Chunk.initLighting}.</li>
+ * </ul>
+ * The stub world holds chunks -2..1; chunks -1..0 are the targets, the outer ring is the fixed input.
+ */
+public class LightEngineNmsParityTest {
+
+    private static final LightEngine ENGINE = new LightEngine();
+
+    private static IBlockData[] palette() {
+        return new IBlockData[] {
+            Blocks.AIR.getBlockData(), Blocks.AIR.getBlockData(), Blocks.AIR.getBlockData(), Blocks.AIR.getBlockData(),
+            Blocks.STONE.getBlockData(), Blocks.STONE.getBlockData(), Blocks.GLASS.getBlockData(), Blocks.LEAVES.getBlockData(),
+            Blocks.WATER.getBlockData(), Blocks.ICE.getBlockData(), Blocks.WEB.getBlockData(), Blocks.LAVA.getBlockData(),
+            Blocks.TORCH.getBlockData(), Blocks.REDSTONE_TORCH.getBlockData(), Blocks.GLOWSTONE.getBlockData(),
+            Blocks.SEA_LANTERN.getBlockData(), Blocks.LIT_REDSTONE_LAMP.getBlockData(), Blocks.ENDER_CHEST.getBlockData(),
+            Blocks.BEACON.getBlockData()
+        };
+    }
+
+    @BeforeClass
+    public static void bootstrap() throws Exception {
+        LightPropagationParityTest.bootstrap();
+    }
+
+    private static WorldServer world(long seed) throws Exception {
+        return LightPropagationParityTest.buildWorld(seed, new LightPropagationParityTest.StubProvider[1]);
+    }
+
+    private static boolean isTarget(int cx, int cz) {
+        return cx >= -1 && cx <= 0 && cz >= -1 && cz <= 0;
+    }
+
+    /** Copies chunks -2..1 into a region; chunks -1..0 are targets. */
+    static LightRegion snapshot(WorldServer world) {
+        LightRegion region = new LightRegion(-2, -2, 4, 4, true);
+
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                Chunk chunk = world.getChunkIfLoaded(cx, cz);
+                LightColumn column = new LightColumn(chunk.heightMap.clone());
+                ChunkSection[] sections = chunk.getSections();
+
+                for (int s = 0; s < 16; ++s) {
+                    ChunkSection section = sections[s];
+
+                    if (section == Chunk.a) {
+                        continue;
+                    }
+
+                    byte[] cells = new byte[LightRules.SECTION_CELLS];
+
+                    for (int y = 0; y < 16; ++y) {
+                        for (int z = 0; z < 16; ++z) {
+                            for (int x = 0; x < 16; ++x) {
+                                IBlockData state = section.getType(x, y, z);
+
+                                cells[LightRules.cellIndex(x, y, z)] = LightRules.pack(state.c(), state.d());
+                            }
+                        }
+                    }
+
+                    column.setCells(s, cells);
+                    column.setStored(s, section.getSkyLightArray().asBytes().clone(), section.getEmittedLightArray().asBytes().clone());
+                }
+
+                region.put(cx, cz, column, isTarget(cx, cz));
+            }
+        }
+
+        return region;
+    }
+
+    private static void randomizeBlocks(WorldServer world, Random random) {
+        IBlockData[] palette = palette();
+
+        for (int cx = -1; cx <= 0; ++cx) {
+            for (int cz = -1; cz <= 0; ++cz) {
+                for (int x = 0; x < 16; ++x) {
+                    for (int z = 0; z < 16; ++z) {
+                        for (int y = 0; y < 72; ++y) { // from the very bottom: y = 0 cells read themselves below
+                            if (random.nextInt(100) < 30) {
+                                LightPropagationParityTest.setBlock(world, cx * 16 + x, y, cz * 16 + z, palette[random.nextInt(palette.length)]);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    /** Vanilla's definition, read straight from the live sections (independent of HeightMaps). */
+    private static void deriveHeights(WorldServer world) {
+        for (int cx = -1; cx <= 0; ++cx) {
+            for (int cz = -1; cz <= 0; ++cz) {
+                Chunk chunk = world.getChunkIfLoaded(cx, cz);
+
+                for (int z = 0; z < 16; ++z) {
+                    for (int x = 0; x < 16; ++x) {
+                        int height = 0;
+
+                        for (int y = 255; y >= 0 && height == 0; --y) {
+                            if (chunk.getSections()[y >> 4].getType(x, y & 15, z).c() != 0) {
+                                height = y + 1;
+                            }
+                        }
+
+                        chunk.heightMap[z << 4 | x] = height;
+                    }
+                }
+            }
+        }
+    }
+
+    private static void randomizeStoredLight(WorldServer world, Random random) {
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                for (ChunkSection section : world.getChunkIfLoaded(cx, cz).getSections()) {
+                    random.nextBytes(section.getSkyLightArray().asBytes());
+                    random.nextBytes(section.getEmittedLightArray().asBytes());
+                }
+            }
+        }
+    }
+
+    @Test
+    public void expectedEqualsTheServersOwnRuleOnArbitraryBlocksHeightsAndStoredLight() throws Exception {
+        Method rule = World.class.getDeclaredMethod("a", BlockPosition.class, EnumSkyBlock.class);
+
+        rule.setAccessible(true);
+        for (long seed = 1; seed <= 3; ++seed) {
+            WorldServer world = world(seed);
+            Random random = new Random(seed * 31);
+
+            randomizeBlocks(world, random);
+            if (seed == 1) {
+                deriveHeights(world); // consistent heights
+            } else if (seed == 3) { // arbitrary heights, nothing to do with the blocks
+                for (int cx = -1; cx <= 0; ++cx) {
+                    for (int cz = -1; cz <= 0; ++cz) {
+                        for (int i = 0; i < 256; ++i) {
+                            world.getChunkIfLoaded(cx, cz).heightMap[i] = random.nextInt(140);
+                        }
+                    }
+                }
+            } // seed 2 keeps buildWorld's heights, which no longer match the random blocks either
+
+            randomizeStoredLight(world, random);
+
+            LightRegion region = snapshot(world);
+            int compared = 0;
+
+            for (int cx = -1; cx <= 0; ++cx) {
+                for (int cz = -1; cz <= 0; ++cz) {
+                    for (int y = 0; y < 256; ++y) {
+                        for (int lz = 0; lz < 16; ++lz) {
+                            for (int lx = 0; lx < 16; ++lx) {
+                                for (int type = 0; type < 2; ++type) {
+                                    boolean sky = type == 0;
+                                    int vanilla = (Integer) rule.invoke(world, new BlockPosition(cx * 16 + lx, y, cz * 16 + lz),
+                                            sky ? EnumSkyBlock.SKY : EnumSkyBlock.BLOCK);
+                                    int mine = LightChecker.expected(region, sky, cx, cz, lx, y, lz);
+
+                                    if (vanilla != mine) {
+                                        throw new AssertionError("seed " + seed + (sky ? " sky" : " block") + " cell "
+                                                + (cx * 16 + lx) + "," + y + "," + (cz * 16 + lz) + ": server rule " + vanilla + ", checker " + mine);
+                                    }
+
+                                    ++compared;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+
+            assertEquals(4 * 256 * 256 * 2, compared);
+        }
+    }
+
+    private static void assertEngineMatchesStoredLight(WorldServer world, String context) {
+        LightRegion region = snapshot(world);
+        LightResult result = ENGINE.relight(region);
+
+        for (int cx = -1; cx <= 0; ++cx) {
+            for (int cz = -1; cz <= 0; ++cz) {
+                ChunkSection[] sections = world.getChunkIfLoaded(cx, cz).getSections();
+
+                for (int s = 0; s < 16; ++s) {
+                    for (int type = 0; type < 2; ++type) {
+                        boolean sky = type == 0;
+                        byte[] vanilla = (sky ? sections[s].getSkyLightArray() : sections[s].getEmittedLightArray()).asBytes();
+                        byte[] engine = sky ? result.sky(cx, cz, s) : result.block(cx, cz, s);
+
+                        assertNotNull(context + ": existing sections always get an array", engine);
+                        if (!java.util.Arrays.equals(vanilla, engine)) {
+                            for (int i = 0; i < LightRules.SECTION_CELLS; ++i) {
+                                if (LightRules.getNibble(vanilla, i) != LightRules.getNibble(engine, i)) {
+                                    throw new AssertionError(context + (sky ? " sky" : " block") + " chunk " + cx + "," + cz + " section " + s
+                                            + " cell x" + (i & 15) + " y" + ((s << 4) + (i >> 8)) + " z" + (i >> 4 & 15)
+                                            + ": vanilla " + LightRules.getNibble(vanilla, i) + ", engine " + LightRules.getNibble(engine, i));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    @Test
+    public void aFreshStubWorldIsAlreadyTheFixedPointTheEngineComputes() throws Exception {
+        assertEngineMatchesStoredLight(world(5), "fresh world");
+    }
+
+    /** Number of block-light cells above zero in the stub world; guards that the parity scenes really contain light. */
+    private static int litBlockCells(WorldServer world) {
+        int lit = 0;
+
+        for (int cx = -2; cx <= 1; ++cx) {
+            for (int cz = -2; cz <= 1; ++cz) {
+                for (ChunkSection section : world.getChunkIfLoaded(cx, cz).getSections()) {
+                    for (int i = 0; i < LightRules.SECTION_CELLS; ++i) {
+                        if (LightRules.getNibble(section.getEmittedLightArray().asBytes(), i) > 0) {
+                            ++lit;
+                        }
+                    }
+                }
+            }
+        }
+
+        return lit;
+    }
+
+    private static IBlockData[] emitters() {
+        return new IBlockData[] {Blocks.TORCH.getBlockData(), Blocks.GLOWSTONE.getBlockData(), Blocks.SEA_LANTERN.getBlockData(),
+            Blocks.LIT_REDSTONE_LAMP.getBlockData(), Blocks.ENDER_CHEST.getBlockData(), Blocks.REDSTONE_TORCH.getBlockData()};
+    }
+
+    /**
+     * Fills the air above the ground around a spot with translucent blocks (opacity 0..3). Heights stay as built, so every cell
+     * above the ground still reads as sky source and the stub world remains a fixed point for sky light; only block light
+     * has to find its way through them.
+     */
+    private static void sprinkleTranslucent(WorldServer world, Random random, int centreX, int centreZ) {
+        IBlockData[] translucent = {Blocks.LEAVES.getBlockData(), Blocks.WATER.getBlockData(), Blocks.ICE.getBlockData(),
+            Blocks.WEB.getBlockData(), Blocks.GLASS.getBlockData()};
+
+        for (int dx = -7; dx <= 7; ++dx) {
+            for (int dz = -7; dz <= 7; ++dz) {
+                int x = centreX + dx;
+                int z = centreZ + dz;
+                int ground = world.getChunkIfLoaded(x >> 4, z >> 4).heightMap[(z & 15) << 4 | x & 15];
+
+                for (int dy = 0; dy < 6; ++dy) {
+                    if (random.nextInt(100) < 30) {
+                        LightPropagationParityTest.setBlock(world, x, ground + dy, z, translucent[random.nextInt(translucent.length)]);
+                    }
+                }
+            }
+        }
+    }
+
+    /** Places one emitter per spot on the first air cell above the ground and lets vanilla relight each incrementally. */
+    private static BlockPosition[] placeAndRelight(WorldServer world, Random random, int[][] spots, boolean withTranslucent) {
+        BlockPosition[] placed = new BlockPosition[spots.length];
+        IBlockData[] emitters = emitters();
+
+        if (withTranslucent) {
+            for (int[] spot : spots) {
+                sprinkleTranslucent(world, random, spot[0], spot[1]);
+            }
+        }
+
+        for (int i = 0; i < spots.length; ++i) {
+            int x = spots[i][0];
+            int z = spots[i][1];
+            int y = world.getChunkIfLoaded(x >> 4, z >> 4).heightMap[(z & 15) << 4 | x & 15]; // first air cell above the ground
+
+            placed[i] = new BlockPosition(x, y, z);
+            LightPropagationParityTest.setBlock(world, x, y, z, emitters[random.nextInt(emitters.length)]);
+            world.w(placed[i]);
+        }
+
+        return placed;
+    }
+
+    private static void removeAndRelight(WorldServer world, BlockPosition[] placed) {
+        for (BlockPosition position : placed) {
+            LightPropagationParityTest.setBlock(world, position.getX(), position.getY(), position.getZ(), Blocks.AIR.getBlockData());
+            world.w(position);
+        }
+    }
+
+    @Test
+    public void isolatedEmittersInTheTargetsMatchVanillasIncrementalRelightAndTheirRemoval() throws Exception {
+        // Pairwise Manhattan distance of at least 30 (twice the largest light radius of 14, plus slack) means no two emitters
+        // overlap, so vanilla's incremental relight is exact for each. All spots keep their light inside chunks -2..1:
+        // the stub world has nothing beyond, and a flood fill reaching it would try to load a chunk.
+        int[][] spots = {{-16, -16}, {15, 15}, {-16, 15}, {15, -16}, {0, 0}};
+
+        for (long seed = 1; seed <= 6; ++seed) {
+            WorldServer world = world(seed);
+            Random random = new Random(seed);
+            int count = 1 + (int) (seed % 5);
+            int[][] chosen = new int[count][];
+
+            for (int i = 0; i < count; ++i) {
+                chosen[i] = spots[(int) ((seed + i) % spots.length)];
+            }
+
+            BlockPosition[] placed = placeAndRelight(world, random, chosen, seed % 2 == 0);
+
+            assertTrue("vanilla must have lit something for the comparison to mean anything", litBlockCells(world) > 150 * count / 2);
+            assertEngineMatchesStoredLight(world, "seed " + seed + " after placing " + count);
+            removeAndRelight(world, placed);
+            assertEquals("vanilla's removal pass clears everything", 0, litBlockCells(world));
+            assertEngineMatchesStoredLight(world, "seed " + seed + " after removing");
+        }
+    }
+
+    @Test
+    public void emittersInTheRingLightTheTargetEdgesLikeVanilla() throws Exception {
+        // chunks -2 and 1 are ring chunks here: the engine must pull their light into the target edge cells
+        int[][] spots = {{-17, 0}, {16, 5}};
+
+        for (long seed = 1; seed <= 3; ++seed) {
+            WorldServer world = world(seed + 40);
+            BlockPosition[] placed = placeAndRelight(world, new Random(seed), spots, seed != 2);
+
+            assertTrue(litBlockCells(world) > 150);
+            assertEngineMatchesStoredLight(world, "ring emitters, seed " + seed);
+            removeAndRelight(world, placed);
+            assertEquals(0, litBlockCells(world));
+            assertEngineMatchesStoredLight(world, "ring emitters removed, seed " + seed);
+        }
+    }
+
+    @Test
+    public void heightMapsMatchChunkInitLighting() throws Exception {
+        for (long seed = 1; seed <= 3; ++seed) {
+            WorldServer world = world(seed);
+
+            randomizeBlocks(world, new Random(seed));
+
+            Chunk chunk = world.getChunkIfLoaded(0, 0);
+            LightRegion region = snapshot(world);
+            int[] expected = new int[256];
+
+            for (int z = 0; z < 16; ++z) {
+                for (int x = 0; x < 16; ++x) {
+                    byte[][] cells = new byte[16][];
+
+                    for (int s = 0; s < 16; ++s) {
+                        cells[s] = region.column(0, 0).cells(s);
+                    }
+
+                    expected[z << 4 | x] = HeightMaps.column(cells, x, z);
+                }
+            }
+
+            LightPropagationParityTest.set(Chunk.class, chunk, "h", new int[256]); // the precipitation map; Unsafe-built chunks have none
+            chunk.initLighting();
+            assertArrayEquals("seed " + seed, chunk.heightMap, expected);
+            assertTrue(expected[0] > 0);
+        }
+    }
