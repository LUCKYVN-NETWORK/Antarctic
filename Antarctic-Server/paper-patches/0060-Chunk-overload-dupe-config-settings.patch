From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RemainingToast <59129680+RemainingToast@users.noreply.github.com>
Date: Wed, 15 Dec 2021 19:39:21 +1000
Subject: [PATCH 060/180] Chunk overload dupe config settings

- Add chunk-overload-dupe configuration options in AntarcticConfig
- Allow skipping save on oversized chunks (>1MB) when chunk-overload-dupe.allow is enabled
- Support logging dupe occurrences via chunk-overload-dupe.log
- Default to false to protect standard gameplay

diff --git a/main/java/com/destroystokyo/paper/AntarcticConfig.java b/main/java/com/destroystokyo/paper/AntarcticConfig.java
index cf54cb0..fd7f3a3 100644
--- a/main/java/com/destroystokyo/paper/AntarcticConfig.java
+++ b/main/java/com/destroystokyo/paper/AntarcticConfig.java
@@ -225,4 +225,19 @@ public class AntarcticConfig {
         optimizeArmourStands = getBoolean("optimize-armourstands", optimizeArmourStands);
     }
 
+    public static boolean chunkOverloadDupe = false;
+    public static boolean chunkOverloadDupeLog = false;
+    private static void chunkOverloadDupe() {
+        setComment("chunk-overload-dupe.allow",
+            "When enabled, allows chunk-overload rollback behavior where oversized chunks (>1MB) are not saved to disk.",
+            "Useful for anarchy servers wishing to preserve authentic vanilla 1.12.2 book-dupe mechanics.",
+            "Defaults to false to prevent chunk rollback and item duplication.");
+        chunkOverloadDupe = getBoolean("chunk-overload-dupe.allow", false);
+        setComment("chunk-overload-dupe.log",
+            "Whether to log chunk overload dupe attempts when triggered.");
+        chunkOverloadDupeLog = getBoolean("chunk-overload-dupe.log", false);
+        if (chunkOverloadDupe) Bukkit.getLogger().info("Chunk overload dupe activated.");
+        if (chunkOverloadDupeLog) Bukkit.getLogger().info("Chunk overload dupes will be logged.");
+    }
+
 }
diff --git a/main/java/net/minecraft/server/RegionFile.java b/main/java/net/minecraft/server/RegionFile.java
index 542a35d..e18b868 100644
--- a/main/java/net/minecraft/server/RegionFile.java
+++ b/main/java/net/minecraft/server/RegionFile.java
@@ -198,6 +198,14 @@ public class RegionFile {
             int k1 = (k + 5) / 4096 + 1;
 
             if (k1 >= 256) {
+                // Dionysus start - chunk overload dupe
+                if (com.destroystokyo.paper.AntarcticConfig.chunkOverloadDupe) {
+                    if (com.destroystokyo.paper.AntarcticConfig.chunkOverloadDupeLog) {
+                        org.bukkit.Bukkit.getLogger().log(java.util.logging.Level.INFO, "Chunk dupe detected: ({0}, {1}) {2}", new Object[]{i, j, this.b});
+                    }
+                    return;
+                }
+                // Dionysus end
                 // Spigot start
                 if (!USE_SPIGOT_OVERSIZED_METHOD && !RegionFileCache.isOverzealous()) throw new ChunkTooLargeException(i, j, k1); // Paper - throw error instead
                 org.bukkit.Bukkit.getLogger().log(java.util.logging.Level.WARNING,"Large Chunk Detected: ({0}, {1}) Size: {2} {3}", new Object[]{i, j, k1, this.b});
