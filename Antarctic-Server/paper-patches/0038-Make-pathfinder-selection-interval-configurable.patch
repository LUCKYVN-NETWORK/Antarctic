Date: Sat, 17 Oct 2026 16:05:02 +0700
Subject: [PATCH 038/145] Make pathfinder selection interval configurable

- Preserve vanilla interval 3 and reject nonpositive intervals before modulo-by-zero failures
- Import unpatched vanilla selector from mc-dev; restart to apply changes to existing entities
- Adapt Dionysus server/0098 by nothub, originally moom0o/Papaya (GPLv3)
- Source: https://github.com/nopjmp/Dionysus at b5c71b62f6f1f555b22bd52f5751e33be4690b6e

diff --git a/main/java/com/destroystokyo/paper/AntarcticConfig.java b/main/java/com/destroystokyo/paper/AntarcticConfig.java
index 18a6740..cc8ce09 100644
--- a/main/java/com/destroystokyo/paper/AntarcticConfig.java
+++ b/main/java/com/destroystokyo/paper/AntarcticConfig.java
@@ -156,4 +156,13 @@ public class AntarcticConfig {
         ensureDefault(key, defaultValue, comment);
         return config.getStringList(key);
     }
+    // Papaya / moom0o via Dionysus 0098; retain the vanilla interval by default.
+    public static int pathfinderGoalSelectionDelay = 3;
+    private static void pathfinderGoalSelectionDelay() {
+        int delay = getInt("pathfinder.goal-selection-delay", 3,
+                "Ticks between goal-selection passes. Vanilla: 3. Higher values reduce AI responsiveness.",
+                "Must be positive. Changes affect newly created selectors; restart to apply everywhere.");
+        if (delay < 1) throw new IllegalArgumentException("pathfinder.goal-selection-delay must be positive");
+        pathfinderGoalSelectionDelay = delay;
+    }
 }
