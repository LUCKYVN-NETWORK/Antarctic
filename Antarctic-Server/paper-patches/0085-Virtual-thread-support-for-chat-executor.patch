diff --git a/test/java/com/destroystokyo/paper/config/toml/VirtualThreadsTest.java b/test/java/com/destroystokyo/paper/config/toml/VirtualThreadsTest.java
new file mode 100644
index 0000000..2da1063
--- /dev/null
+++ b/test/java/com/destroystokyo/paper/config/toml/VirtualThreadsTest.java
@@ -0,0 +1,38 @@
+package com.destroystokyo.paper.config.toml;
+
+import com.destroystokyo.paper.config.toml.modules.concurrency.VirtualThreads;
+import net.minecraft.server.PlayerConnection;
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+public class VirtualThreadsTest {
+
+    @Test
+    public void testVirtualThreadsConfigDefaults() {
+        Assert.assertTrue("VirtualThreads.authenticator should default to true", VirtualThreads.authenticator);
+        Assert.assertTrue("VirtualThreads.chatExecutor should default to true", VirtualThreads.chatExecutor);
+    }
+
+    @Test
+    public void testChatExecutorExecution() throws InterruptedException {
+        ExecutorService executor = PlayerConnection.getChatExecutor();
+        Assert.assertNotNull("Chat executor should not be null", executor);
+
+        CountDownLatch latch = new CountDownLatch(1);
+        AtomicBoolean ran = new AtomicBoolean(false);
+
+        executor.execute(() -> {
+            ran.set(true);
+            latch.countDown();
+        });
+
+        boolean completed = latch.await(5, TimeUnit.SECONDS);
+        Assert.assertTrue("Chat executor task should complete promptly", completed);
+        Assert.assertTrue("Chat executor task should have run", ran.get());
+    }
+}
