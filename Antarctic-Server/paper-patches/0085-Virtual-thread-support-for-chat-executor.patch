Subject: [PATCH 085/123] Virtual thread support for chat executor

- Execute asynchronous player chat processing on OpenJDK 21 virtual threads

- Enforce bounded submission queue to prevent memory exhaustion during chat floods

- Expose getChatExecutor on PlayerConnection and CraftServer

- Add concurrency.virtual-threads.chat-executor toggle (default true)

diff --git a/main/java/net/minecraft/server/PlayerConnection.java b/main/java/net/minecraft/server/PlayerConnection.java
index cb4410a..e5d7a6f 100644
--- a/main/java/net/minecraft/server/PlayerConnection.java
+++ b/main/java/net/minecraft/server/PlayerConnection.java
@@ -68,6 +68,27 @@ public class PlayerConnection implements PacketListenerPlayIn, ITickable {
     private long f = getCurrentMillis(); private void setLastPing(long lastPing) { this.f = lastPing;}; private long getLastPing() { return this.f;}; // Paper - OBFHELPER - set ping to delay initial
     private boolean g; private void setPendingPing(boolean isPending) { this.g = isPending;}; private boolean isPendingPing() { return this.g;}; // Paper - OBFHELPER
     private long h; private void setKeepAliveID(long keepAliveID) { this.h = keepAliveID;}; private long getKeepAliveID() {return this.h; };  // Paper - OBFHELPER
+    // Leaf start - Virtual thread support for chat executor (backport of Leaf MC 0120 / Server-Paper 0025)
+    private static final java.util.concurrent.atomic.AtomicInteger chatThreadId = new java.util.concurrent.atomic.AtomicInteger(0);
+    private static final java.util.concurrent.atomic.AtomicInteger pendingChats = new java.util.concurrent.atomic.AtomicInteger(0);
+    private static final int MAX_PENDING_CHATS = 2048;
+    private static final java.util.concurrent.ExecutorService chatExecutor = buildChatExecutor();
+
+    private static java.util.concurrent.ExecutorService buildChatExecutor() {
+        if (com.destroystokyo.paper.config.toml.modules.concurrency.VirtualThreads.chatExecutor) {
+            return java.util.concurrent.Executors.newThreadPerTaskExecutor(
+                    Thread.ofVirtual().name("Async Chat Thread - #", 0).factory()
+            );
+        }
+        return java.util.concurrent.Executors.newCachedThreadPool(
+                r -> new Thread(r, "Async Chat Thread - #" + chatThreadId.incrementAndGet())
+        );
+    }
+
+    public static java.util.concurrent.ExecutorService getChatExecutor() {
+        return chatExecutor;
+    }
+    // Leaf end
     // CraftBukkit start - multithreaded fields
     private volatile int chatThrottle;
     private static final AtomicIntegerFieldUpdater chatSpamField = AtomicIntegerFieldUpdater.newUpdater(PlayerConnection.class, "chatThrottle");
@@ -1344,7 +1365,21 @@ public class PlayerConnection implements PacketListenerPlayIn, ITickable {
                 chatmessage.getChatModifier().setColor(EnumChatFormat.RED);
                 this.sendPacket(new PacketPlayOutChat(chatmessage));
             } else if (true) {
-                this.chat(s, true);
+                // Leaf start - Virtual thread support for chat executor (backport of Leaf MC 0120 / Server-Paper 0025)
+                if (pendingChats.get() >= MAX_PENDING_CHATS) {
+                    LOGGER.warn("Chat queue overloaded ({} pending), dropping message from {}", pendingChats.get(), this.player.getName());
+                } else {
+                    final String message = s;
+                    pendingChats.incrementAndGet();
+                    chatExecutor.execute(() -> {
+                        try {
+                            this.chat(message, true);
+                        } finally {
+                            pendingChats.decrementAndGet();
+                        }
+                    });
+                }
