From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nopjmp <kthompson@hey.com>
Date: Fri, 5 Mar 2021 19:13:11 -0600
Subject: [PATCH 050/121] Configurable server mod name

- Backport Dionysus server/0029-Configurable-server-mod-name.patch
- Source: https://github.com/nopjmp/Dionysus at b5c71b62f6f1f555b22bd52f5751e33be4690b6e
- Add server-mod-name setting to AntarcticConfig defaulting to Antarctic
- Return AntarcticConfig.serverModName in MinecraftServer.getServerModName

diff --git a/main/java/com/destroystokyo/paper/AntarcticConfig.java b/main/java/com/destroystokyo/paper/AntarcticConfig.java
index 6891a80..f54dbd6 100644
--- a/main/java/com/destroystokyo/paper/AntarcticConfig.java
+++ b/main/java/com/destroystokyo/paper/AntarcticConfig.java
@@ -177,4 +177,10 @@ public class AntarcticConfig {
         }
     }
 
+    public static String serverModName = "Antarctic";
+    private static void serverModName() {
+        setComment("server-mod-name", "The server brand name sent to clients in the F3 debug screen.");
+        serverModName = getString("server-mod-name", serverModName);
+    }
+
 }
diff --git a/main/java/net/minecraft/server/MinecraftServer.java b/main/java/net/minecraft/server/MinecraftServer.java
index b79003e..9ece4a6 100644
--- a/main/java/net/minecraft/server/MinecraftServer.java
+++ b/main/java/net/minecraft/server/MinecraftServer.java
@@ -1,5 +1,7 @@
 package net.minecraft.server;
 
+import com.destroystokyo.paper.AntarcticConfig;
+
 import com.google.common.collect.Lists;
 import com.google.common.collect.Queues;
 import com.google.common.util.concurrent.Futures;
@@ -1168,7 +1170,7 @@ public abstract class MinecraftServer implements ICommandListener, Runnable, IAs
     }
 
     public String getServerModName() {
-        return "Paper"; //Paper - Paper > // Spigot - Spigot > // CraftBukkit - cb > vanilla!
+        return AntarcticConfig.serverModName;
     }
 
     public CrashReport b(CrashReport crashreport) {
