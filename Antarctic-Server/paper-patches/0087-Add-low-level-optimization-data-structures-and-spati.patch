@@ -0,0 +1,24 @@
+package me.stella.antarctic.collection;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class PrimitiveEntityListTest {
+
+    @Test
+    public void testAddAndSize() {
+        PrimitiveEntityList list = new PrimitiveEntityList(2);
+        assertTrue(list.isEmpty());
+        assertEquals(0, list.size());
+        list.add(null);
+        assertEquals(1, list.size());
+        assertFalse(list.isEmpty());
+        assertNull(list.get(0));
+        list.add(null);
+        list.add(null); // tests grow
+        assertEquals(3, list.size());
+        list.clear();
+        assertEquals(0, list.size());
+        assertTrue(list.isEmpty());
+    }
+}
diff --git a/test/java/me/stella/antarctic/math/FastMathTest.java b/test/java/me/stella/antarctic/math/FastMathTest.java
new file mode 100644
index 0000000..d14670c
