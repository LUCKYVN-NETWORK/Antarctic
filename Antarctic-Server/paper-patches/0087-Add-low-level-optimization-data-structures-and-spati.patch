+++ b/test/java/me/stella/antarctic/math/FastMathTest.java
@@ -0,0 +1,47 @@
+package me.stella.antarctic.math;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class FastMathTest {
+
+    @Test
+    public void testChunkPacking() {
+        int x = -42;
+        int z = 105;
+        long packed = FastMath.packChunkPos(x, z);
+        assertEquals(x, FastMath.unpackChunkX(packed));
+        assertEquals(z, FastMath.unpackChunkZ(packed));
+    }
+
+    @Test
+    public void testBlockPosPacking() {
+        int x = 12345;
+        int y = 64;
+        int z = -6789;
+        long packed = FastMath.packBlockPos(x, y, z);
+        assertEquals(x, FastMath.unpackBlockX(packed));
+        assertEquals(y, FastMath.unpackBlockY(packed));
+        assertEquals(z, FastMath.unpackBlockZ(packed));
+    }
+
+    @Test
+    public void testBranchlessFloorCeil() {
+        assertEquals(-2, FastMath.floor(-1.2D));
+        assertEquals(-1, FastMath.floor(-1.0D));
+        assertEquals(0, FastMath.floor(0.0D));
+        assertEquals(1, FastMath.floor(1.9D));
+
+        assertEquals(-1, FastMath.ceil(-1.2D));
+        assertEquals(-1, FastMath.ceil(-1.0D));
+        assertEquals(0, FastMath.ceil(0.0D));
+        assertEquals(2, FastMath.ceil(1.2D));
+    }
+
+    @Test
+    public void testDistanceChecks() {
+        assertTrue(FastMath.isWithinDistance(0, 0, 0, 3, 4, 0, 5.0D));
+        assertFalse(FastMath.isWithinDistance(0, 0, 0, 3, 4, 0, 4.9D));
+        assertEquals(4.0D, FastMath.chebyshevDistance(0, 0, 0, 3, 4, 1), 1e-9);
+    }
+}
diff --git a/test/java/me/stella/antarctic/spatial/CollisionBoxTest.java b/test/java/me/stella/antarctic/spatial/CollisionBoxTest.java
new file mode 100644
index 0000000..bf66cf5
--- /dev/null
+++ b/test/java/me/stella/antarctic/spatial/CollisionBoxTest.java
@@ -0,0 +1,30 @@
+package me.stella.antarctic.spatial;
+
+import net.minecraft.server.AxisAlignedBB;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class CollisionBoxTest {
+
+    @Test
+    public void testIntersection() {
+        CollisionBox box1 = new CollisionBox(0, 0, 0, 1, 1, 1);
+        CollisionBox box2 = new CollisionBox(0.5, 0.5, 0.5, 1.5, 1.5, 1.5);
+        CollisionBox box3 = new CollisionBox(2, 2, 2, 3, 3, 3);
+
+        assertTrue(box1.intersects(box2));
+        assertFalse(box1.intersects(box3));
+
+        AxisAlignedBB aabb = new AxisAlignedBB(0.5, 0.5, 0.5, 1.5, 1.5, 1.5);
+        assertTrue(box1.intersects(aabb));
+    }
+
+    @Test
+    public void testAxisOffsetCalculation() {
+        CollisionBox box = new CollisionBox(0, 0, 0, 1, 1, 1);
+        // Target moving into box from positive X: [2, 0, 0] moving left by -1.5
+        double offsetX = box.calculateXOffset(2.0, 0.0, 0.0, 3.0, 1.0, 1.0, -1.5);
+        // Distance between targetMinX (2.0) and box.maxX (1.0) is -1.0
+        assertEquals(-1.0D, offsetX, 1e-9);
+    }
+}
