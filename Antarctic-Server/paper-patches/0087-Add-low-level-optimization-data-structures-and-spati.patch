+package me.stella.antarctic.spatial;
+
+import net.minecraft.server.Blocks;
+import net.minecraft.server.DispenserRegistry;
+import org.junit.BeforeClass;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class FastVoxelCacheTest {
+
+    @BeforeClass
+    public static void setUp() {
+        DispenserRegistry.c();
+    }
+
+    @Test
+    public void testEmptyBlock() {
+        assertTrue(FastVoxelCache.isEmpty(null));
+        assertTrue(FastVoxelCache.isEmpty(Blocks.AIR.getBlockData()));
+    }
+
+    @Test
+    public void testFullCube() {
+        assertTrue(FastVoxelCache.isFullCube(Blocks.STONE.getBlockData()));
+        assertTrue(FastVoxelCache.isFullCube(Blocks.DIRT.getBlockData()));
+        assertFalse(FastVoxelCache.isFullCube(Blocks.AIR.getBlockData()));
+    }
+}
