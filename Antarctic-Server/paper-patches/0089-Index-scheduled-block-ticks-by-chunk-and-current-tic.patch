@@ -0,0 +1,196 @@
+package me.stella.antarctic.collection;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+import java.util.List;
+import java.util.NoSuchElementException;
+import org.junit.Test;
+
+public class ChunkIndexedTreeSetTest {
+
+    private static final class Entry implements Comparable<Entry> {
+        private static long counter;
+        final int x;
+        final int y;
+        final int z;
+        final String tag;
+        final long time;
+        final long seq = counter++;
+
+        Entry(int x, int y, int z, String tag, long time) {
+            this.x = x;
+            this.y = y;
+            this.z = z;
+            this.tag = tag;
+            this.time = time;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (!(o instanceof Entry)) {
+                return false;
+            }
+            Entry other = (Entry) o;
+            return x == other.x && y == other.y && z == other.z && tag.equals(other.tag);
+        }
+
+        @Override
+        public int hashCode() {
+            return (y + z * 31) * 31 + x;
+        }
+
+        @Override
+        public int compareTo(Entry other) {
+            return time < other.time ? -1 : time > other.time ? 1 : Long.compare(seq, other.seq);
+        }
+    }
+
+    private static final ChunkIndexedTreeSet.Locator<Entry> LOCATOR = new ChunkIndexedTreeSet.Locator<Entry>() {
+        @Override
+        public int blockX(Entry e) {
+            return e.x;
+        }
+
+        @Override
+        public int blockZ(Entry e) {
+            return e.z;
+        }
+    };
+
+    private static ChunkIndexedTreeSet<Entry> newSet() {
+        return new ChunkIndexedTreeSet<Entry>(LOCATOR);
+    }
+
+    @Test
+    public void emptySetBehaves() {
+        ChunkIndexedTreeSet<Entry> set = newSet();
+        assertTrue(set.isEmpty());
+        assertEquals(0, set.size());
+        assertNull(set.collect(0, 0, 16, 16, false));
+        assertNull(set.collect(0, 0, 16, 16, true));
+        try {
+            set.first();
+            throw new AssertionError("first() on an empty set must throw like the old tree set");
+        } catch (NoSuchElementException expected) {
+            // expected
+        }
+    }
+
+    @Test
+    public void addRefusesEqualElementAndRemoveRestores() {
+        ChunkIndexedTreeSet<Entry> set = newSet();
+        Entry a = new Entry(1, 2, 3, "w", 5);
+        Entry duplicate = new Entry(1, 2, 3, "w", 9);
+        assertTrue(set.add(a));
+        assertFalse("an equal element must be refused (old callers checked contains first)", set.add(duplicate));
+        assertEquals(1, set.size());
+        assertTrue(set.contains(duplicate));
+        assertSame(a, set.first());
+        assertTrue(set.remove(a));
+        assertFalse(set.remove(a));
+        assertTrue(set.isEmpty());
+        assertNull(set.collect(-100, -100, 100, 100, false));
+        assertTrue(set.add(duplicate));
+    }
+
+    @Test
+    public void halfOpenBoundsAreExact() {
+        ChunkIndexedTreeSet<Entry> set = newSet();
+        // Box [-2, 16) x [-2, 16): the exact bounds the chunk-save query uses for chunk (0,0).
+        int[] xs = {-3, -2, -1, 0, 15, 16, 17};
+        for (int x : xs) {
+            set.add(new Entry(x, 64, 0, "t", x + 10));
+        }
+        List<Entry> found = set.collect(-2, -2, 16, 16, false);
+        assertEquals("x in [-2, 16) -> -2, -1, 0, 15", 4, found.size());
+        assertEquals(-2, found.get(0).x);
+        assertEquals(15, found.get(3).x);
+        assertEquals("collect without remove must not change the set", 7, set.size());
+    }
+
+    @Test
+    public void resultsFollowCompareToOrderAcrossBuckets() {
+        ChunkIndexedTreeSet<Entry> set = newSet();
+        Entry late = new Entry(1, 0, 1, "a", 90);
+        Entry early = new Entry(-1, 0, -1, "b", 10);
+        Entry mid = new Entry(0, 0, 0, "c", 50);
+        Entry tieFirst = new Entry(5, 0, 5, "d", 50);
+        set.add(late);
+        set.add(early);
+        set.add(mid);
+        set.add(tieFirst);
+        List<Entry> found = set.collect(-16, -16, 16, 16, false);
+        assertEquals(4, found.size());
+        assertSame(early, found.get(0));
+        assertSame(mid, found.get(1));
+        assertSame(tieFirst, found.get(2));
+        assertSame(late, found.get(3));
+    }
+
+    @Test
+    public void removalDropsEntriesFromEveryView() {
+        ChunkIndexedTreeSet<Entry> set = newSet();
+        Entry a = new Entry(2, 0, 2, "a", 1);
+        Entry b = new Entry(40, 0, 40, "b", 2);
+        set.add(a);
+        set.add(b);
+        List<Entry> removed = set.collect(0, 0, 16, 16, true);
+        assertEquals(1, removed.size());
+        assertSame(a, removed.get(0));
+        assertFalse(set.contains(a));
+        assertEquals(1, set.size());
+        assertSame(b, set.first());
+        assertNull(set.collect(0, 0, 16, 16, false));
+    }
+
+    @Test
+    public void negativeCoordinatesAndExtremesDoNotOverflow() {
+        ChunkIndexedTreeSet<Entry> set = newSet();
+        set.add(new Entry(Integer.MIN_VALUE, 0, Integer.MIN_VALUE, "min", 1));
+        set.add(new Entry(Integer.MAX_VALUE, 0, Integer.MAX_VALUE, "max", 2));
+        set.add(new Entry(-1, 0, -1, "neg", 3));
+        List<Entry> all = set.collect(Integer.MIN_VALUE, Integer.MIN_VALUE, Integer.MAX_VALUE, Integer.MAX_VALUE, false);
+        // maxX is exclusive, so an element at Integer.MAX_VALUE is outside the box by definition.
+        assertEquals(2, all.size());
+        assertEquals("min", all.get(0).tag);
+        assertEquals("neg", all.get(1).tag);
+        assertNull("inverted box matches nothing", set.collect(10, 10, 5, 5, false));
+        assertNull("empty box matches nothing", set.collect(3, 3, 3, 3, false));
+    }
+
+    @Test
+    public void largeBoxUsesPopulatedBucketsAndAgreesWithSmallBoxPath() {
+        ChunkIndexedTreeSet<Entry> set = newSet();
+        for (int i = 0; i < 200; ++i) {
+            set.add(new Entry(i * 7 - 300, 0, i * 13 - 500, "e" + i, i));
+        }
+        // Few buckets relative to the box span forces the "walk populated buckets" path.
+        List<Entry> wide = set.collect(-100000, -100000, 100000, 100000, false);
+        assertEquals(200, wide.size());
+        // Narrow box forces the per-chunk lookup path.
+        List<Entry> narrow = set.collect(-300, -500, -280, -480, false);
+        for (Entry e : narrow) {
+            assertTrue(e.x >= -300 && e.x < -280 && e.z >= -500 && e.z < -480);
+        }
+        int expected = 0;
+        for (Entry e : wide) {
+            if (e.x >= -300 && e.x < -280 && e.z >= -500 && e.z < -480) {
+                ++expected;
+            }
+        }
+        assertEquals(expected, narrow.size());
+    }
+
+    @Test
+    public void clearEmptiesEverything() {
+        ChunkIndexedTreeSet<Entry> set = newSet();
+        set.add(new Entry(0, 0, 0, "a", 1));
+        set.clear();
+        assertTrue(set.isEmpty());
+        assertNull(set.collect(-16, -16, 16, 16, false));
+    }
+}
diff --git a/test/java/me/stella/antarctic/collection/MultiplicitySetTest.java b/test/java/me/stella/antarctic/collection/MultiplicitySetTest.java
new file mode 100644
