--- /dev/null
+++ b/test/java/me/stella/antarctic/collection/MultiplicitySetTest.java
@@ -0,0 +1,39 @@
+package me.stella.antarctic.collection;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class MultiplicitySetTest {
+
+    @Test
+    public void mirrorsListContainsWithDuplicates() {
+        MultiplicitySet<String> set = new MultiplicitySet<String>();
+        assertTrue(set.isEmpty());
+        assertFalse(set.contains("a"));
+        set.add("a");
+        set.add(new String("a"));
+        set.add("b");
+        assertEquals(2, set.distinctSize());
+        set.removeOne("a");
+        assertTrue("one equal occurrence remains", set.contains("a"));
+        set.removeOne("a");
+        assertFalse(set.contains("a"));
+        assertTrue(set.contains("b"));
+        set.clear();
+        assertTrue(set.isEmpty());
+        assertFalse(set.contains("b"));
+    }
+
+    @Test
+    public void removingAnAbsentElementLeavesNoGhost() {
+        MultiplicitySet<String> set = new MultiplicitySet<String>();
+        set.removeOne("ghost");
+        assertFalse(set.contains("ghost"));
+        assertTrue(set.isEmpty());
+        set.add("ghost");
+        assertTrue(set.contains("ghost"));
+    }
+}
diff --git a/test/java/net/minecraft/server/ScheduledTickIndexParityTest.java b/test/java/net/minecraft/server/ScheduledTickIndexParityTest.java
new file mode 100644
index 0000000..6b0e70a
--- /dev/null
+++ b/test/java/net/minecraft/server/ScheduledTickIndexParityTest.java
@@ -0,0 +1,231 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Random;
+import me.stella.antarctic.collection.ChunkIndexedTreeSet;
+import me.stella.antarctic.collection.MultiplicitySet;
+import org.bukkit.craftbukkit.util.HashTreeSet;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/**
+ * Vanilla/CraftBukkit parity for the indexed scheduled-tick structures. The "old" side is a verbatim copy of the
+ * pre-Antarctic WorldServer logic (HashTreeSet + linear scans); both sides hold the very same entry objects.
+ */
+public class ScheduledTickIndexParityTest {
+
+    static final ChunkIndexedTreeSet.Locator<NextTickListEntry> LOCATOR = new ChunkIndexedTreeSet.Locator<NextTickListEntry>() {
+        @Override
+        public int blockX(NextTickListEntry e) {
+            return e.a.getX();
+        }
+
+        @Override
+        public int blockZ(NextTickListEntry e) {
+            return e.a.getZ();
+        }
+    };
+
+    private static Block[] blocks;
+
+    @BeforeClass
+    public static void bootstrap() {
+        DispenserRegistry.c();
+        blocks = new Block[] {Blocks.FLOWING_WATER, Blocks.REDSTONE_TORCH, Blocks.UNPOWERED_REPEATER};
+    }
+
+    /** Verbatim copy of the old WorldServer.a(StructureBoundingBox, boolean). */
+    static List<NextTickListEntry> oldQuery(HashTreeSet<NextTickListEntry> nextTickList, List<NextTickListEntry> w,
+            StructureBoundingBox structureboundingbox, boolean flag) {
+        ArrayList<NextTickListEntry> arraylist = null;
+
+        for (int i = 0; i < 2; ++i) {
+            Iterator iterator;
+
+            if (i == 0) {
+                iterator = nextTickList.iterator();
+            } else {
+                iterator = w.iterator();
+            }
+
+            while (iterator.hasNext()) {
+                NextTickListEntry nextticklistentry = (NextTickListEntry) iterator.next();
+                BlockPosition blockposition = nextticklistentry.a;
+
+                if (blockposition.getX() >= structureboundingbox.a && blockposition.getX() < structureboundingbox.d && blockposition.getZ() >= structureboundingbox.c && blockposition.getZ() < structureboundingbox.f) {
+                    if (flag) {
+                        iterator.remove();
+                    }
+
+                    if (arraylist == null) {
+                        arraylist = new ArrayList<NextTickListEntry>();
+                    }
+
+                    arraylist.add(nextticklistentry);
+                }
+            }
+        }
+
+        return arraylist;
+    }
+
+    /** The new WorldServer.a(StructureBoundingBox, boolean) logic, over the same structures. */
+    static List<NextTickListEntry> newQuery(ChunkIndexedTreeSet<NextTickListEntry> nextTickList, List<NextTickListEntry> w,
+            MultiplicitySet<NextTickListEntry> batch, StructureBoundingBox bb, boolean flag) {
+        List<NextTickListEntry> arraylist = nextTickList.collect(bb.a, bb.c, bb.d, bb.f, flag);
+
+        if (!w.isEmpty()) {
+            Iterator iterator = w.iterator();
+
+            while (iterator.hasNext()) {
+                NextTickListEntry e = (NextTickListEntry) iterator.next();
+                BlockPosition p = e.a;
+
+                if (p.getX() >= bb.a && p.getX() < bb.d && p.getZ() >= bb.c && p.getZ() < bb.f) {
+                    if (flag) {
+                        iterator.remove();
+                        batch.removeOne(e);
+                    }
+
+                    if (arraylist == null) {
+                        arraylist = new ArrayList<NextTickListEntry>();
+                    }
+
+                    arraylist.add(e);
+                }
+            }
+        }
+
+        return arraylist;
+    }
+
+    private static StructureBoundingBox chunkBox(int cx, int cz) {
+        // Exactly what WorldServer.a(Chunk, boolean) builds.
+        int i = (cx << 4) - 2;
+        int j = i + 16 + 2;
+        int k = (cz << 4) - 2;
+        int l = k + 16 + 2;
+        return new StructureBoundingBox(i, 0, k, j, 256, l);
+    }
+
+    private static void assertSameResult(List<NextTickListEntry> expected, List<NextTickListEntry> actual) {
+        if (expected == null) {
+            assertNull(actual);
+            return;
+        }
+        assertEquals(expected.size(), actual.size());
+        for (int i = 0; i < expected.size(); ++i) {
+            assertSame("order/identity mismatch at " + i, expected.get(i), actual.get(i));
+        }
+    }
+
+    @Test
+    public void chunkBoxIsTheHalfOpenRangeMinusTwoToPlusSixteen() {
+        StructureBoundingBox box = chunkBox(3, -2);
+        assertEquals(46, box.a);
+        assertEquals(64, box.d);
+        assertEquals(-34, box.c);
+        assertEquals(-16, box.f);
+    }
+
+    @Test
+    public void randomizedOperationsMatchTheOldImplementation() {
+        for (long seed = 1; seed <= 25; ++seed) {
+            Random random = new Random(seed);
+            HashTreeSet<NextTickListEntry> oldSet = new HashTreeSet<NextTickListEntry>();
+            List<NextTickListEntry> oldW = new ArrayList<NextTickListEntry>();
+            ChunkIndexedTreeSet<NextTickListEntry> newSet = new ChunkIndexedTreeSet<NextTickListEntry>(LOCATOR);
+            List<NextTickListEntry> newW = new ArrayList<NextTickListEntry>();
+            MultiplicitySet<NextTickListEntry> batch = new MultiplicitySet<NextTickListEntry>();
+
+            for (int op = 0; op < 4000; ++op) {
+                int kind = random.nextInt(10);
+                if (kind < 5) {
+                    // schedule (callers guard with contains, then add)
+                    BlockPosition pos = new BlockPosition(random.nextInt(161) - 80, random.nextInt(256), random.nextInt(161) - 80);
+                    NextTickListEntry entry = new NextTickListEntry(pos, blocks[random.nextInt(blocks.length)]);
+                    entry.a((long) random.nextInt(40));
+                    entry.a(random.nextInt(3) - 1);
+                    boolean oldContains = oldSet.contains(entry);
+                    if (!oldContains) {
+                        oldSet.add(entry);
+                    }
+                    assertEquals(oldContains, newSet.contains(entry));
+                    boolean added = newSet.add(entry);
+                    assertEquals(!oldContains, added);
+                } else if (kind < 6 && !oldSet.isEmpty()) {
+                    // move the earliest entries into the current batch (the cleaning loop)
+                    int n = 1 + random.nextInt(6);
+                    for (int i = 0; i < n && !oldSet.isEmpty(); ++i) {
+                        NextTickListEntry first = oldSet.first();
+                        assertSame(first, newSet.first());
+                        oldSet.remove(first);
+                        oldW.add(first);
+                        newSet.remove(first);
+                        newW.add(first);
+                        batch.add(first);
+                    }
+                } else if (kind < 7 && !oldW.isEmpty()) {
+                    // tick one batch entry
+                    NextTickListEntry e = oldW.remove(0);
+                    assertSame(e, newW.remove(0));
+                    batch.removeOne(e);
+                } else if (kind < 9) {
+                    int cx = random.nextInt(11) - 5;
+                    int cz = random.nextInt(11) - 5;
+                    boolean flag = random.nextInt(4) == 0;
+                    StructureBoundingBox box = chunkBox(cx, cz);
+                    assertSameResult(oldQuery(oldSet, oldW, box, flag), newQuery(newSet, newW, batch, box, flag));
+                } else {
+                    int minX = random.nextInt(200) - 100;
+                    int minZ = random.nextInt(200) - 100;
+                    StructureBoundingBox box = new StructureBoundingBox(minX, 0, minZ, minX + random.nextInt(120) - 10, 256, minZ + random.nextInt(120) - 10);
+                    boolean flag = random.nextInt(6) == 0;
+                    assertSameResult(oldQuery(oldSet, oldW, box, flag), newQuery(newSet, newW, batch, box, flag));
+                }
+
+                assertEquals(oldSet.size(), newSet.size());
+                if (!oldSet.isEmpty()) {
+                    assertSame(oldSet.first(), newSet.first());
+                }
+                // isBlockTickPending probe: a fresh equal entry, as WorldServer.a(BlockPosition, Block) builds it.
+                BlockPosition probePos = new BlockPosition(random.nextInt(161) - 80, random.nextInt(256), random.nextInt(161) - 80);
+                NextTickListEntry probe = new NextTickListEntry(probePos, blocks[random.nextInt(blocks.length)]);
+                assertEquals(oldW.contains(probe), batch.contains(probe));
+                assertEquals(oldSet.contains(probe), newSet.contains(probe));
+            }
+
+            // Probe every batch entry explicitly, then drain and check the mirror is empty.
+            for (NextTickListEntry e : oldW) {
+                assertTrue(batch.contains(new NextTickListEntry(e.a, e.a())));
+            }
+            oldW.clear();
+            newW.clear();
+            batch.clear();
+        }
+    }
+
+    @Test
+    public void chunkEdgeEntriesRespectTheMinusTwoPlusSixteenWindow() {
+        ChunkIndexedTreeSet<NextTickListEntry> set = new ChunkIndexedTreeSet<NextTickListEntry>(LOCATOR);
+        HashTreeSet<NextTickListEntry> oldSet = new HashTreeSet<NextTickListEntry>();
+        int[] xs = {-3, -2, -1, 0, 15, 16, 17, 18};
+        for (int x : xs) {
+            NextTickListEntry e = new NextTickListEntry(new BlockPosition(x, 64, 0), Blocks.FLOWING_WATER);
+            e.a(5L);
+            oldSet.add(e);
+            set.add(e);
+        }
+        StructureBoundingBox box = chunkBox(0, 0);
+        List<NextTickListEntry> expected = oldQuery(oldSet, new ArrayList<NextTickListEntry>(), box, false);
+        assertSameResult(expected, newQuery(set, new ArrayList<NextTickListEntry>(), new MultiplicitySet<NextTickListEntry>(), box, false));
+        assertEquals("x in [-2, 16) -> -2,-1,0,15", 4, expected.size());
+    }
+}
diff --git a/test/java/net/minecraft/server/ScheduledTickIndexPerfTest.java b/test/java/net/minecraft/server/ScheduledTickIndexPerfTest.java
new file mode 100644
index 0000000..b6966bb
--- /dev/null
+++ b/test/java/net/minecraft/server/ScheduledTickIndexPerfTest.java
@@ -0,0 +1,163 @@
+package net.minecraft.server;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+import me.stella.antarctic.collection.ChunkIndexedTreeSet;
+import me.stella.antarctic.collection.MultiplicitySet;
+import org.bukkit.craftbukkit.util.HashTreeSet;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+/**
+ * Timed comparison of the old linear scans against the indexed structures on a Skyblock-sized workload. The numbers are
+ * printed so they can be pasted into the commit body; the assertions only require a conservative margin so the test is
+ * not flaky on a loaded machine (observed gains are orders of magnitude larger).
+ */
+public class ScheduledTickIndexPerfTest {
+
+    @BeforeClass
+    public static void bootstrap() {
+        DispenserRegistry.c();
+    }
+
+    private static NextTickListEntry entry(Random random, int span) {
+        BlockPosition pos = new BlockPosition(random.nextInt(span * 16), random.nextInt(256), random.nextInt(span * 16));
+        NextTickListEntry e = new NextTickListEntry(pos, random.nextBoolean() ? Blocks.FLOWING_WATER : Blocks.REDSTONE_TORCH);
+        e.a((long) random.nextInt(1000));
+        return e;
+    }
+
+    @Test
+    public void chunkSaveQueryBeatsLinearScan() {
+        Random random = new Random(42);
+        int span = 45; // 45 x 45 = 2025 chunk columns
+        HashTreeSet<NextTickListEntry> oldSet = new HashTreeSet<NextTickListEntry>();
+        ChunkIndexedTreeSet<NextTickListEntry> newSet = new ChunkIndexedTreeSet<NextTickListEntry>(ScheduledTickIndexParityTest.LOCATOR);
+        while (newSet.size() < 100_000) {
+            NextTickListEntry e = entry(random, span);
+            if (!oldSet.contains(e)) {
+                oldSet.add(e);
+                newSet.add(e);
+            }
+        }
+        List<NextTickListEntry> emptyW = new ArrayList<NextTickListEntry>();
+        StructureBoundingBox[] boxes = new StructureBoundingBox[64];
+        for (int i = 0; i < boxes.length; ++i) {
+            int cx = random.nextInt(span);
+            int cz = random.nextInt(span);
+            int a = (cx << 4) - 2;
+            int c = (cz << 4) - 2;
+            boxes[i] = new StructureBoundingBox(a, 0, c, a + 18, 256, c + 18);
+        }
+
+        long checksumOld = 0;
+        long checksumNew = 0;
+        long oldNanos = Long.MAX_VALUE;
+        long newNanos = Long.MAX_VALUE;
+        for (int round = 0; round < 4; ++round) { // first rounds warm up; keep the best
+            long start = System.nanoTime();
+            checksumOld = 0;
+            for (StructureBoundingBox box : boxes) {
+                List<NextTickListEntry> r = ScheduledTickIndexParityTest.oldQuery(oldSet, emptyW, box, false);
+                checksumOld += r == null ? 0 : r.size();
+            }
+            oldNanos = Math.min(oldNanos, System.nanoTime() - start);
+
+            start = System.nanoTime();
+            checksumNew = 0;
+            for (StructureBoundingBox box : boxes) {
+                List<NextTickListEntry> r = newSet.collect(box.a, box.c, box.d, box.f, false);
+                checksumNew += r == null ? 0 : r.size();
+            }
+            newNanos = Math.min(newNanos, System.nanoTime() - start);
+        }
+        assertEquals("both implementations must find the same number of ticks", checksumOld, checksumNew);
+        System.out.println("[perf] chunk-save query, 100k ticks / 2025 chunks, 64 saves: old=" + oldNanos / 1000 + "us new=" + newNanos / 1000
+                + "us ratio=" + (oldNanos / Math.max(1, newNanos)) + "x");
+        assertTrue("indexed query should be at least 5x faster", newNanos * 5 < oldNanos);
+    }
+
+    @Test
+    public void tickPendingProbeBeatsLinearScan() {
+        Random random = new Random(7);
+        List<NextTickListEntry> batch = new ArrayList<NextTickListEntry>();
+        MultiplicitySet<NextTickListEntry> mirror = new MultiplicitySet<NextTickListEntry>();
+        for (int i = 0; i < 20_000; ++i) {
+            NextTickListEntry e = entry(random, 30);
+            batch.add(e);
+            mirror.add(e);
+        }
+        NextTickListEntry[] probes = new NextTickListEntry[2_000];
+        for (int i = 0; i < probes.length; ++i) {
+            probes[i] = entry(random, 30);
+        }
+        long oldNanos = Long.MAX_VALUE;
+        long newNanos = Long.MAX_VALUE;
+        int hitsOld = 0;
+        int hitsNew = 0;
+        for (int round = 0; round < 4; ++round) {
+            long start = System.nanoTime();
+            hitsOld = 0;
+            for (NextTickListEntry probe : probes) {
+                if (batch.contains(probe)) {
+                    ++hitsOld;
+                }
+            }
+            oldNanos = Math.min(oldNanos, System.nanoTime() - start);
+
+            start = System.nanoTime();
+            hitsNew = 0;
+            for (NextTickListEntry probe : probes) {
+                if (mirror.contains(probe)) {
+                    ++hitsNew;
+                }
+            }
+            newNanos = Math.min(newNanos, System.nanoTime() - start);
+        }
+        assertEquals(hitsOld, hitsNew);
+        System.out.println("[perf] isBlockTickPending, 20k batch / 2000 probes: old=" + oldNanos / 1000 + "us new=" + newNanos / 1000
+                + "us ratio=" + (oldNanos / Math.max(1, newNanos)) + "x");
+        assertTrue("O(1) membership should be at least 10x faster than List.contains", newNanos * 10 < oldNanos);
+    }
+
+    @Test
+    public void scheduleAndDrainCostStaysComparable() {
+        Random random = new Random(11);
+        NextTickListEntry[] entries = new NextTickListEntry[200_000];
+        for (int i = 0; i < entries.length; ++i) {
+            entries[i] = entry(random, 45);
+        }
+        long oldNanos = Long.MAX_VALUE;
+        long newNanos = Long.MAX_VALUE;
+        for (int round = 0; round < 5; ++round) {
+            HashTreeSet<NextTickListEntry> oldSet = new HashTreeSet<NextTickListEntry>();
+            long start = System.nanoTime();
+            for (NextTickListEntry e : entries) {
+                if (!oldSet.contains(e)) {
+                    oldSet.add(e);
+                }
+            }
+            while (!oldSet.isEmpty()) {
+                oldSet.remove(oldSet.first());
+            }
+            oldNanos = Math.min(oldNanos, System.nanoTime() - start);
+
+            ChunkIndexedTreeSet<NextTickListEntry> newSet = new ChunkIndexedTreeSet<NextTickListEntry>(ScheduledTickIndexParityTest.LOCATOR);
+            start = System.nanoTime();
+            for (NextTickListEntry e : entries) {
+                newSet.add(e);
+            }
+            while (!newSet.isEmpty()) {
+                newSet.remove(newSet.first());
+            }
+            newNanos = Math.min(newNanos, System.nanoTime() - start);
+        }
+        System.out.println("[perf] schedule+drain 200k ticks: old=" + oldNanos / 1000 + "us new=" + newNanos / 1000
+                + "us ratio=" + String.format("%.2f", (double) oldNanos / Math.max(1, newNanos)) + "x (<1 means the index costs extra)");
+        assertTrue("indexing must not make scheduling more than 3x slower", newNanos < oldNanos * 3);
+    }
+}
