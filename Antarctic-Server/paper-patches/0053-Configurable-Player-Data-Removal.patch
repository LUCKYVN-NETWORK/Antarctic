From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nopjmp <kthompson@hey.com>
Date: Mon, 20 Dec 2021 18:15:01 -0600
Subject: [PATCH 53/94] Configurable Player Data Removal

- Backport Dionysus server/0035-Configurable-Player-Data-Removal.patch
- Source: https://github.com/nopjmp/Dionysus at b5c71b62f6f1f555b22bd52f5751e33be4690b6e
- Add redact-player-data setting to AntarcticConfig (defaults to false)
- Strip IP addresses and coordinates from login, packet failure, and vehicle movement logs when enabled

diff --git a/main/java/com/destroystokyo/paper/AntarcticConfig.java b/main/java/com/destroystokyo/paper/AntarcticConfig.java
index f54dbd6..0143812 100644
--- a/main/java/com/destroystokyo/paper/AntarcticConfig.java
+++ b/main/java/com/destroystokyo/paper/AntarcticConfig.java
@@ -183,4 +183,12 @@ public class AntarcticConfig {
         serverModName = getString("server-mod-name", serverModName);
     }
 
+    public static boolean redactPlayerData = false;
+    private static void redactPlayerData() {
+        setComment("redact-player-data",
+            "When enabled, removes player IP addresses and exact coordinates from console logs.",
+            "Useful for privacy compliance and anarchy server environments.");
+        redactPlayerData = getBoolean("redact-player-data", redactPlayerData);
+    }
+
 }
diff --git a/main/java/net/minecraft/server/LoginListener.java b/main/java/net/minecraft/server/LoginListener.java
index a3820ce..8cab659 100644
--- a/main/java/net/minecraft/server/LoginListener.java
+++ b/main/java/net/minecraft/server/LoginListener.java
@@ -186,7 +186,11 @@ public class LoginListener implements PacketLoginInListener, ITickable {
     }
 
     public String c() {
-        return this.i != null ? this.i + " (" + this.networkManager.getSocketAddress() + ")" : String.valueOf(this.networkManager.getSocketAddress());
+        String address = this.networkManager.getSocketAddress().toString();
+        if (com.destroystokyo.paper.AntarcticConfig.redactPlayerData) {
+            address = "/0.0.0.0:0";
+        }
+        return this.i != null ? this.i + " (" + address + ")" : address;
     }
 
     public void a(PacketLoginInStart packetlogininstart) {
