+            int id = 0xffff & entry.getShort(ENCHANTMENTS_ID.NBT);
+            if (id == targetId) {
+                return Enchantment.getById(id) != null ? (0xffff & entry.getShort(ENCHANTMENTS_LVL.NBT)) : 0;
+            }
+        }
+        return 0;
+        // Antarctic end
     }
 
     @Override
@@ -236,7 +273,27 @@ public final class CraftItemStack extends ItemStack {
 
     @Override
     public Map<Enchantment, Integer> getEnchantments() {
-        return hasItemMeta() ? getItemMeta(false).getEnchants() : ImmutableMap.<Enchantment, Integer>of(); // Paper - use Item Meta // Dionysus - Increase Book Meta Performance
+        // Antarctic start - read NBT enchant list directly without constructing ItemMeta
+        if (!hasItemMeta()) {
+            return ImmutableMap.<Enchantment, Integer>of();
+        }
+        NBTTagCompound tag = this.handle.getTag();
+        if (tag == null || !tag.hasKeyOfType(ENCHANTMENTS.NBT, CraftMagicNumbers.NBT.TAG_LIST)) {
+            return ImmutableMap.<Enchantment, Integer>of();
+        }
+        NBTTagList list = tag.getList(ENCHANTMENTS.NBT, CraftMagicNumbers.NBT.TAG_COMPOUND);
+        int size = list.size();
+        if (size == 0) {
+            return ImmutableMap.<Enchantment, Integer>of();
+        }
+        if (size == 1) {
+            NBTTagCompound entry = list.get(0);
+            Enchantment enchant = Enchantment.getById(0xffff & entry.getShort(ENCHANTMENTS_ID.NBT));
+            return enchant != null ? ImmutableMap.of(enchant, 0xffff & entry.getShort(ENCHANTMENTS_LVL.NBT)) : ImmutableMap.<Enchantment, Integer>of();
+        }
+        java.util.SortedMap<Enchantment, Integer> enchants = CraftMetaItem.buildEnchantments(tag, ENCHANTMENTS);
+        return (enchants == null || enchants.isEmpty()) ? ImmutableMap.<Enchantment, Integer>of() : com.google.common.collect.ImmutableSortedMap.copyOfSorted(enchants);
