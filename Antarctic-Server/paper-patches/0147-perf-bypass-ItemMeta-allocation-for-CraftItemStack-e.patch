diff --git a/test/java/org/bukkit/craftbukkit/inventory/CraftItemStackEnchantFastPathTest.java b/test/java/org/bukkit/craftbukkit/inventory/CraftItemStackEnchantFastPathTest.java
new file mode 100644
index 0000000..f775fcc
--- /dev/null
+++ b/test/java/org/bukkit/craftbukkit/inventory/CraftItemStackEnchantFastPathTest.java
@@ -0,0 +1,164 @@
+package org.bukkit.craftbukkit.inventory;
+
+import com.sun.management.ThreadMXBean;
+import java.lang.management.ManagementFactory;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.server.DispenserRegistry;
+import net.minecraft.server.Items;
+import net.minecraft.server.NBTTagCompound;
+import net.minecraft.server.NBTTagList;
+import net.minecraft.server.NBTTagString;
+import org.bukkit.craftbukkit.enchantments.CraftEnchantment;
+import org.bukkit.enchantments.Enchantment;
+import org.junit.Assert;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+public class CraftItemStackEnchantFastPathTest {
+
+    @BeforeClass
+    public static void setup() {
+        DispenserRegistry.c();
+        for (net.minecraft.server.Enchantment nms : net.minecraft.server.Enchantment.enchantments) {
+            if (nms != null && Enchantment.getById(net.minecraft.server.Enchantment.getId(nms)) == null) {
+                Enchantment.registerEnchantment(new CraftEnchantment(nms));
+            }
+        }
+    }
+
+    private static NBTTagCompound enchantTag(int id, int level) {
+        NBTTagCompound c = new NBTTagCompound();
+        c.setShort("id", (short) id);
+        c.setShort("lvl", (short) level);
+        return c;
+    }
+
+    private static net.minecraft.server.ItemStack makeHeavyBook(NBTTagList enchList) {
+        net.minecraft.server.ItemStack nms = new net.minecraft.server.ItemStack(Items.WRITTEN_BOOK, 1, 0);
+        NBTTagCompound tag = new NBTTagCompound();
+        tag.setString("title", "Heavy Book");
+        tag.setString("author", "Antarctic");
+        NBTTagList pages = new NBTTagList();
+        for (int i = 0; i < 50; ++i) {
+            pages.add(new NBTTagString("{\"text\":\"Page " + i + " with rich JSON text payload\"}"));
+        }
+        tag.set("pages", pages);
+        if (enchList != null) {
+            tag.set("ench", enchList);
+        }
+        nms.setTag(tag);
+        return nms;
+    }
+
+    @Test
+    public void testExactParityWithItemMetaAcrossEdgeCases() {
+        // 1. Plain item without tag -> false / 0 / empty (even null enchant on meta-less item)
+        CraftItemStack plain = CraftItemStack.asCraftMirror(new net.minecraft.server.ItemStack(Items.DIAMOND_SWORD, 1, 0));
+        Assert.assertFalse(plain.containsEnchantment(Enchantment.DAMAGE_ALL));
+        Assert.assertFalse(plain.containsEnchantment(null));
+        Assert.assertEquals(0, plain.getEnchantmentLevel(Enchantment.DAMAGE_ALL));
+        Assert.assertEquals(0, plain.getEnchantmentLevel(null));
+        Assert.assertTrue(plain.getEnchantments().isEmpty());
+
+        // 2. Heavy written book with meta but NO enchants -> false / 0 / empty, null throws IAE
+        CraftItemStack unenchantedBook = CraftItemStack.asCraftMirror(makeHeavyBook(null));
+        Assert.assertFalse(unenchantedBook.containsEnchantment(Enchantment.DAMAGE_ALL));
+        Assert.assertEquals(0, unenchantedBook.getEnchantmentLevel(Enchantment.DAMAGE_ALL));
+        Assert.assertTrue(unenchantedBook.getEnchantments().isEmpty());
+        try {
+            unenchantedBook.containsEnchantment(null);
+            Assert.fail("Expected IllegalArgumentException for null enchantment when item has meta");
+        } catch (IllegalArgumentException expected) {
+        }
+        try {
+            unenchantedBook.getEnchantmentLevel(null);
+            Assert.fail("Expected IllegalArgumentException for null enchantment when item has meta");
+        } catch (IllegalArgumentException expected) {
+        }
+
+        // 3. Single enchantment
+        NBTTagList single = new NBTTagList();
+        single.add(enchantTag(Enchantment.DURABILITY.getId(), 3));
+        CraftItemStack singleItem = CraftItemStack.asCraftMirror(makeHeavyBook(single));
+        Assert.assertTrue(singleItem.containsEnchantment(Enchantment.DURABILITY));
+        Assert.assertFalse(singleItem.containsEnchantment(Enchantment.MENDING));
+        Assert.assertEquals(3, singleItem.getEnchantmentLevel(Enchantment.DURABILITY));
+        Assert.assertEquals(singleItem.getItemMeta().getEnchants(), singleItem.getEnchantments());
+
+        // 4. Multiple enchantments with out-of-order IDs, duplicate ID (last wins!), and unknown ID (ignored!)
+        NBTTagList complex = new NBTTagList();
+        complex.add(enchantTag(Enchantment.MENDING.getId(), 1));
+        complex.add(enchantTag(Enchantment.DAMAGE_ALL.getId(), 2));
+        complex.add(enchantTag(9999, 5)); // unregistered ID must be ignored
+        complex.add(enchantTag(Enchantment.DAMAGE_ALL.getId(), 5)); // duplicate ID -> last wins (5)
+        complex.add(enchantTag(Enchantment.KNOCKBACK.getId(), 2));
+
+        CraftItemStack complexItem = CraftItemStack.asCraftMirror(makeHeavyBook(complex));
+        Map<Enchantment, Integer> expected = complexItem.getItemMeta().getEnchants();
+        Map<Enchantment, Integer> actual = complexItem.getEnchantments();
+
+        Assert.assertEquals("Enchantment map must match CraftMetaItem.getEnchants()", expected, actual);
+        Assert.assertEquals("Key iteration order must match sorted EnchantmentMap order",
+                new ArrayList<Enchantment>(expected.keySet()), new ArrayList<Enchantment>(actual.keySet()));
+        Assert.assertEquals("Duplicate ID must preserve last-wins level", 5, complexItem.getEnchantmentLevel(Enchantment.DAMAGE_ALL));
+        Assert.assertTrue(complexItem.containsEnchantment(Enchantment.MENDING));
+        Assert.assertEquals(1, complexItem.getEnchantmentLevel(Enchantment.MENDING));
+    }
+
+    @Test
+    public void testZeroAllocationAndThroughputGainOverItemMetaConstruction() {
+        NBTTagList ench = new NBTTagList();
+        ench.add(enchantTag(Enchantment.DAMAGE_ALL.getId(), 5));
+        ench.add(enchantTag(Enchantment.DURABILITY.getId(), 3));
+        CraftItemStack sword = CraftItemStack.asCraftMirror(makeHeavyBook(ench));
+
+        final int warmup = 1_000;
+        final int measured = 5_000;
+        long sink = 0;
+
+        for (int i = 0; i < warmup; ++i) {
+            sink += sword.getItemMeta().getEnchantLevel(Enchantment.DAMAGE_ALL);
+            sink += sword.getEnchantmentLevel(Enchantment.DAMAGE_ALL);
+            if (sword.containsEnchantment(Enchantment.DURABILITY)) {
+                sink++;
+            }
+        }
+
+        ThreadMXBean bean = (ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+
+        long a0 = bean.getThreadAllocatedBytes(tid);
+        long t0 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            sink += sword.getItemMeta().getEnchantLevel(Enchantment.DAMAGE_ALL);
+            if (sword.getItemMeta().hasEnchant(Enchantment.DURABILITY)) {
+                sink++;
+            }
+        }
+        long baseNs = System.nanoTime() - t0;
+        long baseAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a0);
+
+        long a1 = bean.getThreadAllocatedBytes(tid);
+        long t1 = System.nanoTime();
+        for (int i = 0; i < measured; ++i) {
+            sink += sword.getEnchantmentLevel(Enchantment.DAMAGE_ALL);
+            if (sword.containsEnchantment(Enchantment.DURABILITY)) {
+                sink++;
+            }
+        }
+        long fastNs = System.nanoTime() - t1;
+        long fastAlloc = Math.max(0L, bean.getThreadAllocatedBytes(tid) - a1);
+
+        System.out.printf(
+                "[perf] CraftItemStack enchant query (%d pairs on 50-page book): meta=%.2f ms (alloc=%.2f MB) vs directNBT=%.2f ms (alloc=%d B), speedup=%.1fx (sink=%d)%n",
+                measured, baseNs / 1e6, baseAlloc / (1024.0 * 1024.0),
+                fastNs / 1e6, fastAlloc, (double) baseNs / Math.max(1L, fastNs), sink);
+
+        Assert.assertTrue("Direct NBT enchant queries must be near-zero allocation (actual=" + fastAlloc + ")",
+                fastAlloc <= 1024L);
+        Assert.assertTrue("Direct NBT enchant queries must be dramatically faster than constructing ItemMeta",
+                fastNs * 10L < baseNs);
+    }
+}
