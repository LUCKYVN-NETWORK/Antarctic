index b3ed98b..740b231 100644
--- a/main/java/org/bukkit/plugin/java/PluginClassLoader.java
+++ b/main/java/org/bukkit/plugin/java/PluginClassLoader.java
@@ -38,7 +38,7 @@ public final class PluginClassLoader extends URLClassLoader { // Spigot
     private IllegalStateException pluginState;
     private java.util.logging.Logger logger; // Paper - add field
 
-    private boolean closed = false; // Dionysus
+    private volatile boolean closed = false; // Dionysus
 
     // Spigot Start
     static
